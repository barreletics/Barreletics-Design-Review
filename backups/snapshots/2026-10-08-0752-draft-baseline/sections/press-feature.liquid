      "label": "Video URL fallback (mp4)",
      "info": "Used only when Shopify video is empty."
    },
    {
      "type": "text",
      "id": "media_1_alt",
      "label": "Alt text"
    },
    {
      "type": "select",
      "id": "media_1_fit",
