  }
  #shopify-section-{{ section.id }} .problem-resolve__cta--outline {
    background: transparent;
    /* Outline ink = remapped --pr-cta-text (white→border in liquid). Border fallback if unset. */
    color: var(--pr-cta-text, var(--pr-cta-border, #c45c3f));
    border-color: var(--pr-cta-border, #c45c3f);
  }
  #shopify-section-{{ section.id }} .problem-resolve__cta:hover { opacity: 0.92; }
  #shopify-section-{{ section.id }} .problem-resolve__cta--outline:hover { opacity: 0.85; }
  
  /* Desk L/R — same mechanism as fifty-fifty reverse (CSS order, not % crop) */
  #shopify-section-{{ section.id }} .problem-layout--with-media {
    display: grid;
    grid-template-columns: var(--pr-split-media, 1fr) var(--pr-split-copy, 1fr);
  }
  #shopify-section-{{ section.id }} .problem-section--reverse .problem-layout--with-media {
    grid-template-columns: var(--pr-split-copy, 1fr) var(--pr-split-media, 1fr);
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media .problem-media { order: 1; }
  #shopify-section-{{ section.id }} .problem-layout--with-media .problem-inner { order: 2; }
  #shopify-section-{{ section.id }} .problem-section--reverse .problem-layout--with-media .problem-media { order: 2; }
  #shopify-section-{{ section.id }} .problem-section--reverse .problem-layout--with-media .problem-inner { order: 1; }

  /* Phone U/D — same idea as fifty-fifty mobile_stack_order */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .problem-layout--with-media {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .problem-section--media-first .problem-layout--with-media .problem-media { order: 1; }
    #shopify-section-{{ section.id }} .problem-section--media-first .problem-layout--with-media .problem-inner { order: 2; }
    #shopify-section-{{ section.id }} .problem-section--copy-first .problem-layout--with-media .problem-inner { order: 1; }
    #shopify-section-{{ section.id }} .problem-section--copy-first .problem-layout--with-media .problem-media { order: 2; }
    /* reset desk reverse on phone */
    #shopify-section-{{ section.id }} .problem-section--reverse .problem-layout--with-media .problem-media,
    #shopify-section-{{ section.id }} .problem-section--reverse .problem-layout--with-media .problem-inner { order: unset; }
    #shopify-section-{{ section.id }} .problem-section--media-first.problem-section--reverse .problem-layout--with-media .problem-media { order: 1; }
    #shopify-section-{{ section.id }} .problem-section--media-first.problem-section--reverse .problem-layout--with-media .problem-inner { order: 2; }
    #shopify-section-{{ section.id }} .problem-section--copy-first.problem-section--reverse .problem-layout--with-media .problem-inner { order: 1; }
    #shopify-section-{{ section.id }} .problem-section--copy-first.problem-section--reverse .problem-layout--with-media .problem-media { order: 2; }
  }
@media (max-width: 768px) {
    .problem-section {
      padding: var(--text-pad-mobile, 48px) 16px;
      min-height: var(--text-min-h-mobile, auto);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    #shopify-section-{{ section.id }} .problem-section--with-media.problem-section--cover-flush {
      padding: 0;
