</style>

{% if section.settings.video != blank or video_src != blank %}
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var video = root.querySelector('.problem-media__video');
    if (!video || video.hasAttribute('controls')) return;
    function kick() {
      video.muted = true;
      video.defaultMuted = true;
      video.setAttribute('muted', '');
      video.playsInline = true;
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
    }
    video.addEventListener('loadeddata', kick);
    video.addEventListener('canplay', kick);
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) kick(); });
      }, { rootMargin: '80px 0px' });
      io.observe(video);
    }
    kick();
  })();
</script>
{% endif %}

