{% comment %}
  Problem section — Home WORKING 12b. Cream beat with optional muted media + copy split.
{% endcomment %}

{%- liquid
  assign cta_style = section.settings.cta_style | default: 'solid'
  assign cta_bg = section.settings.cta_bg_color | default: '#c45c3f'
  assign cta_border = section.settings.cta_border_color | default: cta_bg
  assign cta_text_color = section.settings.cta_text_color | default: '#ffffff'
  if cta_style == 'outline'
    assign _cta_tc = cta_text_color | downcase
    if _cta_tc == '#ffffff' or _cta_tc == '#fff' or _cta_tc == 'white' or cta_text_color == blank
      assign cta_text_color = cta_border
    endif
  endif
  assign mobile_media_height = section.settings.mobile_media_height | default: 520
  assign copy_stack_gap = section.settings.copy_stack_gap | default: 16
  assign reverse = section.settings.reverse
  assign mobile_stack_order = section.settings.mobile_stack_order | default: 'media_first'
  assign media_fit = section.settings.media_fit | default: 'cover'
  assign image_fit_mobile = section.settings.image_fit_mobile | default: 'cover'
  assign media_aspect = section.settings.media_aspect | default: 'stretch'
  assign media_aspect_m = section.settings.media_aspect_mobile | default: 'stretch'
  assign min_height = section.settings.min_height | default: 860
  assign desktop_split = section.settings.desktop_split | default: '50_50'
  if desktop_split == '62_38'
    assign split_media = '1.63fr'
    assign split_copy = '1fr'
  elsif desktop_split == '38_62'
    assign split_media = '1fr'
    assign split_copy = '1.63fr'
  else
    assign split_media = '1fr'
    assign split_copy = '1fr'
  endif

  # Text panel / section bg: preset white/cream or custom picker (bg_color).
  # No preset → cream #faf8f6 (compat with current Home Never-slip look).
  assign bg_preset = section.settings.bg_preset | default: ''
  if bg_preset == 'white'
    assign panel_bg = '#ffffff'
  elsif bg_preset == 'cream'
    assign panel_bg = '#faf8f6'
  elsif bg_preset == 'custom'
    assign panel_bg = section.settings.bg_color | default: '#faf8f6'
  else
    assign panel_bg = section.settings.bg_color | default: '#faf8f6'
  endif

  # Media pad / letterbox bg when Fit or Contain (desk or phone).
  assign media_bg_preset = section.settings.media_bg_preset
  if media_bg_preset == 'cream'
    assign media_pad_bg = '#faf8f6'
  elsif media_bg_preset == 'white'
    assign media_pad_bg = '#ffffff'
  elsif media_bg_preset == 'custom'
    assign media_pad_bg = section.settings.media_bg | default: '#ffffff'
  else
    assign media_pad_bg = section.settings.media_bg | default: '#ffffff'
  endif

  assign has_media = false
  if section.settings.video != blank
    assign has_media = true
  elsif section.settings.video_url != blank
    assign has_media = true
  elsif section.settings.image != blank
    assign has_media = true
  elsif section.settings.image_url != blank
    assign has_media = true
  elsif section.settings.video_asset != blank
    assign has_media = true
  endif

  # Media priority: Shopify video → Video URL → Image → theme asset (last)
  assign video_src = section.settings.video_url | strip
  assign video_asset = section.settings.video_asset | default: '' | strip
  assign video_source_type = 'video/mp4'
  if video_src contains '.mov'
    assign video_source_type = 'video/quicktime'
  endif

  assign poster_url = ''
  if section.settings.image != blank
    assign poster_url = section.settings.image | image_url: width: 1600
  elsif section.settings.poster_url != blank
    assign poster_url = section.settings.poster_url
  endif

  # 108fff6 content ids (restored 2026-10-06 r4). Blank / default = today's output.
  assign pr_hl = section.settings.heading_level | default: 'h2'
  if pr_hl != 'h1' and pr_hl != 'h2' and pr_hl != 'h3' and pr_hl != 'h4' and pr_hl != 'h5' and pr_hl != 'h6'
    assign pr_hl = 'h2'
  endif
  assign pr_href = section.settings.cta_url | default: '#variants'
  if section.settings.cta_link_target != blank and section.settings.cta_link_target != 'custom'
    assign pr_href = section.settings.cta_link_target
  endif
  assign pr_alt = section.settings.image_alt | default: section.settings.title
-%}
<section
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} problem-section{% if has_media %} problem-section--with-media{% endif %}{% if reverse %} problem-section--reverse{% endif %}{% if mobile_stack_order == 'copy_first' %} problem-section--copy-first{% else %} problem-section--media-first{% endif %}{% if media_aspect == 'square' %} problem-section--media-square{% endif %}{% if media_aspect_m == 'square' %} problem-section--media-square-m{% endif %}{% if media_fit == 'contain' or media_fit == 'fit' %} problem-section--media-contain{% endif %}{% if media_fit == 'cover_inset' %} problem-section--cover-inset{% elsif media_fit == 'cover' or media_fit == blank %} problem-section--cover-flush{% endif %}{% if image_fit_mobile == 'fit' or image_fit_mobile == 'contain' %} problem-section--fit-mobile{% endif %}{% if media_fit == 'contain' %} problem-section--media-contain{% endif %}"
  id="{{ section.settings.anchor_id | default: 'problem' | handleize }}"
  aria-label="{{ section.settings.aria_label | default: section.settings.title | escape }}"
  style="{% render 'section-inset-vars' %} --pr-cta-bg: {{ cta_bg }}; --pr-cta-border: {{ cta_border }}; --pr-cta-text: {{ cta_text_color }}; --pr-mobile-media-height: {{ mobile_media_height }}px; --pr-desk-media-min: {{ min_height }}px; --pr-copy-stack-gap: {{ copy_stack_gap }}px; --pr-panel-bg: {{ panel_bg }}; --pr-media-pad-bg: {{ media_pad_bg }}; --pr-split-media: {{ split_media }}; --pr-split-copy: {{ split_copy }};"
>
  <div class="problem-shell">
    <div class="problem-layout{% if has_media %} problem-layout--with-media{% endif %}">
      {% if has_media %}
        <div class="problem-media" style="background: {{ media_pad_bg }};">
          <div class="problem-media__clip">
            {% if section.settings.video != blank %}
              {{
                section.settings.video
                | video_tag:
                  image_size: '1600x',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  class: 'problem-media__video'
              }}
            {% elsif video_src != blank %}
              <video
                class="problem-media__video"
                autoplay
                muted
                loop
                playsinline
                webkit-playsinline
                preload="auto"
                disablepictureinpicture
                {% if poster_url != blank %}poster="{{ poster_url | escape }}"{% endif %}
              >
                <source src="{{ video_src | escape }}" type="{{ video_source_type }}">
              </video>
            {% elsif section.settings.image != blank %}
              {%- if section.settings.image_mobile != blank -%}<picture style="display:contents"><source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 780 }} 780w, {{ section.settings.image_mobile | image_url: width: 1170 }} 1170w" sizes="100vw">{%- endif -%}
              {% render 'media-img',
                 image: section.settings.image,
                 alt: pr_alt,
                 class: 'problem-media__img',
                 widths: '600, 900, 1200, 1600',
                 width_default: 1600,
                 sizes: '(max-width: 768px) 100vw, 50vw',
                 loading: 'lazy',
                 position: 'css' %}
              {%- if section.settings.image_mobile != blank -%}</picture>{%- endif %}
            {% elsif section.settings.image_url != blank %}
              {% render 'media-img',
                 url: section.settings.image_url,
                 alt: pr_alt,
                 class: 'problem-media__img',
                 sizes: '(max-width: 768px) 100vw, 50vw',
                 loading: 'lazy',
                 position: 'css' %}
            {% elsif video_asset != blank %}
              <video
                class="problem-media__video"
                autoplay
                muted
                loop
                playsinline
                webkit-playsinline
                preload="auto"
                disablepictureinpicture
              >
                <source src="{{ video_asset | asset_url }}" type="video/mp4">
              </video>
            {% else %}
              <div class="problem-media__placeholder" aria-hidden="true"></div>
            {% endif %}
          </div>
        </div>
      {% endif %}
      <div class="problem-inner">
        <div>
          {% if section.settings.show_trust_strip %}<div class="problem-trust"><span class="problem-trust__stars" aria-hidden="true">★★★★★</span>{% if section.settings.trust_text != blank %}<span class="problem-trust__text">{{ section.settings.trust_text | escape }}</span>{% endif %}</div>{% endif %}
          <{{ pr_hl }} class="problem-title h2-display">{{ section.settings.title }}</{{ pr_hl }}>
          {% if section.settings.body != blank %}
            <p class="problem-body">{{ section.settings.body }}</p>
          {% endif %}
        </div>
        <div>
          {% if section.blocks.size > 0 %}
            <ul class="problem-list">
              {% for block in section.blocks %}
                {% if block.settings.text != blank %}
                <li {{ block.shopify_attributes }}>
                  <span class="problem-list__x" aria-hidden="true">×</span>
                  <span>{{ block.settings.text }}</span>
                </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
          {% if section.settings.cta_text != blank %}
            <div class="problem-resolve">
              <a class="problem-resolve__cta{% if cta_style == 'outline' %} problem-resolve__cta--outline{% endif %}" href="{{ pr_href }}">
                {{ section.settings.cta_text }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%}
  TE live preview (restored 2026-10-06; pattern verified on draft 2026-10-03 in 108fff6 / PR #36 and acd8a93 / PR #35):
  Shopify hot-patches this {% style %} block when settings change. Values must read section.settings.* directly
  (not top-of-file assigns). !important beats the inline --pr-* vars on .problem-section and the static <style> block.
  Keep this block render-free (no {% render %}).
{%- endcomment -%}
{% style %}
  {%- liquid
    assign te_cta_bg = section.settings.cta_bg_color | default: '#c45c3f'
    assign te_cta_border = section.settings.cta_border_color | default: te_cta_bg
    assign te_cta_text = section.settings.cta_text_color | default: '#ffffff'
    if section.settings.cta_style == 'outline'
      assign te_cta_tc = te_cta_text | downcase
      if te_cta_tc == '#ffffff' or te_cta_tc == '#fff' or te_cta_tc == 'white' or section.settings.cta_text_color == blank
        assign te_cta_text = te_cta_border
      endif
    endif
    assign te_split_media = '1fr'
    assign te_split_copy = '1fr'
    if section.settings.desktop_split == '62_38'
      assign te_split_media = '1.63fr'
    elsif section.settings.desktop_split == '38_62'
      assign te_split_copy = '1.63fr'
    endif
    if section.settings.bg_preset == 'white'
      assign te_panel_bg = '#ffffff'
    elsif section.settings.bg_preset == 'cream'
      assign te_panel_bg = '#faf8f6'
    else
      assign te_panel_bg = section.settings.bg_color | default: '#faf8f6'
    endif
    if section.settings.media_bg_preset == 'cream'
      assign te_media_bg = '#faf8f6'
    elsif section.settings.media_bg_preset == 'white'
      assign te_media_bg = '#ffffff'
    else
      assign te_media_bg = section.settings.media_bg | default: '#ffffff'
    endif
    assign te_in_t = section.settings.inset_top | default: 0
    assign te_in_b = section.settings.inset_bottom | default: 0
    assign te_in_x = section.settings.inset_x | default: 0
    if section.settings.inset_custom_mobile
      assign te_in_tm = section.settings.inset_top_mobile | default: 0
      assign te_in_bm = section.settings.inset_bottom_mobile | default: 0
      assign te_in_xm = section.settings.inset_x_mobile | default: 0
    else
      assign te_in_tm = te_in_t
      assign te_in_bm = te_in_b
      assign te_in_xm = te_in_x
    endif
  -%}
  #shopify-section-{{ section.id }} .problem-section {
    --pr-cta-bg: {{ te_cta_bg }} !important;
    --pr-cta-border: {{ te_cta_border }} !important;
    --pr-cta-text: {{ te_cta_text }} !important;
    --pr-mobile-media-height: {{ section.settings.mobile_media_height | default: 520 }}px !important;
    --pr-desk-media-min: {{ section.settings.min_height | default: 860 }}px !important;
    --pr-copy-stack-gap: {{ section.settings.copy_stack_gap | default: 16 }}px !important;
    --pr-panel-bg: {{ te_panel_bg }} !important;
    --pr-media-pad-bg: {{ te_media_bg }} !important;
    --pr-split-media: {{ te_split_media }} !important;
    --pr-split-copy: {{ te_split_copy }} !important;
    --section-inset-top: {{ te_in_t }}px !important;
    --section-inset-right: {{ te_in_x }}px !important;
    --section-inset-bottom: {{ te_in_b }}px !important;
    --section-inset-left: {{ te_in_x }}px !important;
    --section-inset-top-m: {{ te_in_tm }}px !important;
    --section-inset-right-m: {{ te_in_xm }}px !important;
    --section-inset-bottom-m: {{ te_in_bm }}px !important;
    --section-inset-left-m: {{ te_in_xm }}px !important;
  }
  /* Panel + media pad colours (static <style> and inline background use assigns). */
  #shopify-section-{{ section.id }} .problem-section,
  #shopify-section-{{ section.id }} .problem-section--cover-flush .problem-inner {
    background: {{ te_panel_bg }} !important;
  }
  #shopify-section-{{ section.id }} .problem-media {
    background: {{ te_media_bg }} !important;
  }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .problem-section--with-media .problem-layout--with-media {
      min-height: {{ section.settings.min_height | default: 860 }}px;
    }
  }
  {%- comment -%} Photo focal point (restored 2026-10-06 from 108fff6 schema). Defaults = center = today's look. {%- endcomment -%}
  {%- liquid
    assign te_pos = section.settings.image_position | default: 'center'
    if te_pos == 'custom'
      assign te_pos = section.settings.focal_x | default: 50 | append: '% ' | append: section.settings.focal_y | default: 50 | append: '%'
    endif
    assign te_pos_m = section.settings.image_position_mobile | default: 'same'
    if te_pos_m == 'same' or te_pos_m == blank
      assign te_pos_m = te_pos
    elsif te_pos_m == 'custom'
      assign te_pos_m = section.settings.focal_x_mobile | default: 50 | append: '% ' | append: section.settings.focal_y_mobile | default: 50 | append: '%'
    endif
  -%}
  #shopify-section-{{ section.id }} .problem-section .problem-media__img,
  #shopify-section-{{ section.id }} .problem-section .problem-media__video {
    object-position: {{ te_pos }};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .problem-section .problem-media__img,
    #shopify-section-{{ section.id }} .problem-section .problem-media__video {
      object-position: {{ te_pos_m }};
    }
  }
{% endstyle %}

{%- comment -%}
  108fff6 layout controls (restored 2026-10-06 r4), live in Theme Editor: this block reads section.settings directly.
  Each rule is emitted only when a control is moved off its default; defaults = today's rendered values, so nothing changes at defaults.
{%- endcomment -%}
{% style %}
  {%- liquid
    assign te_ty = section.settings.text_pad_y | default: 72
    assign te_sx = section.settings.side_padding | default: 40
    assign te_tym = section.settings.text_pad_y_mobile | default: 48
    assign te_sxm = section.settings.text_pad_x_mobile | default: 16
    assign te_mc = section.settings.media_column_pct | default: 50
    assign te_mw = section.settings.mobile_media_width | default: 100
    assign te_gap = section.settings.section_gap | default: 0
    assign te_gapm = section.settings.section_gap_mobile | default: 0
    assign te_bgs = ''
    if section.settings.bg_style == 'white'
      assign te_bgs = '#ffffff'
    elsif section.settings.bg_style == 'cream'
      assign te_bgs = '#faf8f6'
    elsif section.settings.bg_style == 'darker_cream'
      assign te_bgs = '#efe9dd'
    endif
  -%}
  {%- if te_ty != 72 or te_sx != 40 or te_mc != 50 or te_gap > 0 %}
  @media (min-width: 769px) {
    {%- if te_ty != 72 or te_sx != 40 %}
    #shopify-section-{{ section.id }} .problem-section:not(.problem-section--with-media),
    #shopify-section-{{ section.id }} .problem-section--with-media:not(.problem-section--cover-flush),
    #shopify-section-{{ section.id }} .problem-section.problem-section--cover-flush .problem-inner {
      {%- if te_ty != 72 %}
      padding-top: {{ te_ty }}px !important;
      padding-bottom: {{ te_ty }}px !important;
      {%- endif %}
      {%- if te_sx != 40 %}
      padding-left: {{ te_sx }}px !important;
      padding-right: {{ te_sx }}px !important;
      {%- endif %}
    }
    {%- endif %}
    {%- if te_mc != 50 %}
    #shopify-section-{{ section.id }} .problem-section.problem-section {
      --pr-split-media: {{ te_mc }}fr !important;
      --pr-split-copy: {{ 100 | minus: te_mc }}fr !important;
    }
    {%- endif %}
    {%- if te_gap > 0 %}
    #shopify-section-{{ section.id }} {
      padding-top: {{ te_gap }}px;
      padding-bottom: {{ te_gap }}px;
    }
    {%- endif %}
  }
  {%- endif %}
  {%- if te_tym != 48 or te_sxm != 16 or te_mw != 100 or te_gapm > 0 %}
  @media (max-width: 768px) {
    {%- if te_tym != 48 or te_sxm != 16 %}
    #shopify-section-{{ section.id }} .problem-section:not(.problem-section--with-media),
    #shopify-section-{{ section.id }} .problem-section--with-media:not(.problem-section--cover-flush),
    #shopify-section-{{ section.id }} .problem-section.problem-section--cover-flush .problem-inner {
      {%- if te_tym != 48 %}
      padding-top: {{ te_tym }}px !important;
      padding-bottom: {{ te_tym }}px !important;
      {%- endif %}
      {%- if te_sxm != 16 %}
      padding-left: {{ te_sxm }}px !important;
      padding-right: {{ te_sxm }}px !important;
      {%- endif %}
    }
    {%- endif %}
    {%- if te_mw != 100 %}
    #shopify-section-{{ section.id }} .problem-layout--with-media .problem-media {
      width: {{ te_mw }}% !important;
      justify-self: center;
      margin-left: auto !important;
      margin-right: auto !important;
    }
    {%- endif %}
    {%- if te_gapm > 0 %}
    #shopify-section-{{ section.id }} {
      padding-bottom: {{ te_gapm }}px;
    }
    {%- endif %}
  }
  {%- endif %}
  {%- if te_bgs != blank %}
  #shopify-section-{{ section.id }} .problem-section.problem-section {
    --pr-panel-bg: {{ te_bgs }} !important;
    background: {{ te_bgs }} !important;
  }
  #shopify-section-{{ section.id }} .problem-section.problem-section--cover-flush .problem-inner {
    background: {{ te_bgs }} !important;
  }
  {%- endif %}
{% endstyle %}

<style>
  {%- if section.settings.heading_size_override != blank %}
  #shopify-section-{{ section.id }} { {% render 'type-override-vars', title_size: section.settings.heading_size_override %} --te-title-size-n: {{ section.settings.heading_size_override }}; }
  {%- endif %}
  {%- assign _hso_n = section.settings.heading_size_override | plus: 0 -%}
  {%- if section.settings.heading_size_override != blank and _hso_n > 0 %}
  #shopify-section-{{ section.id }} { --section-heading-size-m: {{ _hso_n }}px; }
  {%- endif %}
  .problem-section {
    padding: 72px 40px;
    background: {{ panel_bg }};
  }
  /* Cover (fill half): media column bleeds edge-to-edge in its 50%. Text keeps cream. */
  #shopify-section-{{ section.id }} .problem-section--with-media.problem-section--cover-flush {
    padding: 0;
  }
  /* Cover flush: kill shell max-width/centering — that was the left-margin pad. */
  #shopify-section-{{ section.id }} .problem-section--cover-flush .problem-shell {
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .problem-section--cover-flush .problem-layout--with-media {
    width: 100%;
    max-width: none;
    margin: 0;
    gap: 0;
    align-items: stretch;
  }
  /* Cover flush + Landscape: fill the full media half (edge-to-edge). */
  #shopify-section-{{ section.id }} .problem-section--cover-flush:not(.problem-section--media-square) .problem-media__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    max-height: none;
    aspect-ratio: auto;
    border-radius: 0;
  }
  /* Cover flush + Square desk: still left-flush to margin, but 1:1 frame (Frame shape works). */
  #shopify-section-{{ section.id }} .problem-section--cover-flush.problem-section--media-square .problem-media {
    position: relative;
    align-self: start;
    height: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .problem-section--cover-flush.problem-section--media-square .problem-media__clip {
    position: relative;
    inset: auto;
    width: 100%;
    height: auto;
    min-height: 0;
    max-height: none;
    aspect-ratio: 1 / 1;
    border-radius: 0;
    margin: 0;
    padding: 0;
  }
  /* Cover inset (sit in panel): preserve Never-slip sitting-in look (pad + gap + radius). */
  #shopify-section-{{ section.id }} .problem-section--with-media.problem-section--cover-inset {
    padding: 72px 40px;
  }
  {% if template.name == 'collection' %}
  #shopify-section-{{ section.id }} .problem-section {
    background: {{ panel_bg }};
  }
  {% endif %}
  .problem-shell {
    max-width: 1100px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media {
    display: grid;
    grid-template-columns: var(--pr-split-media, 1fr) var(--pr-split-copy, 1fr);
    gap: 48px;
    align-items: stretch;
    max-width: none;
  }
  #shopify-section-{{ section.id }} .problem-section--cover-flush .problem-layout--with-media {
    gap: 0;
    align-items: stretch;
  }
  #shopify-section-{{ section.id }} .problem-section--cover-inset .problem-layout--with-media {
    gap: 48px;
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media .problem-shell {
    max-width: none;
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media {
    align-items: start;
  }
  #shopify-section-{{ section.id }} .problem-section--cover-flush .problem-layout--with-media {
    align-items: stretch;
  }
  #shopify-section-{{ section.id }} .problem-media__clip {
    position: relative;
    width: 100%;
    height: var(--pr-desk-media-min, 860px);
    min-height: var(--pr-desk-media-min, 860px);
    max-height: var(--pr-desk-media-min, 860px);
    overflow: hidden;
    border-radius: 4px;
    background: var(--pr-media-pad-bg, #ffffff);
  }
  #shopify-section-{{ section.id }} .problem-media {
    background: {{ media_pad_bg }};
  }
  /* Cover flush: no radius, stretch to full half, clip absolute fill */
  #shopify-section-{{ section.id }} .problem-section--cover-flush .problem-media {
    align-self: stretch;
    height: 100%;
    min-height: var(--pr-desk-media-min, 860px);
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .problem-section--cover-flush:not(.problem-section--media-square) .problem-media__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    max-height: none;
    border-radius: 0;
