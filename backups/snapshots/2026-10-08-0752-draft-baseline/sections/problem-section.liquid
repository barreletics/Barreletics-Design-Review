      min-height: var(--text-min-h-mobile, auto);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    #shopify-section-{{ section.id }} .problem-layout--with-media {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    #shopify-section-{{ section.id }} .problem-section--cover-flush .problem-layout--with-media {
      gap: 0;
    }
    #shopify-section-{{ section.id }} .problem-media__clip {
      height: var(--pr-mobile-media-height, 520px);
      min-height: var(--pr-mobile-media-height, 520px);
      max-height: var(--pr-mobile-media-height, 520px);
      aspect-ratio: auto;
    }
    /* Phone landscape: desk square must not force 1:1 over height slider */
    #shopify-section-{{ section.id }} .problem-section--media-square:not(.problem-section--media-square-m) .problem-media__clip {
      height: var(--pr-mobile-media-height, 520px);
      min-height: var(--pr-mobile-media-height, 520px);
      max-height: var(--pr-mobile-media-height, 520px);
      aspect-ratio: auto;
    }
    /* Phone square frame — 1/1; height follows width (ignore height slider). */

    /* Frame shape — phone: Square under Cover flush */
    #shopify-section-{{ section.id }} .problem-section--cover-flush.problem-section--media-square-m .problem-media {
      height: auto;
      min-height: 0;
      align-self: stretch;
    }
    #shopify-section-{{ section.id }} .problem-section--cover-flush.problem-section--media-square-m .problem-media__clip {
      position: relative !important;
      inset: auto !important;
      width: 100%;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      aspect-ratio: 1 / 1;
      border-radius: 0;
    }
    /* Frame shape — phone: Landscape under Cover flush = full-width height slider */
    #shopify-section-{{ section.id }} .problem-section--cover-flush:not(.problem-section--media-square-m) .problem-media__clip {
      position: relative;
      inset: auto;
      width: 100%;
      height: var(--pr-mobile-media-height, 520px);
      min-height: var(--pr-mobile-media-height, 520px);
      max-height: none;
      aspect-ratio: auto;
      border-radius: 0;
    }

    #shopify-section-{{ section.id }} .problem-section--media-square-m .problem-media__clip {
      height: auto;
      min-height: 0;
      max-height: none;
      aspect-ratio: 1 / 1;
    }
    .problem-inner {
      grid-template-columns: 1fr;
      gap: var(--pr-copy-stack-gap, 28px);
    }
    #shopify-section-{{ section.id }} .problem-media__video,
    #shopify-section-{{ section.id }} .problem-media__img {
      object-position: center center;
    }
  }
  @media (min-width: 769px) {
