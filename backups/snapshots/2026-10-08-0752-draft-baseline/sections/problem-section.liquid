    #shopify-section-{{ section.id }} .problem-section--cover-flush .problem-inner {
      padding: var(--text-pad-mobile, 48px) 16px;
      min-height: var(--text-min-h-mobile, auto);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    /* Phone: media column follows the clip (mobile_media_height), not the desktop 860 min-height.
       Without this the column stays 860 tall under a 600 clip = blank bar (Home Chair Pose, 2026-09-30). */
    #shopify-section-{{ section.id }} .problem-section--cover-flush .problem-media {
      height: auto;
      min-height: 0;
    }
    #shopify-section-{{ section.id }} .problem-section--cover-flush .problem-media__clip {
