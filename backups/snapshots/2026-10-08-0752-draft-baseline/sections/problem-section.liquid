  /* GLOBAL HEADING SYSTEM (locked 2026-09-27): one display head for this section type.
     56 desktop, standard tier (fluid to 36 on tablet) / 36 phone / 400. Theme Editor title size, weight
     and role settings are intentionally ignored so every page renders the same. */
  #shopify-section-{{ section.id }} .problem-title.h2-display {
    font-size: clamp(var(--heading-phone, 36px), calc(var(--te-title-size-n, var(--heading-standard-desktop-n, 56)) * 4.8vw / 56), var(--te-title-size, var(--heading-standard-desktop, 56px)));
    font-weight: 400;
    line-height: var(--type-h2-display-leading, 1.1);
    letter-spacing: var(--type-h2-display-tracking, -0.028em);
