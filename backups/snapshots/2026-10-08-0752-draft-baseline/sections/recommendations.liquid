{% comment %}
  Product Recommendations Section
  Renders "You may also like" product grid using Shopify's recommendations API.
  Lazy-loads via JavaScript fetch for performance.

  Usage: Include in product template JSON. Automatically uses current product context.
{% endcomment %}

{%- comment -%}
  No product context (cart, pages): there is nothing to recommend, so render nothing.
  Before 2026-09-30 the empty cart showed a bare "You may also like" heading (QC M08).
{%- endcomment -%}
{%- if product != blank -%}
{%- liquid
  assign utp_y_d_def = 32
  assign utp_side_d_def = 40
  assign utp_y_m_def = 24
  assign utp_x_m_def = 20
  assign utp_style = ''
  assign u_y = section.settings.text_pad_y | default: utp_y_d_def
  if u_y != utp_y_d_def
    assign utp_style = utp_style | append: '--utp-y-d:' | append: u_y | append: 'px;'
  endif
  assign u_side = section.settings.side_padding | default: utp_side_d_def
  if u_side != utp_side_d_def
    assign utp_style = utp_style | append: '--utp-side-d:' | append: u_side | append: 'px;'
  endif
  assign u_y_m = section.settings.text_pad_y_mobile | default: utp_y_m_def
  if u_y_m != utp_y_m_def
    assign utp_style = utp_style | append: '--utp-y-m:' | append: u_y_m | append: 'px;'
  endif
  assign u_x_m = section.settings.text_pad_x_mobile | default: utp_x_m_def
  if u_x_m != utp_x_m_def
    assign utp_style = utp_style | append: '--utp-x-m:' | append: u_x_m | append: 'px;'
  endif
-%}
<section
  class="section recommendations"
  data-recommendations
  data-product-id="{{ product.id }}"
  data-limit="{{ section.settings.limit | default: 4 }}"
  aria-labelledby="recommendations-heading"
  style="{{ utp_style }}"
>
  <div class="section__inner">
    <h2 class="recommendations__heading h2-standard" id="recommendations-heading">
      {{ section.settings.heading | default: 'You may also like' }}
    </h2>
    <div class="recommendations__grid grid grid--4" data-recommendations-grid aria-live="polite">
      <p class="recommendations__loading" data-recommendations-loading>Loading recommendations&hellip;</p>
    </div>
  </div>
</section>

<style>
  .recommendations {
    padding: var(--utp-y-d, var(--section-padding-y)) var(--utp-side-d, var(--section-padding-x));
  }
  .recommendations__heading {
    font-size: var(--type-section-size);
    font-weight: var(--type-section-weight);
    line-height: var(--type-section-leading);
    letter-spacing: var(--type-section-tracking);
    text-transform: none;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .recommendations__grid {
    min-height: 120px;
  }
  .recommendations__loading {
    grid-column: 1 / -1;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding: var(--space-9) 0;
  }
  .recommendations__empty {
    grid-column: 1 / -1;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding: var(--space-5) 0;
  }

  @media (max-width: 768px) {
    .recommendations {
      padding: var(--utp-y-m, var(--section-padding-y-mobile)) var(--utp-x-m, var(--section-padding-x-mobile));
    }
    .recommendations__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .recommendations__heading {
      font-size: var(--text-xl);
      margin-bottom: var(--space-6);
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('[data-recommendations]');
    if (!section) return;

    var productId = section.getAttribute('data-product-id');
    var limit = section.getAttribute('data-limit') || 4;
    var grid = section.querySelector('[data-recommendations-grid]');
    var loading = section.querySelector('[data-recommendations-loading]');

    if (!productId) {
      section.hidden = true;
      return;
    }

    var url = '/recommendations/products.json?product_id=' + productId + '&limit=' + limit;

    fetch(url)
      .then(function(response) { return response.json(); })
      .then(function(data) {
        if (loading) loading.remove();

        if (!data.products || data.products.length === 0) {
          section.hidden = true;
          return;
        }

        var html = '';
        data.products.forEach(function(product) {
          var image = product.featured_image || '';
          var priceFormatted = (product.price / 100).toFixed(2);
          var comparePrice = product.compare_at_price ? (product.compare_at_price / 100).toFixed(2) : null;

          html += '<div class="product-card">';
          html += '<a href="' + product.url + '" class="product-card__link">';
          if (image) {
            html += '<div class="product-card__media">';
            html += '<img src="' + image + '" alt="' + product.title.replace(/"/g, '&quot;') + '" loading="lazy" width="400" height="400" class="product-card__img" />';
            html += '</div>';
          }
          html += '<div class="product-card__content">';
          html += '<h3 class="product-card__name">' + product.title + '</h3>';
          html += '<p class="product-card__price">';
          if (comparePrice && comparePrice !== priceFormatted) {
            html += '<s style="color:var(--text-muted);font-weight:var(--weight-regular)">$' + comparePrice + '</s> ';
          }
          html += '$' + priceFormatted;
          html += '</p>';
          html += '</div></a></div>';
        });

        grid.innerHTML = html;
      })
      .catch(function() {
        section.hidden = true;
      });
  })();
</script>
{%- endif -%}

{% style %}
  {%- liquid
    assign te_y_d = 32
    assign te_side_d = 40
    assign te_y_m = 24
    assign te_x_m = 20
    assign u_y = section.settings.text_pad_y | default: te_y_d
    assign u_side = section.settings.side_padding | default: te_side_d
    assign u_y_m = section.settings.text_pad_y_mobile | default: te_y_m
    assign u_x_m = section.settings.text_pad_x_mobile | default: te_x_m
  -%}
  {%- if u_y != te_y_d or u_side != te_side_d -%}
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .recommendations {
      {%- if u_y != te_y_d -%}
      padding-top: {{ u_y }}px;
      padding-bottom: {{ u_y }}px;
      {%- endif -%}
      {%- if u_side != te_side_d -%}
      padding-left: {{ u_side }}px;
      padding-right: {{ u_side }}px;
      {%- endif -%}
    }
  }
  {%- endif -%}
  {%- if u_y_m != te_y_m or u_x_m != te_x_m -%}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .recommendations {
      {%- if u_y_m != te_y_m -%}
      padding-top: {{ u_y_m }}px;
      padding-bottom: {{ u_y_m }}px;
      {%- endif -%}
      {%- if u_x_m != te_x_m -%}
      padding-left: {{ u_x_m }}px;
      padding-right: {{ u_x_m }}px;
      {%- endif -%}
    }
  }
  {%- endif -%}
{% endstyle %}

{% schema %}
{
  "name": "Product Recommendations",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout — text padding"
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 32 — theme section gap)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 40)",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 24 — theme section gap)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 20)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations"
    }
  ]
}
{% endschema %}
