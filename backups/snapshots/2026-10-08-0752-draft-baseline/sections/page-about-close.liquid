{% comment %}
  About page — dark close CTA (v25 Locked)
{% endcomment %}

{%- liquid
  assign pac_y_d_def = 120
  assign pac_side_d_def = 20
  assign pac_y_m_def = 56
  assign pac_x_m_def = 20
  assign pac_fixed_d_y = false
  if section.settings.text_pad_y != pac_y_d_def
    assign pac_fixed_d_y = true
  endif
  assign pac_fixed_d_x = false
  if section.settings.side_padding != pac_side_d_def
    assign pac_fixed_d_x = true
  endif
  assign pac_fixed_m_y = false
  if section.settings.text_pad_y_mobile != pac_y_m_def
    assign pac_fixed_m_y = true
  endif
  assign pac_fixed_m_x = false
  if section.settings.text_pad_x_mobile != pac_x_m_def
    assign pac_fixed_m_x = true
  endif
-%}
<section
  class="page-about-close{% if pac_fixed_d_y %} page-about-close--fixed-pad-d-y{% endif %}{% if pac_fixed_d_x %} page-about-close--fixed-pad-d-x{% endif %}{% if pac_fixed_m_y %} page-about-close--fixed-pad-m-y{% endif %}{% if pac_fixed_m_x %} page-about-close--fixed-pad-m-x{% endif %}"
  {{ section.shopify_attributes }}
  aria-label="{{ section.settings.aria_label | escape }}"
  style="{% render 'unified-text-pads-vars', y_d: 120, side_d: 20, y_m: 56, x_m: 20 %}{% render 'type-override-vars', title_size: section.settings.title_size, title_weight: section.settings.title_weight, body_size: section.settings.body_size, body_weight: section.settings.body_weight, sub_size: section.settings.cta_size %}"
>
  {% if section.settings.heading != blank %}
    <h2 class="page-about-close__title">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.body != blank %}
    <p class="page-about-close__body">{{ section.settings.body }}</p>
  {% endif %}
  {% if section.settings.cta_text != blank %}
    <a class="page-about-close__cta" href="{{ section.settings.cta_url | default: '/collections/barre-pilates-yoga-shoe-sock-footwear' }}">
      {{ section.settings.cta_text }}
    </a>
  {% endif %}
</section>

{% style %}
  #shopify-section-{{ section.id }} .page-about-close {
    background: #faf8f6;
    color: #1c1916;
    padding: clamp(80px, 18vh, 160px) clamp(20px, 8vw, 8vw);
    text-align: center;
  }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .page-about-close--fixed-pad-d-y {
      padding-top: var(--utp-y-d);
      padding-bottom: var(--utp-y-d);
    }
    #shopify-section-{{ section.id }} .page-about-close--fixed-pad-d-x {
      padding-left: var(--utp-side-d);
      padding-right: var(--utp-side-d);
    }
  }
  #shopify-section-{{ section.id }} .page-about-close__title {
    font-size: var(--te-title-size, clamp(44px, 7vw, 88px));
    font-weight: var(--te-title-weight, 400);
    letter-spacing: -0.038em;
    line-height: 1.02;
    margin: 0 0 20px;
    color: #1c1916;
  }
  #shopify-section-{{ section.id }} .page-about-close__body {
    font-size: var(--te-body-size, 17px);
    font-weight: var(--te-body-weight, 400);
    line-height: 1.6;
    color: #6b645a;
    margin: 0 0 32px;
  }
  #shopify-section-{{ section.id }} .page-about-close__cta {
    display: inline-block;
    background: #1c1916;
    color: #fff;
    padding: 14px 28px;
    font-size: var(--te-sub-size, 14px);
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
  }
  #shopify-section-{{ section.id }} .page-about-close__cta:hover {
    background: #c45c3f;
    color: #fff;
    text-decoration: none;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-close { padding: 56px 20px; }
    #shopify-section-{{ section.id }} .page-about-close--fixed-pad-m-y {
      padding-top: var(--utp-y-m);
      padding-bottom: var(--utp-y-m);
    }
    #shopify-section-{{ section.id }} .page-about-close--fixed-pad-m-x {
      padding-left: var(--utp-x-m);
      padding-right: var(--utp-x-m);
    }
    #shopify-section-{{ section.id }} .page-about-close__title {
      font-size: var(--te-title-size, clamp(28px, 8vw, 40px));
    }
  }
{% endstyle %}

{%- comment -%} TE pads: Shopify's wrapper div owns id=shopify-section-<id>; '.page-about-close' is this section's root inside it, so the snippet's '#shopify-section-<id> .page-about-close' matches it. {%- endcomment -%}
{% render 'unified-text-pads-te-style', selector: '.page-about-close', y_d: 120, side_d: 20, y_m: 56, x_m: 20 %}

