{% comment %}
  Collection FAQ (DP-06) — abbreviated accordion + FAQPage schema
{% endcomment %}

{% render 'faq-accordion',
  items: section.blocks,
  heading: section.settings.heading,
  bg_class: section.settings.bg_class,
  include_schema: true,
  studio_core: section.settings.use_studio_bank
%}
<style>
  /* Per-page TE: Background cream = soft #faf8f6, white = #fff. Sitewide cream lock. */
  #shopify-section-{{ section.id }} .faq--cream { background: #faf8f6; }
  #shopify-section-{{ section.id }} .faq--white { background: #fff; }
  #shopify-section-{{ section.id }} .faq__heading {
    /* Type OS H2 Section on Shop All / PDP FAQ */
  }
  {%- if template.name == 'product' -%}
  /* Product pages: extra bottom room (one shared section gap) so the last question clears the sticky add-to-cart bar. */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .faq { padding-bottom: calc(var(--section-padding-y, 32px) + var(--space-section-mobile, 40px)); }
  }
  {%- endif -%}
</style>
{% style %}
  {%- comment -%} 10-03 text pads (e2813bd) restored 2026-10-06 r4 + live TE: reads section.settings directly. At defaults it emits the same theme padding vars the page uses today; a moved slider emits px. {%- endcomment -%}
  #shopify-section-{{ section.id }} .faq {
    background: {% if section.settings.bg_class == 'white' %}#fff{% else %}#faf8f6{% endif %};
    padding: {% if section.settings.text_pad_y != blank and section.settings.text_pad_y != 32 %}{{ section.settings.text_pad_y }}px{% else %}var(--section-padding-y){% endif %} {% if section.settings.side_padding != blank and section.settings.side_padding != 40 %}{{ section.settings.side_padding }}px{% else %}var(--section-padding-x){% endif %};
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .faq {
      padding: {% if section.settings.text_pad_y_mobile != blank and section.settings.text_pad_y_mobile != 32 %}{{ section.settings.text_pad_y_mobile }}px{% else %}var(--section-padding-y){% endif %} {% if section.settings.text_pad_x_mobile != blank and section.settings.text_pad_x_mobile != 16 %}{{ section.settings.text_pad_x_mobile }}px{% else %}var(--section-padding-x){% endif %};
      {%- if template.name == 'product' %}
      padding-bottom: calc({% if section.settings.text_pad_y_mobile != blank and section.settings.text_pad_y_mobile != 32 %}{{ section.settings.text_pad_y_mobile }}px{% else %}var(--section-padding-y, 32px){% endif %} + var(--space-section-mobile, 40px));
      {%- endif %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collection FAQ",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions from the studio",
      "info": "Family is brand Type OS — no font family picker."
    },
    { "type": "header", "content": "Section — FAQ" },
    {
      "type": "select",
      "id": "bg_class",
      "label": "Background",
      "info": "Cream = soft #faf8f6. White = #fff. Set per page in Theme Editor.",
      "options": [
        { "value": "cream", "label": "Cream (#faf8f6)" },
        { "value": "white", "label": "White" }
      ],
      "default": "cream"
    },
    {
      "type": "checkbox",
      "id": "use_studio_bank",
      "label": "Use shared studio FAQ",
      "default": false,
      "info": "On = Theme settings → Studio FAQ (Closed, Open, One-Offs, Coperni). Extra blocks below appear first. Leave off for Outdoor and Shop All."
    },
    {
      "type": "paragraph",
      "content": "When shared studio FAQ is off, items are the blocks below."
    },
    { "type": "header", "content": "Layout — text padding" },
    { "type": "range", "id": "text_pad_y", "label": "Text pad top & bottom — desktop (default 32)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "side_padding", "label": "Text pad left & right — desktop (default 40)", "min": 0, "max": 96, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "text_pad_y_mobile", "label": "Text pad top & bottom — phone (default 32)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "text_pad_x_mobile", "label": "Text pad left & right — phone (default 16)", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "header", "content": "Shared — Content" },
        { "type": "text", "id": "question", "label": "Heading", "info": "Question line." },
        { "type": "richtext", "id": "answer", "label": "Body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What’s the difference between Open Sole and Closed Sole?",
            "answer": "<p><strong>Closed Sole</strong> — heel and foot fully covered. <strong>Open Sole</strong> — heel exposed, mid-foot breathing hole. More grounded, barefoot feel. Natural toe splay. Both perform identically — same grip, same stability. Choice is preference and feel only. Same $74.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Are Performance Skins just expensive grip socks?",
            "answer": "<p>No. Traditional grip socks use silicone dots that wear off and fabric that absorbs sweat. Barreletics use a full-contact injection-molded grip surface you rinse and reuse — built as performance footwear, not disposable socks.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How long do they last?",
            "answer": "<p>The shoe may wear out. The grip does not — it's molded into the sole, so there's nothing to peel or flake. How long a pair lasts depends on how you wear them. Used for Pilates, barre, reformer, Lagree, and yoga, they hold up. One customer recently passed 1,000 classes on a single pair. Another is on year four.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What’s your return policy?",
            "answer": "<p>30-day returns on items in new, sellable condition. 90-day warranty against manufacturing defects. Complimentary shipping on orders over $150.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
