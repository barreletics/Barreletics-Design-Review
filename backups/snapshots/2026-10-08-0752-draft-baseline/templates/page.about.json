      "settings": {
        "title": "Our story",
        "lede": "<p>Patented Performance Skins for barre, Pilates, reformer, Megaformer, and studio fitness. Built because grip socks kept failing when grip mattered most.</p>",
        "byline": "Stefanie Miller, Founder",
        "pull_quote": "We didn't improve the grip sock. We made it obsolete.",
