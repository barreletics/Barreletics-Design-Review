{% comment %}
  Organization Schema (Enhanced)
  Extended Organization structured data for the About page.
  Render on about template: {% render 'organization-schema' %}
{% endcomment %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Barreletics",
  "url": "{{ shop.url }}",
  "logo": "{{ 'logo.png' | asset_url }}",
  "description": "Studio Performance Skins with 360° grip for barre, Pilates, reformer, and yoga. One pair replaces 6-8 grip socks per year.",
  "foundingCountry": "US",
  "sameAs": [
    "https://instagram.com/barreletics",
    "https://tiktok.com/@barreletics",
    "https://facebook.com/barreletics"
  ]
}
</script>
