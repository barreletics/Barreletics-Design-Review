{% comment %}
  Announcement Strip / Ticker
  Rotates promotional messages at page top.
  Source: Doc 04 (Component 1), Doc 11 (Navigation Architecture)

  Messages rotate every 4s with 320ms opacity crossfade.
  Pauses on hover. Static first slide on prefers-reduced-motion.

  Usage: {% render 'announcement-strip' %}
  Configured via section settings in theme customizer.
{% endcomment %}

{% assign slides = section.blocks %}
{% if slides.size > 0 %}
<div
  class="announcement-strip"
  data-announcement-strip
  role="region"
  aria-label="{{ 'general.accessibility.announcement' | t | default: 'Promotional messages' }}"
>
  <div class="announcement-strip__inner">
    {% for block in slides %}
      <div
        class="announcement-strip__slide{% if forloop.first %} is-active{% endif %}"
        data-slide-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.link_url != blank %}
          <a href="{{ block.settings.link_url }}" class="announcement-strip__link">
            {{ block.settings.text }}
          </a>
        {% else %}
          <span>{{ block.settings.text }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .announcement-strip {
    background: var(--color-charcoal);
    padding: 10px var(--section-padding-x);
    overflow: hidden;
    position: relative;
  }
  .announcement-strip__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
    position: relative;
    min-height: 1.4em;
  }
  .announcement-strip__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 320ms ease;
    font-size: 12px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    color: var(--color-white);
    line-height: 1.4;
    pointer-events: none;
  }
  .announcement-strip__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .announcement-strip__link {
    color: var(--color-white);
    text-decoration: none;
  }
  .announcement-strip__link:hover {
    text-decoration: underline;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-strip__slide { transition: none; }
  }
</style>

<script>
  (function() {
    const strip = document.querySelector('[data-announcement-strip]');
    if (!strip) return;

    const slides = strip.querySelectorAll('[data-slide-index]');
    if (slides.length <= 1) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    let current = 0;
    let paused = false;

    strip.addEventListener('mouseenter', function() { paused = true; });
    strip.addEventListener('mouseleave', function() { paused = false; });

    setInterval(function() {
      if (paused) return;
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, 4000);
  })();
</script>
{% endif %}
