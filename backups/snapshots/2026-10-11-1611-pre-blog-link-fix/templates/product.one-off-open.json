    "collection-faq": {
      "type": "collection-faq",
      "blocks": {
        "oo1": {
          "type": "faq_item",
          "settings": {
            "question": "What are One-Off colors?",
            "answer": "<p>One-Off colorways sit outside the regular Open Sole lineup. Construction and 360° grip stay the same; the color does not come back once it sells out.</p>"
          }
        },
        "oo2": {
          "type": "faq_item",
          "settings": {
            "question": "When a One-Off color sells out, will it come back?",
            "answer": "<p>No. One-Offs do not restock. Earlier drops stay gone. Buy the color while it is available.</p>"
          }
        },
        "oo3": {
          "type": "faq_item",
          "settings": {
            "question": "Are One-Offs the same shoe as core Closed Sole / Open Sole?",
            "answer": "<p>Yes. It is the same Open Sole Performance Skin \u2014 same grip, same stability. You are choosing a limited color, not a different shoe.</p>"
          }
        },
        "pdpcopy-faq-care": {
          "type": "faq_item",
          "settings": {
            "question": "How do I put on and care for my grippy shoes?",
            "answer": "<p><strong>How do I put on my grippy shoes?</strong> Pull from the top of the foot, not the straps, to help extend their lifespan.</p><p><strong>After class.</strong> When you wipe down your equipment, give your Barreletics a quick pass with the same wipe.</p><p><strong>Cleaning.</strong> Hand wash with warm soapy water. They dry in seconds. That's it.</p>"
          }
        },
        "pdpcopy-faq-returns": {
          "type": "faq_item",
          "settings": {
            "question": "How do returns, exchanges and the 90-day warranty work?",
            "answer": "<p>You have 30 days to return or exchange. Every pair also has a 90-day warranty against manufacturing defects. <a href=\"/pages/returns\">See our returns policy</a>.</p>"
          }
        }
      },
