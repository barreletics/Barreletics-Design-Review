{% comment %}
  Footer — Canonical
  Matches Doc 11 (Navigation Architecture): 4-column grid with separated links.
  Shop | Support | Company | Newsletter

  Usage: {% render 'footer' %}
{% endcomment %}

<footer class="site-footer" data-theme="dark" role="contentinfo">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__col">
        <h3 class="site-footer__heading">Shop</h3>
        <ul class="site-footer__links" role="list">
          <li><a href="/collections/barre-pilates-yoga-shoe-sock-footwear">All Grippy Shoes</a></li>
          <li><a href="/products/studio-performance-skin-footwear">Open Sole</a></li>
          <li><a href="/products/best-reformer-pilates-legree-workout-shoes">Closed Sole</a></li>
          <li><a href="/collections/outdoor">Outdoor</a></li>
          <li><a href="/collections/apparel">Apparel</a></li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h3 class="site-footer__heading">Support</h3>
        <ul class="site-footer__links" role="list">
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/shipping">Shipping</a></li>
          <li><a href="/pages/returns">Returns</a></li>
          <li><a href="/pages/warranty">Warranty</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h3 class="site-footer__heading">Company</h3>
        <ul class="site-footer__links" role="list">
          <li><a href="/pages/about">About Us</a></li>
          <li><a href="/blogs/journal">Journal</a></li>
          <li><a href="/collections/collaborations">Collaborations</a></li>
          <li><a href="/pages/compare-open-closed-sole">Compare Styles</a></li>
          <li><a href="/pages/partners">Partner Programs</a></li>
        </ul>
      </div>

      <div class="site-footer__col site-footer__col--newsletter">
        <h3 class="site-footer__heading">Join the list</h3>
        <p class="site-footer__newsletter-text">New drops and studio stories. Once or twice a quarter — never spam.</p>
        {% form 'customer', id: 'footer-newsletter' %}
          <div class="site-footer__form">
            <input
              type="email"
              name="contact[email]"
              placeholder="Your email"
              required
              autocomplete="email"
              aria-label="Email address"
              class="site-footer__input"
            />
            <input type="hidden" name="contact[tags]" value="newsletter" />
            <button type="submit" class="site-footer__submit">Sign Up</button>
          </div>
          <p class="site-footer__privacy">No spam. Unsubscribe anytime.</p>
        {% endform %}
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__social">
        <a href="https://instagram.com/barreletics" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="1" y="1" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.3"/><circle cx="9" cy="9" r="4" stroke="currentColor" stroke-width="1.3"/><circle cx="13.5" cy="4.5" r="1" fill="currentColor"/></svg>
        </a>
        <a href="https://tiktok.com/@barreletics" aria-label="TikTok" rel="noopener noreferrer" target="_blank">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M10 2v10a3 3 0 1 1-2-2.8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M10 2c2 0 3.5 1.5 4 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        </a>
        <a href="https://facebook.com/barreletics" aria-label="Facebook" rel="noopener noreferrer" target="_blank">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M10 16V10h2.5l.5-3H10V5.5c0-1 .5-1.5 1.5-1.5H13V1.5c-.5 0-1.5-.1-2.5-.1C8 1.4 7 3 7 5.2V7H4.5v3H7v6h3z" fill="currentColor"/></svg>
        </a>
      </div>
      <p class="site-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: var(--color-white);
    padding: 56px var(--section-padding-x) 32px;
  }
  .site-footer__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.2fr;
    gap: 40px;
  }
  .site-footer__heading {
    font-size: 12px;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-white);
    margin-bottom: 16px;
  }
  .site-footer__links li { margin-bottom: 10px; }
  .site-footer__links a {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color var(--transition-fast);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .site-footer__links a:hover { color: var(--color-white); text-decoration: none; }

  .site-footer__newsletter-text {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 16px;
    line-height: 1.5;
  }
  .site-footer__form {
    display: flex;
    gap: 8px;
  }
  .site-footer__input {
    flex: 1;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-button);
    font-size: 14px;
    color: var(--color-white);
    font-family: var(--font-family);
  }
  .site-footer__input::placeholder { color: rgba(255, 255, 255, 0.4); }
  .site-footer__input:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.5);
  }
  .site-footer__submit {
    padding: 12px 20px;
    background: var(--color-white);
    color: var(--color-charcoal);
    border: none;
    border-radius: var(--radius-button);
    font-size: 12px;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    transition: opacity var(--transition-fast);
    min-height: 44px;
  }
  .site-footer__submit:hover { opacity: 0.85; }
  .site-footer__privacy {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 10px;
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .site-footer__social {
    display: flex;
    gap: 16px;
  }
  .site-footer__social a {
    color: rgba(255, 255, 255, 0.6);
    transition: color var(--transition-fast);
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .site-footer__social a:hover { color: var(--color-white); text-decoration: none; }
  .site-footer__copyright {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 768px) {
    .site-footer { padding: 48px 16px 24px; }
    .site-footer__grid { grid-template-columns: 1fr; gap: 32px; }
    .site-footer__bottom { flex-direction: column; gap: 16px; text-align: center; }
  }
</style>
