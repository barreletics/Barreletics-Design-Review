    "collection-faq": {
      "type": "collection-faq",
      "blocks": {
        "f1": {
          "type": "faq_item",
          "settings": {
            "question": "How should I size the high-rise yoga pants?",
            "answer": "<p><strong>Size down.</strong> Super-high rise Italian 4-way stretch compression runs large. Use the size chart for waist, hip, and inseam. Most studio athletes drop one size for a locked-in hold.</p>"
          }
        },
        "f2": {
          "type": "faq_item",
          "settings": {
            "question": "Are the knees padded or reinforced?",
            "answer": "<p><strong>Reinforced, not bulky pads.</strong> Built-up knee panels support kneeling, transitions, and floor work in barre, Pilates, and yoga without looking like gear.</p>"
          }
        },
        "f3": {
          "type": "faq_item",
          "settings": {
            "question": "Will the tees and pants pill?",
            "answer": "<p><strong>No.</strong> Performance fabric tees and reinforced-knee pants are built to stay smooth class after class, no pilling, no bagging out.</p>"
          }
        },
        "f4": {
          "type": "faq_item",
          "settings": {
            "question": "What workouts are they built for?",
            "answer": "<p>Barre, mat Pilates, reformer, Classical apparatus, Megaformer, Lagree, yoga, and hot yoga. Compression pants for holds and floor work; soft performance tees for breathable layers.</p>"
          }
        },
        "f5": {
          "type": "faq_item",
          "settings": {
            "question": "How do I wash Barreletics apparel?",
            "answer": "<p>Machine wash cold, delicate, inside out. Lay flat to dry. Skip high heat. It kills compression and stretch.</p>"
          }
        },
        "f6": {
          "type": "faq_item",
          "settings": {
            "question": "What's your return policy on apparel?",
            "answer": "<p>30-day returns on apparel unused, unworn, unwashed, with tags and original packaging. Free shipping on orders over $150. Ships in 1-2 days. Apparel does not include a warranty.</p>"
          }
        }
      },
