{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign media_width = block.settings.media_width
  assign text_width = 100 | minus: media_width
%}

{% style %}
  .ai-media-text-outer-{{ ai_gen_id }} {
    margin-top: {{ block.settings.section_margin_top }}px;
    margin-bottom: {{ block.settings.section_margin_bottom }}px;
    padding-left: {{ block.settings.section_margin_sides }}px;
    padding-right: {{ block.settings.section_margin_sides }}px;
    background-color: {{ block.settings.section_background_color }};
    {% if block.settings.section_background_gradient != blank %}
      background-image: {{ block.settings.section_background_gradient }};
    {% endif %}
  }

  .ai-media-text-section-{{ ai_gen_id }} {
    {% unless block.settings.full_width %}
      max-width: {{ block.settings.section_content_width }}px;
      margin-left: auto;
      margin-right: auto;
    {% endunless %}
  }

  .ai-media-text-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    align-items: stretch;
    {% if block.settings.desktop_layout == 'right' %}
      flex-direction: row-reverse;
    {% else %}
      flex-direction: row;
    {% endif %}
  }

  .ai-media-text-media-{{ ai_gen_id }} {
    flex: 0 0 {{ media_width }}%;
    max-width: {{ media_width }}%;
    background-color: {{ block.settings.content_background }};
    border-radius: {{ block.settings.box_roundness }}px;
    overflow: hidden;
    position: relative;
    {% if block.settings.height_style == 'fixed' %}
      height: {{ block.settings.box_height }}px;
    {% elsif block.settings.height_style == 'aspect_ratio' %}
      {% if block.settings.aspect_ratio_desktop == 'square' %}
        aspect-ratio: 1 / 1;
      {% elsif block.settings.aspect_ratio_desktop == 'portrait' %}
        aspect-ratio: 3 / 4;
      {% elsif block.settings.aspect_ratio_desktop == 'landscape' %}
        aspect-ratio: 16 / 9;
      {% endif %}
    {% endif %}
  }

  .ai-media-text-media-content-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-media-text-media-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    display: block;
  }

  .ai-media-text-media-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.video_fit }};
    display: block;
  }

  .ai-media-text-media-{{ ai_gen_id }} iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: none;
  }

  .ai-media-text-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-media-text-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-media-text-play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 16px 24px;
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 2;
    font-size: 18px;
    backdrop-filter: blur(10px);
    opacity: 0.8;
  }

  .ai-media-text-play-button-{{ ai_gen_id }}:hover {
    opacity: 1;
    background-color: rgba(255, 255, 255, 0.3);
    border-color: rgba(255, 255, 255, 0.8);
  }

  .ai-media-text-play-button-{{ ai_gen_id }}.playing {
    opacity: 0;
    pointer-events: none;
  }

  .ai-media-text-play-button-{{ ai_gen_id }}.paused {
    opacity: 0.6;
  }

  .ai-media-text-play-button-{{ ai_gen_id }}.paused:hover {
    opacity: 1;
  }

  .ai-media-text-content-{{ ai_gen_id }} {
    flex: 0 0 {{ text_width }}%;
    max-width: {{ text_width }}%;
    background-color: {{ block.settings.content_background }};
    border-radius: {{ block.settings.box_roundness }}px;
    padding: {{ block.settings.content_padding_vertical }}px {{ block.settings.content_padding_horizontal }}px;
    display: flex;
    flex-direction: column;
    text-align: {{ block.settings.text_align }};
    {% if block.settings.height_style == 'fixed' %}
      min-height: {{ block.settings.box_height }}px;
    {% endif %}
    {% if block.settings.vertical_align == 'top' %}
      justify-content: flex-start;
    {% elsif block.settings.vertical_align == 'center' %}
      justify-content: center;
    {% else %}
      justify-content: flex-end;
    {% endif %}
  }

  .ai-media-text-badge-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    {% if block.settings.text_align == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_align == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-media-text-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    font-size: {{ block.settings.badge_font_size }}px;
    line-height: 1;
  }

  .ai-media-text-stars-{{ ai_gen_id }} span {
    color: {{ block.settings.star_color }};
  }

  .ai-media-text-badge-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.badge_font_size }}px;
    font-family: {{ block.settings.badge_font.family }}, {{ block.settings.badge_font.fallback_families }};
    font-weight: {{ block.settings.badge_font.weight }};
    font-style: {{ block.settings.badge_font.style }};
    color: {{ block.settings.badge_text_color }};
    line-height: {{ block.settings.badge_line_height }};
  }

  .ai-media-text-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    color: {{ block.settings.heading_color }};
    line-height: {{ block.settings.heading_line_height }};
    margin: 0 0 16px 0;
  }

  .ai-media-text-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_font_size }}px;
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    color: {{ block.settings.subheading_color }};
    line-height: {{ block.settings.subheading_line_height }};
    margin: 0 0 24px 0;
  }

  .ai-media-text-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.cta_button_padding_vertical }}px {{ block.settings.cta_button_padding_horizontal }}px;
    background-color: {{ block.settings.cta_button_bg_color }};
    color: {{ block.settings.cta_button_text_color }};
    font-size: {{ block.settings.cta_button_font_size }}px;
    font-family: {{ block.settings.cta_button_font.family }}, {{ block.settings.cta_button_font.fallback_families }};
    font-weight: {{ block.settings.cta_button_font.weight }};
    font-style: {{ block.settings.cta_button_font.style }};
    border-radius: {{ block.settings.cta_button_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    width: {{ block.settings.cta_button_width }}%;
    max-width: 100%;
    text-align: center;
    margin-bottom: 16px;
  }

  .ai-media-text-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_button_hover_bg_color }};
    color: {{ block.settings.cta_button_hover_text_color }};
  }

  .ai-media-text-footer-{{ ai_gen_id }} {
    font-size: {{ block.settings.footer_font_size }}px;
    font-family: {{ block.settings.footer_font.family }}, {{ block.settings.footer_font.fallback_families }};
    font-weight: {{ block.settings.footer_font.weight }};
    font-style: {{ block.settings.footer_font.style }};
    color: {{ block.settings.footer_color }};
    line-height: {{ block.settings.footer_line_height }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-media-text-outer-{{ ai_gen_id }} {
      padding-left: {{ block.settings.section_margin_sides_mobile }}px;
      padding-right: {{ block.settings.section_margin_sides_mobile }}px;
    }

    .ai-media-text-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.gap_mobile }}px;
      {% if block.settings.mobile_layout == 'bottom' %}
        flex-direction: column-reverse;
      {% endif %}
    }

    .ai-media-text-media-{{ ai_gen_id }},
    .ai-media-text-content-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .ai-media-text-media-{{ ai_gen_id }} {
      {% if block.settings.mobile_height_style == 'aspect_ratio' %}
        height: auto;
        {% if block.settings.aspect_ratio_mobile == 'square' %}
          aspect-ratio: 1 / 1;
        {% elsif block.settings.aspect_ratio_mobile == 'portrait' %}
          aspect-ratio: 3 / 4;
        {% elsif block.settings.aspect_ratio_mobile == 'landscape' %}
          aspect-ratio: 16 / 9;
        {% endif %}
      {% elsif block.settings.mobile_height_style == 'fixed' %}
        height: {{ block.settings.mobile_box_height }}px;
      {% else %}
        height: auto;
      {% endif %}
    }

    .ai-media-text-content-{{ ai_gen_id }} {
      text-align: {{ block.settings.text_align_mobile }};
      padding: {{ block.settings.content_padding_vertical_mobile }}px {{ block.settings.content_padding_horizontal_mobile }}px;
      {% if block.settings.mobile_height_style == 'fixed' %}
        min-height: {{ block.settings.mobile_box_height }}px;
      {% else %}
        min-height: auto;
      {% endif %}
      {% if block.settings.text_align_mobile == 'center' %}
        align-items: center;
      {% elsif block.settings.text_align_mobile == 'right' %}
        align-items: flex-end;
      {% else %}
        align-items: flex-start;
      {% endif %}
    }

    .ai-media-text-badge-{{ ai_gen_id }} {
      {% if block.settings.text_align_mobile == 'center' %}
        justify-content: center;
      {% elsif block.settings.text_align_mobile == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .ai-media-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size_mobile }}px;
    }

    .ai-media-text-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_font_size_mobile }}px;
    }

    .ai-media-text-cta-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.cta_button_font_size_mobile }}px;
      width: {{ block.settings.cta_button_width_mobile }}%;
    }

    .ai-media-text-footer-{{ ai_gen_id }} {
      font-size: {{ block.settings.footer_font_size_mobile }}px;
    }

    .ai-media-text-badge-text-{{ ai_gen_id }},
    .ai-media-text-stars-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_font_size_mobile }}px;
    }
  }

  {% if block.settings.hide_on_cart %}
    .template-cart .ai-media-text-outer-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  {% if block.settings.hide_on_blog %}
    .template-blog .ai-media-text-outer-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  {% if block.settings.hide_on_article %}
    .template-article .ai-media-text-outer-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  {% if block.settings.hide_on_policy %}
    .template-policy .ai-media-text-outer-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  {% if block.settings.hide_on_product %}
    .template-product .ai-media-text-outer-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  {% if block.settings.hide_on_collection %}
    .template-collection .ai-media-text-outer-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}
{% endstyle %}

<div class="ai-media-text-outer-{{ ai_gen_id }}">
  <media-text-section-{{ ai_gen_id }} class="ai-media-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-media-text-container-{{ ai_gen_id }}">
      <div class="ai-media-text-media-{{ ai_gen_id }}">
        <div class="ai-media-text-media-content-{{ ai_gen_id }}">
          {% if block.settings.media_type == 'video' %}
            {% if block.settings.video_upload != blank %}
              <video
                class="ai-media-text-video-{{ ai_gen_id }}"
                {% if block.settings.video_autoplay %}autoplay{% endif %}
                {% if block.settings.video_loop %}loop{% endif %}
                {% if block.settings.video_mute %}muted{% endif %}
                playsinline
                data-video-id="{{ ai_gen_id }}"
                {% if block.settings.lazy_load %}loading="lazy"{% endif %}
              >
                {% for source in block.settings.video_upload.sources %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endfor %}
              </video>
              {% unless block.settings.video_autoplay %}
                <button class="ai-media-text-play-button-{{ ai_gen_id }}" data-play-button="{{ ai_gen_id }}" aria-label="Play video">
                  ▶
                </button>
              {% endunless %}
            {% elsif block.settings.video_url != blank %}
              {% if block.settings.video_url.type == 'youtube' %}
                <iframe
                  src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay={% if block.settings.video_autoplay %}1{% else %}0{% endif %}&loop={% if block.settings.video_loop %}1{% else %}0{% endif %}&mute={% if block.settings.video_mute %}1{% else %}0{% endif %}&controls=0&modestbranding=1&rel=0"
                  frameborder="0"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  {% if block.settings.lazy_load %}loading="lazy"{% endif %}
                ></iframe>
              {% elsif block.settings.video_url.type == 'vimeo' %}
                <iframe
                  src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay={% if block.settings.video_autoplay %}1{% else %}0{% endif %}&loop={% if block.settings.video_loop %}1{% else %}0{% endif %}&muted={% if block.settings.video_mute %}1{% else %}0{% endif %}&controls=0"
                  frameborder="0"
                  allow="autoplay; fullscreen"
                  allowfullscreen
                  {% if block.settings.lazy_load %}loading="lazy"{% endif %}
                ></iframe>
              {% endif %}
            {% else %}
              <div class="ai-media-text-placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          {% else %}
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt="{{ block.settings.image.alt | escape }}"
                {% if block.settings.lazy_load %}loading="lazy"{% endif %}
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {% else %}
              <div class="ai-media-text-placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          {% endif %}
        </div>
      </div>

      <div class="ai-media-text-content-{{ ai_gen_id }}">
        {% if block.settings.show_badge and block.settings.badge_text != blank %}
          <div class="ai-media-text-badge-{{ ai_gen_id }}">
            {% if block.settings.show_stars %}
              <div class="ai-media-text-stars-{{ ai_gen_id }}">
                <span>★</span>
                <span>★</span>
                <span>★</span>
                <span>★</span>
                <span>★</span>
              </div>
            {% endif %}
            <div class="ai-media-text-badge-text-{{ ai_gen_id }}">
              {{ block.settings.badge_text }}
            </div>
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <div class="ai-media-text-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </div>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <div class="ai-media-text-subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </div>
        {% endif %}

        {% if block.settings.button_label != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-media-text-cta-button-{{ ai_gen_id }}">
            {{ block.settings.button_label }}
          </a>
        {% endif %}

        {% if block.settings.footer_text != blank %}
          <div class="ai-media-text-footer-{{ ai_gen_id }}">
            {{ block.settings.footer_text }}
          </div>
        {% endif %}
      </div>
    </div>
  </media-text-section-{{ ai_gen_id }}>
</div>

<script>
  (function() {
    class MediaTextSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.video = this.querySelector('.ai-media-text-video-{{ ai_gen_id }}');
        this.playButton = this.querySelector('[data-play-button="{{ ai_gen_id }}"]');

        if (this.video && this.playButton) {
          this.setupVideoControls();
        }
      }

      setupVideoControls() {
        this.playButton.addEventListener('click', () => {
          if (this.video.paused) {
            this.video.play();
            this.playButton.classList.add('playing');
            this.playButton.textContent = '❚❚';
          } else {
            this.video.pause();
            this.playButton.classList.remove('playing');
            this.playButton.classList.add('paused');
            this.playButton.textContent = '▶';
          }
        });

        this.video.addEventListener('click', () => {
          if (this.video.paused) {
            this.video.play();
            this.playButton.classList.add('playing');
            this.playButton.classList.remove('paused');
          } else {
            this.video.pause();
            this.playButton.classList.remove('playing');
            this.playButton.classList.add('paused');
          }
        });

        this.video.addEventListener('play', () => {
          this.playButton.classList.add('playing');
          this.playButton.classList.remove('paused');
        });

        this.video.addEventListener('pause', () => {
          this.playButton.classList.remove('playing');
          this.playButton.classList.add('paused');
        });
      }
    }

    customElements.define('media-text-section-{{ ai_gen_id }}', MediaTextSection{{ ai_gen_id }});
  })();
</script>

