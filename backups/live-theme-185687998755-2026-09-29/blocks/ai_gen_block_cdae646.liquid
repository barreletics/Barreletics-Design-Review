{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    width: 100%;
  }

  .ai-grid-item-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: {{ block.settings.box_background_color }};
  }

  .ai-media-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-position: center;
  }

  .ai-image-fit-contain-{{ ai_gen_id }} {
    object-fit: contain;
  }

  .ai-image-fit-cover-{{ ai_gen_id }} {
    object-fit: cover;
  }

  .ai-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 20px;
    z-index: 2;
  }

  .ai-content-top-{{ ai_gen_id }} {
    justify-content: flex-start;
  }

  .ai-content-center-{{ ai_gen_id }} {
    justify-content: center;
  }

  .ai-content-bottom-{{ ai_gen_id }} {
    justify-content: flex-end;
  }

  .ai-text-{{ ai_gen_id }} {
    margin: 0 0 10px;
  }

  .ai-text-white-{{ ai_gen_id }} {
    color: #ffffff;
  }

  .ai-text-black-{{ ai_gen_id }} {
    color: #000000;
  }

  .ai-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    text-decoration: none;
    border-radius: 4px;
    text-align: center;
    align-self: flex-start;
  }

  @media screen and (max-width: 749px) {
    .ai-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

<div class="ai-grid-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% for i in (1..9) %}
    {% liquid
      assign image_key = 'item_' | append: i | append: '_image'
      assign video_key = 'item_' | append: i | append: '_video'
      assign text_key = 'item_' | append: i | append: '_text'
      assign button_text_key = 'item_' | append: i | append: '_button_text'
      assign button_link_key = 'item_' | append: i | append: '_button_link'
      assign button_bg_key = 'item_' | append: i | append: '_button_bg'
      assign button_text_color_key = 'item_' | append: i | append: '_button_text_color'
      assign overlay_color_key = 'item_' | append: i | append: '_overlay_color'
      assign overlay_opacity_key = 'item_' | append: i | append: '_overlay_opacity'
      assign text_position_key = 'item_' | append: i | append: '_text_position'
      assign text_color_key = 'item_' | append: i | append: '_text_color'
      assign image_fit_key = 'item_' | append: i | append: '_image_fit'

      assign image = block.settings[image_key]
      assign video = block.settings[video_key]
      assign text = block.settings[text_key]
      assign button_text = block.settings[button_text_key]
      assign button_link = block.settings[button_link_key]
      assign button_bg = block.settings[button_bg_key]
      assign button_text_color = block.settings[button_text_color_key]
      assign overlay_color = block.settings[overlay_color_key]
      assign overlay_opacity = block.settings[overlay_opacity_key]
      assign text_position = block.settings[text_position_key]
      assign text_color = block.settings[text_color_key]
      assign image_fit = block.settings[image_fit_key]
    %}

    <div class="ai-grid-item-{{ ai_gen_id }}">
      <div class="ai-media-wrapper-{{ ai_gen_id }}">
        {% if video %}
          <video
            class="ai-video-{{ ai_gen_id }}"
            autoplay
            loop
            muted
            playsinline
          >
            <source src="{{ video }}" type="video/mp4">
          </video>
        {% elsif image %}
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            class="ai-image-{{ ai_gen_id }} ai-image-fit-{{ image_fit }}-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
        {% else %}
          <div class="ai-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if overlay_opacity > 0 %}
        <div
          class="ai-overlay-{{ ai_gen_id }}"
          style="background-color: {{ overlay_color }}; opacity: {{ overlay_opacity | divided_by: 100.0 }};"
        ></div>
      {% endif %}

      {% if text != blank or button_text != blank %}
        <div class="ai-content-{{ ai_gen_id }} ai-content-{{ text_position }}-{{ ai_gen_id }}">
          {% if text != blank %}
            <div class="ai-text-{{ ai_gen_id }} ai-text-{{ text_color }}-{{ ai_gen_id }}">
              {{ text }}
            </div>
          {% endif %}
          {% if button_text != blank %}
            <a
              href="{{ button_link }}"
              class="ai-button-{{ ai_gen_id }}"
              style="background-color: {{ button_bg }}; color: {{ button_text_color }};"
            >
              {{ button_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>

