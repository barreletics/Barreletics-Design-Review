{% doc %}
  @prompt
    build global section like the Paper theme by Brickspace Lab, that aint no Paper theme style? , this is cool but your image layout is off. also make video an option with a sale price on or off function. and make it global on any page, looks great. Add a rich text edior and font style for each font field. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-paper-section-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    position: relative;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-paper-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .ai-paper-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-paper-grid-{{ ai_gen_id }}.reverse {
    direction: rtl;
  }

  .ai-paper-grid-{{ ai_gen_id }}.reverse > * {
    direction: ltr;
  }

  .ai-paper-content-{{ ai_gen_id }} {
    z-index: 2;
  }

  .ai-paper-eyebrow-{{ ai_gen_id }} {
    font-family: {{ block.settings.eyebrow_font.family }}, {{ block.settings.eyebrow_font.fallback_families }};
    font-weight: {{ block.settings.eyebrow_font.weight }};
    font-style: {{ block.settings.eyebrow_font.style }};
    font-size: {{ block.settings.eyebrow_size }}px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: 20px;
  }

  .ai-paper-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
    color: {{ block.settings.heading_color }};
    margin: 0 0 30px 0;
  }

  .ai-paper-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin-bottom: 40px;
  }

  .ai-paper-text-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-paper-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-paper-text-{{ ai_gen_id }} a {
    color: {{ block.settings.heading_color }};
    text-decoration: underline;
  }

  .ai-paper-text-{{ ai_gen_id }} strong {
    font-weight: 700;
  }

  .ai-paper-text-{{ ai_gen_id }} em {
    font-style: italic;
  }

  .ai-paper-price-{{ ai_gen_id }} {
  display: flex;
  align-items: baseline;
  gap: 15px;
  margin-bottom: 30px;
}


  .ai-paper-price-current-{{ ai_gen_id }} {
    font-family: {{ block.settings.price_font.family }}, {{ block.settings.price_font.fallback_families }};
    font-weight: {{ block.settings.price_font.weight }};
    font-style: {{ block.settings.price_font.style }};
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-paper-price-compare-{{ ai_gen_id }} {
    font-family: {{ block.settings.price_font.family }}, {{ block.settings.price_font.fallback_families }};
    font-weight: {{ block.settings.price_font.weight }};
    font-style: {{ block.settings.price_font.style }};
    font-size: {{ block.settings.price_size | times: 0.8 }}px;
    text-decoration: line-through;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-paper-price-badge-{{ ai_gen_id }} {
  display: inline-block;
  background-color: {{ block.settings.sale_badge_color }};
  color: {{ block.settings.sale_badge_text_color }};
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;

  }

  .ai-paper-button-{{ ai_gen_id }} {
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-style: {{ block.settings.button_font.style }};
    display: inline-block;
    padding: 18px 40px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_text_size }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: {{ block.settings.button_radius }}px;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_bg_color }};
  }

  .ai-paper-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
    border-color: {{ block.settings.button_hover_bg }};
    transform: translateY(-2px);
  }

  .ai-paper-media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.media_radius }}px;
  }

  .ai-paper-media-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-paper-media-{{ ai_gen_id }} video {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-paper-media-placeholder-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.media_radius }}px;
  }

  .ai-paper-media-placeholder-{{ ai_gen_id }} svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 60%;
  }

  .ai-paper-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-paper-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-paper-grid-{{ ai_gen_id }}.reverse {
      direction: ltr;
    }

    .ai-paper-container-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-paper-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-paper-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-paper-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-paper-container-{{ ai_gen_id }}">
    <div class="ai-paper-grid-{{ ai_gen_id }} {% if block.settings.image_position == 'left' %}reverse{% endif %}">
      
      <div class="ai-paper-content-{{ ai_gen_id }}">
        {% if block.settings.eyebrow != blank %}
          <div class="ai-paper-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-paper-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-paper-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}

        {% if block.settings.show_price %}
          <div class="ai-paper-price-{{ ai_gen_id }}">
            {% if block.settings.current_price != blank %}
              <span class="ai-paper-price-current-{{ ai_gen_id }}">{{ block.settings.current_price }}</span>
            {% endif %}
            
            {% if block.settings.show_sale and block.settings.compare_price != blank %}
              <span class="ai-paper-price-compare-{{ ai_gen_id }}">{{ block.settings.compare_price }}</span>
              <span class="ai-paper-price-badge-{{ ai_gen_id }}">Sale</span>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-paper-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>

      <div class="ai-paper-media-{{ ai_gen_id }}">
        {% if block.settings.media_type == 'video' and block.settings.video_url != blank %}
          <video 
            autoplay 
            muted 
            loop 
            playsinline
            {% if block.settings.video_url contains 'mp4' or block.settings.video_url contains 'webm' %}
              src="{{ block.settings.video_url }}"
            {% endif %}
          >
            {% if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' %}
              <iframe 
                src="{{ block.settings.video_url }}" 
                frameborder="0" 
                allow="autoplay; encrypted-media" 
                allowfullscreen
                style="width: 100%; height: 100%; position: absolute; top: 0; left: 0;"
              ></iframe>
            {% endif %}
          </video>
        {% elsif block.settings.media_type == 'image' and block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1400 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-paper-media-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-paper-empty-state-{{ ai_gen_id }}">
              Add an image or video
            </div>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
