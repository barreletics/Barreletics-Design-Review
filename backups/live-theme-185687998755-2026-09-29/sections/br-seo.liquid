{% comment %}
  Barreletics SEO — Streamline by Archetype.
  Theme-update safe: custom section only. Adds WebSite + Organization JSON-LD for Google.
  Does not replace or override any theme SEO (title, meta, canonical, OG). Add once in Customize.
{% endcomment %}
{%- liquid
  assign shop_domain = shop.url
  assign search_url_template = shop_domain | append: '/search?q={search_term_string}'
-%}
<div class="br-seo-jsonld" aria-hidden="true" style="display: none;">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop_domain | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": {{ search_url_template | json }}
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop_domain | json }}
    {%- if section.settings.logo != blank -%}
    ,"logo": {
      "@type": "ImageObject",
      "url": {{ section.settings.logo | image_url: width: 512 | prepend: 'https:' | json }}
    }
    {%- endif -%}
  }
  </script>
</div>

{% schema %}
{
  "name": "Barreletics SEO",
  "tag": "section",
  "class": "br-seo-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds WebSite and Organization structured data for Google. No visible output. Add once (e.g. top of homepage or main template)."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Organization logo (optional)",
      "info": "Used in Organization schema. Leave blank to use name and URL only."
    }
  ],
  "presets": [
    {
      "name": "Barreletics SEO"
    }
  ]
}
{% endschema %}
