{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}
 {% liquid
  assign should_display = false
  
  if template.name == 'index' and section.settings.show_on_home
    assign should_display = true
  elsif template.name == 'product' and section.settings.show_on_product
    assign should_display = true
  elsif template.name == 'collection' and section.settings.show_on_collection
    assign should_display = true
  elsif template.name == 'page' and section.settings.show_on_pages
    assign should_display = true
  elsif template.name == 'blog' and section.settings.show_on_blog
    assign should_display = true
  elsif template.name == 'article' and section.settings.show_on_article
    assign should_display = true
  elsif template.name == 'cart' and section.settings.show_on_cart
    assign should_display = true
  elsif template.name == 'search' and section.settings.show_on_search
    assign should_display = true
  endif
%}


{% style %}
  .ai-image-grid-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ section.settings.section_padding }}px;
    background-color: {{ section.settings.section_bg_color }};
  }

  .ai-image-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.boxes_per_row }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-image-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.corner_radius }}px;
    background-color: {{ section.settings.box_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
  }

  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="top-left"] { align-items: flex-start; justify-content: flex-start; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="top-center"] { align-items: flex-start; justify-content: center; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="top-right"] { align-items: flex-start; justify-content: flex-end; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="center-left"] { align-items: center; justify-content: flex-start; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="center"] { align-items: center; justify-content: center; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="center-slightly-above"] { align-items: center; justify-content: center; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="center-slightly-above"] .ai-image-grid__content-{{ ai_gen_id }} { transform: translateY(-12%); }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="center-above"] { align-items: center; justify-content: center; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="center-above"] .ai-image-grid__content-{{ ai_gen_id }} { transform: translateY(-25%); }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="center-well-above"] { align-items: center; justify-content: center; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="center-well-above"] .ai-image-grid__content-{{ ai_gen_id }} { transform: translateY(-38%); }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="center-right"] { align-items: center; justify-content: flex-end; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="bottom-left"] { align-items: flex-end; justify-content: flex-start; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="bottom-center"] { align-items: flex-end; justify-content: center; }
  .ai-image-grid__item-{{ ai_gen_id }}[data-content-position="bottom-right"] { align-items: flex-end; justify-content: flex-end; }

  {% if section.settings.featured_box_enabled %}
    .ai-image-grid__item-{{ ai_gen_id }}:nth-child({{ section.settings.featured_box_position }}) {
      grid-column: span {{ section.settings.featured_box_width }};
      grid-row: span {{ section.settings.featured_box_height }};
    }
    .ai-image-grid__item-{{ ai_gen_id }}:nth-child({{ section.settings.featured_box_position }})::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, {{ section.settings.featured_box_overlay | divided_by: 100.0 }});
      z-index: 1;
      pointer-events: none;
    }
  {% endif %}

  .ai-image-grid__item-{{ ai_gen_id }}.ai-incomplete-row-{{ ai_gen_id }} {
    display: none;
  }

  .ai-image-grid__media-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-image-grid__image-{{ ai_gen_id }},
  .ai-image-grid__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    {% if section.settings.media_fit == 'fill' %}
      object-fit: cover;
      transform: scale(1.2);
    {% else %}
      object-fit: {{ section.settings.media_fit }};
    {% endif %}
    object-position: {{ section.settings.media_position }};
  }

  .ai-image-grid__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: 30px;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
  }

  .ai-image-grid__title-{{ ai_gen_id }} {
    font-family: 'Roboto', sans-serif;
    font-weight: {{ section.settings.title_font_weight }};
    font-size: {{ section.settings.title_size }}px;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .ai-image-grid__subtitle-{{ ai_gen_id }} {
    font-family: 'Roboto', sans-serif;
    font-weight: {{ section.settings.subtitle_font_weight }};
    font-size: {{ section.settings.subtitle_size }}px;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .ai-image-grid__description-{{ ai_gen_id }} {
    font-family: 'Roboto', sans-serif;
    font-weight: {{ section.settings.description_font_weight }};
    font-size: {{ section.settings.description_size }}px;
    margin: 0 0 20px;
    line-height: 1.5;
  }

  .ai-image-grid__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 30px;
    background-color: transparent;
    border: none;
    color: inherit;
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-family: 'Roboto', sans-serif;
    font-weight: {{ section.settings.button_font_weight }};
    font-size: {{ section.settings.button_size }}px;
    transition: all 0.3s ease;
  }

  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="white"] .ai-image-grid__title-{{ ai_gen_id }},
  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="white"] .ai-image-grid__subtitle-{{ ai_gen_id }},
  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="white"] .ai-image-grid__description-{{ ai_gen_id }} {
    color: #ffffff;
  }

  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="white"] .ai-image-grid__button-{{ ai_gen_id }} {
    {% if section.settings.button_style == 'outline' %}
      background-color: transparent;
      border: 2px solid #ffffff;
      color: #ffffff;
    {% elsif section.settings.button_style == 'transparent' %}
      background-color: transparent;
      color: #ffffff;
    {% elsif section.settings.button_style == 'filled-white' %}
      background-color: #ffffff;
      color: #000000;
    {% else %}
      background-color: #000000;
      color: #ffffff;
    {% endif %}
  }

  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="white"] .ai-image-grid__button-{{ ai_gen_id }}:hover {
    {% if section.settings.button_style == 'outline' %}
      background-color: #ffffff;
      border-color: #ffffff;
      color: #000000;
    {% elsif section.settings.button_style == 'transparent' %}
      background-color: transparent;
      color: #ffffff;
    {% elsif section.settings.button_style == 'filled-white' %}
      background-color: #e3e3e3;
      color: #000000;
    {% else %}
      background-color: #333333;
      color: #ffffff;
    {% endif %}
  }

  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="black"] .ai-image-grid__title-{{ ai_gen_id }},
  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="black"] .ai-image-grid__subtitle-{{ ai_gen_id }},
  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="black"] .ai-image-grid__description-{{ ai_gen_id }} {
    color: #000000;
  }

  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="black"] .ai-image-grid__button-{{ ai_gen_id }} {
    {% if section.settings.button_style == 'outline' %}
      background-color: transparent;
      border: 2px solid #000000;
      color: #000000;
    {% elsif section.settings.button_style == 'transparent' %}
      background-color: transparent;
      color: #000000;
    {% elsif section.settings.button_style == 'filled-white' %}
      background-color: #ffffff;
      color: #000000;
    {% else %}
      background-color: #000000;
      color: #ffffff;
    {% endif %}
  }

  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="black"] .ai-image-grid__button-{{ ai_gen_id }}:hover {
    {% if section.settings.button_style == 'outline' %}
      background-color: #000000;
      border-color: #000000;
      color: #ffffff;
    {% elsif section.settings.button_style == 'transparent' %}
      background-color: transparent;
      color: #000000;
    {% elsif section.settings.button_style == 'filled-white' %}
      background-color: #e3e3e3;
      color: #050505;
    {% else %}
      background-color: #333333;
      color: #ffffff;
    {% endif %}
  }

  .ai-image-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-image-grid__placeholder-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-image-grid-{{ ai_gen_id }} {
      padding: {{ section.settings.section_padding_mobile }}px;
      background-color: {{ section.settings.section_bg_color_mobile }};
    }

    .ai-image-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-image-grid__item-{{ ai_gen_id }} {
      background-color: {{ section.settings.box_bg_color_mobile }};
    }

    {% if section.settings.featured_box_enabled %}
      .ai-image-grid__item-{{ ai_gen_id }}:nth-child({{ section.settings.featured_box_position }}) {
        grid-column: span 2;
        min-height: {{ section.settings.featured_box_height_mobile }}px;
      }
    {% endif %}

    .ai-image-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.title_size }}px * 0.8);
    }

    .ai-image-grid__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.subtitle_size }}px * 0.8);
    }

    .ai-image-grid__description-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.description_size }}px * 0.8);
    }

    .ai-image-grid__button-{{ ai_gen_id }} {
      font-size: {{ section.settings.button_size_mobile }}px;
      padding: {{ section.settings.button_padding_mobile }}px {{ section.settings.button_padding_mobile | times: 2 }}px;
    }

    .ai-image-grid__image-{{ ai_gen_id }},
    .ai-image-grid__video-{{ ai_gen_id }} {
      object-fit: {{ section.settings.media_fit_mobile }};
      {% if section.settings.media_fit_mobile == 'fill' %}
        transform: scale(1.2);
      {% else %}
        transform: none;
      {% endif %}
    }

    
    @media screen and (max-width: 749px) {
      {% if section.settings.stack_mobile %}
        .ai-image-grid__container-{{ ai_gen_id }} {
          grid-template-columns: 1fr !important;
        }
        .ai-image-grid__item-{{ ai_gen_id }}:nth-child({{ section.settings.featured_box_position }}) {
          grid-column: span 1 !important;
        }
      {% endif %}

      {% if section.settings.hide_on_mobile %}
        .ai-image-grid-{{ ai_gen_id }} {
          display: none !important;
        }
      {% endif %}

   {% if section.settings.center_text_mobile %}
  .ai-image-grid__content-{{ ai_gen_id }} {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  .ai-image-grid__content-{{ ai_gen_id }},
  .ai-image-grid__title-{{ ai_gen_id }},
  .ai-image-grid__subtitle-{{ ai_gen_id }},
  .ai-image-grid__description-{{ ai_gen_id }} {
    text-align: center !important;
  }
{% endif %}


    }
{% endstyle %}

{% liquid


  assign enabled_count = 0
  for i in (1..16)
    assign item_enabled_key = 'item_' | append: i | append: '_enabled'
    assign item_enabled = section.settings[item_enabled_key]
    if item_enabled
      assign enabled_count = enabled_count | plus: 1
    endif
  endfor

  assign boxes_per_row = section.settings.boxes_per_row
  assign remainder = enabled_count | modulo: boxes_per_row
  assign incomplete_row_start = enabled_count | minus: remainder | plus: 1
  assign hide_incomplete = section.settings.hide_incomplete_rows
%}

{% if should_display %}
  <section class="ai-image-grid-{{ ai_gen_id }}" aria-labelledby="br-multi-box-hero-{{ section.id | replace: '_', '' | downcase }}" {{ section.shopify_attributes }}>
    <div class="ai-image-grid__container-{{ ai_gen_id }}">
      {% assign current_box = 0 %}
      {% for i in (1..16) %}
        {% liquid
          assign item_enabled_key = 'item_' | append: i | append: '_enabled'
          assign item_enabled = section.settings[item_enabled_key]
        %}

        {% if item_enabled %}
          {% assign current_box = current_box | plus: 1 %}
          {% liquid
            assign media_type_key = 'item_' | append: i | append: '_media_type'
            assign image_key = 'item_' | append: i | append: '_image'
            assign video_key = 'item_' | append: i | append: '_video'
            assign title_key = 'item_' | append: i | append: '_title'
            assign title_caps_key = 'item_' | append: i | append: '_title_caps'

            assign subtitle_key = 'item_' | append: i | append: '_subtitle'
            assign description_key = 'item_' | append: i | append: '_description'
            assign button_text_key = 'item_' | append: i | append: '_button_text'
            assign button_link_key = 'item_' | append: i | append: '_button_link'
            assign text_color_key = 'item_' | append: i | append: '_text_color'
            assign content_position_key = 'item_' | append: i | append: '_content_position'

            assign media_type = section.settings[media_type_key]
            assign image = section.settings[image_key]
            assign video = section.settings[video_key]
            assign title = section.settings[title_key]
            assign subtitle = section.settings[subtitle_key]
            assign description = section.settings[description_key]
            assign button_text = section.settings[button_text_key]
            assign button_link = section.settings[button_link_key]
            assign text_color = section.settings[text_color_key] | default: 'white'
            assign content_position = section.settings[content_position_key] | default: 'center'

            assign is_incomplete = false
            if hide_incomplete and remainder > 0 and current_box >= incomplete_row_start
              assign is_incomplete = true
            endif
          %}

          <div
            class="ai-image-grid__item-{{ ai_gen_id }} {% if is_incomplete %}ai-incomplete-row-{{ ai_gen_id }}{% endif %}"
            data-text-color="{{ text_color }}"
            data-content-position="{{ content_position }}"
          >
            <div class="ai-image-grid__media-wrapper-{{ ai_gen_id }}">
              {% if media_type == 'image' %}
                {% if image %}
                  <img
                    src="{{ image | image_url: width: 600 }}"
                    srcset="{{ image | image_url: width: 400 }} 400w,
                            {{ image | image_url: width: 600 }} 600w,
                            {{ image | image_url: width: 900 }} 900w,
                            {{ image | image_url: width: 1200 }} 1200w"
                    sizes="(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw"
                    alt="{{ image.alt | default: title | escape }}"
                    class="ai-image-grid__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    fetchpriority="{% if current_box == 1 %}high{% else %}low{% endif %}"
                  >
                {% else %}
                  <div class="ai-image-grid__placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              {% elsif media_type == 'video' %}
                {% if video %}
                  <video
                    class="ai-image-grid__video-{{ ai_gen_id }}"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster="{% if video.preview_image %}{{ video.preview_image | image_url: width: 800 }}{% endif %}"
                    width="{{ video.preview_image.width | default: 800 }}"
                    height="{{ video.preview_image.height | default: 800 }}"
                  >
                    <source src="{{ video.sources[0].url }}" type="{{ video.sources[0].mime_type }}">
                  </video>
                {% else %}
                  <div class="ai-image-grid__placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              {% endif %}
            </div>

            <div class="ai-image-grid__content-{{ ai_gen_id }}">
              {% if title != blank %}
                {% assign title_caps_setting = section.settings[title_caps_key] %}
                <h3 class="ai-image-grid__title-{{ ai_gen_id }}" {% if title_caps_setting %}style="text-transform: uppercase;"{% else %}style="text-transform: none;"{% endif %}>{{ title }}</h3>
              {% endif %}

              {% if subtitle != blank %}
                <p class="ai-image-grid__subtitle-{{ ai_gen_id }}">{{ subtitle }}</p>
              {% endif %}

              {% if description != blank %}
                <p class="ai-image-grid__description-{{ ai_gen_id }}">{{ description }}</p>
              {% endif %}

              {% if button_text != blank and button_link != blank %}
                <a href="{{ button_link }}" class="ai-image-grid__button-{{ ai_gen_id }}">
                  {{ button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}
{% endif %}
<script src="https://cdn.jsdelivr.net/npm/hls.js@latest" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var grid = document.querySelector('.ai-image-grid-{{ ai_gen_id }}');
    if (grid) {
      grid.querySelectorAll('a[href^="#"]').forEach(function(link) {
        var id = link.getAttribute('href').slice(1).split('?')[0];
        if (!id) return;
        link.addEventListener('click', function(e) {
          var target = document.getElementById(id);
          if (!target && (id === 'shop-all-variants' || id.indexOf('br-variants-') === 0)) {
            target = document.querySelector('.br-variants-section') || document.querySelector('[id^="br-variants-"]');
          }
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    }
    var videos = document.querySelectorAll('video');
    videos.forEach(function(video) {
      var source = video.querySelector('source');
      if (source && source.type === 'application/x-mpegURL') {
        if (Hls.isSupported()) {
          var hls = new Hls();
          hls.loadSource(source.src);
          hls.attachMedia(video);
        }
      }
    });
  });
</script>


