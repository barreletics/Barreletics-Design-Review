{% comment %}
  Newsletter / Email Signup Section
  Source: Approved Home + PDP prototypes
{% endcomment %}

<section class="newsletter-section" aria-label="Newsletter signup">
  <div class="newsletter-inner">
    {% if section.settings.eyebrow != blank %}
      <p class="newsletter-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="newsletter-title">{{ section.settings.title }}</h2>
    <p class="newsletter-body">{{ section.settings.body }}</p>

    <form class="newsletter-form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <label for="newsletter-email" class="visually-hidden">Email address</label>
      <input
        class="newsletter-input"
        type="email"
        name="contact[email]"
        id="newsletter-email"
        placeholder="{{ section.settings.placeholder }}"
        required
        autocomplete="email"
      >
      <button class="newsletter-btn btn btn--primary" type="submit">
        {{ section.settings.button_text }}
      </button>
    </form>

    <p class="newsletter-legal">{{ section.settings.legal }}</p>
  </div>
</section>

<style>
  .newsletter-section {
    padding: var(--space-13) var(--section-padding-x);
    border-top: 1px solid var(--border-default);
  }

  .newsletter-inner {
    max-width: var(--max-width-copy);
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-eyebrow {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--text-muted);
    font-weight: var(--weight-bold);
    margin: 0 0 var(--space-3);
  }

  .newsletter-title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .newsletter-body {
    font-size: var(--text-base);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .newsletter-form {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .newsletter-input {
    flex: 1;
    padding: 14px 16px;
    border: 1px solid var(--border-default);
    background: var(--bg-primary);
    font-size: 14px;
    color: var(--text-primary);
    border-radius: var(--radius-button);
    font-family: var(--font-family);
  }

  .newsletter-input::placeholder {
    color: #9a9182;
  }

  .newsletter-btn {
    padding: 14px 24px;
    font-size: 12px;
    white-space: nowrap;
  }

  .newsletter-legal {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 10px 0 0;
  }

  @media (max-width: 768px) {
    .newsletter-section {
      padding: var(--section-padding-y-mobile) var(--section-padding-x-mobile);
    }

    .newsletter-form {
      flex-direction: column;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the list" },
    { "type": "text", "id": "title", "label": "Title", "default": "10% off your first pair." },
    { "type": "text", "id": "body", "label": "Body", "default": "New drops, studio stories, care tips. Once or twice a quarter." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Email address" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Get 10% off" },
    { "type": "text", "id": "legal", "label": "Legal text", "default": "By subscribing you agree to receive marketing emails. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
