{% comment %}
  Page Returns Section
  Return policy, exchange process, international returns, FAQ accordion.
  Used on: page.returns.json
{% endcomment %}

<section class="section" id="shopify-section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="section__inner section__inner--narrow">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="page-returns__title">{{ section.settings.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="page-returns__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
</section>

<section class="section section--cream">
  <div class="section__inner section__inner--narrow">
    <div class="page-returns__policy-card">
      <h2 class="page-returns__policy-title">{{ section.settings.policy_heading }}</h2>
      <div class="page-returns__policy-body">
        {{ section.settings.policy_text }}
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="section__inner section__inner--narrow">
    <h2 class="page-returns__section-title">{{ section.settings.process_heading }}</h2>
    <div class="page-returns__steps">
      {% for block in section.blocks %}
        {% if block.type == 'return_step' %}
          <div class="page-returns__step" {{ block.shopify_attributes }}>
            <span class="page-returns__step-number">{{ forloop.index }}</span>
            <div class="page-returns__step-content">
              <h3 class="page-returns__step-title">{{ block.settings.title }}</h3>
              <p class="page-returns__step-text">{{ block.settings.description }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% if section.settings.exchange_heading != blank %}
<section class="section section--cream">
  <div class="section__inner section__inner--narrow">
    <h2 class="page-returns__section-title">{{ section.settings.exchange_heading }}</h2>
    <div class="page-returns__body">
      {{ section.settings.exchange_text }}
    </div>
  </div>
</section>
{% endif %}

{% if section.settings.international_heading != blank %}
<section class="section">
  <div class="section__inner section__inner--narrow">
    <h2 class="page-returns__section-title">{{ section.settings.international_heading }}</h2>
    <div class="page-returns__body">
      {{ section.settings.international_text }}
    </div>
  </div>
</section>
{% endif %}

{% assign faq_blocks_exist = false %}
{% for block in section.blocks %}
  {% if block.type == 'faq_item' %}
    {% assign faq_blocks_exist = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% if faq_blocks_exist %}
<section class="section section--cream">
  <div class="section__inner section__inner--narrow">
    <h2 class="page-returns__section-title">Returns FAQ</h2>
    <div class="faq" data-faq-accordion>
      <div class="faq__inner">
        <div class="faq__list">
          {% for block in section.blocks %}
            {% if block.type == 'faq_item' %}
              <details class="faq__item" data-faq-item {{ block.shopify_attributes }}>
                <summary class="faq__trigger" role="button" aria-expanded="false">
                  <span class="faq__question">{{ block.settings.question }}</span>
                  <span class="faq__icon" aria-hidden="true"></span>
                </summary>
                <div class="faq__body">
                  {{ block.settings.answer }}
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

<style>
  .page-returns__title {
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    text-align: center;
    margin: 0 0 var(--space-3);
    letter-spacing: var(--tracking-tight);
  }

  .page-returns__subtitle {
    font-size: var(--text-md);
    color: var(--text-body);
    text-align: center;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .page-returns__policy-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    padding: var(--space-8);
  }

  .page-returns__policy-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-4);
  }

  .page-returns__policy-body {
    font-size: var(--text-md);
    color: var(--text-body);
    line-height: var(--leading-loose);
  }

  .page-returns__policy-body p {
    margin-bottom: var(--space-3);
  }

  .page-returns__policy-body p:last-child {
    margin-bottom: 0;
  }

  .page-returns__section-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-6);
    letter-spacing: var(--tracking-tight);
  }

  .page-returns__steps {
    display: grid;
    gap: var(--space-5);
  }

  .page-returns__step {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .page-returns__step-number {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--text-primary);
    color: var(--color-white);
    border-radius: 50%;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
  }

  .page-returns__step-title {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-1);
  }

  .page-returns__step-text {
    font-size: var(--text-base);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .page-returns__body {
    font-size: var(--text-md);
    color: var(--text-body);
    line-height: var(--leading-loose);
  }

  .page-returns__body p {
    margin-bottom: var(--space-4);
  }

  .page-returns__body p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .page-returns__title {
      font-size: var(--text-3xl);
    }

    .page-returns__policy-card {
      padding: var(--space-5);
    }
  }
</style>

<script>
  (function() {
    document.querySelectorAll('[data-faq-accordion]').forEach(function(accordion) {
      var items = accordion.querySelectorAll('[data-faq-item]');
      items.forEach(function(item) {
        item.addEventListener('toggle', function() {
          if (item.open) {
            items.forEach(function(other) {
              if (other !== item && other.open) other.open = false;
            });
            item.querySelector('.faq__trigger').setAttribute('aria-expanded', 'true');
          } else {
            item.querySelector('.faq__trigger').setAttribute('aria-expanded', 'false');
          }
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Returns Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Returns & Exchanges"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Returns & Exchanges"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We want you to love your Performance Skins. If they're not right, here's how returns and exchanges work."
    },
    {
      "type": "text",
      "id": "policy_heading",
      "label": "Policy heading",
      "default": "30-Day Return Policy"
    },
    {
      "type": "richtext",
      "id": "policy_text",
      "label": "Policy text",
      "default": "<p>We accept returns within 30 days of delivery on items in new, sellable condition. Items must be unworn (other than trying on indoors) and in original packaging.</p><p>This is a standard return policy. Items showing signs of wear, outdoor use, or studio use are not eligible for return.</p>"
    },
    {
      "type": "text",
      "id": "process_heading",
      "label": "Process heading",
      "default": "How to Return"
    },
    {
      "type": "text",
      "id": "exchange_heading",
      "label": "Exchange heading",
      "default": "Size Exchanges"
    },
    {
      "type": "richtext",
      "id": "exchange_text",
      "label": "Exchange text",
      "default": "<p>Need a different size? We offer free shipping on size exchanges within 30 days of purchase. Contact our support team to initiate an exchange — we'll send you a prepaid return label and ship your new size as soon as we receive the original.</p>"
    },
    {
      "type": "text",
      "id": "international_heading",
      "label": "International heading",
      "default": "International Returns"
    },
    {
      "type": "richtext",
      "id": "international_text",
      "label": "International text",
      "default": "<p>International customers: send a photo of the item to our support team. For defects, no return shipping is required. For size exchanges, customer pays return shipping. We cover replacement shipping domestically; international replacement shipping is at customer's cost.</p>"
    }
  ],
  "blocks": [
    {
      "type": "return_step",
      "name": "Return Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step description"
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Returns Page"
    }
  ]
}
{% endschema %}
