{% comment %}
  Custom Judge.me Review Card (D-025)
  Renders review data using Barreletics design tokens.
  Judge.me is data source only — rendering is fully custom.

  Usage: {% render 'review-card', review: review_object %}
  Expected review object properties: rating, body, author, location, date, photo
{% endcomment %}

<article class="review-card" itemscope itemtype="https://schema.org/Review">
  <div class="review-card__stars" aria-label="{{ review.rating }} out of 5 stars">
    {% for i in (1..5) %}
      {% if i <= review.rating %}
        <span class="review-card__star review-card__star--filled" aria-hidden="true">★</span>
      {% else %}
        <span class="review-card__star review-card__star--empty" aria-hidden="true">☆</span>
      {% endif %}
    {% endfor %}
    <meta itemprop="reviewRating" content="{{ review.rating }}">
  </div>

  {% if review.title %}
    <h4 class="review-card__title" itemprop="name">{{ review.title }}</h4>
  {% endif %}

  <p class="review-card__body" itemprop="reviewBody">{{ review.body }}</p>

  {% if review.photo %}
    <div class="review-card__photo">
      <img
        src="{{ review.photo | image_url: width: 400 }}"
        alt="Review photo by {{ review.author }}"
        loading="lazy"
        width="200"
        height="200"
      >
    </div>
  {% endif %}

  <footer class="review-card__footer">
    <span class="review-card__author" itemprop="author">{{ review.author }}</span>
    {% if review.location %}
      <span class="review-card__location">{{ review.location }}</span>
    {% endif %}
    {% if review.date %}
      <time class="review-card__date" itemprop="datePublished" datetime="{{ review.date | date: '%Y-%m-%d' }}">
        {{ review.date | date: '%B %d, %Y' }}
      </time>
    {% endif %}
  </footer>
</article>

<style>
  .review-card {
    background: var(--bg-primary);
    border: 1px solid #e6e6e6;
    border-radius: var(--radius-card);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .review-card__stars {
    color: var(--accent-stars);
    font-size: 14px;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .review-card__star--empty {
    opacity: 0.3;
  }

  .review-card__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .review-card__body {
    font-size: var(--text-base);
    font-style: italic;
    color: var(--text-body);
    line-height: var(--leading-relaxed);
    margin: 0;
    flex: 1;
  }

  .review-card__photo {
    margin-top: var(--space-2);
  }

  .review-card__photo img {
    width: 100%;
    max-width: 200px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-gallery);
  }

  .review-card__footer {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .review-card__author {
    font-size: 13px;
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .review-card__location {
    font-size: 12px;
    color: var(--text-muted);
  }

  .review-card__date {
    font-size: 12px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .review-card {
      padding: var(--space-5);
    }
  }
</style>
