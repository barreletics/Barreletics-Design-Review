{% comment %}
  GA4 Enhanced Ecommerce Events
  Placement: Before </body> via theme.liquid
  Configuration: Requires GA4 Measurement ID set in analytics-head.liquid

  Fires standard ecommerce events based on page context:
  - view_item (PDP)
  - view_item_list (collection)
  - add_to_cart (cart:item-added custom event)
  - begin_checkout (checkout button click)
  Custom: size_selector_click, sticky_atc_click, cart_drawer_open

  Purchase event is handled by Shopify checkout — see note at bottom.

  IMPORTANT: If using Shopify's native Google channel integration,
  leave the GA4 Measurement ID blank in Theme Settings to prevent
  duplicate event tracking.
{% endcomment %}

{% if settings.ga4_measurement_id != blank %}
<script>
(function() {
  'use strict';

  if (typeof gtag === 'undefined') return;

  {% if request.page_type == 'product' %}
    gtag('event', 'view_item', {
      currency: {{ cart.currency.iso_code | json }},
      value: {{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }},
      items: [{
        item_id: {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
        item_name: {{ product.title | json }},
        item_brand: 'Barreletics',
        item_category: {{ product.type | json }},
        item_variant: {{ product.selected_or_first_available_variant.title | json }},
        price: {{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }},
        quantity: 1
      }]
    });
  {% endif %}

  {% if request.page_type == 'collection' %}
    gtag('event', 'view_item_list', {
      item_list_id: {{ collection.handle | json }},
      item_list_name: {{ collection.title | json }},
      items: [
        {% for product in collection.products limit: 12 %}
          {
            item_id: {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
            item_name: {{ product.title | json }},
            item_brand: 'Barreletics',
            item_category: {{ product.type | json }},
            price: {{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }},
            index: {{ forloop.index }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    });
  {% endif %}

  document.addEventListener('cart:item-added', function(e) {
    var item = e.detail;
    if (!item) return;
    gtag('event', 'add_to_cart', {
      currency: {{ cart.currency.iso_code | json }},
      value: item.price / 100,
      items: [{
        item_id: item.sku || item.id,
        item_name: item.title,
        item_brand: 'Barreletics',
        item_variant: item.variant_title,
        price: item.price / 100,
        quantity: item.quantity || 1
      }]
    });
  });

  document.addEventListener('click', function(e) {
    var checkoutBtn = e.target.closest('[data-checkout-button], [name="checkout"]');
    if (checkoutBtn) {
      gtag('event', 'begin_checkout', {
        currency: {{ cart.currency.iso_code | json }},
        value: {{ cart.total_price | money_without_currency | remove: ',' }},
        items: [
          {% for item in cart.items %}
            {
              item_id: {{ item.sku | default: item.variant_id | json }},
              item_name: {{ item.product.title | json }},
              item_brand: 'Barreletics',
              item_variant: {{ item.variant.title | json }},
              price: {{ item.final_price | money_without_currency | remove: ',' }},
              quantity: {{ item.quantity }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      });
    }

    var sizeBtn = e.target.closest('[data-size-option]');
    if (sizeBtn) {
      gtag('event', 'size_selector_click', {
        size_value: sizeBtn.getAttribute('data-size-option')
      });
    }

    var stickyAtc = e.target.closest('[data-sticky-atc]');
    if (stickyAtc) {
      gtag('event', 'sticky_atc_click');
    }

    var cartTrigger = e.target.closest('[data-cart-trigger]');
    if (cartTrigger) {
      gtag('event', 'cart_drawer_open');
    }
  });

})();
</script>
{% endif %}

{% comment %}
  PURCHASE EVENT:
  Configured in Shopify Admin → Settings → Customer events (or
  checkout.liquid Additional Scripts on Shopify Plus). Shopify's
  checkout is a separate domain — theme code cannot fire events there.
  Use Shopify's built-in GA4 integration or a Custom Pixel for purchase.

  DUPLICATE PREVENTION:
  If using Shopify's native Google channel (Sales Channels → Google),
  that integration already fires page_view, view_item, add_to_cart,
  begin_checkout, and purchase events. In that case, leave the
  GA4 Measurement ID blank in Theme Settings to avoid double-counting.
  Only use this theme-level tracking if NOT using the native channel.
{% endcomment %}
