      <button type="button" class="br-toggle-btn br-toggle-see-more" id="br-see-more-{{ section.id }}" data-tier="1" data-section="{{ section.id }}">{{ section.settings.see_all_text }} <span class="br-toggle-arrow">→</span></button>
      {% endif %}
      {% if has_kids_tier %}
      <button type="button" class="br-toggle-btn br-toggle-see-more is-hidden" id="br-see-more-kids-{{ section.id }}" data-tier="2" data-section="{{ section.id }}">{{ section.settings.see_more_kids_text | default: 'See more sizes' }} <span class="br-toggle-arrow">→</span></button>
      {% endif %}
      <button type="button" class="br-toggle-btn is-hidden" id="br-show-less-{{ section.id }}" data-section="{{ section.id }}">{{ section.settings.show_less_text }}</button>
    </div>
    {% endif %}

    {%- if target_product != nil -%}
    <div id="br-oneoff-lightbox-{{ section.id }}" class="br-oneoff-lightbox" aria-hidden="true" role="dialog" aria-label="Enlarge image">
      <div class="br-oneoff-lightbox__inner">
        <button type="button" class="br-oneoff-lightbox__close" aria-label="Close">&times;</button>
        <div class="br-oneoff-lightbox__images" id="br-oneoff-lightbox-images-{{ section.id }}">
          <img src="" alt="" id="br-oneoff-lightbox-img-{{ section.id }}">
          <img src="" alt="" id="br-oneoff-lightbox-img2-{{ section.id }}" class="br-oneoff-lightbox__img2" style="display: none;">
        </div>
      </div>
    </div>
    {%- endif -%}

  </div>
</section>

<script>
  function addToCart{{ section.id | replace: '-', '' }}(variantId, btnEl) {
    if (btnEl && btnEl.getAttribute) {
      btnEl.classList.add('btn--loading');
      btnEl.setAttribute('aria-busy', 'true');
      btnEl.disabled = true;
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1
      })
    })
    .then(function(response) {
      return response.json().then(function(data) {
        return { response: response, data: data };
      });
    })
    .then(function(result) {
      var ok = result.response.ok;
      var data = result.data || {};
      if (!ok || data.status === 422) {
        var msg = '';
        if (typeof data.description === 'string') {
          msg = data.description;
        } else if (data.message) {
          msg = typeof data.message === 'string' ? data.message : '';
        }
        if (!msg) msg = {{ 'Unable to add this item — try refreshing the page.' | json }};
        alert(msg);
        return;
      }
      document.dispatchEvent(new CustomEvent('cart:updated'));
      window.location.href = '/cart';
    })
    .catch(function(error) {
      console.error('Error adding to cart:', error);
    })
    .finally(function() {
      if (btnEl && btnEl.getAttribute) {
        btnEl.classList.remove('btn--loading');
        btnEl.removeAttribute('aria-busy');
        btnEl.disabled = false;
      }
    });
  }

  function brFilterProduct(sectionId, productNum) {
    // Find this section (our section has id br-variants-{sectionId})
    let section = document.getElementById('br-variants-' + sectionId);
    if (!section) {
      section = document.querySelector('[data-section-id="' + sectionId + '"]');
    }
    if (!section) return;
    
    const tabs = section.querySelectorAll('.br-filter-tab');
    const groups = section.querySelectorAll('.br-product-group');
    // Update active tab
    tabs.forEach(tab => {
      if (parseInt(tab.dataset.product) === productNum) {
        tab.classList.add('is-active');
      } else {
        tab.classList.remove('is-active');
      }
    });

    // Show/hide product groups - use both class and inline style for reliability
    groups.forEach(group => {
      if (parseInt(group.dataset.productGroup) === productNum) {
        group.classList.remove('is-hidden');
        group.style.display = '';
        group.querySelectorAll('.br-variant-card').forEach(card => { card.style.display = ''; });
      } else {
        group.classList.add('is-hidden');
        group.style.display = 'none';
        group.querySelectorAll('.br-variant-card').forEach(card => { card.style.display = 'none'; });
      }
    });
  }

  // iOS: ensure filter tabs respond on first tap (avoid delayed/suppressed click synthesis)
  (function bindBrFilterTabs() {
    const sectionId = {{ section.id | json }};
    function bind() {
      const section = document.getElementById('br-variants-' + sectionId) || document.querySelector('[data-section-id="' + sectionId + '"]');
      if (!section || section.dataset.brTabsBound === '1') return;
      section.dataset.brTabsBound = '1';

      const tabs = section.querySelectorAll('.br-filter-tab');
      if (!tabs.length) return;

      let suppressEl = null;
      let suppressUntil = 0;
      const MOVE_THRESHOLD_PX = 12;
      const MAX_TAP_DURATION_MS = 500;

      function activate(tab, evt) {
        if (evt) evt.preventDefault();
        const num = parseInt(tab.dataset.product, 10);
        if (!isNaN(num)) brFilterProduct(sectionId, num);
        // clear iOS sticky focus/hover effects
        try { tab.blur(); } catch (e) {}
      }

      tabs.forEach(tab => {
        tab.addEventListener('touchstart', function(evt) {
          if (evt.touches && evt.touches.length > 1) return;
          const t = evt.touches && evt.touches[0];
          if (!t) return;
          tab.__brTapState = { x: t.clientX, y: t.clientY, at: Date.now(), moved: false };
        }, { passive: true });

        tab.addEventListener('touchmove', function(evt) {
          const st = tab.__brTapState;
          if (!st) return;
          const t = evt.touches && evt.touches[0];
          if (!t) return;
          if (Math.abs(t.clientX - st.x) > MOVE_THRESHOLD_PX || Math.abs(t.clientY - st.y) > MOVE_THRESHOLD_PX) st.moved = true;
        }, { passive: true });

        tab.addEventListener('touchcancel', function() {
          tab.__brTapState = null;
        }, { passive: true });

        tab.addEventListener('touchend', function(evt) {
          if (evt.changedTouches && evt.changedTouches.length > 1) return;
          const st = tab.__brTapState;
          tab.__brTapState = null;
          if (st && (st.moved || (Date.now() - st.at) > MAX_TAP_DURATION_MS)) return;
          evt.preventDefault();
          evt.stopPropagation();
          suppressEl = tab;
          suppressUntil = Date.now() + 750;
          activate(tab, evt);
        }, { passive: false });

        tab.addEventListener('click', function(evt) {
          if (suppressEl === tab && Date.now() < suppressUntil) {
            evt.preventDefault();
            evt.stopPropagation();
            if (evt.stopImmediatePropagation) evt.stopImmediatePropagation();
            suppressEl = null;
            return;
          }
          activate(tab, evt);
        }, false);
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
    else bind();
  })();

  // On load: ensure only the active tab’s group is visible (tab 1 = Open Sole)
  (function initBrFilter() {
    const sectionId = {{ section.id | json }};
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() { brFilterProduct(sectionId, 1); });
    } else {
      brFilterProduct(sectionId, 1);
    }
  })();

  (function initOneoffLightbox() {
    const sectionId = {{ section.id | json }};
    const section = document.getElementById('br-variants-' + sectionId);
    const modal = document.getElementById('br-oneoff-lightbox-' + sectionId);
    const modalImg = document.getElementById('br-oneoff-lightbox-img-' + sectionId);
    const modalImg2 = document.getElementById('br-oneoff-lightbox-img2-' + sectionId);
    if (!section || !modal || !modalImg) return;
    section.querySelectorAll('.br-oneoff-lightbox-trigger').forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        var card = this.closest('.br-variant-card');
        var src1 = card && card.getAttribute('data-br-lightbox-src1');
        var src2 = card && card.getAttribute('data-br-lightbox-src2');
        if (src1 && src2) {
          modalImg.src = src1;
          modalImg.alt = card.getAttribute('data-br-lightbox-alt1') || '';
          modalImg2.src = src2;
          modalImg2.alt = card.getAttribute('data-br-lightbox-alt2') || '';
          modalImg2.style.display = '';
          modal.classList.add('br-oneoff-lightbox--dual', 'is-open');
        } else {
          var src = this.getAttribute('data-br-lightbox-src') || (this.querySelector('img') && this.querySelector('img').src);
          var alt = this.getAttribute('data-br-lightbox-alt') || (this.querySelector('img') && this.querySelector('img').alt) || '';
          if (src) {
            modalImg.src = src;
            modalImg.alt = alt;
            modalImg2.style.display = 'none';
            modalImg2.src = '';
            modal.classList.remove('br-oneoff-lightbox--dual');
            modal.classList.add('is-open');
          }
        }
        if (modal.classList.contains('is-open')) {
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
      });
    });
    function closeLightbox() {
      modal.classList.remove('is-open', 'br-oneoff-lightbox--dual');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    modal.querySelector('.br-oneoff-lightbox__close').addEventListener('click', closeLightbox);
    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeLightbox();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeLightbox();
    });
  })();

  function brToggleVariants(sectionId, action) {
    const grid = document.getElementById('br-grid-' + sectionId);
    if (!grid) return;
    const product2Label = document.getElementById('br-product2-label-' + sectionId);
    if (action === 'expand') {
      grid.querySelectorAll('.br-variant-card.is-hidden').forEach(function(card) {
        card.classList.remove('is-hidden');
        card.classList.add('is-visible');
      });
      if (product2Label) product2Label.classList.remove('is-hidden');
    } else {
      grid.querySelectorAll('.br-variant-card[data-size-tier="see-more"], .br-variant-card[data-size-tier="kids"]').forEach(function(card) {
        card.classList.add('is-hidden');
        card.classList.remove('is-visible');
      });
      if (product2Label) product2Label.classList.add('is-hidden');
    }
  }

  (function() {
    const sectionId = {{ section.id | json }};
    const grid = document.getElementById('br-grid-' + sectionId);
    const toggle = document.getElementById('br-toggle-' + sectionId);
    if (!grid || !toggle) return;
    const seeMore1 = document.getElementById('br-see-more-' + sectionId);
    const seeMoreKids = document.getElementById('br-see-more-kids-' + sectionId);
    const showLess = document.getElementById('br-show-less-' + sectionId);
    const product2Label = document.getElementById('br-product2-label-' + sectionId);

    function showTier(tier) {
      grid.querySelectorAll('.br-variant-card[data-size-tier="' + tier + '"]').forEach(function(c) {
        c.classList.remove('is-hidden');
        c.classList.add('is-visible');
      });
    }
    function hideTiers() {
      grid.querySelectorAll('.br-variant-card[data-size-tier="see-more"], .br-variant-card[data-size-tier="kids"]').forEach(function(c) {
        c.classList.add('is-hidden');
        c.classList.remove('is-visible');
      });
    }

    if (seeMore1) {
      seeMore1.addEventListener('click', function() {
        showTier('see-more');
        seeMore1.classList.add('is-hidden');
        if (seeMoreKids) seeMoreKids.classList.remove('is-hidden');
        if (showLess) showLess.classList.remove('is-hidden');
        if (product2Label) product2Label.classList.remove('is-hidden');
      });
    }
    if (seeMoreKids) {
      seeMoreKids.addEventListener('click', function() {
        showTier('kids');
        seeMoreKids.classList.add('is-hidden');
        if (showLess) showLess.classList.remove('is-hidden');
        if (product2Label) product2Label.classList.remove('is-hidden');
      });
    }
    if (showLess) {
      showLess.addEventListener('click', function() {
        hideTiers();
        showLess.classList.add('is-hidden');
        if (seeMore1) seeMore1.classList.remove('is-hidden');
        if (seeMoreKids) {
          if (seeMore1) seeMoreKids.classList.add('is-hidden');
          else seeMoreKids.classList.remove('is-hidden');
        }
        if (product2Label) product2Label.classList.add('is-hidden');
        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  })();
</script>
{% else %}
  {% if request.design_mode %}
    <div style="padding: 40px; text-align: center; background: #f5f5f5;">
      <p>All Variants Grid: Please select a product in the section settings, or enable "Use current product" on a product page.</p>
    </div>
  {% endif %}
{% endif %}

