{% comment %}
  All Variants Grid Section
  Displays all variants of a product as individual cards with Quick Add
{% endcomment %}

{%- liquid
  comment
    Product loading: aligned with live theme.
    Product 4/5 support handle fallback lookup when picker is empty.
    Draft-only: _use_current, _hide_main_product (one-off pages), product_5.
  endcomment
  assign _p4_invalid_source = false
  assign _p5_invalid_source = false
  assign _use_current = false
  if product != blank and section.settings.use_current_product
    assign _use_current = true
  endif
  assign _hide_main_product = false
  if _use_current and template.name == 'product' and product.handle != blank
    assign _ph_down = product.handle | downcase
    if _ph_down contains 'one-off' or _ph_down contains 'one_off' or _ph_down contains 'exclusive-colors'
      assign _hide_main_product = true
    endif
  endif
  if _use_current
    assign target_product = product
    assign target_product_2 = nil
    assign target_product_3 = nil
    assign target_product_4 = nil
    assign target_product_5 = nil
    assign use_filter_tabs = false
  elsif section.settings.product != blank
    assign target_product = section.settings.product
    if section.settings.product_2 != blank
      assign target_product_2 = section.settings.product_2
    else
      assign target_product_2 = nil
    endif
    if section.settings.product_3 != blank
      assign target_product_3 = section.settings.product_3
    else
      assign target_product_3 = nil
    endif
    if section.settings.product_4 != blank
      assign target_product_4 = section.settings.product_4
    else
      assign target_product_4 = nil
    endif
    if section.settings.product_5 != blank
      assign target_product_5 = section.settings.product_5
    else
      assign target_product_5 = nil
    endif
    assign use_filter_tabs = section.settings.enable_filter_tabs
  else
    assign target_product = nil
    assign target_product_2 = nil
    assign target_product_3 = nil
    assign target_product_4 = nil
    assign target_product_5 = nil
    assign use_filter_tabs = false
  endif
  if target_product == nil or target_product == blank
    assign target_product_2 = nil
    assign target_product_3 = nil
    assign target_product_4 = nil
    assign target_product_5 = nil
  endif
  if target_product_4 != nil and target_product_4.handle != blank
    assign _p4h = target_product_4.handle | downcase
    assign _p4_is_oneoff = false
    if _p4h contains 'one-off' or _p4h contains 'one_off' or _p4h contains 'exclusive-colors'
      assign _p4_is_oneoff = true
    endif
    unless _p4_is_oneoff
      assign _p4_invalid_source = true
      assign target_product_4 = nil
    endunless
  endif
  if target_product_5 != nil and target_product_5.handle != blank
    assign _p5h = target_product_5.handle | downcase
    assign _p5_is_oneoff = false
    if _p5h contains 'one-off' or _p5h contains 'one_off' or _p5h contains 'exclusive-colors'
      assign _p5_is_oneoff = true
    endif
    unless _p5_is_oneoff
      assign _p5_invalid_source = true
      assign target_product_5 = nil
    endunless
  endif

  assign desktop_cols = section.settings.desktop_columns
  assign initial_rows = section.settings.initial_rows | default: 2
  if initial_rows > 0
    assign initial_count = initial_rows | times: desktop_cols
  else
    assign initial_count = section.settings.initial_variants | default: 8
  endif
  assign max_count = section.settings.max_variants
  assign _oneoff_visible_total = 0
  if target_product_4 != nil
    for _ov4 in target_product_4.variants limit: max_count
      assign _ov4_skip = false
      assign _ov4_hidden = _ov4.metafields.custom.hide_from_storefront.value | append: '' | downcase
      if _ov4_hidden == 'true'
        assign _ov4_skip = true
      endif
      if section.settings.hide_sold_out_one_off and _ov4.available == false
        assign _ov4_skip = true
      endif
      unless _ov4_skip
        assign _oneoff_visible_total = _oneoff_visible_total | plus: 1
      endunless
    endfor
  endif
  if target_product_5 != nil
    for _ov5 in target_product_5.variants limit: max_count
      assign _ov5_skip = false
      assign _ov5_hidden = _ov5.metafields.custom.hide_from_storefront.value | append: '' | downcase
      if _ov5_hidden == 'true'
        assign _ov5_skip = true
      endif
      if section.settings.hide_sold_out_one_off and _ov5.available == false
        assign _ov5_skip = true
      endif
      unless _ov5_skip
        assign _oneoff_visible_total = _oneoff_visible_total | plus: 1
      endunless
    endfor
  endif
  assign _show_oneoff_tab = false
  if _oneoff_visible_total > 0
    assign _show_oneoff_tab = true
  endif
  assign mobile_cols = section.settings.mobile_columns
  assign show_product_labels = false
  if target_product_2 != nil and use_filter_tabs == false
    assign show_product_labels = true
  endif
  
  assign has_multiple_products = false
  if target_product_2 != nil or target_product_3 != nil or target_product_4 != nil or target_product_5 != nil
    assign has_multiple_products = true
  endif
  assign kids_trigger_br = section.settings.kids_trigger | default: 'kids' | strip | downcase
-%}

<style>
  #br-variants-{{ section.id }},
  #shopify-section-{{ section.id }} {
    --subtitle-line-size-desktop: {{ section.settings.subtitle_line_font_size_desktop | default: 18 }}px;
    --subtitle-line-size-mobile: {{ section.settings.subtitle_line_font_size_mobile | default: 16 }}px;
    --card-bg: {{ section.settings.card_background }};
    --card-radius: {{ section.settings.card_radius }}px;
    --card-padding: {{ section.settings.card_padding }}px;
    --title-size: {{ section.settings.title_size }}px;
    --subtitle-size: {{ section.settings.subtitle_size }}px;
    --btn-bg: {{ section.settings.button_background }};
    --btn-color: {{ section.settings.button_text_color }};
    --btn-radius: {{ section.settings.button_radius }}px;
    --btn-pad-v: {{ section.settings.button_padding_v }}px;
    --btn-pad-h: {{ section.settings.button_padding_h }}px;
    --btn-font-size-desktop: {{ section.settings.button_font_size_desktop | default: 14 }}px;
    --btn-font-size-mobile: {{ section.settings.button_font_size_mobile | default: 14 }}px;
    --sale-badge-bg: {{ section.settings.sale_badge_bg }};
    --sale-badge-color: {{ section.settings.sale_badge_text_color }};
    --sale-price-color: {{ section.settings.sale_price_color }};
    --compare-color: {{ section.settings.compare_price_color }};
    --le-badge-bg: #458CD9;
    --le-badge-color: #ffffff;
    --le-font-size: {{ section.settings.le_label_font_size | default: 13 }}px;
    --le-font-weight: {{ section.settings.le_label_font_weight | default: 600 }};
    --le-letter-spacing: {{ section.settings.le_label_letter_spacing | default: 0.1 }}em;
    --le-text-color: {{ section.settings.le_label_color | default: '#000000' }};
    --oneoff-badge-bg: {{ section.settings.oneoff_badge_bg | default: '#ffffff' }};
    --oneoff-badge-color: {{ section.settings.oneoff_badge_text_color | default: '#000000' }};
    --oneoff-font-size: {{ section.settings.oneoff_label_font_size | default: 13 }}px;
    --oneoff-font-weight: {{ section.settings.oneoff_label_font_weight | default: 600 }};
    --oneoff-letter-spacing: {{ section.settings.oneoff_label_letter_spacing | default: 0.1 }}em;
    --oneoff-text-color: {{ section.settings.oneoff_label_color | default: '#000000' }};
    --le-font-family: Roboto, sans-serif;
    --section-pad-top-desktop: {{ section.settings.padding_top_desktop | default: 40 }}px;
    --section-pad-bottom-desktop: {{ section.settings.padding_bottom_desktop | default: 40 }}px;
    --section-pad-top-mobile: {{ section.settings.padding_top_mobile | default: 30 }}px;
    --section-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 30 }}px;
  }

  .br-variants-section {
    padding-top: var(--section-pad-top-desktop);
    padding-bottom: var(--section-pad-bottom-desktop);
  }

  @media (max-width: 749px) {
    .br-variants-section {
      padding-top: var(--section-pad-top-mobile);
      padding-bottom: var(--section-pad-bottom-mobile);
    }
  }

  .br-variants-container {
    max-width: {{ section.settings.content_max_width_desktop | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (max-width: 749px) {
    .br-variants-container {
      max-width: max({{ section.settings.content_max_width_mobile | default: 360 }}px, {{ section.settings.heading_max_width_mobile | default: 420 }}px);
    }
  }

  .br-variants-header {
    text-align: center;
    margin-bottom: 30px;
  }

  @media (max-width: 749px) {
    .br-variants-header {
      margin-bottom: 18px;
    }
  }

  .br-variants-title.br-section-heading {
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    font-weight: var(--br-heading-weight, {{ section.settings.title_font.weight }});
    font-size: var(--br-section-heading-size-desktop, {{ section.settings.section_heading_font_size_desktop | default: 28 }}px);
    text-transform: var(--br-heading-transform, none);
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.heading_margin_bottom_desktop | default: 10 }}px;
  }

  @media (max-width: 749px) {
    .br-variants-title.br-section-heading {
      font-size: var(--br-section-heading-size-mobile, {{ section.settings.section_heading_font_size_mobile | default: 22 }}px);
      margin-bottom: {{ section.settings.heading_margin_bottom_mobile | default: 8 }}px;
    }
  }

  @media (max-width: 749px) {
    #br-variants-{{ section.id }} .br-section-heading {
      line-height: 1.1;
      max-width: {{ section.settings.heading_max_width_mobile | default: 420 }}px;
      margin-left: auto;
      margin-right: auto;
      display: block;
    }
  }

  .br-variants-subtitle {
    font-size: var(--subtitle-size);
    color: #666;
    margin: 0;
  }

  #br-variants-{{ section.id }} .br-grid-subtitle-line {
    font-weight: 400 !important;
    font-size: var(--subtitle-line-size-desktop) !important;
    margin: 8px 0 {{ section.settings.subtitle_line_spacing | default: 10 }}px !important;
  }
  #br-variants-{{ section.id }} .br-grid-subtitle-line p,
  #br-variants-{{ section.id }} .br-grid-subtitle-line h1,
  #br-variants-{{ section.id }} .br-grid-subtitle-line h2,
  #br-variants-{{ section.id }} .br-grid-subtitle-line h3 {
    margin: 0 !important;
    font-size: inherit !important;
    font-weight: inherit !important;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} #br-variants-{{ section.id }} .br-grid-subtitle-line.rte,
    #shopify-section-{{ section.id }} #br-variants-{{ section.id }} .br-grid-subtitle-line.rte p,
    #shopify-section-{{ section.id }} #br-variants-{{ section.id }} .br-grid-subtitle-line.rte h1,
    #shopify-section-{{ section.id }} #br-variants-{{ section.id }} .br-grid-subtitle-line.rte h2,
    #shopify-section-{{ section.id }} #br-variants-{{ section.id }} .br-grid-subtitle-line.rte h3 {
      font-size: {{ section.settings.subtitle_line_font_size_mobile | default: 16 }}px !important;
    }
    #br-variants-{{ section.id }} .br-grid-subtitle-line {
      margin-bottom: {{ section.settings.subtitle_line_spacing | default: 10 }}px !important;
    }
  }

  #br-variants-{{ section.id }} .br-grid-subtitle {
    margin: {{ section.settings.body_margin_top_desktop | default: 0 }}px 0 {{ section.settings.body_margin_bottom_desktop | default: 0 }}px !important;
    font-size: {{ section.settings.body_font_size_desktop | default: 16 }}px;
  }
  #br-variants-{{ section.id }} .br-grid-subtitle p {
    margin: 0 !important;
  }

  @media (max-width: 749px) {
    #br-variants-{{ section.id }} .br-grid-subtitle {
      font-size: {{ section.settings.body_font_size_mobile | default: 14 }}px;
      margin-top: {{ section.settings.body_margin_top_mobile | default: 0 }}px !important;
      margin-bottom: {{ section.settings.body_margin_bottom_mobile | default: 0 }}px !important;
    }
  }

  .br-variants-grid {
    display: grid;
    grid-template-columns: repeat({{ desktop_cols }}, 1fr);
    gap: 20px;
  }

  @media (max-width: 749px) {
    .br-variants-grid {
      grid-template-columns: repeat({{ mobile_cols }}, 1fr);
      gap: 15px;
    }
  }

  .br-variant-card {
    background: var(--card-bg);
    border-radius: var(--card-radius);
    padding: {{ section.settings.card_padding }}px;
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
    {% if section.settings.card_border_show %}
    border: 1px solid {{ section.settings.card_border_color }};
    {% endif %}
  }

  @media (max-width: 749px) {
    .br-variant-card {
      padding: {{ section.settings.card_padding_mobile }}px;
    }
  }

  .br-variant-card.is-hidden {
    display: none;
  }

  .br-variant-card.is-visible {
    display: flex;
  }

  .br-variant-badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    z-index: 2;
  }

  .br-badge {
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 3px;
    width: fit-content;
    max-width: 100%;
  }

  .br-badge--sale {
    background: var(--sale-badge-bg);
    color: var(--sale-badge-color);
  }

  #br-variants-{{ section.id }} .br-badge--le.br-le-av,
  .br-le-av.br-badge {
    background: #458CD9 !important;
    color: #ffffff !important;
    font-family: var(--le-font-family) !important;
    font-size: var(--le-font-size) !important;
    font-weight: var(--le-font-weight) !important;
    letter-spacing: var(--le-letter-spacing) !important;
    text-transform: uppercase;
  }

  #br-variants-{{ section.id }} .br-badge--oneoff {
    background: var(--oneoff-badge-bg) !important;
    color: var(--oneoff-badge-color) !important;
    font-family: var(--le-font-family) !important;
    font-size: var(--oneoff-font-size) !important;
    font-weight: var(--oneoff-font-weight) !important;
    letter-spacing: var(--oneoff-letter-spacing) !important;
    color: var(--oneoff-text-color) !important;
    text-transform: uppercase;
  }

  .br-variant-link {
    text-decoration: none;
    color: inherit;
  }
  .br-variant-link:hover {
    text-decoration: underline;
  }
  .br-variant-link--image {
    display: block;
    line-height: 0;
  }
  .br-variant-link--image:hover {
    text-decoration: none;
  }
  .br-variant-image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: calc(var(--card-radius) - 4px);
    margin-bottom: 15px;
  }

  .br-variant-images--dual {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 8px;
    margin-bottom: 15px;
    line-height: 0;
    width: 100%;
  }
  .br-variant-images--dual .br-variant-link--image {
    flex: 1 1 0;
    min-width: 0;
    max-width: calc(50% - 4px);
    display: block;
    overflow: hidden;
    border-radius: calc(var(--card-radius) - 4px);
  }
  .br-variant-images--dual .br-variant-image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
    border-radius: 0;
    margin: 0;
    display: block;
  }
  #br-variants-{{ section.id }} .br-product-group[data-product-group="4"] .br-variant-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  #br-variants-{{ section.id }} .br-product-group[data-product-group="4"] .br-variant-info {
    flex-grow: 1;
    min-height: 0;
  }
  #br-variants-{{ section.id }} .br-product-group[data-product-group="4"] .br-variant-btn {
    margin-top: auto;
  }

  .br-variant-info {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .br-variant-title {
    font-size: var(--title-size);
    font-weight: 600;
    margin: 0 0 5px;
  }

  @media (max-width: 749px) {
    .br-variant-title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }
  }

  .br-variant-subtitle {
    font-size: var(--subtitle-size);
    color: #666;
    margin: 0 0 5px;
  }

  @media (max-width: 749px) {
    .br-variant-subtitle {
      font-size: {{ section.settings.subtitle_size_mobile }}px;
    }
  }

  .br-variant-option {
    font-size: 14px;
    color: #333;
    margin: 0 0 10px;
    word-wrap: break-word;
    overflow-wrap: break-word;
    overflow: visible;
    white-space: normal;
    min-width: 0;
  }

  @media (max-width: 749px) {
    .br-variant-option {
      font-size: {{ section.settings.variant_text_size_mobile }}px;
    }
  }

  .br-variant-option-mobile {
    display: none;
  }

  @media (max-width: 749px) {
    .br-variant-option-desktop {
      display: none;
    }
    .br-variant-option-mobile {
      display: block;
      font-size: {{ section.settings.variant_text_size_mobile }}px;
      color: #333;
      margin: 0 0 10px;
    }
  }

  .br-variant-size-pill {
    display: inline-block;
    background: #eee;
    padding: 2px 7px;
    border-radius: 4px;
    font-weight: 700;
    font-size: inherit;
    line-height: 1.4;
    white-space: nowrap;
  }
  .br-variant-opts-rest {
    font-weight: 500;
    color: #555;
  }
  @media (max-width: 749px) {
    .br-variant-size-pill {
      padding: 1px 5px;
      border-radius: 3px;
    }
  }

  .br-size-filter {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1;
  }
  .br-size-filter__link {
    all: unset;
    cursor: pointer;
    padding: 4px 10px;
    border-radius: 4px;
    font-weight: 600;
    background: #f5f5f5;
    transition: background .15s, color .15s;
  }
  .br-size-filter__link:hover {
    background: #e0e0e0;
  }
  .br-size-filter__link.is-active {
    background: transparent;
    color: #111;
    box-shadow: inset 0 0 0 1px #111;
  }
  .br-size-filter__sep {
    color: #ccc;
    user-select: none;
  }
  .br-size-filter__divider {
    color: #999;
    user-select: none;
    margin: 0 4px;
    font-weight: 400;
    font-size: 1.1em;
  }
  .br-size-filter__text-link,
  .br-size-filter__text-link a,
  .br-size-filter__text-link button {
    font-size: inherit;
    font-weight: 500;
    color: #666;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color .15s;
  }
  .br-size-filter__text-link:hover,
  .br-size-filter__text-link a:hover,
  .br-size-filter__text-link button:hover {
    color: #111;
    text-decoration: underline;
  }
  @media (max-width: 749px) {
    .br-size-filter {
      gap: 3px;
      font-size: 12px;
      margin: 0 0 12px;
    }
    .br-size-filter__link {
      padding: 3px 6px;
    }
    .br-size-filter__divider {
      margin: 0 2px;
    }
  }

  .br-variant-price {
    margin: 0 0 15px;
    font-size: 16px;
  }

  .br-price--sale {
    color: var(--sale-price-color);
    font-weight: 700;
  }

  .br-price--compare {
    color: var(--compare-color);
    text-decoration: line-through;
    margin-left: 8px;
    font-size: 14px;
  }

  .br-variant-btn {
    margin-top: auto;
    background: var(--btn-bg);
    color: var(--btn-color);
    border: 2px solid var(--btn-bg);
    border-radius: var(--btn-radius);
    padding: var(--btn-pad-v) var(--btn-pad-h);
    font-size: var(--btn-font-size-desktop) !important;
    font-weight: inherit;
    cursor: pointer;
    transition: opacity 0.2s, background 0.2s, color 0.2s;
    width: 100%;
    touch-action: manipulation;
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0.08);
  }

  .br-variant-btn:hover {
    opacity: 0.85;
  }

  .br-variant-btn:disabled {
    background: #ccc;
    border-color: #ccc;
    color: #666;
    cursor: not-allowed;
    font-size: var(--btn-font-size-desktop) !important;
  }
  .br-variant-card--sold-out .br-variant-option,
  .br-variant-card--sold-out .br-variant-option-desktop,
  .br-variant-card--sold-out .br-variant-option-mobile {
    text-decoration: line-through;
    color: #666;
  }

  @media (max-width: 749px) {
    .br-variant-btn,
    .br-variant-btn:hover,
    .br-variant-btn:disabled {
      font-size: var(--btn-font-size-mobile) !important;
    }
  }

  /* Outline style: desktop only (min-width 750px) */
  @media (min-width: 750px) {
    .br-variant-btn.br-variant-btn--outline-desktop {
      background: transparent;
      color: var(--btn-bg);
    }
    .br-variant-btn.br-variant-btn--outline-desktop:hover:not(:disabled) {
      background: var(--btn-bg);
      color: var(--btn-color);
    }
  }

  @media (max-width: 749px) {
    .br-variant-btn.br-variant-btn--outline-mobile {
      background: transparent;
      color: var(--btn-bg);
    }
    .br-variant-btn.br-variant-btn--outline-mobile:hover:not(:disabled) {
      background: var(--btn-bg);
      color: var(--btn-color);
    }
  }

  .br-variants-toggle {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5em 1em;
    margin-top: 12px;
  }

  .br-toggle-btn {
    background: none !important;
    border: none !important;
    padding: 0;
    font-size: 16px;
    font-weight: 600;
    color: #222;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.2s ease, text-decoration-thickness 0.2s ease;
  }

  .br-toggle-btn:hover {
    color: #000;
    text-decoration-thickness: 2px;
  }

  .br-toggle-btn .br-toggle-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .br-toggle-btn:hover .br-toggle-arrow {
    transform: translateX(3px);
  }

  .br-toggle-btn.is-hidden {
    display: none;
  }

  /* Desktop/Mobile visibility */
  .br-desktop-only { display: block; }
  .br-mobile-only { display: none; }
  .br-btn-desktop { display: inline; }
  .br-btn-mobile { display: none; }
  
  @media (max-width: 749px) {
    .br-desktop-only { display: none; }
    .br-mobile-only { display: block; }
    .br-btn-desktop { display: none; }
    .br-btn-mobile { display: inline; }
  }

  /* Product Label/Divider */
  .br-product-label {
    grid-column: 1 / -1;
    text-align: left;
    padding: 20px 0 10px;
    margin-top: 10px;
  }

  .br-product-label:first-child {
    margin-top: 0;
    padding-top: 0;
  }

  .br-product-label-text {
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    font-weight: 600;
    font-size: {{ section.settings.product_label_size_desktop }}px;
    color: {{ section.settings.product_label_color }};
    margin: 0;
  }

  @media (max-width: 749px) {
    .br-product-label-text {
      font-size: {{ section.settings.product_label_size_mobile }}px;
    }
  }

  .br-product-label.is-hidden {
    display: none;
  }

  /* Filter Tabs */
  .br-filter-tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }

  .br-filter-tab {
    padding: 10px 24px;
    min-height: 42px;
    line-height: 1.3;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--btn-font-size-desktop) !important;
    font-weight: inherit;
    {% if section.settings.tab_inactive_border %}
    border: {{ section.settings.tab_border_width }}px solid {{ section.settings.tab_border_color }};
    {% else %}
    border: {{ section.settings.tab_border_width }}px solid transparent;
    {% endif %}
    background: transparent;
    color: {{ section.settings.tab_text_color }};
    border-radius: {{ section.settings.tab_radius }}px;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0.08);
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    touch-action: manipulation;
  }

  /* Desktop hover only (avoid iOS sticky hover on touch) */
  @media (hover: hover) and (pointer: fine) {
    .br-filter-tab:hover {
      background: {{ section.settings.tab_active_bg }};
      color: {{ section.settings.tab_active_text }};
      border-color: {{ section.settings.tab_active_bg }};
    }
  }
  /* Explicitly neutralize sticky :hover on touch devices (including base .btn:hover styles) */
  @media (hover: none) and (pointer: coarse) {
    .br-filter-tab:hover:not(.is-active) {
      background: transparent !important;
      color: {{ section.settings.tab_text_color }} !important;
      {% if section.settings.tab_inactive_border %}
      border-color: {{ section.settings.tab_border_color }} !important;
      {% else %}
      border-color: transparent !important;
      {% endif %}
    }
  }

  .br-filter-tab.is-active {
    background: {{ section.settings.tab_active_bg }};
    color: {{ section.settings.tab_active_text }};
    border: {{ section.settings.tab_border_width }}px solid {{ section.settings.tab_active_border }};
  }

  /* One off colors tab: gradient when not selected so it stands out; accent when active/hover */
  #br-variants-{{ section.id }} .br-filter-tab[data-product="4"] {
    background: linear-gradient(135deg, #e8eaef 0%, #e0e4ec 35%, #d8dce4 70%, #e4e8f0 100%);
    border-color: {{ section.settings.exclusive_tab_accent_color | default: '#8c7b5c' }};
    color: {{ section.settings.exclusive_tab_active_text | default: '#333333' }};
  }
  #br-variants-{{ section.id }} .br-filter-tab[data-product="4"].is-active {
    background: {{ section.settings.exclusive_tab_active_bg | default: '#f0f0f0' }};
    color: {{ section.settings.exclusive_tab_active_text | default: '#333333' }};
    border-color: {{ section.settings.exclusive_tab_accent_color | default: '#8c7b5c' }};
  }
  @media (hover: hover) and (pointer: fine) {
    #br-variants-{{ section.id }} .br-filter-tab[data-product="4"]:hover {
      border-color: {{ section.settings.exclusive_tab_accent_color | default: '#8c7b5c' }};
      background: {{ section.settings.exclusive_tab_active_bg | default: '#f0f0f0' }};
      color: {{ section.settings.exclusive_tab_active_text | default: '#333333' }};
    }
  }
  @media (hover: none) and (pointer: coarse) {
    #br-variants-{{ section.id }} .br-filter-tab[data-product="4"]:hover:not(.is-active) {
      background: linear-gradient(135deg, #e8eaef 0%, #e0e4ec 35%, #d8dce4 70%, #e4e8f0 100%) !important;
      border-color: {{ section.settings.exclusive_tab_accent_color | default: '#8c7b5c' }} !important;
      color: {{ section.settings.exclusive_tab_active_text | default: '#333333' }} !important;
    }
  }

  @media (max-width: 749px) {
    .br-filter-tabs {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .br-filter-tabs::-webkit-scrollbar { display: none; }
    .br-filter-tab {
      flex: 0 0 auto;
      max-width: none;
    }
  }
  @media (max-width: 768px) {
    .br-filter-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .br-filter-tab {
      width: 100%;
      padding: 14px 10px;
      min-height: 44px;
      font-size: 14px !important;
    }
    .br-filter-tab:nth-child(3):last-child {
      grid-column: 1 / -1;
      justify-self: center;
      max-width: 180px;
    }
  }

  /* Product groups for filtering */
  .br-product-group {
    display: contents;
  }

  /* One off tab: own grid, 4 items per row by default */
  #br-variants-{{ section.id }} .br-product-group[data-product-group="4"] {
    display: block;
    grid-column: 1 / -1;
  }
  #br-variants-{{ section.id }} .br-one-off-inner {
    display: grid;
    grid-template-columns: repeat({{ section.settings.one_off_columns | default: 3 }}, 1fr);
    gap: 20px;
    align-items: stretch;
  }
  #br-variants-{{ section.id }} .br-product-group[data-product-group="4"] .br-variant-card {
    min-width: 0;
  }
  #br-variants-{{ section.id }} .br-product-group[data-product-group="4"] .br-variant-info {
    min-width: 0;
  }
  /* One off: category titles span full width and don’t break layout */
  #br-variants-{{ section.id }} .br-one-off-inner .br-product-label {
    grid-column: 1 / -1;
    margin-bottom: 0;
    padding: 12px 0 8px;
  }
  #br-variants-{{ section.id }} .br-one-off-inner .br-product-label:first-child {
    padding-top: 0;
  }
  #br-variants-{{ section.id }} .br-one-off-inner .br-product-label-text {
    margin: 0;
    font-weight: 600;
    line-height: 1.25;
    word-wrap: break-word;
    overflow-wrap: break-word;
    color: #666666;
  }
  /* Product titles (Open Sole / Closed Sole) vs color sub-headings use same text style; both span full width */
  @media (max-width: 749px) {
    #br-variants-{{ section.id }} .br-one-off-inner {
      grid-template-columns: repeat({{ mobile_cols }}, 1fr);
      gap: 15px;
    }
  }

  .br-product-group.is-hidden,
  .br-product-group.is-hidden .br-variant-card,
  .br-product-group.is-hidden .br-product-label {
    display: none !important;
  }
  .br-product-group[data-product-group="4"].is-hidden .br-one-off-inner {
    display: none !important;
  }
  /* One off image lightbox */
  .br-oneoff-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.85);
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }
  .br-oneoff-lightbox.is-open {
    display: flex;
  }
  .br-oneoff-lightbox__inner {
    max-width: 90vw;
    max-height: 90vh;
    position: relative;
  }
  .br-oneoff-lightbox__inner img {
    max-width: 100%;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .br-oneoff-lightbox--dual .br-oneoff-lightbox__images {
    display: flex;
    flex-direction: row;
    gap: 16px;
    align-items: center;
    justify-content: center;
    max-width: 95vw;
  }
  .br-oneoff-lightbox--dual .br-oneoff-lightbox__images img {
    max-width: 45vw;
    max-height: 85vh;
  }
  .br-oneoff-lightbox__close {
    position: absolute;
    top: -40px;
    right: 0;
    background: #fff;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #333;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }
  .br-oneoff-lightbox__close:hover {
    background: #f0f0f0;
  }
</style>
{%- comment -%} When "Use current product" is on and this is a one-off product page, hide the main product section so only the All Variants grid shows. Do not hide on other product pages (e.g. water shoe). {%- endcomment -%}
{% if _hide_main_product %}
<style>
  body.br-hide-main-product-on-variants .shopify-section__product,
  body.br-hide-main-product-on-variants main.main-content .shopify-section:first-of-type { display: none !important; }
</style>
<script>
  (function() {
    function hideMainProduct() {
      if (document.body && !document.body.classList.contains('br-hide-main-product-on-variants')) {
        document.body.classList.add('br-hide-main-product-on-variants');
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hideMainProduct);
    } else {
      hideMainProduct();
    }
  })();
</script>
{% endif %}

{% if target_product != nil %}
