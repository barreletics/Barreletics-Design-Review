    <div class="br-variants-grid" id="br-grid-{{ section.id }}">
      
      {%- comment -%} PRODUCT 1: Kids always last. Pass 1 = non-kids, Pass 2 = kids. Hide variant when variant.metafields.custom.hide_from_storefront.value == true. LE badge from custom.limited_colors. Tab prefix for card subtitle (style removed from variants). Single product: derive short label from handle. {%- endcomment -%}
      {%- if has_multiple_products -%}
        {%- assign tab_prefix_1 = section.settings.tab_1_label | default: target_product.title -%}
      {%- else -%}
        {%- assign _ph = target_product.handle | default: '' -%}
        {%- if _ph == 'studio-performance-skin-footwear' -%}
          {%- assign tab_prefix_1 = 'Open Sole' -%}
        {%- elsif _ph == 'best-reformer-pilates-legree-workout-shoes' -%}
          {%- assign tab_prefix_1 = 'Closed Sole' -%}
        {%- elsif _ph == 'aquatic-performance-skins' -%}
          {%- assign tab_prefix_1 = 'Outdoor' -%}
        {%- else -%}
          {%- assign tab_prefix_1 = section.settings.tab_1_label | default: target_product.title -%}
        {%- endif -%}
      {%- endif -%}
      {%- assign non_kids_seen = 0 -%}
      {%- assign has_see_more_tier = false -%}
      {%- assign has_kids_tier = false -%}
      {%- assign show_kids_1 = true -%}
      {%- assign _sk1 = target_product.metafields.custom.show_kids_sizes.value -%}
      {%- if _sk1 == false or _sk1 == "false" or _sk1 == "False" -%}{%- assign show_kids_1 = false -%}{%- endif -%}
      <div class="br-product-group" id="br-product-1-{{ section.id }}" data-product-group="1">
      {% if show_product_labels and section.settings.product_1_label != blank %}
        <div class="br-product-label">
          <p class="br-product-label-text">{{ section.settings.product_1_label }}</p>
        </div>
      {% endif %}
      
      {%- comment -%} Pass 1: non-kids only (initial + see-more) {%- endcomment -%}
      {%- assign le_badge_shown_1 = false -%}
      {%- assign oneoff_badge_shown_1 = false -%}
      {% for variant in target_product.variants limit: max_count %}
        {%- liquid
          assign is_on_sale = false
          if variant.compare_at_price > variant.price
            assign is_on_sale = true
          endif
          assign is_limited = false
          assign opt_count = target_product.options_with_values.size
          assign opt0_down = ''
          assign opt1_down = ''
          assign opt2_down = ''
          if opt_count > 0
            assign opt0_down = target_product.options_with_values[0].name | downcase
          endif
          if opt_count > 1
            assign opt1_down = target_product.options_with_values[1].name | downcase
          endif
          if opt_count > 2
            assign opt2_down = target_product.options_with_values[2].name | downcase
          endif
          assign color_value = blank
          if opt_count > 0 and opt0_down == 'color'
            assign color_value = variant.option1
          elsif opt_count > 1 and opt1_down == 'color'
            assign color_value = variant.option2
          elsif opt_count > 2 and opt2_down == 'color'
            assign color_value = variant.option3
          endif
          assign color_value_clean = color_value | strip | downcase
          assign le_raw = ''
          assign le_me = target_product.metafields.custom.limited_colors | default: target_product.metafields.custom.limited_edition_colors
          if le_me != blank and le_me.value != blank
            assign le_raw = le_me.value | strip
          endif
          if le_raw != blank
            assign le_list = le_raw | split: ','
            for le_c in le_list
              assign le_clean = le_c | strip | downcase
              if le_clean != blank and le_clean == color_value_clean
                assign is_limited = true
                break
              endif
            endfor
          endif
          assign is_kid_br = false
          assign _o1 = variant.option1 | default: ''
          assign _o2 = variant.option2 | default: ''
          assign _o3 = variant.option3 | default: ''
          assign _o1d = _o1 | downcase
          assign _o2d = _o2 | downcase
          assign _o3d = _o3 | downcase
          if _o1 != blank and _o1d contains kids_trigger_br
            assign is_kid_br = true
          elsif _o2 != blank and _o2d contains kids_trigger_br
            assign is_kid_br = true
          elsif _o3 != blank and _o3d contains kids_trigger_br
            assign is_kid_br = true
          endif
          assign skip_card = false
          assign _v_hidden = variant.metafields.custom.hide_from_storefront.value
