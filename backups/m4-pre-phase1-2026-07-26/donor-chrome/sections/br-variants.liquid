              endunless
            endunless
          endif
        endfor
      endif
      if target_product_2 != nil
        assign _bp2_o0 = target_product_2.options_with_values[0].name | downcase
        assign _bp2_o1 = target_product_2.options_with_values[1].name | downcase
        assign _bp2_o2 = target_product_2.options_with_values[2].name | downcase
        for _bsv in target_product_2.variants
          assign _bsv_sz = ''
          if _bp2_o0 == 'size'
            assign _bsv_sz = _bsv.option1
          elsif _bp2_o1 == 'size'
            assign _bsv_sz = _bsv.option2
          elsif _bp2_o2 == 'size'
            assign _bsv_sz = _bsv.option3
          endif
          if _bsv_sz != blank
            assign _bsv_sz = _bsv_sz | strip | split: ' (' | first | strip
            assign _bsv_sz_down = _bsv_sz | downcase
            unless _bsv_sz_down contains 'kid'
              assign _check_sz = '|' | append: _bsv_sz | append: '|'
              unless _br_sizes contains _check_sz
                assign _br_sizes = _br_sizes | append: _bsv_sz | append: '|'
              endunless
            endunless
          endif
        endfor
      endif
      if target_product_3 != nil
        assign _bp3_o0 = target_product_3.options_with_values[0].name | downcase
        assign _bp3_o1 = target_product_3.options_with_values[1].name | downcase
        assign _bp3_o2 = target_product_3.options_with_values[2].name | downcase
        for _bsv in target_product_3.variants
          assign _bsv_sz = ''
          if _bp3_o0 == 'size'
            assign _bsv_sz = _bsv.option1
          elsif _bp3_o1 == 'size'
            assign _bsv_sz = _bsv.option2
          elsif _bp3_o2 == 'size'
            assign _bsv_sz = _bsv.option3
          endif
          if _bsv_sz != blank
            assign _bsv_sz = _bsv_sz | strip | split: ' (' | first | strip
            assign _bsv_sz_down = _bsv_sz | downcase
            unless _bsv_sz_down contains 'kid'
              assign _check_sz = '|' | append: _bsv_sz | append: '|'
              unless _br_sizes contains _check_sz
                assign _br_sizes = _br_sizes | append: _bsv_sz | append: '|'
              endunless
            endunless
          endif
        endfor
      endif
      assign _br_sizes = _br_sizes | remove_first: '|'
      assign _br_sizes_arr = _br_sizes | split: '|'
    -%}
    {%- unless _br_sizes == blank -%}
