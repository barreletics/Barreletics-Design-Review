        "custom_html": "<style>\n  .br-why-strip {\n    background: #f4f4f4;\n    padding: 0;\n    margin-top: 12px;\n    margin-bottom: 12px;\n    display: flex;\n    align-items: stretch;\n    border-top: 0.5px solid #ddd;\n    border-bottom: 0.5px solid #ddd;\n    font-family: 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif;\n    width: 100%;\n    box-sizing: border-box;\n    -webkit-font-smoothing: antialiased;\n  }\n  .br-why-strip__label {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: #111;\n    white-space: nowrap;\n    flex-shrink: 0;\n    padding: 14px 20px;\n    background: #fff;\n    border-right: 1px solid #ddd;\n  }\n  .br-why-strip__pts {\n    display: flex;\n    flex: 1;\n    justify-content: space-between;\n    align-items: center;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: #666;\n    padding: 14px 16px;\n  }\n  .br-why-strip__div {\n    width: 1px;\n    height: 14px;\n    background: #ddd;\n    flex-shrink: 0;\n    margin: 0 4px;\n  }\n\n  @media (max-width: 749px) {\n    .br-why-strip__label { display: none; }\n    .br-why-strip {\n      padding: 10px 12px;\n      background: #f4f4f4;\n    }\n    .br-why-strip__pts {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 10px;\n      padding: 0;\n      font-size: 11px;\n      letter-spacing: 0.07em;\n      line-height: 1.3;\n      text-align: center;\n      justify-items: center;\n      width: 100%;\n    }\n    .br-why-strip__div { display: none; }\n  }\n</style>\n\n<div class=\"br-why-strip\">\n  <span class=\"br-why-strip__label\">Why it works</span>\n  <div class=\"br-why-strip__pts\">\n    <span>360° Grip</span><span class=\"br-why-strip__div\"></span>\n    <span>No Slipping</span><span class=\"br-why-strip__div\"></span>\n    <span>Stay Secure</span><span class=\"br-why-strip__div\"></span>\n    <span>No Sock Fuss</span><span class=\"br-why-strip__div\"></span>\n    <span>Rinse &amp; Reuse</span><span class=\"br-why-strip__div\"></span>\n    <span>No Latex</span>\n  </div>\n</div>"
      }
    },
