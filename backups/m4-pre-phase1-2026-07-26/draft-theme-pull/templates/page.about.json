    "ss_hero_27_kxGmGF": {
      "type": "ss-hero-27",
      "blocks": {
        "heading_i4wHfT": {
          "type": "heading",
          "settings": {
            "heading": "<h2>Trial and Error Led To 100% Grip All The Time</h2>",
