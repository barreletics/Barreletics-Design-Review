    "ss_feature_9_H7GrbY": {
      "type": "ss-feature-9",
      "blocks": {
        "feature_Yc334U": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/Screen_Shot_2024-10-22_at_7.34.27_PM.png",
            "title": "<h2><strong>Comfort</strong></h2>",
            "text": "<p><strong>Engineered for comfort. </strong>Wearing Barreletics for the first time, you will be amazed how much more you can push yourself during practice.  The added comfort forms cushioning at the ball of your foot and heel that will relieve pressure points in oppositional poses. </p>"
          }
        },
        "feature_CQUeQB": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/Screen_Shot_2024-10-20_at_12.32.45_PM.png",
            "title": "<h2><strong>Outdoor Protection</strong></h2>",
            "text": "<p><strong>When outdoors</strong>, protect your feet from hot surfaces and the bare ground.<em>Better than barefoot, like a second skin around your foot.</em>Great for boating, paddle boarding, beach, spa and ocean.</p>"
          }
        },
        "feature_t4fTfX": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/Screen_Shot_2024-10-22_at_7.33.23_PM.png",
            "title": "<h2><strong>In-Studio Support</strong></h2>",
            "text": "<p><em><strong>Barre and Pilates precision and performance. </strong></em><em>Feel the all-around grip, support and balance </em>on the reformer or in any oppositional Barre pose. Dig into a <strong>deep lunge </strong>without sliding! <em>Lightweight. Breathable.</em></p>"
          }
        },
        "feature_gEg6aB": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/Screen_Shot_2024-10-20_at_12.47.39_PM.png",
            "title": "<h4><strong>Workout Performance</strong></h4>",
            "text": "<p><strong>Amp up your workout </strong>and notice the difference when you can <em>max out at full potential </em><span style=\"text-decoration:underline\">without a pilates sock holding you back.</span></p>"
          }
        }
      },
