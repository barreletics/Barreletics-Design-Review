{% comment %}
  BR Sale Banner (theme-update safe)
  Purpose: Replace AI banner blocks that can disappear during theme updates.
  Safety: Wrapper uses pointer-events:none so it can't block header/menu taps.
{% endcomment %}

{%- liquid
  assign br_id = section.id | replace: '_', '' | downcase
-%}

{% style %}
  .br-sale-banner-{{ br_id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding }}px 20px;
    text-align: center;
    width: 100%;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .br-sale-banner__content-{{ br_id }} {
    max-width: 1200px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
  }

  .br-sale-banner__text-{{ br_id }} {
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    letter-spacing: {{ section.settings.letter_spacing }}px;
    margin: 0;
    line-height: 1.2;
    text-transform: {{ section.settings.text_transform }};
  }

  .br-sale-banner__link-{{ br_id }} {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    display: inline-flex;
  }

  .br-sale-banner__link-{{ br_id }}:hover { opacity: 0.85; }

  @media screen and (max-width: 749px) {
    .br-sale-banner__text-{{ br_id }} {
      font-size: {{ section.settings.font_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="br-sale-banner-{{ br_id }}">
  {%- if section.settings.link != blank -%}
    <a class="br-sale-banner__link-{{ br_id }} br-sale-banner__content-{{ br_id }}" href="{{ section.settings.link }}">
      <p class="br-sale-banner__text-{{ br_id }}">{{ section.settings.message }}</p>
    </a>
  {%- else -%}
    <div class="br-sale-banner__content-{{ br_id }}">
      <p class="br-sale-banner__text-{{ br_id }}">{{ section.settings.message }}</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "BR Sale banner (safe)",
  "tag": "section",
  "class": "br-sale-banner-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "message",
      "label": "Message",
      "default": "Buy 2 Save 15% | Use code: SAVE15"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#458cd9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Padding",
      "default": 6
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "label": "Letter spacing",
      "default": 2.5
    }
  ],
  "presets": [
    { "name": "BR Sale banner (safe)" }
  ]
}
{% endschema %}

