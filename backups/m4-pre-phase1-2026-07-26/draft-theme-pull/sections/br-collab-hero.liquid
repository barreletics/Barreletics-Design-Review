
{% assign ai_gen_id = section.id | handleize | replace: '-', '' | replace: '_', '' %}
{% assign html_id = 'br-collab-hero-' | append: section.id | handleize %}
{% assign br_collab_heading_id = 'br-collab-h-' | append: ai_gen_id %}
{% liquid
  assign col_n = section.settings.desktop_columns | plus: 0
  assign max_rows = section.settings.product_grid_max_rows | default: 2 | plus: 0
  assign max_grid_items = max_rows | times: col_n
  if max_grid_items > 6
    assign max_grid_items = 6
  endif
  if max_grid_items < 1
    assign max_grid_items = 1
  endif
  assign hero_vh = section.settings.hero_area_height_vh | default: 100 | plus: 0
  assign hero_zoom_s = section.settings.hero_video_zoom_percent | default: 100 | times: 0.01

  assign hero_scrim_on = true
  if section.settings.hero_collab_readability_scrim == false
    assign hero_scrim_on = false
  endif
  assign tile4_scrim_on = true
  if section.settings.tile4_collab_readability_scrim == false
    assign tile4_scrim_on = false
  endif

  assign hero_s_top = section.settings.hero_scrim_top_opacity | default: 22 | plus: 0 | times: 0.01
  assign hero_s_bot = section.settings.hero_scrim_bottom_opacity | default: 72 | plus: 0 | times: 0.01
  assign t4_s_top = section.settings.tile4_scrim_top_opacity | default: 18 | plus: 0 | times: 0.01
  assign t4_s_bot = section.settings.tile4_scrim_bottom_opacity | default: 78 | plus: 0 | times: 0.01
%}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Syne:wght@400;500;700&display=swap');

  .br-ctb-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: 12;
    display: flex;
    flex-direction: column;
    padding: 52px;
    pointer-events: none;
    box-sizing: border-box;
  }

  .br-ctb-hero--align-bl-{{ ai_gen_id }} {
    justify-content: flex-end;
    align-items: flex-start;
    text-align: left;
  }

  .br-ctb-hero--align-c-{{ ai_gen_id }} {
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  {% if hero_scrim_on %}
    .br-ctb-hero-overlay-{{ ai_gen_id }}.br-ctb-hero--readability-{{ ai_gen_id }} {
      background: linear-gradient(to bottom, rgba(0, 0, 0, {{ hero_s_top }}), rgba(0, 0, 0, {{ hero_s_bot }}));
    }
  {% endif %}

  .br-tile4-collab-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: 8;
    display: flex;
    flex-direction: column;
    pointer-events: none;
    box-sizing: border-box;
  }

  .br-tile4--align-bl-{{ ai_gen_id }} {
    justify-content: flex-end;
    align-items: flex-start;
    text-align: left;
    padding: 18px 14px 22px 14px;
  }

  .br-tile4--align-c-{{ ai_gen_id }} {
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 20px 16px;
  }

  .br-tile4-eye-{{ ai_gen_id }} {
    font-family: 'Syne', sans-serif;
    font-size: {{ section.settings.tile4_collab_font_eyebrow | default: 8 }}px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    max-width: 100%;
    color: {{ section.settings.grid_tile_4_eyebrow_color | default: '#2a2a2a' }};
  }

  .br-tile4-title-{{ ai_gen_id }} {
    font-family: 'Cormorant Garamond', serif;
    font-size: {{ section.settings.tile4_collab_font_title | default: 20 }}px;
    font-weight: 300;
    font-style: italic;
    margin: 0 0 10px 0;
    line-height: 1.15;
    max-width: 28em;
    color: {{ section.settings.grid_tile_4_title_color | default: '#1a1a1a' }};
  }

  .br-tile4-body-{{ ai_gen_id }} {
    font-family: 'Cormorant Garamond', serif;
    font-size: {{ section.settings.tile4_collab_font_body | default: 12 }}px;
    font-style: italic;
    line-height: 1.5;
    max-width: 26em;
    margin: 0 0 10px 0;
    color: {{ section.settings.grid_tile_4_body_color | default: '#333333' }};
  }

  .br-tile4-body-{{ ai_gen_id }} p {
    margin: 0;
  }

  .br-tile4-meta-{{ ai_gen_id }} {
    font-family: 'Syne', sans-serif;
    font-size: {{ section.settings.tile4_collab_font_meta | default: 7 }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
    color: {{ section.settings.grid_tile_4_meta_color | default: '#555555' }};
  }

  {% if tile4_scrim_on %}
    .br-tile4-collab-overlay-{{ ai_gen_id }}.br-tile4--readability-{{ ai_gen_id }} {
      background: linear-gradient(to bottom, rgba(0, 0, 0, {{ t4_s_top }}), rgba(0, 0, 0, {{ t4_s_bot }}));
    }

    .br-tile4--readability-{{ ai_gen_id }} .br-tile4-eye-{{ ai_gen_id }} {
      color: rgba(255, 255, 255, 0.62) !important;
    }

    .br-tile4--readability-{{ ai_gen_id }} .br-tile4-title-{{ ai_gen_id }} {
      color: #ffffff !important;
    }

    .br-tile4--readability-{{ ai_gen_id }} .br-tile4-body-{{ ai_gen_id }} {
      color: rgba(255, 255, 255, 0.78) !important;
    }

    .br-tile4--readability-{{ ai_gen_id }} .br-tile4-meta-{{ ai_gen_id }} {
      color: rgba(255, 255, 255, 0.42) !important;
    }
  {% endif %}

  .br-ctb-eye-{{ ai_gen_id }} {
    font-family: 'Syne', sans-serif;
    font-size: {{ section.settings.hero_collab_font_eyebrow | default: 9 }}px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: {{ section.settings.hero_collab_text_color | default: '#ffffff' }};
    margin: 0 0 10px 0;
  }

  .br-ctb-title-{{ ai_gen_id }} {
    font-family: 'Cormorant Garamond', serif;
    font-size: {{ section.settings.hero_collab_font_title | default: 48 }}px;
    font-weight: 300;
    font-style: italic;
    color: {{ section.settings.hero_collab_text_color | default: '#ffffff' }};
    margin: 0 0 10px 0;
    line-height: 1.05;
    max-width: 560px;
  }

  .br-ctb-sub-{{ ai_gen_id }} {
    font-family: 'Cormorant Garamond', serif;
    font-size: {{ section.settings.hero_collab_font_body | default: 15 }}px;
    font-style: italic;
    color: {{ section.settings.hero_collab_text_color | default: '#ffffff' }};
    margin: 0 0 18px 0;
    line-height: 1.55;
    max-width: 420px;
  }

  .br-ctb-sub-{{ ai_gen_id }} p {
    margin: 0;
    color: inherit;
  }

  .br-ctb-cta-{{ ai_gen_id }} {
    display: inline-block;
    box-sizing: border-box;
    font-family: 'Syne', sans-serif;
    font-size: {{ section.settings.hero_collab_cta_font_size | default: 10 }}px;
    font-weight: {{ section.settings.hero_collab_cta_font_weight | default: 700 }};
    letter-spacing: {{ section.settings.hero_collab_cta_letter_spacing | default: 18 | times: 0.01 }}em;
    text-transform: uppercase;
    color: {{ section.settings.hero_collab_cta_text_color | default: '#000000' }};
    background: {{ section.settings.hero_collab_cta_bg_color | default: '#ffffff' }};
    padding: {{ section.settings.hero_collab_cta_pad_v | default: 14 }}px {{ section.settings.hero_collab_cta_pad_h | default: 32 }}px;
    text-decoration: none;
    border: none !important;
    margin: 0 0 20px 0;
    pointer-events: auto;
    text-align: center;
    line-height: 1.2;
  }

  .br-ctb-cta-{{ ai_gen_id }}:hover,
  .br-ctb-cta-{{ ai_gen_id }}:focus {
    opacity: 0.92;
  }

  .br-ctb-hero--align-bl-{{ ai_gen_id }} .br-ctb-cta-{{ ai_gen_id }} {
    align-self: flex-start;
  }

  .br-ctb-hero--align-c-{{ ai_gen_id }} .br-ctb-cta-{{ ai_gen_id }} {
    align-self: center;
  }

  .br-ctb-meta-{{ ai_gen_id }} {
    font-family: 'Syne', sans-serif;
    font-size: {{ section.settings.hero_collab_font_meta | default: 9 }}px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ section.settings.hero_collab_text_color | default: '#ffffff' }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .br-ctb-hero-overlay-{{ ai_gen_id }} {
      padding: 32px 28px;
    }

    .br-ctb-title-{{ ai_gen_id }} {
      font-size: max(22px, calc({{ section.settings.hero_collab_font_title | default: 48 }}px * 0.55));
    }

    .br-tile4-title-{{ ai_gen_id }} {
      font-size: max(14px, calc({{ section.settings.tile4_collab_font_title | default: 20 }}px * 0.85));
    }
  }

  .ai-collab-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ hero_vh }}vh;
    background-color: {{ section.settings.background_color }};
    overflow: hidden;
    display: block;
  }

  {% if section.settings.hero_edge_to_edge %}
    .ai-collab-hero-{{ ai_gen_id }}.ai-collab-hero--edge-{{ ai_gen_id }} {
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      position: relative;
      left: 0;
      right: 0;
    }
  {% endif %}

  .ai-collab-hero__video-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ hero_vh }}vh;
    min-height: {{ hero_vh }}vh;
    overflow: hidden;
    background-color: {{ section.settings.background_color }};
  }

  .ai-collab-hero__video-media-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ai-collab-hero__video-media-{{ ai_gen_id }} video,
  .ai-collab-hero__video-media-{{ ai_gen_id }} img.ai-collab-hero__poster-image-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    transform: translate(-50%, -50%) scale({{ hero_zoom_s }});
    object-fit: {{ section.settings.hero_video_object_fit | default: 'cover' }};
    object-position: {{ section.settings.hero_video_object_position | default: 'center' }};
  }

  .ai-collab-hero__video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f8f8f8 0%, #e8e8e8 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #999999;
    font-size: 16px;
    gap: 20px;
  }

  .ai-collab-hero__video-placeholder-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    opacity: 0.4;
  }

  .ai-collab-hero__content-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    z-index: 10;
  }

  .ai-collab-hero__title-{{ ai_gen_id }} {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    text-align: center;
    line-height: 1;
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
    margin: 0 0 {{ section.settings.title_spacing }}px 0;
    text-transform: {{ section.settings.title_transform }};
    max-width: 1200px;
  }

  .ai-collab-hero__subtitle-{{ ai_gen_id }} {
    font-size: {{ section.settings.subtitle_size }}px;
    color: {{ section.settings.subtitle_color }};
    text-align: center;
    line-height: 1.4;
    margin: 0 0 {{ section.settings.subtitle_spacing }}px 0;
    max-width: 600px;
    font-weight: {{ section.settings.subtitle_weight }};
    letter-spacing: {{ section.settings.subtitle_letter_spacing }}px;
  }

  .ai-collab-hero__product-subtitle-{{ ai_gen_id }} {
    margin-top: 10px;
    text-align: center;
    line-height: 1.35;
    font-weight: 400;
  }

  .ai-collab-hero__cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.button_text_size }}px;
    font-weight: {{ section.settings.button_weight }};
    border-radius: {{ section.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    text-transform: {{ section.settings.button_transform }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
  }

  .ai-collab-hero__cta-{{ ai_gen_id }}:hover {
    background-color: {{ section.settings.button_hover_bg_color }};
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_border_color }};
  }

  .ai-collab-hero__product-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    padding: {{ section.settings.section_padding }}px 40px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-collab-hero__product-item-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    overflow: hidden;
    background-color: #f8f8f8;
  }

  .ai-collab-hero__product-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .ai-collab-hero__product-item-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collab-hero__product-item-{{ ai_gen_id }}:hover img {
    transform: scale(1.05);
  }

  .ai-collab-hero__product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collab-hero__product-placeholder-{{ ai_gen_id }} svg {
    width: 40%;
    height: 40%;
    opacity: 0.2;
  }

  .ai-collab-hero__product-text-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 20px;
    z-index: 5;
    pointer-events: none;
  }

  .ai-collab-hero__overlay-text-{{ ai_gen_id }} {
    text-align: center;
    line-height: 1.2;
  }

  @media screen and (max-width: 989px) {
    .ai-collab-hero__product-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
      gap: {{ section.settings.grid_gap | times: 0.75 }}px;
      padding: {{ section.settings.section_padding | times: 0.75 }}px 30px;
    }

    .ai-collab-hero__title-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.title_size }}px * 0.6);
    }

    .ai-collab-hero__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.subtitle_size }}px * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collab-hero__product-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.grid_gap | times: 0.5 }}px;
      padding: {{ section.settings.section_padding | times: 0.5 }}px 20px;
    }

    .ai-collab-hero__title-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.title_size }}px * 0.45);
      letter-spacing: calc({{ section.settings.title_letter_spacing }}px * 0.5);
    }

    .ai-collab-hero__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.subtitle_size }}px * 0.75);
    }

    .ai-collab-hero__cta-{{ ai_gen_id }} {
      padding: {{ section.settings.button_padding_vertical | times: 0.8 }}px {{ section.settings.button_padding_horizontal | times: 0.8 }}px;
      font-size: calc({{ section.settings.button_text_size }}px * 0.9);
    }
  }
{% endstyle %}

{% liquid
  assign br_collab_def_eye = 'Limited Edition × Paris SS26'
  assign br_collab_def_hero_title = '<p>Barreletics × Coperni.</p><p>Built for the body in motion.</p>'
  assign br_collab_def_hero_body = '<p>A Pilates shoe designed for comfort, grounding, and athletic poise — introduced on the Coperni runway, Spring–Summer 2026.</p>'
  assign br_collab_def_tile4_title = '<p>Where the runway meets real movement.</p>'
  assign br_collab_def_tile4_body = '<p>Developed for the Coperni Spring–Summer 2026 collection in Paris — a Pilates shoe built for stability, grip, and athletic poise.</p>'

  assign co_eye = section.settings.coperni_overlay_eyebrow | default: br_collab_def_eye
  assign co_title_rt = section.settings.coperni_overlay_title | default: br_collab_def_hero_title
  assign co_sub_rt = section.settings.coperni_overlay_subtitle | default: br_collab_def_hero_body
  assign co_meta = section.settings.coperni_overlay_meta
  assign co_title_plain = co_title_rt | strip_html | strip
  assign co_sub_plain = co_sub_rt | strip_html | strip

  assign t4_eye = section.settings.grid_tile_4_eyebrow | default: br_collab_def_eye
  assign t4_title_rt = section.settings.grid_tile_4_title | default: br_collab_def_tile4_title
  assign t4_body_rt = section.settings.grid_tile_4_body | default: br_collab_def_tile4_body
  assign t4_meta = section.settings.grid_tile_4_meta
  assign t4_title_plain = t4_title_rt | strip_html | strip
  assign t4_body_plain = t4_body_rt | strip_html | strip

  assign hero_collab_align_c = false
  if section.settings.hero_collab_text_position == 'center'
    assign hero_collab_align_c = true
  endif
  assign tile4_collab_align_c = false
  if section.settings.tile4_collab_text_position == 'center'
    assign tile4_collab_align_c = true
  endif

  assign coperni_hero_active = section.settings.coperni_overlay_show_hero
  assign tile4_collab_active = section.settings.coperni_overlay_show_slot4

  assign br_collab_has_heading = false
  if section.settings.coperni_overlay_show_hero and section.settings.coperni_overlay_hide_centered_hero and co_title_plain != blank
    assign br_collab_has_heading = true
  elsif section.settings.title != blank
    assign br_collab_has_heading = true
  endif
%}

<section
  id="{{ html_id }}"
  data-br-collab-root
  class="ai-collab-hero-{{ ai_gen_id }}{% if section.settings.hero_edge_to_edge %} ai-collab-hero--edge-{{ ai_gen_id }}{% endif %}"
  {% if br_collab_has_heading %}
    aria-labelledby="{{ br_collab_heading_id }}"
  {% else %}
    aria-label="{{ section.settings.section_accessible_name | default: 'Collaboration campaign' | escape }}"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="ai-collab-hero__video-container-{{ ai_gen_id }}">
    {% liquid
      assign has_video = false
      if section.settings.runway_video_file != blank or section.settings.runway_video_url != blank
        assign has_video = true
      endif
    %}

    {% if has_video %}
      <div class="ai-collab-hero__video-media-{{ ai_gen_id }}">
        <video
          autoplay
          muted
          loop
          playsinline
          aria-hidden="true"
          {% if section.settings.video_poster %}
            poster="{{ section.settings.video_poster | image_url: width: 2400 }}"
          {% endif %}
        >
          {% if section.settings.runway_video_file != blank %}
            {% for source in section.settings.runway_video_file.sources %}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {% endfor %}
          {% elsif section.settings.runway_video_url != blank %}
            <source src="{{ section.settings.runway_video_url }}" type="video/mp4">
          {% endif %}
        </video>
      </div>
    {% elsif section.settings.video_poster %}
      <div class="ai-collab-hero__video-media-{{ ai_gen_id }}">
        <img
          src="{{ section.settings.video_poster | image_url: width: 2400 }}"
          alt="{{ section.settings.video_poster.alt | default: section.settings.section_accessible_name | default: 'Collaboration campaign' | escape }}"
          class="ai-collab-hero__poster-image-{{ ai_gen_id }}"
          loading="eager"
          fetchpriority="high"
          width="{{ section.settings.video_poster.width }}"
          height="{{ section.settings.video_poster.height }}"
        >
      </div>
    {% else %}
      <div class="ai-collab-hero__video-placeholder-{{ ai_gen_id }}">
        <svg class="ai-collab-hero__video-placeholder-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span>Add video or poster image</span>
      </div>
    {% endif %}

    {% if coperni_hero_active %}
      <div class="br-ctb-hero-overlay-{{ ai_gen_id }}{% if hero_scrim_on %} br-ctb-hero--readability-{{ ai_gen_id }}{% endif %}{% if hero_collab_align_c %} br-ctb-hero--align-c-{{ ai_gen_id }}{% else %} br-ctb-hero--align-bl-{{ ai_gen_id }}{% endif %}">
        <p class="br-ctb-eye-{{ ai_gen_id }}">{{ co_eye | escape }}</p>
        {% if section.settings.coperni_overlay_hide_centered_hero %}
          <h1 id="{{ br_collab_heading_id }}" class="br-ctb-title-{{ ai_gen_id }}">{{ co_title_plain }}</h1>
        {% else %}
          <h2 class="br-ctb-title-{{ ai_gen_id }}">{{ co_title_plain }}</h2>
        {% endif %}
        <div class="br-ctb-sub-{{ ai_gen_id }}">{{ co_sub_rt }}</div>
        {% liquid
          assign co_cta_label = section.settings.hero_collab_cta_label | strip
          assign co_cta_href = section.settings.hero_collab_cta_link
        %}
        {% if co_cta_label != blank and co_cta_href != blank %}
          <a
            href="{{ co_cta_href }}"
            class="br-ctb-cta-{{ ai_gen_id }}"
            {% if section.settings.hero_collab_cta_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            {{- co_cta_label | escape -}}
          </a>
        {% endif %}
        {% if co_meta != blank %}
          <p class="br-ctb-meta-{{ ai_gen_id }}">{{ co_meta | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-collab-hero__content-overlay-{{ ai_gen_id }}">
      {% if section.settings.title != blank %}
        {% unless section.settings.coperni_overlay_show_hero and section.settings.coperni_overlay_hide_centered_hero %}
          <h1 id="{{ br_collab_heading_id }}" class="ai-collab-hero__title-{{ ai_gen_id }}">{{ section.settings.title }}</h1>
        {% endunless %}
      {% endif %}

      {% if section.settings.subtitle != blank %}
        {% unless section.settings.coperni_overlay_show_hero and section.settings.coperni_overlay_hide_centered_hero %}
          <div class="ai-collab-hero__subtitle-{{ ai_gen_id }}">{{ section.settings.subtitle }}</div>
        {% endunless %}
      {% endif %}

      {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
        <a
          href="{{ section.settings.cta_link }}"
          class="ai-collab-hero__cta-{{ ai_gen_id }}"
          {% if section.settings.cta_open_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          {{ section.settings.cta_text | escape }}
        </a>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_product_grid %}
    <div
      class="ai-collab-hero__product-grid-{{ ai_gen_id }}"
      role="region"
      aria-label="{{ section.settings.product_grid_aria_label | default: 'Featured campaign products' | escape }}"
    >
      {% for i in (1..max_grid_items) %}
        {% liquid
          assign image_key = 'product_image_' | append: i
          assign video_key = 'product_video_' | append: i
          assign text_key = 'product_text_' | append: i
          assign text_size_key = 'product_text_size_' | append: i
          assign text_weight_key = 'product_text_weight_' | append: i
          assign text_color_key = 'product_text_color_' | append: i
          assign text_transform_key = 'product_text_transform_' | append: i
          assign text_spacing_key = 'product_text_spacing_' | append: i
          
          assign product_image = section.settings[image_key]
          assign product_video = section.settings[video_key]
          assign product_text = section.settings[text_key]
          assign text_size = section.settings[text_size_key]
          assign text_weight = section.settings[text_weight_key]
          assign text_color = section.settings[text_color_key]
          assign text_transform = section.settings[text_transform_key]
          assign text_spacing = section.settings[text_spacing_key]
          
          assign has_product_video = false
          if i <= 2 and product_video != blank
            assign has_product_video = true
          endif

        %}
        
        <div class="ai-collab-hero__product-item-{{ ai_gen_id }}">
          {% if has_product_video %}
            <video
              autoplay
              muted
              loop
              playsinline
              aria-hidden="true"
            >
              {% for source in product_video.sources %}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {% endfor %}
            </video>
          {% elsif product_image %}
            <img
              src="{{ product_image | image_url: width: 800 }}"
              alt="{{ product_image.alt | default: 'Campaign image' | escape }}"
              loading="lazy"
              decoding="async"
              width="800"
              height="800"
            >
          {% else %}
            <div class="ai-collab-hero__product-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% unless i == 4 and tile4_collab_active %}
          {% if product_text != blank or i == 2 and section.settings.product_subtitle_2 != blank or i == 4 and section.settings.product_subtitle_4 != blank %}
            <div class="ai-collab-hero__product-text-overlay-{{ ai_gen_id }}">
              {% if product_text != blank %}
                <div 
                  class="ai-collab-hero__overlay-text-{{ ai_gen_id }}"
                  style="
                    font-size: {{ text_size }}px;
                    font-weight: {{ text_weight }};
                    color: {{ text_color }};
                    text-transform: {{ text_transform }};
                    letter-spacing: {{ text_spacing }}px;
                  "
                >
                  {{ product_text }}
                </div>
              {% endif %}
              {% if i == 2 and section.settings.product_subtitle_2 != blank %}
                <div
                  class="ai-collab-hero__product-subtitle-{{ ai_gen_id }}"
                  style="color: {{ section.settings.product_subtitle_2_color }}; font-size: {{ section.settings.product_subtitle_2_size }}px;"
                >
                  {{ section.settings.product_subtitle_2 }}
                </div>
              {% elsif i == 4 and section.settings.product_subtitle_4 != blank %}
                <div
                  class="ai-collab-hero__product-subtitle-{{ ai_gen_id }}"
                  style="color: {{ section.settings.product_subtitle_4_color }}; font-size: {{ section.settings.product_subtitle_4_size }}px;"
                >
                  {{ section.settings.product_subtitle_4 }}
                </div>
              {% endif %}
            </div>
          {% endif %}
          {% endunless %}

          {% if i == 4 and tile4_collab_active %}
            <article
              class="br-tile4-collab-overlay-{{ ai_gen_id }}{% if tile4_scrim_on %} br-tile4--readability-{{ ai_gen_id }}{% endif %}{% if tile4_collab_align_c %} br-tile4--align-c-{{ ai_gen_id }}{% else %} br-tile4--align-bl-{{ ai_gen_id }}{% endif %}"
              aria-labelledby="br-tile4-h-{{ ai_gen_id }}"
            >
              <p class="br-tile4-eye-{{ ai_gen_id }}">{{ t4_eye | escape }}</p>
              <h2 id="br-tile4-h-{{ ai_gen_id }}" class="br-tile4-title-{{ ai_gen_id }}">{{ t4_title_plain }}</h2>
              <div class="br-tile4-body-{{ ai_gen_id }}">{{ t4_body_rt }}</div>
              {% if t4_meta != blank %}
                <p class="br-tile4-meta-{{ ai_gen_id }}">{{ t4_meta | escape }}</p>
              {% endif %}
            </article>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {% liquid
    assign br_ld_name = ''
    if section.settings.title != blank
      if section.settings.coperni_overlay_show_hero == false or section.settings.coperni_overlay_hide_centered_hero == false
        assign br_ld_name = section.settings.title | strip_html | strip
      endif
    endif
    if br_ld_name == blank and coperni_hero_active
      assign br_ld_name = co_title_plain
    endif
    if br_ld_name == blank and tile4_collab_active
      assign br_ld_name = t4_title_plain
    endif
    if br_ld_name == blank
      assign br_ld_name = section.settings.section_accessible_name | default: 'Collaboration campaign'
    endif

    assign br_ld_desc = ''
    if coperni_hero_active
      assign br_ld_desc = co_sub_plain
      if co_meta != blank
        if br_ld_desc != blank
          assign br_ld_desc = br_ld_desc | append: ' ' | append: co_meta
        else
          assign br_ld_desc = co_meta
        endif
      endif
    endif
    if br_ld_desc == blank and section.settings.subtitle != blank
      if section.settings.coperni_overlay_show_hero == false or section.settings.coperni_overlay_hide_centered_hero == false
        assign br_ld_desc = section.settings.subtitle | strip_html | strip
      endif
    endif
    if tile4_collab_active and t4_body_plain != blank
      if br_ld_desc != blank
        assign br_ld_desc = br_ld_desc | append: ' ' | append: t4_body_plain
      else
        assign br_ld_desc = t4_body_plain
      endif
    endif
    if tile4_collab_active and t4_meta != blank
      if br_ld_desc != blank
        assign br_ld_desc = br_ld_desc | append: ' ' | append: t4_meta
      else
        assign br_ld_desc = t4_meta
      endif
    endif
  %}
  {% if br_ld_name != blank %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        "name": {{ br_ld_name | json }},
        "description": {{ br_ld_desc | strip | truncate: 500 | json }}
      }
    </script>
  {% endif %}
</section>

<script>
  (function() {
    var elId = {{ html_id | json }};
    var root = document.getElementById(elId);
    if (!root) return;
    root.querySelectorAll('video').forEach(function(video) {
      video.play().catch(function() {
        video.muted = true;
        video.play();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "BR Collaboration hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "section_accessible_name",
      "label": "Section name (accessibility & SEO)",
      "default": "Collaboration campaign",
      "info": "Used when the title is empty (screen readers) and as a fallback for poster image alt text."
    },
    {
      "type": "header",
      "content": "Hero video"
    },
    {
      "type": "video",
      "id": "runway_video_file",
      "label": "Video file"
    },
    {
      "type": "url",
      "id": "runway_video_url",
      "label": "Video URL"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Poster image"
    },
    {
      "type": "paragraph",
      "content": "Poster image displays as fallback when no video is added, or as thumbnail before video loads."
    },
    {
      "type": "range",
      "id": "hero_area_height_vh",
      "label": "Hero height (viewport)",
      "min": 50,
      "max": 130,
      "step": 5,
      "unit": "vh",
      "default": 100,
      "info": "100 = one screen tall. Increase to make the hero taller (e.g. 110–120)."
    },
    {
      "type": "select",
      "id": "hero_video_object_fit",
      "label": "Video & poster fill",
      "options": [
        {
          "value": "cover",
          "label": "Full bleed (cover) — fills frame, may crop edges"
        },
        {
          "value": "contain",
          "label": "Show whole frame (contain) — may show empty bands"
        }
      ],
      "default": "cover",
      "info": "Use Cover to avoid side bars. Black bars baked into the video file may need Zoom below."
    },
    {
      "type": "select",
      "id": "hero_video_object_position",
      "label": "Crop position (when using cover)",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "hero_video_zoom_percent",
      "label": "Zoom (remove edge bars)",
      "min": 100,
      "max": 130,
      "step": 1,
      "unit": "%",
      "default": 100,
      "info": "If black bars are part of the video file, try 105–115% to crop them. Re-exporting the video without letterboxing is the cleanest fix."
    },
    {
      "type": "checkbox",
      "id": "hero_edge_to_edge",
      "label": "Edge-to-edge hero (full browser width)",
      "default": true,
      "info": "Video and hero span the full viewport width. Turn off if your theme already makes sections full width."
    },
    {
      "type": "header",
      "content": "Hero collaboration overlay"
    },
    {
      "type": "paragraph",
      "content": "This block includes gradient sliders (top + bottom darkness), text position, Coperni text sizes in px, copy fields, “Hero video — shop button” (set Button link or the button stays hidden), and meta. Tile 4: same under “Grid tile 4” — gradient sliders + “Tile 4 text sizes.”"
    },
    {
      "type": "checkbox",
      "id": "coperni_overlay_show_hero",
      "label": "Show text on hero video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hero_collab_readability_scrim",
      "label": "Gradient behind hero text (readability)",
