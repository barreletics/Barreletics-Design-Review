    },
    {
      "type": "range",
      "id": "hero_scrim_top_opacity",
      "label": "Hero gradient — top darkness",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 22,
      "info": "0 = transparent at top of overlay. Higher = stronger fade."
    },
    {
      "type": "range",
      "id": "hero_scrim_bottom_opacity",
      "label": "Hero gradient — bottom darkness",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 72,
      "info": "Strength of the dark band behind text at the bottom."
    },
    {
      "type": "select",
      "id": "hero_collab_text_position",
      "label": "Hero collaboration text position",
      "options": [
        {
          "value": "bottom_left",
          "label": "Lower left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "bottom_left"
    },
    {
      "type": "header",
      "content": "Hero collaboration text sizes (px)"
