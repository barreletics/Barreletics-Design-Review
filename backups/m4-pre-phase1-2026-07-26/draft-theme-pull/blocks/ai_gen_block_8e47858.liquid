{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign hide_on_cart = false
  assign hide_on_blog = false
  assign hide_on_article = false
  assign hide_on_policy = false
  assign hide_on_product = false
  assign hide_on_collection = false
  assign hide_on_page = false

  if block.settings.hide_on_cart and template.name == 'cart'
    assign hide_on_cart = true
  endif

  if block.settings.hide_on_blog and template.name == 'blog'
    assign hide_on_blog = true
  endif

  if block.settings.hide_on_article and template.name == 'article'
    assign hide_on_article = true
  endif

  if block.settings.hide_on_policy
    if template.name == 'policy'
      assign hide_on_policy = true
    endif
    if template contains 'policy'
      assign hide_on_policy = true
    endif
    if template.suffix == 'policy'
      assign hide_on_policy = true
    endif
    if page.template_suffix == 'policy'
      assign hide_on_policy = true
    endif
    if request.page_type == 'policy'
      assign hide_on_policy = true
    endif
  endif

  if block.settings.hide_on_product and template.name == 'product'
    assign hide_on_product = true
  endif

  if block.settings.hide_on_collection and template.name == 'collection'
    assign hide_on_collection = true
  endif

  if block.settings.hide_on_page and template.name == 'page'
    assign hide_on_page = true
  endif

  assign should_hide = false
  if hide_on_cart or hide_on_blog or hide_on_article or hide_on_policy or hide_on_product or hide_on_collection or hide_on_page
    assign should_hide = true
  endif
%}

{% unless should_hide %}
  {% style %}
    .ai-media-text-section-{{ ai_gen_id }} {
      background-color: {{ block.settings.section_background }};
      {% if block.settings.section_background_gradient != blank %}
        background-image: {{ block.settings.section_background_gradient }};
      {% endif %}
      padding-top: {{ block.settings.margin_top }}px;
      padding-bottom: {{ block.settings.margin_bottom }}px;
      margin-left: {{ block.settings.margin_sides }}px;
      margin-right: {{ block.settings.margin_sides }}px;
      width: calc(100% - {{ block.settings.margin_sides | times: 2 }}px);
    }

    .ai-media-text-wrapper-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
      padding-left: {{ block.settings.padding_sides }}px;
      padding-right: {{ block.settings.padding_sides }}px;
      {% if block.settings.full_width %}
        max-width: 100%;
      {% else %}
        max-width: {{ block.settings.section_content_width }}px;
        margin: 0 auto;
      {% endif %}
    }

    .ai-media-text-container-{{ ai_gen_id }} {
      display: flex;
      gap: {{ block.settings.gap }}px;
      align-items: stretch;
      {% if block.settings.height == 'fixed' %}
        height: {{ block.settings.fixed_height }}px;
      {% endif %}
      {% if block.settings.desktop_video_placement == 'right' %}
        flex-direction: row-reverse;
      {% else %}
        flex-direction: row;
      {% endif %}
    }

    .ai-media-text-media-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.media_width }}%;
      width: {{ block.settings.media_width }}%;
      min-width: 0;
      {% if block.settings.height == 'fixed' %}
        height: {{ block.settings.fixed_height }}px;
      {% endif %}
    }

    .ai-media-text-content-{{ ai_gen_id }} {
      flex: 0 0 calc({{ 100 | minus: block.settings.media_width }}% - {{ block.settings.gap }}px);
      width: calc({{ 100 | minus: block.settings.media_width }}% - {{ block.settings.gap }}px);
      min-width: 0;
      padding-top: {{ block.settings.content_padding_top }}px;
      padding-bottom: {{ block.settings.content_padding_bottom }}px;
      padding-left: {{ block.settings.padding_horizontal }}px;
      padding-right: {{ block.settings.padding_horizontal }}px;
      display: flex;
      flex-direction: column;
      justify-content: {{ block.settings.vertical_alignment_desktop }};
      text-align: {{ block.settings.horizontal_alignment }};
      align-items: {% if block.settings.horizontal_alignment == 'left' %}flex-start{% elsif block.settings.horizontal_alignment == 'right' %}flex-end{% else %}center{% endif %};
      background-color: {{ block.settings.background }};
      border-radius: {{ block.settings.roundness }}px;
      {% if block.settings.height == 'fixed' %}
        height: {{ block.settings.fixed_height }}px;
      {% endif %}
    }

    .ai-media-text-media-wrapper-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: {{ block.settings.roundness }}px;
      overflow: hidden;
    }

    .ai-media-text-image-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit_desktop }};
      display: block;
    }

    .ai-media-text-video-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.video_fit_desktop }};
      display: block;
    }

    .ai-media-text-video-embed-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .ai-media-text-video-embed-{{ ai_gen_id }} iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .ai-media-text-placeholder-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
      background-color: #f4f4f4;
      display: flex;
      align-items: center;
      justify-content: center;
      {% if block.settings.height != 'fixed' %}
        min-height: 400px;
      {% endif %}
    }

    .ai-media-text-placeholder-{{ ai_gen_id }} svg {
      width: 100%;
      height: 100%;
      max-width: 200px;
      max-height: 200px;
    }

    .ai-media-text-trust-badge-{{ ai_gen_id }} {
      margin-bottom: 16px;
      line-height: {{ block.settings.line_height }}%;
    }

    .ai-media-text-stars-{{ ai_gen_id }} {
      color: {{ block.settings.star_color }};
      font-size: {{ block.settings.trust_font_size }}px;
      {% if block.settings.use_custom_trust_font %}
        font-family: {{ block.settings.trust_font_family.family }}, {{ block.settings.trust_font_family.fallback_families }};
        font-weight: {{ block.settings.trust_font_family.weight }};
        font-style: {{ block.settings.trust_font_family.style }};
      {% endif %}
    }

    .ai-media-text-trust-text-{{ ai_gen_id }} {
      color: {{ block.settings.trust_text_color }};
      font-size: {{ block.settings.trust_font_size }}px;
      {% if block.settings.use_custom_trust_font %}
        font-family: {{ block.settings.trust_font_family.family }}, {{ block.settings.trust_font_family.fallback_families }};
        font-weight: {{ block.settings.trust_font_family.weight }};
        font-style: {{ block.settings.trust_font_family.style }};
      {% endif %}
    }

    .ai-media-text-heading-{{ ai_gen_id }} {
      color: {{ block.settings.heading_color }};
      font-size: {{ block.settings.heading_font_size }}px;
      margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
      line-height: {{ block.settings.heading_line_height }}%;
      {% if block.settings.use_custom_heading_font %}
        font-family: {{ block.settings.heading_font_family.family }}, {{ block.settings.heading_font_family.fallback_families }};
        font-weight: {{ block.settings.heading_font_family.weight }};
        font-style: {{ block.settings.heading_font_family.style }};
      {% endif %}
    }

    .ai-media-text-subheading-{{ ai_gen_id }} {
      color: {{ block.settings.subheading_color }};
      font-size: {{ block.settings.subheading_font_size }}px;
      margin: 0 0 {{ block.settings.subheading_margin_bottom }}px 0;
      line-height: {{ block.settings.subheading_line_height }}%;
      {% if block.settings.use_custom_subheading_font %}
        font-family: {{ block.settings.subheading_font_family.family }}, {{ block.settings.subheading_font_family.fallback_families }};
        font-weight: {{ block.settings.subheading_font_family.weight }};
        font-style: {{ block.settings.subheading_font_family.style }};
      {% endif %}
    }

    .ai-media-text-description-{{ ai_gen_id }} {
      color: {{ block.settings.description_color }};
      font-size: {{ block.settings.description_font_size }}px;
      margin: 0 0 {{ block.settings.description_margin_bottom }}px 0;
      line-height: {{ block.settings.description_line_height }}%;
      {% if block.settings.use_custom_description_font %}
        font-family: {{ block.settings.description_font_family.family }}, {{ block.settings.description_font_family.fallback_families }};
        font-weight: {{ block.settings.description_font_family.weight }};
        font-style: {{ block.settings.description_font_family.style }};
      {% endif %}
    }

    .ai-media-text-button-{{ ai_gen_id }} {
      display: inline-block;
      padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
      background-color: {{ block.settings.button_background }};
      color: {{ block.settings.button_text_color }};
      text-decoration: none;
      border-radius: {{ block.settings.button_roundness }}px;
      font-size: {{ block.settings.button_font_size }}px;
      {% if block.settings.use_custom_button_font %}
        font-family: {{ block.settings.button_font_family.family }}, {{ block.settings.button_font_family.fallback_families }};
        font-weight: {{ block.settings.button_font_family.weight }};
        font-style: {{ block.settings.button_font_family.style }};
      {% endif %}
      line-height: {{ block.settings.button_line_height }}%;
      transition: all 0.3s ease;
      border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
      margin-bottom: {{ block.settings.button_margin_bottom }}px;
      cursor: pointer;
      text-transform: {% if block.settings.button_text_transform %}uppercase{% else %}none{% endif %};
      letter-spacing: {% if block.settings.button_letter_spacing %}{{ block.settings.button_letter_spacing }}px{% else %}normal{% endif %};
    }

    .ai-media-text-button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.button_background_hover }};
      color: {{ block.settings.button_text_hover }};
      border-color: {{ block.settings.button_border_hover }};
      {% if block.settings.use_hover_shadow %}
        box-shadow: 0 4px 12px {{ block.settings.button_shadow }};
      {% endif %}
    }

    .ai-media-text-footer-{{ ai_gen_id }} {
      color: {{ block.settings.footer_text_color }};
      font-size: {{ block.settings.footer_font_size }}px;
      {% if block.settings.use_custom_footer_font %}
        font-family: {{ block.settings.footer_font_family.family }}, {{ block.settings.footer_font_family.fallback_families }};
        font-weight: {{ block.settings.footer_font_family.weight }};
        font-style: {{ block.settings.footer_font_family.style }};
      {% endif %}
      line-height: {{ block.settings.footer_line_height }}%;
      margin-top: 8px;
    }

    @media screen and (max-width: 749px) {
      .ai-media-text-section-{{ ai_gen_id }} {
        margin-left: {{ block.settings.margin_sides_mobile }}px;
        margin-right: {{ block.settings.margin_sides_mobile }}px;
        width: calc(100% - {{ block.settings.margin_sides_mobile | times: 2 }}px);
      }

      .ai-media-text-wrapper-{{ ai_gen_id }} {
        padding-left: {{ block.settings.padding_sides_mobile }}px;
        padding-right: {{ block.settings.padding_sides_mobile }}px;
      }

      .ai-media-text-container-{{ ai_gen_id }} {
        {% if block.settings.mobile_video_placement == 'bottom' %}
          flex-direction: column-reverse;
        {% else %}
          flex-direction: column;
        {% endif %}
        gap: {{ block.settings.gap_mobile }}px;
        height: auto;
      }

      .ai-media-text-media-{{ ai_gen_id }} {
        flex: 0 0 100%;
        width: 100%;
        height: auto;
      }

      .ai-media-text-content-{{ ai_gen_id }} {
        flex: 0 0 100%;
        width: 100%;
        height: auto;
        padding-top: {{ block.settings.content_padding_top_mobile }}px;
        padding-bottom: {{ block.settings.content_padding_bottom_mobile }}px;
        padding-left: {{ block.settings.padding_horizontal_mobile }}px;
        padding-right: {{ block.settings.padding_horizontal_mobile }}px;
        text-align: {{ block.settings.horizontal_alignment_mobile }};
        align-items: {% if block.settings.horizontal_alignment_mobile == 'left' %}flex-start{% elsif block.settings.horizontal_alignment_mobile == 'right' %}flex-end{% else %}center{% endif %};
      }

      .ai-media-text-image-{{ ai_gen_id }} {
        object-fit: {{ block.settings.image_fit_mobile }};
        {% if block.settings.aspect_ratio_mobile == 'square' %}
          aspect-ratio: 1 / 1;
        {% elsif block.settings.aspect_ratio_mobile == 'portrait' %}
          aspect-ratio: 3 / 4;
        {% elsif block.settings.aspect_ratio_mobile == 'landscape' %}
          aspect-ratio: 16 / 9;
        {% elsif block.settings.aspect_ratio_mobile == 'widescreen' %}
          aspect-ratio: 21 / 9;
        {% endif %}
      }

      .ai-media-text-video-{{ ai_gen_id }} {
        object-fit: {{ block.settings.video_fit_mobile }};
        {% if block.settings.aspect_ratio_mobile == 'square' %}
          aspect-ratio: 1 / 1;
        {% elsif block.settings.aspect_ratio_mobile == 'portrait' %}
          aspect-ratio: 3 / 4;
        {% elsif block.settings.aspect_ratio_mobile == 'landscape' %}
          aspect-ratio: 16 / 9;
        {% elsif block.settings.aspect_ratio_mobile == 'widescreen' %}
          aspect-ratio: 21 / 9;
        {% endif %}
      }

      .ai-media-text-video-embed-{{ ai_gen_id }} {
        {% if block.settings.aspect_ratio_mobile == 'square' %}
          padding-bottom: 100%;
          height: 0;
        {% elsif block.settings.aspect_ratio_mobile == 'portrait' %}
          padding-bottom: 133.33%;
          height: 0;
        {% elsif block.settings.aspect_ratio_mobile == 'landscape' %}
          padding-bottom: 56.25%;
          height: 0;
        {% elsif block.settings.aspect_ratio_mobile == 'widescreen' %}
          padding-bottom: 42.86%;
          height: 0;
        {% endif %}
      }

      .ai-media-text-placeholder-{{ ai_gen_id }} {
        {% if block.settings.aspect_ratio_mobile == 'square' %}
          min-height: 300px;
        {% elsif block.settings.aspect_ratio_mobile == 'portrait' %}
          min-height: 400px;
        {% else %}
          min-height: 200px;
        {% endif %}
      }

      .ai-media-text-heading-{{ ai_gen_id }} {
        font-size: {{ block.settings.heading_font_size_mobile }}px;
      }

      .ai-media-text-subheading-{{ ai_gen_id }} {
        font-size: {{ block.settings.subheading_font_size_mobile }}px;
      }

      .ai-media-text-description-{{ ai_gen_id }} {
        font-size: {{ block.settings.description_font_size_mobile }}px;
      }

      .ai-media-text-button-{{ ai_gen_id }} {
        padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
        font-size: {{ block.settings.button_font_size_mobile }}px;
      }

      .ai-media-text-stars-{{ ai_gen_id }} {
        font-size: {{ block.settings.trust_font_size_mobile }}px;
      }

      .ai-media-text-trust-text-{{ ai_gen_id }} {
        font-size: {{ block.settings.trust_font_size_mobile }}px;
      }

      .ai-media-text-footer-{{ ai_gen_id }} {
        font-size: {{ block.settings.footer_font_size_mobile }}px;
      }
    }
  {% endstyle %}

  <div class="ai-media-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-media-text-wrapper-{{ ai_gen_id }}">
      <div class="ai-media-text-container-{{ ai_gen_id }}">
        <div class="ai-media-text-media-{{ ai_gen_id }}">
          <div class="ai-media-text-media-wrapper-{{ ai_gen_id }}">
            {% if block.settings.media_type == 'video' %}
              {% if block.settings.video_shopify %}
                <video
                  class="ai-media-text-video-{{ ai_gen_id }}"
                  {% if block.settings.autoplay %}autoplay{% endif %}
                  {% if block.settings.video_loop %}loop{% endif %}
                  {% if block.settings.video_mute %}muted{% endif %}
                  playsinline
                >
                  <source src="{{ block.settings.video_shopify.sources[1].url }}" type="video/mp4">
                </video>
              {% elsif block.settings.video_url != blank %}
                <div class="ai-media-text-video-embed-{{ ai_gen_id }}">
                  {% if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' %}
                    {% assign video_id = block.settings.video_url | split: 'v=' | last | split: '&' | first %}
                    {% if block.settings.video_url contains 'youtu.be' %}
                      {% assign video_id = block.settings.video_url | split: 'youtu.be/' | last | split: '?' | first %}
                    {% endif %}
                    <iframe
                      src="https://www.youtube.com/embed/{{ video_id }}?autoplay={% if block.settings.autoplay %}1{% else %}0{% endif %}&loop={% if block.settings.video_loop %}1{% else %}0{% endif %}&mute={% if block.settings.video_mute %}1{% else %}0{% endif %}&playlist={{ video_id }}"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                    ></iframe>
                  {% elsif block.settings.video_url contains 'vimeo.com' %}
                    {% assign video_id = block.settings.video_url | split: 'vimeo.com/' | last | split: '?' | first %}
                    <iframe
                      src="https://player.vimeo.com/video/{{ video_id }}?autoplay={% if block.settings.autoplay %}1{% else %}0{% endif %}&loop={% if block.settings.video_loop %}1{% else %}0{% endif %}&muted={% if block.settings.video_mute %}1{% else %}0{% endif %}"
                      allow="autoplay; fullscreen"
                      allowfullscreen
                    ></iframe>
                  {% endif %}
                </div>
              {% else %}
                <div class="ai-media-text-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            {% else %}
              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  class="ai-media-text-image-{{ ai_gen_id }}"
                  {% if block.settings.lazy_load %}loading="lazy"{% endif %}
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% else %}
                <div class="ai-media-text-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            {% endif %}
          </div>
        </div>

        <div class="ai-media-text-content-{{ ai_gen_id }}">
          {% if block.settings.show_trust_badge %}
            <div class="ai-media-text-trust-badge-{{ ai_gen_id }}">
              {% if block.settings.show_stars %}
                <span class="ai-media-text-stars-{{ ai_gen_id }}">★★★★★</span>
              {% endif %}
              {% if block.settings.trust_badge != blank %}
                <span class="ai-media-text-trust-text-{{ ai_gen_id }}"> {{ block.settings.trust_badge }}</span>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.heading != blank %}
            <div class="ai-media-text-heading-{{ ai_gen_id }}">
              {{ block.settings.heading }}
            </div>
          {% endif %}

          {% if block.settings.subheading != blank %}
            <div class="ai-media-text-subheading-{{ ai_gen_id }}">
              {{ block.settings.subheading }}
            </div>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="ai-media-text-description-{{ ai_gen_id }}">
              {{ block.settings.description }}
            </div>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="ai-media-text-button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_label }}
            </a>
          {% endif %}

          {% if block.settings.footer_text != blank %}
            <div class="ai-media-text-footer-{{ ai_gen_id }}">
              {{ block.settings.footer_text }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endunless %}

