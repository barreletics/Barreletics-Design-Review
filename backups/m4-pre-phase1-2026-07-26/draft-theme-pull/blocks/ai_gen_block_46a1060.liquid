{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign collection_handle = block.settings.collection.handle
  if collection_handle == blank
    assign collection_obj = collections.all
  else
    assign collection_obj = collections[collection_handle]
  endif
  
  assign product_limit = block.settings.product_limit
%}

{% style %}
  .ai-upsell-carousel-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: {{ block.settings.section_margin_top }}px auto {{ block.settings.section_margin_bottom }}px;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_bg_color }};
    border-radius: {{ block.settings.section_border_radius }}px;
  }

  .ai-upsell-carousel-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_margin_bottom }}px;
    text-align: center;
  }

  .ai-upsell-carousel-title-{{ ai_gen_id }} {
    {% if block.settings.title_use_custom_font and block.settings.title_font %}
      font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
      font-weight: {{ block.settings.title_font.weight }};
    {% endif %}
    font-size: {{ block.settings.title_size_desktop }}px;
    line-height: {{ block.settings.title_line_height }};
    color: {{ block.settings.title_color }};
    margin: 0;
    {% if block.settings.title_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-upsell-carousel-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
  }

  .ai-upsell-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.slide_gap_desktop }}px;
  }

  .ai-upsell-carousel-slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.slides_per_view_desktop | minus: 1 }} * {{ block.settings.slide_gap_desktop }}px) / {{ block.settings.slides_per_view_desktop }});
    max-width: 400px;
    display: flex;
    flex-direction: column;
  }

  .ai-upsell-carousel-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio_desktop }};
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: {{ block.settings.content_top_margin_desktop }}px;
  }

  .ai-upsell-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-upsell-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
  }

  .ai-upsell-carousel-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.content_alignment_desktop }};
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  {% unless block.settings.show_content_on_all_items %}
    .ai-upsell-carousel-content-{{ ai_gen_id }} {
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .ai-upsell-carousel-slide-{{ ai_gen_id }}.center .ai-upsell-carousel-content-{{ ai_gen_id }} {
      opacity: 1;
      visibility: visible;
    }
  {% endunless %}

  .ai-upsell-carousel-product-title-{{ ai_gen_id }} {
    {% if block.settings.product_title_use_custom_font and block.settings.product_title_font %}
      font-family: {{ block.settings.product_title_font.family }}, {{ block.settings.product_title_font.fallback_families }};
      font-weight: {{ block.settings.product_title_font.weight }};
    {% endif %}
    font-size: {{ block.settings.product_title_size_desktop }}px;
    line-height: {{ block.settings.product_title_line_height }};
    color: {{ block.settings.product_title_color }};
    margin: 0 0 {{ block.settings.button_top_margin }}px;
    {% if block.settings.product_title_uppercase %}
      text-transform: uppercase;
    {% else %}
      text-transform: none;
    {% endif %}
    flex-grow: 1;
  }

  .ai-upsell-carousel-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.arrow_spacing }}px;
  }

  .ai-upsell-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    white-space: nowrap;
    {% if block.settings.button_uppercase %}
      text-transform: uppercase;
    {% else %}
      text-transform: none;
    {% endif %}
    transition: all 0.3s ease;
  }

  .ai-upsell-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-upsell-carousel-arrow-{{ ai_gen_id }} {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    min-width: {{ block.settings.arrow_size }}px;
    min-height: {{ block.settings.arrow_size }}px;
    border-radius: {{ block.settings.arrow_border_radius }}px;
    background-color: {{ block.settings.arrow_bg_color }};
    border: {{ block.settings.arrow_border_width }}px solid {{ block.settings.arrow_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
    padding: 0;
  }

  .ai-upsell-carousel-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg_color }};
    border-color: {{ block.settings.arrow_hover_border_color }};
  }

  .ai-upsell-carousel-arrow-{{ ai_gen_id }} svg {
    width: {{ block.settings.arrow_icon_size }}px;
    height: {{ block.settings.arrow_icon_size }}px;
    flex-shrink: 0;
    stroke: {{ block.settings.arrow_color }};
  }

  .ai-upsell-carousel-arrow-{{ ai_gen_id }}:hover svg {
    stroke: {{ block.settings.arrow_hover_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-upsell-carousel-{{ ai_gen_id }} {
      margin: {{ block.settings.section_margin_top_mobile }}px auto {{ block.settings.section_margin_bottom_mobile }}px;
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-upsell-carousel-header-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.section_padding_horizontal_mobile }}px;
    }

    .ai-upsell-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-upsell-carousel-wrapper-{{ ai_gen_id }} {
      padding: 0 calc((100% - {{ block.settings.mobile_slide_width }}%) / 2);
    }

    .ai-upsell-carousel-track-{{ ai_gen_id }} {
      gap: {{ block.settings.slide_gap_mobile }}px;
    }

    .ai-upsell-carousel-slide-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_slide_width }}%;
      max-width: 350px;
    }

    .ai-upsell-carousel-image-wrapper-{{ ai_gen_id }} {
      aspect-ratio: {{ block.settings.image_aspect_ratio_mobile }};
      margin-bottom: {{ block.settings.content_top_margin_mobile }}px;
    }

    .ai-upsell-carousel-content-{{ ai_gen_id }} {
      text-align: center;
      align-items: center;
    }

    .ai-upsell-carousel-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size_mobile }}px;
      text-align: center;
    }

    .ai-upsell-carousel-button-wrapper-{{ ai_gen_id }} {
      gap: {{ block.settings.arrow_spacing_mobile }}px;
      justify-content: center;
    }

    {% unless block.settings.show_arrows_mobile %}
      .ai-upsell-carousel-arrow-{{ ai_gen_id }} {
        display: none;
      }
    {% endunless %}
  }

  @media screen and (min-width: 769px) {
    {% unless block.settings.show_arrows_desktop %}
      .ai-upsell-carousel-arrow-{{ ai_gen_id }} {
        display: none;
      }
    {% endunless %}
  }
{% endstyle %}

<upsell-carousel-{{ ai_gen_id }} class="ai-upsell-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }} data-show-all="{{ block.settings.show_content_on_all_items }}">
  <div class="ai-upsell-carousel-header-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-upsell-carousel-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="ai-upsell-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-upsell-carousel-track-{{ ai_gen_id }}">
      {% for product in collection_obj.products limit: product_limit %}
        <div class="ai-upsell-carousel-slide-{{ ai_gen_id }}">
          <div class="ai-upsell-carousel-image-wrapper-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="ai-upsell-carousel-image-{{ ai_gen_id }}"
                loading="lazy"
                width="800"
                height="800"
              >
            {% else %}
              <div class="ai-upsell-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-upsell-carousel-content-{{ ai_gen_id }}">
            <h3 class="ai-upsell-carousel-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
            
            {% if block.settings.show_button %}
              <div class="ai-upsell-carousel-button-wrapper-{{ ai_gen_id }}">
                <button type="button" class="ai-upsell-carousel-arrow-{{ ai_gen_id }} ai-prev" aria-label="Previous">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M15 18l-6-6 6-6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

                <a href="{{ product.url }}" class="ai-upsell-carousel-button-{{ ai_gen_id }}">
                  {{ block.settings.button_text }}
                </a>

                <button type="button" class="ai-upsell-carousel-arrow-{{ ai_gen_id }} ai-next" aria-label="Next">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 18l6-6-6-6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</upsell-carousel-{{ ai_gen_id }}>

<script>
(function() {
  if (customElements.get('upsell-carousel-{{ ai_gen_id }}')) return;
  
  class UpsellCarousel{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentIndex = 0;
      this.autoplayInterval = null;
    }

    connectedCallback() {
      this.track = this.querySelector('.ai-upsell-carousel-track-{{ ai_gen_id }}');
      this.slides = Array.from(this.querySelectorAll('.ai-upsell-carousel-slide-{{ ai_gen_id }}'));
      
      if (this.slides.length === 0) return;

      this.isMobile = window.innerWidth <= 768;
      this.slidesPerView = this.isMobile ? ({{ block.settings.mobile_slide_width }} / 100) : {{ block.settings.slides_per_view_desktop }};
      this.autoplay = {{ block.settings.autoplay }};
      this.autoplayDelay = {{ block.settings.autoplay_delay | times: 1000 }};
      this.speed = {{ block.settings.scroll_speed | times: 1000 }};
      this.showContentOnAllItems = this.dataset.showAll === 'true';

      this.duplicateSlides();
      this.setupControls();
      this.centerInitial();
      
      if (this.autoplay) {
        this.startAutoplay();
      }

      this.addEventListener('mouseenter', () => this.stopAutoplay());
      this.addEventListener('mouseleave', () => {
        if (this.autoplay) this.startAutoplay();
      });
    }

    duplicateSlides() {
      const slidesToClone = this.slides.length * 3;
      
      for (let i = 0; i < slidesToClone; i++) {
        const clone = this.slides[i % this.slides.length].cloneNode(true);
        this.track.appendChild(clone);
      }
      
      for (let i = 0; i < slidesToClone; i++) {
        const clone = this.slides[this.slides.length - 1 - (i % this.slides.length)].cloneNode(true);
        this.track.insertBefore(clone, this.track.firstChild);
      }
      
      this.allSlides = Array.from(this.track.children);
      this.currentIndex = slidesToClone;
    }

    setupControls() {
      const prevBtns = this.querySelectorAll('.ai-prev');
      const nextBtns = this.querySelectorAll('.ai-next');
      
      prevBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.prev();
        });
      });
      
      nextBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.next();
        });
      });
    }

    centerInitial() {
      const centerOffset = (this.slidesPerView - 1) / 2;
      this.currentIndex = this.currentIndex - centerOffset;
      this.updatePosition(false);
      this.updateCenter();
    }

    prev() {
      this.stopAutoplay();
      this.currentIndex--;
      this.updatePosition(true);
      if (this.autoplay) this.startAutoplay();
    }

    next() {
      this.stopAutoplay();
      this.currentIndex++;
      this.updatePosition(true);
      if (this.autoplay) this.startAutoplay();
    }

    updatePosition(animate = true) {
      const slideWidth = this.slides[0].offsetWidth;
      const gap = parseInt(getComputedStyle(this.track).gap) || 0;
      const offset = -(this.currentIndex * (slideWidth + gap));
      
      this.track.style.transition = animate ? `transform ${this.speed}ms ease-out` : 'none';
      this.track.style.transform = `translateX(${offset}px)`;
      
      if (animate) {
        setTimeout(() => {
          this.checkLoop();
          this.updateCenter();
        }, this.speed);
      }
    }

    checkLoop() {
      const slidesToClone = this.slides.length * 3;
      
      if (this.currentIndex >= this.slides.length + slidesToClone) {
        this.currentIndex = slidesToClone;
        this.updatePosition(false);
      } else if (this.currentIndex < slidesToClone) {
        this.currentIndex = this.slides.length + slidesToClone - 1;
        this.updatePosition(false);
      }
    }

    updateCenter() {
      if (this.showContentOnAllItems) return;
      
      const centerOffset = (this.slidesPerView - 1) / 2;
      const centerIndex = Math.round(this.currentIndex + centerOffset);
      
      this.allSlides.forEach((slide, index) => {
        slide.classList.toggle('center', index === centerIndex);
      });
    }

    startAutoplay() {
      this.stopAutoplay();
      this.autoplayInterval = setInterval(() => this.next(), this.autoplayDelay);
    }

    stopAutoplay() {
      if (this.autoplayInterval) {
        clearInterval(this.autoplayInterval);
        this.autoplayInterval = null;
      }
    }

    disconnectedCallback() {
      this.stopAutoplay();
    }
  }

  customElements.define('upsell-carousel-{{ ai_gen_id }}', UpsellCarousel{{ ai_gen_id }});
})();
</script>

