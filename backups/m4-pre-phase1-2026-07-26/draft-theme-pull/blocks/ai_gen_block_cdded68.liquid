{% style %}
  .ai-image-grid-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.section_bg_color }};
  }

  .ai-image-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.boxes_per_row }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-image-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    background-color: {{ block.settings.box_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
  }

  {% if block.settings.featured_box_enabled %}
    .ai-image-grid__item-{{ ai_gen_id }}:nth-child({{ block.settings.featured_box_position }}) {
      grid-column: span {{ block.settings.featured_box_width }};
      grid-row: span {{ block.settings.featured_box_height }};
    }
  {% endif %}

  .ai-image-grid__item-{{ ai_gen_id }}.ai-incomplete-row-{{ ai_gen_id }} {
    display: none;
  }

  .ai-image-grid__media-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-image-grid__image-{{ ai_gen_id }},
  .ai-image-grid__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    {% if block.settings.media_fit == 'fill' %}
      object-fit: cover;
      transform: scale(1.2);
    {% else %}
      object-fit: {{ block.settings.media_fit }};
    {% endif %}
    object-position: {{ block.settings.media_position }};
  }

  .ai-image-grid__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: 30px;
    text-align: center;
    width: 100%;
  }

  .ai-image-grid__title-{{ ai_gen_id }} {
    font-family: 'Roboto', sans-serif;
    font-weight: {{ block.settings.title_font_weight }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .ai-image-grid__subtitle-{{ ai_gen_id }} {
    font-family: 'Roboto', sans-serif;
    font-weight: {{ block.settings.subtitle_font_weight }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .ai-image-grid__description-{{ ai_gen_id }} {
    font-family: 'Roboto', sans-serif;
    font-weight: {{ block.settings.description_font_weight }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 20px;
    line-height: 1.5;
  }

  .ai-image-grid__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 30px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: 'Roboto', sans-serif;
    font-weight: {{ block.settings.button_font_weight }};
    font-size: {{ block.settings.button_size }}px;
    transition: all 0.3s ease;
  }

  .ai-image-grid__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="white"] .ai-image-grid__title-{{ ai_gen_id }},
  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="white"] .ai-image-grid__subtitle-{{ ai_gen_id }},
  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="white"] .ai-image-grid__description-{{ ai_gen_id }} {
    color: #ffffff;
  }

  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="black"] .ai-image-grid__title-{{ ai_gen_id }},
  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="black"] .ai-image-grid__subtitle-{{ ai_gen_id }},
  .ai-image-grid__item-{{ ai_gen_id }}[data-text-color="black"] .ai-image-grid__description-{{ ai_gen_id }} {
    color: #000000;
  }

  .ai-image-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-image-grid__placeholder-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-image-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px;
      background-color: {{ block.settings.section_bg_color_mobile }};
    }

    .ai-image-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-image-grid__item-{{ ai_gen_id }} {
      background-color: {{ block.settings.box_bg_color_mobile }};
    }

    {% if block.settings.featured_box_enabled %}
      .ai-image-grid__item-{{ ai_gen_id }}:nth-child({{ block.settings.featured_box_position }}) {
        grid-column: span 2;
        min-height: {{ block.settings.featured_box_height_mobile }}px;
      }
    {% endif %}

    .ai-image-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-image-grid__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.8);
    }

    .ai-image-grid__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.8);
    }

    .ai-image-grid__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_size_mobile }}px;
      padding: {{ block.settings.button_padding_mobile }}px {{ block.settings.button_padding_mobile | times: 2 }}px;
    }

    .ai-image-grid__image-{{ ai_gen_id }},
    .ai-image-grid__video-{{ ai_gen_id }} {
      object-fit: {{ block.settings.media_fit_mobile }};
      {% if block.settings.media_fit_mobile == 'fill' %}
        transform: scale(1.2);
      {% else %}
        transform: none;
      {% endif %}
    }

    
    @media screen and (max-width: 749px) {
      {% if block.settings.stack_mobile %}
        .ai-image-grid__container-{{ ai_gen_id }} {
          grid-template-columns: 1fr !important;
        }
        .ai-image-grid__item-{{ ai_gen_id }}:nth-child({{ block.settings.featured_box_position }}) {
          grid-column: span 1 !important;
        }
      {% endif %}

      {% if block.settings.hide_on_mobile %}
        .ai-image-grid-{{ ai_gen_id }} {
          display: none !important;
        }
      {% endif %}

   {% if block.settings.center_text_mobile %}
  .ai-image-grid__content-{{ ai_gen_id }} {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  .ai-image-grid__content-{{ ai_gen_id }},
  .ai-image-grid__title-{{ ai_gen_id }},
  .ai-image-grid__subtitle-{{ ai_gen_id }},
  .ai-image-grid__description-{{ ai_gen_id }} {
    text-align: center !important;
  }
{% endif %}


    }
{% endstyle %}

{% liquid


  assign enabled_count = 0
  for i in (1..16)
    assign item_enabled_key = 'item_' | append: i | append: '_enabled'
    assign item_enabled = block.settings[item_enabled_key]
    if item_enabled
      assign enabled_count = enabled_count | plus: 1
    endif
  endfor

  assign boxes_per_row = block.settings.boxes_per_row
  assign remainder = enabled_count | modulo: boxes_per_row
  assign incomplete_row_start = enabled_count | minus: remainder | plus: 1
  assign hide_incomplete = block.settings.hide_incomplete_rows
%}

{% if should_display %}
  <div class="ai-image-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-image-grid__container-{{ ai_gen_id }}">
      {% assign current_box = 0 %}
      {% for i in (1..16) %}
        {% liquid
          assign item_enabled_key = 'item_' | append: i | append: '_enabled'
          assign item_enabled = block.settings[item_enabled_key]
        %}

        {% if item_enabled %}
          {% assign current_box = current_box | plus: 1 %}
          {% liquid
            assign media_type_key = 'item_' | append: i | append: '_media_type'
            assign image_key = 'item_' | append: i | append: '_image'
            assign video_key = 'item_' | append: i | append: '_video'
            assign title_key = 'item_' | append: i | append: '_title'
            assign title_caps_key = 'item_' | append: i | append: '_title_caps'

            assign subtitle_key = 'item_' | append: i | append: '_subtitle'
            assign description_key = 'item_' | append: i | append: '_description'
            assign button_text_key = 'item_' | append: i | append: '_button_text'
            assign button_link_key = 'item_' | append: i | append: '_button_link'
            assign text_color_key = 'item_' | append: i | append: '_text_color'

            assign media_type = block.settings[media_type_key]
            assign image = block.settings[image_key]
            assign video = block.settings[video_key]
            assign title = block.settings[title_key]
            assign subtitle = block.settings[subtitle_key]
            assign description = block.settings[description_key]
            assign button_text = block.settings[button_text_key]
            assign button_link = block.settings[button_link_key]
            assign text_color = block.settings[text_color_key]

            assign is_incomplete = false
            if hide_incomplete and remainder > 0 and current_box >= incomplete_row_start
              assign is_incomplete = true
            endif
          %}

          <div
            class="ai-image-grid__item-{{ ai_gen_id }} {% if is_incomplete %}ai-incomplete-row-{{ ai_gen_id }}{% endif %}"
            data-text-color="{{ text_color }}"
          >
            <div class="ai-image-grid__media-wrapper-{{ ai_gen_id }}">
              {% if media_type == 'image' %}
                {% if image %}
                  <img
                    src="{{ image | image_url: width: 1200 }}"
                    alt="{{ image.alt | escape }}"
                    class="ai-image-grid__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                  >
                {% else %}
                  <div class="ai-image-grid__placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              {% elsif media_type == 'video' %}
                {% if video %}
                  <video
                    class="ai-image-grid__video-{{ ai_gen_id }}"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="auto"
                  >
                    <source src="{{ video.sources[0].url }}" type="{{ video.sources[0].mime_type }}">
                  </video>
                {% else %}
                  <div class="ai-image-grid__placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              {% endif %}
            </div>

            <div class="ai-image-grid__content-{{ ai_gen_id }}">
              {% if title != blank %}
               {% assign title_caps_setting = block.settings[title_caps_key] %}
<h3 class="ai-image-grid__title-{{ ai_gen_id }}" style="text-transform: none !important;">{{ title }}</h3>
              {% endif %}

              {% if subtitle != blank %}
                <p class="ai-image-grid__subtitle-{{ ai_gen_id }}">{{ subtitle }}</p>
              {% endif %}

              {% if description != blank %}
                <p class="ai-image-grid__description-{{ ai_gen_id }}">{{ description }}</p>
              {% endif %}

              {% if button_text != blank and button_link != blank %}
                <a href="{{ button_link }}" class="ai-image-grid__button-{{ ai_gen_id }}">
                  {{ button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}
 <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var videos = document.querySelectorAll('video');
    videos.forEach(function(video) {
      var source = video.querySelector('source');
      if (source && source.type === 'application/x-mpegURL') {
        if (Hls.isSupported()) {
          var hls = new Hls();
          hls.loadSource(source.src);
          hls.attachMedia(video);
        }
      }
    });
  });
</script>


