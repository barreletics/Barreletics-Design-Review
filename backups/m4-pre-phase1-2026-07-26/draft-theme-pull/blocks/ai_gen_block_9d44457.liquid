      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Content width",
      "default": 700
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "roboto_n4"
    },
    {
      "type": "font_picker",
      "id": "message_font",
      "label": "Message font",
      "default": "roboto_n3"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Heading size",
      "default": 60
    },
    {
      "type": "range",
      "id": "message_size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Message size",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_shadow",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Text shadow",
      "default": 30
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Button border radius",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Closing banner"
    }
  ]
}
{% endschema %}
