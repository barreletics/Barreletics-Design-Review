{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sole-comparison-{{ ai_gen_id }} {
    padding: {{ block.settings.space_above }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.space_below }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-sole-comparison__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-sole-comparison__heading-{{ ai_gen_id }},
  .ai-sole-comparison__heading-{{ ai_gen_id }} h1,
  .ai-sole-comparison__heading-{{ ai_gen_id }} h2,
  .ai-sole-comparison__heading-{{ ai_gen_id }} h3,
  .ai-sole-comparison__heading-{{ ai_gen_id }} h4,
  .ai-sole-comparison__heading-{{ ai_gen_id }} h5,
  .ai-sole-comparison__heading-{{ ai_gen_id }} h6,
  .ai-sole-comparison__heading-{{ ai_gen_id }} p {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }} !important;
    font-weight: {{ block.settings.heading_font.weight }} !important;
    text-align: {{ block.settings.text_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_font_size }}px !important;
  }

  .ai-sole-comparison__subtitle-{{ ai_gen_id }},
  .ai-sole-comparison__subtitle-{{ ai_gen_id }} h1,
  .ai-sole-comparison__subtitle-{{ ai_gen_id }} h2,
  .ai-sole-comparison__subtitle-{{ ai_gen_id }} h3,
  .ai-sole-comparison__subtitle-{{ ai_gen_id }} h4,
  .ai-sole-comparison__subtitle-{{ ai_gen_id }} h5,
  .ai-sole-comparison__subtitle-{{ ai_gen_id }} h6,
  .ai-sole-comparison__subtitle-{{ ai_gen_id }} p {
    font-family: {{ block.settings.subtitle_font.family }}, {{ block.settings.subtitle_font.fallback_families }} !important;
    font-weight: {{ block.settings.subtitle_font.weight }} !important;
    text-align: {{ block.settings.text_alignment }};
    margin: 0 0 {{ block.settings.subtitle_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtitle_font_size }}px !important;
  }

  .ai-sole-comparison__global-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    text-align: {{ block.settings.text_alignment }};
    margin: 0 0 {{ block.settings.global_description_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.global_description_font_size }}px;
  }

  .ai-sole-comparison__global-description-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-sole-comparison__global-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-sole-comparison__images-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-sole-comparison__image-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-sole-comparison__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.image_scale }}%;
    margin-left: auto;
    margin-right: auto;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: {{ block.settings.space_between_image_and_text }}px;
  }

  .ai-sole-comparison__image-inner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.image_aspect_ratio == 'square' %}
      aspect-ratio: 1 / 1;
    {% elsif block.settings.image_aspect_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
    {% elsif block.settings.image_aspect_ratio == 'landscape' %}
      aspect-ratio: 4 / 3;
    {% endif %}
  }

  .ai-sole-comparison__image-inner-{{ ai_gen_id }} img,
  .ai-sole-comparison__image-inner-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    display: block;
    {% if block.settings.image_aspect_ratio != 'natural' %}
      object-fit: cover;
    {% else %}
      object-fit: contain;
    {% endif %}
  }

  .ai-sole-comparison__image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-sole-comparison__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-sole-comparison__image-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ block.settings.overlay_vertical_position }};
    justify-content: {{ block.settings.overlay_horizontal_position }};
    padding: {{ block.settings.overlay_padding }}px;
    pointer-events: none;
  }

  .ai-sole-comparison__image-overlay-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_bg_color }};
    opacity: {{ block.settings.overlay_bg_opacity | divided_by: 100.0 }};
  }

  .ai-sole-comparison__overlay-text-{{ ai_gen_id }} {
    position: relative;
    font-family: {{ block.settings.overlay_font.family }}, {{ block.settings.overlay_font.fallback_families }};
    font-weight: {{ block.settings.overlay_font.weight }};
    font-size: {{ block.settings.overlay_font_size }}px;
    color: {{ block.settings.overlay_text_color }};
    text-align: {{ block.settings.overlay_text_alignment }};
    text-shadow: {{ block.settings.overlay_text_shadow }}px {{ block.settings.overlay_text_shadow }}px {{ block.settings.overlay_text_shadow | times: 2 }}px rgba(0, 0, 0, {{ block.settings.overlay_text_shadow_opacity | divided_by: 100.0 }});
    max-width: {{ block.settings.overlay_text_max_width }}%;
  }

  .ai-sole-comparison__image-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.image_title_font.family }}, {{ block.settings.image_title_font.fallback_families }} !important;
    font-weight: {{ block.settings.image_title_font.weight }} !important;
    font-size: {{ block.settings.image_title_font_size }}px !important;
    color: {{ block.settings.text_color }} !important;
    text-align: {{ block.settings.content_alignment }};
    margin: 0 0 {{ block.settings.image_section_spacing }}px !important;
    line-height: 1.3;
  }

  .ai-sole-comparison__columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-sole-comparison__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-sole-comparison__description-wrapper-{{ ai_gen_id }} {
    padding: {{ block.settings.description_padding_top }}px {{ block.settings.description_padding_horizontal }}px {{ block.settings.description_padding_bottom }}px;
    background-color: {{ block.settings.description_bg_color }};
    border-radius: {{ block.settings.description_border_radius }}px;
    border: {{ block.settings.description_border_width }}px solid {{ block.settings.description_border_color }};
    margin-bottom: {{ block.settings.description_spacing }}px;
    flex-grow: 1;
  }

  .ai-sole-comparison__description-{{ ai_gen_id }} {
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    text-align: {{ block.settings.content_alignment }};
    margin: 0 auto;
    max-width: {{ block.settings.description_text_width }}%;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_font_size }}px;
  }

  .ai-sole-comparison__description-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-sole-comparison__description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-sole-comparison__description-{{ ai_gen_id }} strong,
  .ai-sole-comparison__description-{{ ai_gen_id }} b {
    font-weight: bold;
  }

  .ai-sole-comparison__description-{{ ai_gen_id }} em,
  .ai-sole-comparison__description-{{ ai_gen_id }} i {
    font-style: italic;
  }

  .ai-sole-comparison__description-{{ ai_gen_id }} ul,
  .ai-sole-comparison__description-{{ ai_gen_id }} ol {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
    padding-left: 20px;
  }

  .ai-sole-comparison__description-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-sole-comparison__description-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-sole-comparison__description-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-sole-comparison__button-wrapper-{{ ai_gen_id }} {
    display: flex;
    {% if block.settings.content_alignment == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.content_alignment == 'center' %}
      justify-content: center;
    {% else %}
      justify-content: flex-end;
    {% endif %}
    margin-top: auto;
  }

  .ai-sole-comparison__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    width: {{ block.settings.button_width }}%;
    text-align: center;
    {% if block.settings.button_uppercase %}
      text-transform: uppercase;
    {% endif %}
    {% if block.settings.button_style == 'solid' %}
      background-color: {{ block.settings.button_bg_color }};
      color: {{ block.settings.button_text_color }};
      border: 2px solid {{ block.settings.button_bg_color }};
    {% else %}
      background-color: transparent;
      color: {{ block.settings.button_bg_color }};
      border: 2px solid {{ block.settings.button_bg_color }};
    {% endif %}
  }

  .ai-sole-comparison__button-{{ ai_gen_id }}:hover {
    {% if block.settings.button_style == 'solid' %}
      background-color: {{ block.settings.button_hover_bg_color }};
      color: {{ block.settings.button_hover_text_color }};
      border-color: {{ block.settings.button_hover_bg_color }};
    {% else %}
      background-color: {{ block.settings.button_bg_color }};
      color: {{ block.settings.button_text_color }};
      border-color: {{ block.settings.button_bg_color }};
    {% endif %}
  }

  @media screen and (max-width: 768px) {
    .ai-sole-comparison-{{ ai_gen_id }} {
      padding: {{ block.settings.space_above | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.space_below | times: 0.7 }}px;
    }

    .ai-sole-comparison__heading-{{ ai_gen_id }},
    .ai-sole-comparison__heading-{{ ai_gen_id }} h1,
    .ai-sole-comparison__heading-{{ ai_gen_id }} h2,
    .ai-sole-comparison__heading-{{ ai_gen_id }} h3,
    .ai-sole-comparison__heading-{{ ai_gen_id }} h4,
    .ai-sole-comparison__heading-{{ ai_gen_id }} h5,
    .ai-sole-comparison__heading-{{ ai_gen_id }} h6,
    .ai-sole-comparison__heading-{{ ai_gen_id }} p {
      font-size: {{ block.settings.mobile_heading_font_size }}px !important;
    }

    .ai-sole-comparison__subtitle-{{ ai_gen_id }},
    .ai-sole-comparison__subtitle-{{ ai_gen_id }} h1,
    .ai-sole-comparison__subtitle-{{ ai_gen_id }} h2,
    .ai-sole-comparison__subtitle-{{ ai_gen_id }} h3,
    .ai-sole-comparison__subtitle-{{ ai_gen_id }} h4,
    .ai-sole-comparison__subtitle-{{ ai_gen_id }} h5,
    .ai-sole-comparison__subtitle-{{ ai_gen_id }} h6,
    .ai-sole-comparison__subtitle-{{ ai_gen_id }} p {
      font-size: {{ block.settings.mobile_subtitle_font_size }}px !important;
    }

    .ai-sole-comparison__global-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_global_description_font_size }}px;
    }

    .ai-sole-comparison__images-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
    }

    .ai-sole-comparison__image-column-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.mobile_image_section_spacing }}px;
    }

    .ai-sole-comparison__image-column-{{ ai_gen_id }}:last-child {
      margin-bottom: 0;
    }

    .ai-sole-comparison__image-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-sole-comparison__overlay-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_overlay_font_size }}px;
      max-width: 100%;
    }

    .ai-sole-comparison__image-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_image_title_font_size }}px !important;
      margin-bottom: {{ block.settings.mobile_image_title_spacing }}px !important;
    }

    .ai-sole-comparison__columns-{{ ai_gen_id }} {
      display: none;
    }

    .ai-sole-comparison__description-{{ ai_gen_id }} {
      max-width: 100%;
      font-size: {{ block.settings.mobile_description_font_size }}px;
    }

    .ai-sole-comparison__description-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.description_padding_top | times: 0.8 }}px {{ block.settings.description_padding_horizontal | times: 0.8 }}px {{ block.settings.description_padding_bottom | times: 0.8 }}px;
    }

    .ai-sole-comparison__button-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-sole-comparison__mobile-content-{{ ai_gen_id }} {
      display: block;
    }
  }

  @media screen and (min-width: 769px) {
    .ai-sole-comparison__mobile-content-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-sole-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-sole-comparison__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-sole-comparison__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </div>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <div class="ai-sole-comparison__subtitle-{{ ai_gen_id }}">
        {{ block.settings.subtitle }}
      </div>
    {% endif %}

    {% if block.settings.global_description != blank %}
      <div class="ai-sole-comparison__global-description-{{ ai_gen_id }}">
        {{ block.settings.global_description }}
      </div>
    {% endif %}

    <div class="ai-sole-comparison__images-{{ ai_gen_id }}">
      <div class="ai-sole-comparison__image-column-{{ ai_gen_id }}">
        <div class="ai-sole-comparison__image-wrapper-{{ ai_gen_id }}">
          <div class="ai-sole-comparison__image-inner-{{ ai_gen_id }}">
            {% if block.settings.left_media_type == 'video' and block.settings.left_video != blank %}
              {{
                block.settings.left_video
                | video_tag:
                  image_size: '1024x',
                  autoplay: block.settings.left_video_autoplay,
                  loop: block.settings.left_video_loop,
                  muted: block.settings.left_video_muted,
                  controls: block.settings.left_video_controls
              }}
            {% elsif block.settings.left_image != blank %}
              <img
                src="{{ block.settings.left_image | image_url: width: 1200 }}"
                alt="{{ block.settings.left_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.left_image.width }}"
                height="{{ block.settings.left_image.height }}"
              >
            {% else %}
              <div class="ai-sole-comparison__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if block.settings.left_overlay_text != blank %}
              <div class="ai-sole-comparison__image-overlay-{{ ai_gen_id }}">
                <div class="ai-sole-comparison__overlay-text-{{ ai_gen_id }}">
                  {{ block.settings.left_overlay_text }}
                </div>
              </div>
            {% endif %}
          </div>
        </div>
        {% if block.settings.left_image_title != blank %}
          <h3 class="ai-sole-comparison__image-title-{{ ai_gen_id }}">
            {{ block.settings.left_image_title }}
          </h3>
        {% endif %}

        <div class="ai-sole-comparison__mobile-content-{{ ai_gen_id }}">
          {% if block.settings.left_description != blank %}
            <div class="ai-sole-comparison__description-wrapper-{{ ai_gen_id }}">
              <div class="ai-sole-comparison__description-{{ ai_gen_id }}">
                {{ block.settings.left_description }}
              </div>
            </div>
          {% endif %}

          {% if block.settings.left_button_text != blank %}
            <div class="ai-sole-comparison__button-wrapper-{{ ai_gen_id }}">
              <a
                href="{{ block.settings.left_button_link }}"
                class="ai-sole-comparison__button-{{ ai_gen_id }}"
              >
                {{ block.settings.left_button_text }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-sole-comparison__image-column-{{ ai_gen_id }}">
        <div class="ai-sole-comparison__image-wrapper-{{ ai_gen_id }}">
          <div class="ai-sole-comparison__image-inner-{{ ai_gen_id }}">
            {% if block.settings.right_media_type == 'video' and block.settings.right_video != blank %}
              {{
                block.settings.right_video
                | video_tag:
                  image_size: '1024x',
                  autoplay: block.settings.right_video_autoplay,
                  loop: block.settings.right_video_loop,
                  muted: block.settings.right_video_muted,
                  controls: block.settings.right_video_controls
              }}
            {% elsif block.settings.right_image != blank %}
              <img
                src="{{ block.settings.right_image | image_url: width: 1200 }}"
                alt="{{ block.settings.right_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.right_image.width }}"
                height="{{ block.settings.right_image.height }}"
              >
            {% else %}
              <div class="ai-sole-comparison__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if block.settings.right_overlay_text != blank %}
              <div class="ai-sole-comparison__image-overlay-{{ ai_gen_id }}">
                <div class="ai-sole-comparison__overlay-text-{{ ai_gen_id }}">
                  {{ block.settings.right_overlay_text }}
                </div>
              </div>
            {% endif %}
          </div>
        </div>
        {% if block.settings.right_image_title != blank %}
          <h3 class="ai-sole-comparison__image-title-{{ ai_gen_id }}">
            {{ block.settings.right_image_title }}
          </h3>
        {% endif %}

        <div class="ai-sole-comparison__mobile-content-{{ ai_gen_id }}">
          {% if block.settings.right_description != blank %}
            <div class="ai-sole-comparison__description-wrapper-{{ ai_gen_id }}">
              <div class="ai-sole-comparison__description-{{ ai_gen_id }}">
                {{ block.settings.right_description }}
              </div>
            </div>
          {% endif %}

          {% if block.settings.right_button_text != blank %}
            <div class="ai-sole-comparison__button-wrapper-{{ ai_gen_id }}">
              <a
                href="{{ block.settings.right_button_link }}"
                class="ai-sole-comparison__button-{{ ai_gen_id }}"
              >
                {{ block.settings.right_button_text }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ai-sole-comparison__columns-{{ ai_gen_id }}">
      <div class="ai-sole-comparison__column-{{ ai_gen_id }}">
        {% if block.settings.left_description != blank %}
          <div class="ai-sole-comparison__description-wrapper-{{ ai_gen_id }}">
            <div class="ai-sole-comparison__description-{{ ai_gen_id }}">
              {{ block.settings.left_description }}
            </div>
          </div>
        {% endif %}

        {% if block.settings.left_button_text != blank %}
          <div class="ai-sole-comparison__button-wrapper-{{ ai_gen_id }}">
            <a
              href="{{ block.settings.left_button_link }}"
