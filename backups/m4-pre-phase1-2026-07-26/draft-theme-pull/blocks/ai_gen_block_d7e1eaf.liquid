{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.desktop_height }}px;
    display: flex;
    align-items: {{ block.settings.content_vertical_alignment }};
    justify-content: {{ block.settings.content_horizontal_alignment }};
    overflow: hidden;
    padding: {{ block.settings.text_box_margin }}px;
    {% if block.settings.enable_letterbox %}
      background-color: {{ block.settings.letterbox_color }};
    {% endif %}
  }

  .ai-hero__media-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    {% if block.settings.enable_letterbox %}
      display: flex;
      align-items: center;
      justify-content: center;
    {% endif %}
  }

  .ai-hero__image-{{ ai_gen_id }} {
    {% if block.settings.enable_letterbox %}
      width: auto;
      height: auto;
      max-width: {{ block.settings.letterbox_width }}%;
      max-height: 100%;
      object-fit: contain;
    {% else %}
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ block.settings.image_position_desktop }};
    {% endif %}
    display: block;
  }

  .ai-hero__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-hero__media-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero__media-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
    opacity: 0.3;
  }

  .ai-hero__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-hero__content-wrapper-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    padding: 60px 40px;
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
    text-align: {{ block.settings.text_alignment }};
    {% if block.settings.enable_text_box %}
      background-color: {{ block.settings.text_box_bg_color }};
      border-radius: {{ block.settings.text_box_border_radius }}px;
      padding: {{ block.settings.text_box_padding }}px;
      opacity: {{ block.settings.text_box_opacity | divided_by: 100.0 }};
    {% endif %}
  }

  .ai-hero__subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_box_text_color }};
    margin: 0 0 {{ block.settings.subheading_spacing_bottom }}px;
    letter-spacing: {{ block.settings.subheading_spacing }}px;
    {% if block.settings.subheading_uppercase %}
      text-transform: uppercase;
    {% endif %}
    {% if block.settings.enable_text_shadow %}
      text-shadow: 0 2px 4px rgba(0, 0, 0, {{ block.settings.text_shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-hero__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_box_text_color }};
    margin: 0 0 {{ block.settings.heading_spacing_bottom }}px;
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: {{ block.settings.heading_spacing }}px;
    {% if block.settings.heading_uppercase %}
      text-transform: uppercase;
    {% endif %}
    {% if block.settings.enable_text_shadow %}
      text-shadow: 0 2px 4px rgba(0, 0, 0, {{ block.settings.text_shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-hero__text-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_box_text_color }};
    margin: 0 0 {{ block.settings.text_spacing_bottom }}px;
    line-height: {{ block.settings.text_line_height }};
    {% if block.settings.enable_text_shadow %}
      text-shadow: 0 2px 4px rgba(0, 0, 0, {{ block.settings.text_shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-hero__text-{{ ai_gen_id }} p {
    margin: 0 0 16px;
  }

  .ai-hero__text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-hero__button-{{ ai_gen_id }} {
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: all 0.3s ease;
    {% if block.settings.button_outline %}
      border: 2px solid {{ block.settings.button_text_color }};
      background-color: transparent;
    {% else %}
      border: none;
    {% endif %}
    {% if block.settings.button_uppercase %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
  }

  .ai-hero__button-{{ ai_gen_id }}:hover {
    {% if block.settings.button_outline %}
      background-color: {{ block.settings.button_text_color }};
      color: {{ block.settings.button_bg_color }};
    {% else %}
      opacity: 0.8;
    {% endif %}
  }

  @media screen and (max-width: 768px) {
    .ai-hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
      align-items: {{ block.settings.text_box_vertical_mobile }};
      justify-content: center;
      padding: 0;
      background-color: transparent;
      {% if block.settings.enable_text_box_mobile %}
        padding: {{ block.settings.text_box_margin_mobile }}px;
      {% endif %}
    }

    .ai-hero__media-wrapper-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero__image-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
      max-width: 100%;
      max-height: 100%;
      object-fit: {{ block.settings.image_fit_mobile }};
      object-position: {{ block.settings.image_position_mobile }};
    }

    .ai-hero__overlay-{{ ai_gen_id }} {
      opacity: {{ block.settings.overlay_opacity_mobile | divided_by: 100.0 }};
    }

    .ai-hero__content-wrapper-{{ ai_gen_id }} {
      padding: 40px 20px;
      max-width: 100%;
      {% if block.settings.enable_text_box_mobile %}
        margin: {{ block.settings.text_box_margin_mobile }}px;
        background-color: {{ block.settings.text_box_bg_color }};
        border-radius: {{ block.settings.text_box_border_radius }}px;
        padding: {{ block.settings.text_box_padding_mobile }}px;
        opacity: {{ block.settings.text_box_opacity_mobile | divided_by: 100.0 }};
      {% else %}
        background-color: transparent;
        opacity: 1;
        border-radius: 0;
        padding: 40px 20px;
      {% endif %}
    }

    .ai-hero__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
      color: {{ block.settings.text_box_text_color_mobile }};
      margin-bottom: {{ block.settings.subheading_spacing_bottom_mobile }}px;
    }

    .ai-hero__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
      color: {{ block.settings.text_box_text_color_mobile }};
      margin-bottom: {{ block.settings.heading_spacing_bottom_mobile }}px;
    }

    .ai-hero__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
      color: {{ block.settings.text_box_text_color_mobile }};
      margin-bottom: {{ block.settings.text_spacing_bottom_mobile }}px;
    }

    .ai-hero__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_text_size_mobile }}px;
      padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
      background-color: {{ block.settings.button_bg_color_mobile }};
      color: {{ block.settings.button_text_color_mobile }};
      {% if block.settings.button_outline_mobile %}
        border: 2px solid {{ block.settings.button_text_color_mobile }};
        background-color: transparent;
      {% else %}
        border: none;
      {% endif %}
    }

    .ai-hero__button-{{ ai_gen_id }}:hover {
      {% if block.settings.button_outline_mobile %}
        background-color: {{ block.settings.button_text_color_mobile }};
        color: {{ block.settings.button_bg_color_mobile }};
      {% else %}
        opacity: 0.8;
      {% endif %}
    }
  }
{% endstyle %}

<div
  class="ai-hero-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero__media-wrapper-{{ ai_gen_id }}">
    {% if block.settings.media_type == 'video' and block.settings.video_url != blank %}
      <video
        class="ai-hero__video-{{ ai_gen_id }}"
        {% if block.settings.video_autoplay %}autoplay{% endif %}
        {% if block.settings.video_loop %}loop{% endif %}
        {% if block.settings.video_muted %}muted{% endif %}
        playsinline
      >
        <source src="{{ block.settings.video_url }}" type="video/mp4">
      </video>
    {% elsif block.settings.media_type == 'image' and block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image.alt | escape }}"
        {% if block.settings.lazy_load %}loading="lazy"{% endif %}
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-hero__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero__media-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.enable_overlay %}
    <div class="ai-hero__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-hero__content-wrapper-{{ ai_gen_id }}">
    {% if block.settings.subheading != blank %}
      <div class="ai-hero__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-hero__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="ai-hero__text-{{ ai_gen_id }}">
        {{ block.settings.text }}
      </div>
    {% endif %}

    {% if block.settings.button_label != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-hero__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

