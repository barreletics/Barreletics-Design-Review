{% doc %}
  @prompt
    narrow Text banner with balck frinday message " Pre-Black Friday Early Access — Up to 35% Off"
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-black-friday-banner-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding }}px 20px;
    text-align: center;
    width: 100%;
    /* Critical: never intercept header/menu taps if stacking overlaps */
    pointer-events: none;
  }

  .ai-black-friday-banner__content-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .ai-black-friday-banner__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    margin: 0;
    line-height: 1.2;
  }

  {% if block.settings.text_transform == 'uppercase' %}
    .ai-black-friday-banner__text-{{ ai_gen_id }} {
      text-transform: uppercase;
    }
  {% endif %}

  .ai-black-friday-banner__link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    display: block;
    /* Allow optional link to be clickable without making whole bar a tap-catcher */
    pointer-events: auto;
  }

  .ai-black-friday-banner__link-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-black-friday-banner__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-black-friday-banner-{{ ai_gen_id }}" style="pointer-events:none" {{ block.shopify_attributes }}>
  {% if block.settings.link != blank %}
    <a href="{{ block.settings.link }}" class="ai-black-friday-banner__link-{{ ai_gen_id }}" style="pointer-events:auto">
      <div class="ai-black-friday-banner__content-{{ ai_gen_id }}">
        <p class="ai-black-friday-banner__text-{{ ai_gen_id }}">{{ block.settings.message }}</p>
      </div>
    </a>
  {% else %}
    <div class="ai-black-friday-banner__content-{{ ai_gen_id }}">
      <p class="ai-black-friday-banner__text-{{ ai_gen_id }}">{{ block.settings.message }}</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Black Friday banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "message",
      "label": "Message",
      "default": "Pre-Black Friday Early Access — Up to 35% Off"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "label": "Letter spacing",
      "default": 0.5
    }
  ],
  "presets": [
    {
      "name": "Black Friday banner"
    }
  ]
}
{% endschema %}
