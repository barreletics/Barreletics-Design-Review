{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign show_block = false
  
  if block.settings.show_on_all_pages
    assign show_block = true
  else
    if template.name == 'index' and block.settings.show_on_home
      assign show_block = true
    elsif template.name == 'product' and block.settings.show_on_product
      assign show_block = true
    elsif template.name == 'collection' and block.settings.show_on_collection
      assign show_block = true
    elsif template.name == 'blog' and block.settings.show_on_blog
      assign show_block = true
    elsif template.name == 'article' and block.settings.show_on_blog
      assign show_block = true
    elsif template.name == 'cart' and block.settings.show_on_cart
      assign show_block = true
    elsif template.name == 'page'
      if page.handle == 'about' and block.settings.show_on_about
        assign show_block = true
      elsif page.handle contains 'polic' and block.settings.show_on_policy
        assign show_block = true
      elsif block.settings.show_on_other_pages
        assign show_block = true
      endif
    elsif template.name == 'search' and block.settings.show_on_search
      assign show_block = true
    elsif block.settings.show_on_other_pages
      assign show_block = true
    endif
  endif

  if block.settings.image_ratio_desktop == 'square'
    assign desktop_padding = 100
  elsif block.settings.image_ratio_desktop == 'portrait'
    assign desktop_padding = 125
  elsif block.settings.image_ratio_desktop == 'landscape'
    assign desktop_padding = 75
  endif

  if block.settings.image_ratio_mobile == 'square'
    assign mobile_padding = 100
  elsif block.settings.image_ratio_mobile == 'portrait'
    assign mobile_padding = 125
  elsif block.settings.image_ratio_mobile == 'landscape'
    assign mobile_padding = 75
  endif
%}

{% if show_block %}
  {% style %}
    .ai-product-slider-{{ ai_gen_id }} {
      position: relative;
      background: {{ block.settings.section_background }};
      {% if block.settings.full_width == false %}
        max-width: {{ block.settings.max_content_width }}px;
        margin: {{ block.settings.section_margin_top }}px auto {{ block.settings.section_margin_bottom }}px;
      {% else %}
        margin: {{ block.settings.section_margin_top }}px 0 {{ block.settings.section_margin_bottom }}px;
      {% endif %}
      padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
      {% if block.settings.section_border_width > 0 %}
        border: {{ block.settings.section_border_width }}px solid {{ block.settings.section_border_color }};
      {% endif %}
      border-radius: {{ block.settings.section_border_radius }}px;
      overflow: hidden;
    }

    .ai-product-slider__wrapper-{{ ai_gen_id }} {
      position: relative;
      overflow: visible;
      max-width: {{ block.settings.max_content_width }}px;
      margin: 0 auto;
    }

    .ai-product-slider__track-{{ ai_gen_id }} {
      display: flex;
      gap: {{ block.settings.gap_desktop }}px;
      will-change: transform;
    }

    .ai-product-slider__slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.gap_desktop | times: block.settings.slides_per_view_desktop | minus: block.settings.gap_desktop }}px) / {{ block.settings.slides_per_view_desktop }});
      display: flex;
      flex-direction: column;
    }

    .ai-product-slider__image-wrapper-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      padding-bottom: {{ desktop_padding }}%;
      overflow: hidden;
      border-radius: {{ block.settings.image_radius_desktop }}px;
      background: {{ block.settings.image_background }};
      margin-bottom: {{ block.settings.content_top_margin_desktop }}px;
    }

    .ai-product-slider__image-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: opacity 0.8s ease;
    }

    .ai-product-slider__image--primary-{{ ai_gen_id }} {
      opacity: 1;
      z-index: 1;
    }

    .ai-product-slider__image--secondary-{{ ai_gen_id }} {
      opacity: 0;
      z-index: 2;
    }

    .ai-product-slider__slide-{{ ai_gen_id }}.center .ai-product-slider__image--secondary-{{ ai_gen_id }} {
      opacity: 1;
    }

    .ai-product-slider__image-placeholder-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: {{ block.settings.image_background }};
    }

    .ai-product-slider__image-placeholder-{{ ai_gen_id }} svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ai-product-slider__content-{{ ai_gen_id }} {
      text-align: {{ block.settings.content_alignment_desktop }};
      display: flex;
      flex-direction: column;
      gap: {{ block.settings.content_gap }}px;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .ai-product-slider__slide-{{ ai_gen_id }}.center .ai-product-slider__content-{{ ai_gen_id }} {
      opacity: 1;
      transform: translateY(0);
    }

    .ai-product-slider__title-wrapper-{{ ai_gen_id }} {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin: {{ block.settings.title_margin_top }}px -{{ block.settings.title_margin_horizontal }}px {{ block.settings.title_margin_bottom }}px;
    }

    .ai-product-slider__title-{{ ai_gen_id }} {
      {% if block.settings.use_custom_title_font %}
        font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
        font-weight: {{ block.settings.title_font.weight }};
        font-style: {{ block.settings.title_font.style }};
      {% endif %}
      font-size: {{ block.settings.title_size_desktop }}px;
      line-height: {{ block.settings.title_line_height }};
      color: {{ block.settings.title_color }};
      margin: 0;
      {% if block.settings.title_uppercase %}
        text-transform: uppercase;
      {% else %}
        text-transform: none;
      {% endif %}
      letter-spacing: 0.5px;
      flex: 1;
      text-align: center;
    }

    .ai-product-slider__button-wrapper-{{ ai_gen_id }} {
      margin-top: auto;
    }

    .ai-product-slider__button-{{ ai_gen_id }} {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
      background: {{ block.settings.button_background }};
      color: {{ block.settings.button_text_color }};
      border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
      border-radius: {{ block.settings.button_radius }}px;
      {% if block.settings.use_custom_button_font %}
        font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
        font-weight: {{ block.settings.button_font.weight }};
        font-style: {{ block.settings.button_font.style }};
      {% endif %}
      font-size: {{ block.settings.button_text_size }}px;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      {% if block.settings.content_alignment_desktop == 'center' %}
        margin: 0 auto;
      {% elsif block.settings.content_alignment_desktop == 'right' %}
        margin-left: auto;
      {% endif %}
    }

    .ai-product-slider__button-{{ ai_gen_id }}:hover {
      background: {{ block.settings.button_hover_background }};
      color: {{ block.settings.button_hover_text_color }};
      border-color: {{ block.settings.button_hover_border_color }};
      {% if block.settings.button_hover_effect == 'scale' %}
        transform: scale(1.05);
      {% endif %}
    }

    .ai-product-slider__button-arrow-{{ ai_gen_id }} {
      width: 16px;
      height: 16px;
      transition: transform 0.3s ease;
    }

    {% if block.settings.button_hover_effect == 'nudge' %}
      .ai-product-slider__button-{{ ai_gen_id }}:hover .ai-product-slider__button-arrow-{{ ai_gen_id }} {
        transform: translateX(4px);
      }
    {% endif %}

    .ai-product-slider__nav-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
      background: rgba(200, 200, 200, 0.3);
      border: none;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      flex-shrink: 0;
    }

    .ai-product-slider__nav-{{ ai_gen_id }}:hover {
      background: rgba(200, 200, 200, 0.5);
      transform: scale(1.1);
    }

    .ai-product-slider__nav-{{ ai_gen_id }} svg {
      width: 18px;
      height: 18px;
      stroke: #999;
      stroke-width: 2;
      transition: stroke 0.3s ease;
    }

    .ai-product-slider__nav-{{ ai_gen_id }}:hover svg {
      stroke: #666;
    }

    @media screen and (max-width: 749px) {
      .ai-product-slider-{{ ai_gen_id }} {
        margin: {{ block.settings.section_margin_top_mobile }}px 0 {{ block.settings.section_margin_bottom_mobile }}px;
        padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
      }

      .ai-product-slider__track-{{ ai_gen_id }} {
        gap: {{ block.settings.gap_mobile }}px;
      }

      .ai-product-slider__slide-{{ ai_gen_id }} {
        flex: 0 0 calc((100% - {{ block.settings.gap_mobile | times: block.settings.slides_per_view_mobile | minus: block.settings.gap_mobile }}px) / {{ block.settings.slides_per_view_mobile }});
      }

      .ai-product-slider__image-wrapper-{{ ai_gen_id }} {
        padding-bottom: {{ mobile_padding }}%;
        border-radius: {{ block.settings.image_radius_mobile }}px;
        margin-bottom: {{ block.settings.content_top_margin_mobile }}px;
      }

      .ai-product-slider__content-{{ ai_gen_id }} {
        text-align: {{ block.settings.content_alignment_mobile }};
      }

      .ai-product-slider__title-wrapper-{{ ai_gen_id }} {
        margin: {{ block.settings.title_margin_top | times: 0.7 }}px -{{ block.settings.title_margin_horizontal | times: 0.7 }}px {{ block.settings.title_margin_bottom | times: 0.7 }}px;
      }

      .ai-product-slider__title-{{ ai_gen_id }} {
        font-size: {{ block.settings.title_size_mobile }}px;
      }

      .ai-product-slider__button-{{ ai_gen_id }} {
        {% if block.settings.content_alignment_mobile == 'center' %}
          margin: 0 auto;
        {% elsif block.settings.content_alignment_mobile == 'right' %}
          margin-left: auto;
        {% elsif block.settings.content_alignment_mobile == 'left' %}
          margin-left: 0;
        {% endif %}
      }

      .ai-product-slider__nav-{{ ai_gen_id }} {
        width: 28px;
        height: 28px;
      }

      .ai-product-slider__nav-{{ ai_gen_id }} svg {
        width: 16px;
        height: 16px;
      }
    }
  {% endstyle %}

  <product-slider-{{ ai_gen_id }} 
    class="ai-product-slider-{{ ai_gen_id }}" 
    data-autoplay="{{ block.settings.autoplay }}"
    data-scroll-speed="{{ block.settings.scroll_speed }}"
    {{ block.shopify_attributes }}
  >
    <div class="ai-product-slider__wrapper-{{ ai_gen_id }}">
      <div class="ai-product-slider__track-{{ ai_gen_id }}">
        {% if block.settings.collection != blank %}
          {% for product in block.settings.collection.products limit: block.settings.product_limit %}
            <div class="ai-product-slider__slide-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
              <div class="ai-product-slider__image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                            {{ product.featured_image | image_url: width: 600 }} 600w,
                            {{ product.featured_image | image_url: width: 800 }} 800w"
                    sizes="(max-width: 749px) 100vw, (max-width: 989px) 50vw, 33vw"
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-slider__image-{{ ai_gen_id }} ai-product-slider__image--primary-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="1000"
                  >
                  {% if product.media[1] %}
                    <img
                      srcset="{{ product.media[1] | image_url: width: 400 }} 400w,
                              {{ product.media[1] | image_url: width: 600 }} 600w,
                              {{ product.media[1] | image_url: width: 800 }} 800w"
                      sizes="(max-width: 749px) 100vw, (max-width: 989px) 50vw, 33vw"
                      src="{{ product.media[1] | image_url: width: 800 }}"
                      alt="{{ product.media[1].alt | escape }}"
                      class="ai-product-slider__image-{{ ai_gen_id }} ai-product-slider__image--secondary-{{ ai_gen_id }}"
                      loading="lazy"
                      width="800"
                      height="1000"
                    >
                  {% endif %}
                {% else %}
                  <div class="ai-product-slider__image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-product-slider__content-{{ ai_gen_id }}">
                <div class="ai-product-slider__title-wrapper-{{ ai_gen_id }}">
                  <button class="ai-product-slider__nav-{{ ai_gen_id }} ai-product-slider__nav--prev-{{ ai_gen_id }}" aria-label="Previous" data-slide-nav="prev">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M15 18L9 12L15 6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>

                  <h3 class="ai-product-slider__title-{{ ai_gen_id }}">{{ product.title }}</h3>

                  <button class="ai-product-slider__nav-{{ ai_gen_id }} ai-product-slider__nav--next-{{ ai_gen_id }}" aria-label="Next" data-slide-nav="next">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 18L15 12L9 6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>

                {% if block.settings.show_button %}
                  <div class="ai-product-slider__button-wrapper-{{ ai_gen_id }}">
                    <a href="{{ product.url }}" class="ai-product-slider__button-{{ ai_gen_id }}">
                      {{ block.settings.button_text }}
                      {% if block.settings.show_button_arrow %}
                        <svg class="ai-product-slider__button-arrow-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {% endif %}
                    </a>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}

