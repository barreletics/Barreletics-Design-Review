    </div>
  </product-slider-{{ ai_gen_id }}>

  <script>
    (function() {
      class ProductSlider{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
          this.currentPosition = 0;
          this.animationId = null;
        }

        connectedCallback() {
          this.track = this.querySelector('.ai-product-slider__track-{{ ai_gen_id }}');
          if (!this.track) return;
          
          this.slides = Array.from(this.querySelectorAll('.ai-product-slider__slide-{{ ai_gen_id }}'));
          this.originalSlides = this.slides.filter(slide => !slide.dataset.clone);
          this.navButtons = this.querySelectorAll('[data-slide-nav]');
          this.autoplay = this.dataset.autoplay === 'true';
          this.scrollSpeed = parseFloat(this.dataset.scrollSpeed) || 0.5;

          this.setupEventListeners();
          this.updateCenterSlide();

          if (this.autoplay) {
            this.startAutoScroll();
          }
        }

        disconnectedCallback() {
          this.stopAutoScroll();
        }

        startAutoScroll() {
          const scroll = () => {
            this.currentPosition -= this.scrollSpeed;
            
            const gap = window.innerWidth <= 749 ? {{ block.settings.gap_mobile }} : {{ block.settings.gap_desktop }};
            const slideWidth = this.slides[0].offsetWidth + gap;
            const resetPoint = -(slideWidth * this.originalSlides.length);

            if (this.currentPosition <= resetPoint) {
              this.currentPosition = 0;
            }

            this.track.style.transform = 'translateX(' + this.currentPosition + 'px)';
            this.updateCenterSlide();
            
            this.animationId = requestAnimationFrame(scroll);
          };
          
          this.animationId = requestAnimationFrame(scroll);
        }

        stopAutoScroll() {
          if (this.animationId) {
            cancelAnimationFrame(this.animationId);
            this.animationId = null;
          }
        }

        updateCenterSlide() {
          const containerWidth = this.offsetWidth;
          const centerPoint = containerWidth / 2;

          this.slides.forEach(slide => {
            const rect = slide.getBoundingClientRect();
            const slideCenter = rect.left + rect.width / 2;
            const distanceFromCenter = Math.abs(slideCenter - centerPoint);

            if (distanceFromCenter < rect.width / 2) {
              slide.classList.add('center');
            } else {
              slide.classList.remove('center');
            }
          });
        }

        setupEventListeners() {
          this.navButtons.forEach(button => {
            button.addEventListener('click', (e) => {
              e.preventDefault();
              this.stopAutoScroll();
              
              const gap = window.innerWidth <= 749 ? {{ block.settings.gap_mobile }} : {{ block.settings.gap_desktop }};
              const slideWidth = this.slides[0].offsetWidth + gap;
              
              if (button.dataset.slideNav === 'prev') {
                this.currentPosition += slideWidth;
              } else {
                this.currentPosition -= slideWidth;
              }
              
              this.track.style.transform = 'translateX(' + this.currentPosition + 'px)';
              this.updateCenterSlide();
              
              if (this.autoplay) {
                setTimeout(() => this.startAutoScroll(), 2000);
              }
            });
          });

          this.addEventListener('mouseenter', () => {
            if (this.autoplay) {
              this.stopAutoScroll();
            }
          });

          this.addEventListener('mouseleave', () => {
            if (this.autoplay) {
              this.startAutoScroll();
            }
          });
        }
      }

      customElements.define('product-slider-{{ ai_gen_id }}', ProductSlider{{ ai_gen_id }});
    })();
  </script>
{% endif %}

