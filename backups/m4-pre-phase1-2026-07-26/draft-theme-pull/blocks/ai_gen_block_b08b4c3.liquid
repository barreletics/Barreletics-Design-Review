                </div>
              </div>

              <div class="ai-product-slider__content-{{ ai_gen_id }}">
                <div class="ai-product-slider__title-wrapper-{{ ai_gen_id }}">
                  <button class="ai-product-slider__nav-{{ ai_gen_id }} ai-product-slider__nav--prev-{{ ai_gen_id }}" aria-label="Previous" data-slide-nav="prev">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
