{% comment %}
  It's best to load images as JPG instead of PNG for faster
  loading, so that is our default. If you upload
  PNG files and want to keep them that way, set the line
  below to false.

  Can set thumbnail position to 'below', but only suggested
  when using the 'Fade' image style (set in Product grid)
{% endcomment %}

{% comment %}
  Parameters
  context - used to determine whether on the featured product or main product template
  sizes
  sizeVariable
  fallback
  le_badge_bg - LE badge background (main product image), default #458CD9
  le_badge_text_color - LE badge text color, default #ffffff
{% endcomment %}

{%- liquid
  assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign _cv = product.selected_or_first_available_variant

  assign thumbnail_position = 'beside'
  assign has_slideshow = 'false'
  if product_image_type == 'slider'
    assign has_slideshow = 'true'
  endif

  if context == 'main-product'
    assign loading = 'eager'
  endif

  assign _show_le_overlay = false
  assign _le_raw = ''
  assign _le_token_csv = ''
  assign _color_opt_index = 0
  if product != blank and _cv != blank
    assign _le_me = product.metafields.custom.limited_colors | default: product.metafields.custom.limited_edition_colors
    if _le_me != blank and _le_me.value != blank
      assign _le_val = _le_me.value
      if _le_val contains ','
        assign _le_raw = _le_val | strip
      else
        assign _le_raw = _le_val | join: ','
      endif
    endif
    if _le_raw != blank
      assign _le_list = _le_raw | split: ','
      for _lc in _le_list
        assign _lc_clean = _lc | strip | downcase | handleize
        if _lc_clean != blank
          if _le_token_csv != blank
            assign _le_token_csv = _le_token_csv | append: ','
          endif
          assign _le_token_csv = _le_token_csv | append: _lc_clean
        endif
      endfor

      for opt in product.options_with_values
        assign _opt_down = opt.name | downcase
        if _opt_down contains 'color' or _opt_down contains 'colour'
          assign _color_opt_index = forloop.index
          break
        endif
      endfor
      if _color_opt_index > 0
        assign _v_color = ''
        if _color_opt_index == 1
          assign _v_color = _cv.option1 | default: ''
        elsif _color_opt_index == 2
          assign _v_color = _cv.option2 | default: ''
        else
          assign _v_color = _cv.option3 | default: ''
        endif
        assign _v_color_clean = _v_color | strip | downcase | handleize
        if _v_color_clean != blank
          assign _le_tokens = _le_token_csv | split: ','
          for _lc in _le_tokens
            assign _lc_clean = _lc | strip | downcase | handleize
            if _lc_clean != blank and _lc_clean == _v_color_clean
              assign _show_le_overlay = true
              break
            endif
          endfor
        endif
      endif
    endif
  endif
  if request.design_mode and _le_token_csv != blank
    assign _show_le_overlay = true
  endif

  assign _le_label = 'Limited Edition'
-%}

{%- unless product.empty? -%}
  <div
    data-product-images
    data-zoom="{{ product_zoom_enable }}"
    data-has-slideshow="{{ has_slideshow }}">
    <div class="product__photos product__photos-{{ section_id }} product__photos--{{ thumbnail_position }}">

      <div class="product__main-photos{% if product_image_type == 'slider' %} product__main-photos--slider{% endif %}{% if _show_le_overlay %} br-product-photos--has-le-overlay{% endif %}" data-aos data-product-single-media-group style="position:relative;">
        <div class="product__main-photos-wrapper">
          <div
            id="ProductPhotos-{{ section_id }}"
            class="product-slideshow"
            data-product-photos
            data-zoom="{{ product_zoom_enable }}"
          >
            {%- for media in product.media -%}
              {%- render 'media',
                section_id: section_id,
                media: media,
                featured_media: featured_media,
                loopIndex0: forloop.index0,
                loopIndex: forloop.index,
                product_zoom_enable: product_zoom_enable,
                product_zoom_size: product_zoom_size,
                product_image_size: product_image_size,
                product_image_type: product_image_type,
                isModal: isModal,
                video_looping: video_looping,
                video_style: video_style,
                sizes: sizes,
                sizeVariable: sizeVariable,
                fallback: fallback,
                loading: loading,
                context: 'product'
              -%}
            {%- endfor -%}
          </div>
        </div>
        {%- if _le_token_csv != blank -%}
          {%- if _show_le_overlay -%}{%- assign _le_display = 'block' -%}{%- else -%}{%- assign _le_display = 'none' -%}{%- endif -%}
          {%- assign _le_extra = 'position:absolute;top:12px;left:12px;z-index:9999;display:' | append: _le_display | append: ';' -%}
          {%- assign _le_badge_id = 'pdp-le-badge-' | append: section_id -%}
          {% render 'br-le-badge', id: _le_badge_id, label: _le_label, extra_style: _le_extra %}
          <script>
            (function() {
              var sectionId = {{ section_id | json }};
              var sectionEl = document.getElementById('ProductSection-' + sectionId);
              var badgeEl = document.getElementById('pdp-le-badge-' + sectionId);
              if (!sectionEl || !badgeEl || sectionEl.dataset.brLeBadgeBound === 'true') return;
              sectionEl.dataset.brLeBadgeBound = 'true';

              var colorOptionIndex = parseInt({{ _color_opt_index | default: 0 | json }}, 10);
              var leColors = {{ _le_token_csv | split: ',' | json }};

              var normalize = function(value) {
                return (value || '')
                  .toString()
                  .trim()
                  .toLowerCase()
                  .replace(/['"]/g, '')
                  .replace(/[^a-z0-9]+/g, '-')
                  .replace(/^-+|-+$/g, '');
              };

              var updateBadge = function(variant) {
                if (!variant || !colorOptionIndex) {
                  badgeEl.style.display = 'none';
                  return;
                }

                var optionValue = variant['option' + colorOptionIndex];
                var normalizedValue = normalize(optionValue);
                var show = Array.isArray(leColors) && leColors.some(function(c) {
                  return c && normalize(c) === normalizedValue;
                });
                badgeEl.style.display = show ? 'block' : 'none';
              };

              sectionEl.addEventListener('variantChange', function(event) {
                updateBadge(event && event.detail ? event.detail.variant : null);
              });

              document.addEventListener('variant:change', function(event) {
                updateBadge(event && event.detail ? event.detail.variant : null);
              });

              var currentVariantNode = sectionEl.querySelector('[data-current-variant-json]');
              if (currentVariantNode && currentVariantNode.textContent) {
                try {
                  updateBadge(JSON.parse(currentVariantNode.textContent));
                } catch (error) {}
              }
            })();
          </script>
        {%- endif -%}

        {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}

        {%- if first_3d_model -%}
          <button
            aria-label="{{ 'products.product.view_in_space_label' | t }}"
            class="product-single__view-in-space"
            data-shopify-xr
            data-shopify-model3d-id="{{ first_3d_model.id }}"
            data-shopify-title="{{ product.title }}"
            data-shopify-xr-hidden
          >
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-3d" viewBox="18.24 17.35 24.52 28.3"><path fill="#3A3A3A" d="m30.5 17.35-12.26 7.07v14.16l12.26 7.07 12.26-7.08V24.42L30.5 17.35zM20.24 37.42V25.58l10.26-5.93 10.13 5.85-10.13 5.88v12l-10.26-5.96z"/></svg>
            <span class='product-single__view-in-space-text'>
              {{ 'products.product.view_in_space' | t }}
            </span>
          </button>
        {%- endif -%}
      </div>

      <div
        id="ProductThumbs-{{ section_id }}"
        class="product__thumbs product__thumbs--{{ thumbnail_position }} small--hide{% if product.media.size == 1 %} medium-up--hide{% endif %}"
        data-position="{{ thumbnail_position }}"
        data-product-thumbs
        data-aos>
        {%- if product_image_type == 'stacked' -%}
          <div class="product__thumbs-sticky">
        {%- else -%}
          <div class="product__thumbs--scroller" data-product-thumbs-scroller>
        {%- endif -%}
          {%- if product.media.size > 1 -%}
            {%- for media in product.media -%}
              {%- liquid
                assign image_set = false
                assign image_set_group = ''
                if media.alt contains '#'
                  assign image_set_full = media.alt | split: '#' | last
                  if image_set_full contains '_'
                    assign image_set = true
                    assign image_set_group = image_set_full | split: '_' | first
                  endif
                endif
              -%}
              <div class="product__thumb-item{% if product_image_type == 'stacked' and forloop.index == 1 %} thumb--current{% endif %}"
                data-product-thumb-item
                data-index="{{ forloop.index0 }}"
                {% if image_set %}
                  data-set-name="{{image_set_group}}"
                  data-group="{{image_set_full}}"
                {% else %}
                  data-group
                {% endif %}>
                <a
                  href="{{ media.preview_image | img_url: product_zoom_size }}"
                  class="image-wrap product__thumb js-no-transition"
                  data-id="{{ media.id }}"
                  data-index="{{ forloop.index0 }}"
                  data-product-thumb
                  style="height: 0; padding-bottom: {{ 100 | divided_by: media.preview_image.aspect_ratio }}%;">
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <span class="product__thumb-icon">
                      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-play" viewBox="18.24 17.35 24.52 28.3"><path fill="#323232" d="M22.1 19.151v25.5l20.4-13.489-20.4-12.011z"/></svg>
                    </span>
                  {%- endif -%}
                  {%- if media.media_type == 'model' -%}
                    <span class="product__thumb-icon">
                      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-3d" viewBox="18.24 17.35 24.52 28.3"><path fill="#3A3A3A" d="m30.5 17.35-12.26 7.07v14.16l12.26 7.07 12.26-7.08V24.42L30.5 17.35zM20.24 37.42V25.58l10.26-5.93 10.13 5.85-10.13 5.88v12l-10.26-5.96z"/></svg>
                    </span>
                  {%- endif -%}

                  {%- render 'image-element',
                    img: media.preview_image,
                    widths: '120, 360, 540, 750',
                    format: format,
                    sizeVariable: '80px',
                    loading: loading,
                  -%}
                </a>
              </div>
            {%- endfor -%}
          {%- endif -%}
        {%- if product_image_type == 'stacked' -%}
          </div>
        {%- else -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {% if thumbnail_height == 'fixed' and product_image_type == 'slider' %}
    {% style %}
      .product__photos-{{ section_id }} .product__thumbs:not(.product__thumbs--below) {
        min-height: 400px;
        max-height: 400px;
      }

      @media screen and (max-width: 589px) {
        .product__photos-{{ section_id }} .product__thumbs:not(.product__thumbs--below) {
          min-height: 300px;
          max-height: 300px;
        }
      }
    {% endstyle %}
  {% endif %}

  <script type="application/json" id="ModelJson-{{ section_id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>

{%- else -%}
  <div class="product__photos">
    <div class="product__main-photos" style="width: 100%">
      <div id="ProductPhotos-{{ section_id }}" class="product-slideshow">
        <div class="product-main-slide" data-index="{{ forloop.index0 }}">
          <a href="#">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </a>
        </div>
      </div>
    </div>
  </div>
{%- endunless -%}
