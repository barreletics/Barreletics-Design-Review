<div class="variant-wrapper small--text-center variant-wrapper--dropdown js" data-type="dropdown">
  <label class="variant__label{% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}"
    for="SingleOptionSelector-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    {{ option.name }}
  </label>
  <div class="variant-input-wrap"
    data-index="option{{ forloop.index }}"
    data-handle="{{ option.name | handleize }}">
    <select
      form="{{ form_id }}"
      class="variant__input-{{ section_id }}"
      id="SingleOptionSelector-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}"
      data-index="option{{ forloop.index }}"
      data-variant-input>
      {%- assign _sk = product.metafields.custom.show_kids_sizes.value -%}
      {%- assign hide_kids_dd = false -%}
      {%- if _sk == false or _sk == "false" or _sk == "False" -%}{%- assign hide_kids_dd = true -%}{%- endif -%}
      {%- assign opt_name_d = option.name | downcase -%}
      {%- for value in option.values -%}
        {%- assign value_d = value | strip | downcase -%}
        {%- assign is_kids_opt = false -%}
        {%- if hide_kids_dd and opt_name_d contains 'size' and value_d contains 'kids' -%}{%- assign is_kids_opt = true -%}{%- endif -%}
        {%- liquid
          assign variant_label_state = true
          if product.options.size == 1 and block.settings.product_dynamic_variants_enable
            unless product.variants[forloop.index0].available
              assign variant_label_state = false
            endunless
          endif
        -%}
        <option
          value="{{ value | escape }}"
          {% if option.selected_value == value %} selected="selected"{% endif %}
          {% unless variant_label_state %} disabled="disabled"{% endunless %}
          name="{{ option.name }}"
          class="variant-input{% if is_kids_opt %} br-hide-kids-pdp{% endif %}"{% if is_kids_opt %} style="display:none!important"{% endif %}
          data-index="option{{ forloop.index }}">
          {{ value }}
        </option>
      {%- endfor -%}
    </select>
  </div>
</div>
