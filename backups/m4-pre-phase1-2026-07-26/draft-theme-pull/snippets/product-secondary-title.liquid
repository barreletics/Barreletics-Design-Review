{%- comment -%}
  Renders the secondary title (H2) when display_title is set.
  Use in product-template after the main H1:
  {% render 'product-secondary-title', display_title: display_title %}
{%- endcomment -%}
{%- if display_title != blank -%}
  <h2 class="product__short-title">{{ display_title }}</h2>
{%- endif -%}