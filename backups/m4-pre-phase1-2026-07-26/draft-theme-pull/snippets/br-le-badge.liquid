{%- comment -%}
  LE badge: blue bg, white text. No theme classes so nothing can override.
  Usage: {% render 'br-le-badge', label: 'Limited Edition' %}
  Optional: id (e.g. pdp-le-badge), extra_style (e.g. display:none; position:absolute...)
{%- endcomment -%}
{%- assign _label = label | default: 'Limited Edition' -%}
{%- assign _extra = extra_style | default: '' -%}
<span{% if id %} id="{{ id }}"{% endif %} style="background:#458CD9;color:#fff;padding:4px 8px;font-family:Roboto,sans-serif;font-weight:600;font-size:13px;text-transform:uppercase;letter-spacing:0.08em;{{ _extra }}">{{ _label }}</span>
