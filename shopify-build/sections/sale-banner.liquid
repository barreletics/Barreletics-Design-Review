{% comment %}
  SAVE2 promo bar. Mobile: on (locked two-bar). Desktop: off by default (one cream announce line).
  TE: Show on desktop / Show on mobile — independent.
{% endcomment %}

{% if section.settings.enabled %}
  {%- liquid
    assign y_d = 10
    assign side_d = 24
    assign y_m = 6
    assign x_m = 16

    assign banner_fs = section.settings.font_size | default: 15
    assign banner_wt = section.settings.font_weight | default: '500'

    assign banner_pad_y = section.settings.pad_y | default: y_d
    if section.settings.text_pad_y != blank and section.settings.text_pad_y != y_d
      assign banner_pad_y = section.settings.text_pad_y
    endif
    assign banner_pad_x = side_d
    if section.settings.side_padding != blank and section.settings.side_padding != side_d
      assign banner_pad_x = section.settings.side_padding
    endif

    assign emit_y_d = false
    if section.settings.text_pad_y != blank and section.settings.text_pad_y != y_d
      assign emit_y_d = true
    endif
    assign emit_side_d = false
    if section.settings.side_padding != blank and section.settings.side_padding != side_d
      assign emit_side_d = true
    endif
    assign emit_y_m = false
    if section.settings.text_pad_y_mobile != blank and section.settings.text_pad_y_mobile != y_m
      assign emit_y_m = true
    endif
    assign emit_x_m = false
    if section.settings.text_pad_x_mobile != blank and section.settings.text_pad_x_mobile != x_m
      assign emit_x_m = true
    endif
  -%}
  {%- assign _desk = section.settings.show_on_desktop -%}
  {%- if _desk == nil -%}{%- assign _desk = true -%}{%- endif -%}
  {%- assign _mob = section.settings.show_on_mobile -%}
  {%- if _mob == nil -%}{%- assign _mob = true -%}{%- endif -%}

  {%- unless _desk -%}
    <style>#shopify-section-{{ section.id }} { }
    @media (min-width: 901px) { #shopify-section-{{ section.id }} { display: none !important; } }</style>
  {%- endunless -%}
  {%- unless _mob -%}
    <style>@media (max-width: 900px) { #shopify-section-{{ section.id }} { display: none !important; } }</style>
  {%- endunless -%}

  <div
    class="sale-banner"
    role="region"
    aria-label="Promotion"
    style="
      --sale-banner-bg: {{ section.settings.bg_color | default: '#faf8f6' }};
      --sale-banner-color: {{ section.settings.text_color | default: '#1c1916' }};
      --sale-banner-font-size: {{ banner_fs }}px;
      --sale-banner-pad-y: {{ banner_pad_y }}px;
      --sale-banner-pad-x: {{ banner_pad_x }}px;
      --sale-banner-weight: {{ banner_wt }};
    "
    {{ section.shopify_attributes }}
  >
    <div class="sale-banner__inner">
      {% if section.settings.link_url != blank %}
        <a href="{{ section.settings.link_url }}" class="sale-banner__text">
          {{ section.settings.text }}
        </a>
      {% else %}
        <p class="sale-banner__text">{{ section.settings.text }}</p>
      {% endif %}
    </div>
  </div>
{% endif %}

{%- if emit_y_d or emit_side_d or emit_y_m or emit_x_m -%}
{% style %}
  {%- if emit_y_d or emit_side_d -%}
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .sale-banner {
      {%- if emit_y_d -%}
      padding-top: {{ section.settings.text_pad_y }}px;
      padding-bottom: {{ section.settings.text_pad_y }}px;
      {%- endif -%}
      {%- if emit_side_d -%}
      padding-left: {{ section.settings.side_padding }}px;
      padding-right: {{ section.settings.side_padding }}px;
      {%- endif -%}
    }
  }
  {%- endif -%}
  {%- if emit_y_m or emit_x_m -%}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .sale-banner {
      {%- if emit_y_m -%}
      padding-top: {{ section.settings.text_pad_y_mobile }}px;
      padding-bottom: {{ section.settings.text_pad_y_mobile }}px;
      {%- endif -%}
      {%- if emit_x_m -%}
      padding-left: {{ section.settings.text_pad_x_mobile }}px;
      padding-right: {{ section.settings.text_pad_x_mobile }}px;
      {%- endif -%}
    }
  }
  {%- endif -%}
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Sale banner",
  "class": "sale-banner-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable sale banner",
      "default": true,
      "info": "Master switch. Use desktop/mobile toggles below for where it shows."
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true,
      "info": "On = cream two-bar (SAVE2 + trust). Off = one announce line only."
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true,
      "info": "Keep on for locked mobile two-bar (SAVE2 + trust)."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Buy 2 save 10% | Use SAVE2"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Optional link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#faf8f6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1c1916"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "400",
          "label": "400 Regular"
        },
        {
          "value": "500",
          "label": "500 Medium"
        },
        {
          "value": "600",
          "label": "600 Semibold"
        },
        {
          "value": "700",
          "label": "700 Bold"
        }
      ],
      "default": "500",
      "info": "Live SAVE2 is not bold."
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Sale"
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Vertical padding",
      "min": 4,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ section.settings.aria_label == '__legacy_hidden__' }}"
    },
    {
      "type": "header",
      "content": "Layout — text padding"
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 10)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 24)",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 6)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 16)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Legacy (hidden — do not edit)"
    },
    {
      "type": "paragraph",
      "content": "Preserves stored values on Theme Editor save."
    }
  ],
  "presets": [
    {
      "name": "Sale banner"
    }
  ]
}
{% endschema %}
