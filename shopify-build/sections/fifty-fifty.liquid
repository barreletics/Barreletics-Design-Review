{% comment %}
  Reusable 50/50 Split Section (Video/Image + Copy)
  Headings: .h2-display (brand) or .h2-standard (wayfinding) — Type OS
  Layout / type overrides: Theme Editor → CSS variables (Default = Type OS)
  Font family is brand Type OS — size/weight only; no font_picker.
{% endcomment %}
{% liquid
  assign heading_register = section.settings.heading_register | default: 'display'
  if heading_register == 'display'
    assign heading_class = 'h2-display'
  else
    assign heading_class = 'h2-standard'
  endif

  assign heading_level = section.settings.heading_level | default: 'h2'
  if heading_level != 'h1' and heading_level != 'h2' and heading_level != 'h3' and heading_level != 'h4' and heading_level != 'h5' and heading_level != 'h6'
    assign heading_level = 'h2'
  endif

  assign media_fit = section.settings.media_fit | default: 'cover'
  assign media_aspect = section.settings.media_aspect | default: 'stretch'

  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_href = cta_target
  else
    assign cta_href = section.settings.cta_url
  endif

  assign media_pct = section.settings.media_column_pct | default: 50
  assign text_pct = 100 | minus: media_pct

  assign min_height = section.settings.min_height | default: 640
  assign mobile_media_height = section.settings.mobile_media_height | default: 320
  assign image_position = section.settings.image_position | default: 'center'
  if image_position == 'custom'
    assign focal_x = section.settings.focal_x | default: 50
    assign focal_y = section.settings.focal_y | default: 50
    assign image_position = focal_x | append: '% ' | append: focal_y | append: '%'
  endif
  assign image_scale = section.settings.image_scale | default: 100
  assign contain_width = section.settings.contain_width | default: 72
  assign media_radius = section.settings.media_radius | default: 0
  assign column_gap = section.settings.column_gap | default: 0
  assign side_padding = section.settings.side_padding | default: 64
  assign vertical_padding = section.settings.vertical_padding | default: 88
  assign section_gap = section.settings.section_gap | default: 32
  assign section_gap_m = section.settings.section_gap_mobile | default: 24

  assign image_scale_ratio = image_scale | times: 1.0 | divided_by: 100.0

  assign title_size = section.settings.title_size | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign body_weight = section.settings.body_weight | default: 'default'
  assign cta_size = section.settings.cta_size | default: 'default'
  assign cta_style = section.settings.cta_style | default: 'solid'
  assign cta_bg = section.settings.cta_bg_color | default: '#c45c3f'
  assign cta_text_color = section.settings.cta_text_color | default: '#ffffff'
  assign cta_border = section.settings.cta_border_color | default: cta_bg

  assign region_label = section.settings.aria_label | strip
  if region_label == blank
    assign region_label = section.settings.title | strip_html | truncate: 60
  endif

  assign content_style = section.settings.content_style | default: 'standard'
  assign quote_italic = section.settings.quote_italic
  if quote_italic == nil
    assign quote_italic = true
  endif
  assign quote_star_color = section.settings.quote_star_color | default: '#d4af37'
  assign show_trust_strip = section.settings.show_trust_strip
  assign show_trust_stars = false
  if show_trust_strip
    assign show_trust_stars = true
  elsif content_style == 'quote' and section.settings.show_quote_stars != false
    assign show_trust_stars = true
  endif
  assign trust_text = section.settings.trust_text | strip
  assign show_trust_label = false
  if show_trust_strip and trust_text != blank
    assign show_trust_label = true
  endif
  assign quote_author_case = section.settings.quote_author_case | default: 'uppercase'
  assign stat_bar_color = section.settings.stat_bar_color | default: '#c45c3f'
%}
{% if content_style == 'quote' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
{% endif %}

<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} split-section{% if section.settings.reverse %} split-section--reverse{% endif %}{% if media_fit == 'contain' %} split-section--contain{% endif %}{% if media_fit == 'fit' %} split-section--fit{% endif %}{% if media_aspect == 'square' %} split-section--media-square{% endif %}{% render 'split-mobile-stack-class', mobile_stack_order: section.settings.mobile_stack_order %}"
  style="{% render 'section-inset-vars' %} 
    --ff-min-height: {{ min_height }}px;
    --ff-mobile-media-height: {{ mobile_media_height }}px;
    --ff-media-fr: {{ media_pct }}fr;
    --ff-text-fr: {{ text_pct }}fr;
    --ff-object-position: {{ image_position }};
    --ff-image-scale: {{ image_scale_ratio }};
    --ff-contain-width: {{ contain_width }}%;
    --ff-media-radius: {{ media_radius }}px;
    --ff-text-radius: {{ media_radius }}px;
    --ff-panel-bg: {{ section.settings.bg_color | default: '#fff' }};
    --ff-column-gap: {{ column_gap }}px;
    --ff-side-padding: {{ side_padding }}px;
    --ff-vertical-padding: {{ vertical_padding }}px;
    --ff-section-gap: {{ section_gap }}px;
    --ff-section-gap-m: {{ section_gap_m }}px;
    --ff-cta-bg: {{ cta_bg }};
    --ff-cta-border: {{ cta_border }};
    --ff-cta-text: {{ cta_text_color }};
    --ff-quote-star: {{ quote_star_color }};
    --ff-quote-style: {% if quote_italic %}italic{% else %}normal{% endif %};
    --ff-stat-bar: {{ stat_bar_color }};
    {% if title_size != 'default' %}--ff-title-size: {{ title_size }}px;{% endif %}
    {% if body_size != 'default' %}--ff-body-size: {{ body_size }}px;{% endif %}
    {% if title_weight != 'default' %}--ff-title-weight: {{ title_weight }};{% endif %}
    {% if body_weight != 'default' %}--ff-body-weight: {{ body_weight }};{% endif %}
    {% if cta_size != 'default' and cta_size != blank %}--ff-cta-size: {{ cta_size }}px;{% endif %}
  "
  {% if region_label != blank %}aria-label="{{ region_label | escape }}"{% endif %}
>
  <div class="split-media"{% if media_fit == 'contain' %} style="background: {{ section.settings.media_bg | default: '#f9f9f9' }};"{% endif %}>
    <div class="split-media__clip">
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          image_size: '1200x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'split-media__video'
      }}
    {% elsif section.settings.video_url != blank %}
      <video
        class="split-media__video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 1200 }}"
        {% elsif section.settings.poster_url != blank %}
          poster="{{ section.settings.poster_url | escape }}"
        {% endif %}
      >
        <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
      </video>
    {% elsif section.settings.image != blank %}
      <img
        class="split-media__img"
        src="{{ section.settings.image | image_url: width: 1200 }}"
        srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                {{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1200 }} 1200w"
        sizes="(max-width: 768px) 100vw, 50vw"
        alt="{{ section.settings.image_alt | escape }}"
        loading="lazy"
      >
    {% elsif section.settings.image_asset != blank %}
      <img
        class="split-media__img"
        src="{{ section.settings.image_asset | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="lazy"
      >
    {% elsif section.settings.image_url != blank %}
      <img
        class="split-media__img"
        src="{{ section.settings.image_url | escape }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="lazy"
      >
    {% else %}
      <div class="split-media__placeholder">
        {{ section.settings.image_alt | default: 'Media placeholder' }}
      </div>
    {% endif %}
    </div>
  </div>

  {% capture split_trust %}
    {% if show_trust_stars %}
      <div class="split-trust{% if show_trust_label %} split-trust--with-text{% endif %}">
        <span class="split-trust__stars" aria-hidden="true">★★★★★</span>
        {% if show_trust_label %}
          <span class="split-trust__text">{{ trust_text | escape }}</span>
        {% endif %}
      </div>
    {% endif %}
  {% endcapture %}
  <div class="split-text align-editorial{% if content_style == 'quote' %} split-text--quote{% endif %}{% if content_style == 'stats' %} split-text--stats{% endif %}{% if content_style == 'statement' %} split-text--statement{% endif %}" style="background: {{ section.settings.bg_color | default: '#fff' }};">
    {% if content_style == 'quote' %}
      {% if section.settings.eyebrow != blank %}
        <h2 class="split-text__title {{ heading_class }}" style="margin:0 0 20px;">{{ section.settings.eyebrow }}</h2>
      {% endif %}
      {{ split_trust }}
      {% if section.settings.title != blank %}
        <p class="split-quote__text">“{{ section.settings.title | strip | remove: '"' | remove: '“' | remove: '”' }}”</p>
      {% endif %}
      {% if section.settings.quote_author != blank %}
        <p class="split-quote__author{% if quote_author_case == 'sentence' %} split-quote__author--sentence{% endif %}">{{ section.settings.quote_author }}</p>
      {% elsif section.settings.body != blank %}
        <p class="split-quote__author{% if quote_author_case == 'sentence' %} split-quote__author--sentence{% endif %}">{{ section.settings.body }}</p>
      {% endif %}
      {% if section.settings.quote_meta != blank %}
        <p class="split-quote__meta">{{ section.settings.quote_meta }}</p>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a
          href="{{ cta_href | default: '#reviews' }}"
          class="btn split-cta split-cta--after-stack{% if cta_style == 'outline' %} split-cta--outline{% else %} btn--primary{% endif %}"
        >{{ section.settings.cta_text }}</a>
      {% endif %}
    {% elsif content_style == 'stats' %}
      {% if section.settings.eyebrow != blank %}
        <p class="split-text__eyebrow type-label">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {{ split_trust }}
      <div class="split-stats">
        {% assign has_stat_blocks = false %}
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            {% assign has_stat_blocks = true %}
            <div class="split-stat" {{ block.shopify_attributes }}>
              <p class="split-stat__value{% if block.settings.emphasis %} split-stat__value--line{% endif %}">{{ block.settings.value }}</p>
              {% if block.settings.label != blank %}
                <p class="split-stat__label">{{ block.settings.label }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
        {% unless has_stat_blocks %}
          {% if section.settings.stat_1_value != blank %}
            <div class="split-stat">
              <p class="split-stat__value">{{ section.settings.stat_1_value }}</p>
              {% if section.settings.stat_1_label != blank %}<p class="split-stat__label">{{ section.settings.stat_1_label }}</p>{% endif %}
            </div>
          {% endif %}
          {% if section.settings.stat_2_value != blank %}
            <div class="split-stat">
              <p class="split-stat__value">{{ section.settings.stat_2_value }}</p>
              {% if section.settings.stat_2_label != blank %}<p class="split-stat__label">{{ section.settings.stat_2_label }}</p>{% endif %}
            </div>
          {% endif %}
          {% if section.settings.stat_3_value != blank %}
            <div class="split-stat">
              <p class="split-stat__value{% if section.settings.stat_3_emphasis %} split-stat__value--line{% endif %}">{{ section.settings.stat_3_value }}</p>
              {% if section.settings.stat_3_label != blank %}<p class="split-stat__label">{{ section.settings.stat_3_label }}</p>{% endif %}
            </div>
          {% endif %}
        {% endunless %}
      </div>
      {% if section.settings.cta_text != blank %}
        <a
          href="{{ cta_href | default: routes.all_products_collection_url }}"
          class="btn split-cta split-cta--after-stack{% if cta_style == 'outline' %} split-cta--outline{% else %} btn--primary{% endif %}"
        >{{ section.settings.cta_text }}</a>
      {% endif %}
    {% else %}
      {% comment %}standard + statement — heading + quiet body; statement uses Type OS expression sizing{% endcomment %}
      {% if section.settings.eyebrow != blank %}
        <p class="split-text__eyebrow type-label{% unless content_style == 'statement' %} eyebrow--accent{% endunless %}">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {{ split_trust }}
      {% if section.settings.title != blank %}
        {% liquid
          if content_style == 'statement'
            assign title_class = 'split-text__title type-statement'
          else
            assign title_class = 'split-text__title ' | append: heading_class
          endif
        %}
        {% case heading_level %}
          {% when 'h1' %}
            <h1 class="{{ title_class }}">{{ section.settings.title | newline_to_br }}</h1>
          {% when 'h3' %}
            <h3 class="{{ title_class }}">{{ section.settings.title | newline_to_br }}</h3>
          {% when 'h4' %}
            <h4 class="{{ title_class }}">{{ section.settings.title | newline_to_br }}</h4>
          {% when 'h5' %}
            <h5 class="{{ title_class }}">{{ section.settings.title | newline_to_br }}</h5>
          {% when 'h6' %}
            <h6 class="{{ title_class }}">{{ section.settings.title | newline_to_br }}</h6>
          {% else %}
            <h2 class="{{ title_class }}">{{ section.settings.title | newline_to_br }}</h2>
        {% endcase %}
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="split-text__body type-body{% if content_style == 'statement' %} split-text__body--quiet{% endif %}">{{ section.settings.body }}</p>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a
          href="{{ cta_href | default: routes.all_products_collection_url }}"
          class="btn split-cta{% if cta_style == 'outline' %} split-cta--outline{% else %} btn--primary{% endif %}"
        >{{ section.settings.cta_text }}</a>
      {% endif %}
    {% endif %}
  </div>
</section>

<style>
  /* Section rhythm (fix-forward 2026-08-09): band lives on the Shopify
     section WRAPPER so neighbouring fifty-fifties never weld — without
     insetting the media column. Prior padding-block on .split-section left
     64px empty bands above/below the image inside the section frame. */
  #shopify-section-{{ section.id }} {
    padding-block: var(--ff-section-gap, var(--section-padding-y, 32px));
    box-sizing: border-box;
    background: {{ section.settings.bg_color | default: '#ffffff' }};
  }
  /* Visible air you named: hero → mosaic tiles = 16 (mosaic pad). Cream, not white. */
  #shopify-section-{{ section.id }}:has(#never-loses-grip) {
    padding-bottom: 16px;
  }
  #shopify-section-{{ section.id }}:has(#never-loses-grip) + .shopify-section .section-frame {
    margin-top: 0 !important;
  }
  #shopify-section-{{ section.id }} .split-section {
    display: grid;
    grid-template-columns: var(--ff-media-fr, 1fr) var(--ff-text-fr, 1fr);
    gap: var(--ff-column-gap, 0);
    align-items: stretch;
    min-height: var(--ff-min-height, 640px);
    padding-block: 0;
    box-sizing: border-box;
    overflow: hidden;
    border-radius: var(--ff-media-radius, 0);
  }
  #shopify-section-{{ section.id }} .split-section--reverse {
    grid-template-columns: var(--ff-text-fr, 1fr) var(--ff-media-fr, 1fr);
  }
  #shopify-section-{{ section.id }} .split-section--reverse .split-media { order: 2; }
  #shopify-section-{{ section.id }} .split-section--reverse .split-text { order: 1; }
  #shopify-section-{{ section.id }} .split-media {
    position: relative;
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    contain: paint;
    align-self: stretch;
    height: 100%;
    min-height: var(--ff-min-height, 640px);
    border-radius: var(--ff-media-radius, 0);
    clip-path: inset(0 round var(--ff-media-radius, 0px));
    -webkit-clip-path: inset(0 round var(--ff-media-radius, 0px));
  }
  #shopify-section-{{ section.id }} .split-media__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    contain: paint;
    border-radius: var(--ff-media-radius, 0);
    clip-path: inset(0 round var(--ff-media-radius, 0px));
    -webkit-clip-path: inset(0 round var(--ff-media-radius, 0px));
  }
  /* Square media column — packshots fill the frame under cover without
     landscape toe-clip. Section grows with the column width (≥ min_height). */
  #shopify-section-{{ section.id }} .split-section--media-square .split-media {
    aspect-ratio: 1 / 1;
    width: 100%;
    height: auto;
    min-height: var(--ff-min-height, 640px);
  }
  /* Round media only on the outer edge (away from the text column) */
  #shopify-section-{{ section.id }} .split-section--media-outer-radius .split-media {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }
  #shopify-section-{{ section.id }} .split-section--media-outer-radius.split-section--reverse .split-media {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: var(--ff-media-radius, 0);
    border-bottom-right-radius: var(--ff-media-radius, 0);
  }
  #shopify-section-{{ section.id }} .split-media__img,
  #shopify-section-{{ section.id }} .split-media__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--ff-object-position, center);
    display: block;
    position: absolute;
    inset: 0;
    transform: scale(var(--ff-image-scale, 1));
    transform-origin: var(--ff-object-position, center);
  }
  /* Full-bleed media law (Andrew 2026-08-08): Cover mode only. Fit and
     packshot-contain are excluded — :not(contain) was winning over Fit
     and forcing object-fit: cover (2026-08-17). */
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media {
    padding: 0;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media__img,
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media__video {
    padding: 0;
    margin: 0;
    max-width: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--ff-object-position, center);
  }
  #shopify-section-{{ section.id }} .split-section--contain .split-media {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .split-section--contain .split-media__img {
    position: relative;
    inset: auto;
    width: var(--ff-contain-width, 72%);
    max-width: 420px;
    height: auto;
    object-fit: contain;
    object-position: var(--ff-object-position, center);
    padding: 48px 24px;
    transform: scale(var(--ff-image-scale, 1));
    transform-origin: center center;
  }
  /* Fit = natural photo (Andrew 2026-08-17). Column width owns the
     image. Height follows the file. No 560 crop. No letterbox. */
  #shopify-section-{{ section.id }} .split-section.split-section--fit {
    min-height: 0;
  }
  #shopify-section-{{ section.id }} .split-section.split-section--fit .split-media {
    padding: 0;
    margin: 0;
    height: auto;
    min-height: 0;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .split-section.split-section--fit .split-media__clip,
  #shopify-section-{{ section.id }} .split-section--contain .split-media__clip {
    position: relative;
    inset: auto;
    height: auto;
    min-height: inherit;
  }
  #shopify-section-{{ section.id }} .split-section.split-section--fit .split-media__img,
  #shopify-section-{{ section.id }} .split-section.split-section--fit .split-media__video {
    position: relative;
    inset: auto;
    width: 100%;
    height: auto;
    max-width: none;
    padding: 0;
    margin: 0;
    object-fit: unset;
    transform: none;
    display: block;
  }
  #shopify-section-{{ section.id }} .split-media__placeholder {
    width: 100%;
    height: 100%;
    min-height: var(--ff-min-height, 640px);
    background: linear-gradient(135deg, #c9c5b8, #e9d3cb);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: var(--text-muted, #8a8a8a);
    padding: var(--space-8, 32px);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .split-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: var(--ff-vertical-padding, 88px) var(--ff-side-padding, 64px);
    background: var(--ff-panel-bg, {{ section.settings.bg_color | default: '#fff' }});
    overflow: hidden;
    border-radius: var(--ff-text-radius, 0);
    clip-path: inset(0 round var(--ff-text-radius, 0px));
    -webkit-clip-path: inset(0 round var(--ff-text-radius, 0px));
    text-align: var(--align-editorial, left);
  }
  #shopify-section-{{ section.id }} .split-text__title {
    font-family: var(--font-family, 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif);
    max-width: none !important;
    margin: 0 0 var(--gap-b, 20px);
    text-transform: none;
  }
  /* Type OS — H2 Display / Standard (SETTLED tokens; TE size override optional) */
  #shopify-section-{{ section.id }} .split-text__title.h2-display {
    font-size: var(--ff-title-size, var(--type-h2-display-size));
    font-weight: var(--ff-title-weight, var(--type-h2-display-weight));
    line-height: var(--type-h2-display-leading);
    letter-spacing: var(--type-h2-display-tracking);
  }
  #shopify-section-{{ section.id }} .split-text__title.h2-standard {
    font-size: var(--ff-title-size, var(--type-section-size));
    font-weight: var(--ff-title-weight, var(--type-section-weight));
    line-height: var(--type-section-leading);
    letter-spacing: var(--type-section-tracking);
  }
  #shopify-section-{{ section.id }} .split-text__title.type-statement {
    font-size: var(--ff-title-size, var(--type-statement-size));
    font-weight: var(--ff-title-weight, var(--type-statement-weight));
    line-height: var(--type-statement-leading);
    letter-spacing: var(--type-statement-tracking);
    max-width: 18ch;
  }
  #shopify-section-{{ section.id }} .split-text__body--quiet {
    color: #6b645a;
    font-size: var(--ff-body-size, 16px);
    max-width: 32ch;
  }
  #shopify-section-{{ section.id }} .split-text__eyebrow {
    font-size: var(--type-label-size, 11px);
    text-transform: uppercase;
    letter-spacing: var(--type-label-tracking, 0.08em);
    color: var(--type-label-color, #6b645a);
    font-weight: var(--type-label-weight, 600);
    margin: 0 0 var(--gap-a, 16px);
  }
  #shopify-section-{{ section.id }} .split-text__title.h2-display,
  #shopify-section-{{ section.id }} .split-text__title.h2-standard {
    margin: 0 0 var(--gap-b, 20px);
  }
  #shopify-section-{{ section.id }} .split-text__body {
    font-family: var(--font-family, 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: var(--ff-body-size, var(--type-body-size, 17px));
    font-weight: var(--ff-body-weight, var(--type-body-weight, 400));
    color: var(--text-body, #4a4a4a);
    line-height: var(--type-body-leading, 1.6);
    margin: 0 0 var(--gap-c, 32px);
    max-width: 36ch;
  }
  #shopify-section-{{ section.id }} .split-cta {
    width: fit-content;
    font-size: var(--ff-cta-size, var(--type-cta-size));
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking, 0.12em);
    line-height: var(--type-cta-leading, 1);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ff-cta-bg, #c45c3f);
    border: 1px solid var(--ff-cta-border, var(--ff-cta-bg, #c45c3f));
    color: var(--ff-cta-text, #fff);
    transition: opacity 0.15s ease;
  }
  #shopify-section-{{ section.id }} .split-cta--outline {
    background: transparent;
    color: var(--ff-cta-text, var(--ff-cta-border, #c45c3f));
  }
  #shopify-section-{{ section.id }} .split-cta:hover {
    opacity: 0.92;
  }
  #shopify-section-{{ section.id }} .split-cta--outline:hover {
    opacity: 0.85;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-block: var(--ff-section-gap-m, var(--section-padding-y-mobile, 24px));
    }
    #shopify-section-{{ section.id }} .split-section {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: 0;
    }
    #shopify-section-{{ section.id }} .split-section--reverse .split-media,
    #shopify-section-{{ section.id }} .split-section--reverse .split-text { order: 0; }
    #shopify-section-{{ section.id }} .split-media,
    #shopify-section-{{ section.id }} .split-section--media-square .split-media {
      aspect-ratio: auto;
      width: 100%;
      height: var(--ff-mobile-media-height, 320px);
      min-height: var(--ff-mobile-media-height, 320px);
    }
    #shopify-section-{{ section.id }} .split-section.split-section--fit .split-media {
      height: auto;
      min-height: 0;
    }
    #shopify-section-{{ section.id }} .split-section--media-outer-radius .split-media,
    #shopify-section-{{ section.id }} .split-section--media-outer-radius.split-section--reverse .split-media {
      border-radius: var(--ff-media-radius, 0);
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }
    #shopify-section-{{ section.id }} .split-text {
      padding:
        min(var(--ff-vertical-padding, 88px), var(--section-padding-y-mobile, 48px))
        min(var(--ff-side-padding, 64px), var(--section-padding-x-mobile, 16px));
    }
  }

  /* Quote composition — Cormorant ~28px default; Title size/weight scale quote */
  #shopify-section-{{ section.id }} .split-trust {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .split-trust__stars,
  #shopify-section-{{ section.id }} .split-quote__stars {
    color: var(--ff-quote-star, #d4af37);
    font-size: 15px;
    letter-spacing: 0.22em;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .split-trust__text {
    font-size: 13px;
    font-weight: 400;
    color: #4a4a4a;
    letter-spacing: 0;
  }
  #shopify-section-{{ section.id }} .split-quote__text {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-size: var(--ff-title-size, 28px);
    font-style: var(--ff-quote-style, italic);
    font-weight: var(--ff-title-weight, 400);
    color: #1c1916;
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
    max-width: 34ch;
  }
  #shopify-section-{{ section.id }} .split-quote__author {
    font-family: var(--font-family, 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 12px;
    font-weight: 600;
    color: #1c1916;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 8px;
    line-height: 1.35;
  }
  #shopify-section-{{ section.id }} .split-quote__author--sentence {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  #shopify-section-{{ section.id }} .split-quote__meta {
    font-family: var(--font-family, 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 14px;
    font-weight: 400;
    color: #6b645a;
    letter-spacing: 0.01em;
    line-height: 1.5;
    margin: 0;
    max-width: 36ch;
  }
  #shopify-section-{{ section.id }} .split-text--quote .split-quote__author:last-child,
  #shopify-section-{{ section.id }} .split-text--quote .split-quote__meta:last-of-type {
    margin-bottom: 0;
  }
  #shopify-section-{{ section.id }} .split-cta--after-stack {
    margin-top: 32px;
  }

  /* Stats composition — rust bar color TE; prefer Stat blocks */
  #shopify-section-{{ section.id }} .split-text--stats .split-text__eyebrow {
    margin: 0 0 32px;
    color: #6b645a;
  }
  #shopify-section-{{ section.id }} .split-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    margin-bottom: 0;
  }
  #shopify-section-{{ section.id }} .split-stat {
    border-left: 3px solid var(--ff-stat-bar, #c45c3f);
    padding-left: 20px;
  }
  #shopify-section-{{ section.id }} .split-stat__value {
    font-size: 32px;
    font-weight: 700;
    color: #1c1916;
    margin: 0;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .split-stat__value--line {
    font-size: 22px;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .split-stat__label {
    font-size: 14px;
    color: #4a4a4a;
    margin: 6px 0 0;
    line-height: 1.4;
  }
