{% comment %}
  Reusable 50/50 Split Section (Video/Image + Copy)
  Headings: .h2-display (brand) or .h2-standard (wayfinding) — Type OS
  Layout / type overrides: Theme Editor → CSS variables (Default = Type OS)
  Font family is brand Type OS — size/weight only; no font_picker.
  GLOBAL HEADING SYSTEM (2026-09-27): heading is locked to clamp(36px, 4.8vw, 56px) / 400 /
  1.06 / -0.032em (phone 36), body 17 / 1.70. title_size, title_weight, heading_register and
  content_style "statement" no longer change the heading. Quote style (quote text) unchanged.
{% endcomment %}
{% liquid
  # Global heading system 2026-09-27: heading_register is ignored; one heading class for every instance.
  assign heading_class = 'h2-display'

  assign heading_level = section.settings.heading_level | default: 'h2'
  if heading_level != 'h1' and heading_level != 'h2' and heading_level != 'h3' and heading_level != 'h4' and heading_level != 'h5' and heading_level != 'h6'
    assign heading_level = 'h2'
  endif

  assign media_fit = section.settings.media_fit | default: 'cover'
  assign image_fit_m = section.settings.image_fit_mobile | default: 'cover'
  assign media_aspect = section.settings.media_aspect | default: 'stretch'
  assign media_aspect_m = section.settings.media_aspect_mobile | default: 'stretch'

  # Text panel bg: bg_style (new) with full legacy bg_preset / bg_color fallback (zero-change migration).
  assign bg_style = section.settings.bg_style
  if bg_style == 'white'
    assign panel_bg = '#ffffff'
  elsif bg_style == 'cream'
    assign panel_bg = '#faf8f6'
  elsif bg_style == 'darker_cream'
    assign panel_bg = '#efe9dd'
  else
    assign bg_preset = section.settings.bg_preset | default: ''
    if bg_preset == 'white'
      assign panel_bg = '#ffffff'
    elsif bg_preset == 'cream'
      assign panel_bg = '#faf8f6'
    elsif bg_preset == 'custom'
      assign panel_bg = section.settings.bg_color | default: '#ffffff'
    else
      assign legacy_bg = section.settings.bg_color | default: ''
      if legacy_bg == '#faf8f6' or legacy_bg == '#FAF8F6'
        assign panel_bg = '#faf8f6'
      elsif legacy_bg == '#efe9dd' or legacy_bg == '#EFE9DD'
        assign panel_bg = '#efe9dd'
      elsif legacy_bg != blank
        assign panel_bg = legacy_bg
      else
        assign panel_bg = '#ffffff'
      endif
    endif
  endif

  assign media_pad_bg = section.settings.media_bg | default: '#ffffff'
  if media_pad_bg == blank
    assign media_bg_preset = section.settings.media_bg_preset
    if media_bg_preset == 'cream'
      assign media_pad_bg = '#faf8f6'
    elsif media_bg_preset == 'white'
      assign media_pad_bg = '#ffffff'
    else
      assign media_pad_bg = '#ffffff'
    endif
  endif

  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_href = cta_target
  else
    assign cta_href = section.settings.cta_url
  endif

  assign media_pct = section.settings.media_column_pct | default: 50
  assign text_pct = 100 | minus: media_pct

  assign min_height = section.settings.min_height | default: 560
  # Phone media height: global Theme settings > Split images > Phone split-image height (--split-media-h-mobile, default 500).
  # Section setting mobile_media_height is an optional override; 0 or blank = use global (2026-09-29).
  assign mobile_media_height = section.settings.mobile_media_height | default: 0
  if mobile_media_height > 0
    assign ff_mobile_media_h_css = mobile_media_height | append: 'px'
  else
    assign ff_mobile_media_h_css = 'var(--split-media-h-mobile, 500px)'
  endif
  assign mobile_text_height = section.settings.mobile_text_height | default: 0
  if template.name == 'product'
    assign mobile_text_height = 0
  endif
  assign mobile_media_width = section.settings.mobile_media_width | default: 100

  assign image_position_key = section.settings.image_position | default: 'center'
  assign image_position = image_position_key
  if image_position_key == 'custom'
    assign focal_x = section.settings.focal_x | default: 50
    assign focal_y = section.settings.focal_y | default: 50
    assign image_position = focal_x | append: '% ' | append: focal_y | append: '%'
  endif

  assign image_position_m_key = section.settings.image_position_mobile | default: 'same'
  assign image_position_m = image_position
  assign ff_pos_fit_m = 'center top'
  if image_position_m_key == 'same' or image_position_m_key == blank
    if image_position_key != blank and image_position_key != 'center'
      if image_position_key != 'custom' or image_position != '50% 50%'
        assign ff_pos_fit_m = image_position
      endif
    endif
  elsif image_position_m_key == 'custom'
    assign focal_x_m = section.settings.focal_x_mobile | default: 50
    assign focal_y_m = section.settings.focal_y_mobile | default: 50
    assign image_position_m = focal_x_m | append: '% ' | append: focal_y_m | append: '%'
    assign ff_pos_fit_m = image_position_m
  else
    assign image_position_m = image_position_m_key
    assign ff_pos_fit_m = image_position_m_key
  endif

  assign image_scale = section.settings.image_scale | default: 100
  assign contain_width = section.settings.contain_width | default: 72
  assign media_radius = section.settings.media_radius | default: 0
  assign side_padding = section.settings.side_padding
  if side_padding == blank
    assign side_padding = 64
  endif
  assign text_pad_y_d = section.settings.text_pad_y
  if text_pad_y_d == blank
    assign text_pad_y_d = section.settings.text_pad_top
  endif
  if text_pad_y_d == blank
    assign text_pad_y_d = section.settings.text_pad_bottom
  endif
  if text_pad_y_d == blank
    assign text_pad_y_d = section.settings.vertical_padding
  endif
  if text_pad_y_d == blank
    assign text_pad_y_d = 96
  endif
  assign text_pad_top_d = text_pad_y_d
  assign text_pad_bottom_d = text_pad_y_d
  assign text_pad_y_m = section.settings.text_pad_y_mobile
  if text_pad_y_m == blank
    assign text_pad_y_m = section.settings.text_pad_top_mobile
  endif
  if text_pad_y_m == blank
    assign text_pad_y_m = section.settings.text_pad_bottom_mobile
  endif
  if text_pad_y_m == blank
    assign text_pad_y_m = 80
  endif
  assign text_pad_m = text_pad_y_m
  assign text_pad_bottom_m = text_pad_y_m
  assign text_pad_x_m = section.settings.text_pad_x_mobile
  if text_pad_x_m == blank
    assign text_pad_x_m = 20
  endif
  assign section_gap = 32
  if section.settings.section_gap == 0 or section.settings.section_gap != blank
    assign section_gap = section.settings.section_gap
  endif
  assign section_gap_m = 0
  if section.settings.section_gap_mobile == 0 or section.settings.section_gap_mobile != blank
    assign section_gap_m = section.settings.section_gap_mobile
  endif
  if template.name == 'product'
    assign section_gap_m = 0
  endif
  assign image_scale_ratio = image_scale | times: 1.0 | divided_by: 100.0

  assign title_size = section.settings.title_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: '400'
  assign body_weight = section.settings.body_weight | default: 'default'
  assign cta_style = section.settings.cta_style | default: 'rust_solid'
  case cta_style
    when 'rust_outline', 'outline'
      assign cta_btn_class = 'btn--brand-outline'
    when 'black_solid', 'primary'
      assign cta_btn_class = 'btn--primary'
    when 'black_outline', 'secondary'
      assign cta_btn_class = 'btn--secondary'
    else
      assign cta_btn_class = 'btn--brand'
  endcase

  assign region_label = section.settings.aria_label | strip
  if region_label == blank
    assign region_label = section.settings.title | replace: '[[em]]', '' | replace: '[[/em]]', '' | strip_html | strip | truncate: 60
  endif
  if region_label == blank
    assign region_label = '50/50 section'
  endif

  assign content_style = section.settings.content_style | default: 'standard'
  assign quote_italic = section.settings.quote_italic
  if quote_italic == nil
    assign quote_italic = true
  endif
  assign quote_star_color = '#d4af37'
  assign show_trust_strip = section.settings.show_trust_strip
  assign show_trust_stars = false
  if show_trust_strip
    assign show_trust_stars = true
  elsif content_style == 'quote' and section.settings.show_quote_stars != false
    assign show_trust_stars = true
  endif
  assign trust_text = section.settings.trust_text | strip
  assign show_trust_label = false
  if show_trust_strip and trust_text != blank
    assign show_trust_label = true
  endif
  assign quote_author_case = section.settings.quote_author_case | default: 'uppercase'
  assign stat_bar_color = '#c45c3f'
%}
{% if content_style == 'quote' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
{% endif %}

<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} split-section{% if template.name == 'product' %} split-section--pdp{% endif %}{% if section.settings.reverse %} split-section--reverse{% endif %}{% if media_fit == 'contain' %} split-section--contain{% endif %}{% if media_fit == 'fit' %} split-section--fit{% endif %}{% if media_fit == 'cover_inset' %} split-section--cover-inset{% endif %}{% if image_fit_m == 'fit' %} split-section--fit-m{% endif %}{% if image_fit_m == 'contain' %} split-section--contain-m{% endif %}{% if media_aspect == 'square' %} split-section--media-square{% endif %}{% if media_aspect_m == 'square' %} split-section--media-square-m{% endif %}{% render 'split-mobile-stack-class', mobile_stack_order: section.settings.mobile_stack_order %}"
  style="{% render 'section-inset-vars' %} 
    --ff-min-height: {{ min_height }}px;
    --ff-mobile-media-height: {{ ff_mobile_media_h_css }};
    --ff-mobile-text-height: {{ mobile_text_height }}px;
    --ff-media-fr: {{ media_pct }}fr;
    --ff-text-fr: {{ text_pct }}fr;
    --ff-object-position: {{ image_position }};
    --ff-object-position-m: {{ image_position_m }};
    --ff-object-position-fit-m: {{ ff_pos_fit_m }};
    --ff-mobile-media-width: {{ mobile_media_width }}%;
    --ff-image-scale: {{ image_scale_ratio }};
    --ff-contain-width: {{ contain_width }}%;
    --ff-media-radius: {{ media_radius }}px;
    --ff-text-radius: {{ media_radius }}px;
    --ff-panel-bg: {{ panel_bg }};
    --ff-media-pad-bg: {{ media_pad_bg }};
    --ff-side-padding: {{ side_padding }}px;
    --ff-text-pad-top-d: {{ text_pad_top_d }}px;
    --ff-text-pad-bottom-d: {{ text_pad_bottom_d }}px;
    --ff-section-gap: {{ section_gap }}px;
    --ff-section-gap-m: {{ section_gap_m }}px;
    --ff-text-pad-top-m: {{ text_pad_m }}px;
    --ff-text-pad-bottom-m: {{ text_pad_bottom_m }}px;
    --ff-text-pad-x-m: {{ text_pad_x_m }}px;
    --ff-quote-star: {{ quote_star_color }};
    --ff-quote-style: {% if quote_italic %}italic{% else %}normal{% endif %};
    --ff-stat-bar: {{ stat_bar_color }};
    {% if title_size != 'default' %}--ff-title-size: {{ title_size }}px;{% endif %}
    {% if title_weight != 'default' %}--ff-title-weight: {{ title_weight }};{% endif %}
    {% if body_weight != 'default' %}--ff-body-weight: {{ body_weight }};{% endif %}
  "
  role="region"
  aria-label="{{ region_label | escape }}"
>
  <div class="split-media" style="background: {{ media_pad_bg }};">
    <div class="split-media__clip">
    {%- comment -%} Phone image (optional): replaces the still image at max-width 768px via <picture>; desktop keeps the main image. {%- endcomment -%}
    {%- assign ff_pic = false -%}
    {%- if section.settings.image_mobile != blank and section.settings.video == blank and section.settings.video_url == blank -%}{%- assign ff_pic = true -%}
    <picture style="display:contents">
      <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 780 }} 780w, {{ section.settings.image_mobile | image_url: width: 1170 }} 1170w" sizes="100vw" width="{{ section.settings.image_mobile.width }}" height="{{ section.settings.image_mobile.height }}">
    {%- endif -%}
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          image_size: '1200x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          class: 'split-media__video'
      }}
    {% elsif section.settings.video_url != blank %}
      <video
        class="split-media__video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 1200 }}"
        {% elsif section.settings.poster_url != blank %}
          poster="{{ section.settings.poster_url | escape }}"
        {% endif %}
      >
        <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
      </video>
    {% elsif section.settings.image != blank %}
      {%- assign ff_alt = section.settings.image_alt -%}
      {% render 'media-img',
         image: section.settings.image,
         alt: ff_alt,
         class: 'split-media__img',
         widths: '600, 900, 1200',
         width_default: 1200,
         sizes: '(max-width: 768px) 100vw, 50vw',
         loading: 'lazy',
         position: 'css' %}
    {% elsif section.settings.image_asset != blank %}
      {%- assign ff_alt_a = section.settings.image_alt -%}
      {%- assign ff_src_a = section.settings.image_asset | asset_url -%}
      {% render 'media-img',
         url: ff_src_a,
         alt: ff_alt_a,
         class: 'split-media__img',
         loading: 'lazy',
         position: 'css' %}
    {% elsif section.settings.image_url != blank %}
      {%- assign ff_alt_u = section.settings.image_alt -%}
      {% render 'media-img',
         url: section.settings.image_url,
         alt: ff_alt_u,
         class: 'split-media__img',
         loading: 'lazy',
         position: 'css' %}
    {% else %}
      <div class="split-media__placeholder">
        {{ section.settings.image_alt | default: 'Media placeholder' }}
      </div>
    {% endif %}
    {%- if ff_pic %}</picture>{% endif %}
    </div>
  </div>

  {% capture split_trust %}
    {% if show_trust_stars %}
      <div class="split-trust{% if show_trust_label %} split-trust--with-text{% endif %}">
        <span class="split-trust__stars" aria-hidden="true">★★★★★</span>
        {% if show_trust_label %}
          <span class="split-trust__text">{{ trust_text | escape }}</span>
        {% endif %}
      </div>
    {% endif %}
  {% endcapture %}
  <div class="split-text align-editorial{% if content_style == 'quote' %} split-text--quote{% endif %}{% if content_style == 'stats' %} split-text--stats{% endif %}{% if content_style == 'statement' %} split-text--statement{% endif %}" style="background: {{ panel_bg }};">
    <div class="split-text__stack">
    {% if content_style == 'quote' %}
      {% if section.settings.eyebrow != blank %}
        {% assign quote_heading_class = 'split-text__title ' | append: heading_class %}
        {% case heading_level %}
          {% when 'h1' %}
            <h1 class="{{ quote_heading_class }}" style="margin:0 0 20px;">{{ section.settings.eyebrow }}</h1>
          {% when 'h3' %}
            <h3 class="{{ quote_heading_class }}" style="margin:0 0 20px;">{{ section.settings.eyebrow }}</h3>
          {% when 'h4' %}
            <h4 class="{{ quote_heading_class }}" style="margin:0 0 20px;">{{ section.settings.eyebrow }}</h4>
          {% when 'h5' %}
            <h5 class="{{ quote_heading_class }}" style="margin:0 0 20px;">{{ section.settings.eyebrow }}</h5>
          {% when 'h6' %}
            <h6 class="{{ quote_heading_class }}" style="margin:0 0 20px;">{{ section.settings.eyebrow }}</h6>
          {% else %}
            <h2 class="{{ quote_heading_class }}" style="margin:0 0 20px;">{{ section.settings.eyebrow }}</h2>
        {% endcase %}
      {% endif %}
      {%- if show_trust_stars -%}{{ split_trust }}{%- endif -%}
      {% if section.settings.title != blank %}
        <p class="split-quote__text">“{{ section.settings.title | strip | remove: '"' | remove: '“' | remove: '”' }}”</p>
      {% endif %}
      {% if section.settings.quote_author != blank %}
        <p class="split-quote__author{% if quote_author_case == 'sentence' %} split-quote__author--sentence{% endif %}">{{ section.settings.quote_author }}</p>
      {% elsif section.settings.body != blank %}
        <p class="split-quote__author{% if quote_author_case == 'sentence' %} split-quote__author--sentence{% endif %}">{{ section.settings.body }}</p>
      {% endif %}
      {% if section.settings.quote_meta != blank %}
        <p class="split-quote__meta">{{ section.settings.quote_meta }}</p>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a
          href="{{ cta_href | default: '#reviews' }}"
          class="btn {{ cta_btn_class }} split-cta split-cta--after-stack"
        >{{ section.settings.cta_text }}</a>
      {% endif %}
    {% elsif content_style == 'stats' %}
      {% if section.settings.eyebrow != blank %}
        <p class="split-text__eyebrow type-label">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {%- if show_trust_stars -%}{{ split_trust }}{%- endif -%}
      <div class="split-stats">
        {% assign has_stat_blocks = false %}
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            {% assign has_stat_blocks = true %}
            <div class="split-stat" {{ block.shopify_attributes }}>
              <p class="split-stat__value{% if block.settings.emphasis %} split-stat__value--line{% endif %}">{{ block.settings.value }}</p>
              {% if block.settings.label != blank %}
                <p class="split-stat__label">{{ block.settings.label }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
        {% unless has_stat_blocks %}
          {% if section.settings.stat_1_value != blank %}
            <div class="split-stat">
              <p class="split-stat__value">{{ section.settings.stat_1_value }}</p>
              {% if section.settings.stat_1_label != blank %}<p class="split-stat__label">{{ section.settings.stat_1_label }}</p>{% endif %}
            </div>
          {% endif %}
          {% if section.settings.stat_2_value != blank %}
            <div class="split-stat">
              <p class="split-stat__value">{{ section.settings.stat_2_value }}</p>
              {% if section.settings.stat_2_label != blank %}<p class="split-stat__label">{{ section.settings.stat_2_label }}</p>{% endif %}
            </div>
          {% endif %}
          {% if section.settings.stat_3_value != blank %}
            <div class="split-stat">
              <p class="split-stat__value{% if section.settings.stat_3_emphasis %} split-stat__value--line{% endif %}">{{ section.settings.stat_3_value }}</p>
              {% if section.settings.stat_3_label != blank %}<p class="split-stat__label">{{ section.settings.stat_3_label }}</p>{% endif %}
            </div>
          {% endif %}
        {% endunless %}
      </div>
      {% if section.settings.cta_text != blank %}
        <a
          href="{{ cta_href | default: routes.all_products_collection_url }}"
          class="btn {{ cta_btn_class }} split-cta split-cta--after-stack"
        >{{ section.settings.cta_text }}</a>
      {% endif %}
    {% else %}
      {% comment %}standard + statement — heading + quiet body; statement uses Type OS expression sizing{% endcomment %}
      {% if section.settings.eyebrow != blank %}
        <p class="split-text__eyebrow type-label{% unless content_style == 'statement' %} eyebrow--accent{% endunless %}">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {%- if show_trust_stars -%}{{ split_trust }}{%- endif -%}
      {% if section.settings.title != blank %}
        {% liquid
          # Global heading system 2026-09-27: "statement" no longer swaps the heading class.
          assign title_class = 'split-text__title ' | append: heading_class
        %}
        {% capture ff_title_html %}
          {%- if section.settings.title contains '[[em]]' -%}
            {%- assign ff_em_chunks = section.settings.title | split: '[[em]]' -%}
            {%- assign ff_em_rest = ff_em_chunks.last | split: '[[/em]]' -%}
            {{ ff_em_chunks.first | newline_to_br }}<em>{{ ff_em_rest.first | escape }}</em>{{ ff_em_rest.last | newline_to_br }}
          {%- else -%}
            {{ section.settings.title | newline_to_br }}
          {%- endif -%}
        {% endcapture %}
        {% case heading_level %}
          {% when 'h1' %}
            <h1 class="{{ title_class }}">{{ ff_title_html }}</h1>
          {% when 'h3' %}
            <h3 class="{{ title_class }}">{{ ff_title_html }}</h3>
          {% when 'h4' %}
            <h4 class="{{ title_class }}">{{ ff_title_html }}</h4>
          {% when 'h5' %}
            <h5 class="{{ title_class }}">{{ ff_title_html }}</h5>
          {% when 'h6' %}
            <h6 class="{{ title_class }}">{{ ff_title_html }}</h6>
          {% else %}
            <h2 class="{{ title_class }}">{{ ff_title_html }}</h2>
        {% endcase %}
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="split-text__body type-body{% if content_style == 'statement' %} split-text__body--quiet{% endif %}">{{ section.settings.body }}</p>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a
          href="{{ cta_href | default: routes.all_products_collection_url }}"
          class="btn {{ cta_btn_class }} split-cta"
        >{{ section.settings.cta_text }}</a>
      {% endif %}
    {% endif %}
    </div>
  </div>
</section>

<style>
  {%- if section.settings.heading_size_override != blank %}
  #shopify-section-{{ section.id }} { {% render 'type-override-vars', title_size: section.settings.heading_size_override %} --te-title-size-n: {{ section.settings.heading_size_override }}; }
  {%- endif %}
  /* Section rhythm (fix-forward 2026-08-09): band lives on the Shopify
     section WRAPPER so neighbouring fifty-fifties never weld — without
     insetting the media column. Prior padding-block on .split-section left
     64px empty bands above/below the image inside the section frame. */
  #shopify-section-{{ section.id }} {
    --ff-section-gap: {{ section_gap }}px;
    --ff-section-gap-m: {{ section_gap_m }}px;
    --ff-text-pad-top-d: {{ text_pad_top_d }}px;
    --ff-text-pad-bottom-d: {{ text_pad_bottom_d }}px;
    --ff-text-pad-top-m: {{ text_pad_m }}px;
    --ff-text-pad-bottom-m: {{ text_pad_bottom_m }}px;
    --ff-text-pad-x-m: {{ text_pad_x_m }}px;
    padding-block: var(--ff-section-gap, var(--section-padding-y, 32px));
    box-sizing: border-box;
    background: {{ panel_bg }};
  }
  /* Visible air you named: hero → mosaic tiles = 16 (mosaic pad). Cream, not white. */
  #shopify-section-{{ section.id }}:has(#never-loses-grip) {
    padding-bottom: 16px;
  }
  #shopify-section-{{ section.id }}:has(#never-loses-grip) + .shopify-section .section-frame {
    margin-top: 0 !important;
  }
  #shopify-section-{{ section.id }} .split-section {
    display: grid;
    grid-template-columns: var(--ff-media-fr, 1fr) var(--ff-text-fr, 1fr);
    gap: 0;
    align-items: stretch;
    min-height: var(--ff-min-height, 560px);
    padding-block: 0;
    box-sizing: border-box;
    overflow: hidden;
