{% comment %}
  Reusable 50/50 Split Section (Video/Image + Copy)
  Headings: .h2-display (brand) or .h2-standard (wayfinding) — Type OS
  Layout / type overrides: Theme Editor → CSS variables (Default = Type OS)
{% endcomment %}
{% liquid
  assign heading_register = section.settings.heading_register | default: 'display'
  if heading_register == 'display'
    assign heading_class = 'h2-display'
  else
    assign heading_class = 'h2-standard'
  endif
  assign media_fit = section.settings.media_fit | default: 'cover'
  assign cta_href = section.settings.cta_url

  assign media_pct = section.settings.media_column_pct | default: 50
  assign text_pct = 100 | minus: media_pct

  assign min_height = section.settings.min_height | default: 640
  assign mobile_media_height = section.settings.mobile_media_height | default: 320
  assign image_position = section.settings.image_position | default: 'center'
  assign image_scale = section.settings.image_scale | default: 100
  assign contain_width = section.settings.contain_width | default: 72
  assign media_radius = section.settings.media_radius | default: 0
  assign section_radius = section.settings.section_radius | default: 0

  assign image_scale_ratio = image_scale | times: 1.0 | divided_by: 100.0

  assign title_size = section.settings.title_size | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign body_weight = section.settings.body_weight | default: 'default'
%}

<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="split-section{% if section.settings.reverse %} split-section--reverse{% endif %}{% if media_fit == 'contain' %} split-section--contain{% endif %}"
  style="
    --ff-min-height: {{ min_height }}px;
    --ff-mobile-media-height: {{ mobile_media_height }}px;
    --ff-media-fr: {{ media_pct }}fr;
    --ff-text-fr: {{ text_pct }}fr;
    --ff-object-position: {{ image_position }};
    --ff-image-scale: {{ image_scale_ratio }};
    --ff-contain-width: {{ contain_width }}%;
    --ff-media-radius: {{ media_radius }}px;
    --ff-section-radius: {{ section_radius }}px;
    {% if title_size != 'default' %}--ff-title-size: {{ title_size }}px;{% endif %}
    {% if body_size != 'default' %}--ff-body-size: {{ body_size }}px;{% endif %}
    {% if title_weight != 'default' %}--ff-title-weight: {{ title_weight }};{% endif %}
    {% if body_weight != 'default' %}--ff-body-weight: {{ body_weight }};{% endif %}
    background: {{ section.settings.bg_color | default: '#fff' }};
  "
  aria-label="{{ section.settings.title | strip_html | truncate: 60 | escape }}"
>
  <div class="split-media"{% if media_fit == 'contain' %} style="background: {{ section.settings.media_bg | default: '#f9f9f9' }};"{% endif %}>
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          image_size: '1200x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'split-media__video'
      }}
    {% elsif section.settings.video_url != blank %}
      <video
        class="split-media__video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 1200 }}"
        {% elsif section.settings.poster_url != blank %}
          poster="{{ section.settings.poster_url | escape }}"
        {% endif %}
      >
        <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
      </video>
    {% elsif section.settings.image != blank %}
      <img
        class="split-media__img"
        src="{{ section.settings.image | image_url: width: 1200 }}"
        srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                {{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1200 }} 1200w"
        sizes="(max-width: 768px) 100vw, 50vw"
        alt="{{ section.settings.image_alt | escape }}"
        loading="lazy"
      >
    {% elsif section.settings.image_url != blank %}
      <img
        class="split-media__img"
        src="{{ section.settings.image_url | escape }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="lazy"
      >
    {% else %}
      <div class="split-media__placeholder">
        {{ section.settings.image_alt | default: 'Media placeholder' }}
      </div>
    {% endif %}
  </div>

  <div class="split-text align-editorial" style="background: {{ section.settings.bg_color | default: '#fff' }};">
    {% if section.settings.eyebrow != blank %}
      <p class="split-text__eyebrow type-label eyebrow--accent">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="split-text__title {{ heading_class }}">{{ section.settings.title | newline_to_br }}</h2>
    {% if section.settings.body != blank %}
      <p class="split-text__body type-body">{{ section.settings.body }}</p>
    {% endif %}
    {% if section.settings.cta_text != blank and cta_href != blank %}
      <a href="{{ cta_href }}" class="btn btn--primary split-cta">{{ section.settings.cta_text }}</a>
    {% elsif section.settings.cta_text != blank %}
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary split-cta">{{ section.settings.cta_text }}</a>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .split-section {
    display: grid;
    grid-template-columns: var(--ff-media-fr, 1fr) var(--ff-text-fr, 1fr);
    min-height: var(--ff-min-height, 640px);
    border-radius: var(--ff-section-radius, 0);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .split-section--reverse {
    grid-template-columns: var(--ff-text-fr, 1fr) var(--ff-media-fr, 1fr);
  }
  #shopify-section-{{ section.id }} .split-section--reverse .split-media { order: 2; }
  #shopify-section-{{ section.id }} .split-section--reverse .split-text { order: 1; }
  #shopify-section-{{ section.id }} .split-media {
    position: relative;
    overflow: hidden;
    min-height: calc(var(--ff-min-height, 640px) * 0.75);
    border-radius: var(--ff-media-radius, 0);
  }
  #shopify-section-{{ section.id }} .split-media__img,
  #shopify-section-{{ section.id }} .split-media__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--ff-object-position, center);
    display: block;
    position: absolute;
    inset: 0;
    transform: scale(var(--ff-image-scale, 1));
    transform-origin: var(--ff-object-position, center);
  }
  #shopify-section-{{ section.id }} .split-section--contain .split-media {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .split-section--contain .split-media__img {
    position: relative;
    inset: auto;
    width: var(--ff-contain-width, 72%);
    max-width: 420px;
    height: auto;
    object-fit: contain;
    object-position: var(--ff-object-position, center);
    padding: 48px 24px;
    transform: scale(var(--ff-image-scale, 1));
    transform-origin: center center;
  }
  #shopify-section-{{ section.id }} .split-media__placeholder {
    width: 100%;
    height: 100%;
    min-height: calc(var(--ff-min-height, 640px) * 0.75);
    background: linear-gradient(135deg, #c9c5b8, #e9d3cb);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: var(--text-muted, #8a8a8a);
    padding: var(--space-8, 32px);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .split-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 88px 64px;
    text-align: var(--align-editorial, left);
  }
  #shopify-section-{{ section.id }} .split-text__title {
    font-size: var(--ff-title-size, clamp(28px, 3.2vw, 36px)) !important;
    font-weight: var(--ff-title-weight, 400) !important;
    line-height: 1.15 !important;
    letter-spacing: -0.028em !important;
    max-width: none !important;
    margin: 0 0 20px;
  }
  #shopify-section-{{ section.id }} .split-text__eyebrow {
    font-size: var(--type-label-size, 11px);
    text-transform: uppercase;
    letter-spacing: var(--type-label-tracking, 0.08em);
    color: var(--type-label-color, #6b645a);
    font-weight: var(--type-label-weight, 600);
    margin: 0 0 var(--gap-a, 16px);
  }
  #shopify-section-{{ section.id }} .split-text__title.h2-display,
  #shopify-section-{{ section.id }} .split-text__title.h2-standard {
    margin: 0 0 var(--gap-b, 20px);
  }
  #shopify-section-{{ section.id }} .split-text__body {
    font-size: var(--ff-body-size, var(--type-body-size, 17px));
    font-weight: var(--ff-body-weight, var(--type-body-weight, 400));
    color: var(--text-body, #4a4a4a);
    line-height: var(--type-body-leading, 1.6);
    margin: 0 0 var(--gap-c, 32px);
    max-width: 36ch;
  }
  #shopify-section-{{ section.id }} .split-cta { width: fit-content; }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .split-section {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    #shopify-section-{{ section.id }} .split-section--reverse .split-media,
    #shopify-section-{{ section.id }} .split-section--reverse .split-text { order: 0; }
    #shopify-section-{{ section.id }} .split-media {
      min-height: var(--ff-mobile-media-height, 320px);
    }
    #shopify-section-{{ section.id }} .split-text {
      padding: var(--section-padding-y-mobile, 48px) var(--section-padding-x-mobile, 16px);
    }
  }
</style>

{% schema %}
{
  "name": "50/50 Split",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    {
      "type": "select",
      "id": "heading_register",
      "label": "Heading register",
      "options": [
        { "value": "display", "label": "Display — brand statement" },
        { "value": "standard", "label": "Standard — wayfinding" }
      ],
      "default": "display",
      "info": "Type family stays Type OS. Size/weight below are optional overrides only."
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Never loses shape.\nNever loses grip.",
      "info": "Plain text. Line breaks become <br>. Not richtext."
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "24", "label": "24px" },
        { "value": "28", "label": "28px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" }
      ],
      "default": "default",
      "info": "Default keeps Type OS. Overrides size only — not font family."
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Built to hold when it matters most—so you can push deeper, stay longer, and move with confidence."
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "24", "label": "24px" },
        { "value": "28", "label": "28px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" }
      ],
      "default": "default",
      "info": "Default keeps Type OS body size."
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Body weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "cta_text", "label": "CTA label", "default": "Shop Now" },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link",
      "info": "Use a collection/product/page URL for navigation. Use #anchors (e.g. #variants or #knock-socks) only to jump to a section on the same page that has that Anchor ID. Blank → all-products collection."
    },

    { "type": "header", "content": "Shared — Media" },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video",
      "info": "Preferred when the file lives in Shopify Files. Use this OR Video URL — not both. Shopify video wins if both are set."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (mp4)",
      "info": "External/CDN mp4 when you are not using Shopify Video above. Ignored if Shopify video is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image / poster (Shopify)",
      "info": "Still image for image mode, OR poster frame when using Video URL. Prefer this over URL fields when the asset is in Shopify."
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "Poster URL fallback",
      "info": "Poster for Video URL only when Image / poster (Shopify) is empty. Not used for still-image mode."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL fallback",
      "info": "Still image when no Shopify image is set and there is no video. Do not use this as a video poster — use Poster URL fallback."
    },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },

    { "type": "header", "content": "Shared — Layout" },
    {
      "type": "range",
      "id": "min_height",
      "label": "Desktop min height",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640,
      "info": "Home WORKING default is 640px."
    },
    {
      "type": "range",
      "id": "media_column_pct",
      "label": "Media column %",
      "min": 35,
      "max": 65,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "Desktop only. Text column = 100 − media %. Default 50/50."
    },
    {
      "type": "range",
      "id": "mobile_media_height",
      "label": "Mobile media height",
      "min": 220,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout (text left, media right)", "default": false },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Media corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID (optional)",
      "info": "Enables same-page jumps via #this-id from a CTA link elsewhere."
    },

    { "type": "header", "content": "Section — Fifty-fifty — media fit" },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "options": [
        { "value": "cover", "label": "Cover (lifestyle / video)" },
        { "value": "contain", "label": "Contain (packshot)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top left", "label": "Top left" },
        { "value": "top right", "label": "Top right" },
        { "value": "bottom left", "label": "Bottom left" },
        { "value": "bottom right", "label": "Bottom right" }
      ],
      "default": "center",
      "info": "object-position for cover crops (and contain alignment)."
    },
    {
      "type": "range",
      "id": "image_scale",
      "label": "Image scale",
      "min": 100,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Zooms media inside the cell (cover crop / contain packshot)."
    },
    {
      "type": "range",
      "id": "contain_width",
      "label": "Contain media width",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 72,
      "info": "Only when Media fit = Contain. WORKING mock uses ~72%."
    },
    { "type": "color", "id": "media_bg", "label": "Media background (contain)", "default": "#f9f9f9" },
    { "type": "text", "id": "video_caption", "label": "Video caption (compat — unused)" }
  ],
  "presets": [{ "name": "50/50 Split" }]
}
{% endschema %}
