{% comment %}
  Full-bleed statement — Home WORKING §9. Lifestyle image + commit line.
  Separate from statement-band (cream solo slogan).
{% endcomment %}
{% liquid
  assign title_size = section.settings.title_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign media_radius = section.settings.media_radius | default: 0
  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_href = cta_target
  else
    assign cta_href = section.settings.cta_url
  endif
  assign region_label = section.settings.aria_label | strip
  if region_label == blank
    assign region_label = section.settings.title
  endif
%}

<section
  class="fullbleed-statement"
  style="
    --fb-media-radius: {{ media_radius }}px;
    {% if title_size != 'default' %}--fb-title-size: {{ title_size }}px;{% endif %}
    {% if title_weight != 'default' %}--fb-title-weight: {{ title_weight }};{% endif %}
  "
  {% if region_label != blank %}aria-label="{{ region_label | escape }}"{% endif %}
>
  <div class="fullbleed-statement__bg">
    {% if section.settings.image != blank %}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="lazy"
        width="2000"
        height="1200"
      >
    {% elsif section.settings.image_url != blank %}
      <img
        src="{{ section.settings.image_url | escape }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="lazy"
        width="2000"
        height="1200"
      >
    {% endif %}
  </div>
  <div class="fullbleed-statement__content">
    <p class="fullbleed-statement__line type-statement">{{ section.settings.title }}</p>
    {% if section.settings.cta_text != blank %}
      <a class="fullbleed-statement__cta" href="{{ cta_href | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .fullbleed-statement {
    position: relative;
    width: 100%;
    min-height: 64vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1c1916;
    border-radius: var(--fb-media-radius, 0);
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__bg { position: absolute; inset: 0; }
  #shopify-section-{{ section.id }} .fullbleed-statement__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(28, 25, 22, 0.55);
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 80px 40px;
    max-width: 720px;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__line {
    font-size: var(--fb-title-size, clamp(28px, 3.5vw, 40px)) !important;
    font-weight: var(--fb-title-weight, 400) !important;
    letter-spacing: -0.03em !important;
    line-height: 1.12 !important;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.3);
    margin: 0 0 32px;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 16px 36px;
    background: #fff;
    color: #1c1916;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    border: 1px solid #fff;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__cta:hover {
    background: transparent;
    color: #fff;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .fullbleed-statement { min-height: 52vh; }
    #shopify-section-{{ section.id }} .fullbleed-statement__content { padding: 56px 16px; }
  }
</style>

{% schema %}
{
  "name": "Fullbleed statement",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "You commit to the class. Commit to the gear.",
      "info": "Family is brand Type OS — use Title size/weight to adjust. No font family picker."
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" },
        { "value": "24", "label": "24px" },
        { "value": "26", "label": "26px" },
        { "value": "28", "label": "28px" },
        { "value": "30", "label": "30px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "56", "label": "56px" }

      ],
      "default": "default",
      "info": "Family is brand Type OS — size only. Default keeps Type OS."
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "cta_text", "label": "CTA label", "default": "Shop Now" },
    {
      "type": "select",
      "id": "cta_link_target",
      "label": "CTA link",
      "options": [
        { "value": "custom", "label": "Custom URL…" },
        { "value": "#variants", "label": "#variants — Shop styles" },
        { "value": "#knock-socks", "label": "#knock-socks — Statement" },
        { "value": "#reviews", "label": "#reviews" },
        { "value": "#guarantee", "label": "#guarantee" },
        { "value": "#never-loses-grip", "label": "#never-loses-grip" },
        { "value": "#one-pair", "label": "#one-pair" },
        { "value": "#coperni", "label": "#coperni — Collab" },
        { "value": "#problem", "label": "#problem" }
      ],
      "default": "custom",
      "info": "Homepage section anchors jump on the same page. Choose Custom URL… for a full URL or any other #hash. Blank custom → all-products collection."
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Custom CTA URL",
      "info": "Used when CTA link = Custom URL…."
    },
    { "type": "header", "content": "Shared — Media" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (Shopify)",
      "info": "Prefer Shopify Files when the asset is in the library. Leave blank to use Image URL fallback."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL fallback",
      "default": "https://barreletics.com/cdn/shop/files/IMG_2917.jpg?v=1741040637&width=2000",
      "info": "Used only when Background image (Shopify) is empty — for CDN/external stills. Leave blank if Shopify image is set."
    },
    { "type": "text", "id": "image_alt", "label": "Image alt" },
    { "type": "header", "content": "Shared — Layout" },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "One control — applies equally to all four corners."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria-label",
      "info": "Accessibility name for screen readers — not visible on the page. Leave blank to use the Heading."
    }
  ],
  "presets": [{ "name": "Fullbleed statement" }]
}
{% endschema %}
