{% comment %}
  Full-bleed statement / stage — lifestyle image or video + optional copy.
  Multi-use: PDP commit line, tall stage heroes, image-only media bands.
  Separate from statement-band (cream solo slogan).
  GLOBAL HEADING SYSTEM (2026-09-28): line matches the fifty-fifty heading size on every template:
  clamp(36px, 4.8vw, 56px) desktop / 36 phone / 400 (replaces 52 / 36 and the product-only big size).
  (Closed Sole "TRANSFORM YOUR PRACTICE" no longer falls back to the 36/28 statement role).
  title_role / title_size / title_weight stay in the schema but are ignored.
{% endcomment %}
{% liquid
  assign body_size = section.settings.body_size | default: 'default'
  assign body_weight = section.settings.body_weight | default: 'default'
  assign media_radius = section.settings.media_radius | default: 0
  assign show_text = section.settings.show_text
  if show_text == nil
    assign show_text = true
  endif
  assign height_desktop = section.settings.height_desktop | default: '64'
  assign height_mobile = section.settings.height_mobile | default: '52'
  # Phone height 0 = theme setting (2026-09-29): video -> Phone full-width video height, photo -> Phone split-image height.
  assign fb_height_mobile_css = height_mobile | append: 'vh'
  if height_mobile == 0
    if section.settings.video != blank or section.settings.video_url != blank
      assign fb_height_mobile_css = 'var(--fullbleed-video-h-mobile, 500px)'
    else
      assign fb_height_mobile_css = 'var(--split-media-h-mobile, 500px)'
    endif
  endif
  assign image_fit_mobile = section.settings.image_fit_mobile | default: section.settings.media_fit | default: 'cover'
  if image_fit_mobile == blank
    assign image_fit_mobile = 'cover'
  endif
  assign video_fit_mobile = image_fit_mobile
  assign overlay_opacity = section.settings.overlay_opacity | default: 55
  assign overlay_alpha = overlay_opacity | times: 0.01
  assign show_overlay = section.settings.show_overlay
  if show_overlay == nil
    assign show_overlay = true
  endif
  if show_overlay == false
    assign overlay_alpha = 0
  endif
  assign focal_x = section.settings.focal_x | default: 50
  assign focal_y = section.settings.focal_y | default: 50
  assign media_fit = section.settings.media_fit | default: 'cover'
  assign phone_photo = false
  if show_text == false and section.settings.video == blank and section.settings.video_url == blank
    if section.settings.image != blank or section.settings.image_asset != blank or section.settings.image_url != blank
      assign phone_photo = true
    endif
  endif
  if section.settings.mobile_full_bleed
    assign phone_photo = false
  endif
  # Phone "match image" (2026-09-29): phone photo box takes the photo's own shape (no band, no crop). Default off. Photos only.
  assign fb_match_ratio = ''
  assign fb_match_img = nil
  if section.settings.phone_match_image and section.settings.video == blank and section.settings.video_url == blank
    if section.settings.image_mobile != blank
      assign fb_match_img = section.settings.image_mobile
    elsif section.settings.image != blank
      assign fb_match_img = section.settings.image
    endif
    if fb_match_img != blank and fb_match_img.width > 0 and fb_match_img.height > 0
      assign fb_match_ratio = fb_match_img.width | append: ' / ' | append: fb_match_img.height
    endif
  endif

  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_href = cta_target
  else
    assign cta_href = section.settings.cta_url
  endif
  assign cta_style = section.settings.cta_style | default: 'solid'
  assign cta_bg = section.settings.cta_bg_color | default: '#ffffff'
  assign cta_border = section.settings.cta_border_color | default: cta_bg
  assign cta_text_color = section.settings.cta_text_color | default: '#1c1916'
  assign region_label = section.settings.aria_label | strip
  if region_label == blank
    assign region_label = section.settings.title
  endif
%}

<section
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} fullbleed-statement{% unless show_text %} fullbleed-statement--media-only{% endunless %}{% if phone_photo %} fullbleed-statement--phone-photo{% endif %}{% if media_fit == 'contain' %} fullbleed-statement--contain{% endif %}{% if image_fit_mobile == 'contain' %} fullbleed-statement--fit-m-contain{% endif %}{% if fb_match_ratio != blank %} fullbleed-statement--m-match{% endif %}"
  style="{% render 'section-inset-vars' %}{% render 'unified-text-pads-vars', y_d: 80, side_d: 40, y_m: 80, x_m: 20 %} 
    --fb-media-radius: {{ media_radius }}px;
    --fb-height-desktop: {{ height_desktop }}vh;
    --fb-height-mobile: {{ fb_height_mobile_css }};
    {% if section.settings.media_bg_mobile != blank %}--fb-bg-mobile: {{ section.settings.media_bg_mobile }};{% endif %}
    {% if fb_match_ratio != blank %}--fb-ratio-mobile: {{ fb_match_ratio }};{% endif %}
    --fb-fit-mobile: {{ image_fit_mobile }};
    --fb-video-fit-mobile: {{ video_fit_mobile }};
    --fb-overlay: rgba(28, 25, 22, {{ overlay_alpha }});
    --fb-focal: {{ focal_x }}% {{ focal_y }}%;
    --fb-cta-bg: {{ cta_bg }};
    --fb-cta-border: {{ cta_border }};
    --fb-cta-text: {{ cta_text_color }};
    {% if body_size != 'default' %}--fb-body-size: {{ body_size }}px;{% endif %}
    {% if body_weight != 'default' %}--fb-body-weight: {{ body_weight }};{% endif %}
  "
  {% if region_label != blank %}aria-label="{{ region_label | escape }}"{% endif %}
>
  <div class="fullbleed-statement__bg">
    {%- comment -%} Phone image (optional): replaces the still image at max-width 768px via <picture>; desktop keeps the main image. {%- endcomment -%}
    {%- assign fb_pic = false -%}
    {%- if section.settings.image_mobile != blank and section.settings.video == blank and section.settings.video_url == blank -%}{%- assign fb_pic = true -%}
    <picture style="display:contents">
      <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 780 }} 780w, {{ section.settings.image_mobile | image_url: width: 1170 }} 1170w" sizes="100vw" width="{{ section.settings.image_mobile.width }}" height="{{ section.settings.image_mobile.height }}">
    {%- endif -%}
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          image_size: '2000x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          class: 'fullbleed-statement__video'
      }}
      {%- liquid
        assign fb_poster_s = ''
        if section.settings.image != blank
          assign fb_poster_s = section.settings.image | image_url: width: 2000
        elsif section.settings.poster_url != blank
          assign fb_poster_s = section.settings.poster_url
        endif
      -%}
      {% if fb_poster_s != blank %}
        <img
          class="fullbleed-statement__poster-cover"
          src="{{ fb_poster_s | escape }}"
          alt=""
          aria-hidden="true"
          width="2000"
          height="1200"
        >
      {% endif %}
    {% elsif section.settings.video_url != blank %}
      {%- liquid
        assign fb_poster = ''
        if section.settings.image != blank
          assign fb_poster = section.settings.image | image_url: width: 2000
        elsif section.settings.poster_url != blank
          assign fb_poster = section.settings.poster_url
        endif
      -%}
      <video
        class="fullbleed-statement__video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        disablepictureinpicture
        {% if fb_poster != blank %}poster="{{ fb_poster | escape }}"{% endif %}
      >
        <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
      </video>
      {% if fb_poster != blank %}
        <img
          class="fullbleed-statement__poster-cover"
          src="{{ fb_poster | escape }}"
          alt=""
          aria-hidden="true"
          decoding="async"
          width="2000"
          height="1200"
        >
      {% else %}
        <div class="fullbleed-statement__poster-cover" aria-hidden="true"></div>
      {% endif %}
    {% elsif section.settings.image != blank %}
      {%- assign fb_alt = section.settings.image_alt -%}
      {% render 'media-img',
         image: section.settings.image,
         alt: fb_alt,
         widths: '800, 1200, 1600, 2000, 2400',
         width_default: 2000,
         sizes: '100vw',
         loading: 'lazy',
         position: 'css' %}
    {% elsif section.settings.image_asset != blank %}
      {%- assign fb_alt_a = section.settings.image_alt -%}
      {%- assign fb_src_a = section.settings.image_asset | asset_url -%}
      {% render 'media-img',
         url: fb_src_a,
         alt: fb_alt_a,
         loading: 'lazy',
         position: 'css',
         width_attr: 2000,
         height_attr: 1200 %}
    {% elsif section.settings.image_url != blank %}
      {%- assign fb_alt_u = section.settings.image_alt -%}
      {% render 'media-img',
         url: section.settings.image_url,
         alt: fb_alt_u,
         loading: 'lazy',
         position: 'css',
         width_attr: 2000,
         height_attr: 1200 %}
    {% endif %}
    {%- if fb_pic %}</picture>{% endif %}
  </div>
  {% if show_text %}
    <div class="fullbleed-statement__content">
      {% if section.settings.eyebrow != blank %}
        <p class="fullbleed-statement__eyebrow type-label">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <p class="fullbleed-statement__line h2-display">{{ section.settings.title }}</p>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="fullbleed-statement__sub">{{ section.settings.body }}</p>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a class="fullbleed-statement__cta{% if cta_style == 'outline' %} fullbleed-statement__cta--outline{% endif %}" href="{{ cta_href | default: routes.all_products_collection_url }}">
          {{ section.settings.cta_text }}
        </a>
      {% endif %}
    </div>
  {% endif %}
</section>

<style>
  {%- if section.settings.heading_size_override != blank %}
  #shopify-section-{{ section.id }} { {% render 'type-override-vars', title_size: section.settings.heading_size_override %} --te-title-size-n: {{ section.settings.heading_size_override }}; }
  {%- endif %}
  #shopify-section-{{ section.id }} .fullbleed-statement {
    position: relative;
    width: 100%;
    min-height: var(--fb-height-desktop, 64vh);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1c1916;
    border-radius: var(--fb-media-radius, 0);
  }
  /* z-index:0 creates a stacking context so ::after scrim stays behind content (was painting over title) */
  #shopify-section-{{ section.id }} .fullbleed-statement__bg { position: absolute; inset: 0; z-index: 0; }
  #shopify-section-{{ section.id }} .fullbleed-statement__bg img,
  #shopify-section-{{ section.id }} .fullbleed-statement__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--fb-focal, 50% 50%);
    display: block;
  }
  /* Contain: whole photo (face + board). Default Cover unchanged — Closed / sand hero stay fill-crop. */
  #shopify-section-{{ section.id }} .fullbleed-statement--contain .fullbleed-statement__bg img,
  #shopify-section-{{ section.id }} .fullbleed-statement--contain .fullbleed-statement__video {
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement--contain {
    background: #3d7ea6;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__video {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* Invisible until playing — prevents Safari refresh flash of native play button */
    opacity: 0;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__bg.is-playing .fullbleed-statement__video {
    opacity: 1;
  }
  /* Still image sits above video until playback starts */
  #shopify-section-{{ section.id }} .fullbleed-statement__poster-cover {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--fb-focal, 50% 50%);
    pointer-events: none;
    opacity: 1;
    background: #1c1916;
    transition: opacity 0.25s ease;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__bg.is-playing .fullbleed-statement__poster-cover {
    opacity: 0;
    visibility: hidden;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__video:not([controls])::-webkit-media-controls,
  #shopify-section-{{ section.id }} .fullbleed-statement__video:not([controls])::-webkit-media-controls-start-playback-button,
  #shopify-section-{{ section.id }} .fullbleed-statement__video:not([controls])::-webkit-media-controls-enclosure {
    display: none !important;
    -webkit-appearance: none !important;
    opacity: 0 !important;
    width: 0 !important;
    height: 0 !important;
  }
  #shopify-section-{{ section.id }} {
    --fb-overlay: rgba(28, 25, 22, {{ overlay_alpha }});
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--fb-overlay, rgba(28, 25, 22, 0.55));
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement--media-only .fullbleed-statement__bg::after {
    background: transparent;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: var(--utp-y-d, 80px) var(--utp-side-d, 40px);
    max-width: 720px;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__eyebrow {
    color: rgba(255, 255, 255, 0.72);
    margin: 0 0 var(--gap-a, 16px);
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__line {
    color: #fff;
    margin: 0 0 var(--gap-c);
  }
  /* GLOBAL HEADING SYSTEM (locked 2026-09-27): one display head for this section type.
     56 desktop (fluid to 36 on tablet) / 36 phone / 400, same as the fifty-fifty heading (2026-09-28). Theme Editor title size, weight
     and role settings are intentionally ignored so every page renders the same. */
  #shopify-section-{{ section.id }} .fullbleed-statement__line.h2-display {
    font-size: clamp(var(--heading-phone, 36px), calc(var(--te-title-size-n, var(--heading-standard-desktop-n, 56)) * 4.8vw / 56), var(--te-title-size, var(--heading-standard-desktop, 56px)));
    font-weight: 400;
    line-height: var(--heading-standard-leading, 1.06);
    letter-spacing: var(--heading-standard-tracking, -0.032em);
    text-wrap: balance; /* avoid one-word last lines (2026-09-27, Andrew) */
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__line.h2-display strong,
  #shopify-section-{{ section.id }} .fullbleed-statement__line.h2-display b {
    font-weight: inherit;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .fullbleed-statement__line.h2-display {
      font-size: var(--heading-phone, 36px);
    }
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__sub {
    font-size: var(--fb-body-size, 16px);
    font-weight: var(--fb-body-weight, 400);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
    margin: -12px auto var(--gap-c, 32px);
    max-width: 42ch;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
    background: var(--fb-cta-bg, #fff);
    color: var(--fb-cta-text, #1c1916);
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    line-height: var(--type-cta-leading, 1);
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    border: 1px solid var(--fb-cta-border, var(--fb-cta-bg, #fff));
    transition: opacity 0.15s ease;
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__cta--outline {
    background: transparent;
    color: var(--fb-cta-text, var(--fb-cta-border, #fff));
  }
  #shopify-section-{{ section.id }} .fullbleed-statement__cta:hover {
    opacity: 0.92;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .fullbleed-statement {
      min-height: var(--fb-height-mobile, 52vh);
      height: var(--fb-height-mobile, 52vh);
    }
    #shopify-section-{{ section.id }} .fullbleed-statement__bg img {
      object-fit: var(--fb-fit-mobile, cover);
    }
    #shopify-section-{{ section.id }} .fullbleed-statement__video {
      object-fit: var(--fb-video-fit-mobile, var(--fb-fit-mobile, cover));
    }
    #shopify-section-{{ section.id }} .fullbleed-statement__content { padding: var(--utp-y-m, 80px) var(--utp-x-m, 20px); }
    /* Contain stays inside the Mobile height box. Do not zero height — slider must work. */
    #shopify-section-{{ section.id }} .fullbleed-statement--fit-m-contain .fullbleed-statement__bg img,
    #shopify-section-{{ section.id }} .fullbleed-statement--fit-m-contain .fullbleed-statement__video {
      object-fit: contain;
    }
    {%- if section.settings.media_bg_mobile != blank %}
    #shopify-section-{{ section.id }} .fullbleed-statement--fit-m-contain { background: var(--fb-bg-mobile); }
    {%- endif %}
    /* Phone height: match image (2026-09-29, opt-in): box = photo's own aspect ratio, cover, so no band and no crop. */
    #shopify-section-{{ section.id }} .fullbleed-statement--m-match {
      height: auto;
      min-height: 0;
      aspect-ratio: var(--fb-ratio-mobile);
    }
    #shopify-section-{{ section.id }} .fullbleed-statement--m-match .fullbleed-statement__bg img {
      object-fit: cover;
    }
    /* Phone photo: full collage, 32 cream breath — taller section, no hard crop. Videos keep vh. */
    #shopify-section-{{ section.id }} .fullbleed-statement--phone-photo {
      height: auto;
      min-height: 0;
      {% if template.name == 'product' %}
      padding: 32px;
      background: #faf8f6;
      box-sizing: border-box;
      {% endif %}
    }
    #shopify-section-{{ section.id }} .fullbleed-statement--phone-photo .fullbleed-statement__bg {
      position: relative;
      inset: auto;
    }
    #shopify-section-{{ section.id }} .fullbleed-statement--phone-photo .fullbleed-statement__bg img {
      position: relative;
      width: 100%;
      height: auto;
      object-fit: cover;
    }
  }
</style>


<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var bg = root.querySelector('.fullbleed-statement__bg');
    var video = root.querySelector('.fullbleed-statement__video');
    if (!bg || !video || video.hasAttribute('controls')) return;
    function markPlaying() {
      if (video.paused || video.readyState < 2) return;
      bg.classList.add('is-playing');
    }
    function kick() {
      video.muted = true;
      video.defaultMuted = true;
      video.setAttribute('muted', '');
      video.playsInline = true;
      var p = video.play();
      if (p && p.then) p.then(function () { markPlaying(); }).catch(function () {});
      else markPlaying();
    }
    video.addEventListener('playing', markPlaying);
    video.addEventListener('timeupdate', function onTime() {
      if (video.currentTime > 0.05) {
        markPlaying();
        video.removeEventListener('timeupdate', onTime);
      }
    });
    video.addEventListener('loadeddata', kick);
    video.addEventListener('canplay', kick);
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) kick(); });
      }, { rootMargin: '80px 0px' });
      io.observe(video);
    }
    kick();
  })();
</script>

{% render 'bg-video-autoplay-script',
  section_id: section.id,
  root_class: 'fullbleed-statement',
  video_selector: 'video.fullbleed-statement__video, .fullbleed-statement__bg video'
%}

{% render 'unified-text-pads-te-style', selector: '.fullbleed-statement__content', y_d: 80, side_d: 40, y_m: 80, x_m: 20 %}

{% schema %}
{
  "name": "Fullbleed statement",
  "settings": [
    {
      "type": "header",
      "content": "Shared \u2014 Content"
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Show text overlay",
      "default": true,
      "info": "Off = image/video-only stage (no eyebrow, title, sub, or CTA)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "You commit to the class. Commit to the gear.",
      "info": "Family is brand Type OS. Heading size and weight are locked by the global type system."
    },
    {
      "type": "number",
      "id": "heading_size_override",
      "label": "Heading size override (px, desktop)",
      "info": "Leave blank to follow Theme settings > Section headings. A number sets this section's desktop heading size only. Phones keep the global phone size."
