{% comment %}
  Article Content Section
  Full article layout with rich content, author, date, share buttons,
  and BlogPosting structured data. Includes related articles.
  Used on: article.json
{% endcomment %}

<article class="section" id="shopify-section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="section__inner section__inner--narrow">
    <header class="article__header">
      {% if article.tags.size > 0 %}
        <span class="article__category">{{ article.tags.first }}</span>
      {% endif %}
      <h1 class="article__title type-hero">{{ article.title }}</h1>
      <div class="article__meta">
        <span class="article__author">By {{ article.author }}</span>
        <time class="article__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%B %d, %Y' }}
        </time>
      </div>
    </header>

    {% if article.image %}
      <div class="article__hero-image">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          srcset="{{ article.image | image_url: width: 600 }} 600w,
                  {{ article.image | image_url: width: 900 }} 900w,
                  {{ article.image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 768px) 100vw, 760px"
          alt="{{ article.image.alt | escape }}"
          loading="eager"
          class="article__image"
        >
      </div>
    {% endif %}

    <div class="article__body rte">
      {{ article.content }}
    </div>

    <footer class="article__footer">
      <div class="article__share">
        <span class="article__share-label">Share:</span>
        <a
          href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ shop.url }}{{ article.url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="article__share-link"
          aria-label="Share on X (Twitter)"
        >X</a>
        <a
          href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="article__share-link"
          aria-label="Share on Facebook"
        >Facebook</a>
        <a
          href="mailto:?subject={{ article.title | url_encode }}&body={{ shop.url }}{{ article.url }}"
          class="article__share-link"
          aria-label="Share via email"
        >Email</a>
      </div>

      {% if article.tags.size > 0 %}
        <div class="article__tags">
          {% for tag in article.tags %}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article__tag">{{ tag }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </footer>
  </div>
</article>

{% if section.settings.show_related and blog.articles.size > 1 %}
<section class="section section--cream">
  <div class="section__inner">
    <h2 class="article__related-title">{{ section.settings.related_heading }}</h2>
    <div class="article__related-grid">
      {% assign count = 0 %}
      {% for related in blog.articles %}
        {% if related.id != article.id and count < 3 %}
          <a href="{{ related.url }}" class="article__related-card" aria-label="Read {{ related.title }}">
            <div class="article__related-image-wrap">
              {% if related.image %}
                <img
                  src="{{ related.image | image_url: width: 480 }}"
                  alt="{{ related.image.alt | escape }}"
                  loading="lazy"
                  class="article__related-image"
                >
              {% else %}
                <div class="article__related-placeholder"></div>
              {% endif %}
            </div>
            <h3 class="article__related-name">{{ related.title }}</h3>
            <time class="article__related-date" datetime="{{ related.published_at | date: '%Y-%m-%d' }}">
              {{ related.published_at | date: '%B %d, %Y' }}
            </time>
          </a>
          {% assign count = count | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  {% if article.image %}
  "image": "{{ article.image | image_url: width: 1200 }}",
  {% endif %}
  "publisher": {
    "@type": "Organization",
    "name": "Barreletics",
    "url": "https://barreletics.com"
  },
  "description": {{ article.excerpt | strip_html | truncate: 160 | json }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ shop.url }}{{ article.url }}"
  }
}
</script>

<style>
  .article__header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .article__category {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--accent-primary);
    margin-bottom: var(--space-3);
  }

  .article__title {
    font-size: var(--type-hero-size);
    font-weight: var(--type-hero-weight);
    line-height: var(--type-hero-leading);
    letter-spacing: var(--type-hero-tracking);
    text-transform: none;
    color: var(--text-primary);
    margin: 0 0 var(--space-4);
  }

  .article__meta {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .article__author {
    font-weight: var(--weight-medium);
  }

  .article__hero-image {
    margin-bottom: var(--space-8);
    border-radius: var(--radius-gallery);
    overflow: hidden;
  }

  .article__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .article__body {
    font-size: var(--text-md);
    color: var(--text-body);
    line-height: var(--leading-loose);
  }

  .article__body h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: var(--space-8) 0 var(--space-4);
  }

  .article__body h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-3);
  }

  .article__body p {
    margin-bottom: var(--space-4);
  }

  .article__body img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-gallery);
    margin: var(--space-6) 0;
  }

  .article__footer {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-default);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .article__share {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .article__share-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
  }

  .article__share-link {
    font-size: var(--text-sm);
    color: var(--text-primary);
    text-decoration: none;
    padding: 6px 12px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-button);
    transition: background var(--transition-fast), color var(--transition-fast);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .article__share-link:hover {
    background: var(--text-primary);
    color: var(--color-white);
    border-color: var(--text-primary);
  }

  .article__tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .article__tag {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
    text-decoration: none;
    padding: 4px 10px;
    background: var(--bg-alternate);
    border-radius: var(--radius-badge);
    transition: background var(--transition-fast);
  }

  .article__tag:hover {
    background: var(--border-default);
  }

  .article__related-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    text-align: center;
    margin: 0 0 var(--space-8);
  }

  .article__related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
  }

  .article__related-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .article__related-image-wrap {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-card-sm);
    overflow: hidden;
    margin-bottom: var(--space-3);
    background: var(--bg-alternate);
  }

  .article__related-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article__related-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--bg-alternate), var(--border-default));
  }

  .article__related-name {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-1);
    line-height: var(--leading-snug);
  }

  .article__related-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .article__title {
      font-size: var(--text-3xl);
    }

    .article__related-grid {
      grid-template-columns: 1fr;
      gap: var(--grid-gap-sm);
    }

    .article__footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Article Content",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show related articles",
      "default": true
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Related articles heading",
      "default": "Keep Reading"
    }
  ],
  "presets": [
    {
      "name": "Article Content"
    }
  ]
}
{% endschema %}
