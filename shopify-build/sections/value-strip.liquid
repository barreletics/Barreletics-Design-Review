{% comment %}
  Trust / Value scan strip — v19 wording + optional Non-toxic
  Desktop: full ·-separated line. Mobile: short line (hide show_on_mobile=false items).
{% endcomment %}
<section
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} value-strip-section"
  aria-label="{{ section.settings.aria_label | default: 'Value propositions' | escape }}"
  style="{% render 'section-inset-vars' %}{% render 'unified-text-pads-vars', y_d: 28, side_d: 40, y_m: 20, x_m: 16, legacy_y_d: section.settings.padding_y, legacy_y_m: section.settings.padding_y_mobile %}{% if section.settings.bg_color != blank %} background: {{ section.settings.bg_color }};{% endif %}"
>
  <div class="value-strip trust-strip__inner">
    <span class="value-strip__full">
      {% assign full_i = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}
          {% if full_i > 0 %}<span class="value-strip__sep" aria-hidden="true"> · </span>{% endif %}
          <span class="value-strip__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {% assign full_i = full_i | plus: 1 %}
        {% endif %}
      {% endfor %}
    </span>
    <span class="value-strip__short">
      {% assign short_i = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.text != blank and block.settings.show_on_mobile != false %}
          {% assign short_i = short_i | plus: 1 %}
          <span class="value-strip__item">
            <span class="value-strip__text">{{ block.settings.text }}</span>
            <span class="value-strip__sep" aria-hidden="true"> · </span>
          </span>
          {% if short_i == 2 %}
            <span class="value-strip__break" aria-hidden="true"></span>
          {% endif %}
        {% endif %}
      {% endfor %}
    </span>
  </div>
</section>

<style>
  .value-strip-section {
    background: #faf8f6;
    border-top: none;
    border-bottom: 1px solid #d6cfc0;
    /* Band height via TE padding_y (default 28). Still welded under buy box — not content-section rhythm. */
    padding: var(--utp-y-d, 28px) var(--utp-side-d, 40px);
  }
  .value-strip {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    font-size: var(--type-value-strip-size, 12px);
    font-weight: var(--type-value-strip-weight, 500);
    text-transform: uppercase;
    letter-spacing: var(--type-value-strip-tracking, 0.08em);
    color: #6b645a;
    line-height: 1;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .value-strip::-webkit-scrollbar { display: none; }
  .value-strip__sep { color: #9a9182; margin: 0 8px; }
  .value-strip__short { display: none; }
  @media (max-width: 768px) {
    .value-strip-section {
      padding: var(--utp-y-m, 20px) var(--utp-x-m, 16px);
    }
    .value-strip { white-space: normal; line-height: 1.35; }
    .value-strip__full { display: none; }
    /* Clean 2×2 — no trailing dots, no nowrap overflow */
    .value-strip__short {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 12px;
      row-gap: 10px;
      justify-items: center;
      align-items: center;
      width: 100%;
      max-width: 420px;
      margin: 0 auto;
    }
    .value-strip__item {
      display: block;
      white-space: normal;
      text-align: center;
    }
    .value-strip__item .value-strip__sep,
    .value-strip__break {
      display: none !important;
    }
  }
</style>

{% render 'unified-text-pads-te-style', selector: '.value-strip-section', y_d: 28, side_d: 40, y_m: 20, x_m: 16 %}

{% schema %}
{
  "name": "Value Strip",
  "settings": [
    {
      "type": "header",
      "content": "Shared — Content"
    },
    {
      "type": "paragraph",
      "content": "v19 scan strip. Desktop shows all items with · separators. Mobile uses items with Show on mobile ON (drop lower-priority labels if crowded)."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria-label",
      "default": "Value propositions"
    },
    {
      "type": "header",
      "content": "Section — Value strip"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#faf8f6"
    },
    { "type": "header", "content": "Layout — text padding" },
    { "type": "range", "id": "text_pad_y", "label": "Text pad top & bottom — desktop (default 96)", "min": 32, "max": 120, "step": 4, "unit": "px", "default": 96, "info": "Band height on desktop. Unset uses legacy padding_y (default 28)." },
    { "type": "range", "id": "side_padding", "label": "Text pad left & right — desktop (default 64)", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 64, "info": "Default render 40px when unset." },
    { "type": "range", "id": "text_pad_y_mobile", "label": "Text pad top & bottom — phone (default 80)", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 80, "info": "Unset uses legacy padding_y_mobile or 20px." },
    { "type": "range", "id": "text_pad_x_mobile", "label": "Text pad left & right — phone (default 20)", "min": 12, "max": 48, "step": 4, "unit": "px", "default": 20, "info": "Default render 16px when unset." },
    { "type": "header", "content": "Legacy (hidden — do not edit)" },
    { "type": "range", "id": "padding_y", "label": "Legacy: Band height desktop", "min": 12, "max": 48, "step": 2, "unit": "px", "default": 28, "visible_if": "{{ section.settings.aria_label == '__legacy_hidden__' }}" },
    { "type": "range", "id": "padding_y_mobile", "label": "Legacy: Band height mobile", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 24, "visible_if": "{{ section.settings.aria_label == '__legacy_hidden__' }}" },
    {
      "type": "header",
      "content": "Shared — Section frame"
    },
    {
      "type": "paragraph",
      "content": "OUTER inset from the page edges (margin). Top and bottom are independent; left & right = one control. Custom mobile OFF = mobile uses the same inset as desktop. Defaults 0 = full bleed."
    },
    {
      "type": "checkbox",
      "id": "inset_custom_mobile",
      "label": "Custom mobile inset",
      "default": false,
      "info": "OFF (default): ignore the mobile inset sliders — mobile uses desktop Inset top / bottom / left & right. ON: use the mobile inset sliders instead."
    },
    {
      "type": "range",
      "id": "inset_top",
      "label": "Inset top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_bottom",
      "label": "Inset bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x",
      "label": "Inset left & right",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Same value on both sides."
    },
    {
      "type": "range",
      "id": "inset_top_mobile",
      "label": "Inset top — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "range",
      "id": "inset_bottom_mobile",
      "label": "Inset bottom — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x_mobile",
      "label": "Inset left & right — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Value item",
      "settings": [
        {
          "type": "header",
          "content": "Shared — Content"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Label",
          "default": "Made in USA"
        },
        {
          "type": "header",
          "content": "Section — Item"
        },
        {
          "type": "checkbox",
          "id": "show_on_mobile",
          "label": "Show on mobile (short line)",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value Strip",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Made in USA",
            "show_on_mobile": true
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Complimentary shipping over $150",
            "show_on_mobile": true
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "30-day returns",
            "show_on_mobile": true
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "90-day warranty",
            "show_on_mobile": false
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Non-toxic",
            "show_on_mobile": true
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "No latex",
            "show_on_mobile": false
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "No silicone",
            "show_on_mobile": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
