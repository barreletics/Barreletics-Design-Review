{% comment %}
  Page Size Guide Section
  Size chart, color-specific fit notes, and visual fit guidance.
  Used on: page.size-guide.json
{% endcomment %}

<section class="section page-size__head" id="shopify-section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="section__inner section__inner--narrow">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="page-size__title">{{ section.settings.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="page-size__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
</section>

<section class="section page-size__body">
  <div class="section__inner section__inner--narrow">
    <h2 class="page-size__section-title h2-standard">Size Chart</h2>
    <div class="page-size__table-wrap">
      <table class="page-size__table" role="table" aria-label="Size chart">
        <thead>
          <tr>
            <th scope="col">Size</th>
            <th scope="col">US Women's</th>
            <th scope="col">Foot Length</th>
            <th scope="col">Best For</th>
          </tr>
        </thead>
        <tbody>
          {%- assign size_rows = 0 -%}
          {% for block in section.blocks %}
            {% if block.type == 'size_row' %}
              {%- assign size_rows = size_rows | plus: 1 -%}
              <tr {{ block.shopify_attributes }}>
                <td class="page-size__td--size">{{ block.settings.size_name }}</td>
                <td>{{ block.settings.us_size }}</td>
                <td>{{ block.settings.foot_length }}</td>
                <td>{{ block.settings.best_for }}</td>
              </tr>
            {% endif %}
          {% endfor %}
          {%- comment -%} Fallback if TE cleared size_row blocks — chart must never be empty {%- endcomment -%}
          {% if size_rows == 0 %}
              <tr>
                <td class="page-size__td--size">M</td>
                <td>5–8</td>
                <td>8.5"–9.5"</td>
                <td>Most women's sizes 5–8</td>
              </tr>
              <tr>
                <td class="page-size__td--size">L</td>
                <td>8.5–11</td>
                <td>9.5"–10.5"</td>
                <td>Most women's sizes 8.5–11</td>
              </tr>
          {% endif %}
        </tbody>
      </table>
    </div>

    <h2 class="page-size__section-title page-size__section-title--stacked h2-standard">Fit Notes by Color</h2>
    <div class="page-size__notes">
      <div class="page-size__note">
        <h3 class="page-size__note-title">Dark Grey, Hot Coral & Blue</h3>
        <p class="page-size__note-text">{{ section.settings.snug_colors_note }}</p>
      </div>
      <div class="page-size__note">
        <h3 class="page-size__note-title">Light Grey</h3>
        <p class="page-size__note-text">{{ section.settings.light_grey_note }}</p>
      </div>
    </div>

    <h2 class="page-size__section-title page-size__section-title--stacked h2-standard">Fit Tips</h2>
    <div class="page-size__tips">
      {% for block in section.blocks %}
        {% if block.type == 'fit_tip' %}
          <div class="page-size__tip" {{ block.shopify_attributes }}>
            <h3 class="page-size__tip-title">{{ block.settings.title }}</h3>
            <p class="page-size__tip-text">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% if section.settings.cta_text != blank %}
<section class="section page-size__cta">
  <div class="section__inner section__inner--narrow" style="text-align: center;">
    <p class="page-size__cta-text">{{ section.settings.cta_note }}</p>
    {% render 'button', label: section.settings.cta_text, url: section.settings.cta_url, style: 'primary', size: 'lg' %}
  </div>
</section>
{% endif %}

<style>
  /* Help-family page H1 — planning/help-family-type-law.md */
  .page-size__title {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.028em;
    text-transform: none;
    color: var(--text-primary);
    text-align: center;
    margin: 0 0 var(--space-3);
  }

  .page-size__subtitle {
    font-size: var(--text-md);
    color: var(--text-body);
    text-align: center;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .page-size__section-title {
    font-size: var(--type-section-size);
    font-weight: var(--type-section-weight);
    line-height: var(--type-section-leading);
    letter-spacing: var(--type-section-tracking);
    text-transform: none;
    color: var(--text-primary);
    margin: 0 0 var(--space-5);
  }

  /* One continuous white band — the chart, notes, and tips are one system,
     not three striped sections. */
  .page-size__section-title--stacked { margin-top: 56px; }

  /* Calm chart system — docs/Barreletics Size Chart - Definitive-v1.html:
     bordered wrap, cream header, hairline rows. No heavy rules, no tinted alerts. */
  .page-size__table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid #d6cfc0;
    border-radius: 8px;
  }

  .page-size__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .page-size__table th {
    padding: 14px 16px;
    text-align: left;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8a8a8a;
    background: #f5f2ec;
    border-bottom: 1px solid #d6cfc0;
  }

  .page-size__table td {
    padding: 14px 16px;
    border-bottom: 1px solid #e8e2d8;
    color: var(--text-body, #4a4a4a);
  }
  .page-size__table tr:last-child td { border-bottom: none; }

  .page-size__td--size {
    font-weight: 500;
    color: var(--text-primary, #1c1916);
  }

  .page-size__notes,
  .page-size__tips {
    display: grid;
    gap: 16px;
  }

  .page-size__note,
  .page-size__tip {
    padding: 20px 22px;
    background: #f5f2ec;
    border: 1px solid #e8e2d8;
    border-radius: 8px;
  }

  .page-size__note-title,
  .page-size__tip-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary, #1c1916);
    margin: 0 0 8px;
  }

  .page-size__note-text,
  .page-size__tip-text {
    font-size: 14px;
    color: var(--text-body, #4a4a4a);
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 769px) {
    .page-size__tips { grid-template-columns: repeat(2, 1fr); }
  }

  .page-size__head { border-bottom: 1px solid #e8e2d8; }
  .page-size__cta { border-top: 1px solid #d6cfc0; }

  .page-size__cta-text {
    font-size: var(--text-md);
    color: var(--text-body);
    margin: 0 0 var(--space-5);
  }

  @media (max-width: 768px) {
    .page-size__title {
      font-size: clamp(28px, 8vw, 36px);
    }

    .page-size__section-title--stacked { margin-top: 44px; }

    .page-size__table th,
    .page-size__table td {
      padding: 12px 14px;
      font-size: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "Size Guide Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fit Guide"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Size Guide"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Performance Skins are designed for a snug, second-skin fit. Here's how to find your perfect size."
    },
    {
      "type": "textarea",
      "id": "snug_colors_note",
      "label": "Snug colors note",
      "default": "These colors run slightly snugger than Light Grey. If you're between sizes in Dark Grey, Hot Coral, or Blue — size up."
    },
    {
      "type": "textarea",
      "id": "light_grey_note",
      "label": "Light Grey note",
      "default": "Light Grey offers a slightly more relaxed fit compared to other colors. True to size for most customers."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "textarea",
      "id": "cta_note",
      "label": "CTA note",
      "default": "Still unsure? Contact us and we'll help you find the right fit."
    }
  ],
  "blocks": [
    {
      "type": "size_row",
      "name": "Size Row",
      "settings": [
        {
          "type": "text",
          "id": "size_name",
          "label": "Size name"
        },
        {
          "type": "text",
          "id": "us_size",
          "label": "US size range"
        },
        {
          "type": "text",
          "id": "foot_length",
          "label": "Foot length"
        },
        {
          "type": "text",
          "id": "best_for",
          "label": "Best for"
        }
      ]
    },
    {
      "type": "fit_tip",
      "name": "Fit Tip",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tip title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Tip description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size Guide Page"
    }
  ]
}
{% endschema %}
