{% comment %}
  About page — 50/50 split (Theme Editor aligned with fifty-fifty control set)
{% endcomment %}

{%- liquid
  assign reverse = section.settings.reverse
  assign media_pct = section.settings.media_column_pct | default: 50
  assign text_pct = 100 | minus: media_pct

  assign min_height = section.settings.min_height
  if min_height == blank
    assign min_height = section.settings.media_max_px | default: 760
  endif
  assign mobile_media_height = section.settings.mobile_media_height
  if mobile_media_height == blank or mobile_media_height == 0
    assign mobile_media_height = section.settings.media_max_px_mobile | default: 480
  endif

  assign panel_cream = false
  if section.settings.bg_style == 'cream'
    assign panel_cream = true
  elsif section.settings.cream_bg
    assign panel_cream = true
  endif

  assign text_pad_y_d = section.settings.text_pad_y
  assign text_pad_y_m = section.settings.text_pad_y_mobile
  assign side_padding = section.settings.side_padding
  if side_padding == blank
    assign side_padding = 48
  endif
  assign text_pad_x_m = section.settings.text_pad_x_mobile
  if text_pad_x_m == blank
    assign text_pad_x_m = 20
  endif
  assign section_gap = section.settings.section_gap
  if section_gap == blank
    assign section_gap = 0
  endif
  assign section_gap_m = section.settings.section_gap_mobile | default: 0
-%}

<section
  class="page-about-split{% if reverse %} page-about-split--reverse{% endif %}{% if panel_cream %} page-about-split--cream{% endif %}{% if text_pad_y_d != blank %} page-about-split--fixed-pad-d{% endif %}{% if text_pad_y_m != blank %} page-about-split--fixed-pad-m{% endif %}{% render 'split-mobile-stack-class', mobile_stack_order: section.settings.mobile_stack_order %}"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
  aria-label="{{ section.settings.aria_label | escape }}"
  style="--pas-media-fr: {{ media_pct }}fr; --pas-text-fr: {{ text_pct }}fr; --pas-min-height: {{ min_height }}px; --pas-mobile-media-height: {{ mobile_media_height }}px; --pas-section-gap: {{ section_gap }}px; --pas-section-gap-m: {{ section_gap_m }}px;{% if text_pad_y_d != blank %} --pas-text-pad-y-d: {{ text_pad_y_d }}px;{% endif %}{% if text_pad_y_m != blank %} --pas-text-pad-y-m: {{ text_pad_y_m }}px;{% endif %} --pas-side-padding: {{ side_padding }}px; --pas-text-pad-x-m: {{ text_pad_x_m }}px;{% render 'type-override-vars', title_weight: section.settings.title_weight, body_size: section.settings.body_size, body_weight: section.settings.body_weight %}"
>
  <div class="page-about-split__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          widths: '600, 900, 1200, 1600',
          sizes: '(max-width: 768px) 100vw, 50vw',
          alt: section.settings.image_alt,
          loading: 'lazy',
          class: 'page-about-split__img'
      }}
    {% elsif section.settings.image_url != blank %}
      <img
        class="page-about-split__img"
        src="{{ section.settings.image_url | escape }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="lazy"
      >
    {% endif %}
  </div>
  <div class="page-about-split__copy">
    {% if section.settings.title != blank %}
      {% assign hl = section.settings.heading_level | default: 'h2' %}
      {% if hl != 'h2' and hl != 'h3' %}{% assign hl = 'h2' %}{% endif %}
      <{{ hl }} class="page-about-split__title">{{ section.settings.title }}</{{ hl }}>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="page-about-split__body rte">{{ section.settings.body }}</div>
    {% endif %}
  </div>
</section>

<style>
  {%- if section.settings.heading_size_override != blank %}
  #shopify-section-{{ section.id }} { {% render 'type-override-vars', title_size: section.settings.heading_size_override %} --te-title-size-n: {{ section.settings.heading_size_override }}; }
  {%- endif %}
  #shopify-section-{{ section.id }} {
    padding-block: var(--pas-section-gap, 0px);
  }
  #shopify-section-{{ section.id }} .page-about-split {
    display: grid;
    grid-template-columns: var(--pas-media-fr, 1fr) var(--pas-text-fr, 1fr);
    align-items: center;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .page-about-split--cream { background: var(--color-warm-cream, #faf8f6); }
  #shopify-section-{{ section.id }} .page-about-split--reverse { direction: rtl; }
  #shopify-section-{{ section.id }} .page-about-split--reverse > * { direction: ltr; }
  #shopify-section-{{ section.id }} .page-about-split__media {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 3vw, 36px) clamp(12px, 2vw, 24px);
  }
  #shopify-section-{{ section.id }} .page-about-split__img {
    width: auto;
    max-width: 100%;
    max-height: var(--pas-min-height, 760px);
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .page-about-split__copy {
    padding: clamp(28px, 4vw, 56px) clamp(20px, 4vw, 48px);
    max-width: 36em;
  }
  #shopify-section-{{ section.id }} .page-about-split--fixed-pad-d .page-about-split__copy {
    padding: var(--pas-text-pad-y-d, 56px) var(--pas-side-padding, 48px);
  }
  #shopify-section-{{ section.id }} .page-about-split__title {
    font-size: clamp(var(--heading-phone, 36px), calc(var(--te-title-size-n, var(--heading-standard-desktop-n, 56)) * 4.8vw / 56), var(--te-title-size, var(--heading-standard-desktop, 56px)));
    font-weight: var(--te-title-weight, 400);
    letter-spacing: -0.032em;
    line-height: 1.06;
    margin: 0 0 24px;
    color: var(--text-primary, #1c1916);
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .page-about-split__title {
      font-size: var(--heading-phone, 36px);
    }
  }
  #shopify-section-{{ section.id }} .page-about-split__body {
    font-size: var(--te-body-size, 17px);
    font-weight: var(--te-body-weight, 400);
    line-height: 1.7;
    color: var(--text-body, #4a4a4a);
  }
  #shopify-section-{{ section.id }} .page-about-split__body p + p { margin-top: 1em; }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-bottom: var(--pas-section-gap-m, 0px);
    }
    #shopify-section-{{ section.id }} .page-about-split {
      grid-template-columns: 1fr;
      display: flex;
      flex-direction: column;
    }
    #shopify-section-{{ section.id }} .page-about-split--reverse { direction: ltr; }
    #shopify-section-{{ section.id }} .page-about-split__media { padding: 16px 16px 0; }
    #shopify-section-{{ section.id }} .page-about-split__img {
      width: 100%;
      height: var(--pas-mobile-media-height, 480px);
      max-height: none;
      object-fit: cover;
      object-position: center center;
    }
    #shopify-section-{{ section.id }} .page-about-split__copy { padding: 8px var(--pas-text-pad-x-m, 20px) 32px; }
    #shopify-section-{{ section.id }} .page-about-split--fixed-pad-m .page-about-split__copy {
      padding: var(--pas-text-pad-y-m, 32px) var(--pas-text-pad-x-m, 20px);
    }
  }
</style>

{%- comment -%}
  TE live preview: read section.settings.* directly (not top-of-file assigns).
{%- endcomment -%}
{% style %}
  {%- liquid
    assign te_min_h = section.settings.min_height
    if te_min_h == blank
      assign te_min_h = section.settings.media_max_px | default: 760
    endif
    assign te_mmh = section.settings.mobile_media_height
    if te_mmh == blank or te_mmh == 0
      assign te_mmh = section.settings.media_max_px_mobile | default: 480
    endif
    assign te_mcp = section.settings.media_column_pct | default: 50
  -%}
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .page-about-split {
    --pas-min-height: {{ te_min_h }}px;
    --pas-mobile-media-height: {{ te_mmh }}px;
    --pas-media-fr: {{ te_mcp }}fr;
    --pas-text-fr: {{ 100 | minus: te_mcp }}fr;
    --pas-section-gap: {{ section.settings.section_gap | default: 0 }}px;
    --pas-section-gap-m: {{ section.settings.section_gap_mobile | default: 0 }}px;
    --pas-side-padding: {{ section.settings.side_padding | default: 48 }}px;
    --pas-text-pad-x-m: {{ section.settings.text_pad_x_mobile | default: 20 }}px;
  }
  {%- if section.settings.text_pad_y != blank %}
  #shopify-section-{{ section.id }} .page-about-split__copy {
    padding-top: {{ section.settings.text_pad_y }}px !important;
    padding-bottom: {{ section.settings.text_pad_y }}px !important;
    padding-left: {{ section.settings.side_padding | default: 48 }}px !important;
    padding-right: {{ section.settings.side_padding | default: 48 }}px !important;
  }
  {%- endif %}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-split__img {
      height: {{ te_mmh }}px !important;
      max-height: none !important;
    }
    {%- if section.settings.text_pad_y_mobile != blank %}
    #shopify-section-{{ section.id }} .page-about-split__copy {
      padding-top: {{ section.settings.text_pad_y_mobile }}px !important;
      padding-bottom: {{ section.settings.text_pad_y_mobile }}px !important;
      padding-left: {{ section.settings.text_pad_x_mobile | default: 20 }}px !important;
      padding-right: {{ section.settings.text_pad_x_mobile | default: 20 }}px !important;
    }
    {%- endif %}
  }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .page-about-split__img {
      max-height: {{ te_min_h }}px !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "About \u2014 Split",
  "settings": [
    {
      "type": "header",
      "content": "1 \u2014 Photo / video"
    },
    {
      "type": "paragraph",
      "content": "Pick ONE. Priority: Shopify image \u2192 Image URL."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image / poster (Shopify)"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "info": "Used when Shopify image is empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "header",
      "content": "2 \u2014 Focus + height"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Height \u2014 desktop (default 760)",
      "min": 360,
      "max": 820,
      "step": 20,
      "unit": "px",
      "info": "Contain-fit photo max height on desktop."
    },
    {
      "type": "range",
      "id": "media_column_pct",
      "label": "Image width \u2014 desktop (default 50%)",
      "min": 40,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_media_height",
      "label": "Image height \u2014 phone (default 0 = theme 500px)",
      "min": 0,
      "max": 900,
      "step": 10,
      "unit": "px",
      "info": "0 uses legacy saved phone height when present (see hidden keys)."
    },
    {
      "type": "header",
      "content": "3 \u2014 Heading / body / CTA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level (default H2)",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "header",
      "content": "4 \u2014 Trust strip"
    },
    {
      "type": "paragraph",
      "content": "Not used on About splits."
    },
    {
      "type": "header",
      "content": "5 \u2014 Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Image on right \u2014 desktop (default: off)",
      "default": false,
      "info": "769px and up only."
    },
    {
      "type": "select",
      "id": "mobile_stack_order",
      "label": "Phone stack (default: image on top)",
      "default": "media_first",
      "options": [
        {
          "value": "media_first",
          "label": "Image above copy (default)"
        },
        {
          "value": "copy_first",
          "label": "Copy above image"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 56)",
      "min": 8,
      "max": 120,
      "step": 1,
      "unit": "px",
      "info": "Leave unset in JSON keeps legacy clamp padding until you set this in TE."
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 48)",
      "min": 8,
      "max": 96,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 36)",
      "min": 8,
      "max": 120,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 20)",
      "min": 8,
      "max": 48,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "bg_style",
      "label": "Text panel background (default: White)",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "White (#ffffff)"
        },
        {
          "value": "cream",
          "label": "Cream (#faf8f6)"
        }
      ]
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility name (aria-label)",
      "default": "Story section"
    },
    {
      "type": "header",
      "content": "6 \u2014 Section gap"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "Space above & below \u2014 desktop (default 0)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_gap_mobile",
      "label": "Space after section \u2014 phone (default 0)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Legacy (hidden \u2014 do not edit)"
    },
    {
      "type": "paragraph",
      "content": "Preserves stored values on Theme Editor save."
    },
    {
      "type": "range",
      "id": "media_max_px",
      "label": "Legacy: Photo height desktop",
      "min": 360,
      "max": 820,
      "step": 20,
      "unit": "px",
      "default": 760,
      "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}"
    },
    {
      "type": "range",
      "id": "media_max_px_mobile",
      "label": "Legacy: Photo height mobile",
      "min": 280,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 480,
      "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}"
    },
    {
      "type": "checkbox",
      "id": "cream_bg",
      "label": "Legacy: Cream background",
      "default": false,
      "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}"
    },
    {
      "type": "number",
      "id": "heading_size_override",
      "label": "Legacy: Heading size override",
      "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Legacy: Heading weight",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        }
      ],
      "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Legacy: Body size",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "14",
          "label": "14px"
        },
        {
          "value": "15",
          "label": "15px"
        },
        {
          "value": "16",
          "label": "16px"
        },
        {
          "value": "17",
          "label": "17px"
        },
        {
          "value": "18",
          "label": "18px"
        },
        {
          "value": "20",
          "label": "20px"
        },
        {
          "value": "22",
          "label": "22px"
        },
        {
          "value": "24",
          "label": "24px"
        }
      ],
      "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}"
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Legacy: Body weight",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        }
      ],
      "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}"
    }
  ],
  "presets": [
    {
      "name": "About \u2014 Split"
    }
  ]
}
{% endschema %}
