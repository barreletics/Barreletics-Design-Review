{% comment %}
  Blog Listing Section
  Displays articles in a responsive grid with featured image, title, excerpt,
  author, date, and category tag. Includes pagination.
  Used on: blog.json
{% endcomment %}

<section class="section" id="shopify-section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="section__inner">
    {% if section.settings.title != blank %}
      <div class="blog-listing__header">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 class="blog-listing__title type-hero">{{ section.settings.title }}</h1>
        {% if section.settings.subtitle != blank %}
          <p class="blog-listing__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if blog.articles.size > 0 %}
      <div class="blog-listing__grid">
        {% paginate blog.articles by section.settings.articles_per_page %}
          {% for article in blog.articles %}
            <article class="blog-card">
              <a href="{{ article.url }}" class="blog-card__link" aria-label="Read {{ article.title }}">
                <div class="blog-card__image-wrap">
                  {% if article.image %}
                    <img
                      src="{{ article.image | image_url: width: 720 }}"
                      srcset="{{ article.image | image_url: width: 360 }} 360w,
                              {{ article.image | image_url: width: 540 }} 540w,
                              {{ article.image | image_url: width: 720 }} 720w"
                      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                      alt="{{ article.image.alt | escape }}"
                      loading="lazy"
                      class="blog-card__image"
                    >
                  {% else %}
                    <div class="blog-card__image-placeholder"></div>
                  {% endif %}
                  {% if article.tags.size > 0 %}
                    <span class="blog-card__tag">{{ article.tags.first }}</span>
                  {% endif %}
                </div>
                <div class="blog-card__content">
                  <h2 class="blog-card__title">{{ article.title }}</h2>
                  {% if article.excerpt != blank %}
                    <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
                  {% endif %}
                  <div class="blog-card__meta">
                    <span class="blog-card__author">{{ article.author }}</span>
                    <span class="blog-card__date">
                      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                        {{ article.published_at | date: '%B %d, %Y' }}
                      </time>
                    </span>
                  </div>
                </div>
              </a>
            </article>
          {% endfor %}

          {% if paginate.pages > 1 %}
            <nav class="blog-listing__pagination" aria-label="Blog pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="btn btn--secondary blog-listing__prev" aria-label="Previous page">← Previous</a>
              {% endif %}
              <span class="blog-listing__page-info">
                Page {{ paginate.current_page }} of {{ paginate.pages }}
              </span>
              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="btn btn--secondary blog-listing__next" aria-label="Next page">Next →</a>
              {% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>
    {% else %}
      <p class="blog-listing__empty">No articles yet. Check back soon.</p>
    {% endif %}
  </div>
</section>

<style>
  .blog-listing__header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .blog-listing__title {
    font-size: var(--type-hero-size);
    font-weight: var(--type-hero-weight);
    line-height: var(--type-hero-leading);
    letter-spacing: var(--type-hero-tracking);
    text-transform: none;
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .blog-listing__subtitle {
    font-size: var(--text-md);
    color: var(--text-body);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .blog-listing__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
  }

  .blog-card {
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-primary);
    border: 1px solid var(--border-default);
    transition: box-shadow var(--transition-fast);
  }

  .blog-card:hover {
    box-shadow: var(--shadow-md);
  }

  .blog-card__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .blog-card__image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-alternate);
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.03);
  }

  .blog-card__image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--bg-alternate), var(--border-default));
  }

  .blog-card__tag {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: 4px 8px;
    border-radius: var(--radius-badge);
  }

  .blog-card__content {
    padding: var(--space-5);
  }

  .blog-card__title {
    font-size: var(--type-section-size);
    font-weight: var(--type-section-weight);
    line-height: var(--type-section-leading);
    letter-spacing: var(--type-section-tracking);
    text-transform: none;
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .blog-card__excerpt {
    font-size: var(--text-base);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-3);
  }

  .blog-card__meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .blog-card__author {
    font-weight: var(--weight-medium);
  }

  .blog-listing__pagination {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .blog-listing__page-info {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .blog-listing__empty {
    text-align: center;
    font-size: var(--text-md);
    color: var(--text-muted);
    padding: var(--space-12) 0;
  }

  @media (max-width: 1024px) {
    .blog-listing__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .blog-listing__title {
      font-size: var(--text-3xl);
    }

    .blog-listing__grid {
      grid-template-columns: 1fr;
      gap: var(--grid-gap-sm);
    }
  }
</style>

{% schema %}
{
  "name": "Blog Listing",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Journal"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Barreletics Journal"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Studio tips, product insights, and performance stories."
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "Blog Listing"
    }
  ]
}
{% endschema %}
