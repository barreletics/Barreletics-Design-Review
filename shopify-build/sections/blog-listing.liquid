{% comment %}
  Blog Listing Section (Journal index)
  Masthead → curated topic filter → featured article → editorial article grid → pagination.
  Authority: docs/Barreletics Journal - Definitive-v5.html (hub Locked).
  Used on: blog.json

  ANTI-REVERT / fix-forward: replace blog.all_tags dump with curated TE topic blocks
  (All · Care · Founder · Movement · Story · Wellness). Do not invent a full-bleed image hero.
{% endcomment %}

{%- liquid
  assign has_featured = false
  assign featured_id = 0

  if section.settings.show_featured and blog.articles.size > 0
    if section.settings.featured_article != blank
      assign featured = section.settings.featured_article
    else
      assign featured = blog.articles.first
    endif

    if featured != blank
      assign has_featured = true
      assign featured_id = featured.id
    endif
  endif

  if has_featured
    assign f_dek = featured.excerpt | strip_html | strip_newlines | strip
    if f_dek == blank
      assign f_dek = featured.content | strip_html | strip_newlines | truncatewords: 30
    endif

    # No read-time metafield exists on articles (article-content.liquid renders none),
    # so derive it from the body at 200 wpm and round up — never below 1 min.
    assign f_words = featured.content | strip_html | strip_newlines | split: ' ' | size
    assign f_read = f_words | divided_by: 200.0 | ceil
    if f_read < 1
      assign f_read = 1
    endif

    assign meta_bits = ''
    if featured.tags.size > 0
      assign meta_bits = meta_bits | append: featured.tags.first | append: '|'
    endif
    if section.settings.featured_label != blank
      assign meta_bits = meta_bits | append: section.settings.featured_label | append: '|'
    endif
    if section.settings.show_read_time
      assign meta_bits = meta_bits | append: f_read | append: ' min|'
    endif
    assign f_meta = meta_bits | split: '|' | join: ' · '
  endif

  # The featured article is pulled out of the grid below, so the grid can end up empty
  # on a one-article blog.
  assign grid_count = blog.articles.size
  if has_featured
    for a in blog.articles
      if a.id == featured_id
        assign grid_count = grid_count | minus: 1
        break
      endif
    endfor
  endif

  assign topic_blocks = section.blocks | where: 'type', 'topic'
  assign show_topic_nav = false
  if section.settings.show_topics
    if topic_blocks.size > 0 or section.settings.topics_all_label != blank
      assign show_topic_nav = true
    endif
  endif

  assign active_tag_handle = ''
  if current_tags.size > 0
    assign active_tag_handle = current_tags.first | handle
  endif
-%}

<section class="section blog-listing" id="shopify-section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="section__inner">
    {% if section.settings.title != blank %}
      <header class="blog-listing__header">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 class="blog-listing__title type-hero">{{ section.settings.title }}</h1>
        {% if section.settings.subtitle != blank %}
          <p class="blog-listing__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </header>
    {% endif %}

    {% if show_topic_nav %}
      <nav class="journal-topics" aria-label="Topics">
        <a
          href="{{ blog.url }}"
          class="journal-topics__link{% if current_tags.size == 0 %} is-active{% endif %}"
          {% if current_tags.size == 0 %}aria-current="page"{% endif %}
        >{{ section.settings.topics_all_label | default: 'All' }}</a>
        {% for block in topic_blocks %}
          {%- liquid
            assign topic_label = block.settings.label | strip
            if topic_label == blank
              continue
            endif
            assign topic_tag = block.settings.tag | strip
            if topic_tag == blank
              assign topic_tag = topic_label
            endif
            assign topic_handle = topic_tag | handle
            assign topic_active = false
            if active_tag_handle != blank and active_tag_handle == topic_handle
              assign topic_active = true
            elsif current_tags contains topic_tag
              assign topic_active = true
            endif
          -%}
          <a
            href="{{ blog.url }}/tagged/{{ topic_handle }}"
            class="journal-topics__link{% if topic_active %} is-active{% endif %}"
            {% if topic_active %}aria-current="page"{% endif %}
            {{ block.shopify_attributes }}
          >{{ topic_label }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    {% if has_featured %}
      <article class="journal-feature">
        <a class="journal-feature__media" href="{{ featured.url }}" aria-label="Read {{ featured.title | escape }}" tabindex="-1">
          {% if featured.image %}
            <img
              src="{{ featured.image | image_url: width: 1200 }}"
              srcset="{{ featured.image | image_url: width: 600 }} 600w,
                      {{ featured.image | image_url: width: 900 }} 900w,
                      {{ featured.image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 1024px) 100vw, 55vw"
              alt="{{ featured.image.alt | escape }}"
              width="1200"
              height="900"
              loading="eager"
              class="journal-feature__image"
            >
          {% else %}
            <div class="journal-feature__placeholder"></div>
          {% endif %}
        </a>
        <div class="journal-feature__copy">
          {% if f_meta != blank %}
            <p class="journal-feature__meta">{{ f_meta }}</p>
          {% endif %}
          <h2 class="journal-feature__title type-statement">
            <a href="{{ featured.url }}">{{ featured.title }}</a>
          </h2>
          {% if f_dek != blank %}
            <p class="journal-feature__dek">{{ f_dek }}</p>
          {% endif %}
          {% if section.settings.featured_cta_label != blank %}
            <a href="{{ featured.url }}" class="btn btn--primary journal-feature__cta">
              {{ section.settings.featured_cta_label }}
            </a>
          {% endif %}
        </div>
      </article>
    {% endif %}

    {% if grid_count > 0 %}
      <div class="blog-listing__grid">
        {% paginate blog.articles by section.settings.articles_per_page %}
          {% for article in blog.articles %}
            {% if article.id == featured_id %}{% continue %}{% endif %}
            {%- liquid
              assign a_words = article.content | strip_html | strip_newlines | split: ' ' | size
              assign a_read = a_words | divided_by: 200.0 | ceil
              if a_read < 1
                assign a_read = 1
              endif
              assign a_meta = ''
              if article.tags.size > 0
                assign a_meta = article.tags.first
              endif
              if section.settings.show_read_time
                if a_meta != blank
                  assign a_meta = a_meta | append: ' · ' | append: a_read | append: ' min'
                else
                  assign a_meta = a_read | append: ' min'
                endif
              endif
              assign a_dek = article.excerpt | strip_html | strip_newlines | strip
              if a_dek == blank
                assign a_dek = article.content | strip_html | strip_newlines | truncatewords: 22
              else
                assign a_dek = a_dek | truncate: 140
              endif
            -%}
            <a href="{{ article.url }}" class="blog-card" aria-label="Read {{ article.title | escape }}">
              <div class="blog-card__media">
                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 720 }}"
                    srcset="{{ article.image | image_url: width: 360 }} 360w,
                            {{ article.image | image_url: width: 540 }} 540w,
                            {{ article.image | image_url: width: 720 }} 720w"
                    sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                    alt="{{ article.image.alt | escape }}"
                    width="720"
                    height="540"
                    loading="lazy"
                    class="blog-card__image"
                  >
                {% else %}
                  <div class="blog-card__image-placeholder"></div>
                {% endif %}
              </div>
              {% if a_meta != blank %}
                <p class="blog-card__meta">{{ a_meta }}</p>
              {% endif %}
              <h2 class="blog-card__title">{{ article.title }}</h2>
              {% if a_dek != blank %}
                <p class="blog-card__excerpt">{{ a_dek }}</p>
              {% endif %}
            </a>
          {% endfor %}

          {% if paginate.pages > 1 %}
            <nav class="blog-listing__pagination" aria-label="Blog pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="btn btn--secondary blog-listing__prev" aria-label="Previous page">← Previous</a>
              {% endif %}
              <span class="blog-listing__page-info">
                Page {{ paginate.current_page }} of {{ paginate.pages }}
              </span>
              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="btn btn--secondary blog-listing__next" aria-label="Next page">Next →</a>
              {% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>
    {% elsif blog.articles.size == 0 %}
      <p class="blog-listing__empty">{{ section.settings.empty_text }}</p>
    {% endif %}
  </div>
</section>

<style>
  .blog-listing__header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto var(--space-10);
  }

  .blog-listing__header .eyebrow {
    margin: 0 0 var(--gap-a);
  }

  /* Size/weight/tracking come from .type-hero — cadence only here */
  .blog-listing__title {
    color: var(--text-primary);
    margin: 0 0 var(--gap-b);
  }

  .blog-listing__subtitle {
    font-size: var(--type-lede-size);
    font-weight: var(--type-lede-weight);
    line-height: var(--type-lede-leading);
    color: var(--text-body);
    max-width: 38ch;
    margin: 0 auto;
  }

  /* --- Topic filter — Locked v5: centred curated labels + hairline rule --- */
  .journal-topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    margin: 0 0 var(--space-11);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--border-default);
  }

  .journal-topics__link {
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: var(--type-label-color);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .journal-topics__link:hover,
  .journal-topics__link.is-active {
    color: var(--text-primary);
  }

  .journal-topics__link.is-active {
    border-bottom: 1px solid var(--text-primary);
    padding-bottom: 2px;
  }

  /* --- Featured article — image left, copy right --- */
  .journal-feature {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-10);
    align-items: center;
    margin-bottom: var(--space-13);
  }

  .journal-feature__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-button);
    background: var(--bg-alternate);
  }

  .journal-feature__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .journal-feature:hover .journal-feature__image {
    transform: scale(1.03);
  }

  .journal-feature__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--bg-alternate), var(--border-default));
  }

  .journal-feature__meta {
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: var(--accent-primary);
    margin: 0 0 var(--gap-a);
  }

  /* Size/weight/tracking come from .type-statement — cadence only here */
  .journal-feature__title {
    margin: 0 0 var(--gap-a);
  }

  .journal-feature__title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .journal-feature__title a:hover {
    color: var(--accent-primary);
  }

  .journal-feature__dek {
    font-size: var(--type-body-size);
    font-weight: var(--type-body-weight);
    line-height: var(--type-body-leading);
    color: var(--text-body);
    max-width: 36ch;
    margin: 0 0 var(--gap-c);
  }

  .journal-feature__cta {
    text-decoration: none;
  }

  .blog-listing__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 28px;
  }

  /* Locked v5: borderless editorial cards — meta above title, no card chrome */
  .blog-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: transparent;
    border: 0;
    border-radius: 0;
    overflow: visible;
    box-shadow: none;
  }

  .blog-card:hover {
    text-decoration: none;
    box-shadow: none;
  }

  .blog-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-button);
    background: var(--bg-alternate);
    margin-bottom: 18px;
  }

  .blog-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.04);
  }

  .blog-card__image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--bg-alternate), var(--border-default));
  }

  .blog-card__meta {
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 10px;
  }

  .blog-card__title {
    font-size: 22px;
    font-weight: var(--type-h3-weight);
    line-height: var(--type-h3-leading);
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--text-primary);
    margin: 0 0 10px;
  }

  .blog-card:hover .blog-card__title {
    color: var(--accent-primary);
  }

  .blog-card__excerpt {
    font-size: 15px;
    font-weight: var(--type-body-weight);
    color: var(--text-body);
    line-height: 1.5;
    margin: 0;
    max-width: 34ch;
  }

  .blog-listing__pagination {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-default);
  }

  .blog-listing__page-info {
    font-size: var(--type-trust-size);
    font-weight: var(--type-trust-weight);
    color: var(--text-muted);
  }

  .blog-listing__empty {
    text-align: center;
    font-size: var(--type-body-size);
    font-weight: var(--type-body-weight);
    line-height: var(--type-body-leading);
    color: var(--text-muted);
    padding: var(--space-12) 0;
  }

  @media (max-width: 1024px) {
    .blog-listing__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .journal-feature {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  @media (max-width: 768px) {
    .blog-listing__grid {
      grid-template-columns: 1fr;
      gap: var(--grid-gap-sm);
    }

    .blog-listing__header {
      margin-bottom: var(--space-9);
    }

    .journal-topics {
      gap: var(--space-2) var(--space-4);
      margin-bottom: var(--space-9);
    }

    /* Filter links are 11px labels — give them a 44px tap target on touch */
    .journal-topics__link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .journal-feature {
      margin-bottom: var(--space-10);
    }
  }
</style>

{% schema %}
{
  "name": "Blog Listing",
  "settings": [
    {
      "type": "header",
      "content": "Masthead"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The journal"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "From the Studio"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Lede",
      "default": "Studio care, founder notes, and pose-proof stories — then shop Secure in Every Hold."
    },

    {
      "type": "header",
      "content": "Topic filter"
    },
    {
      "type": "paragraph",
      "content": "Curated editorial topics (Locked Journal). Add Topic blocks below — do not dump every blog SEO tag. Links use /tagged/{handle}; empty tag results if that tag is missing on articles."
    },
    {
      "type": "checkbox",
      "id": "show_topics",
      "label": "Show topic filter",
      "default": true
    },
    {
      "type": "text",
      "id": "topics_all_label",
      "label": "\"All\" label",
      "default": "All"
    },

    {
      "type": "header",
      "content": "Featured article"
    },
    {
      "type": "paragraph",
      "content": "Large image-left card under the masthead. Defaults to the most recent article on this blog. The featured article is removed from the grid below so it never appears twice."
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Show featured article",
      "default": true
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "Featured article",
      "info": "Leave empty to use the most recent article."
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Featured label",
      "default": "Featured",
      "info": "Middle item of the meta line: tag · label · read time."
    },
    {
      "type": "checkbox",
      "id": "show_read_time",
      "label": "Show read time",
      "default": true,
      "info": "Estimated from the article body at 200 words per minute."
    },
    {
      "type": "text",
      "id": "featured_cta_label",
      "label": "Button label",
      "default": "Read the guide"
    },

    {
      "type": "header",
      "content": "Article grid"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 9
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "No articles yet. Check back soon."
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Care"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Blog tag (for /tagged/ filter)",
          "info": "Must match an article tag (case-insensitive handle). Defaults to the label if blank.",
          "default": "Care"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog Listing",
      "blocks": [
        { "type": "topic", "settings": { "label": "Care", "tag": "Care" } },
        { "type": "topic", "settings": { "label": "Founder", "tag": "Founder" } },
        { "type": "topic", "settings": { "label": "Movement", "tag": "Movement" } },
        { "type": "topic", "settings": { "label": "Story", "tag": "Story" } },
        { "type": "topic", "settings": { "label": "Wellness", "tag": "Wellness" } }
      ]
    }
  ]
}
{% endschema %}
