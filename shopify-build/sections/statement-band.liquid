{% comment %}
  Statement band — cream solo slogan (Home WORKING 6b).
  Full-bleed lifestyle commit lives in fullbleed-statement.
{% endcomment %}

<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="statement-band align-band"
  aria-label="{{ section.settings.title | escape }}"
>
  <div class="statement-band__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="statement-band__eyebrow type-label">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <p class="statement-band__line type-statement">{{ section.settings.title }}</p>
    {% if section.settings.subhead != blank %}
      <p class="statement-band__sub">{{ section.settings.subhead }}</p>
    {% endif %}
    {% if section.settings.cta_text != blank %}
      <a class="statement-band__cta" href="{{ section.settings.cta_url | default: '#variants' }}">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  .statement-band {
    padding: 96px 40px;
    background: #f5f2ec;
    text-align: center;
    border-top: 1px solid #e8e2d8;
    border-bottom: 1px solid #e8e2d8;
    color: #1c1916;
  }
  .statement-band__inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .statement-band__eyebrow {
    margin: 0 0 var(--gap-a, 16px);
    color: #6b645a;
  }
  .statement-band__line {
    margin: 0 auto var(--gap-b, 20px);
    color: #1c1916;
    max-width: var(--type-section-measure-wide, 28ch);
  }
  .statement-band__sub {
    font-size: 16px;
    font-weight: 400;
    color: #4a4a4a;
    line-height: 1.45;
    margin: 0 auto 28px;
    max-width: 36ch;
  }
  .statement-band__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 28px;
    background: #1c1916;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid #1c1916;
  }
  .statement-band__cta:hover {
    background: #c45c3f;
    border-color: #c45c3f;
    color: #fff;
  }
  @media (max-width: 768px) {
    .statement-band { padding: 64px 16px; }
  }
</style>

{% schema %}
{
  "name": "Statement band",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "knock-socks" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank unless distinct from the statement." },
    {
      "type": "text",
      "id": "title",
      "label": "Statement",
      "default": "Let us knock your socks off"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Support",
      "default": "Safely push harder in every studio move."
    },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop Now" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [{ "name": "Statement band" }]
}
{% endschema %}
