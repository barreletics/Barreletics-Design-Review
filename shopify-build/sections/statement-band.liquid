{% comment %}
  Statement band — cream solo slogan (Home WORKING 6b).
  Full-bleed lifestyle commit lives in fullbleed-statement.
{% endcomment %}
{% liquid
  assign title_size = section.settings.title_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign title_role = section.settings.title_role | default: 'statement'
  assign body_size = section.settings.body_size | default: 'default'
  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_href = cta_target
  else
    assign cta_href = section.settings.cta_url
  endif
  assign cta_style = section.settings.cta_style | default: 'solid'
  assign cta_bg = section.settings.cta_bg_color | default: '#1c1916'
  assign cta_border = section.settings.cta_border_color | default: cta_bg
  assign cta_text_color = section.settings.cta_text_color | default: '#ffffff'
  assign region_label = section.settings.aria_label | strip
  if region_label == blank
    assign region_label = section.settings.title
  endif
%}

<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} statement-band align-band"
  style="{% render 'section-inset-vars' %} 
    --sb-cta-bg: {{ cta_bg }};
    --sb-cta-border: {{ cta_border }};
    --sb-cta-text: {{ cta_text_color }};
    {% if title_size != 'default' %}--sb-title-size: {{ title_size }}px;{% endif %}
    {% if title_weight != 'default' %}--sb-title-weight: {{ title_weight }};{% endif %}
    {% if body_size != 'default' %}--sb-body-size: {{ body_size }}px;{% endif %}
  "
  {% if region_label != blank %}aria-label="{{ region_label | escape }}"{% endif %}
>
  <div class="statement-band__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="statement-band__eyebrow type-label">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <p class="statement-band__line {% if title_role == 'display' %}h2-display{% else %}type-statement{% endif %}">{{ section.settings.title }}</p>
    {% if section.settings.subhead != blank %}
      <p class="statement-band__sub">{{ section.settings.subhead }}</p>
    {% endif %}
    {% if section.settings.cta_text != blank %}
      <a class="statement-band__cta{% if cta_style == 'outline' %} statement-band__cta--outline{% endif %}" href="{{ cta_href | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .statement-band {
    padding: 96px 40px;
    background: #f5f2ec;
    text-align: center;
    border-top: 1px solid #e8e2d8;
    border-bottom: 1px solid #e8e2d8;
    color: #1c1916;
  }
  #shopify-section-{{ section.id }} .statement-band__inner {
    max-width: {% if title_role == 'display' %}1100px{% else %}820px{% endif %};
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .statement-band__eyebrow {
    margin: 0 0 var(--gap-a, 16px);
    color: #6b645a;
  }
  #shopify-section-{{ section.id }} .statement-band__line {
    font-size: var(--sb-title-size, {% if title_role == 'display' %}var(--type-h2-display-size){% else %}var(--type-statement-size){% endif %});
    font-weight: var(--sb-title-weight, {% if title_role == 'display' %}var(--type-h2-display-weight){% else %}var(--type-statement-weight){% endif %});
    letter-spacing: {% if title_role == 'display' %}var(--type-h2-display-tracking){% else %}var(--type-statement-tracking){% endif %};
    line-height: {% if title_role == 'display' %}var(--type-h2-display-leading){% else %}var(--type-statement-leading){% endif %};
    margin: 0 auto var(--gap-a);
    color: var(--text-primary);
    max-width: none;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .statement-band__line {
      font-size: var(--sb-title-size, {% if title_role == 'display' %}var(--type-h2-display-size-mobile){% else %}var(--type-statement-size-mobile){% endif %});
    }
  }
  #shopify-section-{{ section.id }} .statement-band__sub {
    font-size: var(--sb-body-size, var(--type-body-size));
    font-weight: var(--type-body-weight);
    color: var(--text-body);
    line-height: var(--type-body-leading);
    margin: 0 auto var(--gap-c);
    max-width: 36ch;
  }
  #shopify-section-{{ section.id }} .statement-band__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
    background: var(--sb-cta-bg, #1c1916);
    color: var(--sb-cta-text, #fff);
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    line-height: var(--type-cta-leading, 1);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid var(--sb-cta-border, var(--sb-cta-bg, #1c1916));
    transition: opacity 0.15s ease;
  }
  #shopify-section-{{ section.id }} .statement-band__cta--outline {
    background: transparent;
    color: var(--sb-cta-text, var(--sb-cta-border, #1c1916));
  }
  #shopify-section-{{ section.id }} .statement-band__cta:hover {
    opacity: 0.92;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .statement-band { padding: 56px 20px; }
  }
</style>

{% schema %}
{
  "name": "Statement band",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank unless distinct from the statement." },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Let us knock your socks off",
      "info": "Family is brand Type OS — use Title size/weight to adjust. No font family picker."
    },
    {
      "type": "select",
      "id": "title_role",
      "label": "Title Type OS role",
      "options": [
        { "value": "statement", "label": "Statement (default)" },
        { "value": "display", "label": "H2 Display — large brand" }
      ],
      "default": "statement",
      "info": "Hero stays page-opening only. Display is the large brand face."
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" },
        { "value": "24", "label": "24px" },
        { "value": "26", "label": "26px" },
        { "value": "28", "label": "28px" },
        { "value": "30", "label": "30px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "56", "label": "56px" }

      ],
      "default": "default",
      "info": "Family is brand Type OS — size only. Independent size for this statement line. Default keeps Type OS."
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Body",
      "default": "Safely push harder in every studio move.",
      "info": "Family is brand Type OS — use Body size to adjust. No font family picker."
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" },
        { "value": "24", "label": "24px" },
        { "value": "26", "label": "26px" },
        { "value": "28", "label": "28px" },
        { "value": "30", "label": "30px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "56", "label": "56px" }

      ],
      "default": "default"
    },
    { "type": "text", "id": "cta_text", "label": "CTA label", "default": "Shop Now" },
    
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "options": [
        { "value": "solid", "label": "Solid fill" },
        { "value": "outline", "label": "Outline only" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA background color",
      "default": "#1c1916",
      "info": "Used for solid fill. Outline style uses transparent fill + border color."
    },
    {
      "type": "color",
      "id": "cta_border_color",
      "label": "CTA outline / border color",
      "default": "#1c1916"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA label color",
      "default": "#ffffff",
      "info": "Solid fill: usually white. Outline or light fill: charcoal/black."
    },
    {
      "type": "select",
      "id": "cta_link_target",
      "label": "CTA link",
      "options": [
        { "value": "custom", "label": "Custom URL…" },
        { "value": "#variants", "label": "#variants — Shop styles" },
        { "value": "#knock-socks", "label": "#knock-socks — Statement" },
        { "value": "#reviews", "label": "#reviews" },
        { "value": "#guarantee", "label": "#guarantee" },
        { "value": "#never-loses-grip", "label": "#never-loses-grip" },
        { "value": "#one-pair", "label": "#one-pair" },
        { "value": "#coperni", "label": "#coperni — Collab" },
        { "value": "#problem", "label": "#problem" }
      ],
      "default": "custom",
      "info": "Homepage section anchors jump on the same page. Choose Custom URL… for a full URL or any other #hash. Blank custom → all-products collection."
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Custom CTA URL",
      "info": "Used when CTA link = Custom URL…."
    },
    { "type": "header", "content": "Section — Statement band" },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "knock-socks",
      "info": "This section’s own ID for same-page jumps (e.g. #knock-socks from hero tag / CTAs)."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria-label",
      "info": "Accessibility name for screen readers — not visible on the page. Leave blank to use the Heading."
    },
    { "type": "header", "content": "Shared — Section frame" },
    {
      "type": "paragraph",
      "content": "OUTER inset from the page edges (margin). Top and bottom are independent; left & right = one control. Custom mobile OFF = mobile uses the same inset as desktop. Defaults 0 = full bleed."
    },
    {
      "type": "checkbox",
      "id": "inset_custom_mobile",
      "label": "Custom mobile inset",
      "default": false,
      "info": "OFF (default): ignore the mobile inset sliders — mobile uses desktop Inset top / bottom / left & right. ON: use the mobile inset sliders instead."
    },
    {
      "type": "range",
      "id": "inset_top",
      "label": "Inset top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_bottom",
      "label": "Inset bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x",
      "label": "Inset left & right",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Same value on both sides."
    },
    {
      "type": "range",
      "id": "inset_top_mobile",
      "label": "Inset top — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "range",
      "id": "inset_bottom_mobile",
      "label": "Inset bottom — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x_mobile",
      "label": "Inset left & right — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],

  "presets": [{ "name": "Statement band" }]
}
{% endschema %}
