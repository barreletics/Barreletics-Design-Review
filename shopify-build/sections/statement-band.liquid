{% comment %}
  Full-bleed statement band — dark band max 2 tiers (statement + support)
{% endcomment %}

<section class="statement-band section--campaign align-band" aria-label="{{ section.settings.title | escape }}">
  <div class="statement-band__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="statement-band__eyebrow type-label">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <p class="statement-band__title type-statement type-section--wide">{{ section.settings.title }}</p>
    {% if section.settings.subhead != blank or section.settings.meta != blank %}
      <p class="statement-band__support">
        {% if section.settings.subhead != blank %}{{ section.settings.subhead }}{% endif %}
        {% if section.settings.subhead != blank and section.settings.meta != blank %} {% endif %}
        {% if section.settings.meta != blank %}{{ section.settings.meta }}{% endif %}
      </p>
    {% endif %}
    {% if section.settings.cta_text != blank %}
      {% assign sb_href = section.settings.cta_url | default: '/collections/grippy-shoes' %}
      <a class="statement-band__cta" href="{{ sb_href }}">{{ section.settings.cta_text }}</a>
    {% endif %}
  </div>
</section>

<style>
  .statement-band {
    position: relative;
    padding: var(--section-padding-y-campaign) var(--section-padding-x);
    background:
      linear-gradient(135deg, rgba(28, 25, 22, 0.72), rgba(28, 25, 22, 0.45)),
      #6b645a;
    color: #fff;
    text-align: var(--align-band);
  }
  .statement-band__inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .statement-band__eyebrow {
    margin: 0 0 var(--stack-campaign-eyebrow);
    color: var(--type-dark-support-color);
  }
  .statement-band__title {
    margin: 0 auto var(--stack-campaign-after-title);
    color: #ffffff;
    max-width: var(--type-section-measure-wide);
  }
  /* Dark band tier 2 only — no third text tier */
  .statement-band__support {
    margin: 0 auto var(--stack-campaign-to-cta);
    font-size: var(--type-dark-support-size);
    font-weight: var(--type-dark-support-weight);
    line-height: var(--type-body-leading);
    color: var(--type-dark-support-color);
    max-width: 42ch;
  }
  .statement-band__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 16px 40px;
    background: #fff;
    color: #1c1916;
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-button);
  }
  .statement-band__cta:hover {
    background: #c45c3f;
    color: #fff;
  }
  @media (max-width: 768px) {
    .statement-band {
      padding: var(--section-padding-y-campaign-mobile) var(--section-padding-x-mobile);
    }
  }
</style>

{% schema %}
{
  "name": "Statement band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank unless distinct from the statement." },
    {
      "type": "text",
      "id": "title",
      "label": "Statement",
      "default": "Studio workouts and footwear will never be the same.",
      "info": "Dark-band tier 1 — statement size/weight; one step below section H2."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Support",
      "default": "You commit to the class. Commit to the gear."
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Support (merged)",
      "default": "Trusted by 1,000's of instructors across barre, Pilates, and reformer studios.",
      "info": "Merged into the single dark-band support tier (same style as Support)."
    },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop Performance Skins" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [{ "name": "Statement band" }]
}
{% endschema %}
