{% comment %}
  Statement band — cream solo slogan (Home WORKING 6b).
  Full-bleed lifestyle commit lives in fullbleed-statement.
  GLOBAL HEADING SYSTEM (2026-09-27): line is locked 52 / 36 phone / 400.
  title_role / title_size / title_weight stay in the schema but are ignored.
{% endcomment %}
{% liquid
  assign body_size = section.settings.body_size | default: 'default'
  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_href = cta_target
  else
    assign cta_href = section.settings.cta_url
  endif
  assign cta_style = section.settings.cta_style | default: 'solid'
  assign cta_bg = section.settings.cta_bg_color | default: '#1c1916'
  assign cta_border = section.settings.cta_border_color | default: cta_bg
  assign cta_text_color = section.settings.cta_text_color | default: '#ffffff'
  assign band_bg = section.settings.bg_color | default: '#faf8f6'
  assign region_label = section.settings.aria_label | strip
  if region_label == blank
    assign region_label = section.settings.title
  endif
  assign open_knock_join = false
  if template.suffix == 'in-studio-template' or template.suffix == 'open-sole'
    if section.settings.title == 'Let us knock your socks off'
      assign open_knock_join = true
    endif
  endif
%}

<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} statement-band align-band"
  style="{% render 'section-inset-vars' %}{% render 'unified-text-pads-vars', y_d: 96, side_d: 40, y_m: 56, x_m: 20 %} 
    --sb-band-bg: {{ band_bg }};
    --sb-cta-bg: {{ cta_bg }};
    --sb-cta-border: {{ cta_border }};
    --sb-cta-text: {{ cta_text_color }};
    {% if body_size != 'default' %}--sb-body-size: {{ body_size }}px;{% endif %}
  "
  {% if region_label != blank %}aria-label="{{ region_label | escape }}"{% endif %}
>
  <div class="statement-band__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="statement-band__eyebrow type-label">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <p class="statement-band__line h2-display">{{ section.settings.title }}</p>
    {% if section.settings.subhead != blank %}
      <p class="statement-band__sub">{{ section.settings.subhead }}</p>
    {% endif %}
    {% if section.settings.cta_text != blank %}
      <a class="statement-band__cta{% if cta_style == 'outline' %} statement-band__cta--outline{% endif %}" href="{{ cta_href | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  {%- if section.settings.heading_size_override != blank %}
  #shopify-section-{{ section.id }} { {% render 'type-override-vars', title_size: section.settings.heading_size_override %} --te-title-size-n: {{ section.settings.heading_size_override }}; }
  {%- endif %}
  {%- assign _hso_n = section.settings.heading_size_override | plus: 0 -%}
  {%- if section.settings.heading_size_override != blank and _hso_n > 0 %}
  #shopify-section-{{ section.id }} { --section-heading-size-m: {{ _hso_n }}px; }
  {%- endif %}
  #shopify-section-{{ section.id }} .statement-band {
    padding: var(--utp-y-d, 96px) var(--utp-side-d, 40px);
    background: var(--sb-band-bg, #faf8f6);
    text-align: center;
    border-top: 1px solid #e8e2d8;
    border-bottom: 1px solid #e8e2d8;
    color: #1c1916;
  }
  {% if template.name == 'collection' %}
  #shopify-section-{{ section.id }} .statement-band {
    border-top: none;
  }
  {% endif %}
  {% if open_knock_join %}
  #shopify-section-{{ section.id }} {
    background: {{ band_bg }};
  }
  #shopify-section-{{ section.id }} .statement-band {
    border: none;
  }
  {% endif %}
  #shopify-section-{{ section.id }} .statement-band__inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .statement-band__eyebrow {
    margin: 0 0 var(--gap-a, 16px);
    color: #6b645a;
  }
  #shopify-section-{{ section.id }} .statement-band__line {
    margin: 0 auto var(--gap-a);
    color: var(--text-primary);
    max-width: none;
  }
  /* GLOBAL HEADING SYSTEM (locked 2026-09-27): one display head for this section type.
     52 desktop (fluid to 36 on tablet) / 36 phone / 400. Theme Editor title size, weight
     and role settings are intentionally ignored so every page renders the same. */
  #shopify-section-{{ section.id }} .statement-band__line.h2-display {
    font-size: clamp(var(--heading-phone, 36px), calc(var(--te-title-size-n, var(--heading-band-desktop-n, 52)) * 4.6vw / 52), var(--te-title-size, var(--heading-band-desktop, 52px)));
    font-weight: 400;
    line-height: var(--type-h2-display-leading, 1.1);
    letter-spacing: var(--type-h2-display-tracking, -0.028em);
    text-wrap: pretty; /* avoid one-word last lines (2026-09-27, Andrew) */
  }
  #shopify-section-{{ section.id }} .statement-band__line.h2-display strong,
  #shopify-section-{{ section.id }} .statement-band__line.h2-display b {
    font-weight: inherit;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .statement-band__line.h2-display {
      font-size: var(--section-heading-size-m, 36px);
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }
  }
  #shopify-section-{{ section.id }} .statement-band__sub {
    font-size: var(--sb-body-size, var(--type-body-size));
    font-weight: var(--type-body-weight);
    color: var(--text-body);
    line-height: var(--type-body-leading);
    margin: 0 auto var(--gap-c);
    max-width: 36ch;
  }
  #shopify-section-{{ section.id }} .statement-band__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
    background: var(--sb-cta-bg, #1c1916);
    color: var(--sb-cta-text, #fff);
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    line-height: var(--type-cta-leading, 1);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid var(--sb-cta-border, var(--sb-cta-bg, #1c1916));
    transition: opacity 0.15s ease;
  }
  #shopify-section-{{ section.id }} .statement-band__cta--outline {
    background: transparent;
    color: var(--sb-cta-text, var(--sb-cta-border, #1c1916));
  }
  #shopify-section-{{ section.id }} .statement-band__cta:hover {
    opacity: 0.92;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .statement-band {
      padding: var(--text-pad-mobile, var(--utp-y-m, 56px)) var(--utp-x-m, 20px);
      min-height: var(--text-min-h-mobile, auto);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    {%- if template.suffix == 'in-studio-template' %}
    /* Open Sole phone: match Sock era total section height (1013 at 390). Desktop unchanged. */
    #shopify-section-{{ section.id }} .statement-band {
      min-height: 1013px;
    }
    {%- endif %}
  }
</style>

{% render 'unified-text-pads-te-style', selector: '.statement-band', y_d: 96, side_d: 40, y_m: 56, x_m: 20 %}

{%- comment -%}
  TE live preview (2026-10-06): dual-write of the inline vars (unified text pads snippet + band/CTA colours),
  read from section.settings.* directly (fifty-fifty / acd8a93 / 108fff6 pattern). Values equal the CSS fallbacks
  at schema defaults, so no visual change at saved values. Keep render-free.
{%- endcomment -%}
{% style %}
  #shopify-section-{{ section.id }} .statement-band {
    --utp-y-d: {{ section.settings.text_pad_y | default: 96 }}px !important;
    --utp-side-d: {{ section.settings.side_padding | default: 40 }}px !important;
    --utp-y-m: {{ section.settings.text_pad_y_mobile | default: 56 }}px !important;
    --utp-x-m: {{ section.settings.text_pad_x_mobile | default: 20 }}px !important;
    --sb-band-bg: {{ section.settings.bg_color | default: '#faf8f6' }} !important;
    --sb-cta-bg: {{ section.settings.cta_bg_color | default: '#1c1916' }} !important;
    --sb-cta-border: {{ section.settings.cta_border_color | default: section.settings.cta_bg_color | default: '#1c1916' }} !important;
  }
{% endstyle %}

{%- comment -%}
  TE live preview (2026-10-06): Shared — Section frame insets. The section-inset-vars snippet writes these inline
  (Save-only). Same dual-write as split-hero (acd8a93): section.settings.* directly, !important on the vars.
{%- endcomment -%}
{% style %}
  {%- liquid
    assign te_in_t = section.settings.inset_top | default: 0
    assign te_in_b = section.settings.inset_bottom | default: 0
    assign te_in_x = section.settings.inset_x | default: 0
    if section.settings.inset_custom_mobile
      assign te_in_tm = section.settings.inset_top_mobile | default: 0
      assign te_in_bm = section.settings.inset_bottom_mobile | default: 0
      assign te_in_xm = section.settings.inset_x_mobile | default: 0
    else
      assign te_in_tm = te_in_t
      assign te_in_bm = te_in_b
      assign te_in_xm = te_in_x
    endif
  -%}
  #shopify-section-{{ section.id }} .section-frame {
    --section-inset-top: {{ te_in_t }}px !important;
    --section-inset-right: {{ te_in_x }}px !important;
    --section-inset-bottom: {{ te_in_b }}px !important;
    --section-inset-left: {{ te_in_x }}px !important;
    --section-inset-top-m: {{ te_in_tm }}px !important;
    --section-inset-right-m: {{ te_in_xm }}px !important;
    --section-inset-bottom-m: {{ te_in_bm }}px !important;
    --section-inset-left-m: {{ te_in_xm }}px !important;
  }
{% endstyle %}

{%- comment -%}
  TE live preview (2026-10-06, round 3): remaining Save-only controls. Reads section.settings.* directly
  (verified 10-03 pattern: acd8a93 / 108fff6). Values match what the inline style / static <style> render.
{%- endcomment -%}
{% style %}
  #shopify-section-{{ section.id }} .statement-band {
    --sb-cta-text: {{ section.settings.cta_text_color | default: '#ffffff' }} !important;
  }
{% endstyle %}

