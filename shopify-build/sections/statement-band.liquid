{% comment %}
  Full-bleed statement band — Tier 2 Campaign (Hold Display) + align-band
{% endcomment %}

<section class="statement-band section--campaign align-band" aria-label="{{ section.settings.title | escape }}">
  <div class="statement-band__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="statement-band__eyebrow type-label">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <p class="statement-band__title type-campaign type-campaign--mark type-campaign--wide">{{ section.settings.title }}</p>
    {% if section.settings.subhead != blank %}
      <p class="statement-band__sub type-lede">{{ section.settings.subhead }}</p>
    {% endif %}
    {% if section.settings.meta != blank %}
      <p class="statement-band__meta type-body">{{ section.settings.meta }}</p>
    {% endif %}
    {% if section.settings.cta_text != blank %}
      {% assign sb_href = section.settings.cta_url | default: '/collections/grippy-shoes' %}
      <a class="statement-band__cta" href="{{ sb_href }}">{{ section.settings.cta_text }}</a>
    {% endif %}
  </div>
</section>

<style>
  .statement-band {
    position: relative;
    padding: var(--section-padding-y-campaign) var(--section-padding-x);
    background:
      linear-gradient(135deg, rgba(28, 25, 22, 0.72), rgba(28, 25, 22, 0.45)),
      #6b645a;
    color: #fff;
    text-align: var(--align-band);
  }
  .statement-band__inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .statement-band__eyebrow {
    margin: 0 0 var(--stack-campaign-eyebrow);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
  .statement-band__title {
    margin: 0 auto var(--stack-campaign-after-title);
    color: #fff;
    max-width: var(--type-campaign-measure-wide);
  }
  .statement-band__title.type-campaign--mark::after {
    margin-left: auto;
    margin-right: auto;
  }
  .statement-band__sub {
    margin: 0 auto 20px;
    font-size: var(--type-lede-size);
    font-weight: var(--type-lede-weight);
    line-height: var(--type-lede-leading);
    color: rgba(255, 255, 255, 0.92);
    max-width: 36ch;
  }
  .statement-band__meta {
    margin: 0 auto var(--stack-campaign-to-cta);
    font-size: var(--type-body-size-sm);
    font-weight: var(--type-body-weight);
    line-height: var(--type-body-leading);
    color: rgba(255, 255, 255, 0.72);
    max-width: 42ch;
  }
  .statement-band__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 16px 40px;
    background: #fff;
    color: #1c1916;
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-button);
  }
  .statement-band__cta:hover {
    background: #c45c3f;
    color: #fff;
  }
  @media (max-width: 768px) {
    .statement-band {
      padding: var(--section-padding-y-campaign-mobile) var(--section-padding-x-mobile);
    }
  }
</style>

{% schema %}
{
  "name": "Statement band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    {
      "type": "text",
      "id": "title",
      "label": "Statement",
      "default": "Studio Workouts and Footwear Will Never Be the Same"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "You Commit to the Class. Commit to the Gear."
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Meta line",
      "default": "Trusted by 1,000's of instructors across barre, Pilates, and reformer studios."
    },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop Performance Skins" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [{ "name": "Statement band" }]
}
{% endschema %}
