        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" },
        { "value": "24", "label": "24px" },
        { "value": "26", "label": "26px" },
        { "value": "28", "label": "28px" },
        { "value": "30", "label": "30px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
