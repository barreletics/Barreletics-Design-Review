{% comment %}
  Statement band — cream solo slogan (Home WORKING 6b).
  Full-bleed lifestyle commit lives in fullbleed-statement.
{% endcomment %}
{% liquid
  assign title_size = section.settings.title_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
%}

<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="statement-band align-band"
  style="
    {% if title_size != 'default' %}--sb-title-size: {{ title_size }}px;{% endif %}
    {% if title_weight != 'default' %}--sb-title-weight: {{ title_weight }};{% endif %}
    {% if body_size != 'default' %}--sb-body-size: {{ body_size }}px;{% endif %}
  "
  aria-label="{{ section.settings.title | escape }}"
>
  <div class="statement-band__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="statement-band__eyebrow type-label">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <p class="statement-band__line type-statement">{{ section.settings.title }}</p>
    {% if section.settings.subhead != blank %}
      <p class="statement-band__sub">{{ section.settings.subhead }}</p>
    {% endif %}
    {% if section.settings.cta_text != blank %}
      <a class="statement-band__cta" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .statement-band {
    padding: 96px 40px;
    background: #f5f2ec;
    text-align: center;
    border-top: 1px solid #e8e2d8;
    border-bottom: 1px solid #e8e2d8;
    color: #1c1916;
  }
  #shopify-section-{{ section.id }} .statement-band__inner {
    max-width: 820px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .statement-band__eyebrow {
    margin: 0 0 var(--gap-a, 16px);
    color: #6b645a;
  }
  #shopify-section-{{ section.id }} .statement-band__line {
    font-size: var(--sb-title-size, clamp(32px, 4.5vw, 48px)) !important;
    font-weight: var(--sb-title-weight, 400) !important;
    letter-spacing: -0.03em !important;
    line-height: 1.12 !important;
    margin: 0 auto 12px;
    color: #1c1916;
    max-width: none;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .statement-band__line {
      font-size: var(--sb-title-size, clamp(28px, 7vw, 36px)) !important;
    }
  }
  #shopify-section-{{ section.id }} .statement-band__sub {
    font-size: var(--sb-body-size, 16px);
    font-weight: 400;
    color: #4a4a4a;
    line-height: 1.45;
    margin: 0 auto 28px;
    max-width: 36ch;
  }
  #shopify-section-{{ section.id }} .statement-band__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 28px;
    background: #1c1916;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid #1c1916;
  }
  #shopify-section-{{ section.id }} .statement-band__cta:hover {
    background: #c45c3f;
    border-color: #c45c3f;
    color: #fff;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .statement-band { padding: 56px 20px; }
  }
</style>

{% schema %}
{
  "name": "Statement band",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank unless distinct from the statement." },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Let us knock your socks off"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "24", "label": "24px" },
        { "value": "28", "label": "28px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "52", "label": "52px" },
        { "value": "56", "label": "56px" }
      ],
      "default": "default",
      "info": "Independent size for this statement line (e.g. “Let us knock your socks off”). Default keeps Type OS."
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Body",
      "default": "Safely push harder in every studio move."
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "24", "label": "24px" },
        { "value": "28", "label": "28px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "cta_text", "label": "CTA label", "default": "Shop Now" },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link",
      "info": "Collection/product/page URL for navigation. Use #anchors only to jump to a same-page section Anchor ID. Blank → all-products collection."
    },
    { "type": "header", "content": "Section — Statement band" },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "knock-socks",
      "info": "Enables jumps like #knock-socks from hero tag / CTAs."
    }
  ],
  "presets": [{ "name": "Statement band" }]
}
{% endschema %}
