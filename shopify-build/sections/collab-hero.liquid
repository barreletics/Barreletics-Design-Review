{% comment %}
  Collab hero — Home WORKING Coperni module (stage + 4-tile grid).
  Simplified from live br-collab-hero; exact-to-mock composition.
{% endcomment %}

{% liquid
  assign title_size = section.settings.title_size | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign media_radius = section.settings.media_radius | default: 0
%}
{% unless section.settings.enabled == false %}
<section
  id="{{ section.settings.anchor_id | default: 'coperni' | handleize }}"
  class="collab-hero"
  style="
    --ch-media-radius: {{ media_radius }}px;
    {% if title_size != 'default' %}--ch-title-size: {{ title_size }}px;{% endif %}
    {% if body_size != 'default' %}--ch-body-size: {{ body_size }}px;{% endif %}
    {% if title_weight != 'default' %}--ch-title-weight: {{ title_weight }};{% endif %}
  "
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="collab-hero__stage">
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          image_size: '2000x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'collab-hero__video'
      }}
    {% elsif section.settings.video_url != blank %}
      <video
        class="collab-hero__video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 2000 }}"
        {% elsif section.settings.poster_url != blank %}
          poster="{{ section.settings.poster_url | escape }}"
        {% endif %}
      >
        <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
      </video>
    {% elsif section.settings.image != blank %}
      <img
        class="collab-hero__video"
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt=""
        loading="lazy"
      >
    {% elsif section.settings.poster_url != blank %}
      <img class="collab-hero__video" src="{{ section.settings.poster_url | escape }}" alt="" loading="lazy">
    {% endif %}
    <div class="collab-hero__overlay">
      {% if section.settings.eyebrow != blank %}
        <p class="collab-hero__eye">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="collab-hero__title">{{ section.settings.title }}</h2>
      {% if section.settings.body != blank %}
        <p class="collab-hero__body">{{ section.settings.body }}</p>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a class="collab-hero__cta" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_text }}</a>
      {% endif %}
      {% if section.settings.meta != blank %}
        <p class="collab-hero__meta">{{ section.settings.meta }}</p>
      {% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="collab-hero__grid" role="region" aria-label="Featured campaign products">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}
          <a class="collab-hero__tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {% else %}
          <div class="collab-hero__tile" {{ block.shopify_attributes }}>
        {% endif %}
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.alt | escape }}" loading="lazy">
          {% elsif block.settings.image_url != blank %}
            <img src="{{ block.settings.image_url | escape }}" alt="{{ block.settings.alt | escape }}" loading="lazy">
          {% endif %}
          {% if block.settings.tile_title != blank or block.settings.tile_body != blank %}
            <div class="collab-hero__tile-copy">
              {% if block.settings.tile_eyebrow != blank %}
                <p class="collab-hero__tile-eye">{{ block.settings.tile_eyebrow }}</p>
              {% endif %}
              {% if block.settings.tile_title != blank %}
                <p class="collab-hero__tile-title">{{ block.settings.tile_title }}</p>
              {% endif %}
              {% if block.settings.tile_body != blank %}
                <p class="collab-hero__tile-body">{{ block.settings.tile_body }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>
{% endunless %}

<style>
  .collab-hero { background: #fff; }
  .collab-hero__stage {
    position: relative;
    width: 100%;
    height: 105vh;
    min-height: 640px;
    overflow: hidden;
    background: #1c1916;
    border-radius: var(--ch-media-radius, 0);
  }
  .collab-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.22);
    transform-origin: center center;
    display: block;
  }
  .collab-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 52px;
    box-sizing: border-box;
    max-width: none;
    color: #fff;
    background: linear-gradient(to bottom, rgba(0,0,0,0.09), rgba(0,0,0,0.37));
    pointer-events: none;
  }
  .collab-hero__overlay > * { pointer-events: auto; }
  .collab-hero__eye {
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    margin: 0 0 14px;
  }
  .collab-hero__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: var(--ch-title-size, clamp(36px, 5.5vw, 70px));
    font-weight: var(--ch-title-weight, 300);
    font-style: italic;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    max-width: 14ch;
    color: #fff;
  }
  .collab-hero__title em,
  .collab-hero__title strong {
    font-weight: 400;
    font-style: italic;
  }
  .collab-hero__body {
    font-size: var(--ch-body-size, 16px);
    line-height: 1.55;
    color: rgba(255,255,255,0.88);
    margin: 0 0 24px;
    max-width: 42ch;
  }
  .collab-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 28px;
    background: #fff;
    color: #1c1916;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    margin-bottom: 14px;
  }
  .collab-hero__cta:hover { background: #c45c3f; color: #fff; }
  .collab-hero__meta {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin: 0;
  }
  .collab-hero__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .collab-hero__tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f5f2ec;
    text-decoration: none;
    color: inherit;
  }
  .collab-hero__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .collab-hero__tile-copy {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px 18px;
    background: linear-gradient(180deg, rgba(28,25,22,0.1) 20%, rgba(28,25,22,0.78) 100%);
    color: #fff;
  }
  .collab-hero__tile-eye {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .collab-hero__tile-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .collab-hero__tile-body {
    font-size: 13px;
    line-height: 1.45;
    margin: 0;
    color: rgba(255,255,255,0.85);
  }
  @media (max-width: 900px) {
    .collab-hero__grid { grid-template-columns: 1fr 1fr; }
    .collab-hero__overlay { padding: 32px 20px 40px; }
    .collab-hero__title { max-width: none; }
  }
  @media (max-width: 768px) {
    .collab-hero__stage { height: 78vh; min-height: 480px; }
    .collab-hero__video { transform: scale(1.1); }
    .collab-hero__grid { grid-template-columns: 1fr; padding: 24px 16px 40px; gap: 12px; }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&family=Syne:wght@400;700&display=swap" rel="stylesheet">

{% schema %}
{
  "name": "Collab hero",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited Edition × Paris 2026" },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "<strong>Barreletics × Coperni</strong><br>Built for the body in motion.",
      "info": "HTML allowed for emphasis line breaks."
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "28", "label": "28px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "48", "label": "48px" },
        { "value": "56", "label": "56px" },
        { "value": "64", "label": "64px" },
        { "value": "72", "label": "72px" }
      ],
      "default": "default",
      "info": "Default keeps collab display size. Overrides size only — not font family."
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "A Pilates shoe designed for comfort, grounding, and athletic poise — introduced on the Coperni runway, Spring–Summer 2026."
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "24", "label": "24px" },
        { "value": "28", "label": "28px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "cta_text", "label": "CTA label", "default": "See the collaboration" },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link",
      "info": "Collection/product/page URL for navigation. Use #anchors only to jump to a same-page section Anchor ID."
    },
    { "type": "header", "content": "Shared — Media" },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video",
      "info": "Preferred when the file lives in Shopify Files. Use this OR Video URL — not both. Shopify video wins if both are set."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (mp4)",
      "default": "https://barreletics.com/cdn/shop/videos/c/vp/a91000a89fb04c70935becea5180b69e/a91000a89fb04c70935becea5180b69e.HD-1080p-7.2Mbps-43057645.mp4",
      "info": "External/CDN mp4 when not using Shopify Video. Ignored if Shopify video is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image / poster (Shopify)",
      "info": "Still fallback, OR poster when using Video URL. Prefer this over URL fields when the asset is in Shopify."
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "Poster URL fallback",
      "default": "https://barreletics.com/cdn/shop/files/yellow_tone_mix.png?width=2000",
      "info": "Poster for Video URL only when Image / poster (Shopify) is empty."
    },
    { "type": "header", "content": "Shared — Layout" },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Stage corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    { "type": "header", "content": "Section — Collab hero" },
    { "type": "checkbox", "id": "enabled", "label": "Enabled", "default": true },
    { "type": "text", "id": "meta", "label": "Meta line", "default": "Closed Sole · Special Release · One Run" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "coperni" },
    { "type": "text", "id": "aria_label", "label": "Aria label", "default": "Coperni x Barreletics Collaboration campaign" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Grid tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL fallback" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "tile_eyebrow", "label": "Overlay eyebrow" },
        { "type": "text", "id": "tile_title", "label": "Overlay title" },
        { "type": "textarea", "id": "tile_body", "label": "Overlay body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collab hero",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "image_url": "https://barreletics.com/cdn/shop/files/Copreni_Final_More_grey.png?v=1774119812&width=1200",
            "alt": "Barreletics × Coperni Closed Sole"
          }
        },
        {
          "type": "tile",
          "settings": {
            "image_url": "https://barreletics.com/cdn/shop/files/Screenshot_2026-03-20_at_6.53.30_PM.png?width=1200",
            "alt": "Coperni runway detail"
          }
        },
        {
          "type": "tile",
          "settings": {
            "image_url": "https://barreletics.com/cdn/shop/files/Screenshot_2026-03-21_at_3.04.37_PM.png?width=1200",
            "alt": "Coperni collaboration look"
          }
        },
        {
          "type": "tile",
          "settings": {
            "image_url": "https://barreletics.com/cdn/shop/files/yellow_tone_mix.png?width=2000",
            "tile_eyebrow": "Limited Edition × Paris SS26",
            "tile_title": "Where the runway meets real movement.",
            "tile_body": "Developed for the Coperni Spring–Summer 2026 collection in Paris — a Pilates shoe built for stability, grip, and athletic poise."
          }
        }
      ]
    }
  ]
}
{% endschema %}
