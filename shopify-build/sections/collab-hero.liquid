{% comment %}
  Collab hero — Coperni / campaign module.
  Layout TE: stage_grid (live runway) | editorial (DS section row).
{% endcomment %}

{% liquid
  assign title_size = section.settings.title_size | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign media_radius = section.settings.media_radius | default: 0
  assign tile_radius = section.settings.tile_radius | default: 0
  assign height_desktop = section.settings.height_desktop | default: '105'
  assign height_mobile = section.settings.height_mobile | default: '78'
  assign layout = section.settings.layout | default: 'stage_grid'
  assign tile_grid = section.settings.tile_grid | default: 'row'
  assign tile_size = section.settings.tile_size | default: 100
  assign tile_gap = section.settings.tile_gap | default: 0
  assign tile_focus = section.settings.tile_focus | default: 'center'
  assign tile_fit = section.settings.tile_fit | default: 'contain'
  # Size ≤100% = inset grid width. Size >100% = full-width row, taller tiles (no side crop).
  if tile_size > 100
    assign grid_width = 100
    assign tile_height_scale = tile_size
  else
    assign grid_width = tile_size
    assign tile_height_scale = 100
  endif
  assign media_fill_class = 'media-fill'
  if tile_fit == 'contain'
    assign media_fill_class = media_fill_class | append: ' media-fill--contain'
  endif
  if tile_focus == 'top'
    assign media_fill_class = media_fill_class | append: ' media-fill--top'
  elsif tile_focus == 'bottom'
    assign media_fill_class = media_fill_class | append: ' media-fill--bottom'
  elsif tile_focus == 'left'
    assign media_fill_class = media_fill_class | append: ' media-fill--left'
  elsif tile_focus == 'right'
    assign media_fill_class = media_fill_class | append: ' media-fill--right'
  endif
  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_href = cta_target
  else
    assign cta_href = section.settings.cta_url
  endif
  assign cta_style = section.settings.cta_style | default: 'solid'
  assign cta_bg = section.settings.cta_bg_color | default: '#ffffff'
  assign cta_border = section.settings.cta_border_color | default: cta_bg
  assign cta_text_color = section.settings.cta_text_color | default: '#1c1916'
  assign region_label = section.settings.aria_label | strip
  if region_label == blank
    assign region_label = section.settings.title | strip_html | truncate: 60
  endif
%}
{% unless section.settings.enabled == false %}
<section
  id="{{ section.settings.anchor_id | default: 'coperni' | handleize }}"
  class="collab-hero collab-hero--{{ layout }} section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %}"
  style="
    {% render 'section-inset-vars' %}
    --ch-media-radius: {{ media_radius }}px;
    --ch-tile-radius: {{ tile_radius }}px;
    --ch-height-desktop: {{ height_desktop }}vh;
    --ch-height-mobile: {{ height_mobile }}vh;
    --ch-grid-width: {{ grid_width }};
    --ch-tile-height-scale: {{ tile_height_scale }};
    --ch-tile-gap: {{ tile_gap }}px;
    --ch-gap-top: {{ section.settings.section_gap_top | default: 0 }}px;
    --ch-gap-top-m: {{ section.settings.section_gap_top_mobile | default: 0 }}px;
    --ch-cta-bg: {{ cta_bg }};
    --ch-cta-border: {{ cta_border }};
    --ch-cta-text: {{ cta_text_color }};
    --ch-badge-bg: {{ section.settings.badge_bg_color | default: '#C4859B' }};
    {% if title_size != 'default' %}--ch-title-size: {{ title_size }}px;{% endif %}
    {% if body_size != 'default' %}--ch-body-size: {{ body_size }}px;{% endif %}
    {% if title_weight != 'default' %}--ch-title-weight: {{ title_weight }};{% endif %}
  "
  {% if region_label != blank %}aria-label="{{ region_label | escape }}"{% endif %}
>
  {% if layout == 'editorial' %}
    <div class="collab-hero__editorial">
      <div class="collab-hero__editorial-media">
        {% if section.settings.video != blank %}
          {{
            section.settings.video
            | video_tag:
              image_size: '2000x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              class: 'collab-hero__video'
          }}
        {% elsif section.settings.video_url != blank %}
          <video
            class="collab-hero__video"
            autoplay
            muted
            loop
            playsinline
            webkit-playsinline
            preload="metadata"
            {% if section.settings.image != blank %}
              poster="{{ section.settings.image | image_url: width: 2000 }}"
            {% elsif section.settings.poster_url != blank %}
              poster="{{ section.settings.poster_url | escape }}"
            {% endif %}
          >
            <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
          </video>
        {% elsif section.settings.image != blank %}
          <img class="collab-hero__video" src="{{ section.settings.image | image_url: width: 2000 }}" alt="" loading="lazy">
        {% elsif section.settings.poster_url != blank %}
          <img class="collab-hero__video" src="{{ section.settings.poster_url | escape }}" alt="" loading="lazy">
        {% endif %}
      </div>
      <div class="collab-hero__editorial-copy">
        {% if section.settings.badge_text != blank %}
          <p class="collab-hero__badge"><span>{{ section.settings.badge_text | escape }}</span></p>
        {% endif %}
        {% if section.settings.eyebrow != blank %}
          <p class="collab-hero__eye">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="collab-hero__title">{{ section.settings.title }}</h2>
        {% if section.settings.body != blank %}
          <p class="collab-hero__body">{{ section.settings.body }}</p>
        {% endif %}
        {% if section.settings.cta_text != blank %}
          <a class="collab-hero__cta{% if cta_style == 'outline' %} collab-hero__cta--outline{% endif %}" href="{{ cta_href | default: routes.all_products_collection_url }}">{{ section.settings.cta_text }}</a>
        {% endif %}
        {% if section.settings.meta != blank %}
          <p class="collab-hero__meta">{{ section.settings.meta }}</p>
        {% endif %}
      </div>
    </div>
  {% else %}
    <div class="collab-hero__stage">
      {% if section.settings.video != blank %}
        {{
          section.settings.video
          | video_tag:
            image_size: '2000x',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            class: 'collab-hero__video'
        }}
      {% elsif section.settings.video_url != blank %}
        <video
          class="collab-hero__video"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="metadata"
          {% if section.settings.image != blank %}
            poster="{{ section.settings.image | image_url: width: 2000 }}"
          {% elsif section.settings.poster_url != blank %}
            poster="{{ section.settings.poster_url | escape }}"
          {% endif %}
        >
          <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
        </video>
      {% elsif section.settings.image != blank %}
        <img class="collab-hero__video" src="{{ section.settings.image | image_url: width: 2000 }}" alt="" loading="lazy">
      {% elsif section.settings.poster_url != blank %}
        <img class="collab-hero__video" src="{{ section.settings.poster_url | escape }}" alt="" loading="lazy">
      {% endif %}
      <div class="collab-hero__overlay">
        {% if section.settings.badge_text != blank %}
          <p class="collab-hero__badge"><span>{{ section.settings.badge_text | escape }}</span></p>
        {% endif %}
        {% if section.settings.eyebrow != blank %}
          <p class="collab-hero__eye">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="collab-hero__title">{{ section.settings.title }}</h2>
        {% if section.settings.body != blank %}
          <p class="collab-hero__body">{{ section.settings.body }}</p>
        {% endif %}
        {% if section.settings.cta_text != blank %}
          <a class="collab-hero__cta{% if cta_style == 'outline' %} collab-hero__cta--outline{% endif %}" href="{{ cta_href | default: routes.all_products_collection_url }}">{{ section.settings.cta_text }}</a>
        {% endif %}
        {% if section.settings.meta != blank %}
          <p class="collab-hero__meta">{{ section.settings.meta }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div
      class="collab-hero__grid collab-hero__grid--{{ tile_grid }}"
      role="region"
      aria-label="Featured campaign products"
    >
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}
          <a class="collab-hero__tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {% else %}
          <div class="collab-hero__tile" {{ block.shopify_attributes }}>
        {% endif %}
          {% if block.settings.image != blank %}
            <img
              class="{{ media_fill_class }}"
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.alt | escape }}"
              loading="lazy"
            >
          {% elsif block.settings.image_url != blank %}
            <img
              class="{{ media_fill_class }}"
              src="{{ block.settings.image_url | escape }}"
              alt="{{ block.settings.alt | escape }}"
              loading="lazy"
            >
          {% endif %}
          {% if block.settings.tile_title != blank or block.settings.tile_body != blank or block.settings.tile_eyebrow != blank %}
            <div class="collab-hero__tile-copy">
              {% if block.settings.tile_eyebrow != blank %}
                <p class="collab-hero__tile-eye">{{ block.settings.tile_eyebrow }}</p>
              {% endif %}
              {% if block.settings.tile_title != blank %}
                <p class="collab-hero__tile-title">{{ block.settings.tile_title }}</p>
              {% endif %}
              {% if block.settings.tile_body != blank %}
                <p class="collab-hero__tile-body">{{ block.settings.tile_body }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>
{% endunless %}

<style>
  .collab-hero {
    background: #fff;
    padding-top: var(--ch-gap-top, 0px);
    box-sizing: border-box;
  }
  .collab-hero__stage {
    position: relative;
    width: 100%;
    height: var(--ch-height-desktop, 105vh);
    min-height: 0;
    overflow: hidden;
    background: #1c1916;
    border-radius: var(--ch-media-radius, 0);
  }
  .collab-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.22);
    transform-origin: center center;
    display: block;
  }
  /* Editorial — quieter DS section row (media + copy, then tile row) */
  .collab-hero--editorial {
    padding: 0 0 0;
    border-top: 1px solid #ebe7e0;
    border-bottom: 1px solid #ebe7e0;
  }
  .collab-hero__editorial {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    min-height: 560px;
    align-items: stretch;
  }
  .collab-hero__editorial-media {
    position: relative;
    min-height: 480px;
    overflow: hidden;
    background: #1c1916;
    border-radius: var(--ch-media-radius, 0);
  }
  .collab-hero--editorial .collab-hero__video {
    transform: scale(1.06);
  }
  .collab-hero__editorial-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 56px 48px;
    background: #fff;
    color: #1c1916;
  }
  .collab-hero--editorial .collab-hero__eye {
    color: #6b645a;
  }
  .collab-hero__badge {
    margin: 0 0 16px;
  }
  .collab-hero__badge span {
    display: inline-block;
    font-family: var(--font-body), Roboto, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: var(--ch-badge-bg, #C4859B);
    padding: 8px 14px;
    border-radius: 2px;
  }
  .collab-hero--editorial .collab-hero__badge span {
    color: #fff;
  }
  .collab-hero--editorial .collab-hero__title {
    color: #1c1916;
    max-width: 16ch;
  }
  .collab-hero--editorial .collab-hero__body {
    color: #4a4a4a;
  }
  .collab-hero--editorial .collab-hero__meta {
    color: #8a8a8a;
  }
  .collab-hero--editorial .collab-hero__grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px 64px;
    gap: 12px;
    box-sizing: border-box;
  }
  .collab-hero--editorial .collab-hero__tile {
    border-radius: var(--ch-tile-radius, 0);
  }
  .collab-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 52px;
    box-sizing: border-box;
    max-width: none;
    color: #fff;
    background: linear-gradient(to bottom, rgba(0,0,0,0.09), rgba(0,0,0,0.37));
    pointer-events: none;
  }
  .collab-hero__overlay > * { pointer-events: auto; }
  .collab-hero__eye {
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    margin: 0 0 14px;
  }
  .collab-hero__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: var(--ch-title-size, clamp(36px, 5.5vw, 70px));
    font-weight: var(--ch-title-weight, 300);
    font-style: italic;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    max-width: 14ch;
    color: #fff;
  }
  .collab-hero__title em,
  .collab-hero__title strong {
    font-weight: 400;
    font-style: italic;
  }
  .collab-hero__body {
    font-size: var(--ch-body-size, 16px);
    line-height: 1.55;
    color: rgba(255,255,255,0.88);
    margin: 0 0 24px;
    max-width: 42ch;
  }
  .collab-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
    background: var(--ch-cta-bg, #fff);
    color: var(--ch-cta-text, #1c1916);
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    line-height: var(--type-cta-leading, 1);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid var(--ch-cta-border, var(--ch-cta-bg, #fff));
    margin-bottom: 14px;
    transition: opacity 0.15s ease;
  }
  .collab-hero__cta--outline {
    background: transparent;
    color: var(--ch-cta-text, var(--ch-cta-border, #fff));
  }
  .collab-hero__cta:hover { opacity: 0.92; }
  .collab-hero__meta {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin: 0;
  }
  .collab-hero__grid {
    display: grid;
    gap: var(--ch-tile-gap, 0px);
    width: calc(var(--ch-grid-width, 100) * 1%);
    max-width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
  }
  /* Single row — original 4-across */
  .collab-hero__grid--row {
    grid-template-columns: repeat(4, 1fr);
  }
  /* 2×2 — larger squares */
  .collab-hero__grid--2x2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .collab-hero__tile {
    position: relative;
    display: block;
    /* 100% = square; >100% grows height so enlarge doesn’t crop sides */
    aspect-ratio: 1 / calc(var(--ch-tile-height-scale, 100) / 100);
    overflow: hidden;
    background: #f5f2ec;
    text-decoration: none;
    color: inherit;
    min-width: 0;
    border-radius: var(--ch-tile-radius, 0);
  }
  /* Images: .media-fill / .media-fill--contain in barreletics-base.css */
  .collab-hero__tile-copy {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px 18px;
    background: linear-gradient(180deg, rgba(28,25,22,0.1) 20%, rgba(28,25,22,0.78) 100%);
    color: #fff;
    box-sizing: border-box;
    overflow: hidden;
    pointer-events: none;
  }
  .collab-hero__tile-copy a,
  .collab-hero__tile-copy { pointer-events: auto; }
  .collab-hero__tile-eye {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .collab-hero__tile-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .collab-hero__tile-body {
    font-size: 13px;
    line-height: 1.45;
    margin: 0;
    color: rgba(255,255,255,0.85);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  /* 4-across: denser overlay so copy fits the cell */
  .collab-hero__grid--row .collab-hero__tile-copy {
    padding: 12px 10px;
  }
  .collab-hero__grid--row .collab-hero__tile-eye {
    font-size: 9px;
    margin: 0 0 4px;
  }
  .collab-hero__grid--row .collab-hero__tile-title {
    font-size: clamp(14px, 1.6vw, 18px);
    margin: 0 0 4px;
  }
  .collab-hero__grid--row .collab-hero__tile-body {
    font-size: 11px;
    line-height: 1.35;
    -webkit-line-clamp: 2;
  }
  @media (max-width: 900px) {
    .collab-hero__grid--row { grid-template-columns: 1fr 1fr; }
    .collab-hero__overlay { padding: 32px 20px 40px; }
    .collab-hero__title { max-width: none; }
    .collab-hero__editorial { grid-template-columns: 1fr; min-height: 0; }
    .collab-hero__editorial-media { min-height: 360px; }
    .collab-hero__editorial-copy { padding: 40px 24px; }
    .collab-hero--editorial .collab-hero__grid { padding: 0 16px 48px; }
  }
  @media (max-width: 768px) {
    .collab-hero {
      padding-top: var(--ch-gap-top-m, 0px);
    }
    .collab-hero__stage {
      height: var(--ch-height-mobile, 78vh);
      min-height: 0;
    }
    .collab-hero__video { transform: scale(1.1); }
    .collab-hero__grid--row,
    .collab-hero__grid--2x2 {
      grid-template-columns: 1fr 1fr;
    }
    .collab-hero--editorial .collab-hero__grid { gap: 10px; padding: 0 16px 40px; }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&family=Syne:wght@400;700&display=swap" rel="stylesheet">

{% schema %}
{
  "name": "Collab hero",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited Edition × Paris 2026" },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge",
      "info": "Short pill — e.g. Available at Free People"
    },
    { "type": "color", "id": "badge_bg_color", "label": "Badge background", "default": "#C4859B" },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "<strong>Barreletics × Coperni</strong><br>Built for the body in motion.",
