{% comment %}
  Page Warranty Section
  90-day warranty details, coverage, claims process.
  Used on: page.warranty.json
{% endcomment %}

<section class="section" id="shopify-section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="section__inner section__inner--narrow">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="page-warranty__title type-hero">{{ section.settings.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="page-warranty__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
</section>

<section class="section section--cream">
  <div class="section__inner section__inner--narrow">
    <div class="page-warranty__coverage">
      <div class="page-warranty__covered">
        <h2 class="page-warranty__coverage-title page-warranty__coverage-title--yes">What's Covered</h2>
        <ul class="page-warranty__list">
          {% for block in section.blocks %}
            {% if block.type == 'covered' %}
              <li class="page-warranty__list-item page-warranty__list-item--yes" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
      <div class="page-warranty__not-covered">
        <h2 class="page-warranty__coverage-title page-warranty__coverage-title--no">What's NOT Covered</h2>
        <ul class="page-warranty__list">
          {% for block in section.blocks %}
            {% if block.type == 'not_covered' %}
              <li class="page-warranty__list-item page-warranty__list-item--no" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="section__inner section__inner--narrow">
    <h2 class="page-warranty__section-title">How to Make a Claim</h2>
    <div class="page-warranty__steps">
      {% for block in section.blocks %}
        {% if block.type == 'claim_step' %}
          <div class="page-warranty__step" {{ block.shopify_attributes }}>
            <span class="page-warranty__step-number">{{ forloop.index }}</span>
            <div class="page-warranty__step-content">
              <h3 class="page-warranty__step-title">{{ block.settings.title }}</h3>
              <p class="page-warranty__step-text">{{ block.settings.description }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% if section.settings.international_heading != blank %}
<section class="section section--cream">
  <div class="section__inner section__inner--narrow">
    <h2 class="page-warranty__section-title">{{ section.settings.international_heading }}</h2>
    <div class="page-warranty__international">
      {{ section.settings.international_text }}
    </div>
  </div>
</section>
{% endif %}

<style>
  .page-warranty__title {
    font-size: var(--type-hero-size);
    font-weight: var(--type-hero-weight);
    line-height: var(--type-hero-leading);
    letter-spacing: var(--type-hero-tracking);
    text-transform: none;
    color: var(--text-primary);
    text-align: center;
    margin: 0 0 var(--space-3);
  }

  .page-warranty__subtitle {
    font-size: var(--text-md);
    color: var(--text-body);
    text-align: center;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .page-warranty__coverage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .page-warranty__coverage-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--border-default);
  }

  .page-warranty__coverage-title--yes {
    color: var(--text-primary);
    border-bottom-color: var(--text-primary);
  }

  .page-warranty__coverage-title--no {
    color: var(--accent-primary);
    border-bottom-color: var(--accent-primary);
  }

  .page-warranty__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .page-warranty__list-item {
    padding: var(--space-3) 0;
    padding-left: var(--space-6);
    position: relative;
    font-size: var(--text-base);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
    border-bottom: 1px solid var(--border-default);
  }

  .page-warranty__list-item::before {
    position: absolute;
    left: 0;
    font-weight: var(--weight-bold);
  }

  .page-warranty__list-item--yes::before {
    content: "✓";
    color: var(--text-primary);
  }

  .page-warranty__list-item--no::before {
    content: "✕";
    color: var(--accent-primary);
  }

  .page-warranty__section-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-6);
    letter-spacing: var(--tracking-tight);
  }

  .page-warranty__steps {
    display: grid;
    gap: var(--space-5);
  }

  .page-warranty__step {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .page-warranty__step-number {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--text-primary);
    color: var(--color-white);
    border-radius: 50%;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
  }

  .page-warranty__step-title {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-1);
  }

  .page-warranty__step-text {
    font-size: var(--text-base);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .page-warranty__international {
    font-size: var(--text-md);
    color: var(--text-body);
    line-height: var(--leading-loose);
    padding: var(--space-5);
    background: var(--bg-primary);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card-sm);
  }

  .page-warranty__international p {
    margin-bottom: var(--space-3);
  }

  .page-warranty__international p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .page-warranty__title {
      font-size: var(--text-3xl);
    }

    .page-warranty__coverage {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Warranty Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Warranty"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "90-Day Warranty"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Every pair of Barreletics is backed by a 90-day warranty against manufacturing defects."
    },
    {
      "type": "text",
      "id": "international_heading",
      "label": "International section heading",
      "default": "International Warranty Claims"
    },
    {
      "type": "richtext",
      "id": "international_text",
      "label": "International warranty text",
      "default": "<p>International customers do not need to return the original pair. Send a photo of the defect to our support team. If approved, customer pays replacement shipping only.</p>"
    }
  ],
  "blocks": [
    {
      "type": "covered",
      "name": "Covered Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Coverage item"
        }
      ]
    },
    {
      "type": "not_covered",
      "name": "Not Covered Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Not covered item"
        }
      ]
    },
    {
      "type": "claim_step",
      "name": "Claim Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Warranty Page"
    }
  ]
}
{% endschema %}
