{% comment %}
  Sock Math — COMPACT (Definitive-v18 / v19 mid-page)
  Quote + 2-col comparison. Not July 17 Option C giant $74 vs $144 header.
{% endcomment %}

{% liquid
  assign title_size = section.settings.title_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign layout = section.settings.layout | default: 'compact'
  assign show_prices = section.settings.show_prices
  if show_prices == nil
    assign show_prices = true
  endif
  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_href = cta_target
  else
    assign cta_href = section.settings.cta_url | default: '#variants'
  endif
  assign editorial_img = ''
  if section.settings.image != blank
    assign editorial_img = section.settings.image | image_url: width: 1600
  elsif section.settings.image_url != blank
    assign editorial_img = section.settings.image_url
  endif
  assign image_fit = section.settings.image_fit | default: 'contain'
  assign image_scale = section.settings.image_scale | default: 100 | times: 0.01
  assign image_frame = section.settings.image_frame | default: 480
%}

<section
  class="sock-math sock-math--{{ layout }}"
  aria-label="{{ section.settings.aria_label | default: 'One pair' | escape }}"
  style="{% if title_size != 'default' %}--sm-title-size: {{ title_size }}px;{% endif %}{% if title_weight != 'default' %}--sm-title-weight: {{ title_weight }};{% endif %}{% if body_size != 'default' %}--sm-body-size: {{ body_size }}px;{% endif %}--sm-fit: {{ image_fit }};--sm-scale: {{ image_scale }};--sm-frame: {{ image_frame }}px;"
>
  {% if layout == 'editorial' %}
    <div class="sock-math__split">
      <div class="sock-math__copy">
        <h2 class="sock-math__headline">{{ section.settings.headline }}</h2>
        {% if section.settings.subheadline != blank %}
          <p class="sock-math__sub">{{ section.settings.subheadline }}</p>
        {% endif %}
        {% if section.settings.theirs_1 != blank or section.settings.ours_1 != blank %}
          <div class="sock-math__paths">
            {% if section.settings.theirs_1 != blank %}
              <p class="sock-math__path sock-math__path--theirs">
                <span>{{ section.settings.theirs_label | default: 'The 3-pack' }}</span>
                {{ section.settings.theirs_1 }}
                {% if section.settings.theirs_2 != blank %} {{ section.settings.theirs_2 }}{% endif %}
                {% if section.settings.theirs_3 != blank %} {{ section.settings.theirs_3 }}{% endif %}
              </p>
            {% endif %}
            {% if section.settings.ours_1 != blank %}
              <p class="sock-math__path sock-math__path--ours">
                <span>{{ section.settings.ours_label | default: 'The pair' }}</span>
                {{ section.settings.ours_1 }}
                {% if section.settings.ours_2 != blank %} {{ section.settings.ours_2 }}{% endif %}
                {% if section.settings.ours_3 != blank %} {{ section.settings.ours_3 }}{% endif %}
              </p>
            {% endif %}
          </div>
        {% endif %}
      </div>
      {% if editorial_img != blank %}
        <div class="sock-math__visual">
          <img
            src="{{ editorial_img | escape }}"
            alt="{{ section.settings.image_alt | default: section.settings.headline | escape }}"
            width="1200"
            height="1500"
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>
  {% else %}
  <div class="sock-math__header">
    <h2 class="sock-math__headline">{{ section.settings.headline }}</h2>
  </div>
  {% if section.settings.subheadline != blank %}
    <p class="sock-math__sub">{{ section.settings.subheadline }}</p>
  {% endif %}

  <div class="sock-math__inner">
    {% if section.settings.quote != blank %}
      <blockquote class="sock-math__quote">
        <p>“{{ section.settings.quote | strip | remove: '"' | remove: '“' | remove: '”' }}”</p>
        {% if section.settings.quote_cite != blank %}
          <cite>— {{ section.settings.quote_cite }}</cite>
        {% endif %}
      </blockquote>
    {% endif %}

    <div class="sock-math__grid">
      <div class="sock-math__col sock-math__col--theirs">
        <p class="sock-math__col-brand">{{ section.settings.theirs_label | default: 'Grip Socks' }}</p>
        {% if show_prices and section.settings.their_price != blank %}
          <p class="sock-math__col-price">{{ section.settings.their_price }}<span>/yr</span></p>
        {% endif %}
        <ul class="sock-math__list">
          <li><span class="sock-math__x" aria-hidden="true">✗</span>{{ section.settings.theirs_1 | default: 'Replace every 6–8 weeks' }}</li>
          <li><span class="sock-math__x" aria-hidden="true">✗</span>{{ section.settings.theirs_2 | default: 'Grip degrades with washing' }}</li>
          <li><span class="sock-math__x" aria-hidden="true">✗</span>{{ section.settings.theirs_3 | default: '6–8 pairs per year minimum' }}</li>
        </ul>
      </div>
      <div class="sock-math__col sock-math__col--ours">
        <p class="sock-math__col-brand sock-math__col-brand--accent">{{ section.settings.ours_label | default: 'Barreletics' }}</p>
        {% if show_prices and section.settings.our_price != blank %}
          <p class="sock-math__col-price sock-math__col-price--bold">{{ section.settings.our_price }}<span> once</span></p>
        {% endif %}
        <ul class="sock-math__list">
          <li><span class="sock-math__check" aria-hidden="true">✓</span>{{ section.settings.ours_1 | default: '18+ month lifespan' }}</li>
          <li><span class="sock-math__check" aria-hidden="true">✓</span>{{ section.settings.ours_2 | default: 'Grip never degrades' }}</li>
          <li><span class="sock-math__check" aria-hidden="true">✓</span>{{ section.settings.ours_3 | default: 'One pair, every class' }}</li>
        </ul>
      </div>
    </div>
  </div>
  {% endif %}

  {% if section.settings.cta_text != blank %}
    <div class="sock-math__cta-wrap">
      <a href="{{ cta_href }}" class="btn btn--primary">{{ section.settings.cta_text }}</a>
    </div>
  {% endif %}
</section>

<style>
  .sock-math--compact,
  .sock-math--editorial {
    background: #f5f2ec;
    padding: 0 0 var(--section-padding-y);
  }
  .sock-math--editorial {
    padding: 0;
  }
  .sock-math__split {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    min-height: 520px;
    align-items: stretch;
  }
  .sock-math__copy {
    padding: var(--section-padding-y) 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 640px;
  }
  .sock-math--editorial .sock-math__headline {
    text-align: left;
    margin: 0 0 28px;
  }
  .sock-math--editorial .sock-math__sub {
    text-align: left;
    padding: 0;
    max-width: 28em;
    line-height: 1.7;
    margin: 0;
  }
  .sock-math--editorial .sock-math__sub strong {
    color: #1c1916;
    font-weight: 600;
  }
  .sock-math__paths {
    margin-top: 40px;
    display: grid;
    gap: 18px;
  }
  .sock-math__path {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: #4a4a4a;
  }
  .sock-math__path span {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a8a8a;
    margin-bottom: 6px;
  }
  .sock-math__path--ours span {
    color: #c45c3f;
  }
  .sock-math__visual {
    background: #ece7de;
    height: var(--sm-frame, 480px);
    min-height: var(--sm-frame, 480px);
    max-height: var(--sm-frame, 480px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .sock-math__visual img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--sm-frame, 480px);
    object-fit: var(--sm-fit, contain);
    transform: scale(var(--sm-scale, 1));
    transform-origin: center center;
    display: block;
  }
  .sock-math__header {
    text-align: center;
    padding: var(--section-padding-y) 40px 32px;
  }
  .sock-math__headline {
    font-size: var(--sm-title-size, clamp(36px, 5vw, 52px));
    font-weight: var(--sm-title-weight, 400);
    color: #1c1916;
    margin: 0;
    letter-spacing: -0.028em;
    line-height: 1.1;
  }
  .sock-math__sub {
    text-align: center;
    padding: 0 40px;
    font-size: var(--sm-body-size, 16px);
    font-weight: 400;
    color: #4a4a4a;
    margin: 0;
    line-height: 1.5;
  }
  .sock-math__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 40px 0;
  }
  .sock-math__quote {
    max-width: 600px;
    margin: 0 auto 40px;
    text-align: center;
    border: none;
    padding: 0;
  }
  .sock-math__quote p {
    font-size: 16px;
    font-style: italic;
    color: #4a4a4a;
    line-height: 1.6;
    margin: 0 0 8px;
  }
  .sock-math__quote cite {
    font-size: 12px;
    font-style: normal;
    color: #8a8a8a;
    font-weight: 600;
  }
  .sock-math__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid #d6cfc0;
    border-radius: 8px;
    overflow: hidden;
  }
  .sock-math__col {
    padding: 40px;
  }
  .sock-math__col--theirs {
    border-right: 1px solid #d6cfc0;
    background: transparent;
  }
  .sock-math__col--ours {
    background: #fff;
  }
  .sock-math__col-brand {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8a8a8a;
    font-weight: 700;
    margin: 0 0 16px;
  }
  .sock-math__col-brand--accent {
    color: #c45c3f;
  }
  .sock-math__col-price {
    font-size: 36px;
    font-weight: 700;
    color: #1c1916;
    margin: 0 0 24px;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .sock-math__col-price span {
    font-size: 14px;
    font-weight: 400;
    color: #8a8a8a;
  }
  .sock-math__list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 14px;
    color: #4a4a4a;
    line-height: 2;
  }
  .sock-math__list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .sock-math__x {
    color: #8a8a8a;
    flex-shrink: 0;
  }
  .sock-math__check {
    color: #1c1916;
    font-weight: 700;
    flex-shrink: 0;
  }
  .sock-math__col--theirs .sock-math__list {
    color: #8a8a8a;
  }
  .sock-math__cta-wrap {
    text-align: center;
    margin-top: 40px;
    padding: 0 40px;
  }
  @media (max-width: 768px) {
    .sock-math--compact { padding: 0 0 var(--section-padding-y-mobile); }
    .sock-math__header { padding: var(--section-padding-y-mobile) 16px 24px; }
    .sock-math__sub { padding: 0 16px; }
    .sock-math__inner { padding: 32px 16px 0; }
    .sock-math__grid { grid-template-columns: 1fr; }
    .sock-math__col--theirs { border-right: none; border-bottom: 1px solid #d6cfc0; }
    .sock-math__col { padding: 28px 24px; }
    .sock-math__split { grid-template-columns: 1fr; min-height: 0; }
    .sock-math__copy { padding: var(--section-padding-y-mobile) 24px 32px; max-width: none; }
    .sock-math__visual { min-height: 280px; }
  }
</style>

{% schema %}
{
  "name": "Sock Math",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    {
      "type": "text",
      "id": "headline",
      "label": "Heading",
      "default": "One pair. Done.",
      "info": "Family is brand Type OS — use Title size/weight to adjust. No font family picker."
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "52", "label": "52px" },
        { "value": "56", "label": "56px" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "subheadline",
      "label": "Body",
      "default": "Smarter than grip socks. Your practice. Your pace. Months to years of the same grip."
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "cta_text", "label": "CTA label", "info": "Leave blank to hide (v18 compact has no CTA)." },
    {
      "type": "select",
      "id": "cta_link_target",
      "label": "CTA link",
      "options": [
        { "value": "custom", "label": "Custom URL…" },
        { "value": "#variants", "label": "#variants — Shop styles" },
        { "value": "#reviews", "label": "#reviews" },
        { "value": "#guarantee", "label": "#guarantee" }
      ],
      "default": "#variants"
    },
    { "type": "text", "id": "cta_url", "label": "Custom CTA URL" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "compact", "label": "Compact — 2-col compare" },
        { "value": "editorial", "label": "Editorial — copy + photo" }
      ],
      "default": "compact"
    },
    {
      "type": "checkbox",
      "id": "show_prices",
      "label": "Show prices (compact)",
      "default": true
    },
    { "type": "image_picker", "id": "image", "label": "Editorial photo" },
    { "type": "text", "id": "image_url", "label": "Editorial photo URL" },
    { "type": "text", "id": "image_alt", "label": "Editorial photo alt" },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Photo fit",
      "options": [
        { "value": "contain", "label": "Shrink to fit (whole photo)" },
        { "value": "cover", "label": "Fill box (may crop)" }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "image_frame",
      "min": 360,
      "max": 560,
      "step": 20,
      "unit": "px",
      "label": "Photo frame height",
      "default": 480
    },
    {
      "type": "range",
      "id": "image_scale",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Photo size inside frame",
      "default": 100
    },
    { "type": "header", "content": "Section — Sock math — compact" },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote (optional)",
      "info": "Leave blank — compact One pair. Done. has no review quote (v19 clean). Reviews live in the reviews section."
    },
    {
      "type": "text",
      "id": "quote_cite",
      "label": "Quote cite (optional)"
    },
    { "type": "text", "id": "theirs_label", "label": "Their column label", "default": "Grip Socks" },
    { "type": "text", "id": "their_price", "label": "Their price", "default": "$112–144" },
    { "type": "text", "id": "theirs_1", "label": "Their point 1", "default": "Replace every 6–8 weeks" },
    { "type": "text", "id": "theirs_2", "label": "Their point 2", "default": "Grip degrades with washing" },
    { "type": "text", "id": "theirs_3", "label": "Their point 3", "default": "6–8 pairs per year minimum" },
    { "type": "text", "id": "ours_label", "label": "Our column label", "default": "Barreletics" },
    { "type": "text", "id": "our_price", "label": "Our price", "default": "$74" },
    { "type": "text", "id": "ours_1", "label": "Our point 1", "default": "18+ month lifespan" },
    { "type": "text", "id": "ours_2", "label": "Our point 2", "default": "Grip never degrades" },
    { "type": "text", "id": "ours_3", "label": "Our point 3", "default": "One pair, every class" },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria-label",
      "default": "Cost comparison"
    }
  ],
  "presets": [{ "name": "Sock Math" }]
}
{% endschema %}
