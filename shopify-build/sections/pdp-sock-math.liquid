{% comment %}
  Sock Math
  compact — v18/v19 2-col compare (Coperni / default). Do not change.
  editorial — mock L (docs/pdp-sock-math-directions.html v8). Closed only.
{% endcomment %}

{% liquid
  assign title_size = section.settings.title_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign layout = section.settings.layout | default: 'compact'
  assign show_prices = section.settings.show_prices
  if show_prices == nil
    assign show_prices = true
  endif
  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_href = cta_target
  else
    assign cta_href = section.settings.cta_url | default: '#variants'
  endif
  assign editorial_img = ''
  if section.settings.image != blank
    assign editorial_img = section.settings.image | image_url: width: 1600
  elsif section.settings.image_url != blank
    assign editorial_img = section.settings.image_url
  endif
  assign image_fit = section.settings.image_fit | default: 'cover'
  assign image_scale = section.settings.image_scale | default: 100 | times: 0.01
  assign image_frame = section.settings.image_frame | default: 480
  assign image_unframed = section.settings.image_unframed
  assign pad_top = section.settings.pad_top | default: 0
  assign pad_bottom = section.settings.pad_bottom | default: 0
%}

<section
  class="sock-math sock-math--{{ layout }}{% if image_unframed %} sock-math--unframed{% endif %}"
  aria-label="{{ section.settings.aria_label | default: 'One pair' | escape }}"
  style="{% if title_size != 'default' %}--sm-title-size: {{ title_size }}px;{% endif %}{% if title_weight != 'default' %}--sm-title-weight: {{ title_weight }};{% endif %}{% if body_size != 'default' %}--sm-body-size: {{ body_size }}px;{% endif %}--sm-fit: {{ image_fit }};--sm-scale: {{ image_scale }};--sm-frame: {{ image_frame }}px;--sm-pad-top: {{ pad_top }}px;--sm-pad-bottom: {{ pad_bottom }}px;"
>
  {% if layout == 'editorial' %}
    <div class="sock-math__split">
      <div class="sock-math__copy">
        <h2 class="sock-math__headline h2-display">
          {% if section.settings.done_line != blank %}
            {{ section.settings.headline }}<em>{{ section.settings.done_line }}</em>
          {% else %}
            {{ section.settings.headline }}
          {% endif %}
        </h2>
        {% if section.settings.subheadline != blank %}
          <p class="sock-math__sub">{{ section.settings.subheadline | newline_to_br }}</p>
        {% endif %}
        {% if section.settings.punch != blank %}
          <p class="sock-math__end">{{ section.settings.punch }}</p>
        {% endif %}
      </div>
      <div class="sock-math__pane">
        {% if editorial_img != blank %}
          <div class="sock-math__visual">
            <img
              src="{{ editorial_img | escape }}"
              alt="{{ section.settings.image_alt | default: section.settings.headline | escape }}"
              width="1200"
              height="1500"
              loading="lazy"
            >
          </div>
        {% endif %}
        <div class="sock-math__cycle">
          <div class="sock-math__cycle-item">
            <span>{{ section.settings.theirs_label | default: 'The cycle' }}</span>
            {% if section.settings.their_price != blank %}
              <p class="sock-math__cycle-price">{{ section.settings.their_price }} <small>/yr</small></p>
            {% endif %}
            {% if section.settings.theirs_1 != blank %}
              <p>{{ section.settings.theirs_1 }}</p>
            {% endif %}
          </div>
          <div class="sock-math__cycle-item sock-math__cycle-item--ours">
            <span>{{ section.settings.ours_label | default: 'The pair' }}</span>
            {% if section.settings.our_price != blank %}
              <p class="sock-math__cycle-price">{{ section.settings.our_price }} <small>once</small></p>
            {% endif %}
            {% if section.settings.ours_1 != blank %}
              <p class="sock-math__grip">{{ section.settings.ours_1 }}</p>
            {% endif %}
            {% if section.settings.ours_2 != blank %}
              <p>{{ section.settings.ours_2 }}</p>
            {% endif %}
          </div>
          {% if section.settings.cycle_foot != blank %}
            <p class="sock-math__cycle-foot">{{ section.settings.cycle_foot }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% else %}
  <div class="sock-math__header">
    <h2 class="sock-math__headline">{{ section.settings.headline }}</h2>
  </div>
  {% if section.settings.subheadline != blank %}
    <p class="sock-math__sub">{{ section.settings.subheadline }}</p>
  {% endif %}

  <div class="sock-math__inner">
    {% if section.settings.quote != blank %}
      <blockquote class="sock-math__quote">
        <p>“{{ section.settings.quote | strip | remove: '"' | remove: '“' | remove: '”' }}”</p>
        {% if section.settings.quote_cite != blank %}
          <cite>— {{ section.settings.quote_cite }}</cite>
        {% endif %}
      </blockquote>
    {% endif %}

    <div class="sock-math__grid">
      <div class="sock-math__col sock-math__col--theirs">
        <p class="sock-math__col-brand">{{ section.settings.theirs_label | default: 'Grip Socks' }}</p>
        {% if show_prices and section.settings.their_price != blank %}
          <p class="sock-math__col-price">{{ section.settings.their_price }}<span>/yr</span></p>
        {% endif %}
        <ul class="sock-math__list">
          <li><span class="sock-math__x" aria-hidden="true">✗</span>{{ section.settings.theirs_1 | default: 'Replace every 6–8 weeks' }}</li>
          <li><span class="sock-math__x" aria-hidden="true">✗</span>{{ section.settings.theirs_2 | default: 'Grip degrades with washing' }}</li>
          <li><span class="sock-math__x" aria-hidden="true">✗</span>{{ section.settings.theirs_3 | default: '6–8 pairs per year minimum' }}</li>
        </ul>
      </div>
      <div class="sock-math__col sock-math__col--ours">
        <p class="sock-math__col-brand sock-math__col-brand--accent">{{ section.settings.ours_label | default: 'Barreletics' }}</p>
        {% if show_prices and section.settings.our_price != blank %}
          <p class="sock-math__col-price sock-math__col-price--bold">{{ section.settings.our_price }}<span> once</span></p>
        {% endif %}
        <ul class="sock-math__list">
          <li><span class="sock-math__check" aria-hidden="true">✓</span>{{ section.settings.ours_1 | default: '1,000 classes. Year four.' }}</li>
          <li><span class="sock-math__check" aria-hidden="true">✓</span>{{ section.settings.ours_2 | default: 'Grip never degrades' }}</li>
          <li><span class="sock-math__check" aria-hidden="true">✓</span>{{ section.settings.ours_3 | default: 'One pair, every class' }}</li>
        </ul>
      </div>
    </div>
  </div>
  {% endif %}

  {% if layout != 'editorial' and section.settings.cta_text != blank %}
    <div class="sock-math__cta-wrap">
      <a href="{{ cta_href }}" class="btn btn--primary">{{ section.settings.cta_text }}</a>
    </div>
  {% endif %}
</section>

<style>
  .sock-math--compact {
    background: #f5f2ec;
    padding: 0 0 var(--section-padding-y);
  }
  .sock-math--editorial {
    background: #f5f2ec;
    padding: var(--sm-pad-top, 0) 0 var(--sm-pad-bottom, 0);
  }
  .sock-math--editorial .sock-math__split {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    background: #f5f2ec;
    align-items: stretch;
  }
  .sock-math--editorial .sock-math__copy {
    padding: 64px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .sock-math--editorial h2.sock-math__headline {
    text-align: left;
    margin: 0 0 8px;
    font-size: var(--type-h2-display-size);
    font-weight: var(--type-h2-display-weight);
    line-height: var(--type-h2-display-leading);
    letter-spacing: var(--type-h2-display-tracking);
    color: #1c1916;
  }
  .sock-math--editorial h2.sock-math__headline em {
    display: block;
    font-style: normal;
    font-weight: 400;
    color: #6b645a;
    margin-top: 4px;
  }
  .sock-math--editorial .sock-math__sub {
    text-align: left;
    padding: 0;
    max-width: 28em;
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.7;
    color: #4a4a4a;
  }
  .sock-math--editorial .sock-math__end {
    margin: 36px 0 0;
    font-size: var(--sm-body-size, 16px);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.5;
    color: #1c1916;
  }
  .sock-math--editorial .sock-math__pane {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .sock-math--editorial .sock-math__visual {
    flex: 0 0 var(--sm-frame, 480px);
    height: var(--sm-frame, 480px);
    min-height: var(--sm-frame, 480px);
    max-height: var(--sm-frame, 480px);
    padding: 0;
    overflow: hidden;
    background: #ece7de;
  }
  .sock-math--editorial .sock-math__visual img {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: var(--sm-fit, cover);
    object-position: center center;
    display: block;
  }
  .sock-math--editorial.sock-math--unframed .sock-math__visual {
    flex: 1 1 auto;
    height: auto;
    min-height: 420px;
    max-height: none;
    background: transparent;
  }
  .sock-math--editorial .sock-math__cycle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    padding: 28px 24px 24px;
    background: #fff;
  }
  .sock-math--editorial .sock-math__cycle-item {
    margin: 0;
    padding: 0 24px;
    text-align: center;
  }
  .sock-math--editorial .sock-math__cycle-item + .sock-math__cycle-item {
    border-left: 1px solid #d6cfc0;
  }
  .sock-math--editorial .sock-math__cycle-item span {
    display: block;
    margin-bottom: 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a8a8a;
  }
  .sock-math--editorial .sock-math__cycle-item--ours span {
    color: #c45c3f;
  }
  .sock-math--editorial .sock-math__cycle-item p.sock-math__cycle-price {
    margin: 0 0 8px;
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #1c1916;
  }
  .sock-math--editorial .sock-math__cycle-item--ours .sock-math__cycle-price {
    color: #c45c3f;
  }
  .sock-math--editorial .sock-math__cycle-price small {
    font-size: 14px;
    font-weight: 400;
    color: #8a8a8a;
  }
  .sock-math--editorial .sock-math__cycle-item p {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: #4a4a4a;
  }
  .sock-math--editorial .sock-math__cycle-item p.sock-math__grip {
    margin: 6px 0 0;
    font-size: 13px;
    font-weight: 500;
    color: #1c1916;
  }
  .sock-math--editorial .sock-math__cycle-foot {
    grid-column: 1 / -1;
    margin: 20px 8px 0;
    padding-top: 18px;
    border-top: 1px solid #d6cfc0;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    color: #1c1916;
  }
  .sock-math__header {
    text-align: center;
    padding: var(--section-padding-y) 40px 32px;
  }
  .sock-math__headline {
    font-size: var(--sm-title-size, clamp(36px, 5vw, 52px));
    font-weight: var(--sm-title-weight, 400);
    color: #1c1916;
    margin: 0;
    letter-spacing: -0.028em;
    line-height: 1.1;
  }
  .sock-math__sub {
    text-align: center;
    padding: 0 40px;
    font-size: var(--sm-body-size, 16px);
    font-weight: 400;
    color: #4a4a4a;
    margin: 0;
    line-height: 1.5;
  }
  .sock-math__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 40px 0;
  }
  .sock-math__quote {
    max-width: 600px;
    margin: 0 auto 40px;
    text-align: center;
    border: none;
    padding: 0;
  }
  .sock-math__quote p {
    font-size: 16px;
    font-style: italic;
    color: #4a4a4a;
    line-height: 1.6;
    margin: 0 0 8px;
  }
  .sock-math__quote cite {
    font-size: 12px;
    font-style: normal;
    color: #8a8a8a;
    font-weight: 600;
  }
  .sock-math__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid #d6cfc0;
    border-radius: 8px;
    overflow: hidden;
  }
  .sock-math__col {
    padding: 40px;
  }
  .sock-math__col--theirs {
    border-right: 1px solid #d6cfc0;
    background: transparent;
  }
  .sock-math__col--ours {
    background: #fff;
  }
  .sock-math__col-brand {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8a8a8a;
    font-weight: 700;
    margin: 0 0 16px;
  }
  .sock-math__col-brand--accent {
    color: #c45c3f;
  }
  .sock-math__col-price {
    font-size: 36px;
    font-weight: 700;
    color: #1c1916;
    margin: 0 0 24px;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .sock-math__col-price span {
    font-size: 14px;
    font-weight: 400;
    color: #8a8a8a;
  }
  .sock-math__list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 14px;
    color: #4a4a4a;
    line-height: 2;
  }
  .sock-math__list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .sock-math__x {
    color: #8a8a8a;
    flex-shrink: 0;
  }
  .sock-math__check {
    color: #1c1916;
    font-weight: 700;
    flex-shrink: 0;
  }
  .sock-math__col--theirs .sock-math__list {
    color: #8a8a8a;
  }
  .sock-math__cta-wrap {
    text-align: center;
    margin-top: 40px;
    padding: 0 40px;
  }
  @media (max-width: 768px) {
    .sock-math--compact { padding: 0 0 var(--section-padding-y-mobile); }
    .sock-math__header { padding: var(--section-padding-y-mobile) 16px 24px; }
    .sock-math__sub { padding: 0 16px; }
    .sock-math__inner { padding: 32px 16px 0; }
    .sock-math__grid { grid-template-columns: 1fr; }
    .sock-math__col--theirs { border-right: none; border-bottom: 1px solid #d6cfc0; }
    .sock-math__col { padding: 28px 24px; }
    .sock-math--editorial { padding: var(--sm-pad-top, 0) 0 var(--sm-pad-bottom, 0); }
    .sock-math--editorial .sock-math__split { grid-template-columns: 1fr; }
    .sock-math--editorial .sock-math__copy { padding: 48px 24px; }
    .sock-math--editorial .sock-math__visual,
    .sock-math--editorial .sock-math__visual img {
      height: 360px;
      min-height: 360px;
      max-height: 360px;
      flex-basis: 360px;
    }
    .sock-math--editorial.sock-math--unframed .sock-math__visual,
    .sock-math--editorial.sock-math--unframed .sock-math__visual img {
      height: 320px;
      min-height: 320px;
      max-height: 320px;
      flex-basis: 320px;
    }
    .sock-math--editorial .sock-math__cycle { grid-template-columns: 1fr; padding: 40px 24px; }
    .sock-math--editorial .sock-math__cycle-item + .sock-math__cycle-item {
      border-left: 0;
      border-top: 1px solid #d6cfc0;
      padding-top: 24px;
      margin-top: 24px;
    }
    .sock-math--editorial .sock-math__cycle-foot { margin: 24px 0 0; }
  }
</style>

{% schema %}
{
  "name": "Sock Math",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    {
      "type": "text",
      "id": "headline",
      "label": "Heading",
      "default": "One pair. Done.",
      "info": "Editorial L: set to One pair. Use Done line below."
    },
    {
      "type": "text",
      "id": "done_line",
      "label": "Done line (editorial)",
      "info": "Quiet second line. Mock L = Done."
    },
    {
      "type": "text",
      "id": "punch",
      "label": "Punch (editorial)",
      "info": "Mock L = This ends that."
    },
    {
      "type": "text",
      "id": "cycle_foot",
      "label": "Cycle foot (editorial)",
      "info": "Mock L = Yoga socks are useless."
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "52", "label": "52px" },
        { "value": "56", "label": "56px" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "subheadline",
      "label": "Body",
      "default": "Smarter than grip socks. Your practice. Your pace. Months to years of the same grip."
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "cta_text", "label": "CTA label", "info": "Leave blank to hide (v18 compact has no CTA)." },
    {
      "type": "select",
      "id": "cta_link_target",
      "label": "CTA link",
      "options": [
        { "value": "custom", "label": "Custom URL…" },
        { "value": "#variants", "label": "#variants — Shop styles" },
        { "value": "#reviews", "label": "#reviews" },
        { "value": "#guarantee", "label": "#guarantee" }
      ],
      "default": "#variants"
    },
    { "type": "text", "id": "cta_url", "label": "Custom CTA URL" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "compact", "label": "Compact — 2-col compare" },
        { "value": "editorial", "label": "Editorial — mock L" }
      ],
      "default": "compact"
    },
    {
      "type": "checkbox",
      "id": "show_prices",
      "label": "Show prices (compact)",
      "default": true
    },
    { "type": "image_picker", "id": "image", "label": "Editorial photo" },
    { "type": "text", "id": "image_url", "label": "Editorial photo URL" },
    { "type": "text", "id": "image_alt", "label": "Editorial photo alt" },
    {
      "type": "checkbox",
      "id": "image_unframed",
      "label": "No photo frame (fill column)",
      "info": "Open only. Closed stays framed. Ignores Photo frame height.",
      "default": false
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Photo fit",
      "options": [
        { "value": "contain", "label": "Shrink to fit (whole photo)" },
        { "value": "cover", "label": "Fill box (may crop)" }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "image_frame",
      "min": 360,
      "max": 560,
      "step": 20,
      "unit": "px",
      "label": "Photo frame height",
      "default": 480
    },
    {
      "type": "range",
      "id": "image_scale",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Photo size inside frame",
      "default": 100
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Open PDP match is 80 (same as 50/50s). Closed stays 0."
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Open PDP match is 80 (same as 50/50s). Closed stays 0."
    },
    { "type": "header", "content": "Section — Sock math — compact" },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote (optional)",
      "info": "Leave blank — compact One pair. Done. has no review quote (v19 clean). Reviews live in the reviews section."
    },
    {
      "type": "text",
      "id": "quote_cite",
      "label": "Quote cite (optional)"
    },
    { "type": "text", "id": "theirs_label", "label": "Their column label", "default": "Grip Socks" },
    { "type": "text", "id": "their_price", "label": "Their price", "default": "$112–144" },
    { "type": "text", "id": "theirs_1", "label": "Their point 1", "default": "Replace every 6–8 weeks" },
    { "type": "text", "id": "theirs_2", "label": "Their point 2", "default": "Grip degrades with washing" },
    { "type": "text", "id": "theirs_3", "label": "Their point 3", "default": "6–8 pairs per year minimum" },
    { "type": "text", "id": "ours_label", "label": "Our column label", "default": "Barreletics" },
    { "type": "text", "id": "our_price", "label": "Our price", "default": "$74" },
    { "type": "text", "id": "ours_1", "label": "Our point 1", "default": "1,000 classes. Year four." },
    { "type": "text", "id": "ours_2", "label": "Our point 2", "default": "Grip never degrades" },
