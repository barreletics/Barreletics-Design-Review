{% comment %}
  FOOTER LOCKED Jul 31 2026 — sitewide via footer-group (all pages).
  Trusted by (toggle) · Join the list (toggle, NO 10%) · columns · Light/Dark per band.
  Join the list = option A (2026-08-12): headline left, form right, checks OFF.
  Spec: specs/frozen/footer.md · Registry: planning/m4-section-freeze.md
  Do not reintroduce 10% or page-level duplicate newsletters.
{% endcomment %}

{% assign menu_primary = section.settings.menu %}
{% assign menu_shop = section.settings.menu_shop %}
{% assign menu_learn = section.settings.menu_learn %}
{% assign menu_support = section.settings.menu_support %}
{% assign menu_connect = section.settings.menu_connect %}
{% assign use_column_pickers = false %}
{% if menu_shop != blank or menu_learn != blank or menu_support != blank or menu_connect != blank %}
  {% assign use_column_pickers = true %}
{% endif %}

{% assign trust_theme = section.settings.trust_theme | default: section.settings.trust_band_style | default: 'light' %}
{% if trust_theme == 'cream' or trust_theme == 'black' %}
  {% if trust_theme == 'cream' %}{% assign trust_theme = 'light' %}{% else %}{% assign trust_theme = 'dark' %}{% endif %}
{% endif %}
{% assign join_theme = section.settings.join_theme | default: 'light' %}
{% assign columns_theme = section.settings.columns_theme | default: 'light' %}
{% assign trust_title_size = section.settings.trust_title_size | default: 'default' %}
{% assign trust_body_size = section.settings.trust_body_size | default: 'default' %}
{% assign join_title_size = section.settings.join_title_size | default: 'default' %}
{% assign join_body_size = section.settings.join_body_size | default: 'default' %}

<footer
  class="site-footer site-footer--a-plus"
  role="contentinfo"
  style="{% if trust_title_size != 'default' %}--ft-trust-title-size: {{ trust_title_size }}px;{% endif %}{% if trust_body_size != 'default' %}--ft-trust-body-size: {{ trust_body_size }}px;{% endif %}{% if join_title_size != 'default' %}--ft-join-title-size: {{ join_title_size }}px;{% endif %}{% if join_body_size != 'default' %}--ft-join-body-size: {{ join_body_size }}px;{% endif %}"
  {{ section.shopify_attributes }}
>

  {% if section.settings.show_studio_trust %}
    <div class="footer-studio-trust footer-studio-trust--{{ trust_theme }}" aria-label="Studio trust">
      {% if section.settings.studio_trust_title != blank %}
        <p class="footer-studio-trust__line">{{ section.settings.studio_trust_title }}</p>
      {% endif %}
      {% if section.settings.studio_trust_subhead != blank %}
        <p class="footer-studio-trust__sub">{{ section.settings.studio_trust_subhead }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="site-footer__body site-footer__body--{{ columns_theme }}">
    <div class="site-footer__inner">

      {% if section.settings.show_newsletter %}
        <div class="footer-newsletter footer-newsletter--{{ join_theme }}">
          <div class="fn-signup">
            {% if section.settings.newsletter_heading != blank %}
              <h2 class="fn-signup__title">{{ section.settings.newsletter_heading }}</h2>
            {% endif %}
            {% if section.settings.newsletter_text != blank %}
              <p>{{ section.settings.newsletter_text }}</p>
            {% endif %}
          </div>
          <div class="fn-form-col">
            {% form 'customer', id: 'footer-newsletter' %}
              <div class="fn-form">
                <input
                  class="fn-input"
                  type="email"
                  name="contact[email]"
                  placeholder="Email address"
                  required
                  autocomplete="email"
                  aria-label="Email address"
                >
                <input type="hidden" name="contact[tags]" value="newsletter">
                <button class="fn-btn" type="submit">{{ section.settings.newsletter_cta }}</button>
              </div>
              {% if section.settings.newsletter_privacy != blank %}
                <p class="fn-legal">{{ section.settings.newsletter_privacy }}</p>
              {% endif %}
            {% endform %}
            {% if section.settings.show_checklist %}
              <ul class="fn-checks" aria-label="List benefits">
                {% if section.settings.check_1 != blank %}
                  <li><span class="fn-check" aria-hidden="true">✓</span><span class="fn-check-text">{{ section.settings.check_1 }}</span></li>
                {% endif %}
                {% if section.settings.check_2 != blank %}
                  <li><span class="fn-check" aria-hidden="true">✓</span><span class="fn-check-text">{{ section.settings.check_2 }}</span></li>
                {% endif %}
                {% if section.settings.check_3 != blank %}
                  <li><span class="fn-check" aria-hidden="true">✓</span><span class="fn-check-text">{{ section.settings.check_3 }}</span></li>
                {% endif %}
                {% if section.settings.check_4 != blank %}
                  <li><span class="fn-check" aria-hidden="true">✓</span><span class="fn-check-text">{{ section.settings.check_4 }}</span></li>
                {% endif %}
              </ul>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="site-footer__grid">
        {% if use_column_pickers %}
          {% if menu_shop != blank %}
            <div class="site-footer__col">
              <h6>{{ section.settings.shop_heading }}</h6>
              <ul>
                {% for link in menu_shop.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
          {% if menu_learn != blank %}
            <div class="site-footer__col">
              <h6>{{ section.settings.learn_heading }}</h6>
              <ul>
                {% assign footer_has_partners = false %}
                {% assign footer_has_ambassador = false %}
                {% for link in menu_learn.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% if link.url contains '/pages/partners' %}
                    {% assign footer_has_partners = true %}
                  {% endif %}
                  {% if link.url contains '/pages/ambassador' %}
                    {% assign footer_has_ambassador = true %}
                  {% endif %}
                {% endfor %}
                {% unless footer_has_partners %}
                  <li><a href="/pages/partners">Partner programs</a></li>
                {% endunless %}
                {% unless footer_has_ambassador %}
                  <li><a href="/pages/ambassador">Ambassador</a></li>
                {% endunless %}
              </ul>
            </div>
          {% endif %}
          {% if menu_support != blank %}
            <div class="site-footer__col">
              <h6>{{ section.settings.support_heading }}</h6>
              <ul>
                {% for link in menu_support.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
          {% if menu_connect != blank %}
            <div class="site-footer__col">
              <h6>{{ section.settings.connect_heading }}</h6>
              <ul>
                {% for link in menu_connect.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% elsif section.settings.instagram_url != blank or section.settings.tiktok_url != blank or section.settings.facebook_url != blank or section.settings.pinterest_url != blank or section.settings.email_url != blank %}
            <div class="site-footer__col">
              <h6>{{ section.settings.connect_heading }}</h6>
              <ul>
                {% if section.settings.instagram_url != blank %}
                  <li><a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram</a></li>
                {% endif %}
                {% if section.settings.tiktok_url != blank %}
                  <li><a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer">TikTok</a></li>
                {% endif %}
                {% if section.settings.facebook_url != blank %}
                  <li><a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer">Facebook</a></li>
                {% endif %}
                {% if section.settings.pinterest_url != blank %}
                  <li><a href="{{ section.settings.pinterest_url }}" target="_blank" rel="noopener noreferrer">Pinterest</a></li>
                {% endif %}
                {% if section.settings.email_url != blank %}
                  <li><a href="{{ section.settings.email_url }}">Email Us</a></li>
                {% endif %}
              </ul>
            </div>
          {% endif %}

        {% elsif menu_primary != blank %}
          {% assign nested_columns = false %}
          {% for link in menu_primary.links %}
            {% if link.links != blank %}
              {% assign nested_columns = true %}
            {% endif %}
          {% endfor %}

          {% if nested_columns %}
            {% for link in menu_primary.links %}
              <div class="site-footer__col">
                {% if link.links != blank %}
                  <h6>{{ link.title }}</h6>
                  <ul>
                    {% for child in link.links %}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {% endfor %}
                  </ul>
                {% else %}
                  <h6>{{ link.title }}</h6>
                  <ul>
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  </ul>
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            {%- comment -%}
              Fallback columns — rendered only when no column menu is assigned. Same link
              set as the Footer Shop / Learn / Support menus in
              planning/navigation-menu-spec.md §3, so the fallback and the menu-driven
              footer agree. Every href here returns 200 on this store; rows whose
              destination does not exist yet (Gift Cards, How It Works, Warranty, Track
              Order) are held out until the page or product is created rather than
              shipping a 404. Composition, column count and headings are unchanged.
            {%- endcomment -%}
            <div class="site-footer__col">
              <h6>{{ section.settings.shop_heading | default: 'Shop' }}</h6>
              <ul>
                <li><a href="/collections/barre-pilates-yoga-shoe-sock-footwear">All Grippy Shoes</a></li>
                <li><a href="/products/studio-performance-skin-footwear">Open Sole</a></li>
                <li><a href="/products/best-reformer-pilates-legree-workout-shoes">Closed Sole</a></li>
                <li><a href="/products/aquatic-performance-skins">Outdoor</a></li>
                <li><a href="/collections/apparel">Apparel</a></li>
              </ul>
            </div>
            <div class="site-footer__col">
              <h6>{{ section.settings.learn_heading | default: 'Learn' }}</h6>
              <ul>
                <li><a href="/pages/our-story">About Us</a></li>
                <li><a href="/blogs/news">Journal</a></li>
                <li><a href="/pages/collaborations">Collaborations</a></li>
                <li><a href="/pages/partners">Partner programs</a></li>
                <li><a href="/pages/ambassador">Ambassador</a></li>
                <li><a href="/pages/compare-open-closed-sole">Compare Styles</a></li>
                <li><a href="/pages/best-barre-pilates-yoga-grippy-socks">Better Than Grippy Socks</a></li>
              </ul>
            </div>
            <div class="site-footer__col">
              <h6>{{ section.settings.support_heading | default: 'Support' }}</h6>
              <ul>
                <li><a href="/pages/help">Help Center</a></li>
                <li><a href="/pages/faq">FAQ</a></li>
                <li><a href="/pages/performance-skins-size-chart">Size Guide</a></li>
                <li><a href="/pages/care">Care Instructions</a></li>
                <li><a href="/pages/returns">Returns &amp; Exchanges</a></li>
                <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
                <li><a href="/policies/refund-policy">Refund Policy</a></li>
                <li><a href="/pages/contact-us-form">Contact Us</a></li>
              </ul>
            </div>
            <div class="site-footer__col">
              <h6>{{ section.settings.connect_heading | default: 'Connect' }}</h6>
              <ul>
                <li><a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/barreletics/' }}" target="_blank" rel="noopener noreferrer">Instagram</a></li>
                <li><a href="https://www.tiktok.com/@barreletics" target="_blank" rel="noopener noreferrer">TikTok</a></li>
                <li><a href="https://www.facebook.com/barreletics" target="_blank" rel="noopener noreferrer">Facebook</a></li>
                <li><a href="https://www.pinterest.com/barreletics" target="_blank" rel="noopener noreferrer">Pinterest</a></li>
                <li><a href="{{ section.settings.email_url | default: '/pages/contact-us-form' }}">Email Us</a></li>
              </ul>
            </div>
          {% endif %}
        {% else %}
          {%- comment -%}
            Same fallback set as above, for the case where no footer menu is assigned at
            all. Keep the two blocks in sync — see planning/navigation-menu-spec.md §3.
          {%- endcomment -%}
          <div class="site-footer__col">
            <h6>{{ section.settings.shop_heading | default: 'Shop' }}</h6>
            <ul>
              <li><a href="/collections/barre-pilates-yoga-shoe-sock-footwear">All Grippy Shoes</a></li>
              <li><a href="/products/studio-performance-skin-footwear">Open Sole</a></li>
              <li><a href="/products/best-reformer-pilates-legree-workout-shoes">Closed Sole</a></li>
              <li><a href="/products/aquatic-performance-skins">Outdoor</a></li>
              <li><a href="/collections/apparel">Apparel</a></li>
            </ul>
          </div>
          <div class="site-footer__col">
            <h6>{{ section.settings.learn_heading | default: 'Learn' }}</h6>
            <ul>
              <li><a href="/pages/our-story">About Us</a></li>
              <li><a href="/blogs/news">Journal</a></li>
              <li><a href="/pages/collaborations">Collaborations</a></li>
              <li><a href="/pages/partners">Partner programs</a></li>
              <li><a href="/pages/ambassador">Ambassador</a></li>
              <li><a href="/pages/compare-open-closed-sole">Compare Styles</a></li>
              <li><a href="/pages/best-barre-pilates-yoga-grippy-socks">Better Than Grippy Socks</a></li>
            </ul>
          </div>
          <div class="site-footer__col">
            <h6>{{ section.settings.support_heading | default: 'Support' }}</h6>
            <ul>
              <li><a href="/pages/help">Help Center</a></li>
              <li><a href="/pages/faq">FAQ</a></li>
              <li><a href="/pages/performance-skins-size-chart">Size Guide</a></li>
              <li><a href="/pages/care">Care Instructions</a></li>
              <li><a href="/pages/returns">Returns &amp; Exchanges</a></li>
              <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
              <li><a href="/policies/refund-policy">Refund Policy</a></li>
              <li><a href="/pages/contact-us-form">Contact Us</a></li>
            </ul>
          </div>
          <div class="site-footer__col">
            <h6>{{ section.settings.connect_heading | default: 'Connect' }}</h6>
            <ul>
              <li><a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/barreletics/' }}" target="_blank" rel="noopener noreferrer">Instagram</a></li>
              <li><a href="https://www.tiktok.com/@barreletics" target="_blank" rel="noopener noreferrer">TikTok</a></li>
              <li><a href="https://www.facebook.com/barreletics" target="_blank" rel="noopener noreferrer">Facebook</a></li>
              <li><a href="https://www.pinterest.com/barreletics" target="_blank" rel="noopener noreferrer">Pinterest</a></li>
              <li><a href="{{ section.settings.email_url | default: '/pages/contact-us-form' }}">Email Us</a></li>
            </ul>
          </div>
        {% endif %}
      </div>

      <div class="site-footer__bottom">
        <span class="site-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </span>
        {% if section.settings.usa_line != blank %}
          <span class="site-footer__usa">{{ section.settings.usa_line }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Trusted by (above newsletter)"
    },
    {
      "type": "checkbox",
      "id": "show_studio_trust",
      "label": "Show Trusted by strip",
      "default": true,
      "info": "Sitewide (footer group). Off = hide on every page. Keep as footer toggle — not a separate section."
    },
    {
      "type": "text",
      "id": "studio_trust_title",
      "label": "Trusted by heading",
      "default": "Trusted by 1,000's of instructors & studios."
    },
    {
      "type": "textarea",
      "id": "studio_trust_subhead",
      "label": "Trusted by subcopy",
      "default": "Dig into deep lunges and every position—endless grip that breathes."
    },
    {
      "type": "select",
      "id": "trust_theme",
      "label": "Trusted by",
      "default": "light",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    {
      "type": "select",
      "id": "trust_title_size",
      "label": "Trusted by title size",
      "default": "default",
      "info": "Family is brand Type OS — size only.",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "18", "label": "18" },
        { "value": "20", "label": "20" },
        { "value": "22", "label": "22" },
        { "value": "24", "label": "24" },
        { "value": "26", "label": "26" },
        { "value": "28", "label": "28" },
        { "value": "30", "label": "30" },
        { "value": "32", "label": "32" },
        { "value": "36", "label": "36" },
        { "value": "40", "label": "40" }
      ]
    },
    {
      "type": "select",
      "id": "trust_body_size",
      "label": "Trusted by body size",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "13", "label": "13" },
        { "value": "14", "label": "14" },
        { "value": "15", "label": "15" },
        { "value": "16", "label": "16" },
        { "value": "17", "label": "17" },
        { "value": "18", "label": "18" }
      ]
    },
    {
      "type": "header",
      "content": "Join the list band"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Join the list band",
      "default": true,
      "info": "Sitewide email signup. Off = hide on every page. Independent of Trusted by toggle."
    },
    {
      "type": "select",
      "id": "join_theme",
      "label": "Join the list",
      "default": "light",
      "info": "Light or brand dark. Text follows automatically.",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    {
      "type": "select",
      "id": "join_title_size",
      "label": "Join the list title size",
      "default": "default",
      "info": "Family is brand Type OS — size only.",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "18", "label": "18" },
        { "value": "20", "label": "20" },
        { "value": "22", "label": "22" },
        { "value": "24", "label": "24" },
        { "value": "26", "label": "26" },
        { "value": "28", "label": "28" },
        { "value": "30", "label": "30" },
        { "value": "32", "label": "32" },
        { "value": "36", "label": "36" },
        { "value": "40", "label": "40" }
      ]
    },
    {
      "type": "select",
      "id": "join_body_size",
      "label": "Join the list body size",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "13", "label": "13" },
        { "value": "14", "label": "14" },
        { "value": "15", "label": "15" },
        { "value": "16", "label": "16" },
        { "value": "17", "label": "17" },
        { "value": "18", "label": "18" }
      ]
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join the list"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "New colorways and studio stories."
    },
    {
      "type": "text",
      "id": "newsletter_cta",
      "label": "Newsletter CTA",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "newsletter_privacy",
      "label": "Newsletter privacy line",
      "default": "By subscribing you agree to receive marketing emails. Unsubscribe anytime."
