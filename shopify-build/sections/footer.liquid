      "type": "text",
      "id": "check_4",
      "label": "Check 4",
      "default": "Care tips to extend the life of your performance skins"
    },
    {
      "type": "header",
      "content": "Columns / bottom footer"
    },
    {
      "type": "select",
      "id": "columns_theme",
      "label": "Columns + bottom",
      "default": "light",
      "info": "Light or brand dark. Text follows automatically.",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "paragraph",
      "content": "WORKING columns: Shop · Learn · Support · Connect. Assign existing store menus in Theme Editor — no new Navigation handles. If column menus are empty, the primary footer menu is used (nested items become columns)."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary footer menu (fallback)",
      "info": "Used when column menus below are blank. Nested top-level items render as columns."
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Heading for flat primary menu",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Shop column heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_shop",
      "label": "Shop menu"
    },
    {
      "type": "text",
      "id": "learn_heading",
      "label": "Learn column heading",
      "default": "Learn"
    },
    {
      "type": "link_list",
      "id": "menu_learn",
      "label": "Learn menu"
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Support column heading",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "menu_support",
      "label": "Support menu"
    },
    {
      "type": "text",
      "id": "connect_heading",
      "label": "Connect column heading",
      "default": "Connect"
    },
    {
      "type": "link_list",
      "id": "menu_connect",
      "label": "Connect menu",
      "info": "If blank, social URL fields below fill the Connect column."
    },
    {
      "type": "header",
      "content": "Connect links (when Connect menu empty)"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "email_url",
      "label": "Email Us URL"
