    },
    {
      "type": "text",
      "id": "check_1",
      "label": "Check 1",
      "default": "New drops and studio stories first"
    },
    {
      "type": "text",
      "id": "check_2",
      "label": "Check 2",
      "default": "Early access to new colorways and limited editions"
