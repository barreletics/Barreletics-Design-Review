{% comment %}
  Search Results Section
  Displays search results in a responsive product grid with filter/sort and empty state.
  Uses product-card.liquid snippet for product-type results.

  Usage: Rendered via search.json template
{% endcomment %}

{%- liquid
  assign utp_y_d_def = 32
  assign utp_side_d_def = 40
  assign utp_y_m_def = 24
  assign utp_x_m_def = 20
  assign utp_style = ''
  assign u_y = section.settings.text_pad_y | default: utp_y_d_def
  if u_y != utp_y_d_def
    assign utp_style = utp_style | append: '--utp-y-d:' | append: u_y | append: 'px;'
  endif
  assign u_side = section.settings.side_padding | default: utp_side_d_def
  if u_side != utp_side_d_def
    assign utp_style = utp_style | append: '--utp-side-d:' | append: u_side | append: 'px;'
  endif
  assign u_y_m = section.settings.text_pad_y_mobile | default: utp_y_m_def
  if u_y_m != utp_y_m_def
    assign utp_style = utp_style | append: '--utp-y-m:' | append: u_y_m | append: 'px;'
  endif
  assign u_x_m = section.settings.text_pad_x_mobile | default: utp_x_m_def
  if u_x_m != utp_x_m_def
    assign utp_style = utp_style | append: '--utp-x-m:' | append: u_x_m | append: 'px;'
  endif
-%}
<section class="section search-results" aria-labelledby="search-heading" style="{{ utp_style }}">
  <div class="section__inner">
    <h1 class="visually-hidden" id="search-heading">Search</h1>

    <form action="/search" method="get" role="search" class="search-results__form">
      <label for="search-input" class="visually-hidden">Search</label>
      <div class="search-results__input-wrap">
        <svg class="search-results__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="7.5" cy="7.5" r="5.5" stroke="currentColor" stroke-width="1.4"/>
          <path d="M11.5 11.5L16 16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          id="search-input"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search grippy shoes, open sole, closed sole..."
          class="search-results__input"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
        />
        <button type="submit" class="search-results__submit btn btn--primary btn--sm">Search</button>
      </div>
      <input type="hidden" name="type" value="product,article,page" />
    </form>

    {% if search.performed %}
      <p class="search-results__count" aria-live="polite">
        {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms }}&rdquo;
      </p>

      {% if search.results_count > 0 %}
        {% assign product_results = search.results | where: 'object_type', 'product' %}
        {% assign content_results = search.results | where: 'object_type', 'article' %}
        {% assign page_results = search.results | where: 'object_type', 'page' %}

        {% if product_results.size > 0 %}
          <div class="search-results__section">
            <h2 class="search-results__section-title">Products</h2>
            <div class="grid grid--4 search-results__grid">
              {% for product in product_results %}
                {% render 'product-card', product: product, show_quick_add: true, show_badge: true, show_installments: true %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        {% if content_results.size > 0 %}
          <div class="search-results__section">
            <h2 class="search-results__section-title">Journal</h2>
            <div class="grid grid--3 search-results__content-grid">
              {% for article in content_results %}
                <a href="{{ article.url }}" class="search-results__content-card">
                  {% if article.image %}
                    <img
                      src="{{ article.image | image_url: width: 400 }}"
                      alt="{{ article.title | escape }}"
                      width="400"
                      height="225"
                      loading="lazy"
                      class="search-results__content-img"
                    />
                  {% endif %}
                  <h3 class="search-results__content-title">{{ article.title }}</h3>
                  <p class="search-results__content-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
                </a>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        {% if page_results.size > 0 %}
          <div class="search-results__section">
            <h2 class="search-results__section-title">Pages</h2>
            <div class="search-results__pages">
              {% for page in page_results %}
                <a href="{{ page.url }}" class="search-results__page-link">
                  <h3>{{ page.title }}</h3>
                  <p>{{ page.content | strip_html | truncate: 150 }}</p>
                </a>
              {% endfor %}
            </div>
          </div>
        {% endif %}

      {% else %}
        <div class="search-results__empty">
          <p class="search-results__empty-text">No results found for &ldquo;{{ search.terms }}&rdquo;</p>
          <p class="search-results__suggestions">Try searching for:</p>
          <ul class="search-results__suggestion-list">
            <li><a href="/search?q=grippy+shoes">grippy shoes</a></li>
            <li><a href="/search?q=open+sole">open sole</a></li>
            <li><a href="/search?q=closed+sole">closed sole</a></li>
            <li><a href="/search?q=outdoor">outdoor</a></li>
          </ul>
        </div>
      {% endif %}

      {% if search.results_count > 16 %}
        <nav class="search-results__pagination" aria-label="Search results pagination">
          {{ paginate | default_pagination: next: '→', previous: '←' }}
        </nav>
      {% endif %}
    {% endif %}
  </div>
</section>

<style>
  .search-results {
    padding: var(--utp-y-d, var(--section-padding-y)) var(--utp-side-d, var(--section-padding-x));
  }
  .search-results__form {
    max-width: 600px;
    margin: 0 auto 40px;
  }
  .search-results__input-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-button);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    background: var(--bg-primary);
    transition: border-color var(--transition-fast);
  }
  .search-results__input-wrap:focus-within {
    border-color: var(--color-charcoal);
  }
  .search-results__icon {
    flex-shrink: 0;
    color: var(--color-muted);
  }
  .search-results__input {
    flex: 1;
    border: none;
    outline: none;
    font-size: var(--text-base);
    font-family: var(--font-family);
    color: var(--text-primary);
    background: transparent;
    min-height: 44px;
  }
  .search-results__input::placeholder {
    color: var(--color-muted);
  }
  .search-results__submit {
    flex-shrink: 0;
  }
  .search-results__count {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-8);
  }
  .search-results__section {
    margin-bottom: var(--space-10);
  }
  .search-results__section-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--text-primary);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-default);
  }
  .search-results__content-card {
    display: block;
    text-decoration: none;
    color: var(--color-body);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: transform 200ms ease;
  }
  .search-results__content-card:hover {
    transform: translateY(-2px);
    text-decoration: none;
  }
  .search-results__content-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: var(--radius-card-sm);
    margin-bottom: var(--space-3);
  }
  .search-results__content-title {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }
  .search-results__content-excerpt {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }
  .search-results__page-link {
    display: block;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-default);
    text-decoration: none;
    color: var(--text-body);
  }
  .search-results__page-link:first-child {
    border-top: 1px solid var(--border-default);
  }
  .search-results__page-link h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }
  .search-results__page-link p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }
  .search-results__page-link:hover h3 {
    color: var(--accent-primary);
  }
  .search-results__page-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
  .search-results__content-card:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
  .search-results__empty {
    text-align: center;
    padding: var(--space-10) 0;
  }
  .search-results__empty-text {
    font-size: var(--text-lg);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }
  .search-results__suggestions {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }
  .search-results__suggestion-list {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .search-results__suggestion-list a {
    font-size: var(--text-sm);
    color: var(--accent-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-2);
  }
  .search-results__suggestion-list a:hover {
    color: var(--text-primary);
  }
  .search-results__suggestion-list a:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
  .search-results__pagination {
    text-align: center;
    margin-top: var(--space-9);
  }

  @media (max-width: 768px) {
    .search-results {
      padding: var(--utp-y-m, var(--section-padding-y-mobile)) var(--utp-x-m, var(--section-padding-x-mobile));
    }
    .search-results__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .search-results__content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% style %}
  {%- liquid
    assign te_y_d = 32
    assign te_side_d = 40
    assign te_y_m = 24
    assign te_x_m = 20
    assign u_y = section.settings.text_pad_y | default: te_y_d
    assign u_side = section.settings.side_padding | default: te_side_d
    assign u_y_m = section.settings.text_pad_y_mobile | default: te_y_m
    assign u_x_m = section.settings.text_pad_x_mobile | default: te_x_m
  -%}
  {%- if u_y != te_y_d or u_side != te_side_d -%}
  #shopify-section-{{ section.id }} .search-results {
    {%- if u_y != te_y_d -%}
    padding-top: {{ u_y }}px;
    padding-bottom: {{ u_y }}px;
    {%- endif -%}
    {%- if u_side != te_side_d -%}
    padding-left: {{ u_side }}px;
    padding-right: {{ u_side }}px;
    {%- endif -%}
  }
  {%- endif -%}
  {%- if u_y_m != te_y_m or u_x_m != te_x_m -%}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .search-results {
      {%- if u_y_m != te_y_m -%}
      padding-top: {{ u_y_m }}px;
      padding-bottom: {{ u_y_m }}px;
      {%- endif -%}
      {%- if u_x_m != te_x_m -%}
      padding-left: {{ u_x_m }}px;
      padding-right: {{ u_x_m }}px;
      {%- endif -%}
    }
  }
  {%- endif -%}
{% endstyle %}

{% schema %}
{
  "name": "Search Results",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout — text padding"
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 32 — theme section gap)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 40)",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 24 — theme section gap)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 20)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Search Results"
    }
  ]
}
{% endschema %}
