{% comment %}
  Guarantee / trust band — dark band max 2 tiers (statement + support)
{% endcomment %}

<section class="guarantee-band section--campaign align-band" aria-label="Guarantee">
  <div class="guarantee-band__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="guarantee-band__eyebrow type-label">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="guarantee-band__title type-statement">{{ section.settings.title }}</h2>
    {% if section.settings.body != blank %}
      <p class="guarantee-band__body">{{ section.settings.body }}</p>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <ul class="guarantee-band__list" role="list">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {% endfor %}
      </ul>
    {% endif %}
    {% if section.settings.cta_text != blank %}
      {% assign g_href = section.settings.cta_url | default: '/collections/grippy-shoes' %}
      <a class="btn btn--primary guarantee-band__cta" href="{{ g_href }}">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  .guarantee-band {
    padding: var(--section-padding-y-campaign) var(--section-padding-x);
    background: var(--bg-dark);
    color: #fff;
    text-align: var(--align-band);
  }
  .guarantee-band__inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .guarantee-band__eyebrow {
    margin: 0 0 var(--stack-campaign-eyebrow);
    color: var(--type-dark-support-color);
  }
  .guarantee-band__title {
    margin: 0 auto var(--stack-campaign-after-title);
    color: #ffffff;
    max-width: var(--type-section-measure);
  }
  /* Dark band tier 2 — body + points share one support style */
  .guarantee-band__body,
  .guarantee-band__list li {
    font-size: var(--type-dark-support-size);
    font-weight: var(--type-dark-support-weight);
    line-height: var(--type-body-leading);
    color: var(--type-dark-support-color);
  }
  .guarantee-band__body {
    margin: 0 auto var(--stack-campaign-to-body);
    max-width: 48ch;
  }
  .guarantee-band__list {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 24px;
  }
  .guarantee-band__cta {
    display: inline-block;
    background: #fff;
    color: #1c1916;
    padding: 14px 28px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
  }
  .guarantee-band__cta:hover {
    background: #c45c3f;
    color: #fff;
  }
  @media (max-width: 768px) {
    .guarantee-band {
      padding: var(--section-padding-y-campaign-mobile) var(--section-padding-x-mobile);
    }
  }
</style>

{% schema %}
{
  "name": "Guarantee Band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank on dark bands — max two text tiers." },
    { "type": "text", "id": "title", "label": "Title", "default": "Zero risk. All grip.", "info": "Dark-band tier 1 — statement size/weight." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "30-day returns on items in new, sellable condition. 90-day warranty against manufacturing defects. Free shipping on orders over $150."
    },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop Grippy Shoes" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "30-day returns" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guarantee Band",
      "blocks": [
        { "type": "point", "settings": { "text": "30-day returns" } },
        { "type": "point", "settings": { "text": "90-day warranty" } },
        { "type": "point", "settings": { "text": "Made in USA" } },
        { "type": "point", "settings": { "text": "Free shipping over $150" } }
      ]
    }
  ]
}
{% endschema %}
