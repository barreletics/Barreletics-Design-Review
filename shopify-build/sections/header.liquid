{% comment %}
  Site header — Shopify menus (main + help). CSS/JS in assets/chrome.*
{% endcomment %}

{% assign main_menu = section.settings.menu %}
{% assign help_menu = section.settings.help_menu %}

{%- assign logo_height = section.settings.logo_height | default: 22 -%}
{%- assign logo_height_mobile = section.settings.logo_height_mobile | default: logo_height -%}
{%- assign sticky_header = section.settings.sticky_header -%}
{%- if sticky_header == nil -%}{%- assign sticky_header = true -%}{%- endif -%}
{%- assign nav_link_size = section.settings.nav_link_size | default: 'default' -%}
{%- assign nav_gap = section.settings.nav_gap | default: 30 -%}
{%- comment -%} Help center hub (page.help.json) — routes to FAQ, returns, size, contact. {%- endcomment -%}
{%- assign help_fallback_url = '/pages/help' -%}
{%- assign show_help = section.settings.show_help -%}
{%- if show_help == nil -%}{%- assign show_help = true -%}{%- endif -%}
{%- assign show_account = section.settings.show_account -%}
{%- if show_account == nil -%}{%- assign show_account = true -%}{%- endif -%}
{%- assign show_cart = section.settings.show_cart -%}
{%- if show_cart == nil -%}{%- assign show_cart = true -%}{%- endif -%}
{%- assign show_action_labels = section.settings.show_action_labels -%}
{%- if show_action_labels == nil -%}{%- assign show_action_labels = true -%}{%- endif -%}
{%- assign header_bg = section.settings.header_bg | default: '#ffffff' -%}
{%- assign header_text = section.settings.header_text | default: '#4a4a4a' -%}
{%- assign logo_img_width = logo_height | times: 4 | at_least: 280 -%}

{%- unless sticky_header -%}
  {%- comment -%} Stickiness lives on the section wrapper (see .header-section in chrome.css). {%- endcomment -%}
  <style>#shopify-section-{{ section.id }} { position: static; }</style>
{%- endunless -%}

<header
  class="site-header{% unless sticky_header %} site-header--static{% endunless %}"
  data-site-header
  role="banner"
  style="
    --header-logo-height: {{ logo_height }}px;
    --header-logo-height-mobile: {{ logo_height_mobile }}px;
    --header-nav-gap: {{ nav_gap }}px;
    --header-bg: {{ header_bg }};
    --header-text: {{ header_text }};
    {% if nav_link_size != 'default' %}--header-nav-size: {{ nav_link_size }}px;{% endif %}
  "
  {{ section.shopify_attributes }}
>
  <div class="site-header__inner">
    <button
      class="site-header__hamburger"
      data-mobile-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      type="button"
    >
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
        <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: logo_img_width
          | image_tag:
            class: 'site-header__logo-img',
            alt: shop.name,
            loading: 'eager',
            widths: '136, 204, 272, 320, 400',
            sizes: '(max-width: 768px) 120px, 200px',
            height: logo_height
        }}
      {% else %}
        {%- comment -%} Home WORKING authority: barreletics-logo.png @ 68×22 {%- endcomment -%}
        <img
          class="site-header__logo-img"
          src="{{ 'barreletics-logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="68"
          height="{{ logo_height }}"
          decoding="async"
          loading="eager"
        >
      {% endif %}
    </a>

    <nav class="site-header__nav" aria-label="Main navigation">
      <ul class="site-header__nav-list" role="list">
        {% if main_menu != blank %}
          {% for link in main_menu.links %}
            {%- capture oo_nav_probe -%}
              {% render 'one-off-nav-item', parent_title: link.title, children: link.links %}
            {%- endcapture -%}
            {%- assign oo_nav_probe = oo_nav_probe | strip -%}
            <li class="site-header__nav-item{% if link.links != blank or oo_nav_probe != blank %} site-header__nav-item--has-sub{% endif %}">
              <a href="{{ link.url }}">{{ link.title }}</a>
              {% if link.links != blank or oo_nav_probe != blank %}
                <ul class="site-header__subnav" role="list">
                  {% for child in link.links %}
                    <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                  {% endfor %}
                  {{ oo_nav_probe }}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </nav>

    <div class="site-header__actions">
      {% if show_help %}
        {% if help_menu != blank %}
          <div class="site-header__help site-header__nav-item--has-sub">
            <a
              href="{{ help_fallback_url }}"
              class="site-header__action site-header__action--help{% if show_action_labels %} site-header__action--text{% endif %}"
              aria-label="Help"
              aria-haspopup="true"
            >
              {%- if show_action_labels -%}
                Help <span class="site-header__caret" aria-hidden="true">▾</span>
              {%- else -%}
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M6.5 7a2.5 2.5 0 0 1 5 0c0 1.5-2.5 1.5-2.5 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                  <circle cx="9" cy="13" r="0.8" fill="currentColor"/>
                </svg>
              {%- endif -%}
            </a>
            <ul class="site-header__subnav site-header__subnav--help" role="list">
              {% for link in help_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% else %}
          {%- comment -%}
            No secondary menu assigned — link straight to the help center hub.
          {%- endcomment -%}
          <a href="{{ help_fallback_url }}" class="site-header__action site-header__action--text" aria-label="Help">
            {%- if show_action_labels -%}
              Help
            {%- else -%}
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.3"/>
                <path d="M6.5 7a2.5 2.5 0 0 1 5 0c0 1.5-2.5 1.5-2.5 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <circle cx="9" cy="13" r="0.8" fill="currentColor"/>
              </svg>
            {%- endif -%}
          </a>
        {% endif %}
      {% endif %}

      {% if show_account %}
        <a href="{{ routes.account_url }}" class="site-header__action site-header__action--text" aria-label="Account">
          {% if show_action_labels %}Account{% else %}
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <circle cx="9" cy="6" r="3" stroke="currentColor" stroke-width="1.3"/>
              <path d="M3 15c0-3 2.7-5 6-5s6 2 6 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
          {% endif %}
        </a>
      {% endif %}

      {% if show_cart %}
        <a href="{{ routes.cart_url }}" class="site-header__action site-header__action--text site-header__cart" aria-label="Cart ({{ cart.item_count }} items)" data-cart-trigger>
          {% if show_action_labels %}
            Cart <span class="site-header__cart-badge site-header__cart-badge--inline" data-cart-count>{{ cart.item_count }}</span>
          {% else %}
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M2 2h2l1.5 9h9L16 5H5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="8" cy="15" r="1" fill="currentColor"/>
              <circle cx="13" cy="15" r="1" fill="currentColor"/>
            </svg>
            <span class="site-header__cart-badge site-header__cart-badge--inline" data-cart-count>{{ cart.item_count }}</span>
          {% endif %}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
    <div class="mobile-menu__overlay" data-mobile-menu-close></div>
    <div class="mobile-menu__drawer" role="dialog" aria-label="Navigation menu">
      <button class="mobile-menu__close" data-mobile-menu-close aria-label="Close menu" type="button">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
      <nav class="mobile-menu__nav" aria-label="Mobile navigation">
        <ul class="mobile-menu__list" role="list">
          {% if main_menu != blank %}
            {% for link in main_menu.links %}
              {%- capture oo_nav_probe_m -%}
                {% render 'one-off-nav-item', parent_title: link.title, children: link.links %}
              {%- endcapture -%}
              {%- assign oo_nav_probe_m = oo_nav_probe_m | strip -%}
              {% if link.links != blank or oo_nav_probe_m != blank %}
                <li class="mobile-menu__item mobile-menu__item--parent">
                  <button class="mobile-menu__toggle" aria-expanded="false" type="button">{{ link.title }}</button>
                  <ul class="mobile-menu__sub" role="list">
                    {% for child in link.links %}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {% endfor %}
                    {{ oo_nav_probe_m }}
                  </ul>
                </li>
              {% else %}
                <li class="mobile-menu__item"><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endif %}
            {% endfor %}
          {% endif %}
        </ul>
        {%- comment -%}
          The desktop Help action is hidden below 768px, so this list is the only support
          affordance on mobile. Without a fallback, an unconfigured header leaves phone users
          with no way to reach support at all.
        {%- endcomment -%}
        {% if help_menu != blank %}
          <ul class="mobile-menu__utility" role="list">
            {% for link in help_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% elsif show_help %}
          <ul class="mobile-menu__utility" role="list">
            <li><a href="{{ help_fallback_url }}">Help</a></li>
          </ul>
        {% endif %}
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "header",
      "content": "Shared — Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image (optional)",
      "info": "Defaults to barreletics-logo.png. Override only if needed."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "info": "Theme Editor picker — assign any store menu. Leave blank for logo/actions only."
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "Optional secondary menu",
      "info": "Optional. Shown as help dropdown when assigned. Not required."
    },
    {
      "type": "checkbox",
      "id": "show_help",
      "label": "Show Help",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_action_labels",
      "label": "Show Help / Account / Cart text labels",
      "default": true,
      "info": "Off = icon-only utility links (aria labels kept)."
    },
    {
      "type": "paragraph",
      "content": "Announcement / trust bar show/hide lives on the Announcement strip section in this header group."
    },
    {
      "type": "header",
      "content": "Shared — Layout"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height (desktop)",
      "min": 16,
      "max": 80,
      "step": 1,
      "default": 22,
      "unit": "px",
      "info": "Home WORKING default is 22px. Width scales proportionally."
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height (mobile)",
      "min": 16,
      "max": 64,
      "step": 1,
      "default": 22,
      "unit": "px",
      "info": "Applies at ≤768px."
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": true,
      "info": "Keep header fixed to the top while scrolling."
    },
    {
      "type": "select",
      "id": "nav_link_size",
      "label": "Nav link size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "10", "label": "10px" },
        { "value": "11", "label": "11px" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px (live match)" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" }
      ],
      "default": "default",
      "info": "LOCKED 2026-08-11 nav #2: Type OS default = 13px / 500. Prefer 13px (v20d chrome)."
    },
    {
      "type": "range",
      "id": "nav_gap",
      "label": "Nav item gap",
      "min": 16,
      "max": 48,
      "step": 2,
      "default": 26,
      "unit": "px",
      "info": "26px matches v20d LOCKED nav #2."
    },
    {
      "type": "header",
      "content": "Section — Header"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "Header text / icons",
      "default": "#4a4a4a",
      "info": "Nav links, utility actions, and hamburger."
    }
  ]
}
{% endschema %}
