{% comment %}
  Split hero — 50/50 media | copy
  Authority: Home WORKING · type via design-tokens.css (no local font overrides)
  Font family is brand Type OS — size/weight only; no font_picker.
  CSS: assets/split-hero.css
{% endcomment %}

{{ 'split-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign media_type = section.settings.media_type | default: 'image'
  assign image = section.settings.image
  assign image_url = section.settings.image_url
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign image_alt = section.settings.image_alt
  assign title = section.settings.title
  assign body = section.settings.body
  assign cta_text = section.settings.cta_text
  assign tag_text = section.settings.tag_text
  assign trust_text = section.settings.trust_text

  assign heading_level = section.settings.heading_level | default: 'h1'
  if heading_level != 'h1' and heading_level != 'h2' and heading_level != 'h3' and heading_level != 'h4' and heading_level != 'h5' and heading_level != 'h6'
    assign heading_level = 'h1'
  endif

  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_url = cta_target
  else
    assign cta_url = section.settings.cta_url
  endif

  assign trust_target = section.settings.trust_link_target | default: 'custom'
  if trust_target != blank and trust_target != 'custom'
    assign trust_url = trust_target
  else
    assign trust_url = section.settings.trust_url
  endif

  assign tag_target = section.settings.tag_link_target | default: 'custom'
  if tag_target != blank and tag_target != 'custom'
    assign tag_url = tag_target
  else
    assign tag_url = section.settings.tag_url
  endif

  if image_alt == blank and image != blank
    assign image_alt = image.alt | default: title
  endif

  assign reverse_layout = section.settings.reverse_layout
  assign title_size = section.settings.title_size | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign body_weight = section.settings.body_weight | default: 'default'
  assign star_color = section.settings.star_color | default: settings.star_color_global | default: '#E5C71F'
  assign star_size = section.settings.star_size | default: settings.star_size_global | default: 14
  assign trust_text_size = section.settings.trust_text_size | default: 'default'
  assign trust_gap = section.settings.trust_gap | default: 10
  assign trust_below = section.settings.trust_below | default: 16
  assign media_column_pct = section.settings.media_column_pct | default: 62
  assign media_radius = section.settings.media_radius | default: 0
  assign sh_pos = section.settings.image_position
  if sh_pos == blank
    assign sh_px = section.settings.image_pos_x | default: 50
    assign sh_py = section.settings.image_pos_y | default: 50
    if sh_px == 50 and sh_py == 50
      assign sh_pos = 'center'
    else
      assign sh_pos = 'custom'
    endif
  endif
  if sh_pos == 'custom'
    assign img_x = section.settings.image_pos_x | default: 50
    assign img_y = section.settings.image_pos_y | default: 50
    assign img_zoom = section.settings.image_zoom | default: 100
  elsif sh_pos == 'top left'
    assign img_x = 0
    assign img_y = 0
    assign img_zoom = section.settings.image_zoom | default: 100
  elsif sh_pos == 'top'
    assign img_x = 50
    assign img_y = 0
    assign img_zoom = section.settings.image_zoom | default: 100
  elsif sh_pos == 'top right'
    assign img_x = 100
    assign img_y = 0
    assign img_zoom = section.settings.image_zoom | default: 100
  elsif sh_pos == 'left'
    assign img_x = 0
    assign img_y = 50
    assign img_zoom = section.settings.image_zoom | default: 100
  elsif sh_pos == 'right'
    assign img_x = 100
    assign img_y = 50
    assign img_zoom = section.settings.image_zoom | default: 100
  elsif sh_pos == 'bottom left'
    assign img_x = 0
    assign img_y = 100
    assign img_zoom = section.settings.image_zoom | default: 100
  elsif sh_pos == 'bottom'
    assign img_x = 50
    assign img_y = 100
    assign img_zoom = section.settings.image_zoom | default: 100
  elsif sh_pos == 'bottom right'
    assign img_x = 100
    assign img_y = 100
    assign img_zoom = section.settings.image_zoom | default: 100
  else
    assign img_x = 50
    assign img_y = 50
    assign img_zoom = section.settings.image_zoom | default: 100
  endif
  assign sh_pos_m = section.settings.image_position_mobile | default: 'same'
  if sh_pos_m == 'same' or sh_pos_m == blank
    assign img_x_m = img_x
    assign img_y_m = img_y
    assign img_zoom_m = img_zoom
  elsif sh_pos_m == 'custom'
    assign img_x_m = section.settings.image_pos_x_mobile | default: img_x
    assign img_y_m = section.settings.image_pos_y_mobile | default: img_y
    assign img_zoom_m = section.settings.image_zoom_mobile | default: img_zoom
  elsif sh_pos_m == 'top left'
    assign img_x_m = 0
    assign img_y_m = 0
    assign img_zoom_m = section.settings.image_zoom_mobile | default: img_zoom
  elsif sh_pos_m == 'top'
    assign img_x_m = 50
    assign img_y_m = 0
    assign img_zoom_m = section.settings.image_zoom_mobile | default: img_zoom
  elsif sh_pos_m == 'top right'
    assign img_x_m = 100
    assign img_y_m = 0
    assign img_zoom_m = section.settings.image_zoom_mobile | default: img_zoom
  elsif sh_pos_m == 'left'
    assign img_x_m = 0
    assign img_y_m = 50
    assign img_zoom_m = section.settings.image_zoom_mobile | default: img_zoom
  elsif sh_pos_m == 'right'
    assign img_x_m = 100
    assign img_y_m = 50
    assign img_zoom_m = section.settings.image_zoom_mobile | default: img_zoom
  elsif sh_pos_m == 'bottom left'
    assign img_x_m = 0
    assign img_y_m = 100
    assign img_zoom_m = section.settings.image_zoom_mobile | default: img_zoom
  elsif sh_pos_m == 'bottom'
    assign img_x_m = 50
    assign img_y_m = 100
    assign img_zoom_m = section.settings.image_zoom_mobile | default: img_zoom
  elsif sh_pos_m == 'bottom right'
    assign img_x_m = 100
    assign img_y_m = 100
    assign img_zoom_m = section.settings.image_zoom_mobile | default: img_zoom
  else
    assign img_x_m = 50
    assign img_y_m = 50
    assign img_zoom_m = section.settings.image_zoom_mobile | default: img_zoom
  endif
  assign media_ratio_w = 2400
  assign media_ratio_h = 2750
  if image != blank and image.width > 0 and image.height > 0
    assign media_ratio_w = image.width
    assign media_ratio_h = image.height
  endif
  assign cta_size = section.settings.cta_size | default: 'default'
  assign cta_style = section.settings.cta_style | default: 'solid'
  assign cta_bg = section.settings.cta_bg_color | default: '#c45c3f'
  assign cta_border = section.settings.cta_border_color | default: cta_bg
  assign cta_text_color = section.settings.cta_text_color | default: '#ffffff'

  assign region_label = section.settings.aria_label | strip
  if region_label == blank and title != blank
    assign region_label = title | strip_html | strip
  endif
  if region_label == blank
    assign region_label = 'Split hero'
  endif

  # media-img shared params — object-position stays on CSS class (--sh-img-x/y)
  assign sh_pos_css = 'css'
  assign sh_widths = '800, 1200, 1600, 2000, 2400'
  assign sh_width_default = 2400
  assign sh_widths_v = '600, 900, 1200, 1600'
  assign sh_width_default_v = 1600
  assign sh_sizes = '(max-width: 768px) 100vw, 62vw'
  assign sh_sizes_v = '(max-width: 768px) 100vw, 50vw'
  assign sh_alt_fallback = 'Barreletics Performance Skins — grip that holds in every studio workout'
-%}

<div
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} split-hero{% if reverse_layout %} split-hero--reverse{% endif %}{% render 'split-mobile-stack-class', mobile_stack_order: section.settings.mobile_stack_order %}"
  id="split-hero-{{ section.id }}"
  role="region"
  aria-label="{{ region_label | escape }}"
  style="{% render 'section-inset-vars' %}"
>
  <div class="split-hero__media" data-media-type="{{ media_type }}">
    {%- if media_type == 'video' -%}
      {%- if video != blank -%}
        {{
          video
          | video_tag:
            image_size: '1600x',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            class: 'split-hero__video'
        }}
      {%- elsif video_url != blank -%}
        <video
          class="split-hero__video"
          src="{{ video_url }}"
          {% if image != blank %}poster="{{ image | image_url: width: 1600 }}"{% endif %}
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="metadata"
        ></video>
      {%- elsif image != blank -%}
        {%- assign sh_alt_v = image_alt -%}
        {% render 'media-img',
           image: image,
           alt: sh_alt_v,
           class: 'split-hero__img',
           widths: sh_widths_v,
           width_default: sh_width_default_v,
           sizes: sh_sizes_v,
           loading: 'eager',
           fetchpriority: 'high',
           position: sh_pos_css %}
      {%- else -%}
        <div class="split-hero__placeholder" role="img" aria-label="Add video or poster image">
          Add video (or poster image) in Theme Editor
        </div>
      {%- endif -%}
    {%- else -%}
      {%- if image != blank -%}
        {%- assign sh_alt_i = image_alt -%}
        {% render 'media-img',
           image: image,
           alt: sh_alt_i,
           class: 'split-hero__img',
           widths: sh_widths,
           width_default: sh_width_default,
           sizes: sh_sizes,
           loading: 'eager',
           fetchpriority: 'high',
           position: sh_pos_css %}
      {%- elsif image_url != blank -%}
        {%- liquid
          assign sh_alt_url = image_alt | default: sh_alt_fallback
          if image_url contains '://'
            assign sh_src_url = image_url
          else
            assign sh_src_url = image_url | asset_url
          endif
        -%}
        {% render 'media-img',
           url: sh_src_url,
           alt: sh_alt_url,
           class: 'split-hero__img',
           loading: 'eager',
           fetchpriority: 'high',
           position: sh_pos_css,
           width_attr: 2400,
           height_attr: 1890 %}
      {%- else -%}
        <div class="split-hero__placeholder" role="img" aria-label="Add hero image in Theme Editor">
          Add pink-shorts hero image in Theme Editor
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="split-hero__copy">
    {%- if section.settings.show_trust -%}
      {%- assign trust_plain = trust_text | strip_html | strip -%}
      {%- if section.settings.show_stars or trust_plain != blank -%}
        <div class="split-hero__trust">
          {%- if section.settings.show_stars -%}
            <span class="split-hero__stars" aria-hidden="true">★★★★★</span>
            <span class="visually-hidden">5 out of 5 stars</span>
          {%- endif -%}
          {%- if trust_plain != blank -%}
            {%- if trust_url != blank -%}
              <a class="split-hero__trust-link" href="{{ trust_url }}">{{ trust_plain | escape }}</a>
            {%- else -%}
              <div class="split-hero__trust-text rte">{{ trust_text }}</div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if title != blank -%}
      {%- comment -%}
        No lone last word: bind the last two words with a non-breaking space (literal U+00A0; the &nbsp; entity was being escaped)
        ("The Pilates Sock Era is Over" never leaves "Over" alone on phone; QC 2026-09-30).
      {%- endcomment -%}
      {%- liquid
        assign sh_title_words = title | strip | split: ' '
        if sh_title_words.size > 2
          assign sh_title_last = sh_title_words | last | escape
          assign sh_title_head_n = sh_title_words.size | minus: 1
          assign sh_title_html = ''
          for sh_w in sh_title_words limit: sh_title_head_n
            assign sh_w_esc = sh_w | escape
            if forloop.first
              assign sh_title_html = sh_w_esc
            else
              assign sh_title_html = sh_title_html | append: ' ' | append: sh_w_esc
            endif
          endfor
          assign sh_title_html = sh_title_html | append: ' ' | append: sh_title_last
        else
          assign sh_title_html = title | escape
        endif
      -%}
      {% case heading_level %}
        {% when 'h2' %}
          <h2 class="split-hero__title type-hero">{{ sh_title_html }}</h2>
        {% when 'h3' %}
          <h3 class="split-hero__title type-hero">{{ sh_title_html }}</h3>
        {% when 'h4' %}
          <h4 class="split-hero__title type-hero">{{ sh_title_html }}</h4>
        {% when 'h5' %}
          <h5 class="split-hero__title type-hero">{{ sh_title_html }}</h5>
        {% when 'h6' %}
          <h6 class="split-hero__title type-hero">{{ sh_title_html }}</h6>
        {% else %}
          <h1 class="split-hero__title type-hero">{{ sh_title_html }}</h1>
      {% endcase %}
    {%- endif -%}

    {%- if body != blank -%}
      <div class="split-hero__body rte">{{ body }}</div>
    {%- endif -%}

    {%- if cta_text != blank -%}
      <div class="split-hero__ctas">
        <a
          href="{{ cta_url | default: routes.all_products_collection_url }}"
          class="split-hero__cta{% if cta_style == 'outline' %} split-hero__cta--outline{% endif %}"
        >
          {{ cta_text | escape }}
        </a>
      </div>
    {%- endif -%}

    {%- if tag_text != blank and tag_url != blank -%}
      <a class="split-hero__tag" href="{{ tag_url }}">{{ tag_text | escape }}</a>
    {%- elsif tag_text != blank -%}
      <span class="split-hero__tag">{{ tag_text | escape }}</span>
    {%- endif -%}
  </div>
</div>

{%- comment -%} TE live preview: patch CSS vars here (!important beats stale inline). {%- endcomment -%}
{% style %}
  {%- liquid
    assign sh_pos = section.settings.image_position
    if sh_pos == blank
      assign sh_px = section.settings.image_pos_x | default: 50
      assign sh_py = section.settings.image_pos_y | default: 50
      if sh_px == 50 and sh_py == 50
        assign sh_pos = 'center'
      else
        assign sh_pos = 'custom'
      endif
    endif
    if sh_pos == 'custom'
      assign te_ix = section.settings.image_pos_x | default: 50
      assign te_iy = section.settings.image_pos_y | default: 50
    elsif sh_pos == 'top left'
      assign te_ix = 0
      assign te_iy = 0
    elsif sh_pos == 'top'
      assign te_ix = 50
      assign te_iy = 0
    elsif sh_pos == 'top right'
      assign te_ix = 100
      assign te_iy = 0
    elsif sh_pos == 'left'
      assign te_ix = 0
      assign te_iy = 50
    elsif sh_pos == 'right'
      assign te_ix = 100
      assign te_iy = 50
    elsif sh_pos == 'bottom left'
      assign te_ix = 0
      assign te_iy = 100
    elsif sh_pos == 'bottom'
      assign te_ix = 50
      assign te_iy = 100
    elsif sh_pos == 'bottom right'
      assign te_ix = 100
      assign te_iy = 100
    else
      assign te_ix = 50
      assign te_iy = 50
    endif
    assign te_iz = section.settings.image_zoom | default: 100
    assign sh_pos_m = section.settings.image_position_mobile | default: 'same'
    if sh_pos_m == 'same' or sh_pos_m == blank
      assign te_ixm = te_ix
      assign te_iym = te_iy
      assign te_izm = te_iz
    elsif sh_pos_m == 'custom'
      assign te_ixm = section.settings.image_pos_x_mobile | default: te_ix
      assign te_iym = section.settings.image_pos_y_mobile | default: te_iy
      assign te_izm = section.settings.image_zoom_mobile | default: te_iz
    elsif sh_pos_m == 'top left'
      assign te_ixm = 0
      assign te_iym = 0
      assign te_izm = section.settings.image_zoom_mobile | default: te_iz
    elsif sh_pos_m == 'top'
      assign te_ixm = 50
      assign te_iym = 0
      assign te_izm = section.settings.image_zoom_mobile | default: te_iz
    elsif sh_pos_m == 'top right'
      assign te_ixm = 100
      assign te_iym = 0
      assign te_izm = section.settings.image_zoom_mobile | default: te_iz
    elsif sh_pos_m == 'left'
      assign te_ixm = 0
      assign te_iym = 50
      assign te_izm = section.settings.image_zoom_mobile | default: te_iz
    elsif sh_pos_m == 'right'
      assign te_ixm = 100
      assign te_iym = 50
      assign te_izm = section.settings.image_zoom_mobile | default: te_iz
    elsif sh_pos_m == 'bottom left'
      assign te_ixm = 0
      assign te_iym = 100
      assign te_izm = section.settings.image_zoom_mobile | default: te_iz
    elsif sh_pos_m == 'bottom'
      assign te_ixm = 50
      assign te_iym = 100
      assign te_izm = section.settings.image_zoom_mobile | default: te_iz
    elsif sh_pos_m == 'bottom right'
      assign te_ixm = 100
      assign te_iym = 100
      assign te_izm = section.settings.image_zoom_mobile | default: te_iz
    else
      assign te_ixm = 50
      assign te_iym = 50
      assign te_izm = section.settings.image_zoom_mobile | default: te_iz
    endif
    assign te_star = section.settings.star_size | default: 14
    assign te_star_c = section.settings.star_color | default: '#d4af37'
  -%}
  #split-hero-{{ section.id }} {
    --sh-media-pct: {{ section.settings.media_column_pct | default: 62 }}% !important;
    --sh-height-scale: {{ section.settings.media_height | default: 100 | times: 0.01 }} !important;
    --sh-media-radius: {{ section.settings.media_radius | default: 0 }}px !important;
    --sh-copy-bg: {{ section.settings.bg_color | default: '#ffffff' }} !important;
    --sh-img-x: {{ te_ix }}% !important;
    --sh-img-y: {{ te_iy }}% !important;
    --sh-img-zoom: {{ te_iz | at_least: 100 | times: 0.01 }} !important;
    --sh-img-x-m: {{ te_ixm }}% !important;
    --sh-img-y-m: {{ te_iym }}% !important;
    --sh-img-zoom-m: {{ te_izm | at_least: 100 | times: 0.01 }} !important;
    --sh-star-color: {{ te_star_c }} !important;
    --sh-star-size: {{ te_star }}px !important;
    --sh-trust-gap: {{ section.settings.trust_gap | default: 10 }}px !important;
    --sh-trust-below: {{ section.settings.trust_below | default: 16 }}px !important;
    --sh-cta-bg: {{ section.settings.cta_bg_color | default: '#c45c3f' }} !important;
    --sh-cta-border: {{ section.settings.cta_border_color | default: section.settings.cta_bg_color | default: '#c45c3f' }} !important;
    --sh-cta-text: {{ section.settings.cta_text_color | default: '#ffffff' }} !important;
    {%- if section.settings.inset_custom_mobile -%}
    --section-inset-top-m: {{ section.settings.inset_top_mobile | default: 0 }}px !important;
    --section-inset-bottom-m: {{ section.settings.inset_bottom_mobile | default: 0 }}px !important;
    --section-inset-left-m: {{ section.settings.inset_x_mobile | default: 0 }}px !important;
    --section-inset-right-m: {{ section.settings.inset_x_mobile | default: 0 }}px !important;
    {%- else -%}
    --section-inset-top-m: {{ section.settings.inset_top | default: 0 }}px !important;
    --section-inset-bottom-m: {{ section.settings.inset_bottom | default: 0 }}px !important;
    --section-inset-left-m: {{ section.settings.inset_x | default: 0 }}px !important;
    --section-inset-right-m: {{ section.settings.inset_x | default: 0 }}px !important;
    {%- endif -%}
    --section-inset-top: {{ section.settings.inset_top | default: 0 }}px !important;
    --section-inset-bottom: {{ section.settings.inset_bottom | default: 0 }}px !important;
    --section-inset-left: {{ section.settings.inset_x | default: 0 }}px !important;
    --section-inset-right: {{ section.settings.inset_x | default: 0 }}px !important;
  }
{% endstyle %}

{% render 'bg-video-autoplay-script',
  section_id: section.id,
  root_class: 'split-hero',
  video_selector: 'video.split-hero__video, .split-hero__media video'
%}

{% schema %}
{
  "name": "Split hero",
  "tag": "section",
  "class": "section-split-hero",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Pilates Sock Era is Over",
      "info": "Family is brand Type OS — use Title size/weight to adjust. No font family picker."
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1",
      "info": "Outputs the real HTML tag (h1–h6) for SEO/accessibility. Visual size is Title size — not this control."
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" },
        { "value": "24", "label": "24px" },
        { "value": "26", "label": "26px" },
        { "value": "28", "label": "28px" },
        { "value": "30", "label": "30px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "56", "label": "56px" },
        { "value": "64", "label": "64px" },
        { "value": "72", "label": "72px" }
      ],
      "default": "default",
      "info": "Family is brand Type OS — size only. Default keeps Type OS hero size."
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Outperforms barre socks, Pilates socks, and yoga socks — combined.</p>",
      "info": "Family is brand Type OS — use Body size/weight to adjust. No font family picker."
    },
    {
      "type": "select",
