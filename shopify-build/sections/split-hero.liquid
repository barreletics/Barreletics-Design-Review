{% comment %}
  Split hero — 50/50 media | copy
  Authority: Home WORKING · type via design-tokens.css (no local font overrides)
  Font family is brand Type OS — size/weight only; no font_picker.
  CSS: assets/split-hero.css
{% endcomment %}

{{ 'split-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign media_type = section.settings.media_type | default: 'image'
  assign image = section.settings.image
  assign image_url = section.settings.image_url
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign image_alt = section.settings.image_alt
  assign title = section.settings.title
  assign body = section.settings.body
  assign cta_text = section.settings.cta_text
  assign tag_text = section.settings.tag_text
  assign trust_text = section.settings.trust_text

  assign heading_level = section.settings.heading_level | default: 'h1'
  if heading_level != 'h1' and heading_level != 'h2' and heading_level != 'h3' and heading_level != 'h4' and heading_level != 'h5' and heading_level != 'h6'
    assign heading_level = 'h1'
  endif

  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_url = cta_target
  else
    assign cta_url = section.settings.cta_url
  endif

  assign trust_target = section.settings.trust_link_target | default: 'custom'
  if trust_target != blank and trust_target != 'custom'
    assign trust_url = trust_target
  else
    assign trust_url = section.settings.trust_url
  endif

  assign tag_target = section.settings.tag_link_target | default: 'custom'
  if tag_target != blank and tag_target != 'custom'
    assign tag_url = tag_target
  else
    assign tag_url = section.settings.tag_url
  endif

  if image_alt == blank and image != blank
    assign image_alt = image.alt | default: title
  endif

  assign reverse_layout = section.settings.reverse_layout
  assign title_size = section.settings.title_size | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign body_weight = section.settings.body_weight | default: 'default'
  assign star_color = section.settings.star_color | default: '#d4af37'
  assign star_size = section.settings.star_size | default: 14
  assign trust_text_size = section.settings.trust_text_size | default: 'default'
  assign trust_gap = section.settings.trust_gap | default: 10
  assign trust_below = section.settings.trust_below | default: 16
  assign media_column_pct = section.settings.media_column_pct | default: 62
  assign media_radius = section.settings.media_radius | default: 0
  assign cta_size = section.settings.cta_size | default: 'default'
  assign cta_style = section.settings.cta_style | default: 'solid'
  assign cta_bg = section.settings.cta_bg_color | default: '#c45c3f'
  assign cta_border = section.settings.cta_border_color | default: cta_bg
  assign cta_text_color = section.settings.cta_text_color | default: '#ffffff'

  assign region_label = section.settings.aria_label | strip
  if region_label == blank
    assign region_label = title
  endif
-%}

<div
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} split-hero{% if reverse_layout %} split-hero--reverse{% endif %}"
  id="split-hero-{{ section.id }}"
  role="region"
  {% if region_label != blank %}aria-label="{{ region_label | escape }}"{% endif %}
  style="
    {% render 'section-inset-vars' %}
    --sh-media-pct: {{ media_column_pct }}%;
    --sh-media-radius: {{ media_radius }}px;
    --sh-star-color: {{ star_color }};
    --sh-star-size: {{ star_size }}px;
    --sh-trust-gap: {{ trust_gap }}px;
    --sh-trust-below: {{ trust_below }}px;
    --sh-cta-bg: {{ cta_bg }};
    --sh-cta-border: {{ cta_border }};
    --sh-cta-text: {{ cta_text_color }};
    {% if trust_text_size != 'default' %}--sh-trust-size: {{ trust_text_size }}px;{% endif %}
    {% if title_size != 'default' %}--sh-title-size: {{ title_size }}px;{% endif %}
    {% if body_size != 'default' %}--sh-body-size: {{ body_size }}px;{% endif %}
    {% if title_weight != 'default' %}--sh-title-weight: {{ title_weight }};{% endif %}
    {% if body_weight != 'default' %}--sh-body-weight: {{ body_weight }};{% endif %}
    {% if cta_size != 'default' %}--sh-cta-size: {{ cta_size }}px;{% endif %}
  "
>
  <div class="split-hero__media" data-media-type="{{ media_type }}">
    {%- if media_type == 'video' -%}
      {%- if video != blank -%}
        {{
          video
          | video_tag:
            image_size: '1600x',
            autoplay: true,
            loop: true,
            muted: true,
            controls: section.settings.video_controls,
            playsinline: true,
            class: 'split-hero__video'
        }}
      {%- elsif video_url != blank -%}
        <video
          class="split-hero__video"
          src="{{ video_url }}"
          {% if image != blank %}poster="{{ image | image_url: width: 1600 }}"{% endif %}
          autoplay
          muted
          loop
          playsinline
          {% if section.settings.video_controls %}controls{% endif %}
        ></video>
      {%- elsif image != blank -%}
        {{
          image
          | image_url: width: 1600
          | image_tag:
            widths: '600, 900, 1200, 1600',
            sizes: '(max-width: 768px) 100vw, 50vw',
            alt: image_alt,
            loading: 'eager',
            fetchpriority: 'high',
            decoding: 'async',
            class: 'split-hero__img'
        }}
      {%- else -%}
        <div class="split-hero__placeholder" role="img" aria-label="Add video or poster image">
          Add video (or poster image) in Theme Editor
        </div>
      {%- endif -%}
    {%- else -%}
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 2400
          | image_tag:
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '(max-width: 768px) 100vw, 62vw',
            alt: image_alt,
            loading: 'eager',
            fetchpriority: 'high',
            decoding: 'async',
            class: 'split-hero__img'
        }}
      {%- elsif image_url != blank -%}
        <img
          class="split-hero__img"
          src="{{ image_url | escape }}"
          alt="{{ image_alt | default: 'Barreletics Performance Skins — grip that holds in every studio workout' | escape }}"
          width="2400"
          height="2750"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {%- else -%}
        <div class="split-hero__placeholder" role="img" aria-label="Add hero image in Theme Editor">
          Add pink-shorts hero image in Theme Editor
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="split-hero__copy">
    {%- if section.settings.show_trust -%}
      {%- assign trust_plain = trust_text | strip_html | strip -%}
      {%- if section.settings.show_stars or trust_plain != blank -%}
        <div class="split-hero__trust">
          {%- if section.settings.show_stars -%}
            <span class="split-hero__stars" aria-hidden="true">★★★★★</span>
            <span class="visually-hidden">5 out of 5 stars</span>
          {%- endif -%}
          {%- if trust_plain != blank -%}
            {%- if trust_url != blank -%}
              <a class="split-hero__trust-link" href="{{ trust_url }}">{{ trust_plain | escape }}</a>
            {%- else -%}
              <div class="split-hero__trust-text rte">{{ trust_text }}</div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if title != blank -%}
      {% case heading_level %}
        {% when 'h2' %}
          <h2 class="split-hero__title type-hero">{{ title | escape }}</h2>
        {% when 'h3' %}
          <h3 class="split-hero__title type-hero">{{ title | escape }}</h3>
        {% when 'h4' %}
          <h4 class="split-hero__title type-hero">{{ title | escape }}</h4>
        {% when 'h5' %}
          <h5 class="split-hero__title type-hero">{{ title | escape }}</h5>
        {% when 'h6' %}
          <h6 class="split-hero__title type-hero">{{ title | escape }}</h6>
        {% else %}
          <h1 class="split-hero__title type-hero">{{ title | escape }}</h1>
      {% endcase %}
    {%- endif -%}

    {%- if body != blank -%}
      <div class="split-hero__body rte">{{ body }}</div>
    {%- endif -%}

    {%- if cta_text != blank -%}
      <div class="split-hero__ctas">
        <a
          href="{{ cta_url | default: routes.all_products_collection_url }}"
          class="split-hero__cta{% if cta_style == 'outline' %} split-hero__cta--outline{% endif %}"
        >
          {{ cta_text | escape }}
        </a>
      </div>
    {%- endif -%}

    {%- if tag_text != blank and tag_url != blank -%}
      <a class="split-hero__tag" href="{{ tag_url }}">{{ tag_text | escape }}</a>
    {%- elsif tag_text != blank -%}
      <span class="split-hero__tag">{{ tag_text | escape }}</span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Split hero",
  "tag": "section",
  "class": "section-split-hero",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Pilates Sock Era is Over",
      "info": "Family is brand Type OS — use Title size/weight to adjust. No font family picker."
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1",
      "info": "Outputs the real HTML tag (h1–h6) for SEO/accessibility. Visual size is Title size — not this control."
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" },
        { "value": "24", "label": "24px" },
        { "value": "26", "label": "26px" },
        { "value": "28", "label": "28px" },
        { "value": "30", "label": "30px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "56", "label": "56px" },
        { "value": "64", "label": "64px" },
        { "value": "72", "label": "72px" }
      ],
      "default": "default",
      "info": "Family is brand Type OS — size only. Default keeps Type OS hero size."
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Outperforms barre socks, Pilates socks, and yoga socks — combined.</p>",
      "info": "Family is brand Type OS — use Body size/weight to adjust. No font family picker."
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" },
        { "value": "24", "label": "24px" },
        { "value": "26", "label": "26px" },
        { "value": "28", "label": "28px" },
        { "value": "30", "label": "30px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "56", "label": "56px" }
      ],
      "default": "default",
      "info": "Family is brand Type OS — size only."
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Body weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA label",
      "default": "Shop Now"
    },
    {
      "type": "select",
      "id": "cta_size",
      "label": "CTA font size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "11", "label": "11px" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "options": [
        { "value": "solid", "label": "Solid fill" },
        { "value": "outline", "label": "Outline only" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA background color",
      "default": "#c45c3f",
      "info": "Used for solid fill. Outline style uses transparent fill + border color."
    },
    {
      "type": "color",
      "id": "cta_border_color",
      "label": "CTA outline / border color",
      "default": "#c45c3f"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA label color",
      "default": "#ffffff",
      "info": "Solid fill: usually white. Outline or light fill: charcoal/black."
    },
    {
      "type": "select",
      "id": "cta_link_target",
      "label": "CTA link",
      "options": [
        { "value": "custom", "label": "Custom URL…" },
        { "value": "#variants", "label": "#variants — Shop styles" },
        { "value": "#knock-socks", "label": "#knock-socks — Statement" },
        { "value": "#reviews", "label": "#reviews" },
        { "value": "#guarantee", "label": "#guarantee" },
        { "value": "#never-loses-grip", "label": "#never-loses-grip" },
        { "value": "#one-pair", "label": "#one-pair" },
        { "value": "#coperni", "label": "#coperni — Collab" },
        { "value": "#problem", "label": "#problem" }
      ],
      "default": "#variants",
      "info": "Homepage section anchors jump on the same page. Choose Custom URL… for a full URL or any other #hash. Blank custom → all-products collection."
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Custom CTA URL",
      "info": "Used when CTA link = Custom URL…. Full URL, relative path, or custom #hash."
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Hashtag line (under button)",
      "default": "#letusknockyoursocksoff",
      "info": "Optional decorative text under the CTA (e.g. #letusknockyoursocksoff). Not a page section — just a visual line. Leave blank to hide. Optional link below."
    },
    {
      "type": "select",
      "id": "tag_link_target",
      "label": "Hashtag link",
      "options": [
        { "value": "custom", "label": "Custom URL… / none" },
        { "value": "#variants", "label": "#variants — Shop styles" },
        { "value": "#knock-socks", "label": "#knock-socks — Statement" },
        { "value": "#reviews", "label": "#reviews" },
        { "value": "#guarantee", "label": "#guarantee" },
        { "value": "#never-loses-grip", "label": "#never-loses-grip" },
        { "value": "#one-pair", "label": "#one-pair" },
        { "value": "#coperni", "label": "#coperni — Collab" },
        { "value": "#problem", "label": "#problem" }
      ],
      "default": "#knock-socks",
      "info": "Optional. Where the hashtag line goes when tapped. Custom URL… + empty field = plain text (no link)."
    },
    {
      "type": "text",
      "id": "tag_url",
      "label": "Custom hashtag URL",
      "info": "Used when Hashtag link = Custom URL… / none. Leave blank for non-linked text."
    },

    { "type": "header", "content": "Shared — Media" },
    {
      "type": "paragraph",
      "content": "Pick media type first. Image mode: Shopify image → Image URL fallback. Video mode: Shopify video → Video URL (+ optional poster). Leave unused fields blank."
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video",
      "info": "Preferred when the file lives in Shopify Files. Use this OR Video URL — not both. Shopify video wins if both are set."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (mp4)",
      "info": "External/CDN mp4 when not using Shopify Video. Ignored if Shopify video is set. Leave blank in image mode."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image / poster (Shopify)",
      "info": "Still image for image mode, OR poster when using Video URL. Prefer this over URL fields when the asset is in Shopify. Leave blank to use Image URL fallback."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL fallback",
      "default": "https://barreletics.com/cdn/shop/products/barreletixxstefrunningpinkbackground.jpg?v=1710549452&width=2400",
      "info": "Used only when Shopify image picker is empty and media type is Image — for CDN/external stills. Leave blank if Shopify image is set."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Barreletics Performance Skins — grip that holds in every studio workout"
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "Show video controls",
      "default": false
    },

    { "type": "header", "content": "Shared — Layout" },
    {
      "type": "range",
      "id": "media_column_pct",
      "label": "Media column %",
      "min": 35,
      "max": 65,
      "step": 1,
      "unit": "%",
      "default": 62,
      "info": "Desktop only. Text = 100 − media %. Default 62 matches Home WORKING media-dominant hero."
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Media corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "One control — applies equally to all four corners of the media panel."
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse layout (copy left / media right)",
      "default": false,
      "info": "Desktop only. Mobile stays media first."
    },

    { "type": "header", "content": "Section — Split hero — trust" },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust row",
      "default": true,
      "info": "Stars + “Trusted by…” above the headline (Home WORKING order)."
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#d4af37"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "trust_text_size",
      "label": "Trust text size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "18", "label": "18px" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "trust_gap",
      "label": "Trust row gap (stars ↔ text)",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10,
      "info": "Horizontal space between stars and trust text."
    },
    {
      "type": "range",
      "id": "trust_below",
      "label": "Gap below trust row",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16,
      "info": "Space between the trust row and the heading — move the row up/down relative to the title."
    },
    {
      "type": "richtext",
      "id": "trust_text",
      "label": "Trust text",
      "default": "<p>Trusted by 1,000's of instructors & studios</p>"
    },
    {
      "type": "select",
      "id": "trust_link_target",
      "label": "Trust link",
      "options": [
        { "value": "custom", "label": "Custom URL… / none" },
        { "value": "#variants", "label": "#variants — Shop styles" },
        { "value": "#knock-socks", "label": "#knock-socks — Statement" },
        { "value": "#reviews", "label": "#reviews" },
        { "value": "#guarantee", "label": "#guarantee" },
        { "value": "#never-loses-grip", "label": "#never-loses-grip" },
        { "value": "#one-pair", "label": "#one-pair" },
        { "value": "#coperni", "label": "#coperni — Collab" },
        { "value": "#problem", "label": "#problem" }
      ],
      "default": "#reviews",
      "info": "Wraps trust text in a link. Custom URL… + empty field = plain text (no link)."
    },
    {
