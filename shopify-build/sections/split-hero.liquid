{% comment %}
  Split hero — 50/50 media | copy (Theme Editor parity with fifty-fifty / problem-section).
  Unique: type-hero title scale, trust stars + links, hashtag line, 92vh × media_height.
  Font family is brand Type OS — size/weight only; no font_picker. CSS: assets/split-hero.css
{% endcomment %}

{{ 'split-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign image = section.settings.image
  assign image_url = section.settings.image_url
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign image_alt = section.settings.image_alt
  assign title = section.settings.title
  assign body = section.settings.body
  assign cta_text = section.settings.cta_text
  assign tag_text = section.settings.tag_text
  assign trust_text = section.settings.trust_text

  assign heading_level = section.settings.heading_level | default: 'h1'
  if heading_level != 'h1' and heading_level != 'h2' and heading_level != 'h3' and heading_level != 'h4' and heading_level != 'h5' and heading_level != 'h6'
    assign heading_level = 'h1'
  endif

  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_url = cta_target
  else
    assign cta_url = section.settings.cta_url
  endif

  assign trust_target = section.settings.trust_link_target | default: 'custom'
  if trust_target != blank and trust_target != 'custom'
    assign trust_url = trust_target
  else
    assign trust_url = section.settings.trust_url
  endif

  assign tag_target = section.settings.tag_link_target | default: 'custom'
  if tag_target != blank and tag_target != 'custom'
    assign tag_url = tag_target
  else
    assign tag_url = section.settings.tag_url
  endif

  if image_alt == blank and image != blank
    assign image_alt = image.alt | default: title
  endif

  assign reverse_layout = section.settings.reverse
  if reverse_layout == nil
    assign reverse_layout = section.settings.reverse_layout
  endif

  assign show_trust_row = section.settings.show_trust_strip
  if show_trust_row == nil
    assign show_trust_row = section.settings.show_trust
  endif
  if show_trust_row == nil
    assign show_trust_row = true
  endif

  assign title_size = section.settings.title_size | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign body_weight = section.settings.body_weight | default: 'default'
  assign cta_size = section.settings.cta_size | default: 'default'
  assign star_color = section.settings.star_color | default: settings.star_color_global | default: '#E5C71F'
  assign star_size = section.settings.star_size | default: settings.star_size_global | default: 14
  assign trust_text_size = section.settings.trust_text_size | default: 'default'
  assign trust_gap = section.settings.trust_gap | default: 10
  assign trust_below = section.settings.trust_below | default: 16

  assign media_pct = section.settings.media_column_pct
  if media_pct == blank
    assign media_pct = 50
  endif
  assign media_radius = section.settings.media_radius | default: 0
  assign media_height = section.settings.media_height | default: 0
  if media_height == blank or media_height == 0
    assign media_height = 100
  endif

  assign media_fit = section.settings.media_fit | default: 'cover'
  assign image_fit_m = section.settings.image_fit_mobile | default: 'cover'
  assign media_aspect = section.settings.media_aspect | default: 'stretch'
  assign media_aspect_m = section.settings.media_aspect_mobile | default: 'stretch'
  assign mobile_media_height = section.settings.mobile_media_height | default: 0
  assign mobile_media_width = section.settings.mobile_media_width | default: 100

  assign bg_style = section.settings.bg_style
  if bg_style == 'white'
    assign panel_bg = '#ffffff'
  elsif bg_style == 'cream'
    assign panel_bg = '#faf8f6'
  elsif bg_style == 'darker_cream'
    assign panel_bg = '#efe9dd'
  else
    assign legacy_bg = section.settings.bg_color | default: ''
    if legacy_bg == '#faf8f6' or legacy_bg == '#FAF8F6'
      assign panel_bg = '#faf8f6'
    elsif legacy_bg == '#efe9dd' or legacy_bg == '#EFE9DD'
      assign panel_bg = '#efe9dd'
    elsif legacy_bg != blank
      assign panel_bg = legacy_bg
    else
      assign panel_bg = '#ffffff'
    endif
  endif

  assign media_pad_bg = section.settings.media_bg | default: '#ffffff'
  if media_pad_bg == blank
    assign media_pad_bg = '#ffffff'
  endif

  assign side_padding = section.settings.side_padding | default: 56
  assign text_pad_y_d = section.settings.text_pad_y | default: 72
  assign text_pad_y_m = section.settings.text_pad_y_mobile | default: 52
  assign text_pad_x_m = section.settings.text_pad_x_mobile | default: 24

  assign section_gap = 0
  if section.settings.section_gap == 0 or section.settings.section_gap != blank
    assign section_gap = section.settings.section_gap
  endif
  assign section_gap_m = 0
  if section.settings.section_gap_mobile == 0 or section.settings.section_gap_mobile != blank
    assign section_gap_m = section.settings.section_gap_mobile
  endif

  assign cta_style = section.settings.cta_style | default: 'rust_solid'
  if cta_style == 'solid'
    assign cta_style = 'rust_solid'
  elsif cta_style == 'outline'
    assign cta_style = 'rust_outline'
  endif
  case cta_style
    when 'rust_outline', 'outline'
      assign cta_btn_class = 'btn--brand-outline'
    when 'black_solid', 'primary'
      assign cta_btn_class = 'btn--primary'
    when 'black_outline', 'secondary'
      assign cta_btn_class = 'btn--secondary'
    else
      assign cta_btn_class = 'btn--brand'
  endcase

  assign region_label = section.settings.aria_label | strip
  if region_label == blank and title != blank
    assign region_label = title | strip_html | strip
  endif
  if region_label == blank
    assign region_label = 'Split hero'
  endif

  assign sh_pos = section.settings.image_position
  if sh_pos == blank
    assign sh_px = section.settings.image_pos_x | default: 50
    assign sh_py = section.settings.image_pos_y | default: 50
    if sh_px == 50 and sh_py == 50
      assign sh_pos = 'center'
    else
      assign sh_pos = 'custom'
    endif
  endif

  assign img_scale = section.settings.image_scale
  if img_scale == blank
    assign img_scale = section.settings.image_zoom | default: 100
  endif

  if sh_pos == 'custom'
    assign img_x = section.settings.focal_x
    if img_x == blank
      assign img_x = section.settings.image_pos_x | default: 50
    endif
    assign img_y = section.settings.focal_y
    if img_y == blank
      assign img_y = section.settings.image_pos_y | default: 50
    endif
  elsif sh_pos == 'top left'
    assign img_x = 0
    assign img_y = 0
  elsif sh_pos == 'top'
    assign img_x = 50
    assign img_y = 0
  elsif sh_pos == 'top right'
    assign img_x = 100
    assign img_y = 0
  elsif sh_pos == 'left'
    assign img_x = 0
    assign img_y = 50
  elsif sh_pos == 'right'
    assign img_x = 100
    assign img_y = 50
  elsif sh_pos == 'bottom left'
    assign img_x = 0
    assign img_y = 100
  elsif sh_pos == 'bottom'
    assign img_x = 50
    assign img_y = 100
  elsif sh_pos == 'bottom right'
    assign img_x = 100
    assign img_y = 100
  else
    assign img_x = 50
    assign img_y = 50
  endif

  assign sh_pos_m = section.settings.image_position_mobile | default: 'same'
  assign img_scale_m = section.settings.image_scale_mobile
  if img_scale_m == blank
    assign img_scale_m = section.settings.image_zoom_mobile | default: img_scale
  endif

  if sh_pos_m == 'same' or sh_pos_m == blank
    assign img_x_m = img_x
    assign img_y_m = img_y
  elsif sh_pos_m == 'custom'
    assign img_x_m = section.settings.focal_x_mobile
    if img_x_m == blank
      assign img_x_m = section.settings.image_pos_x_mobile | default: img_x
    endif
    assign img_y_m = section.settings.focal_y_mobile
    if img_y_m == blank
      assign img_y_m = section.settings.image_pos_y_mobile | default: img_y
    endif
  elsif sh_pos_m == 'top left'
    assign img_x_m = 0
    assign img_y_m = 0
  elsif sh_pos_m == 'top'
    assign img_x_m = 50
    assign img_y_m = 0
  elsif sh_pos_m == 'top right'
    assign img_x_m = 100
    assign img_y_m = 0
  elsif sh_pos_m == 'left'
    assign img_x_m = 0
    assign img_y_m = 50
  elsif sh_pos_m == 'right'
    assign img_x_m = 100
    assign img_y_m = 50
  elsif sh_pos_m == 'bottom left'
    assign img_x_m = 0
    assign img_y_m = 100
  elsif sh_pos_m == 'bottom'
    assign img_x_m = 50
    assign img_y_m = 100
  elsif sh_pos_m == 'bottom right'
    assign img_x_m = 100
    assign img_y_m = 100
  else
    assign img_x_m = 50
    assign img_y_m = 50
  endif

  assign has_video = false
  if video != blank or video_url != blank
    assign has_video = true
  endif

  assign sh_media_kind = 'image'
  if has_video
    assign sh_media_kind = 'video'
  endif

  assign sh_pos_css = 'css'
  assign sh_widths = '800, 1200, 1600, 2000, 2400'
  assign sh_width_default = 2400
  assign sh_widths_v = '600, 900, 1200, 1600'
  assign sh_width_default_v = 1600
  assign sh_sizes = '(max-width: 768px) 100vw, 62vw'
  assign sh_sizes_v = '(max-width: 768px) 100vw, 50vw'
  assign sh_alt_fallback = 'Barreletics Performance Skins — grip that holds in every studio workout'
-%}

<div
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} split-hero{% if reverse_layout %} split-hero--reverse{% endif %}{% if media_fit == 'contain' or media_fit == 'cover_inset' %} split-hero--contain{% endif %}{% if media_fit == 'fit' %} split-hero--fit{% endif %}{% if image_fit_m == 'fit' %} split-hero--fit-m{% endif %}{% if image_fit_m == 'contain' %} split-hero--contain-m{% endif %}{% if media_aspect == 'square' %} split-hero--media-square{% endif %}{% if media_aspect_m == 'square' %} split-hero--media-square-m{% endif %}{% render 'split-mobile-stack-class', mobile_stack_order: section.settings.mobile_stack_order %}"
  id="split-hero-{{ section.id }}"
  role="region"
  aria-label="{{ region_label | escape }}"
  style="{% render 'section-inset-vars' %}"
>
  <div class="split-hero__media" data-media-type="{{ sh_media_kind }}">
    {%- assign sh_pic = false -%}
    {%- if section.settings.image_mobile != blank and has_video == false -%}{%- assign sh_pic = true -%}
    <picture style="display:contents">
      <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 780 }} 780w, {{ section.settings.image_mobile | image_url: width: 1170 }} 1170w" sizes="100vw" width="{{ section.settings.image_mobile.width }}" height="{{ section.settings.image_mobile.height }}">
    {%- endif -%}
    {%- if video != blank -%}
      {{
        video
        | video_tag:
          image_size: '1600x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          class: 'split-hero__video'
      }}
    {%- elsif video_url != blank -%}
      <video
        class="split-hero__video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        {% if image != blank %}
          poster="{{ image | image_url: width: 1600 }}"
        {% elsif section.settings.poster_url != blank %}
          poster="{{ section.settings.poster_url | escape }}"
        {% endif %}
      >
        <source src="{{ video_url | escape }}" type="video/mp4">
      </video>
    {%- elsif image != blank -%}
      {%- assign sh_alt_i = image_alt -%}
      {% render 'media-img',
         image: image,
         alt: sh_alt_i,
         class: 'split-hero__img',
         widths: sh_widths,
         width_default: sh_width_default,
         sizes: sh_sizes,
         loading: 'eager',
         fetchpriority: 'high',
         position: sh_pos_css %}
    {%- elsif image_url != blank -%}
      {%- liquid
        assign sh_alt_url = image_alt | default: sh_alt_fallback
        if image_url contains '://'
          assign sh_src_url = image_url
        else
          assign sh_src_url = image_url | asset_url
        endif
      -%}
      {% render 'media-img',
         url: sh_src_url,
         alt: sh_alt_url,
         class: 'split-hero__img',
         loading: 'eager',
         fetchpriority: 'high',
         position: sh_pos_css,
         width_attr: 2400,
         height_attr: 1890 %}
    {%- else -%}
      <div class="split-hero__placeholder" role="img" aria-label="Add hero image in Theme Editor">
        Add hero image or video in Theme Editor
      </div>
    {%- endif -%}
    {%- if sh_pic %}</picture>{% endif %}
  </div>

  <div class="split-hero__copy">
    <div class="split-hero__stack">
      {%- if show_trust_row -%}
        {%- assign trust_plain = trust_text | strip_html | strip -%}
        {%- if section.settings.show_stars or trust_plain != blank -%}
          <div class="split-hero__trust">
            {%- if section.settings.show_stars -%}
              <span class="split-hero__stars" aria-hidden="true">★★★★★</span>
              <span class="visually-hidden">5 out of 5 stars</span>
            {%- endif -%}
            {%- if trust_plain != blank -%}
              {%- if trust_url != blank -%}
                <a class="split-hero__trust-link" href="{{ trust_url }}">{{ trust_plain | escape }}</a>
              {%- else -%}
                <div class="split-hero__trust-text rte">{{ trust_text }}</div>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if title != blank -%}
        {%- liquid
          assign sh_title_words = title | strip | split: ' '
          if sh_title_words.size > 2
            assign sh_title_last = sh_title_words | last | escape
            assign sh_title_head_n = sh_title_words.size | minus: 1
            assign sh_title_html = ''
            for sh_w in sh_title_words limit: sh_title_head_n
              assign sh_w_esc = sh_w | escape
              if forloop.first
                assign sh_title_html = sh_w_esc
              else
                assign sh_title_html = sh_title_html | append: ' ' | append: sh_w_esc
              endif
            endfor
            assign sh_title_html = sh_title_html | append: ' ' | append: sh_title_last
          else
            assign sh_title_html = title | escape
          endif
        -%}
        {% case heading_level %}
          {% when 'h2' %}
            <h2 class="split-hero__title type-hero">{{ sh_title_html }}</h2>
          {% when 'h3' %}
            <h3 class="split-hero__title type-hero">{{ sh_title_html }}</h3>
          {% when 'h4' %}
            <h4 class="split-hero__title type-hero">{{ sh_title_html }}</h4>
          {% when 'h5' %}
            <h5 class="split-hero__title type-hero">{{ sh_title_html }}</h5>
          {% when 'h6' %}
            <h6 class="split-hero__title type-hero">{{ sh_title_html }}</h6>
          {% else %}
            <h1 class="split-hero__title type-hero">{{ sh_title_html }}</h1>
        {% endcase %}
      {%- endif -%}

      {%- if body != blank -%}
        <div class="split-hero__body rte">{{ body }}</div>
      {%- endif -%}

      {%- if cta_text != blank -%}
        <div class="split-hero__ctas">
          <a
            href="{{ cta_url | default: routes.all_products_collection_url }}"
            class="btn {{ cta_btn_class }} split-hero__cta"
          >
            {{ cta_text | escape }}
          </a>
        </div>
      {%- endif -%}

      {%- if tag_text != blank and tag_url != blank -%}
        <a class="split-hero__tag" href="{{ tag_url }}">{{ tag_text | escape }}</a>
      {%- elsif tag_text != blank -%}
        <span class="split-hero__tag">{{ tag_text | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}
  TE live preview: Shopify hot-patches this {% style %} block when sliders change.
  Values must read section.settings.* directly (not top-of-file assigns) — same pattern as fifty-fifty.liquid.
  !important beats split-hero.css and the section-frame inset inline style.
{%- endcomment -%}
{% style %}
  {%- liquid
    assign sh_te_pos = section.settings.image_position
    if sh_te_pos == blank
      assign sh_te_lpx = section.settings.image_pos_x | default: 50
      assign sh_te_lpy = section.settings.image_pos_y | default: 50
      if sh_te_lpx == 50 and sh_te_lpy == 50
        assign sh_te_pos = 'center'
      else
        assign sh_te_pos = 'custom'
      endif
    endif
    if sh_te_pos == 'custom'
      assign sh_te_ix = section.settings.focal_x | default: section.settings.image_pos_x | default: 50
      assign sh_te_iy = section.settings.focal_y | default: section.settings.image_pos_y | default: 50
    elsif sh_te_pos == 'top left'
      assign sh_te_ix = 0
      assign sh_te_iy = 0
    elsif sh_te_pos == 'top'
      assign sh_te_ix = 50
      assign sh_te_iy = 0
    elsif sh_te_pos == 'top right'
      assign sh_te_ix = 100
      assign sh_te_iy = 0
    elsif sh_te_pos == 'left'
      assign sh_te_ix = 0
      assign sh_te_iy = 50
    elsif sh_te_pos == 'right'
      assign sh_te_ix = 100
      assign sh_te_iy = 50
    elsif sh_te_pos == 'bottom left'
      assign sh_te_ix = 0
      assign sh_te_iy = 100
    elsif sh_te_pos == 'bottom'
      assign sh_te_ix = 50
      assign sh_te_iy = 100
    elsif sh_te_pos == 'bottom right'
      assign sh_te_ix = 100
      assign sh_te_iy = 100
    else
      assign sh_te_ix = 50
      assign sh_te_iy = 50
    endif
    assign sh_te_scale = section.settings.image_scale | default: section.settings.image_zoom | default: 100
    assign sh_te_pm = section.settings.image_position_mobile | default: 'same'
    if sh_te_pm == 'same' or sh_te_pm == blank
      assign sh_te_ixm = sh_te_ix
      assign sh_te_iym = sh_te_iy
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    elsif sh_te_pm == 'custom'
      assign sh_te_ixm = section.settings.focal_x_mobile | default: section.settings.image_pos_x_mobile | default: sh_te_ix
      assign sh_te_iym = section.settings.focal_y_mobile | default: section.settings.image_pos_y_mobile | default: sh_te_iy
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    elsif sh_te_pm == 'top left'
      assign sh_te_ixm = 0
      assign sh_te_iym = 0
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    elsif sh_te_pm == 'top'
      assign sh_te_ixm = 50
      assign sh_te_iym = 0
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    elsif sh_te_pm == 'top right'
      assign sh_te_ixm = 100
      assign sh_te_iym = 0
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    elsif sh_te_pm == 'left'
      assign sh_te_ixm = 0
      assign sh_te_iym = 50
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    elsif sh_te_pm == 'right'
      assign sh_te_ixm = 100
      assign sh_te_iym = 50
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    elsif sh_te_pm == 'bottom left'
      assign sh_te_ixm = 0
      assign sh_te_iym = 100
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    elsif sh_te_pm == 'bottom'
      assign sh_te_ixm = 50
      assign sh_te_iym = 100
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    elsif sh_te_pm == 'bottom right'
      assign sh_te_ixm = 100
      assign sh_te_iym = 100
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    else
      assign sh_te_ixm = 50
      assign sh_te_iym = 50
      assign sh_te_scale_m = section.settings.image_scale_mobile | default: section.settings.image_zoom_mobile | default: sh_te_scale
    endif
    assign sh_te_mh = section.settings.media_height | default: 0
    if sh_te_mh == blank or sh_te_mh == 0
      assign sh_te_mh = 100
    endif
    assign sh_te_pct = section.settings.media_column_pct | default: 50
  -%}
  #shopify-section-{{ section.id }} {
    padding-block: {{ section.settings.section_gap | default: 0 }}px !important;
    box-sizing: border-box;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-block-start: 0 !important;
      padding-block-end: {{ section.settings.section_gap_mobile | default: 0 }}px !important;
    }
  }
  #shopify-section-{{ section.id }},
  #split-hero-{{ section.id }} {
    --sh-media-pct: {{ sh_te_pct }}% !important;
    --sh-height-scale: {{ sh_te_mh | times: 0.01 }} !important;
    --sh-media-radius: {{ section.settings.media_radius | default: 0 }}px !important;
    --sh-img-x: {{ sh_te_ix }}% !important;
    --sh-img-y: {{ sh_te_iy }}% !important;
    --sh-img-zoom: {{ sh_te_scale | at_least: 100 | times: 0.01 }} !important;
    --sh-img-x-m: {{ sh_te_ixm }}% !important;
    --sh-img-y-m: {{ sh_te_iym }}% !important;
    --sh-img-zoom-m: {{ sh_te_scale_m | at_least: 100 | times: 0.01 }} !important;
    --sh-star-color: {{ section.settings.star_color | default: '#d4af37' }} !important;
    --sh-star-size: {{ section.settings.star_size | default: 14 }}px !important;
    --sh-trust-gap: {{ section.settings.trust_gap | default: 10 }}px !important;
    --sh-trust-below: {{ section.settings.trust_below | default: 16 }}px !important;
    --hero-copy-pad-y-mobile: {{ section.settings.text_pad_y_mobile | default: 52 }}px !important;
    --hero-copy-pad-x-mobile: {{ section.settings.text_pad_x_mobile | default: 24 }}px !important;
    {%- if section.settings.inset_custom_mobile -%}
    --section-inset-top-m: {{ section.settings.inset_top_mobile | default: 0 }}px !important;
    --section-inset-bottom-m: {{ section.settings.inset_bottom_mobile | default: 0 }}px !important;
    --section-inset-left-m: {{ section.settings.inset_x_mobile | default: 0 }}px !important;
    --section-inset-right-m: {{ section.settings.inset_x_mobile | default: 0 }}px !important;
    {%- else -%}
    --section-inset-top-m: {{ section.settings.inset_top | default: 0 }}px !important;
    --section-inset-bottom-m: {{ section.settings.inset_bottom | default: 0 }}px !important;
    --section-inset-left-m: {{ section.settings.inset_x | default: 0 }}px !important;
    --section-inset-right-m: {{ section.settings.inset_x | default: 0 }}px !important;
    {%- endif -%}
    --section-inset-top: {{ section.settings.inset_top | default: 0 }}px !important;
    --section-inset-bottom: {{ section.settings.inset_bottom | default: 0 }}px !important;
    --section-inset-left: {{ section.settings.inset_x | default: 0 }}px !important;
    --section-inset-right: {{ section.settings.inset_x | default: 0 }}px !important;
    {%- if section.settings.trust_text_size != blank and section.settings.trust_text_size != 'default' -%}
    --sh-trust-size: {{ section.settings.trust_text_size }}px !important;
    {%- endif -%}
    {%- if section.settings.title_size != blank and section.settings.title_size != 'default' -%}
    --sh-title-size: {{ section.settings.title_size }}px !important;
    {%- endif -%}
    {%- if section.settings.title_weight != blank and section.settings.title_weight != 'default' -%}
    --sh-title-weight: {{ section.settings.title_weight }} !important;
    {%- endif -%}
    {%- if section.settings.body_size != blank and section.settings.body_size != 'default' -%}
    --sh-body-size: {{ section.settings.body_size }}px !important;
    {%- endif -%}
    {%- if section.settings.body_weight != blank and section.settings.body_weight != 'default' -%}
    --sh-body-weight: {{ section.settings.body_weight }} !important;
    {%- endif -%}
    {%- if section.settings.cta_size != blank and section.settings.cta_size != 'default' -%}
    --sh-cta-size: {{ section.settings.cta_size }}px !important;
    {%- endif -%}
    {%- if section.settings.bg_style == 'white' -%}
    --sh-copy-bg: #ffffff !important;
    {%- elsif section.settings.bg_style == 'cream' -%}
    --sh-copy-bg: #faf8f6 !important;
    {%- elsif section.settings.bg_style == 'darker_cream' -%}
    --sh-copy-bg: #efe9dd !important;
    {%- else -%}
    --sh-copy-bg: {{ section.settings.bg_color | default: '#ffffff' }} !important;
    {%- endif -%}
  }
  #split-hero-{{ section.id }} .split-hero__media {
    background: {{ section.settings.media_bg | default: '#ffffff' }} !important;
  }
  #split-hero-{{ section.id }} .split-hero__copy {
    background: var(--sh-copy-bg, #ffffff) !important;
    padding: {{ section.settings.text_pad_y | default: 72 }}px {{ section.settings.side_padding | default: 56 }}px !important;
  }
  @media (min-width: 769px) {
    #split-hero-{{ section.id }} .split-hero__copy {
      min-height: calc(92vh * var(--sh-height-scale, 1)) !important;
    }
    #split-hero-{{ section.id }} .split-hero__stack {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      margin-block: auto;
    }
  }
  #split-hero-{{ section.id }} .split-hero__stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }
  #split-hero-{{ section.id }} .split-hero__stack > :first-child {
    margin-top: 0 !important;
  }
  #split-hero-{{ section.id }} .split-hero__stack > :last-child {
    margin-bottom: 0 !important;
  }
  #split-hero-{{ section.id }} .split-hero__cta.btn {
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
    font-size: var(--sh-cta-size, var(--type-cta-size));
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    line-height: var(--type-cta-leading, 1);
    text-transform: uppercase;
    border-radius: var(--radius-button);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }
  #split-hero-{{ section.id }} .split-hero__cta.btn:hover {
    opacity: 0.92;
    text-decoration: none;
  }
  #split-hero-{{ section.id }} .split-hero__cta.btn--brand-outline:hover,
  #split-hero-{{ section.id }} .split-hero__cta.btn--secondary:hover {
    opacity: 0.85;
  }
  #split-hero-{{ section.id }}.split-hero--contain .split-hero__media .split-hero__img,
  #split-hero-{{ section.id }}.split-hero--contain .split-hero__media .split-hero__video,
  #split-hero-{{ section.id }}.split-hero--contain .split-hero__media video,
  #split-hero-{{ section.id }}.split-hero--fit .split-hero__media .split-hero__img,
  #split-hero-{{ section.id }}.split-hero--fit .split-hero__media .split-hero__video,
  #split-hero-{{ section.id }}.split-hero--fit .split-hero__media video {
    object-fit: contain !important;
  }
  #split-hero-{{ section.id }}.split-hero--media-square .split-hero__media {
    aspect-ratio: 1 / 1;
    height: auto !important;
    max-height: none !important;
  }
  @media (max-width: 768px) {
    #split-hero-{{ section.id }}.split-hero--contain-m .split-hero__media .split-hero__img,
    #split-hero-{{ section.id }}.split-hero--contain-m .split-hero__media .split-hero__video,
    #split-hero-{{ section.id }}.split-hero--contain-m .split-hero__media video,
    #split-hero-{{ section.id }}.split-hero--fit-m .split-hero__media .split-hero__img,
    #split-hero-{{ section.id }}.split-hero--fit-m .split-hero__media .split-hero__video,
    #split-hero-{{ section.id }}.split-hero--fit-m .split-hero__media video {
      object-fit: contain !important;
    }
    #split-hero-{{ section.id }}.split-hero--media-square-m .split-hero__media {
      aspect-ratio: 1 / 1;
      max-height: none !important;
      height: auto !important;
    }
    {%- if section.settings.mobile_media_height > 0 %}
    #split-hero-{{ section.id }} .split-hero__media {
      height: {{ section.settings.mobile_media_height }}px !important;
      min-height: {{ section.settings.mobile_media_height }}px !important;
      max-height: {{ section.settings.mobile_media_height }}px !important;
      aspect-ratio: auto !important;
    }
    {%- endif %}
    #split-hero-{{ section.id }} .split-hero__media {
      width: {{ section.settings.mobile_media_width | default: 100 }}% !important;
      margin-left: auto;
      margin-right: auto;
    }
  }
{% endstyle %}

{% render 'bg-video-autoplay-script',
  section_id: section.id,
  root_class: 'split-hero',
  video_selector: 'video.split-hero__video, .split-hero__media video'
%}

