{% comment %}
  Split hero — 50/50 media | copy
  Authority: Home WORKING · type via design-tokens.css (no local font overrides)
  CSS: assets/split-hero.css
{% endcomment %}

{{ 'split-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign media_type = section.settings.media_type | default: 'image'
  assign image = section.settings.image
  assign image_url = section.settings.image_url
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign image_alt = section.settings.image_alt
  assign title = section.settings.title
  assign body = section.settings.body
  assign cta_text = section.settings.cta_text
  assign cta_url = section.settings.cta_url
  assign tag_text = section.settings.tag_text
  assign tag_url = section.settings.tag_url
  assign trust_text = section.settings.trust_text
  assign trust_url = section.settings.trust_url
  assign heading_level = section.settings.heading_level | default: 'h1'
  if heading_level != 'h1' and heading_level != 'h2' and heading_level != 'h3'
    assign heading_level = 'h1'
  endif
  if image_alt == blank and image != blank
    assign image_alt = image.alt | default: title
  endif
  if image_url == blank
    assign image_url = 'https://barreletics.com/cdn/shop/products/barreletixxstefrunningpinkbackground.jpg?v=1710549452&width=2400'
  endif
  assign reverse_layout = section.settings.reverse_layout
  assign title_size = section.settings.title_size | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign star_color = section.settings.star_color | default: '#d4af37'
  assign star_size = section.settings.star_size | default: 14
  assign trust_text_size = section.settings.trust_text_size | default: 'default'
  assign trust_gap = section.settings.trust_gap | default: 10
  assign media_column_pct = section.settings.media_column_pct | default: 62
  assign media_radius = section.settings.media_radius | default: 0
-%}

<div
  class="split-hero{% if reverse_layout %} split-hero--reverse{% endif %}"
  id="split-hero-{{ section.id }}"
  role="region"
  aria-label="{{ section.settings.aria_label | default: 'Hero' | escape }}"
  style="
    --sh-media-pct: {{ media_column_pct }}%;
    --sh-media-radius: {{ media_radius }}px;
    --sh-star-color: {{ star_color }};
    --sh-star-size: {{ star_size }}px;
    --sh-trust-gap: {{ trust_gap }}px;
    {% if trust_text_size != 'default' %}--sh-trust-size: {{ trust_text_size }}px;{% endif %}
    {% if title_size != 'default' %}--sh-title-size: {{ title_size }}px;{% endif %}
    {% if body_size != 'default' %}--sh-body-size: {{ body_size }}px;{% endif %}
    {% if title_weight != 'default' %}--sh-title-weight: {{ title_weight }};{% endif %}
  "
>
  <div class="split-hero__media" data-media-type="{{ media_type }}">
    {%- if media_type == 'video' -%}
      {%- if video != blank -%}
        {{
          video
          | video_tag:
            image_size: '1600x',
            autoplay: true,
            loop: true,
            muted: true,
            controls: section.settings.video_controls,
            playsinline: true,
            class: 'split-hero__video'
        }}
      {%- elsif video_url != blank -%}
        <video
          class="split-hero__video"
          src="{{ video_url }}"
          {% if image != blank %}poster="{{ image | image_url: width: 1600 }}"{% endif %}
          autoplay
          muted
          loop
          playsinline
          {% if section.settings.video_controls %}controls{% endif %}
        ></video>
      {%- elsif image != blank -%}
        {{
          image
          | image_url: width: 1600
          | image_tag:
            widths: '600, 900, 1200, 1600',
            sizes: '(max-width: 768px) 100vw, 50vw',
            alt: image_alt,
            loading: 'eager',
            fetchpriority: 'high',
            decoding: 'async',
            class: 'split-hero__img'
        }}
      {%- else -%}
        <div class="split-hero__placeholder" role="img" aria-label="Add video or poster image">
          Add video (or poster image) in Theme Editor
        </div>
      {%- endif -%}
    {%- else -%}
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 2400
          | image_tag:
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '(max-width: 768px) 100vw, 62vw',
            alt: image_alt,
            loading: 'eager',
            fetchpriority: 'high',
            decoding: 'async',
            class: 'split-hero__img'
        }}
      {%- elsif image_url != blank -%}
        {%- comment -%} Live pink-shorts hero (stefrunning) via URL — large media-dominant treatment {%- endcomment -%}
        <img
          class="split-hero__img"
          src="{{ image_url | escape }}"
          srcset="https://barreletics.com/cdn/shop/products/barreletixxstefrunningpinkbackground.jpg?v=1710549452&width=800 800w,
                  https://barreletics.com/cdn/shop/products/barreletixxstefrunningpinkbackground.jpg?v=1710549452&width=1200 1200w,
                  https://barreletics.com/cdn/shop/products/barreletixxstefrunningpinkbackground.jpg?v=1710549452&width=1600 1600w,
                  https://barreletics.com/cdn/shop/products/barreletixxstefrunningpinkbackground.jpg?v=1710549452&width=2000 2000w,
                  https://barreletics.com/cdn/shop/products/barreletixxstefrunningpinkbackground.jpg?v=1710549452&width=2400 2400w"
          sizes="(max-width: 768px) 100vw, 62vw"
          alt="{{ image_alt | default: 'Barreletics Performance Skins — grip that holds in every studio workout' | escape }}"
          width="2400"
          height="2750"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {%- else -%}
        <div class="split-hero__placeholder" role="img" aria-label="Add hero image in Theme Editor">
          Add pink-shorts hero image in Theme Editor
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="split-hero__copy">
    {%- if section.settings.show_trust -%}
      {%- assign trust_plain = trust_text | strip_html | strip -%}
      {%- if section.settings.show_stars or trust_plain != blank -%}
        <div class="split-hero__trust">
          {%- if section.settings.show_stars -%}
            <span class="split-hero__stars" aria-hidden="true">★★★★★</span>
            <span class="visually-hidden">5 out of 5 stars</span>
          {%- endif -%}
          {%- if trust_plain != blank -%}
            {%- if trust_url != blank -%}
              <a class="split-hero__trust-link" href="{{ trust_url }}">{{ trust_plain | escape }}</a>
            {%- else -%}
              <div class="split-hero__trust-text rte">{{ trust_text }}</div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if title != blank -%}
      <{{ heading_level }} class="split-hero__title type-hero">{{ title | escape }}</{{ heading_level }}>
    {%- endif -%}

    {%- if body != blank -%}
      <div class="split-hero__body rte">{{ body }}</div>
    {%- endif -%}

    {%- if cta_text != blank -%}
      <div class="split-hero__ctas">
        <a
          href="{{ cta_url | default: routes.all_products_collection_url }}"
          class="split-hero__cta"
        >
          {{ cta_text | escape }}
        </a>
      </div>
    {%- endif -%}

    {%- if tag_text != blank and tag_url != blank -%}
      <a class="split-hero__tag" href="{{ tag_url }}">{{ tag_text | escape }}</a>
    {%- elsif tag_text != blank -%}
      <span class="split-hero__tag">{{ tag_text | escape }}</span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Split hero",
  "tag": "section",
  "class": "section-split-hero",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Pilates Sock Era is Over"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "28", "label": "28px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "48", "label": "48px" },
        { "value": "56", "label": "56px" },
        { "value": "64", "label": "64px" },
        { "value": "72", "label": "72px" }
      ],
      "default": "default",
      "info": "Default keeps Type OS hero size. Overrides size only — not font family."
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Outperforms barre socks, Pilates socks, and yoga socks — combined.</p>"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "24", "label": "24px" },
        { "value": "28", "label": "28px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link",
      "info": "Collection/product/page URL for navigation. Use #anchors (e.g. #variants, #knock-socks) only to jump to a same-page section Anchor ID. Blank → all-products collection."
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Tag text",
      "default": "#letusknockyoursocksoff"
    },
    {
      "type": "url",
      "id": "tag_url",
      "label": "Tag link",
      "info": "Usually an #anchor to statement-band (e.g. #knock-socks)."
    },

    { "type": "header", "content": "Shared — Media" },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video",
      "info": "Preferred when the file lives in Shopify Files. Use this OR Video URL — not both. Shopify video wins if both are set."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (mp4)",
      "info": "External/CDN mp4 when not using Shopify Video. Ignored if Shopify video is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image / poster (Shopify)",
      "info": "Still image for image mode, OR poster when using Video URL. Prefer this over URL fields when the asset is in Shopify."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL fallback",
      "default": "https://barreletics.com/cdn/shop/products/barreletixxstefrunningpinkbackground.jpg?v=1710549452&width=2400",
      "info": "Still image when no Shopify image is set and media type is Image. Not a video poster."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Barreletics Performance Skins — grip that holds in every studio workout"
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "Show video controls",
      "default": false
    },

    { "type": "header", "content": "Shared — Layout" },
    {
      "type": "range",
      "id": "media_column_pct",
      "label": "Media column %",
      "min": 35,
      "max": 65,
      "step": 1,
      "unit": "%",
      "default": 62,
      "info": "Desktop only. Text = 100 − media %. Default 62 matches Home WORKING media-dominant hero."
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Media corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse layout (copy left / media right)",
      "default": false,
      "info": "Desktop only. Mobile stays media first."
    },

    { "type": "header", "content": "Section — Split hero — trust" },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust row",
      "default": true,
      "info": "Stars + “Trusted by…” above the headline (Home WORKING order)."
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#d4af37"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "trust_text_size",
      "label": "Trust text size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "18", "label": "18px" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "trust_gap",
      "label": "Trust row gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10,
      "info": "Space between stars and trust text."
    },
    {
      "type": "richtext",
      "id": "trust_text",
      "label": "Trust text",
      "default": "<p>Trusted by 1,000's of instructors & studios</p>"
    },
    {
      "type": "url",
      "id": "trust_url",
      "label": "Trust link",
      "info": "Optional. Wraps the trust text (e.g. #reviews)."
    },

    { "type": "header", "content": "Section — Split hero — accessibility" },
    {
      "type": "paragraph",
      "content": "Typography defaults to Type OS. Size/weight selects above are optional overrides — no font family pickers."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria-label",
      "default": "Hero"
    }
  ],
  "presets": [
    {
      "name": "Split hero"
    }
  ]
}
{% endschema %}
