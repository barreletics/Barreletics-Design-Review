{% comment %}
  Split hero — 50/50 media | copy
  Authority: docs/Barreletics Home - Definitive-WORKING.html
  Type: BZ-020 (title clamp 40–64 / 400 · rust CTA 700)
  CSS: assets/split-hero.css (loaded here — not global)
{% endcomment %}

{{ 'split-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign trust_text = section.settings.trust_text
  assign trust_url = section.settings.trust_url
  assign title = section.settings.title
  assign body = section.settings.body
  assign cta_text = section.settings.cta_text
  assign cta_url = section.settings.cta_url
  assign tag_text = section.settings.tag_text
  assign tag_url = section.settings.tag_url
  assign image = section.settings.image
  assign image_alt = section.settings.image_alt
  assign heading_level = section.settings.heading_level | default: 'h1'
  if heading_level != 'h1' and heading_level != 'h2' and heading_level != 'h3'
    assign heading_level = 'h1'
  endif
  if image_alt == blank and image != blank
    assign image_alt = image.alt | default: title
  endif
  assign reverse_layout = section.settings.reverse_layout
-%}

<div
  class="split-hero{% if reverse_layout %} split-hero--reverse{% endif %}"
  id="split-hero-{{ section.id }}"
  role="region"
  aria-label="{{ section.settings.aria_label | default: 'Hero' | escape }}"
>
  <div class="split-hero__image">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 1600
        | image_tag:
          widths: '600, 900, 1200, 1600',
          sizes: '(max-width: 768px) 100vw, 50vw',
          alt: image_alt,
          loading: 'eager',
          fetchpriority: 'high',
          decoding: 'async'
      }}
    {%- else -%}
      <div class="split-hero__image-placeholder" role="img" aria-label="{{ image_alt | default: 'Hero lifestyle image' | escape }}">
        {{ image_alt | default: 'Add hero image in Theme Editor' }}
      </div>
    {%- endif -%}
  </div>

  <div class="split-hero__copy">
    {%- if section.settings.show_trust and trust_text != blank -%}
      <p class="split-hero__trust">
        {%- if section.settings.show_stars -%}
          <span class="split-hero__stars" aria-hidden="true">★★★★★</span>
        {%- endif -%}
        {%- if trust_url != blank -%}
          <a href="{{ trust_url }}">{{ trust_text | escape }}</a>
        {%- else -%}
          <span>{{ trust_text | escape }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if title != blank -%}
      <{{ heading_level }} class="split-hero__title">{{ title | escape }}</{{ heading_level }}>
    {%- endif -%}

    {%- if body != blank -%}
      <p class="split-hero__body">{{ body | escape }}</p>
    {%- endif -%}

    {%- if cta_text != blank -%}
      <div class="split-hero__ctas">
        <a
          href="{{ cta_url | default: routes.all_products_collection_url }}"
          class="split-hero__cta"
        >
          {{ cta_text | escape }}
        </a>
      </div>
    {%- endif -%}

    {%- if tag_text != blank and tag_url != blank -%}
      <a class="split-hero__tag" href="{{ tag_url }}">{{ tag_text | escape }}</a>
    {%- elsif tag_text != blank -%}
      <span class="split-hero__tag">{{ tag_text | escape }}</span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Split hero",
  "tag": "section",
  "class": "section-split-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Barreletics Performance Skins — grip that holds in every studio workout"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse layout (copy left / image right)",
      "default": false,
      "info": "Desktop only. Mobile stays image first."
    },
    {
      "type": "header",
      "content": "Trust"
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust line",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust line",
      "default": "Trusted by 1,000's of instructors & studios"
    },
    {
      "type": "url",
      "id": "trust_url",
      "label": "Trust line link",
      "info": "Optional. Home WORKING links to #reviews."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Headline",
      "default": "The Pilates Sock Era is Over"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h1",
      "info": "Use H1 once per page. Choose H2/H3 when reusing off the primary entry."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Outperforms barre socks, Pilates socks, and yoga socks — combined."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Primary CTA",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary CTA link",
      "info": "Defaults to all products if blank."
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Tag link text",
      "default": "#letusknockyoursocksoff"
    },
    {
      "type": "url",
      "id": "tag_url",
      "label": "Tag link",
      "info": "Optional. If blank, tag text renders without a link (no hardcoded URL)."
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria-label",
      "default": "Hero"
    }
  ],
  "presets": [
    {
      "name": "Split hero"
    }
  ]
}
{% endschema %}
