{% comment %}
  Disciplines — cream typographic band (Home WORKING).
{% endcomment %}

<section class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} discipline-film" aria-label="{{ section.settings.aria_label | default: 'Built for every studio discipline' | escape }}" style="{% render 'section-inset-vars' %}">
  <div class="discipline-film__inner">
    {% if section.settings.headline != blank %}
      <p class="discipline-film__line h2-display">{{ section.settings.headline | newline_to_br }}</p>
    {% endif %}
    <div class="discipline-film__moves">
      {% for block in section.blocks %}
        {% unless forloop.first %}
          <span aria-hidden="true"><em>·</em></span>
        {% endunless %}
        <span {{ block.shopify_attributes }}>{{ block.settings.discipline }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .discipline-film {
    position: relative;
    overflow: hidden;
    background: #f5f2ec;
    border-top: 1px solid #e8e2d8;
    border-bottom: 1px solid #e8e2d8;
  }
  .discipline-film__inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--section-padding-y, 64px) var(--section-padding-x, 40px);
    text-align: center;
  }
  /* Type OS — .h2-display tokens (no local clamp/weight fight) */
  .discipline-film__line.h2-display {
    color: var(--text-primary);
    max-width: none;
    margin: 0 0 var(--gap-c);
  }
  .discipline-film__moves {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 8px;
    align-items: center;
    justify-content: center;
    border-top: 1px solid #d6cfc0;
    padding-top: 24px;
  }
  .discipline-film__moves span {
    font-size: clamp(12px, 1.3vw, 14px);
    font-weight: 500;
    color: #4a4a4a;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .discipline-film__moves span em {
    font-style: normal;
    color: #c45c3f;
    margin: 0 14px;
    font-weight: 400;
  }
  @media (max-width: 768px) {
    .discipline-film__inner {
      padding: var(--section-padding-y-mobile, 48px) var(--section-padding-x-mobile, 16px);
    }
  }
</style>

{% schema %}
{
  "name": "Disciplines",
  "settings": [
    {
      "type": "header",
      "content": "Shared — Content"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Heading",
      "default": "Upgrade your grip.\nUpgrade your workout.",
      "info": "H2 Display (brand). Use a line break for two lines. Type OS owns size/weight."
    },
    {
      "type": "header",
      "content": "Section — Disciplines"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria label",
      "default": "Built for every studio discipline"
    },
    {
      "type": "header",
      "content": "Shared — Section frame"
    },
    {
      "type": "paragraph",
      "content": "OUTER inset from the page edges (margin). Top and bottom are independent; left & right = one control. Custom mobile OFF = mobile uses the same inset as desktop. Defaults 0 = full bleed."
    },
    {
      "type": "checkbox",
      "id": "inset_custom_mobile",
      "label": "Custom mobile inset",
      "default": false,
      "info": "OFF (default): ignore the mobile inset sliders — mobile uses desktop Inset top / bottom / left & right. ON: use the mobile inset sliders instead."
    },
    {
      "type": "range",
      "id": "inset_top",
      "label": "Inset top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_bottom",
      "label": "Inset bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x",
      "label": "Inset left & right",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Same value on both sides."
    },
    {
      "type": "range",
      "id": "inset_top_mobile",
      "label": "Inset top — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "range",
      "id": "inset_bottom_mobile",
      "label": "Inset bottom — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x_mobile",
      "label": "Inset left & right — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "discipline",
      "name": "Discipline",
      "settings": [
        {
          "type": "text",
          "id": "discipline",
          "label": "Discipline name",
          "default": "Barre"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Disciplines",
      "blocks": [
        {
          "type": "discipline",
          "settings": {
            "discipline": "Barre"
          }
        },
        {
          "type": "discipline",
          "settings": {
            "discipline": "Reformer"
          }
        },
        {
          "type": "discipline",
          "settings": {
            "discipline": "Megaformer"
          }
        },
        {
          "type": "discipline",
          "settings": {
            "discipline": "Lagree"
          }
        },
        {
          "type": "discipline",
          "settings": {
            "discipline": "Pilates"
          }
        },
        {
          "type": "discipline",
          "settings": {
            "discipline": "Yoga"
          }
        }
      ]
    }
  ]
}
{% endschema %}
