{% comment %}
  Disciplines — cream typographic band (Home WORKING).
{% endcomment %}

<section class="discipline-film" aria-label="{{ section.settings.aria_label | default: 'Built for every studio discipline' | escape }}">
  <div class="discipline-film__inner">
    {% if section.settings.headline != blank %}
      <p class="discipline-film__line h2-display">{{ section.settings.headline | newline_to_br }}</p>
    {% endif %}
    <div class="discipline-film__moves">
      {% for block in section.blocks %}
        {% unless forloop.first %}
          <span aria-hidden="true"><em>·</em></span>
        {% endunless %}
        <span {{ block.shopify_attributes }}>{{ block.settings.discipline }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .discipline-film {
    position: relative;
    overflow: hidden;
    background: #f5f2ec;
    border-top: 1px solid #e8e2d8;
    border-bottom: 1px solid #e8e2d8;
  }
  .discipline-film__inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 88px 40px 80px;
    text-align: center;
  }
  /* H2 Display — brand grip slogan (not label / not hero).
     Font-size set locally so theme.css / label rules cannot shrink it. */
  .discipline-film__line.h2-display {
    font-size: var(--type-h2-display-size, clamp(38px, 4.6vw, 52px)) !important;
    font-weight: var(--type-h2-display-weight, 500);
    line-height: var(--type-h2-display-leading, 1.10);
    letter-spacing: var(--type-h2-display-tracking, -0.028em);
    color: #1c1916;
    text-transform: none;
    max-width: none;
    margin: 0 0 var(--gap-c, 32px);
  }
  @media (max-width: 768px) {
    .discipline-film__line.h2-display {
      font-size: var(--type-h2-display-size-mobile, clamp(32px, 7vw, 40px)) !important;
    }
  }
  .discipline-film__moves {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 8px;
    align-items: center;
    justify-content: center;
    border-top: 1px solid #d6cfc0;
    padding-top: 24px;
  }
  .discipline-film__moves span {
    font-size: clamp(12px, 1.3vw, 14px);
    font-weight: 500;
    color: #4a4a4a;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .discipline-film__moves span em {
    font-style: normal;
    color: #c45c3f;
    margin: 0 14px;
    font-weight: 400;
  }
  @media (max-width: 768px) {
    .discipline-film__inner { padding: 56px 16px 48px; }
  }
</style>

{% schema %}
{
  "name": "Disciplines",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Aria label", "default": "Built for every studio discipline" },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Upgrade your grip.\nUpgrade your workout.",
      "info": "H2 Display (brand). Use a line break for two lines."
    }
  ],
  "blocks": [
    {
      "type": "discipline",
      "name": "Discipline",
      "settings": [
        { "type": "text", "id": "discipline", "label": "Discipline name", "default": "Barre" }
      ]
    }
  ],
  "presets": [{
    "name": "Disciplines",
    "blocks": [
      { "type": "discipline", "settings": { "discipline": "Barre" } },
      { "type": "discipline", "settings": { "discipline": "Reformer" } },
      { "type": "discipline", "settings": { "discipline": "Megaformer" } },
      { "type": "discipline", "settings": { "discipline": "Lagree" } },
      { "type": "discipline", "settings": { "discipline": "Pilates" } },
      { "type": "discipline", "settings": { "discipline": "Yoga" } }
    ]
  }]
}
{% endschema %}
