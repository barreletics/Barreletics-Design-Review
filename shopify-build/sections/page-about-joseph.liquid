{% comment %}
  About page — Joseph Pilates archival gallery + essay (v25 Locked · cream mat)
{% endcomment %}

<article
  class="page-about-joseph{% render 'split-mobile-stack-class', mobile_stack_order: section.settings.mobile_stack_order %}"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="page-about-joseph__gallery" aria-label="{{ section.settings.gallery_aria | escape }}">
    {% if section.settings.image_1 != blank %}
      {{
        section.settings.image_1
        | image_url: width: 1600
        | image_tag:
          widths: '600, 900, 1200, 1600',
          sizes: '(max-width: 768px) 100vw, 50vw',
          alt: section.settings.image_1_alt,
          loading: 'lazy',
          class: 'page-about-joseph__img'
      }}
    {% elsif section.settings.image_1_url != blank %}
      <img class="page-about-joseph__img" src="{{ section.settings.image_1_url | escape }}" alt="{{ section.settings.image_1_alt | escape }}" loading="lazy">
    {% endif %}
    {% if section.settings.image_2 != blank %}
      {{
        section.settings.image_2
        | image_url: width: 1400
        | image_tag:
          widths: '600, 900, 1200, 1400',
          sizes: '(max-width: 768px) 100vw, 50vw',
          alt: section.settings.image_2_alt,
          loading: 'lazy',
          class: 'page-about-joseph__img'
      }}
    {% elsif section.settings.image_2_url != blank %}
      <img class="page-about-joseph__img" src="{{ section.settings.image_2_url | escape }}" alt="{{ section.settings.image_2_alt | escape }}" loading="lazy">
    {% endif %}
  </div>
  <div class="page-about-joseph__copy">
    <div class="page-about-joseph__inner">
      {% if section.settings.title != blank %}
        <h2 class="page-about-joseph__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="page-about-joseph__body rte">{{ section.settings.body }}</div>
      {% endif %}
    </div>
  </div>
</article>

<style>
  #shopify-section-{{ section.id }} .page-about-joseph {
    display: block;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .page-about-joseph__gallery {
    background: var(--color-warm-cream, #f5f2ec);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(20px, 3vw, 32px);
    align-items: center;
    padding: clamp(48px, 8vh, 80px) clamp(20px, 6vw, 6vw);
    border-top: 1px solid var(--line-soft, #e8e2d8);
    border-bottom: 1px solid var(--line-soft, #e8e2d8);
  }
  #shopify-section-{{ section.id }} .page-about-joseph__img {
    width: 100%;
    height: auto;
    max-height: min(68vh, 620px);
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--line-soft, #e8e2d8);
    border-radius: 4px;
    padding: clamp(12px, 2vw, 20px);
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .page-about-joseph__copy {
    padding: clamp(40px, 7vh, 72px) clamp(20px, 8vw, 8vw);
  }
  #shopify-section-{{ section.id }} .page-about-joseph__inner { max-width: 32em; }
  #shopify-section-{{ section.id }} .page-about-joseph__title {
    font-size: clamp(36px, 4.8vw, 56px);
    font-weight: 400;
    letter-spacing: -0.032em;
    line-height: 1.06;
    margin: 0 0 24px;
    color: var(--text-primary, #1c1916);
  }
  #shopify-section-{{ section.id }} .page-about-joseph__body {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-body, #4a4a4a);
  }
  #shopify-section-{{ section.id }} .page-about-joseph__body p + p { margin-top: 1em; }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-joseph {
      display: flex;
      flex-direction: column;
    }
    #shopify-section-{{ section.id }} .page-about-joseph__gallery {
      grid-template-columns: 1fr;
      padding: 28px 20px;
    }
    #shopify-section-{{ section.id }} .page-about-joseph__img {
      max-height: min(44vh, 340px);
    }
    #shopify-section-{{ section.id }} .page-about-joseph__copy {
      padding: 28px 20px 36px;
    }
  }
</style>

{% schema %}
{
  "name": "About — Joseph",
  "settings": [
    { "type": "text", "id": "gallery_aria", "label": "Gallery ARIA label", "default": "Joseph Pilates archival photographs" },
    { "type": "image_picker", "id": "image_1", "label": "Archival image 1" },
    {
      "type": "text",
      "id": "image_1_url",
      "label": "Image 1 URL fallback",
      "default": "https://barreletics.com/cdn/shop/files/Screenshot_2026-06-06_at_6.59.10_PM.png?v=1780787015&width=1600"
    },
    { "type": "text", "id": "image_1_alt", "label": "Image 1 alt", "default": "Archival photograph of Joseph Pilates on the Reformer" },
    { "type": "image_picker", "id": "image_2", "label": "Archival image 2" },
    {
      "type": "text",
      "id": "image_2_url",
      "label": "Image 2 URL fallback",
      "default": "https://barreletics.com/cdn/shop/files/Screenshot_2026-06-06_at_9.58.53_PM.png?v=1780797556&width=1400"
    },
    { "type": "text", "id": "image_2_alt", "label": "Image 2 alt", "default": "Archival photograph of Joseph Pilates teaching on the Reformer" },
    { "type": "text", "id": "title", "label": "Essay heading", "default": "Joseph Pilates built the method around the feet." },
    { "type": "richtext", "id": "body", "label": "Essay body" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "mobile_stack_order",
      "label": "Mobile stack order",
      "default": "media_first",
      "options": [
        { "value": "media_first", "label": "Gallery above essay" },
        { "value": "copy_first", "label": "Essay above gallery" }
      ],
      "info": "Below 768px only."
    }
  ],
  "presets": [{ "name": "About — Joseph" }]
}
{% endschema %}
