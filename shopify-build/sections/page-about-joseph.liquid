    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Legacy: Body size",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "14",
          "label": "14px"
        },
        {
          "value": "15",
          "label": "15px"
        },
        {
          "value": "16",
          "label": "16px"
        },
        {
          "value": "17",
          "label": "17px"
        },
        {
          "value": "18",
          "label": "18px"
        },
        {
          "value": "20",
