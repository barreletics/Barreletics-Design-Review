{% comment %}
  About page — Joseph Pilates archival gallery + essay (v25 Locked · cream mat)
{% endcomment %}

{%- liquid
  assign paj_y_d_def = 56
  assign paj_side_d_def = 48
  assign paj_y_m_def = 28
  assign paj_x_m_def = 20
  assign paj_fixed_d_y = false
  if section.settings.text_pad_y != paj_y_d_def
    assign paj_fixed_d_y = true
  endif
  assign paj_fixed_d_x = false
  if section.settings.side_padding != paj_side_d_def
    assign paj_fixed_d_x = true
  endif
  assign paj_fixed_m_y = false
  if section.settings.text_pad_y_mobile != paj_y_m_def
    assign paj_fixed_m_y = true
  endif
  assign paj_fixed_m_x = false
  if section.settings.text_pad_x_mobile != paj_x_m_def
    assign paj_fixed_m_x = true
  endif
-%}
<article
  class="page-about-joseph{% if paj_fixed_d_y %} page-about-joseph--fixed-pad-d-y{% endif %}{% if paj_fixed_d_x %} page-about-joseph--fixed-pad-d-x{% endif %}{% if paj_fixed_m_y %} page-about-joseph--fixed-pad-m-y{% endif %}{% if paj_fixed_m_x %} page-about-joseph--fixed-pad-m-x{% endif %}{% render 'split-mobile-stack-class', mobile_stack_order: section.settings.mobile_stack_order %}"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
  style="{% render 'unified-text-pads-vars', y_d: 56, side_d: 48, y_m: 28, x_m: 20 %}{% render 'type-override-vars', title_weight: section.settings.title_weight, body_size: section.settings.body_size, body_weight: section.settings.body_weight %}"
>
  <div class="page-about-joseph__gallery" aria-label="{{ section.settings.gallery_aria | escape }}">
    {% if section.settings.image_1 != blank or section.settings.image_1_url != blank %}
      {%- comment -%} Image 1 defaults to CDN Screenshot_2026-06-06_at_6.59.10_PM.png (554×600) when URL-only. {%- endcomment -%}
      {%- assign frame_1_aspect = '554 / 600' -%}
      {%- if section.settings.image_1 != blank -%}
        {%- assign frame_1_aspect = section.settings.image_1.width | append: ' / ' | append: section.settings.image_1.height -%}
      {%- endif -%}
      <div class="page-about-joseph__frame" style="aspect-ratio: {{ frame_1_aspect }};">
        {% render 'media-img',
          image: section.settings.image_1,
          url: section.settings.image_1_url,
          alt: section.settings.image_1_alt,
          fit: 'contain',
          position: 'css',
          class: 'page-about-joseph__img',
          sizes: '(max-width: 768px) 100vw, 50vw',
          widths: '600, 900, 1200, 1600',
          width_default: 1600,
          loading: 'lazy'
        %}
      </div>
    {% endif %}
    {% if section.settings.image_2 != blank or section.settings.image_2_url != blank %}
      {%- comment -%} Image 2 defaults to CDN Screenshot_2026-06-06_at_9.58.53_PM.png (748×960) when URL-only. {%- endcomment -%}
      {%- assign frame_2_aspect = '748 / 960' -%}
      {%- if section.settings.image_2 != blank -%}
        {%- assign frame_2_aspect = section.settings.image_2.width | append: ' / ' | append: section.settings.image_2.height -%}
      {%- endif -%}
      <div class="page-about-joseph__frame" style="aspect-ratio: {{ frame_2_aspect }};">
        {% render 'media-img',
          image: section.settings.image_2,
          url: section.settings.image_2_url,
          alt: section.settings.image_2_alt,
          fit: 'contain',
          position: 'css',
          class: 'page-about-joseph__img',
          sizes: '(max-width: 768px) 100vw, 50vw',
          widths: '600, 900, 1200, 1400',
          width_default: 1400,
          loading: 'lazy'
        %}
      </div>
    {% endif %}
  </div>
  <div class="page-about-joseph__copy">
    <div class="page-about-joseph__inner">
      {% if section.settings.title != blank %}
        <h2 class="page-about-joseph__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="page-about-joseph__body rte">{{ section.settings.body }}</div>
      {% endif %}
    </div>
  </div>
</article>

<style>
  {%- if section.settings.heading_size_override != blank %}
  #shopify-section-{{ section.id }} { {% render 'type-override-vars', title_size: section.settings.heading_size_override %} --te-title-size-n: {{ section.settings.heading_size_override }}; }
  {%- endif %}
  #shopify-section-{{ section.id }} .page-about-joseph {
    display: block;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .page-about-joseph__gallery {
    background: var(--color-warm-cream, #faf8f6);
    display: grid;
    /* fr weights ≈ each image's aspect (554/600 = 0.923, 748/960 = 0.779) so both frames render
       at the same height when placed side-by-side with matching mat. Grok 2026-09-27. */
    grid-template-columns: 0.923fr 0.779fr;
    gap: clamp(20px, 3vw, 32px);
    align-items: center;
    padding: clamp(48px, 8vh, 80px) clamp(20px, 6vw, 6vw);
    border-top: 1px solid var(--line-soft, #e8e2d8);
    border-bottom: 1px solid var(--line-soft, #e8e2d8);
  }
  #shopify-section-{{ section.id }} .page-about-joseph__frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    background: #fff;
    border: 1px solid var(--line-soft, #e8e2d8);
    border-radius: 4px;
    --mat: clamp(12px, 2vw, 20px);
    /* Aspect-ratio is set inline per-image (image.width / image.height, with hardcoded
       fallbacks per image for URL-only case). Mat is applied via .media-img inset+dims
       below — NOT via padding — because abs children fill to the padding-edge and
       overrun any padding on the containing block. */
  }
  #shopify-section-{{ section.id }} .page-about-joseph__frame .media-img {
    inset: var(--mat);
    width: calc(100% - 2 * var(--mat));
    height: calc(100% - 2 * var(--mat));
  }
  #shopify-section-{{ section.id }} .page-about-joseph__copy {
    padding: clamp(40px, 7vh, 72px) clamp(20px, 8vw, 8vw);
  }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .page-about-joseph--fixed-pad-d-y .page-about-joseph__copy {
      padding-top: var(--utp-y-d);
      padding-bottom: var(--utp-y-d);
    }
    #shopify-section-{{ section.id }} .page-about-joseph--fixed-pad-d-x .page-about-joseph__copy {
      padding-left: var(--utp-side-d);
      padding-right: var(--utp-side-d);
    }
  }
  #shopify-section-{{ section.id }} .page-about-joseph__inner { max-width: 32em; }
  #shopify-section-{{ section.id }} .page-about-joseph__title {
    font-size: clamp(var(--heading-phone, 36px), calc(var(--te-title-size-n, var(--heading-standard-desktop-n, 56)) * 4.8vw / 56), var(--te-title-size, var(--heading-standard-desktop, 56px))); /* standard heading tier (Theme settings > Section headings) */
    font-weight: var(--te-title-weight, 400);
    letter-spacing: -0.032em;
    line-height: 1.06;
    margin: 0 0 24px;
    color: var(--text-primary, #1c1916);
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .page-about-joseph__title {
      font-size: var(--heading-phone, 36px);
    }
  }
  #shopify-section-{{ section.id }} .page-about-joseph__body {
    font-size: var(--te-body-size, 17px);
    font-weight: var(--te-body-weight, 400);
    line-height: 1.7;
    color: var(--text-body, #4a4a4a);
  }
  #shopify-section-{{ section.id }} .page-about-joseph__body p + p { margin-top: 1em; }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-joseph {
      display: flex;
      flex-direction: column;
    }
    #shopify-section-{{ section.id }} .page-about-joseph__gallery {
      grid-template-columns: 1fr;
      padding: 28px 20px;
    }
    /* Mobile: frame aspect-ratio + padding drive size from inline style; no fixed height. */
    #shopify-section-{{ section.id }} .page-about-joseph__copy {
      padding: 28px 20px 36px;
    }
    #shopify-section-{{ section.id }} .page-about-joseph--fixed-pad-m-y .page-about-joseph__copy {
      padding-top: var(--utp-y-m);
      padding-bottom: var(--utp-y-m);
    }
    #shopify-section-{{ section.id }} .page-about-joseph--fixed-pad-m-x .page-about-joseph__copy {
      padding-left: var(--utp-x-m);
      padding-right: var(--utp-x-m);
    }
  }
</style>

{% render 'unified-text-pads-te-style', selector: '.page-about-joseph__copy', y_d: 56, side_d: 48, y_m: 28, x_m: 20 %}

{% schema %}
{
  "name": "About \u2014 Joseph",
  "settings": [
    {
      "type": "header",
      "content": "1 \u2014 Photo / video"
    },
    {
      "type": "paragraph",
      "content": "Two archival images (gallery column). Shopify picker \u2192 URL fallback for each."
    },
    {
      "type": "text",
      "id": "gallery_aria",
      "label": "Gallery accessibility name",
      "default": "Joseph Pilates archival photographs"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Archival image 1 (Shopify)"
    },
    {
      "type": "text",
      "id": "image_1_url",
      "label": "Image 1 URL fallback",
      "default": "https://barreletics.com/cdn/shop/files/Screenshot_2026-06-06_at_6.59.10_PM.png?v=1780787015&width=1600"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Image 1 alt",
      "default": "Archival photograph of Joseph Pilates on the Reformer"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Archival image 2"
    },
    {
      "type": "text",
      "id": "image_2_url",
      "label": "Image 2 URL fallback",
      "default": "https://barreletics.com/cdn/shop/files/Screenshot_2026-06-06_at_9.58.53_PM.png?v=1780797556&width=1400"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Image 2 alt",
      "default": "Archival photograph of Joseph Pilates teaching on the Reformer"
    },
    {
      "type": "header",
      "content": "2 \u2014 Focus + height"
    },
    {
      "type": "paragraph",
      "content": "Gallery uses natural aspect ratios; no height sliders on this section."
    },
    {
      "type": "header",
      "content": "3 \u2014 Heading / body / CTA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Joseph Pilates built the method around the feet."
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level (default H2)",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "header",
      "content": "4 \u2014 Trust strip"
    },
    {
      "type": "paragraph",
      "content": "Not used."
    },
    {
      "type": "header",
      "content": "5 \u2014 Layout"
    },
    {
      "type": "select",
      "id": "mobile_stack_order",
      "label": "Phone stack (default: gallery on top)",
      "default": "media_first",
      "options": [
        {
          "value": "media_first",
          "label": "Gallery above essay (default)"
        },
        {
          "value": "copy_first",
          "label": "Essay above gallery"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom \u2014 desktop (default 56)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "info": "Unset in JSON keeps legacy clamp padding on the essay column.",
      "default": 56
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right \u2014 desktop (default 48)",
      "min": 0,
      "max": 96,
      "step": 1,
      "unit": "px",
      "info": "Unset keeps legacy clamp horizontal padding.",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom \u2014 phone (default 28)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "info": "Unset in JSON keeps legacy 28/36px gallery copy padding.",
      "default": 28
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right \u2014 phone (default 20)",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "6 \u2014 Section gap"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "Space above & below \u2014 desktop (default 0)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_gap_mobile",
      "label": "Space after section \u2014 phone (default 0)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Legacy (hidden \u2014 do not edit)"
    },
    {
      "type": "paragraph",
      "content": "Preserves stored values on Theme Editor save."
    },
    {
      "type": "number",
      "id": "heading_size_override",
      "label": "Legacy: Heading size override",
      "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Legacy: Heading weight",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        }
      ],
