    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Legacy: Body weight",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        }
      ],
      "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}"
    }
  ],
  "presets": [
    {
      "name": "About \u2014 Joseph"
    }
  ]
}
{% endschema %}
