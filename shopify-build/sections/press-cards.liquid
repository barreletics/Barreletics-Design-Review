{% comment %}
  Press cards — reusable recognition grid (Home / PDP).
  Desk: equal CSS columns. Mobile: 1-col stack (no carousel). Cream #faf8f6.
{% endcomment %}

{% liquid
  assign heading = section.settings.heading | default: 'PRESS'
  assign bg = section.settings.bg_color | default: '#faf8f6'
  assign cols = section.settings.columns_desktop | default: 3
  assign cols_mobile = section.settings.columns_mobile | default: 1
  assign gap = section.settings.gap | default: 16
  assign radius = section.settings.card_radius | default: 0
  assign pad_y = section.settings.padding_y | default: 48
  assign pad_x = section.settings.padding_x | default: 40
  assign media_ratio = section.settings.media_ratio | default: '4 / 5'
  assign video_mode = section.settings.video_mode | default: 'autoplay'
%}

<section
  id="press-cards-{{ section.id }}"
  class="press-cards section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %}"
  style="
    {% render 'section-inset-vars' %}{% render 'unified-text-pads-vars', y_d: 48, side_d: 40, y_m: 32, x_m: 20, legacy_y_d: section.settings.padding_y, legacy_side_d: section.settings.padding_x %}
    --pc-bg: {{ bg }};
    --pc-cols: {{ cols }};
    --pc-gap: {{ gap }}px;
    --pc-radius: {{ radius }}px;
    --pc-pad-y: {{ pad_y }}px;
    --pc-pad-x: {{ pad_x }}px;
    --pc-ratio: {{ media_ratio }};
    --pc-cols-mobile: {{ cols_mobile }};
  "
  aria-label="{{ heading | strip_html | escape }}"
>
  <div class="press-cards__inner">
    {% if heading != blank %}
      <p class="press-cards__heading type-label">{{ heading }}</p>
    {% endif %}

    <div class="press-cards__grid">
      {% for block in section.blocks %}
        {% liquid
          assign media_type = block.settings.media_type | default: 'image'
          assign card_title = block.settings.title
          assign card_eyebrow = block.settings.eyebrow
          assign card_caption = block.settings.caption
          assign card_link = block.settings.link
          assign card_link_label = block.settings.link_label
          assign image_fit = block.settings.image_fit | default: 'cover'
          assign alt_text = card_title | default: card_eyebrow | default: 'Press' | strip_html
          assign pc_sizes = '(max-width: 749px) 100vw, calc(100vw / ' | append: cols | append: ')'
          assign card_class = 'press-cards__card'
          if block.settings.hide_on_desktop
            assign card_class = card_class | append: ' press-cards__card--hide-desktop'
          endif
          if block.settings.hide_on_mobile
            assign card_class = card_class | append: ' press-cards__card--hide-mobile'
          endif
        %}
        <article class="{{ card_class }}" {{ block.shopify_attributes }}>
          <div class="press-cards__media press-cards__media--{{ image_fit }}">
            {% if media_type == 'video' %}
              {% if block.settings.video != blank %}
                {{
                  block.settings.video
                  | video_tag:
                    image_size: '1600x',
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    playsinline: true,
                    preload: 'metadata',
                    class: 'press-cards__video'
                }}
              {% elsif block.settings.video_url != blank %}
                {% liquid
                  assign poster_src = blank
                  if block.settings.poster != blank
                    assign poster_src = block.settings.poster | image_url: width: 1600
                  elsif block.settings.poster_url != blank
                    assign poster_src = block.settings.poster_url
                  elsif block.settings.image != blank
                    assign poster_src = block.settings.image | image_url: width: 1600
                  elsif block.settings.image_url != blank
                    assign poster_src = block.settings.image_url
                  endif
                %}
                {% if video_mode == 'click' %}
                  <button
                    type="button"
                    class="press-cards__play"
                    data-press-play
                    aria-label="Play video"
                  >
                    {% if poster_src != blank %}
                      {% render 'media-img',
                         url: poster_src,
                         alt: alt_text,
                         class: 'press-cards__img',
                         loading: 'lazy',
                         width_attr: 800,
                         height_attr: 1000 %}
                    {% endif %}
                    <span class="press-cards__play-icon" aria-hidden="true"></span>
                  </button>
                  <video
                    class="press-cards__video press-cards__video--deferred"
                    muted
                    loop
                    playsinline
                    webkit-playsinline
                    preload="metadata"
                    {% if poster_src != blank %}poster="{{ poster_src | escape }}"{% endif %}
                    data-src="{{ block.settings.video_url | escape }}"
                    hidden
                  ></video>
                {% else %}
                  <video
                    class="press-cards__video"
                    autoplay
                    muted
                    loop
                    playsinline
                    webkit-playsinline
                    preload="metadata"
                    {% if poster_src != blank %}poster="{{ poster_src | escape }}"{% endif %}
                  >
                    <source src="{{ block.settings.video_url | escape }}" type="video/mp4">
                  </video>
                {% endif %}
              {% elsif block.settings.poster != blank %}
                {% render 'media-img',
                   image: block.settings.poster,
                   alt: alt_text,
                   class: 'press-cards__img',
                   widths: '800, 1200, 1600',
                   width_default: 1600,
                   sizes: pc_sizes,
                   loading: 'lazy' %}
              {% elsif block.settings.poster_url != blank %}
                {% render 'media-img',
                   url: block.settings.poster_url,
                   alt: alt_text,
                   class: 'press-cards__img',
                   loading: 'lazy',
                   width_attr: 800,
                   height_attr: 1000 %}
              {% endif %}
            {% else %}
              {% if block.settings.image != blank %}
                {% render 'media-img',
                   image: block.settings.image,
                   alt: alt_text,
                   class: 'press-cards__img',
                   widths: '800, 1200, 1600',
                   width_default: 1600,
                   sizes: pc_sizes,
                   loading: 'lazy' %}
              {% elsif block.settings.image_url != blank %}
                {% render 'media-img',
                   url: block.settings.image_url,
                   alt: alt_text,
                   class: 'press-cards__img',
                   loading: 'lazy',
                   width_attr: 800,
                   height_attr: 1000 %}
              {% elsif block.settings.poster != blank %}
                {% render 'media-img',
                   image: block.settings.poster,
                   alt: alt_text,
                   class: 'press-cards__img',
                   widths: '800, 1200, 1600',
                   width_default: 1600,
                   sizes: pc_sizes,
                   loading: 'lazy' %}
              {% elsif block.settings.poster_url != blank %}
                {% render 'media-img',
                   url: block.settings.poster_url,
                   alt: alt_text,
                   class: 'press-cards__img',
                   loading: 'lazy',
                   width_attr: 800,
                   height_attr: 1000 %}
              {% endif %}
            {% endif %}
          </div>

          {% if card_eyebrow != blank or card_title != blank or card_caption != blank or card_link != blank %}
            <div class="press-cards__meta">
              {% if card_eyebrow != blank %}
                <p class="press-cards__eyebrow type-label">{{ card_eyebrow }}</p>
              {% endif %}
              {% if card_title != blank %}
                <h3 class="press-cards__title">{{ card_title }}</h3>
              {% endif %}
              {% if card_caption != blank %}
                <p class="press-cards__caption type-body">{{ card_caption }}</p>
              {% endif %}
              {% if card_link != blank and card_link_label != blank %}
                <a class="press-cards__link" href="{{ card_link }}">{{ card_link_label }}</a>
              {% elsif card_link != blank %}
                <a class="press-cards__link press-cards__link--stretch" href="{{ card_link }}" aria-label="{{ alt_text | escape }}"></a>
              {% endif %}
            </div>
          {% elsif card_link != blank %}
            <a class="press-cards__link press-cards__link--stretch" href="{{ card_link }}" aria-label="{{ alt_text | escape }}"></a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    background: var(--pc-bg, #faf8f6);
    /* TE mobile preview defensive: opt out of any inherited content-visibility skipping */
    content-visibility: visible;
    contain: none;
  }
  #shopify-section-{{ section.id }} .press-cards {
    background: var(--pc-bg, #faf8f6);
    padding: var(--pc-pad-y, 48px) var(--pc-pad-x, 40px);
    /* Fallback so section always has intrinsic size even if grid hasn't laid out yet */
    min-height: 300px;
  }
  #shopify-section-{{ section.id }} .press-cards__inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .press-cards__heading {
    margin: 0 0 20px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 700;
    color: #1c1916;
  }
  #shopify-section-{{ section.id }} .press-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--pc-cols, 3), minmax(0, 1fr));
    gap: var(--pc-gap, 16px);
  }
  /* Per-card hide toggles. display:none removes from grid so remaining cards fill columns cleanly. */
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .press-cards__card--hide-desktop { display: none !important; }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .press-cards__card--hide-mobile { display: none !important; }
  }
  #shopify-section-{{ section.id }} .press-cards__card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: transparent;
  }
  #shopify-section-{{ section.id }} .press-cards__media {
    position: relative;
    aspect-ratio: var(--pc-ratio, 4 / 5);
    overflow: hidden;
    border-radius: var(--pc-radius, 0px);
    background: #efeae3;
  }
  #shopify-section-{{ section.id }} .press-cards__img,
  #shopify-section-{{ section.id }} .press-cards__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  /* Over-scale video only — clips baked-in letterbox bars (Coperni video etc.) via parent overflow:hidden. */
  #shopify-section-{{ section.id }} .press-cards__video {
    position: absolute;
    top: -8%;
    left: -8%;
    width: 116%;
    height: 116%;
    max-width: none;
    max-height: none;
  }
  #shopify-section-{{ section.id }} .press-cards__media--contain .press-cards__img,
  #shopify-section-{{ section.id }} .press-cards__media--contain .press-cards__video {
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .press-cards__media--cover .press-cards__img,
  #shopify-section-{{ section.id }} .press-cards__media--cover .press-cards__video {
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .press-cards__play {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    background: transparent;
  }
  #shopify-section-{{ section.id }} .press-cards__play .press-cards__img {
    width: 100%;
    height: 100%;
  }
  #shopify-section-{{ section.id }} .press-cards__play-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    border-radius: 999px;
    background: rgba(28, 25, 22, 0.72);
    box-shadow: 0 8px 24px rgba(28, 25, 22, 0.2);
  }
  #shopify-section-{{ section.id }} .press-cards__play-icon::before {
    content: '';
    position: absolute;
    left: 22px;
    top: 18px;
    border-style: solid;
    border-width: 10px 0 10px 16px;
    border-color: transparent transparent transparent #fff;
  }
  #shopify-section-{{ section.id }} .press-cards__meta {
    padding: 14px 2px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #shopify-section-{{ section.id }} .press-cards__eyebrow {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6560;
  }
  #shopify-section-{{ section.id }} .press-cards__title {
    margin: 0;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 600;
    color: #1c1916;
  }
  #shopify-section-{{ section.id }} .press-cards__caption {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: #4a4a4a;
  }
  #shopify-section-{{ section.id }} .press-cards__link {
    font-size: 13px;
    font-weight: 600;
    color: #1c1916;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #shopify-section-{{ section.id }} .press-cards__link--stretch {
    position: absolute;
    inset: 0;
    z-index: 2;
    text-decoration: none;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .press-cards {
      padding: var(--utp-y-d, 48px) var(--utp-side-d, 40px);
    }
    #shopify-section-{{ section.id }} .press-cards__grid {
      grid-template-columns: repeat(var(--pc-cols-mobile, 1), minmax(0, 1fr));
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('press-cards-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('[data-press-play]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var media = btn.parentElement;
        if (!media) return;
        var video = media.querySelector('video[data-src]');
        if (!video) return;
        if (!video.getAttribute('src') && video.dataset.src) {
          video.src = video.dataset.src;
        }
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        video.playsInline = true;
        btn.hidden = true;
        video.hidden = false;
        video.play().catch(function () {});
      });
    });
  })();
</script>

{% render 'bg-video-autoplay-script',
  section_id: section.id,
  root_class: 'press-cards',
  video_selector: 'video.press-cards__video:not(.press-cards__video--deferred)'
%}

{% render 'unified-text-pads-te-style', selector: '.press-cards', y_d: 48, side_d: 40, y_m: 32, x_m: 20 , legacy_y_d: section.settings.padding_y , legacy_side_d: section.settings.padding_x %}

{% schema %}
{
  "name": "Press cards",
  "tag": "section",
  "class": "section-press-cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section label",
      "default": "PRESS"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Press"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#faf8f6"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column (stack)"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1",
      "info": "1 = stack. 2 = tighter grid on phone."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Padding vertical",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.aria_label == '__legacy_hidden__' }}"
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Padding horizontal",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.aria_label == '__legacy_hidden__' }}"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Media aspect ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "1:1"
        },
        {
          "value": "4 / 5",
          "label": "4:5"
        },
        {
          "value": "3 / 4",
          "label": "3:4"
        },
        {
          "value": "16 / 9",
          "label": "16:9"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "video_mode",
      "label": "Video behavior",
      "options": [
        {
          "value": "autoplay",
          "label": "Muted autoplay loop"
        },
        {
          "value": "click",
          "label": "Click to play (poster)"
        }
      ],
      "default": "autoplay"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout — text padding"
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 48)",
      "min": 8,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 40)",
      "min": 8,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 32)",
      "min": 8,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 20)",
      "min": 8,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Legacy (hidden — do not edit)"
    },
    {
      "type": "paragraph",
      "content": "Preserves stored values on Theme Editor save."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image fit",
          "options": [
            {
              "value": "cover",
              "label": "Fill card (crop)"
            },
            {
              "value": "contain",
              "label": "Fit inside (no crop)"
            }
          ],
          "default": "cover",
          "info": "Use Fit inside for magazine/editorial art so the full page shows."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Shopify)"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL fallback",
          "info": "Used when Image (Shopify) is empty — for existing CDN URLs."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify video",
          "info": "Preferred when the file is in Shopify Files."
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (mp4)",
          "info": "CDN/mp4 when not using Shopify video."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster (Shopify)"
        },
        {
          "type": "text",
          "id": "poster_url",
          "label": "Poster URL fallback"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "header",
          "content": "Visibility"
        },
        {
          "type": "checkbox",
          "id": "hide_on_desktop",
          "label": "Hide on desktop",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "hide_on_mobile",
          "label": "Hide on mobile",
          "default": false,
          "info": "Row auto-shrinks to remaining visible cards."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "media_type": "video",
            "eyebrow": "Coperni",
            "title": "Barreletics × Coperni"
          }
        },
        {
          "type": "card",
          "settings": {
            "media_type": "image",
            "eyebrow": "Runway",
            "title": "Paris"
          }
        },
        {
          "type": "card",
          "settings": {
            "media_type": "image",
            "eyebrow": "INTERNI",
            "title": "As seen in INTERNI"
          }
        }
      ]
    }
  ]
}
{% endschema %}
