{% comment %}
  Reviews — hybrid (Andrew CURRENT MESSAGE 2026-08-08, forward 2026-08-08 evening):

  1. Top: up to 3 curated PHOTO cards (Theme Editor blocks). Hand-picked best
     reviews with customer photos. Image blank → "Add image" placeholder.
     Different sets per template; quotes must be verbatim from
     docs/09-PRODUCT-KNOWLEDGE.md PRODUCTION-READY REVIEWS.

  2. Under: up to 6 curated TEXT cards (original social-proof community row).
     Same verified-quote law. This is the signed-off "six text sections" band.

  3. Optional live Judge.me under that (full mode on /pages/reviews). Compact
     PDPs use the curated 6 text cards — not a empty Judge.me stand-in.

  Judge.me data is still tokenless metafield HTML — never reintroduce the
  unauthenticated judge.me/api/v1/reviews fetch (401).
{% endcomment %}

{% liquid
  assign scope = section.settings.scope | default: 'product'
  assign live_mode = section.settings.live_mode | default: 'compact'
  assign show_photo = section.settings.show_photo_cards
  assign show_text = section.settings.show_text_cards
  assign show_live = section.settings.show_live_text

  if scope == 'store'
    assign jm_widget = shop.metafields.judgeme.all_reviews_page
    assign jm_header = shop.metafields.judgeme.all_reviews_header
    assign jm_chunk = shop.metafields.judgeme.all_reviews_0
    assign jm_rating = shop.metafields.judgeme.all_reviews_rating
    assign jm_count = shop.metafields.judgeme.all_reviews_count | plus: 0
    assign write_url = '/pages/reviews'
  else
    assign jm_widget = product.metafields.judgeme.widget
    assign jm_header = ''
    assign jm_chunk = ''
    assign jm_rating = product.metafields.judgeme.average_rating
    assign jm_count = product.metafields.judgeme.review_count | plus: 0
    assign write_url = product.url
  endif

  assign has_aggregate = false
  if jm_count > 0 and jm_rating
    assign has_aggregate = true
  endif

  assign has_widget = false
  if jm_widget != blank or jm_header != blank or jm_chunk != blank
    assign has_widget = true
  endif

  assign photo_count = 0
  assign text_count = 0
  for block in section.blocks
    if block.type == 'photo_review'
      assign photo_count = photo_count | plus: 1
    endif
    if block.type == 'text_review'
      assign text_count = text_count | plus: 1
    endif
  endfor

  assign render_live = false
  if show_live
    assign render_live = true
  endif
%}
{% comment %}
  HARD: show_live_text always mounts Judge.me. Compact CSS hides chrome +
  review media; never skip the widget when curated text cards exist, and
  never JS-hide reviews that include photos (that emptied Outdoor's row).
{% endcomment %}

<section
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} pdp-reviews pdp-reviews--{{ live_mode }}"
  id="{{ section.settings.anchor_id | default: 'reviews' }}"
  aria-label="Customer reviews"
  data-jm-scope="{{ scope }}"
  data-jm-pictures-first="{% if section.settings.pictures_first %}true{% else %}false{% endif %}"
  style="{% render 'section-inset-vars' %}{% if section.settings.bg_color != blank %} background: {{ section.settings.bg_color }};{% endif %}"
>
  <div class="pdp-reviews__inner">
    {% if section.settings.title != blank or section.settings.body != blank or has_aggregate %}
      <header class="pdp-reviews__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pdp-reviews__title h2-standard">{{ section.settings.title }}</h2>
          {% endif %}
          {% if section.settings.body != blank %}
            <p class="pdp-reviews__body">{{ section.settings.body }}</p>
          {% endif %}
          {% if has_aggregate and section.settings.show_aggregate and jm_count >= 1000 %}
            <p class="pdp-reviews__score">
              <span class="pdp-reviews__stars" aria-hidden="true">★★★★★</span>
              <strong>{{ jm_rating }}</strong> out of 5 · {{ jm_count }} reviews
            </p>
          {% endif %}
        </div>
        {% if section.settings.all_reviews_label != blank %}
          <a
            class="pdp-reviews__more"
            href="{{ section.settings.all_reviews_url | default: write_url }}"
          >{{ section.settings.all_reviews_label }}</a>
        {% endif %}
        {% if live_mode == 'full' %}
          <a class="pdp-reviews__more pdp-reviews__write jdgm-write-rev-link" href="#judgeme_product_reviews">Write a Review</a>
        {% endif %}
      </header>
    {% endif %}

    {% if show_photo and photo_count > 0 %}
      <div class="pdp-reviews__photo-grid">
        {% assign shown = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'photo_review' and shown < 3 %}
            {% liquid
              assign star_n = block.settings.rating | default: 5
              if star_n < 1
                assign star_n = 1
              endif
              if star_n > 5
                assign star_n = 5
              endif
              assign shown = shown | plus: 1
            %}
            <article class="pdp-reviews__photo-card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    class: 'pdp-reviews__photo-img',
                    loading: 'lazy',
                    widths: '400, 600, 900',
                    sizes: '(max-width: 768px) 100vw, 33vw',
                    alt: block.settings.author
                }}
              {% elsif block.settings.image_url != blank %}
                <img
                  class="pdp-reviews__photo-img"
                  src="{{ block.settings.image_url | escape }}"
                  alt="{{ block.settings.author | default: 'Customer photo' | escape }}"
                  loading="lazy"
                  width="900"
                  height="900"
                >
              {% else %}
                <div class="pdp-reviews__photo-img pdp-reviews__photo-img--empty" role="img" aria-label="Add customer photo">
                  <span>Add image</span>
                </div>
              {% endif %}
              <div class="pdp-reviews__photo-pad">
                <div class="pdp-reviews__photo-stars" aria-label="{{ star_n }} out of 5 stars">
                  {% for i in (1..5) %}
                    {% if i <= star_n %}★{% else %}<span class="pdp-reviews__star--empty">☆</span>{% endif %}
                  {% endfor %}
                </div>
                {% if block.settings.body != blank %}
                  <p class="pdp-reviews__photo-body">“{{ block.settings.body | strip | remove: '"' | remove: '“' | remove: '”' }}”</p>
                {% endif %}
                <footer class="pdp-reviews__photo-footer">
                  {% if block.settings.author != blank %}
                    <span class="pdp-reviews__photo-author">{{ block.settings.author }}</span>
                  {% endif %}
                  {% if block.settings.location != blank %}
                    <span class="pdp-reviews__photo-loc">{{ block.settings.location }}</span>
                  {% endif %}
                </footer>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if show_text and text_count > 0 %}
      {% if section.settings.community_label != blank %}
        <p class="pdp-reviews__community-label">{{ section.settings.community_label }}</p>
      {% endif %}
      <div class="pdp-reviews__text-grid">
        {% assign text_shown = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'text_review' and text_shown < 6 %}
            {% liquid
              assign star_n = block.settings.rating | default: 5
              if star_n < 1
                assign star_n = 1
              endif
              if star_n > 5
                assign star_n = 5
              endif
              assign text_shown = text_shown | plus: 1
            %}
            <article class="pdp-reviews__text-card" {{ block.shopify_attributes }}>
              <div class="pdp-reviews__text-stars" aria-label="{{ star_n }} out of 5 stars">
                {% for i in (1..5) %}
                  {% if i <= star_n %}★{% else %}<span class="pdp-reviews__star--empty">☆</span>{% endif %}
                {% endfor %}
              </div>
              {% if block.settings.body != blank %}
                <p class="pdp-reviews__text-body">“{{ block.settings.body | strip | remove: '"' | remove: '“' | remove: '”' }}”</p>
              {% endif %}
              <footer class="pdp-reviews__text-footer">
                {% if block.settings.author != blank %}
                  <span class="pdp-reviews__text-author">{{ block.settings.author }}</span>
                {% endif %}
                {% if block.settings.location != blank %}
                  <span class="pdp-reviews__text-loc">{{ block.settings.location }}</span>
                {% endif %}
              </footer>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if render_live %}
      {% if section.settings.community_label != blank and live_mode == 'compact' and text_count == 0 %}
        <p class="pdp-reviews__community-label">{{ section.settings.community_label }}</p>
      {% endif %}

      <div style="clear:both"></div>

      {% if live_mode == 'compact' and text_count == 0 %}
        {% comment %}
          Visible 3-up text cards. SSR fallback from photo-review quotes so the
          row is never empty; JS replaces with live Judge.me when it hydrates.
        {% endcomment %}
        <div
          class="pdp-reviews__text-grid pdp-reviews__jm-cards"
          data-jm-card-target
          data-jm-card-count="3"
        >
          {% assign fb_shown = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'photo_review' and fb_shown < 3 and block.settings.body != blank %}
              {% assign fb_shown = fb_shown | plus: 1 %}
              {% assign star_n = block.settings.rating | default: 5 %}
              <article class="pdp-reviews__text-card" data-jm-fallback>
                <div class="pdp-reviews__text-stars" aria-label="{{ star_n }} out of 5 stars">
                  {% for i in (1..5) %}{% if i <= star_n %}★{% else %}☆{% endif %}{% endfor %}
                </div>
                <p class="pdp-reviews__text-body">“{{ block.settings.body | strip | remove: '"' | remove: '“' | remove: '”' }}”</p>
                <footer class="pdp-reviews__text-footer">
                  {% if block.settings.author != blank %}
                    <span class="pdp-reviews__text-author">{{ block.settings.author }}</span>
                  {% endif %}
                  {% if block.settings.location != blank %}
                    <span class="pdp-reviews__text-loc">{{ block.settings.location }}</span>
                  {% endif %}
                </footer>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div class="pdp-reviews__live{% if live_mode == 'compact' %} pdp-reviews__live--compact pdp-reviews__live--source{% endif %}">
        {% if scope == 'store' and live_mode == 'full' %}
          <div class="pdp-reviews__widget pdp-reviews__widget--all">
            {% render 'judgeme_all_reviews' %}
          </div>
        {% elsif scope == 'store' %}
          <div class="jdgm-widget jdgm-all-reviews-widget pdp-reviews__widget">
            {{ jm_widget }}
          </div>
        {% else %}
          <div
            id="judgeme_product_reviews"
            class="jdgm-widget jdgm-review-widget pdp-reviews__widget"
            data-product-title="{{ product.title | escape }}"
            data-id="{{ product.id }}"
          >
            {{ jm_widget }}
          </div>
        {% endif %}

        {% unless has_widget %}
          <div class="pdp-reviews__standin" role="note">
            <p class="pdp-reviews__standin-flag">Placeholder — live Judge.me text reviews render here</p>
            <p class="pdp-reviews__standin-copy">
              {% if live_mode == 'compact' %}
                In Shopify this band is filled by Judge.me as a compact text-card row
                (histogram and review photos hidden — the three cards above are the curated photo set).
              {% else %}
                In Shopify this block is the full Judge.me reviews widget.
              {% endif %}
              Source:
              {% if scope == 'store' %}
                <strong>shop.metafields.judgeme.all_reviews_page</strong>
              {% else %}
                <strong>product.metafields.judgeme.widget</strong>
              {% endif %}.
              Static previews cannot fetch Judge.me — nothing is broken.
            </p>
          </div>
        {% endunless %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .pdp-reviews {
    padding: var(--section-padding-y) var(--section-padding-x);
    background: var(--bg-primary);
  }

  .pdp-reviews__inner {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .pdp-reviews__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: var(--space-8);
  }

  .pdp-reviews__title {
    margin: 0 0 var(--gap-a);
  }

  .pdp-reviews__body {
    font-size: var(--type-lede-size);
    font-weight: var(--type-lede-weight);
    line-height: var(--type-lede-leading);
    color: var(--text-body);
    margin: 0;
    max-width: 32ch;
  }

  .pdp-reviews__score {
    font-size: 14px;
    color: var(--text-body);
    margin: 10px 0 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pdp-reviews__stars {
    color: var(--accent-stars);
    letter-spacing: 0.12em;
  }

  .pdp-reviews__more {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
  }

  .pdp-reviews__more:hover {
    color: #c45c3f;
  }

  /* ---- Curated photo cards (3) ------------------------------------------- */

  .pdp-reviews__photo-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }

  .pdp-reviews__photo-card {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    flex: 0 1 calc(33.333% - 14px);
    max-width: calc(33.333% - 14px);
    min-width: 0;
    width: 100%;
  }

  .pdp-reviews__photo-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center center;
    display: block;
    margin-inline: auto;
  }

  .pdp-reviews__photo-img--empty {
    background: #e8e2d8;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8a8a8a;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pdp-reviews__photo-pad {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .pdp-reviews__photo-stars {
    color: #c45c3f;
    font-size: 14px;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .pdp-reviews__star--empty {
    opacity: 0.3;
  }

  .pdp-reviews__photo-body {
    font-size: 15px;
    color: #4a4a4a;
    line-height: 1.55;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pdp-reviews__photo-footer {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pdp-reviews__photo-author {
    font-size: 13px;
    font-weight: 500;
    color: #1c1916;
  }

  .pdp-reviews__photo-loc {
    font-size: 12px;
    color: #8a8a8a;
  }

  .pdp-reviews__community-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8a8a8a;
    text-align: center;
    margin: 48px 0 24px;
  }

  /* ---- Curated text cards (6) — original social-proof community row ------ */

  .pdp-reviews__text-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
    justify-content: center;
    justify-items: stretch;
  }

  .pdp-reviews__text-card {
    background: #fff;
    border: 1px solid #e6e6e6;
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .pdp-reviews__text-stars {
    color: #d4af37;
    font-size: 14px;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .pdp-reviews__text-body {
    font-size: 14px;
    font-style: italic;
    color: #4a4a4a;
    line-height: 1.6;
    margin: 0;
    flex: 1;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .pdp-reviews__text-footer {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px;
  }

  .pdp-reviews__text-author {
    font-size: 12px;
    font-weight: 700;
    color: #1c1916;
  }

  .pdp-reviews__text-loc {
    font-size: 12px;
    font-weight: 400;
    color: #8a8a8a;
  }

  /* ---- Judge.me skin ----------------------------------------------------- */

  .pdp-reviews__widget {
    --jdgm-primary-color: #c45c3f;
    --jdgm-star-color: var(--accent-stars);
    font-family: inherit;
  }

  .pdp-reviews__widget .jdgm-star {
    color: var(--accent-stars);
  }

  .pdp-reviews__widget .jdgm-rev,
  .pdp-reviews__widget .jdgm-rev.jdgm-divider-top {
    border-color: #e8e2d8;
    padding: var(--space-6) 0;
  }

  .pdp-reviews__widget .jdgm-rev__title {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .pdp-reviews__widget .jdgm-rev__body,
  .pdp-reviews__widget .jdgm-rev__body p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-body);
  }

  .pdp-reviews__widget .jdgm-rev__author {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .pdp-reviews__widget .jdgm-rev__location,
  .pdp-reviews__widget .jdgm-rev__timestamp {
    font-size: 12px;
    color: var(--text-muted);
  }

  .pdp-reviews__widget .jdgm-rev__buyer-badge {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: #7b8c84;
  }

  .pdp-reviews__widget .jdgm-write-rev-link,
  .pdp-reviews__widget .jdgm-btn--solid {
    border-radius: 0;
    letter-spacing: var(--tracking-wider);
    font-weight: var(--weight-semibold);
  }

  .pdp-reviews__widget .jdgm-histogram__bar-content {
    background: var(--accent-stars);
  }

  /* Compact: text-card band only — Juicer is the photo wall */
  .pdp-reviews__live--compact .jdgm-rev-widg__summary,
  .pdp-reviews__live--compact .jdgm-histogram,
  .pdp-reviews__live--compact .jdgm-widget-actions,
  .pdp-reviews__live--compact .jdgm-write-rev-link,
  .pdp-reviews__live--compact .jdgm-sort-dropdown,
  .pdp-reviews__live--compact .jdgm-row-search,
  .pdp-reviews__live--compact .jdgm-paginate-all-reviews,
  .pdp-reviews__live--compact .jdgm-rev__pics,
  .pdp-reviews__live--compact .jdgm-rev__vids,
  .pdp-reviews__live--compact .jdgm-gallery,
  .pdp-reviews__live--compact .jdgm-rev__custom-form,
  .pdp-reviews__live--compact .jdgm-form-wrapper,
  .pdp-reviews__live--compact .jdgm-rev-widg__header {
    display: none !important;
  }

  .pdp-reviews__live--compact .jdgm-rev-widg__reviews,
  .pdp-reviews__live--compact .jdgm-all-rev-widg__reviews {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .pdp-reviews__live--compact .jdgm-rev,
  .pdp-reviews__live--compact .jdgm-rev.jdgm-divider-top {
    background: #fff;
    border: 1px solid #e6e6e6;
    border-radius: 12px;
    padding: 24px;
    margin: 0;
  }

  .pdp-reviews__live--compact .jdgm-rev:nth-child(n + 4) {
    display: none !important;
  }

  /* Full store page: keep Judge.me pagination / Load more visible */
  .pdp-reviews--full .jdgm-paginate,
  .pdp-reviews--full .jdgm-paginate-all-reviews {
    display: block !important;
    margin-top: 28px;
  }

  /* One list only — hide Product Reviews / Shop Reviews tabs */
  .pdp-reviews--full .jdgm-subtab {
    display: none !important;
  }

  /* When JS builds the 3 text cards, park the raw Judge.me source off-screen */
  .pdp-reviews__live--source.is-cardified {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .pdp-reviews__jm-cards:not([hidden]) {
    margin-top: 8px;
  }

  .pdp-reviews__standin {
    border: 2px dashed #c9a227;
    background: #fffdf5;
    padding: var(--space-6);
    text-align: center;
  }

  .pdp-reviews__standin-flag {
    display: inline-block;
    margin: 0 0 12px;
    padding: 6px 12px;
    background: #f6e7b8;
    color: #8a6d3b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pdp-reviews__standin-copy {
    margin: 0 auto;
    max-width: 70ch;
    font-size: 13px;
    line-height: 1.6;
    color: #6b645a;
  }

  @media (max-width: 1024px) {
    .pdp-reviews__photo-grid {
      justify-content: center;
    }

    .pdp-reviews__photo-card {
      flex: 0 1 calc(50% - 10px);
      max-width: calc(50% - 10px);
    }

    .pdp-reviews__text-grid,
    .pdp-reviews__live--compact .jdgm-rev-widg__reviews,
    .pdp-reviews__live--compact .jdgm-all-rev-widg__reviews {
      grid-template-columns: repeat(2, 1fr);
      justify-items: stretch;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .pdp-reviews {
      padding: var(--section-padding-y-mobile, 48px) 16px;
      overflow-x: hidden;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .pdp-reviews__inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .pdp-reviews__head,
    #shopify-section-{{ section.id }} .pdp-reviews__head > div {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      max-width: 100%;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .pdp-reviews__title {
      width: 100%;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .pdp-reviews__body {
      max-width: none;
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .pdp-reviews__photo-grid,
    #shopify-section-{{ section.id }} .pdp-reviews__text-grid,
    #shopify-section-{{ section.id }} .pdp-reviews__live--compact .jdgm-rev-widg__reviews,
    #shopify-section-{{ section.id }} .pdp-reviews__live--compact .jdgm-all-rev-widg__reviews {
      display: grid;
      grid-template-columns: 1fr;
      justify-content: center;
      justify-items: stretch;
      width: 100%;
      max-width: 100%;
      margin-inline: auto;
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .pdp-reviews__photo-card,
    #shopify-section-{{ section.id }} .pdp-reviews__text-card,
    #shopify-section-{{ section.id }} .pdp-reviews__live--compact .jdgm-rev {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      margin-inline: auto;
      box-sizing: border-box;
    }

    .pdp-reviews__photo-pad {
      padding: 18px 18px 20px;
    }

    .pdp-reviews__photo-body {
      font-size: 14px;
    }

    .pdp-reviews__community-label {
      margin: 36px 0 20px;
    }
  }
</style>

<script>
  (function () {
    // Compact mode: copy first 3 Judge.me reviews into our text-card grid
    // so the row always looks like Closed/Open community cards (dynamic).
    var roots = document.querySelectorAll('.pdp-reviews--compact');
    if (!roots.length) return;

    function starsHtml(score) {
      var n = Math.max(1, Math.min(5, parseInt(score, 10) || 5));
      var out = '';
      for (var i = 1; i <= 5; i++) out += i <= n ? '★' : '☆';
      return out;
    }

    function textOf(el) {
      return el ? String(el.textContent || '').replace(/\s+/g, ' ').trim() : '';
    }

    function build(section) {
      var target = section.querySelector('[data-jm-card-target]');
      var source = section.querySelector('.pdp-reviews__live--source');
      if (!target || !source) return false;

      var revs = Array.prototype.slice.call(source.querySelectorAll('.jdgm-rev'));
      if (!revs.length) return false;

      // Soft preference only — Judge.me still owns the feed. When pictures_first
      // is on, surface reviews that include media before text-only ones.
      var picsFirst = section.getAttribute('data-jm-pictures-first') === 'true';
      if (picsFirst) {
        revs.sort(function (a, b) {
          var ap = a.querySelector('.jdgm-rev__pics, .jdgm-rev__vids, .jdgm-gallery') ? 0 : 1;
          var bp = b.querySelector('.jdgm-rev__pics, .jdgm-rev__vids, .jdgm-gallery') ? 0 : 1;
          return ap - bp;
        });
      }

      var max = parseInt(target.getAttribute('data-jm-card-count') || '3', 10) || 3;
      var html = '';
      var count = 0;

      revs.forEach(function (rev) {
        if (count >= max) return;
        var bodyEl = rev.querySelector('.jdgm-rev__body');
        var body = textOf(bodyEl);
        if (!body) return;

        var author =
          textOf(rev.querySelector('.jdgm-rev__author')) ||
          textOf(rev.querySelector('.jdgm-rev__author-wrapper')) ||
          '';
        var loc = textOf(rev.querySelector('.jdgm-rev__location'));
        var score =
          (rev.querySelector('.jdgm-rev__rating') &&
            rev.querySelector('.jdgm-rev__rating').getAttribute('data-score')) ||
          '5';

        // Strip wrapping quotes if Judge.me already includes them
        body = body.replace(/^[“"]+|[”"]+$/g, '');

        html +=
          '<article class="pdp-reviews__text-card">' +
          '<div class="pdp-reviews__text-stars" aria-label="' +
          score +
          ' out of 5 stars">' +
          starsHtml(score) +
          '</div>' +
          '<p class="pdp-reviews__text-body">“' +
          body.replace(/</g, '&lt;') +
          '”</p>' +
          '<footer class="pdp-reviews__text-footer">' +
          (author
            ? '<span class="pdp-reviews__text-author">' + author.replace(/</g, '&lt;') + '</span>'
            : '') +
          (loc
            ? '<span class="pdp-reviews__text-loc">' + loc.replace(/</g, '&lt;') + '</span>'
            : '') +
          '</footer></article>';
        count += 1;
      });

      if (!count) return false;

      target.innerHTML = html;
      target.hidden = false;
      target.removeAttribute('hidden');
      source.classList.add('is-cardified');
      return true;
    }

    roots.forEach(function (section) {
      if (build(section)) return;

      var source = section.querySelector('.pdp-reviews__live--source');
      if (!source) return;
      var tries = 0;
      var timer = setInterval(function () {
        tries += 1;
        if (build(section) || tries > 40) clearInterval(timer);
      }, 250);

      var obs = new MutationObserver(function () {
        if (build(section)) obs.disconnect();
      });
      obs.observe(source, { childList: true, subtree: true });
    });
  })();
</script>

