{% comment %}
  Visual mosaic — Home WORKING 2b. Multi-tile lifestyle grid under hero.
  Blocks = tiles (add blocks to add squares / rows). Per-tile image or video.
{% endcomment %}

{%- liquid
  assign vm_cols = section.settings.columns | default: 3
  assign vm_gap = section.settings.grid_gap | default: 12
  assign vm_row_h = section.settings.tile_height | default: 268
  assign vm_radius = section.settings.corner_radius | default: 4
  assign vm_pad_legacy = section.settings.section_padding | default: 16
  assign vm_pad_top = section.settings.pad_top | default: vm_pad_legacy
  assign vm_pad_bottom = section.settings.pad_bottom | default: vm_pad_legacy
  assign vm_pad_x = section.settings.pad_x | default: vm_pad_legacy
  assign vm_fit = section.settings.media_fit | default: 'cover'
  assign vm_mob_cols = section.settings.mobile_columns | default: '2' | plus: 0
  assign vm_mob_h = section.settings.mobile_tile_height | default: 180
  assign vm_hero_wide = section.settings.hero_column_wide
  assign has_hero = false
  for block in section.blocks
    if block.settings.size == 'hero'
      assign has_hero = true
    endif
  endfor
  assign vm_shape = section.settings.featured_layout
  if vm_shape == blank
    if vm_cols <= 2 and has_hero
      assign vm_shape = 'stack_right'
    elsif vm_hero_wide
      assign vm_shape = 'working'
    else
      assign vm_shape = 'stack_right'
    endif
  endif
  assign vm_stack_right = false
  assign vm_featured_row = false
  if vm_shape == 'stack_right'
    assign vm_stack_right = true
  endif
  if vm_shape == 'featured_row'
    assign vm_featured_row = true
  endif
  if vm_stack_right or vm_featured_row
    assign vm_cols = 3
    assign vm_cols_css = '1fr 1fr 1fr'
    assign vm_hero_wide = false
  else
    if has_hero and vm_hero_wide
      assign vm_cols_css = '1.4fr'
    else
      assign vm_cols_css = '1fr'
    endif
    if vm_cols >= 2
      assign vm_cols_css = vm_cols_css | append: ' 1fr'
    endif
    if vm_cols >= 3
      assign vm_cols_css = vm_cols_css | append: ' 1fr'
    endif
    if vm_cols >= 4
      assign vm_cols_css = vm_cols_css | append: ' 1fr'
    endif
  endif
  if vm_mob_cols == 1
    assign vm_mob_cols_css = '1fr'
  else
    assign vm_mob_cols_css = '1fr 1fr'
  endif
  assign default_target = section.settings.default_link_target | default: '#variants'
  if default_target != blank and default_target != 'custom'
    assign default_href = default_target
  else
    assign default_href = section.settings.default_link_url | default: '#variants'
  endif
-%}

<section
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} visual-mosaic"
  data-vm-layout="{{ vm_shape }}"
  data-vm-overlay="{% if section.settings.show_overlay == false %}off{% else %}on{% endif %}"
  id="visual-mosaic-{{ section.id }}"
  aria-label="{{ section.settings.aria_label | default: 'Studio proof' | escape }}"
  style="{% render 'section-inset-vars' %} 
    --vm-cols-css: {{ vm_cols_css }};
    --vm-mob-cols-css: {{ vm_mob_cols_css }};
    --vm-gap: {{ vm_gap }}px;
    --vm-row-h: {{ vm_row_h }}px;
    --vm-radius: {{ vm_radius }}px;
    --vm-pad-top: {{ vm_pad_top }}px;
    --vm-pad-bottom: {{ vm_pad_bottom }}px;
    --vm-pad-x: {{ vm_pad_x }}px;
    --vm-fit: {{ vm_fit }};
    --vm-mob-h: {{ vm_mob_h }}px;
  "
>
  <div class="visual-mosaic__grid">
    {% liquid
      assign hero_used = false
      assign sm_shown = 0
      assign cells_used = 0
    %}
    {% for block in section.blocks %}
      {% liquid
        assign skip_tile = false
        assign tile_class = 'vm-tile'
        assign size = block.settings.size | default: 'sm'
        if vm_stack_right or vm_featured_row
          if has_hero == false and forloop.first
            assign size = 'hero'
          endif
        endif
        if size == 'hero'
          assign tile_class = tile_class | append: ' vm-tile--hero'
        else
          assign tile_class = tile_class | append: ' vm-tile--sm'
        endif

        assign link_target = block.settings.link_target | default: 'default'
        if link_target == 'default'
          assign tile_href = default_href
        elsif link_target != blank and link_target != 'custom'
          assign tile_href = link_target
        else
          assign tile_href = block.settings.link_url | default: default_href
        endif

        assign text_color = block.settings.text_color | default: 'white'
        assign content_pos = block.settings.content_position | default: 'bottom-left'
        assign media_pos = block.settings.media_position | default: 'center center'
        assign col_span = 1
        if size == 'hero' and vm_stack_right or size == 'hero' and vm_featured_row
          assign col_span = 2
        endif

        if vm_stack_right
          if size == 'hero'
            if hero_used
              assign skip_tile = true
            else
              assign hero_used = true
            endif
          else
            assign sm_shown = sm_shown | plus: 1
            if sm_shown > 2
              assign skip_tile = true
            endif
          endif
        endif
      %}
      {% unless skip_tile %}
      <a
        class="{{ tile_class }}"
        href="{{ tile_href }}"
        data-text-color="{{ text_color }}"
        data-content-position="{{ content_pos }}"
        style="--vm-media-pos: {{ media_pos }};{% if col_span > 1 %} --vm-col-span: {{ col_span }};{% endif %}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.video != blank %}
          {{
            block.settings.video
            | video_tag:
              image_size: '1200x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true
          }}
        {% elsif block.settings.video_url != blank %}
          <video
            autoplay
            muted
            loop
            playsinline
            webkit-playsinline
            preload="metadata"
            {% if block.settings.image != blank %}
              poster="{{ block.settings.image | image_url: width: 1200 }}"
            {% elsif block.settings.poster_url != blank %}
              poster="{{ block.settings.poster_url | escape }}"
            {% endif %}
          >
            <source src="{{ block.settings.video_url | escape }}" type="video/mp4">
          </video>
        {% elsif block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                    {{ block.settings.image | image_url: width: 900 }} 900w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 900px) 50vw, 33vw"
            alt="{{ block.settings.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="800"
            height="800"
          >
        {% elsif block.settings.image_url != blank %}
          <img
            src="{{ block.settings.image_url | escape }}"
            alt="{{ block.settings.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="800"
            height="800"
          >
        {% else %}
          <span class="vm-tile__placeholder" aria-hidden="true"></span>
        {% endif %}
        {% unless section.settings.show_overlay == false %}
          <span class="vm-tile__shade"></span>
        {% endunless %}
        <div class="vm-tile__content">
          {% if block.settings.title != blank %}
            <span class="vm-tile__title">{{ block.settings.title }}</span>
          {% endif %}
          {% if block.settings.cta_text != blank %}
            <span class="vm-tile__cta">{{ block.settings.cta_text }}</span>
          {% endif %}
        </div>
      </a>
      {% liquid
        if size == 'hero'
          assign tile_cells = 2 | times: col_span
        else
          assign tile_cells = col_span
        endif
        assign cells_used = cells_used | plus: tile_cells
      %}
      {% endunless %}
    {% endfor %}
    {% liquid
      assign fill_n = 0
      if vm_featured_row
        assign small_n = section.blocks.size | minus: 1
        if small_n < 0
          assign small_n = 0
        endif
        assign cells_used = 4 | plus: small_n
      endif
      if vm_cols > 1 and cells_used > 0
        assign rem = cells_used | modulo: vm_cols
        if rem > 0
          assign fill_n = vm_cols | minus: rem
        endif
      endif
    %}
    {% if fill_n > 0 %}
      {% for i in (1..fill_n) %}
        <div class="vm-tile vm-tile--sm vm-tile--filler" aria-hidden="true"></div>
      {% endfor %}
    {% endif %}
  </div>
</section>

<style>
  #visual-mosaic-{{ section.id }}.visual-mosaic {
    padding: var(--vm-pad-top, 16px) var(--vm-pad-x, 16px) var(--vm-pad-bottom, 16px);
    background: #fff;
  }
  #visual-mosaic-{{ section.id }} .visual-mosaic__grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: var(--vm-cols-css);
    grid-auto-rows: var(--vm-row-h);
    gap: var(--vm-gap);
  }
  #visual-mosaic-{{ section.id }} .vm-tile {
    position: relative;
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    border-radius: var(--vm-radius, 0px);
    clip-path: inset(0 round var(--vm-radius, 0px));
    display: flex;
    text-decoration: none;
    color: #fff;
    min-height: 0;
    background: #e8e2d8;
    grid-column: span var(--vm-col-span, 1);
  }
  #visual-mosaic-{{ section.id }} .vm-tile--hero {
    grid-row: span 2;
  }
  #visual-mosaic-{{ section.id }} .vm-tile[data-text-color="black"] {
    color: #1c1916;
  }
  #visual-mosaic-{{ section.id }} .vm-tile[data-text-color="black"] .vm-tile__cta {
    color: #1c1916;
    border-color: #1c1916;
    background: rgba(255, 255, 255, 0.55);
  }
  #visual-mosaic-{{ section.id }} .vm-tile[data-content-position="bottom-left"] {
    align-items: flex-end;
    justify-content: flex-start;
  }
  #visual-mosaic-{{ section.id }} .vm-tile[data-content-position="bottom-center"] {
    align-items: flex-end;
    justify-content: center;
  }
  #visual-mosaic-{{ section.id }} .vm-tile[data-content-position="center"] {
    align-items: center;
    justify-content: center;
  }
  #visual-mosaic-{{ section.id }} .vm-tile[data-content-position="top-left"] {
    align-items: flex-start;
    justify-content: flex-start;
  }
  #visual-mosaic-{{ section.id }} .vm-tile img,
  #visual-mosaic-{{ section.id }} .vm-tile video,
  #visual-mosaic-{{ section.id }} .vm-tile__placeholder {
    width: 100%;
    height: 100%;
    object-fit: var(--vm-fit);
    object-position: var(--vm-media-pos, center center);
    display: block;
    position: absolute;
    inset: 0;
    transition: transform 0.45s ease;
  }
  #visual-mosaic-{{ section.id }} .vm-tile__placeholder {
    background: linear-gradient(135deg, #c9c5b8, #e9d3cb);
  }
  #visual-mosaic-{{ section.id }} .vm-tile:hover img,
  #visual-mosaic-{{ section.id }} .vm-tile:hover video {
    transform: scale(1.04);
  }
  #visual-mosaic-{{ section.id }} .vm-tile__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28, 25, 22, 0.05) 30%, rgba(28, 25, 22, 0.72) 100%);
    z-index: 1;
    pointer-events: none;
  }
  #visual-mosaic-{{ section.id }}[data-vm-overlay="off"] .vm-tile__shade {
    display: none;
  }
  #visual-mosaic-{{ section.id }} .vm-tile[data-text-color="black"] .vm-tile__shade {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 30%, rgba(255, 255, 255, 0.55) 100%);
  }
  #visual-mosaic-{{ section.id }} .vm-tile__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: min(340px, calc(100% - 48px));
    margin: 24px;
    pointer-events: none;
  }
  #visual-mosaic-{{ section.id }} .vm-tile[data-content-position="bottom-center"] .vm-tile__content,
  #visual-mosaic-{{ section.id }} .vm-tile[data-content-position="center"] .vm-tile__content {
    align-items: center;
    text-align: center;
  }
  #visual-mosaic-{{ section.id }} .vm-tile__title {
    font-size: 28px;
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 14px;
    letter-spacing: -0.028em;
  }
  #visual-mosaic-{{ section.id }} .vm-tile__cta {
    display: inline-block;
    padding: 11px 18px;
    border: 1px solid #fff;
    color: #fff;
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    text-transform: uppercase;
    background: rgba(28, 25, 22, 0.35);
  }
  #visual-mosaic-{{ section.id }} .vm-tile--sm .vm-tile__content {
    margin: 18px;
    max-width: none;
  }
  #visual-mosaic-{{ section.id }} .vm-tile--sm .vm-tile__title {
    font-size: 20px;
    font-weight: 400;
    margin: 0;
  }
  #visual-mosaic-{{ section.id }} .vm-tile--filler {
    pointer-events: none;
    display: block;
    min-height: var(--vm-row-h);
    height: 100%;
    align-self: stretch;
    background: #ddd8ce;
  }
  @media (max-width: 900px) {
    #visual-mosaic-{{ section.id }} .visual-mosaic__grid {
      grid-template-columns: var(--vm-mob-cols-css);
      grid-auto-rows: var(--vm-mob-h);
    }
    #visual-mosaic-{{ section.id }} .vm-tile--hero {
      grid-column: 1 / -1;
      grid-row: span 1;
      min-height: 280px;
    }
    #visual-mosaic-{{ section.id }} .vm-tile {
      grid-column: span 1;
    }
    #visual-mosaic-{{ section.id }} .vm-tile--filler {
      min-height: var(--vm-mob-h);
    }
  }
  /* iPhone / phone only — one full-width tile per row. Tablet (768–900) stays 2-col. TE mobile_columns unchanged. */
  @media (max-width: 767px) {
    #visual-mosaic-{{ section.id }} .visual-mosaic__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: calc(var(--vm-mob-h) * 1.35);
    }
    #visual-mosaic-{{ section.id }} .vm-tile--hero {
      min-height: 0;
      grid-row: span 1;
    }
    #visual-mosaic-{{ section.id }} .vm-tile--filler {
      min-height: calc(var(--vm-mob-h) * 1.35);
    }
  }
  @media (max-width: 560px) {
    #visual-mosaic-{{ section.id }}.visual-mosaic {
      padding: 12px 12px var(--vm-gap);
    }
    #visual-mosaic-{{ section.id }} .visual-mosaic__grid {
      gap: var(--vm-gap);
    }
    #visual-mosaic-{{ section.id }} .vm-tile__title {
      font-size: 22px;
      margin-bottom: 10px;
    }
    #visual-mosaic-{{ section.id }} .vm-tile--sm .vm-tile__title {
      font-size: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Visual mosaic",
  "tag": "section",
  "class": "section-visual-mosaic",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "featured_layout",
      "label": "Grid",
      "options": [
        {
          "value": "stack_right",
          "label": "1 large + 2 stacked"
        },
        {
          "value": "featured_row",
          "label": "1 large + row under"
        },
        {
          "value": "working",
          "label": "Tall left"
        }
      ],
      "default": "working",
      "info": "1 large + 2 stacked = no row under. Extra tiles stay in the sidebar."
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Dark overlay",
      "default": true,
      "info": "Off = photos only, no gradient."
    },
    {
      "type": "header",
      "content": "Size & space"
    },
    {
      "type": "range",
      "id": "tile_height",
      "label": "Tile height",
      "min": 160,
      "max": 420,
      "step": 4,
      "unit": "px",
      "default": 268
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12,
      "info": "Space between tiles — including the hero photo and the card under it on phone."
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Master Corner Radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 4,
      "info": "One slider. All tiles. 0 = square."
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Pad top",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Pad bottom",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "pad_x",
      "label": "Pad left & right",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "More"
    },
    {
      "type": "select",
      "id": "default_link_target",
      "label": "Default tile link",
      "options": [
        {
          "value": "custom",
          "label": "Custom URL…"
        },
        {
          "value": "#variants",
          "label": "#variants — Shop styles"
        },
        {
          "value": "#knock-socks",
          "label": "#knock-socks — Statement"
        },
        {
          "value": "#reviews",
          "label": "#reviews"
        },
        {
          "value": "#guarantee",
          "label": "#guarantee"
        },
        {
          "value": "#never-loses-grip",
          "label": "#never-loses-grip"
        },
        {
          "value": "#one-pair",
          "label": "#one-pair"
        },
        {
          "value": "#coperni",
          "label": "#coperni"
        },
        {
          "value": "#problem",
          "label": "#problem"
        }
      ],
      "default": "#variants",
      "info": "Used when a tile’s link is set to Default. Homepage anchors jump on the same page."
    },
    {
      "type": "text",
      "id": "default_link_url",
      "label": "Custom default URL",
      "info": "Used when Default tile link = Custom URL…. Full URL, relative path, or #hash."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria label",
      "default": "Studio proof",
      "info": "Screen-reader name only — not visible on the page."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (tall left only)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "Ignored when Grid is 1 large + 2 stacked or 1 large + row under."
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "hero_column_wide",
      "label": "Widen tall-left column",
      "default": true,
      "info": "Only when Grid is Tall left."
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns per row (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1 column (stack)"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "mobile_tile_height",
      "label": "Tile height (mobile)",
      "min": 120,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 180
    },
    {
      "type": "header",
      "content": "Page inset"
    },
    {
      "type": "checkbox",
      "id": "inset_custom_mobile",
      "label": "Custom mobile inset",
      "default": false,
      "info": "OFF (default): ignore the mobile inset sliders — mobile uses desktop Inset top / bottom / left & right. ON: use the mobile inset sliders instead."
    },
    {
      "type": "range",
      "id": "inset_top",
      "label": "Inset top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_bottom",
      "label": "Inset bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x",
      "label": "Inset left & right",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Same value on both sides."
    },
    {
      "type": "range",
      "id": "inset_top_mobile",
      "label": "Inset top — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "range",
      "id": "inset_bottom_mobile",
      "label": "Inset bottom — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x_mobile",
      "label": "Inset left & right — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "header",
          "content": "Shared — Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA label",
          "info": "Optional. Best on Large tiles (Home WORKING: Shop Now)."
        },
        {
          "type": "select",
          "id": "link_target",
          "label": "Tile link",
          "options": [
            {
              "value": "default",
