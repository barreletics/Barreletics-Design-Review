{% comment %}
  Visual mosaic — Home WORKING 2b. Multi-tile lifestyle grid under hero.
{% endcomment %}

<section class="visual-mosaic" aria-label="{{ section.settings.aria_label | default: 'Studio proof' | escape }}">
  <div class="visual-mosaic__grid">
    {% for block in section.blocks %}
      {% liquid
        assign tile_class = 'vm-tile'
        if block.settings.size == 'hero'
          assign tile_class = tile_class | append: ' vm-tile--hero'
        else
          assign tile_class = tile_class | append: ' vm-tile--sm'
        endif
        assign tile_href = block.settings.link | default: section.settings.default_link | default: '#variants'
      %}
      <a class="{{ tile_class }}" href="{{ tile_href }}" {{ block.shopify_attributes }}>
        {% if block.settings.video_url != blank %}
          <video autoplay muted loop playsinline webkit-playsinline preload="metadata"{% if block.settings.poster_url != blank %} poster="{{ block.settings.poster_url | escape }}"{% endif %}>
            <source src="{{ block.settings.video_url | escape }}" type="video/mp4">
          </video>
        {% elsif block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="800"
            height="800"
          >
        {% elsif block.settings.image_url != blank %}
          <img
            src="{{ block.settings.image_url | escape }}"
            alt="{{ block.settings.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="800"
            height="800"
          >
        {% else %}
          <span class="vm-tile__placeholder" aria-hidden="true"></span>
        {% endif %}
        <span class="vm-tile__shade"></span>
        <div class="vm-tile__content">
          {% if block.settings.title != blank %}
            <span class="vm-tile__title">{{ block.settings.title }}</span>
          {% endif %}
          {% if block.settings.cta_text != blank %}
            <span class="vm-tile__cta">{{ block.settings.cta_text }}</span>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>

<style>
  .visual-mosaic { padding: 16px 16px 8px; background: #fff; }
  .visual-mosaic__grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    grid-template-rows: 268px 268px;
    gap: 12px;
  }
  .vm-tile {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    display: block;
    text-decoration: none;
    color: #fff;
    min-height: 200px;
    background: #e8e2d8;
  }
  .vm-tile--hero { grid-row: 1 / span 2; }
  .vm-tile img,
  .vm-tile video,
  .vm-tile__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
    transition: transform 0.45s ease;
  }
  .vm-tile__placeholder {
    background: linear-gradient(135deg, #c9c5b8, #e9d3cb);
  }
  .vm-tile:hover img,
  .vm-tile:hover video { transform: scale(1.04); }
  .vm-tile__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28,25,22,0.05) 30%, rgba(28,25,22,0.72) 100%);
    z-index: 1;
  }
  .vm-tile__content {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: min(340px, calc(100% - 48px));
  }
  .vm-tile__title {
    font-size: 28px;
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 14px;
    letter-spacing: -0.028em;
  }
  .vm-tile__cta {
    display: inline-block;
    padding: 11px 18px;
    border: 1px solid #fff;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgba(28,25,22,0.35);
  }
  .vm-tile--sm .vm-tile__content { left: 18px; bottom: 18px; max-width: none; }
  .vm-tile--sm .vm-tile__title { font-size: 20px; font-weight: 400; margin: 0; }
  @media (max-width: 900px) {
    .visual-mosaic__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
    }
    .vm-tile--hero {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 280px;
    }
    .vm-tile--sm { min-height: 180px; }
  }
  @media (max-width: 560px) {
    .visual-mosaic { padding: 12px 12px 4px; }
    .visual-mosaic__grid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .vm-tile__title { font-size: 22px; margin-bottom: 10px; }
    .vm-tile--sm .vm-tile__title { font-size: 16px; }
  }
</style>

