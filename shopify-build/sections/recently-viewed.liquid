{% comment %}
  Recently Viewed Products Section
  Tracks recently viewed products in localStorage and renders them in a grid.
  On PDP: saves current product. On render: displays up to 4 recent products (excluding current).
  Uses product-card styling rendered client-side from localStorage data.

  Usage: Include in product template JSON or any page where recently viewed should appear.
{% endcomment %}

{%- liquid
  assign utp_y_d_def = 32
  assign utp_side_d_def = 40
  assign utp_y_m_def = 24
  assign utp_x_m_def = 20
  assign utp_style = ''
  assign u_y = section.settings.text_pad_y | default: utp_y_d_def
  if u_y != utp_y_d_def
    assign utp_style = utp_style | append: '--utp-y-d:' | append: u_y | append: 'px;'
  endif
  assign u_side = section.settings.side_padding | default: utp_side_d_def
  if u_side != utp_side_d_def
    assign utp_style = utp_style | append: '--utp-side-d:' | append: u_side | append: 'px;'
  endif
  assign u_y_m = section.settings.text_pad_y_mobile | default: utp_y_m_def
  if u_y_m != utp_y_m_def
    assign utp_style = utp_style | append: '--utp-y-m:' | append: u_y_m | append: 'px;'
  endif
  assign u_x_m = section.settings.text_pad_x_mobile | default: utp_x_m_def
  if u_x_m != utp_x_m_def
    assign utp_style = utp_style | append: '--utp-x-m:' | append: u_x_m | append: 'px;'
  endif
-%}
<section
  class="section recently-viewed"
  data-recently-viewed
  {% if product %}data-current-handle="{{ product.handle }}"{% endif %}
  {% if product %}data-current-product='{{ product | json | escape }}'{% endif %}
  aria-labelledby="recently-viewed-heading"
  style="{{ utp_style }}display:none;"
>
  <div class="section__inner">
    <h2 class="recently-viewed__heading h2-standard" id="recently-viewed-heading">
      {{ section.settings.heading | default: 'Recently Viewed' }}
    </h2>
    <div class="recently-viewed__grid grid grid--4" data-recently-viewed-grid>
    </div>
  </div>
</section>

<style>
  .recently-viewed {
    padding: var(--utp-y-d, var(--section-padding-y)) var(--utp-side-d, var(--section-padding-x));
    border-top: 1px solid var(--color-warm-border);
  }
  .recently-viewed__heading {
    font-size: var(--type-section-size);
    font-weight: var(--type-section-weight);
    line-height: var(--type-section-leading);
    letter-spacing: var(--type-section-tracking);
    text-transform: none;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .recently-viewed__card {
    display: block;
    text-decoration: none;
    color: var(--text-body);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: transform var(--transition-fast);
  }
  .recently-viewed__card:hover {
    transform: translateY(-2px);
    text-decoration: none;
  }
  .recently-viewed__card:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
  .recently-viewed__card-media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-warm-cream);
  }
  .recently-viewed__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .recently-viewed__card-info {
    padding: var(--space-3) 0 0;
  }
  .recently-viewed__card-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-1);
    line-height: var(--leading-snug);
  }
  .recently-viewed__card-price {
    font-size: var(--text-sm);
    color: var(--text-body);
    font-weight: var(--weight-medium);
  }

  @media (max-width: 768px) {
    .recently-viewed {
      padding: var(--utp-y-m, var(--section-padding-y-mobile)) var(--utp-x-m, var(--section-padding-x-mobile));
    }
    .recently-viewed__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .recently-viewed__heading {
      font-size: var(--text-xl);
      margin-bottom: var(--space-6);
    }
  }
</style>

<script>
  (function() {
    var STORAGE_KEY = 'barreletics_recently_viewed';
    var MAX_ITEMS = 8;
    var DISPLAY_LIMIT = 4;

    var section = document.querySelector('[data-recently-viewed]');
    if (!section) return;

    var grid = section.querySelector('[data-recently-viewed-grid]');
    var currentHandle = section.getAttribute('data-current-handle') || '';

    function getItems() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
      } catch (e) {
        return [];
      }
    }

    function saveItems(items) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      } catch (e) {}
    }

    function trackCurrentProduct() {
      var productData = section.getAttribute('data-current-product');
      if (!productData) return;

      try {
        var product = JSON.parse(productData);
        var item = {
          handle: product.handle,
          title: product.title,
          url: product.url,
          price: product.price,
          image: product.featured_image || (product.images && product.images[0]) || ''
        };

        var items = getItems();
        items = items.filter(function(i) { return i.handle !== item.handle; });
        items.unshift(item);
        if (items.length > MAX_ITEMS) items = items.slice(0, MAX_ITEMS);
        saveItems(items);
      } catch (e) {}
    }

    function renderGrid() {
      var items = getItems();
      items = items.filter(function(i) { return i.handle !== currentHandle; });
      items = items.slice(0, DISPLAY_LIMIT);

      if (items.length === 0) return;

      section.style.display = '';

      var html = '';
      items.forEach(function(item) {
        var priceFormatted = typeof item.price === 'number'
          ? '$' + (item.price / 100).toFixed(2)
          : item.price;

        html += '<a href="' + item.url + '" class="recently-viewed__card">';
        html += '<div class="recently-viewed__card-media">';
        if (item.image) {
          html += '<img src="' + item.image + '" alt="' + item.title.replace(/"/g, '&quot;') + '" loading="lazy" width="400" height="400" class="recently-viewed__card-img" />';
        }
        html += '</div>';
        html += '<div class="recently-viewed__card-info">';
        html += '<h3 class="recently-viewed__card-title">' + item.title + '</h3>';
        html += '<p class="recently-viewed__card-price">' + priceFormatted + '</p>';
        html += '</div></a>';
      });

      grid.innerHTML = html;
    }

    trackCurrentProduct();
    renderGrid();
  })();
</script>

{% style %}
  {%- liquid
    assign te_y_d = 32
    assign te_side_d = 40
    assign te_y_m = 24
    assign te_x_m = 20
    assign u_y = section.settings.text_pad_y | default: te_y_d
    assign u_side = section.settings.side_padding | default: te_side_d
    assign u_y_m = section.settings.text_pad_y_mobile | default: te_y_m
    assign u_x_m = section.settings.text_pad_x_mobile | default: te_x_m
  -%}
  {%- if u_y != te_y_d or u_side != te_side_d -%}
  #shopify-section-{{ section.id }} .recently-viewed {
    {%- if u_y != te_y_d -%}
    padding-top: {{ u_y }}px;
    padding-bottom: {{ u_y }}px;
    {%- endif -%}
    {%- if u_side != te_side_d -%}
    padding-left: {{ u_side }}px;
    padding-right: {{ u_side }}px;
    {%- endif -%}
  }
  {%- endif -%}
  {%- if u_y_m != te_y_m or u_x_m != te_x_m -%}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .recently-viewed {
      {%- if u_y_m != te_y_m -%}
      padding-top: {{ u_y_m }}px;
      padding-bottom: {{ u_y_m }}px;
      {%- endif -%}
      {%- if u_x_m != te_x_m -%}
      padding-left: {{ u_x_m }}px;
      padding-right: {{ u_x_m }}px;
      {%- endif -%}
    }
  }
  {%- endif -%}
{% endstyle %}

{% schema %}
{
  "name": "Recently Viewed",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "header",
      "content": "Layout — text padding"
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 32 — theme section gap)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 40)",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 24 — theme section gap)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 20)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed"
    }
  ]
}
{% endschema %}
