{% comment %}
  About page — intro + pull quote (v25 Locked)
{% endcomment %}

<section
  class="page-about-intro"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
  aria-label="{{ section.settings.aria_label | default: 'Our story' | escape }}"
>
  <div class="page-about-intro__inner">
    <h1 class="page-about-intro__title">{{ section.settings.title }}</h1>
    {% if section.settings.lede != blank %}
      <div class="page-about-intro__lede rte">{{ section.settings.lede }}</div>
    {% endif %}
    {% if section.settings.byline != blank %}
      <p class="page-about-intro__byline">{{ section.settings.byline }}</p>
    {% endif %}
    {% if section.settings.pull_quote != blank %}
      <p class="page-about-intro__pull">{{ section.settings.pull_quote }}</p>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .page-about-intro {
    padding: clamp(40px, 8vh, 72px) clamp(20px, 8vw, 8vw) clamp(36px, 6vh, 64px);
    border-bottom: 1px solid var(--line-soft, #e8e2d8);
  }
  #shopify-section-{{ section.id }} .page-about-intro__inner { max-width: 24em; }
  #shopify-section-{{ section.id }} .page-about-intro__title {
    font-size: clamp(56px, 8.5vw, 104px);
    font-weight: 400;
    letter-spacing: -0.038em;
    line-height: 0.96;
    margin: 0 0 24px;
    color: var(--text-primary, #1c1916);
  }
  #shopify-section-{{ section.id }} .page-about-intro__lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-body, #4a4a4a);
    max-width: 36ch;
  }
  #shopify-section-{{ section.id }} .page-about-intro__byline {
    font-size: 15px;
    color: var(--text-muted, #6b645a);
    margin: 16px 0 0;
  }
  #shopify-section-{{ section.id }} .page-about-intro__pull {
    font-size: clamp(32px, 4.6vw, 52px);
    font-weight: 500;
    letter-spacing: -0.032em;
    line-height: 1.08;
    max-width: 14em;
    margin: clamp(28px, 5vh, 44px) 0 0;
    color: var(--text-primary, #1c1916);
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-intro { padding: 32px 20px 28px; }
    #shopify-section-{{ section.id }} .page-about-intro__title {
      font-size: clamp(40px, 10vw, 52px);
      margin-bottom: 16px;
    }
    #shopify-section-{{ section.id }} .page-about-intro__pull {
      font-size: clamp(24px, 6vw, 32px);
      margin-top: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "About — Intro",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Our story" },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Lede",
      "default": "<p>Patented Performance Skins for barre, Pilates, reformer, Megaformer, and studio fitness. Built because grip socks kept failing when grip mattered most.</p>"
    },
    { "type": "text", "id": "byline", "label": "Byline", "default": "Stefanie Miller, Founder" },
    {
      "type": "text",
      "id": "pull_quote",
      "label": "Pull quote",
      "default": "We didn't improve the grip sock. We made it obsolete."
    },
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Our story" }
  ],
  "presets": [{ "name": "About — Intro" }]
}
{% endschema %}
