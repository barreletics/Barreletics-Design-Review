{% comment %}
  About page — intro + pull quote (v25 Locked)
{% endcomment %}

<section
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} page-about-intro"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
  aria-label="{{ section.settings.aria_label | default: 'Our story' | escape }}"
  style="{% render 'section-inset-vars' %}{% if section.settings.bg_color != blank %} background: {{ section.settings.bg_color }};{% endif %} {% render 'type-override-vars', title_size: section.settings.title_size, title_weight: section.settings.title_weight, body_size: section.settings.body_size, body_weight: section.settings.body_weight, sub_size: section.settings.pull_quote_size, sub_weight: section.settings.pull_quote_weight %}"
>
  <div class="page-about-intro__inner">
    <h1 class="page-about-intro__title">{{ section.settings.title }}</h1>
    {% if section.settings.lede != blank %}
      <div class="page-about-intro__lede rte">{{ section.settings.lede }}</div>
    {% endif %}
    {% if section.settings.byline != blank %}
      <p class="page-about-intro__byline">{{ section.settings.byline }}</p>
    {% endif %}
    {% if section.settings.pull_quote != blank %}
      <p class="page-about-intro__pull">{{ section.settings.pull_quote }}</p>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .page-about-intro {
    padding: clamp(40px, 8vh, 72px) clamp(20px, 8vw, 8vw) clamp(36px, 6vh, 64px);
    border-bottom: 1px solid var(--line-soft, #e8e2d8);
  }
  /* Desktop width matches the other content pages (Andrew 2026-09-30): the inner row uses the full
     section width so "Our story" stays on one line; body copy caps at the 760px content-page measure. */
  #shopify-section-{{ section.id }} .page-about-intro__inner { max-width: none; }
  #shopify-section-{{ section.id }} .page-about-intro__title {
    font-size: var(--te-title-size, clamp(56px, 8.5vw, 104px));
    font-weight: var(--te-title-weight, 400);
    letter-spacing: -0.038em;
    line-height: 0.96;
    margin: 0 0 24px;
    color: var(--text-primary, #1c1916);
  }
  #shopify-section-{{ section.id }} .page-about-intro__lede {
    font-size: var(--te-body-size, 18px);
    font-weight: var(--te-body-weight, 400);
    line-height: 1.55;
    color: var(--text-body, #4a4a4a);
    max-width: 760px;
  }
  #shopify-section-{{ section.id }} .page-about-intro__byline {
    font-size: 15px;
    color: var(--text-muted, #6b645a);
    margin: 16px 0 0;
  }
  #shopify-section-{{ section.id }} .page-about-intro__pull {
    font-size: var(--te-sub-size, clamp(32px, 4.6vw, 52px));
    font-weight: var(--te-sub-weight, 500);
    letter-spacing: -0.032em;
    line-height: 1.08;
    max-width: 14em;
    margin: clamp(28px, 5vh, 44px) 0 0;
    color: var(--text-primary, #1c1916);
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-intro { padding: 32px 20px 28px; }
    #shopify-section-{{ section.id }} .page-about-intro__title {
      font-size: var(--te-title-size, clamp(40px, 10vw, 52px));
      margin-bottom: 16px;
    }
    #shopify-section-{{ section.id }} .page-about-intro__pull {
      font-size: var(--te-sub-size, clamp(24px, 6vw, 32px));
      margin-top: 24px;
    }
  }
</style>

