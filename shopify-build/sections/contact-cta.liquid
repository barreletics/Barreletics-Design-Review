{% comment %}
  Contact-primary terminal CTA (R-08) — FAQ closing, not newsletter Subscribe
{% endcomment %}

{%- liquid
  assign utp_y_d_def = 64
  assign utp_side_d_def = 40
  assign utp_y_m_def = 48
  assign utp_x_m_def = 16
  assign utp_style = ''
  assign u_y = section.settings.text_pad_y | default: utp_y_d_def
  if u_y != utp_y_d_def
    assign utp_style = utp_style | append: '--utp-y-d:' | append: u_y | append: 'px;'
  endif
  assign u_side = section.settings.side_padding | default: utp_side_d_def
  if u_side != utp_side_d_def
    assign utp_style = utp_style | append: '--utp-side-d:' | append: u_side | append: 'px;'
  endif
  assign u_y_m = section.settings.text_pad_y_mobile | default: utp_y_m_def
  if u_y_m != utp_y_m_def
    assign utp_style = utp_style | append: '--utp-y-m:' | append: u_y_m | append: 'px;'
  endif
  assign u_x_m = section.settings.text_pad_x_mobile | default: utp_x_m_def
  if u_x_m != utp_x_m_def
    assign utp_style = utp_style | append: '--utp-x-m:' | append: u_x_m | append: 'px;'
  endif
-%}

<section class="contact-cta" aria-label="Contact" style="{{ utp_style }}">
  <div class="contact-cta__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="contact-cta__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="contact-cta__title">{{ section.settings.title }}</h2>
    {% if section.settings.body != blank %}
      <p class="contact-cta__body">{{ section.settings.body }}</p>
    {% endif %}
    {% assign cta_href = section.settings.cta_url | default: '/pages/contact-us-form' %}
    <a class="btn btn--primary contact-cta__btn" href="{{ cta_href }}">
      {{ section.settings.cta_text }}
    </a>
  </div>
</section>

<style>
  .contact-cta {
    padding: var(--utp-y-d, var(--space-13, 64px)) var(--utp-side-d, var(--section-padding-x, 40px));
    border-top: 1px solid var(--border-default, #d6cfc0);
    text-align: center;
  }
  .contact-cta__inner {
    max-width: 560px;
    margin: 0 auto;
  }
  .contact-cta__eyebrow {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8a8a8a;
  }
  .contact-cta__title {
    margin: 0 0 12px;
    font-size: 32px;
    font-weight: 700;
    color: #1c1916;
  }
  .contact-cta__body {
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.6;
    color: #4a4a4a;
  }
  .contact-cta__btn {
    display: inline-block;
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
  }
  @media (max-width: 768px) {
    .contact-cta {
      padding: var(--utp-y-m, 48px) var(--utp-x-m, 16px);
    }
    .contact-cta__title {
      font-size: 28px;
    }
  }
</style>

{% style %}
  {%- liquid
    assign te_y_d = 64
    assign te_side_d = 40
    assign te_y_m = 48
    assign te_x_m = 16
    assign u_y = section.settings.text_pad_y | default: te_y_d
    assign u_side = section.settings.side_padding | default: te_side_d
    assign u_y_m = section.settings.text_pad_y_mobile | default: te_y_m
    assign u_x_m = section.settings.text_pad_x_mobile | default: te_x_m
  -%}
  {%- if u_y != te_y_d or u_side != te_side_d -%}
  #shopify-section-{{ section.id }} .contact-cta {
    {%- if u_y != te_y_d -%}
    padding-top: {{ u_y }}px;
    padding-bottom: {{ u_y }}px;
    {%- endif -%}
    {%- if u_side != te_side_d -%}
    padding-left: {{ u_side }}px;
    padding-right: {{ u_side }}px;
    {%- endif -%}
  }
  {%- endif -%}
  {%- if u_y_m != te_y_m or u_x_m != te_x_m -%}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .contact-cta {
      {%- if u_y_m != te_y_m -%}
      padding-top: {{ u_y_m }}px;
      padding-bottom: {{ u_y_m }}px;
      {%- endif -%}
      {%- if u_x_m != te_x_m -%}
      padding-left: {{ u_x_m }}px;
      padding-right: {{ u_x_m }}px;
      {%- endif -%}
    }
  }
  {%- endif -%}
{% endstyle %}

{% schema %}
{
  "name": "Contact CTA",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Get in touch."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Can't find what you're looking for? Contact us and we'll get back within 24–48 hours."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "header",
      "content": "Layout — text padding"
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 64)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 40)",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 48)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 16)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Contact CTA"
    }
  ]
}
{% endschema %}
