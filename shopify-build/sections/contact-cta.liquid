{% comment %}
  Contact-primary terminal CTA (R-08) — FAQ closing, not newsletter Subscribe
{% endcomment %}

<section class="contact-cta" aria-label="Contact" style="{% render 'unified-text-pads-vars', y_d: 96, side_d: 40, y_m: 80, x_m: 20 %}">
  <div class="contact-cta__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="contact-cta__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="contact-cta__title">{{ section.settings.title }}</h2>
    {% if section.settings.body != blank %}
      <p class="contact-cta__body">{{ section.settings.body }}</p>
    {% endif %}
    {% assign cta_href = section.settings.cta_url | default: '/pages/contact-us-form' %}
    <a class="btn btn--primary contact-cta__btn" href="{{ cta_href }}">
      {{ section.settings.cta_text }}
    </a>
  </div>
</section>

<style>
  .contact-cta {
    padding: var(--space-13, 64px) var(--section-padding-x, 40px);
    border-top: 1px solid var(--border-default, #d6cfc0);
    text-align: center;
  }
  .contact-cta__inner {
    max-width: 560px;
    margin: 0 auto;
  }
  .contact-cta__eyebrow {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8a8a8a;
  }
  .contact-cta__title {
    margin: 0 0 12px;
    font-size: 32px;
    font-weight: 700;
    color: #1c1916;
  }
  .contact-cta__body {
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.6;
    color: #4a4a4a;
  }
  .contact-cta__btn {
    display: inline-block;
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
  }
  @media (max-width: 768px) {
    .contact-cta {
      padding: 48px 16px;
    }
    .contact-cta__title {
      font-size: 28px;
    }
  }
</style>

{% render 'unified-text-pads-te-style', selector: '.section-frame', y_d: 96, side_d: 40, y_m: 80, x_m: 20 %}

{% schema %}
{
  "name": "Contact CTA",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Get in touch."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Can't find what you're looking for? Contact us and we'll get back within 24\u201348 hours."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "header",
      "content": "Layout \u2014 text padding"
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 96)",
      "min": 8,
      "max": 120,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 40)",
      "min": 8,
      "max": 96,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 80)",
      "min": 8,
      "max": 120,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 20)",
      "min": 8,
      "max": 48,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Contact CTA"
    }
  ]
}
{% endschema %}
