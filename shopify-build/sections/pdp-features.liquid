{% comment %}
  PDP Features — Definitive-v19 authority · Title 40/400 · italic Grip · 2×2 grid
{% endcomment %}

{% liquid
  assign title_size = section.settings.title_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign pad_top = section.settings.pad_top | default: 32
  assign pad_bottom = section.settings.pad_bottom | default: 32
  assign pad_top_mobile = section.settings.pad_top_mobile | default: 24
  assign pad_bottom_mobile = section.settings.pad_bottom_mobile | default: 24
%}

<section
  class="pdp-features"
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  aria-label="{{ section.settings.aria_label | default: 'Product features' | escape }}"
  style="{% if title_size != 'default' %}--pf-title-size: {{ title_size }}px;{% endif %}{% if title_weight != 'default' %}--pf-title-weight: {{ title_weight }};{% endif %}{% if body_size != 'default' %}--pf-body-size: {{ body_size }}px;{% endif %}--pf-pad-top: {{ pad_top }}px;--pf-pad-bottom: {{ pad_bottom }}px;--pf-pad-top-m: {{ pad_top_mobile }}px;--pf-pad-bottom-m: {{ pad_bottom_mobile }}px;"
>
  <div class="pdp-features__inner">
    <header class="pdp-features__header">
      {% if section.settings.eyebrow != blank %}
        <p class="pdp-features__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="pdp-features__title">{{ section.settings.title }}</h2>
    </header>

    <div class="pdp-features__grid">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="pdp-feature" {{ block.shopify_attributes }}>
            <p class="pdp-feature__title">{{ block.settings.title }}</p>
            <p class="pdp-feature__desc">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.footnote != blank %}
      <p class="pdp-features__footnote">{{ section.settings.footnote | escape | newline_to_br }}</p>
    {% endif %}

    {% if section.settings.show_disciplines %}
      <div class="pdp-disciplines">
        <p class="pdp-disciplines__label">Built for every discipline</p>
        <div class="pdp-disciplines__strip">
          {% assign disciplines = 'Barre,Reformer,Megaformer,Lagree,Pilates,Yoga' | split: ',' %}
          {% for d in disciplines %}
            {% unless forloop.first %}
              <span class="pdp-disciplines__dot" aria-hidden="true">·</span>
            {% endunless %}
            <span class="pdp-disciplines__name">{{ d }}</span>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .pdp-features {
    padding: var(--pf-pad-top, var(--section-padding-y)) var(--section-padding-x) var(--pf-pad-bottom, var(--section-padding-y));
    background: var(--bg-primary);
    border-top: 1px solid var(--border-default);
    border-bottom: 1px solid var(--border-default);
  }

  .pdp-features__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .pdp-features__header {
    margin-bottom: 32px;
  }

  .pdp-features__eyebrow {
    font-size: var(--type-label-size);
    text-transform: uppercase;
    letter-spacing: var(--type-label-tracking);
    color: var(--type-label-color);
    font-weight: var(--type-label-weight);
    margin: 0 0 var(--gap-a);
  }

  /* H2 Supporting — 40/400 / 1.1 (Type OS). TE size/weight override via CSS vars */
  .pdp-features__title {
    margin: 0;
    max-width: 18ch;
    font-size: var(--pf-title-size, var(--type-h2-supporting-size, 40px));
    font-weight: var(--pf-title-weight, var(--type-h2-supporting-weight, 400));
    line-height: var(--type-h2-supporting-leading, 1.1);
    letter-spacing: var(--type-h2-supporting-tracking, -0.02em);
    color: #1c1916;
  }

  .pdp-features__title strong,
  .pdp-features__title .em {
    font-weight: 400;
    font-style: italic;
    font-size: clamp(28px, 3.5vw, 40px);
    color: #1c1916;
  }

  .pdp-features__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 56px;
  }

  .pdp-feature {
    border-top: 1px solid #d6cfc0;
    padding-top: 24px;
  }

  .pdp-feature__title {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0;
    color: #1c1916;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .pdp-feature__desc {
    font-size: var(--pf-body-size, 16px);
    font-weight: 400;
    color: #6b6459;
    line-height: 1.5;
    margin: 0;
  }

  .pdp-features__footnote {
    margin: 28px 0 0;
    max-width: 62ch;
    font-size: 12px;
    line-height: 1.5;
    color: #8a8a8a;
  }

  .pdp-disciplines {
    margin-top: var(--space-10);
    text-align: center;
  }

  .pdp-disciplines__label {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--text-muted);
    font-weight: var(--type-label-weight);
    margin: 0 0 var(--space-8);
  }

  .pdp-disciplines__strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 8px;
  }

  .pdp-disciplines__name {
    font-size: clamp(12px, 1.3vw, 14px);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4a4a4a;
  }

  .pdp-disciplines__dot {
    font-style: normal;
    font-weight: 400;
    color: #c45c3f;
    margin: 0 6px;
  }

  @media (max-width: 768px) {
    .pdp-features {
      padding: var(--pf-pad-top-m, var(--section-padding-y-mobile)) var(--section-padding-x-mobile) var(--pf-pad-bottom-m, var(--section-padding-y-mobile));
    }

    .pdp-features__grid {
      grid-template-columns: 1fr 1fr;
      gap: 20px 16px;
    }

    .pdp-feature {
      padding-top: 16px;
    }

    .pdp-feature__title {
      font-size: 16px;
    }

    .pdp-feature__desc {
      font-size: 13px;
    }

    .pdp-disciplines__strip {
      gap: 10px 4px;
    }
  }
</style>

{% schema %}
{
  "name": "PDP Features",
  "settings": [
    { "type": "header", "content": "Shared — Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Barreletics" },
    {
      "type": "html",
      "id": "title",
      "label": "Heading (supports HTML)",
      "default": "Built around<br>one obsession: <strong>Grip.</strong>",
      "info": "Family is brand Type OS — use Title size/weight to adjust. No font family picker."
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "24", "label": "24px" },
        { "value": "28", "label": "28px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "56", "label": "56px" }
      ],
      "default": "default",
      "info": "Family is brand Type OS — size only. Default keeps section baseline (40px)."
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body size",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" }
      ],
      "default": "default",
      "info": "Applies to feature descriptions."
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Padding top — desktop",
      "default": 32
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom — desktop",
      "default": 32
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Padding top — phone",
      "default": 24
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom — phone",
      "default": 24
    },
    { "type": "header", "content": "Section — PDP features" },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote under features",
      "info": "Optional. Use with a * in a feature line (e.g. Outdoor surface note). Leave blank to hide."
    },
    {
      "type": "checkbox",
      "id": "show_disciplines",
      "label": "Show discipline tags",
      "default": false,
      "info": "Barre · Reformer · Megaformer · Lagree · Pilates · Yoga. Leave OFF on PDP."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section aria-label",
      "default": "Product features",
      "info": "Accessibility name for screen readers — not visible on the page."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Optional jump target (e.g. no-socks). Leave blank on PDP."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "header", "content": "Shared — Content" },
        { "type": "text", "id": "title", "label": "Heading", "default": "360° Grip" },
        { "type": "textarea", "id": "description", "label": "Body", "default": "Every direction. Every movement." }
      ]
    }
  ],
  "presets": [{
    "name": "PDP Features",
    "blocks": [
      { "type": "feature", "settings": { "title": "360° Grip", "description": "Every direction. Every movement." } },
      { "type": "feature", "settings": { "title": "Secure in Every Hold", "description": "No slipping. No resets." } },
      { "type": "feature", "settings": { "title": "Stay in the Flow", "description": "No adjusting. No distractions." } },
      { "type": "feature", "settings": { "title": "Built to Last", "description": "Class 1 to class 1,000." } }
    ]
  }]
}
{% endschema %}
