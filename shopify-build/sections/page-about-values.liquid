{% comment %}
  About page — What we stand for (v25 Locked · 2-col grid)
{% endcomment %}

<section
  class="page-about-values"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="page-about-values__inner">
    {% if section.settings.heading != blank %}
      <div class="page-about-values__head">
        <h2 class="page-about-values__title">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}
    <div class="page-about-values__grid">
      {% for block in section.blocks %}
        {% if block.type == 'value' %}
          <div class="page-about-values__card" {{ block.shopify_attributes }}>
            <h3 class="page-about-values__card-title">{{ block.settings.title }}</h3>
            <p class="page-about-values__card-body">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .page-about-values {
    padding: clamp(56px, 10vh, 96px) clamp(20px, 8vw, 8vw);
    border-top: 1px solid var(--line-soft, #e8e2d8);
    border-bottom: 1px solid var(--line-soft, #e8e2d8);
    background: #fff;
  }
  #shopify-section-{{ section.id }} .page-about-values__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .page-about-values__head {
    max-width: 20em;
    margin: 0 0 clamp(28px, 5vh, 40px);
  }
  #shopify-section-{{ section.id }} .page-about-values__title {
    font-size: clamp(40px, 5.2vw, 64px);
    font-weight: 400;
    letter-spacing: -0.036em;
    line-height: 1.02;
    margin: 0;
    color: var(--text-primary, #1c1916);
  }
  #shopify-section-{{ section.id }} .page-about-values__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 3vw, 28px);
  }
  #shopify-section-{{ section.id }} .page-about-values__card {
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--line-soft, #e8e2d8);
    border-radius: 4px;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .page-about-values__card-title {
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 500;
    letter-spacing: -0.022em;
    line-height: 1.15;
    margin: 0 0 8px;
    color: var(--text-primary, #1c1916);
  }
  #shopify-section-{{ section.id }} .page-about-values__card-body {
    font-size: 16px;
    line-height: 1.68;
    color: var(--text-body, #4a4a4a);
    margin: 0;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-values { padding: 40px 20px; }
    #shopify-section-{{ section.id }} .page-about-values__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "About — Values",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we stand for" },
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "What we stand for" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Values",
      "blocks": [
        { "type": "value", "settings": { "title": "Performance over promise", "description": "Every claim we make is backed by the product itself. Injection-molded grip that never peels. Materials that never absorb. Results you can feel from day one." } },
        { "type": "value", "settings": { "title": "Category creation", "description": "We're not competing in the grip sock market — we're replacing it. Performance Skins are a new category of studio footwear built from first principles." } },
        { "type": "value", "settings": { "title": "Durability as design", "description": "Products should outlast the hype cycle. Many customers report 3–4 years of daily use. One purchase replaces years of disposable socks." } },
        { "type": "value", "settings": { "title": "Commitment match", "description": "You show up 6 days a week. Your gear should match that commitment. Built for people who take their practice seriously." } },
        { "type": "value", "settings": { "title": "Studio-first", "description": "Designed for the demands of real studio environments — reformer carriages, Megaformer platforms, barre floors. Every detail serves the practice." } }
      ]
    }
  ]
}
{% endschema %}
