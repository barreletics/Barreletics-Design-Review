{% comment %}
  About page — What we stand for (v25 Locked · 2-col grid)
{% endcomment %}

{%- liquid
  assign pav_y_d_def = 40
  assign pav_side_d_def = 20
  assign pav_y_m_def = 40
  assign pav_x_m_def = 20
  assign pav_fixed_d_y = false
  if section.settings.text_pad_y != pav_y_d_def
    assign pav_fixed_d_y = true
  endif
  assign pav_fixed_d_x = false
  if section.settings.side_padding != pav_side_d_def
    assign pav_fixed_d_x = true
  endif
  assign pav_fixed_m_y = false
  if section.settings.text_pad_y_mobile != pav_y_m_def
    assign pav_fixed_m_y = true
  endif
  assign pav_fixed_m_x = false
  if section.settings.text_pad_x_mobile != pav_x_m_def
    assign pav_fixed_m_x = true
  endif
-%}
<section
  class="page-about-values{% if pav_fixed_d_y %} page-about-values--fixed-pad-d-y{% endif %}{% if pav_fixed_d_x %} page-about-values--fixed-pad-d-x{% endif %}{% if pav_fixed_m_y %} page-about-values--fixed-pad-m-y{% endif %}{% if pav_fixed_m_x %} page-about-values--fixed-pad-m-x{% endif %}"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
  aria-label="{{ section.settings.aria_label | escape }}"
  style="{% render 'unified-text-pads-vars', y_d: 40, side_d: 20, y_m: 40, x_m: 20 %}{% render 'type-override-vars', title_size: section.settings.title_size, title_weight: section.settings.title_weight, body_size: section.settings.body_size, body_weight: section.settings.body_weight, sub_size: section.settings.card_title_size, sub_weight: section.settings.card_title_weight %}"
>
  <div class="page-about-values__inner">
    {% if section.settings.heading != blank %}
      <div class="page-about-values__head">
        <h2 class="page-about-values__title">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}
    <div class="page-about-values__grid">
      {% for block in section.blocks %}
        {% if block.type == 'value' %}
          <div class="page-about-values__card" {{ block.shopify_attributes }}>
            <h3 class="page-about-values__card-title">{{ block.settings.title }}</h3>
            <p class="page-about-values__card-body">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .page-about-values {
    padding: clamp(56px, 10vh, 96px) clamp(20px, 8vw, 8vw);
    border-top: 1px solid var(--line-soft, #e8e2d8);
    border-bottom: 1px solid var(--line-soft, #e8e2d8);
    background: #fff;
  }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .page-about-values--fixed-pad-d-y {
      padding-top: var(--utp-y-d);
      padding-bottom: var(--utp-y-d);
    }
    #shopify-section-{{ section.id }} .page-about-values--fixed-pad-d-x {
      padding-left: var(--utp-side-d);
      padding-right: var(--utp-side-d);
    }
  }
  #shopify-section-{{ section.id }} .page-about-values__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .page-about-values__head {
    max-width: 20em;
    margin: 0 0 clamp(28px, 5vh, 40px);
  }
  #shopify-section-{{ section.id }} .page-about-values__title {
    font-size: var(--te-title-size, clamp(40px, 5.2vw, 64px));
    font-weight: var(--te-title-weight, 400);
    letter-spacing: -0.036em;
    line-height: 1.02;
    margin: 0;
    color: var(--text-primary, #1c1916);
  }
  #shopify-section-{{ section.id }} .page-about-values__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 3vw, 28px);
  }
  #shopify-section-{{ section.id }} .page-about-values__card {
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--line-soft, #e8e2d8);
    border-radius: 4px;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .page-about-values__card-title {
    font-size: var(--te-sub-size, clamp(20px, 2.2vw, 26px));
    font-weight: var(--te-sub-weight, 500);
    letter-spacing: -0.022em;
    line-height: 1.15;
    margin: 0 0 8px;
    color: var(--text-primary, #1c1916);
  }
  #shopify-section-{{ section.id }} .page-about-values__card-body {
    font-size: var(--te-body-size, 16px);
    font-weight: var(--te-body-weight, 400);
    line-height: 1.68;
    color: var(--text-body, #4a4a4a);
    margin: 0;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-values { padding: 40px 20px; }
    #shopify-section-{{ section.id }} .page-about-values--fixed-pad-m-y {
      padding-top: var(--utp-y-m);
      padding-bottom: var(--utp-y-m);
    }
    #shopify-section-{{ section.id }} .page-about-values--fixed-pad-m-x {
      padding-left: var(--utp-x-m);
      padding-right: var(--utp-x-m);
    }
    #shopify-section-{{ section.id }} .page-about-values__grid { grid-template-columns: 1fr; }
  }
</style>

{% render 'unified-text-pads-te-style', selector: '.page-about-values', y_d: 40, side_d: 20, y_m: 40, x_m: 20 %}

