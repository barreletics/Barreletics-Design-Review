      padding: var(--section-padding-y-mobile) var(--section-padding-x-mobile);
    }

    #shopify-section-{{ section.id }} .variants-head {
      margin-bottom: 28px;
    }

    #shopify-section-{{ section.id }} .variants-toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 12px 0;
    }

