{% comment %}
  Variant Grid — streamlined (2026-07-30)

  Capability kept from br-variants / all-variants:
  - Choose which of Open / Closed / One-Offs / Outdoor tabs show
  - Populate each tab from a product picker (variants → cards) — same model as live KEEP logic
  - Size M/L filter, Compare + Size chart, 2-row + See all (VARIANTS-GRID.md)

  Simplified vs old br-variants (~4.5k lines) and early stub:
  - No Theme Editor junk (fonts, paddings, badge color sprawl)
  - No product_4/product_5 dual one-off pickers — one One-Offs product
  - No hardcoded all_products fallbacks that forced every tab on
  - No tag-filter from a mega-collection
  - One panel snippet + one card snippet; one lean JS (tabs / size / see-all)
  - Header chrome locked (Andrew approved)
{% endcomment %}

{%- comment -%}
  PDP mode: only when Theme Editor toggle is on AND Liquid `product` exists
  (product templates). Homepage / collection have no current product — toggle
  is ignored so tabs + product pickers keep working.
{%- endcomment -%}
{%- liquid
  assign use_current = false
  if section.settings.use_current_product and product != blank and request.page_type == 'product'
    assign use_current = true
  endif

  assign max_variants = section.settings.max_variants | default: 48
  assign initial_rows = section.settings.initial_rows | default: 2
  assign see_all_mode = section.settings.see_all | default: 'expand'
  assign show_all_tab = section.settings.show_all_tab
  assign title_size = section.settings.title_size | default: 'default'
  assign body_size = section.settings.body_size | default: 'default'
  assign title_weight = section.settings.title_weight | default: 'default'
  assign card_messaging = section.settings.card_messaging | default: 'meta'

  if use_current
    assign show_closed = true
    assign show_open = false
    assign show_oneoffs = false
    assign show_outdoor = false
    assign product_closed = product
    assign product_open = nil
    assign product_oneoffs = nil
    assign product_outdoor = nil
    assign show_all_tab = false
    assign default_tab = 'all'

    assign sole_for_current = ''
    assign title_d = product.title | downcase
    assign handle_d = product.handle | downcase
    # One-off BEFORE open-sole — handles like one-off-colors-open-sole contain "open-sole"
    if title_d contains 'coperni' or handle_d contains 'coperni' or title_d contains 'one-off' or title_d contains 'one off' or handle_d contains 'one-off'
      assign sole_for_current = 'One-Off'
    elsif title_d contains 'outdoor' or handle_d contains 'aquatic' or handle_d contains 'outdoor'
      assign sole_for_current = 'Outdoor'
    elsif title_d contains 'open sole' or handle_d contains 'open-sole' or handle_d contains 'open_sole' or handle_d contains 'studio-performance'
      assign sole_for_current = 'Open Sole'
    elsif title_d contains 'closed sole' or handle_d contains 'closed' or handle_d contains 'reformer' or handle_d contains 'legree'
      assign sole_for_current = 'Closed Sole'
    endif
  else
    assign show_closed = section.settings.show_closed
    assign show_open = section.settings.show_open
    assign show_oneoffs = section.settings.show_oneoffs
    assign show_outdoor = section.settings.show_outdoor
    assign product_closed = section.settings.product_closed
    assign product_open = section.settings.product_open
    assign product_oneoffs = section.settings.product_oneoffs
    assign product_outdoor = section.settings.product_outdoor

    unless show_closed
      assign product_closed = nil
    endunless
    unless show_open
      assign product_open = nil
    endunless
    unless show_oneoffs
      assign product_oneoffs = nil
    endunless
    unless show_outdoor
      assign product_outdoor = nil
    endunless

    # One-off PDPs: keep Closed/Open/Outdoor tabs (shop-all) like Closed Sole.
    # One-Offs tab = THIS product (not theme picker / not core Open Sole misroute).
    assign _oo_pdp = false
    if request.page_type == 'product' and product != blank
      assign _oo_sfx = template.suffix | downcase
      assign _oo_h = product.handle | downcase
      assign _oo_t = product.title | downcase
      if _oo_sfx == 'one-off-open' or _oo_sfx == 'one-off-closed' or _oo_sfx == 'one-off' or _oo_sfx == 'coperni' or _oo_h contains 'one-off' or _oo_t contains 'one-off' or _oo_t contains 'one off' or _oo_h contains 'coperni' or _oo_t contains 'coperni'
        assign _oo_pdp = true
        if show_oneoffs
          assign product_oneoffs = product
        endif
      endif
    endif

    # Theme settings → One-off colors wins (same product as nav + quiet link)
    # Skip on one-off PDPs so Open/Closed one-off pages keep their own One-Offs catalog.
    if show_oneoffs and settings.one_off_product != blank and _oo_pdp == false
      assign oo_ref = settings.one_off_product
      assign oo_handle = oo_ref.handle | default: oo_ref
      assign product_oneoffs = all_products[oo_handle]
      if product_oneoffs == blank
        assign product_oneoffs = oo_ref
      endif
    endif

    assign default_tab = section.settings.default_tab | default: 'closed'

    # PDP category wins: template suffix → product identity → TE default_tab
    # One-off BEFORE open-sole — handles like one-off-colors-open-sole contain "open-sole"
    if request.page_type == 'product' and product != blank
      assign _vg_title = product.title | downcase
      assign _vg_handle = product.handle | downcase
      assign _vg_type = product.type | downcase
      assign _vg_suffix = template.suffix | downcase
      assign _vg_tags = product.tags | join: ',' | downcase
      if _vg_suffix == 'outdoor' or _vg_handle contains 'aquatic' or _vg_handle contains 'outdoor' or _vg_title contains 'water shoe' or _vg_title contains 'outdoor' or _vg_type contains 'outdoor' or _vg_tags contains 'outdoor'
        assign default_tab = 'outdoor'
      elsif _vg_suffix == 'one-off-open' or _vg_suffix == 'one-off-closed' or _vg_suffix == 'one-off' or _vg_suffix == 'coperni' or _vg_title contains 'coperni' or _vg_handle contains 'coperni' or _vg_title contains 'one-off' or _vg_title contains 'one off' or _vg_handle contains 'one-off'
        if product_oneoffs != blank
          assign default_tab = 'oneoffs'
        else
          assign default_tab = 'closed'
        endif
      elsif _vg_suffix == 'open-sole' or _vg_title contains 'open sole' or _vg_handle contains 'open-sole' or _vg_handle contains 'open_sole' or _vg_handle contains 'studio-performance'
        assign default_tab = 'open'
      elsif _vg_suffix == blank or _vg_suffix == 'product' or _vg_title contains 'closed sole' or _vg_handle contains 'closed-sole' or _vg_handle contains 'reformer' or _vg_handle contains 'legree'
        assign default_tab = 'closed'
      endif
    endif

    if default_tab == 'closed' and product_closed == blank
      assign default_tab = 'open'
    endif
    if default_tab == 'open' and product_open == blank
      assign default_tab = 'oneoffs'
    endif
    if default_tab == 'oneoffs' and product_oneoffs == blank
      assign default_tab = 'outdoor'
    endif
    if default_tab == 'outdoor' and product_outdoor == blank
      if product_closed != blank
        assign default_tab = 'closed'
      elsif product_open != blank
        assign default_tab = 'open'
      elsif product_oneoffs != blank
        assign default_tab = 'oneoffs'
      elsif show_all_tab
        assign default_tab = 'all'
      endif
    endif
  endif

  assign label_closed = section.settings.label_closed | default: 'Closed Sole'
  assign label_open = section.settings.label_open | default: 'Open Sole'
  assign label_oneoffs = section.settings.label_oneoffs | default: 'One-Offs'
  assign label_outdoor = section.settings.label_outdoor | default: 'Outdoor'
  assign vg_anchor = section.settings.anchor_id | default: 'variants' | handleize
-%}

<section
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} variants-section"
  id="{{ vg_anchor }}"
  aria-label="Shop all styles"
  data-variants-collapse
  data-size-filter="{% if section.settings.show_size_filter != false %}on{% else %}off{% endif %}"
  data-initial-rows="{{ initial_rows }}"
  data-see-all="{{ see_all_mode }}"
  data-variants-expanded="false"
  data-default-tab="{{ default_tab }}"
  style="{% render 'section-inset-vars' %} 
    {% if title_size != 'default' %}--vg-title-size: {{ title_size }}px;{% endif %}
    {% if body_size != 'default' %}--vg-body-size: {{ body_size }}px;{% endif %}
    {% if title_weight != 'default' %}--vg-title-weight: {{ title_weight }};{% endif %}
  "
>
  <div class="variants-inner">
    <header class="variants-head align-editorial">
      {% if section.settings.eyebrow != blank %}
        <p class="variants-head__eyebrow type-label eyebrow--accent">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="variants-head__title h2-standard">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="variants-head__body type-body">{{ section.settings.body }}</p>
      {% endif %}
    </header>

    <div class="variants-toolbar{% if use_current %} variants-toolbar--pdp{% endif %}">
      {% unless use_current %}
        <div class="variants-tabs" role="tablist">
          {% if show_all_tab %}
            <button type="button" class="variants-tab{% if default_tab == 'all' %} is-active{% endif %}" role="tab" aria-selected="{% if default_tab == 'all' %}true{% else %}false{% endif %}" data-tab="all">All</button>
          {% endif %}
          {% if product_closed != blank %}
            <button type="button" class="variants-tab{% if default_tab == 'closed' %} is-active{% endif %}" role="tab" aria-selected="{% if default_tab == 'closed' %}true{% else %}false{% endif %}" data-tab="closed">{{ label_closed }}</button>
          {% endif %}
          {% if product_open != blank %}
            <button type="button" class="variants-tab{% if default_tab == 'open' %} is-active{% endif %}" role="tab" aria-selected="{% if default_tab == 'open' %}true{% else %}false{% endif %}" data-tab="open">{{ label_open }}</button>
          {% endif %}
          {% if product_oneoffs != blank %}
            <button type="button" class="variants-tab{% if default_tab == 'oneoffs' %} is-active{% endif %}" role="tab" aria-selected="{% if default_tab == 'oneoffs' %}true{% else %}false{% endif %}" data-tab="oneoffs">{{ label_oneoffs }}</button>
          {% endif %}
          {% if product_outdoor != blank %}
            <button type="button" class="variants-tab{% if default_tab == 'outdoor' %} is-active{% endif %}" role="tab" aria-selected="{% if default_tab == 'outdoor' %}true{% else %}false{% endif %}" data-tab="outdoor">{{ label_outdoor }}</button>
          {% endif %}
        </div>
      {% else %}
        <p class="variants-pdp-note">{{ product.title | escape }} — colors &amp; sizes</p>
      {% endunless %}
      <div class="variants-utils">
        {% if section.settings.show_size_filter != false %}
          <div class="variants-size" data-variants-size>
            <span class="variants-size__label">Size</span>
            <button type="button" class="variants-size__btn is-active" data-size="M">M</button>
            <button type="button" class="variants-size__btn" data-size="L">L</button>
          </div>
        {% endif %}
        {% if section.settings.show_utility_links != false %}
          {%- comment -%} /pages/size-chart 404s; the real page is performance-skins-size-chart. {%- endcomment -%}
          <a href="{{ section.settings.size_chart_url | default: '/pages/performance-skins-size-chart' }}" class="variants-link">Size chart →</a>
          {% if section.settings.show_compare_link != false %}
            <a href="{{ section.settings.compare_url | default: '/pages/compare-open-closed-sole' }}" class="variants-link">Compare →</a>
          {% endif %}
        {% endif %}
      </div>
    </div>

    {%- if use_current and product_closed != blank -%}
      {% render 'variant-grid-panel',
        product: product_closed,
        sole_label: sole_for_current,
        tab_key: 'all',
        max_variants: max_variants,
        is_default: true,
        messaging_style: card_messaging
      %}
    {%- else -%}
      {%- liquid
        assign def_all = false
        if default_tab == 'all'
          assign def_all = true
        endif
        assign def_closed = def_all
        assign def_open = def_all
        assign def_oneoffs = def_all
        assign def_outdoor = def_all
        if default_tab == 'closed'
          assign def_closed = true
        elsif default_tab == 'open'
          assign def_open = true
        elsif default_tab == 'oneoffs'
          assign def_oneoffs = true
        elsif default_tab == 'outdoor'
          assign def_outdoor = true
        endif
      -%}
      {% if product_closed != blank %}
        {% render 'variant-grid-panel',
          product: product_closed,
          sole_label: label_closed,
          tab_key: 'closed',
          max_variants: max_variants,
          is_default: def_closed,
          messaging_style: card_messaging
        %}
      {% endif %}
      {% if product_open != blank %}
        {% render 'variant-grid-panel',
          product: product_open,
          sole_label: label_open,
          tab_key: 'open',
          max_variants: max_variants,
          is_default: def_open,
          messaging_style: card_messaging
        %}
      {% endif %}
      {% if product_oneoffs != blank %}
        {% render 'variant-grid-panel',
          product: product_oneoffs,
          sole_label: label_oneoffs,
          tab_key: 'oneoffs',
          max_variants: max_variants,
          is_default: def_oneoffs,
          messaging_style: card_messaging
        %}
      {% endif %}
      {% if product_outdoor != blank %}
        {% render 'variant-grid-panel',
          product: product_outdoor,
          sole_label: label_outdoor,
          tab_key: 'outdoor',
          max_variants: max_variants,
          is_default: def_outdoor,
          messaging_style: card_messaging
        %}
      {% endif %}
    {%- endif -%}

    {%- assign see_all_label = section.settings.see_all_label | default: 'See all colors & styles' -%}
    {%- if see_all_mode == 'expand' -%}
      <div class="variants-see-all">
        <button
          type="button"
          class="variants-see-all__btn"
          data-variants-see-all
          data-see-all-label="{{ see_all_label | escape }}"
          data-see-more-label="See more"
          aria-expanded="false"
        >{{ see_all_label | escape }}</button>
      </div>
    {%- elsif see_all_mode == 'link' and section.settings.see_all_url != blank -%}
      <div class="variants-see-all">
        <a href="{{ section.settings.see_all_url }}" class="variants-see-all__btn">{{ see_all_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .variants-section {
    padding: var(--section-padding-y) var(--section-padding-x);
    background: var(--bg-primary);
  }

  #shopify-section-{{ section.id }} .variants-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .variants-head {
    text-align: left;
    margin-bottom: var(--space-9);
  }

  #shopify-section-{{ section.id }} .variants-head__eyebrow {
    margin: 0 0 var(--gap-a);
    color: var(--type-label-color);
  }

  #shopify-section-{{ section.id }} .variants-head__title {
    /* Type OS H2 Standard — class on element; TE size override optional */
    font-size: var(--vg-title-size, var(--type-section-size));
    font-weight: var(--vg-title-weight, var(--type-section-weight));
    line-height: var(--type-section-leading);
    letter-spacing: var(--type-section-tracking);
    margin: 0 0 var(--gap-a);
  }

  #shopify-section-{{ section.id }} .variants-head__body {
    max-width: 48ch;
    margin: 0;
    font-size: var(--vg-body-size, var(--type-body-size));
    font-weight: var(--type-body-weight);
    line-height: var(--type-body-leading);
  }

  #shopify-section-{{ section.id }} .variants-toolbar {
    border-top: 1px solid var(--border-default);
    border-bottom: 1px solid var(--border-default);
    padding: 14px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-9);
  }

  #shopify-section-{{ section.id }} .variants-tabs {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .variants-tab {
    padding: 10px 24px;
    font-size: 12px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--bg-primary);
    border: 1px solid var(--border-default);
    cursor: pointer;
    border-radius: var(--radius-button);
    font-family: inherit;
    transition: all var(--transition-fast);
  }

  #shopify-section-{{ section.id }} .variants-tab.is-active {
    color: var(--color-white);
    background: var(--color-charcoal);
    border-color: var(--color-charcoal);
  }

  #shopify-section-{{ section.id }} .variants-utils {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  #shopify-section-{{ section.id }} .variants-size {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  #shopify-section-{{ section.id }} .variants-size__label {
    font-size: 12px;
    font-weight: var(--type-label-weight);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-primary);
  }

  #shopify-section-{{ section.id }} .variants-size__btn {
    font-size: 12px;
    font-weight: var(--weight-bold);
    padding: 7px 14px;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-badge);
    letter-spacing: 0.04em;
    font-family: inherit;
    color: var(--text-muted);
    background: var(--bg-alternate);
    transition: all var(--transition-fast);
  }

  #shopify-section-{{ section.id }} .variants-size__btn.is-active {
    color: var(--color-white);
    background: var(--color-charcoal);
  }

  #shopify-section-{{ section.id }} .variants-link {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-warm-border);
    padding-bottom: 1px;
  }

  #shopify-section-{{ section.id }} .var-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 28px;
    row-gap: 56px;
  }

  #shopify-section-{{ section.id }} .var-grid.is-grid-hidden {
    display: none !important;
  }

  /* One-Offs: same 4-up grid as other tabs (available first, then sold-out — no group bands). */
  #shopify-section-{{ section.id }} .var-grid--oneoffs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 28px;
    row-gap: 56px;
  }

  #shopify-section-{{ section.id }} .var-card {
    display: flex;
    flex-direction: column;
    border: 1px solid #e8e2d8;
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.2s;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .var-card:hover {
    box-shadow: 0 4px 16px rgba(28, 25, 22, 0.08);
  }

  #shopify-section-{{ section.id }} .var-card--sold-out {
    opacity: 0.5;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .var-card__img {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f5f2ec;
    position: relative;
    display: block;
  }

  #shopify-section-{{ section.id }} .var-card__imglink {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .var-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  #shopify-section-{{ section.id }} .var-card__img:hover img {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .var-card__img--muted {
    filter: grayscale(0.4);
  }

  #shopify-section-{{ section.id }} .var-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: #8a8a8a;
  }

  #shopify-section-{{ section.id }} .var-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 2px;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .var-card__badge--le {
    background: #458CD9;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .var-card__badge--soldout {
    background: #1c1916;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .var-card__badge--sole {
    top: auto;
    bottom: 10px;
    left: 10px;
    background: rgba(28, 25, 22, 0.72);
    color: #fff;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 4px 8px;
  }

  #shopify-section-{{ section.id }} .var-card__content {
    padding: 18px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .var-card__eyebrow {
    margin: 0 0 2px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c45c3f;
  }

  #shopify-section-{{ section.id }} .var-card__name {
    font-size: 18px;
    font-weight: 700;
    color: #1c1916;
    margin: 0;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .var-card__name a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .var-card__name a:hover {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .var-card__meta {
    font-size: 12px;
    font-weight: 400;
    color: var(--text-muted, #8a8a8a);
    margin: 0;
  }

  /* A · Meta — soft light-grey chip under color name (Home WORKING size-chip tone) */
  #shopify-section-{{ section.id }} .var-card--msg-meta .var-card__meta {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #6b645a;
    background: #f0efec;
    padding: 4px 10px;
    border-radius: 3px;
    margin: 2px 0 0;
  }

  #shopify-section-{{ section.id }} .var-card__meta--soft {
    font-size: 11px;
    color: #6b645a;
  }

  #shopify-section-{{ section.id }} .variants-pdp-note {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  #shopify-section-{{ section.id }} .variants-toolbar--pdp {
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .var-card__price {
    font-size: 16px;
    font-weight: 700;
    color: #1c1916;
    margin: 4px 0 0;
  }

  #shopify-section-{{ section.id }} .var-card__installment {
    font-size: 12px;
    color: #8a8a8a;
    margin: 2px 0 0;
  }

  #shopify-section-{{ section.id }} .var-card__form {
    width: 100%;
    margin-top: 12px;
  }

