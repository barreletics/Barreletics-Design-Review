<script>
  (function () {
    var section = document.getElementById('{{ vg_anchor }}');
    if (!section) return;

    var activeSize = 'M';
    var resizeT;

    function cols() {
      return window.matchMedia('(max-width: 1024px)').matches ? 2 : 4;
    }

    function limitFor() {
      var rows = parseInt(section.getAttribute('data-initial-rows') || '2', 10) || 2;
      return rows * cols();
    }

    function grids() {
      return section.querySelectorAll('.var-grid');
    }

    function activeGrid() {
      var list = grids();
      for (var i = 0; i < list.length; i++) {
        if (!list[i].classList.contains('is-grid-hidden')) return list[i];
      }
      return list[0] || null;
    }

    function isOneoffsGrid(grid) {
      return !!(grid && grid.getAttribute('data-grid-tab') === 'oneoffs');
    }

    function cardsInGrid(grid) {
      if (!grid) return [];
      return Array.prototype.slice.call(grid.querySelectorAll('.var-card'));
    }

    function visibleCardsOf(grid) {
      return cardsInGrid(grid).filter(function (el) {
        return !el.classList.contains('is-size-hidden');
      });
    }

    function ensureVisibleLimit() {
      if (!section.getAttribute('data-visible-limit')) {
        section.setAttribute('data-visible-limit', String(limitFor()));
      }
    }

    function resetVisibleLimit() {
      section.setAttribute('data-visible-limit', String(limitFor()));
      section.setAttribute('data-variants-expanded', 'false');
    }

    function applySizeFilter() {
      var sizeFilterOn = section.getAttribute('data-size-filter') !== 'off';
      section.querySelectorAll('.var-card').forEach(function (card) {
        if (!sizeFilterOn) {
          card.classList.remove('is-size-hidden');
          return;
        }
        var size = (card.getAttribute('data-br-size') || 'M').toUpperCase();
        card.classList.toggle('is-size-hidden', size !== activeSize);
      });
    }

    function applyCollapse() {
      var mode = section.getAttribute('data-see-all') || 'expand';
      var baseLimit = limitFor();
      ensureVisibleLimit();
      var wrap = section.querySelector('.variants-see-all');
      var btn = section.querySelector('[data-variants-see-all]');
      var grid = activeGrid();
      var oneoffs = isOneoffsGrid(grid);

      grids().forEach(function (g) {
        var expanded =
          !isOneoffsGrid(g) &&
          (section.getAttribute('data-variants-expanded') === 'true' || mode === 'off');
        var limit = isOneoffsGrid(g)
          ? parseInt(section.getAttribute('data-visible-limit') || String(baseLimit), 10) || baseLimit
          : baseLimit;
        var visibleIdx = 0;
        cardsInGrid(g).forEach(function (card) {
          if (card.classList.contains('is-size-hidden')) {
            card.classList.add('is-variants-hidden');
            return;
          }
          var show = mode === 'off' || expanded || visibleIdx < limit;
          card.classList.toggle('is-variants-hidden', !show);
          visibleIdx++;
        });
      });

      var total = visibleCardsOf(grid).length;
      var shownLimit = oneoffs
        ? parseInt(section.getAttribute('data-visible-limit') || String(baseLimit), 10) || baseLimit
        : baseLimit;
      var expandedAll =
        !oneoffs &&
        (section.getAttribute('data-variants-expanded') === 'true' || mode === 'off');
      var needs = mode !== 'off' && total > (expandedAll ? total : shownLimit) && !expandedAll;
      if (oneoffs) {
        needs = mode !== 'off' && total > shownLimit;
      }
      if (wrap) {
        if (needs) wrap.removeAttribute('hidden');
        else wrap.setAttribute('hidden', '');
      }
      if (btn && mode === 'expand') {
        if (oneoffs) {
          btn.setAttribute('aria-expanded', 'false');
          btn.textContent = btn.getAttribute('data-see-more-label') || 'See more';
        } else {
          var open = section.getAttribute('data-variants-expanded') === 'true';
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          var openLabel = btn.getAttribute('data-see-all-label') || 'See all colors & styles';
          btn.textContent = open ? 'Show fewer' : openLabel;
        }
      }
    }

    function switchTab(tab) {
      resetVisibleLimit();
      grids().forEach(function (grid) {
        var key = grid.getAttribute('data-grid-tab');
        grid.classList.toggle('is-grid-hidden', !(tab === 'all' || key === tab));
      });
      section.querySelectorAll('.variants-tab').forEach(function (t) {
        var on = t.getAttribute('data-tab') === tab;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      applyCollapse();
    }

    section.querySelectorAll('.variants-tab').forEach(function (tab) {
      tab.addEventListener('click', function () {
        switchTab(tab.getAttribute('data-tab'));
      });
    });

    section.querySelectorAll('[data-size]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeSize = btn.getAttribute('data-size');
        section.querySelectorAll('[data-size]').forEach(function (b) {
          b.classList.toggle('is-active', b === btn);
        });
        resetVisibleLimit();
        applySizeFilter();
        applyCollapse();
      });
    });

    var seeBtn = section.querySelector('[data-variants-see-all]');
    if (seeBtn && (section.getAttribute('data-see-all') || 'expand') === 'expand') {
      seeBtn.addEventListener('click', function () {
        var grid = activeGrid();
        if (isOneoffsGrid(grid)) {
          var cur = parseInt(section.getAttribute('data-visible-limit') || String(limitFor()), 10) || limitFor();
          section.setAttribute('data-visible-limit', String(cur + cols()));
        } else {
          var open = section.getAttribute('data-variants-expanded') === 'true';
          section.setAttribute('data-variants-expanded', open ? 'false' : 'true');
        }
        applyCollapse();
      });
    }

    resetVisibleLimit();
    applySizeFilter();
    applyCollapse();
    window.addEventListener('resize', function () {
      clearTimeout(resizeT);
      resizeT = setTimeout(function () {
        var grid = activeGrid();
        if (isOneoffsGrid(grid)) {
          var cur = parseInt(section.getAttribute('data-visible-limit') || '0', 10) || 0;
          var min = limitFor();
          if (cur < min) section.setAttribute('data-visible-limit', String(min));
        }
        applyCollapse();
      }, 120);
    });
  })();
</script>

