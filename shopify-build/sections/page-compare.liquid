{% comment %}
  Page Compare — Open Sole vs Closed Sole
  Used on: page.compare.json · page.compare-open-vs-closed.json
  Page handle: /pages/compare-open-closed-sole
{% endcomment %}

{%- assign product_a = section.settings.product_a -%}
{%- assign product_b = section.settings.product_b -%}
{%- assign img_a = section.settings.product_a_image -%}
{%- assign img_b = section.settings.product_b_image -%}
{%- if img_a == blank and product_a != blank and product_a.featured_media -%}
  {%- assign img_a = product_a.featured_media.preview_image -%}
{%- endif -%}
{%- if img_b == blank and product_b != blank and product_b.featured_media -%}
  {%- assign img_b = product_b.featured_media.preview_image -%}
{%- endif -%}
{%- assign url_a = section.settings.product_a_url -%}
{%- if url_a == blank and product_a != blank -%}{%- assign url_a = product_a.url -%}{%- endif -%}
{%- assign url_b = section.settings.product_b_url -%}
{%- if url_b == blank and product_b != blank -%}{%- assign url_b = product_b.url -%}{%- endif -%}

<section class="section page-compare" id="shopify-section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="section__inner section__inner--narrow page-compare__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="page-compare__title">{{ section.settings.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="page-compare__subtitle type-lede">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
</section>

<section class="section page-compare__products">
  <div class="section__inner">
    <div class="page-compare__visual">
      <div class="page-compare__product">
        <div class="page-compare__product-image">
          {% if img_a != blank %}
            {{ img_a
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '480, 720, 1200',
                sizes: '(max-width: 768px) 90vw, 40vw',
                class: 'page-compare__img',
                alt: section.settings.product_a_name
            }}
          {% else %}
            <div class="page-compare__placeholder">{{ section.settings.product_a_name }}</div>
          {% endif %}
        </div>
        <h2 class="page-compare__product-name type-statement">{{ section.settings.product_a_name }}</h2>
        <p class="page-compare__product-desc type-body">{{ section.settings.product_a_desc }}</p>
        {% if url_a != blank %}
          {% render 'button', label: section.settings.product_a_cta, url: url_a, style: 'primary' %}
        {% endif %}
      </div>
      <div class="page-compare__vs type-statement" aria-hidden="true">vs</div>
      <div class="page-compare__product">
        <div class="page-compare__product-image">
          {% if img_b != blank %}
            {{ img_b
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '480, 720, 1200',
                sizes: '(max-width: 768px) 90vw, 40vw',
                class: 'page-compare__img',
                alt: section.settings.product_b_name
            }}
          {% else %}
            <div class="page-compare__placeholder">{{ section.settings.product_b_name }}</div>
          {% endif %}
        </div>
        <h2 class="page-compare__product-name type-statement">{{ section.settings.product_b_name }}</h2>
        <p class="page-compare__product-desc type-body">{{ section.settings.product_b_desc }}</p>
        {% if url_b != blank %}
          {% render 'button', label: section.settings.product_b_cta, url: url_b, style: 'primary' %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<section class="section page-compare__table-section">
  <div class="section__inner">
    <div class="page-compare__table-wrap">
      <table class="page-compare__table type-body" role="table" aria-label="Feature comparison: {{ section.settings.product_a_name }} vs {{ section.settings.product_b_name }}">
        <thead>
          <tr>
            <th scope="col" class="page-compare__th page-compare__th--feature">Feature</th>
            <th scope="col" class="page-compare__th">{{ section.settings.product_a_name }}</th>
            <th scope="col" class="page-compare__th">{{ section.settings.product_b_name }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'feature_row' %}
              <tr {{ block.shopify_attributes }}>
                <td class="page-compare__td page-compare__td--feature">{{ block.settings.feature }}</td>
                <td class="page-compare__td">{{ block.settings.value_a }}</td>
                <td class="page-compare__td">{{ block.settings.value_b }}</td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>

  </div>
</section>

{% if section.settings.shared_note != blank or section.settings.bottom_cta_label != blank %}
<section class="section page-compare__close">
  <div class="section__inner section__inner--narrow page-compare__close-inner">
    {% if section.settings.shared_note != blank %}
      <p class="page-compare__shared-text type-body">{{ section.settings.shared_note }}</p>
    {% endif %}
    {% if section.settings.bottom_cta_label != blank %}
      {% render 'button',
        label: section.settings.bottom_cta_label,
        url: section.settings.bottom_cta_url | default: '/collections/all',
        style: 'brand',
        size: 'lg'
      %}
    {% endif %}
  </div>
</section>
{% endif %}

<style>
  /* Layout + color only — type comes from Type OS classes
     eyebrow → .eyebrow (label 11)
     title → page H1 law clamp(32–44)/400 (Help/FAQ family)
     subtitle/desc/table/shared → .type-body (16)
     product name → .type-statement (28–36)
     vs → .type-label (11) */
  /* Rhythm aligned to Help/FAQ content pages */
  .page-compare.section {
    padding-top: 72px;
    padding-bottom: 8px;
  }
  .page-compare__intro { text-align: center; }
  .page-compare__intro .eyebrow {
    margin: 0 0 16px;
  }
  .page-compare__products.section {
    padding-top: var(--section-padding-y, 32px);
    padding-bottom: var(--section-padding-y, 32px);
  }
  .page-compare__table-section.section {
    padding-top: var(--section-padding-y, 32px);
    padding-bottom: var(--section-padding-y, 32px);
  }
  .page-compare__close.section {
    padding-top: var(--section-padding-y, 32px);
    padding-bottom: var(--section-padding-y, 32px);
  }
  @media (max-width: 768px) {
    .page-compare.section {
      padding-top: 48px;
      padding-bottom: 4px;
    }
    .page-compare__products.section,
    .page-compare__table-section.section,
    .page-compare__close.section {
      padding-top: var(--section-padding-y-mobile, 24px);
      padding-bottom: var(--section-padding-y-mobile, 24px);
    }
  }
  /* Help-family page H1 — planning/help-family-type-law.md */
  .page-compare__title {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.028em;
    text-transform: none;
    color: var(--text-primary, #1c1916);
    text-align: center;
    margin: 0 0 20px;
  }
  @media (max-width: 768px) {
    .page-compare__title { font-size: clamp(28px, 8vw, 36px); }
  }
  .page-compare__subtitle {
    text-align: center;
    margin: 0 auto;
    max-width: 42ch;
  }
  .page-compare__visual {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: stretch;
    width: 100%;
  }
  .page-compare__product {
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
  }
  .page-compare__product .btn {
    margin-top: auto;
    min-height: var(--type-cta-min-height, 44px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .page-compare__product-desc {
    flex: 1 1 auto;
    margin: 0 auto 20px;
    max-width: 34ch;
  }
  .page-compare__product-image {
    width: 100%;
    max-width: 100%;
    margin: 0 0 20px;
    aspect-ratio: 1;
    overflow: hidden;
    background: transparent;
    position: relative;
    z-index: 0;
  }
  .page-compare__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: transparent;
  }
  .page-compare__placeholder {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    background: var(--bg-alternate-soft, #faf8f6);
    border-radius: var(--radius-card, 8px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .page-compare__vs {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    text-transform: lowercase;
    flex-shrink: 0;
    padding: 0 8px;
    position: relative;
    z-index: 1;
  }
  .page-compare__product-name { margin: 0 0 8px; }
  .page-compare__table-section { background: #fff; }
  .page-compare__table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .page-compare__table {
    width: 100%;
    border-collapse: collapse;
  }
  .page-compare__th {
    padding: 14px 16px;
    text-align: left;
    font-weight: 500;
    color: var(--text-primary);
    border-bottom: 1px solid var(--text-primary);
    background: var(--bg-alternate-soft, #faf8f6);
  }
  .page-compare__th--feature { width: 28%; }
  .page-compare__td {
    padding: 14px 16px;
    border-bottom: 1px solid #ebe6dc;
    color: var(--text-body);
    line-height: var(--type-body-leading, 1.5);
    vertical-align: top;
  }
  .page-compare__td--feature {
    font-weight: 500;
    color: var(--text-primary);
  }
  .page-compare__close {
    background: var(--bg-alternate-soft, #faf8f6);
  }
  .page-compare__close-inner {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto;
  }
  .page-compare__shared-text {
    margin: 0 auto 32px;
    max-width: 38ch;
  }
  @media (max-width: 768px) {
    .page-compare__visual {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .page-compare__vs { text-align: center; }
    .page-compare__th,
    .page-compare__td { padding: 12px 8px; }
  }
</style>

{% schema %}
{
  "name": "Compare Page",
  "tag": "div",
  "class": "page-compare-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Two versions. One performance."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Open Sole vs Closed Sole"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Both perform identically — same grip, same stability. The difference is feel and coverage only."
    },
    {
      "type": "header",
      "content": "Product A — Open Sole"
    },
    {
      "type": "product",
      "id": "product_a",
      "label": "Product A (pulls image + URL)"
    },
    {
      "type": "image_picker",
      "id": "product_a_image",
      "label": "Product A image override"
    },
    {
      "type": "text",
      "id": "product_a_name",
      "label": "Product A name",
      "default": "Open Sole"
    },
    {
      "type": "textarea",
      "id": "product_a_desc",
      "label": "Product A description",
      "default": "Heel exposed, mid-foot breathing hole. More grounded, barefoot feel. Natural toe splay."
    },
    {
      "type": "text",
      "id": "product_a_cta",
      "label": "Product A CTA",
      "default": "Shop Open Sole"
    },
    {
      "type": "url",
      "id": "product_a_url",
      "label": "Product A link override"
    },
    {
      "type": "header",
      "content": "Product B — Closed Sole"
    },
    {
      "type": "product",
      "id": "product_b",
      "label": "Product B (pulls image + URL)"
    },
    {
      "type": "image_picker",
      "id": "product_b_image",
      "label": "Product B image override"
    },
    {
      "type": "text",
      "id": "product_b_name",
      "label": "Product B name",
      "default": "Closed Sole"
    },
    {
      "type": "textarea",
      "id": "product_b_desc",
      "label": "Product B description",
      "default": "Heel and foot fully covered. Same grip, same stability."
    },
    {
      "type": "text",
      "id": "product_b_cta",
      "label": "Product B CTA",
      "default": "Shop Closed Sole"
    },
    {
      "type": "url",
      "id": "product_b_url",
      "label": "Product B link override"
    },
    {
      "type": "header",
      "content": "Shared + bottom CTA"
    },
    {
      "type": "textarea",
      "id": "shared_note",
      "label": "Shared features note",
      "default": "Both deliver the same molded 360° full-contact grip, the same stability, and natural toe splay. Choice is preference and feel only.",
      "info": "Leave blank to hide."
    },
    {
      "type": "text",
      "id": "bottom_cta_heading",
      "label": "Bottom CTA heading",
      "default": "Not sure? Start with the pair that matches your feel."
    },
    {
      "type": "text",
      "id": "bottom_cta_label",
      "label": "Bottom CTA label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "bottom_cta_url",
      "label": "Bottom CTA URL"
    }
  ],
  "blocks": [
    {
      "type": "feature_row",
      "name": "Feature Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature name" },
        { "type": "text", "id": "value_a", "label": "Product A value" },
        { "type": "text", "id": "value_b", "label": "Product B value" }
      ]
    }
  ],
  "presets": [{ "name": "Compare Page" }]
}
{% endschema %}
