{% comment %}
  Studio trust — Home WORKING 14b. Replaces state GEO accordion on Home.
  Optional GEO accordion blocks keep FAQPage structured data when used.
{% endcomment %}

{%- liquid
  assign y_d = 48
  assign side_d = 40
  assign y_m = 40
  assign x_m = 16
  assign emit_y_d = false
  if section.settings.text_pad_y != blank and section.settings.text_pad_y != y_d
    assign emit_y_d = true
  endif
  assign emit_side_d = false
  if section.settings.side_padding != blank and section.settings.side_padding != side_d
    assign emit_side_d = true
  endif
  assign emit_y_m = false
  if section.settings.text_pad_y_mobile != blank and section.settings.text_pad_y_mobile != y_m
    assign emit_y_m = true
  endif
  assign emit_x_m = false
  if section.settings.text_pad_x_mobile != blank and section.settings.text_pad_x_mobile != x_m
    assign emit_x_m = true
  endif
-%}

<section class="studio-trust" aria-label="Studio trust">
  <p class="studio-trust__line type-statement">{{ section.settings.title }}</p>
  {% if section.settings.subhead != blank %}
    <p class="studio-trust__sub">{{ section.settings.subhead }}</p>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="studio-trust__geo">
      {% for block in section.blocks %}
        {% if block.type == 'geo_item' %}
          <details class="studio-trust__item" {{ block.shopify_attributes }}>
            <summary class="studio-trust__trigger">{{ block.settings.question }}</summary>
            <div class="studio-trust__answer">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

{% assign geo_count = 0 %}
{% for block in section.blocks %}
  {% if block.type == 'geo_item' %}
    {% assign geo_count = geo_count | plus: 1 %}
  {% endif %}
{% endfor %}
{% if geo_count > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for block in section.blocks %}
          {% if block.type == 'geo_item' %}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | json }}
              }
            }{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

<style>
  .studio-trust {
    padding: 48px 40px;
    background: #faf8f6;
    text-align: center;
    border-top: 1px solid #e8e2d8;
  }
  .studio-trust__line {
    color: var(--text-primary);
    margin: 0 0 var(--gap-a);
  }
  .studio-trust__sub {
    font-size: var(--type-body-size);
    font-weight: var(--type-body-weight);
    line-height: var(--type-body-leading);
    color: var(--text-warm-muted);
    margin: 0;
  }
  .studio-trust__geo {
    max-width: 720px;
    margin: 32px auto 0;
    text-align: left;
  }
  .studio-trust__item {
    border-top: 1px solid #d6cfc0;
  }
  .studio-trust__item:last-child {
    border-bottom: 1px solid #d6cfc0;
  }
  .studio-trust__trigger {
    cursor: pointer;
    list-style: none;
    padding: 14px 0;
    font-size: 14px;
    font-weight: 600;
    color: #1c1916;
  }
  .studio-trust__trigger::-webkit-details-marker { display: none; }
  .studio-trust__answer {
    padding: 0 0 16px;
    font-size: 14px;
    color: #4a4a4a;
    line-height: 1.55;
  }
  @media (max-width: 768px) {
    .studio-trust { padding: 40px 16px; }
  }
</style>

{%- if emit_y_d or emit_side_d or emit_y_m or emit_x_m -%}
{% style %}
  {%- if emit_y_d or emit_side_d -%}
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .studio-trust {
      {%- if emit_y_d -%}
      padding-top: {{ section.settings.text_pad_y }}px;
      padding-bottom: {{ section.settings.text_pad_y }}px;
      {%- endif -%}
      {%- if emit_side_d -%}
      padding-left: {{ section.settings.side_padding }}px;
      padding-right: {{ section.settings.side_padding }}px;
      {%- endif -%}
    }
  }
  {%- endif -%}
  {%- if emit_y_m or emit_x_m -%}
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .studio-trust {
      {%- if emit_y_m -%}
      padding-top: {{ section.settings.text_pad_y_mobile }}px;
      padding-bottom: {{ section.settings.text_pad_y_mobile }}px;
      {%- endif -%}
      {%- if emit_x_m -%}
      padding-left: {{ section.settings.text_pad_x_mobile }}px;
      padding-right: {{ section.settings.text_pad_x_mobile }}px;
      {%- endif -%}
    }
  }
  {%- endif -%}
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Studio trust",
  "settings": [
    {
      "type": "header",
      "content": "Shared — Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trusted by 1,000's of instructors & studios."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Body",
      "default": "Dig into deep lunges and every position—endless grip that breathes."
    },
    {
      "type": "header",
      "content": "Section — Studio trust — GEO"
    },
    {
      "type": "paragraph",
      "content": "GEO Q&A items are blocks below (lives in studio-trust per contract)."
    },
    {
      "type": "header",
      "content": "Layout — text padding"
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 48)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 40)",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 40)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 16)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "geo_item",
      "name": "GEO item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question / location"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio trust"
    }
  ]
}
{% endschema %}
