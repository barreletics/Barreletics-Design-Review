{% comment %}
  Studio trust — Home WORKING 14b. Replaces state GEO accordion on Home.
  Optional GEO accordion blocks keep FAQPage structured data when used.
{% endcomment %}

<section class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} studio-trust" aria-label="Studio trust" style="{% render 'section-inset-vars' %}">
  <p class="studio-trust__line type-statement">{{ section.settings.title }}</p>
  {% if section.settings.subhead != blank %}
    <p class="studio-trust__sub">{{ section.settings.subhead }}</p>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="studio-trust__geo">
      {% for block in section.blocks %}
        {% if block.type == 'geo_item' %}
          <details class="studio-trust__item" {{ block.shopify_attributes }}>
            <summary class="studio-trust__trigger">{{ block.settings.question }}</summary>
            <div class="studio-trust__answer">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

{% assign geo_count = 0 %}
{% for block in section.blocks %}
  {% if block.type == 'geo_item' %}
    {% assign geo_count = geo_count | plus: 1 %}
  {% endif %}
{% endfor %}
{% if geo_count > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for block in section.blocks %}
          {% if block.type == 'geo_item' %}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | json }}
              }
            }{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

<style>
  .studio-trust {
    padding: 48px 40px;
    background: #faf8f6;
    text-align: center;
    border-top: 1px solid #e8e2d8;
  }
  .studio-trust__line {
    color: var(--text-primary);
    margin: 0 0 var(--gap-a);
  }
  .studio-trust__sub {
    font-size: var(--type-body-size);
    font-weight: var(--type-body-weight);
    line-height: var(--type-body-leading);
    color: var(--text-warm-muted);
    margin: 0;
  }
  .studio-trust__geo {
    max-width: 720px;
    margin: 32px auto 0;
    text-align: left;
  }
  .studio-trust__item {
    border-top: 1px solid #d6cfc0;
  }
  .studio-trust__item:last-child {
    border-bottom: 1px solid #d6cfc0;
  }
  .studio-trust__trigger {
    cursor: pointer;
    list-style: none;
    padding: 14px 0;
    font-size: 14px;
    font-weight: 600;
    color: #1c1916;
  }
  .studio-trust__trigger::-webkit-details-marker { display: none; }
  .studio-trust__answer {
    padding: 0 0 16px;
    font-size: 14px;
    color: #4a4a4a;
    line-height: 1.55;
  }
  @media (max-width: 768px) {
    .studio-trust { padding: 40px 16px; }
  }
</style>

{% schema %}
{
  "name": "Studio trust",
  "settings": [
        { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf8f6" },
{ "type": "header", "content": "Shared — Content" },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trusted by 1,000's of instructors & studios."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Body",
      "default": "Dig into deep lunges and every position—endless grip that breathes."
    },
    { "type": "header", "content": "Section — Studio trust — GEO" },
    { "type": "paragraph", "content": "GEO Q&A items are blocks below (lives in studio-trust per contract)." },

    {
      "type": "header",
      "content": "Shared — Section frame"
    },
    {
      "type": "paragraph",
      "content": "OUTER inset from the page edges (margin). Top and bottom are independent; left & right = one control. Custom mobile OFF = mobile uses the same inset as desktop. Defaults 0 = full bleed."
    },
    {
      "type": "checkbox",
      "id": "inset_custom_mobile",
      "label": "Custom mobile inset",
      "default": false,
      "info": "OFF (default): ignore the mobile inset sliders — mobile uses desktop Inset top / bottom / left & right. ON: use the mobile inset sliders instead."
    },
    {
      "type": "range",
      "id": "inset_top",
      "label": "Inset top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_bottom",
      "label": "Inset bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x",
      "label": "Inset left & right",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Same value on both sides."
    },
    {
      "type": "range",
      "id": "inset_top_mobile",
      "label": "Inset top — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "range",
      "id": "inset_bottom_mobile",
      "label": "Inset bottom — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x_mobile",
      "label": "Inset left & right — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "geo_item",
      "name": "GEO item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question / location" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "Studio trust" }]
}
{% endschema %}
