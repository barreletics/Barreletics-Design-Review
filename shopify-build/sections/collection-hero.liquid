{% comment %}
  Collection hero — Collection Definitive-v18 Locked
  Split: trust + H1 + body + CTAs | media (inset default | column fill)
  Optional sole cards OFF by default (v15+ shop-first; tabs + FAQ only)
{% endcomment %}

{%- liquid
  assign media_type = section.settings.media_type | default: 'image'
  assign media_fill = section.settings.media_fill | default: 'inset'
  assign min_height = section.settings.min_height
  if min_height == blank
    assign min_height = section.settings.media_height | default: 480
  endif
  assign image = section.settings.image
  assign image_url = section.settings.image_url
  assign image_mobile = section.settings.image_mobile
  assign text_spacing_mobile = section.settings.text_spacing_mobile | default: 36
  assign text_height_mobile = section.settings.text_height_mobile | default: 0
  assign aspect_ratio_mobile = section.settings.aspect_ratio_mobile | default: 'natural'
  assign image_fit_mobile = section.settings.image_fit_mobile | default: 'cover'
  assign video_fit_mobile = section.settings.video_fit_mobile | default: 'cover'
  comment
    Collection hero mobile default is the photo’s own ratio — not 50/50 3:4.
  endcomment
  assign qa_frame = false
  if template == 'collection'
    assign qa_frame = true
  endif
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign image_alt = section.settings.image_alt | default: section.settings.title
  assign has_media = false
  if video != blank or video_url != blank or image != blank or image_url != blank
    assign has_media = true
  endif
  assign reverse = section.settings.reverse | default: false
  assign section_gap = section.settings.section_gap | default: 0
  assign section_gap_m = section.settings.section_gap_mobile | default: 0
  assign show_trust_strip = section.settings.show_trust_strip
  if show_trust_strip == nil
    assign show_trust_strip = section.settings.show_trust
  endif
  if show_trust_strip == nil
    assign show_trust_strip = true
  endif
  assign cta_style = section.settings.cta_style | default: 'rust_solid'
  if cta_style == 'solid'
    assign cta_style = 'rust_solid'
  elsif cta_style == 'outline'
    assign cta_style = 'rust_outline'
  endif
  case cta_style
    when 'rust_outline', 'outline'
      assign cta_btn_class = 'btn--brand-outline'
    when 'black_solid', 'primary'
      assign cta_btn_class = 'btn--primary'
    when 'black_outline', 'secondary'
      assign cta_btn_class = 'btn--secondary'
    else
      assign cta_btn_class = 'btn--brand'
  endcase
  assign media_pct = section.settings.media_column_pct | default: 48
  if media_pct < 35
    assign media_pct = 35
  endif
  assign text_pct = 100 | minus: media_pct
  assign img_zoom = section.settings.image_zoom | default: 100
  if img_zoom < 100
    assign img_zoom = 100
  endif
  assign media_h = min_height
  assign layout_class = 'coll-hero'
  if has_media
    assign layout_class = 'coll-hero coll-hero--split'
  endif
-%}

<section
  class="{{ layout_class }}{% if reverse %} coll-hero--reverse{% endif %}{% render 'split-mobile-stack-class', mobile_stack_order: section.settings.mobile_stack_order %}"
  {{ section.shopify_attributes }}
  data-media-fill="{{ media_fill }}"
  aria-label="{{ section.settings.aria_label | default: 'Collection hero' | escape }}"
  style="{% render 'unified-text-pads-vars', y_d: 56, side_d: 40, y_m: 36, x_m: 20, legacy_y_m: section.settings.text_spacing_mobile %}--ch-text: {{ text_pct }}fr; --ch-media: {{ media_pct }}fr; --ch-zoom: {{ img_zoom | times: 0.01 }}; --ch-media-h: {{ media_h }}px;"
>
  <div class="coll-hero__copy">
    {% if show_trust_strip and section.settings.trust_text != blank %}
      <p class="coll-hero__trust">
        <span class="coll-hero__stars" aria-hidden="true">★★★★★</span>
        {{ section.settings.trust_text }}
      </p>
    {% elsif section.settings.eyebrow != blank %}
      <p class="coll-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    <h1 class="coll-hero__title type-hero">{{ section.settings.title | default: collection.title }}</h1>

    {% if section.settings.body != blank %}
      <div class="coll-hero__body">{{ section.settings.body }}</div>
    {% elsif collection.description != blank %}
      <div class="coll-hero__body">{{ collection.description }}</div>
    {% endif %}

    {% if section.settings.cta_text != blank or section.settings.secondary_cta_text != blank %}
      <div class="coll-hero__actions">
        {% if section.settings.cta_text != blank %}
          <a class="btn {{ cta_btn_class }} coll-hero__cta" href="{{ section.settings.cta_url | default: '#grid' }}">{{ section.settings.cta_text }}</a>
        {% endif %}
        {% if section.settings.secondary_cta_text != blank %}
          <a class="coll-hero__link" href="{{ section.settings.secondary_cta_url | default: '#pose' }}">{{ section.settings.secondary_cta_text }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% if has_media %}
    <div class="coll-hero__media" data-media-type="{% if video != blank or video_url != blank %}video{% else %}image{% endif %}" data-media-fill="{{ media_fill }}" data-mobile-ratio="{{ aspect_ratio_mobile }}">
      {%- if video != blank -%}
        {{
          video
          | video_tag:
            image_size: '1600x',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            class: 'coll-hero__video'
        }}
      {%- elsif video_url != blank -%}
        <video class="coll-hero__video" autoplay muted loop playsinline webkit-playsinline preload="metadata"{% if image != blank %} poster="{{ image | image_url: width: 1600 }}"{% elsif image_url != blank %} poster="{{ image_url | escape }}"{% endif %}>
          <source src="{{ video_url | escape }}" type="video/mp4">
        </video>
      {%- elsif image != blank -%}
        {%- if image_mobile != blank -%}
          <picture>
            <source
              media="(max-width: 768px)"
              srcset="{{ image_mobile | image_url: width: 800 }} 800w, {{ image_mobile | image_url: width: 1200 }} 1200w"
              sizes="100vw"
              width="{{ image_mobile.width }}"
              height="{{ image_mobile.height }}"
            >
            <img
              src="{{ image | image_url: width: 1600 }}"
              srcset="{{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w"
              sizes="(max-width: 768px) 100vw, 45vw"
              alt="{{ image_alt | escape }}"
              loading="eager"
              width="{{ image.width | default: 1200 }}"
              height="{{ image.height | default: 1500 }}"
            >
          </picture>
        {%- else -%}
          <img
            src="{{ image | image_url: width: 1600 }}"
            srcset="{{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w"
            sizes="(max-width: 768px) 100vw, 45vw"
            alt="{{ image_alt | escape }}"
            loading="eager"
            width="{{ image.width | default: 1200 }}"
            height="{{ image.height | default: 1500 }}"
          >
        {%- endif -%}
      {%- elsif image_url != blank -%}
        {%- if image_mobile != blank -%}
          <picture>
            <source
              media="(max-width: 768px)"
              srcset="{{ image_mobile | image_url: width: 800 }} 800w, {{ image_mobile | image_url: width: 1200 }} 1200w"
              sizes="100vw"
              width="{{ image_mobile.width }}"
              height="{{ image_mobile.height }}"
            >
            <img
              src="{{ image_url | escape }}"
              alt="{{ image_alt | escape }}"
              loading="eager"
              width="1200"
              height="1500"
            >
          </picture>
        {%- else -%}
          <img
            src="{{ image_url | escape }}"
            alt="{{ image_alt | escape }}"
            loading="eager"
            width="1200"
            height="1500"
          >
        {%- endif -%}
      {%- endif -%}
    </div>
  {% endif %}

  {% if section.settings.show_sole_cards %}
    {% assign closed_href = section.settings.closed_url | default: '/products/best-reformer-pilates-legree-workout-shoes' %}
    {% assign open_href = section.settings.open_url | default: '/products/studio-performance-skin-footwear' %}
    <div class="sole-cards">
      <a class="sole-card" href="{{ closed_href }}">
        {% if section.settings.closed_image != blank %}
          <div class="sole-card__img">
            <img
              src="{{ section.settings.closed_image | image_url: width: 600 }}"
              alt="Closed Sole"
              loading="eager"
              width="300"
              height="169"
            >
          </div>
        {% endif %}
        <span class="sole-card__tag">Full Coverage</span>
        <h3 class="sole-card__title">Closed Sole</h3>
        {% if section.settings.closed_best_for != blank %}
          <p class="sole-card__best">Pick this if: {{ section.settings.closed_best_for }}</p>
        {% endif %}
        <p class="sole-card__desc">{{ section.settings.closed_desc }}</p>
        <span class="sole-card__cta">Shop Closed Sole →</span>
      </a>
      <a class="sole-card" href="{{ open_href }}">
        {% if section.settings.open_image != blank %}
          <div class="sole-card__img">
            <img
              src="{{ section.settings.open_image | image_url: width: 600 }}"
              alt="Open Sole"
              loading="eager"
              width="300"
              height="169"
            >
          </div>
        {% endif %}
        <span class="sole-card__tag">Barefoot Feel</span>
        <h3 class="sole-card__title">Open Sole</h3>
        {% if section.settings.open_best_for != blank %}
          <p class="sole-card__best">Pick this if: {{ section.settings.open_best_for }}</p>
        {% endif %}
        <p class="sole-card__desc">{{ section.settings.open_desc }}</p>
        <span class="sole-card__cta">Shop Open Sole →</span>
      </a>
    </div>
  {% endif %}
</section>

<style>
  #shopify-section-{{ section.id }} {
    --ch-text: {{ text_pct }}fr;
    --ch-media: {{ media_pct }}fr;
    --ch-zoom: {{ img_zoom | times: 0.01 }};
    --ch-media-h: {{ media_h }}px;
  }
  #shopify-section-{{ section.id }} .coll-hero,
  #shopify-section-{{ section.id }}.coll-hero {
    padding: var(--space-13, 72px) var(--section-padding-x, 40px) var(--space-9, 40px);
    max-width: var(--max-width, 1200px);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .coll-hero--split,
  #shopify-section-{{ section.id }}.coll-hero--split {
    display: grid;
    grid-template-columns: var(--ch-text, 52fr) var(--ch-media, 48fr);
    gap: 40px;
    align-items: center;
    padding: var(--utp-y-d, 56px) var(--utp-side-d, 40px) 40px;
  }
  #shopify-section-{{ section.id }} .coll-hero--split.coll-hero--reverse {
    direction: rtl;
  }
  #shopify-section-{{ section.id }} .coll-hero--split.coll-hero--reverse > * {
    direction: ltr;
  }
  #shopify-section-{{ section.id }} .coll-hero--split {
    padding-top: var(--utp-y-d, 56px);
    padding-bottom: var(--utp-y-d, 56px);
  }
  /* Bleed hero → next section: no extra margin — following section's section_gap owns the gutter (one system). */
  #shopify-section-{{ section.id }}:has([data-media-fill="bleed"]) {
    margin-bottom: 32px; /* token between-section before Shop all colors */
  }
  #shopify-section-{{ section.id }}:has([data-media-fill="bleed"]),
  #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"],
  #shopify-section-{{ section.id }}.coll-hero--split[data-media-fill="bleed"] {
    max-width: none;
    width: 100%;
    gap: 0;
    align-items: stretch;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] .coll-hero__copy {
    padding: var(--utp-y-d, 56px) var(--utp-side-d, 48px);
    align-self: center;
  }

  #shopify-section-{{ section.id }} .coll-hero--split .sole-cards {
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .coll-hero__trust {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 13px;
    font-weight: 500;
    color: #6b645a;
    margin: 0 0 18px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .coll-hero__stars {
    color: #c45c3f;
    letter-spacing: 0.1em;
    font-size: 15px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .coll-hero__eyebrow {
    font-size: var(--type-label-size, 11px);
    font-weight: var(--type-label-weight, 600);
    letter-spacing: var(--type-label-tracking, 0.08em);
    text-transform: uppercase;
    color: var(--accent-primary, #c45c3f);
    margin: 0 0 var(--gap-a, 16px);
  }

  #shopify-section-{{ section.id }} .coll-hero__title {
    font-size: var(--type-hero-size);
    font-weight: var(--type-hero-weight);
    line-height: var(--type-hero-leading);
    letter-spacing: var(--type-hero-tracking);
    text-transform: none;
    color: var(--text-primary, #1c1916);
    margin: 0 0 var(--gap-b, 20px);
  }

  #shopify-section-{{ section.id }} .coll-hero__body {
    font-size: var(--text-md, 16px);
    font-weight: 400;
    color: var(--text-body, #4a4a4a);
    line-height: var(--leading-relaxed, 1.6);
    max-width: 42ch;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .coll-hero__actions {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .coll-hero__cta.btn {
    min-height: var(--type-cta-min-height);
    padding: 14px 28px;
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    line-height: var(--type-cta-leading, 1);
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .coll-hero__link {
    font-size: 13px;
    font-weight: 500;
    color: #1c1916;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .coll-hero__link:hover {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .coll-hero__media {
    position: relative;
    overflow: hidden;
    background: #faf8f6;
    min-height: var(--ch-media-h, 420px);
    aspect-ratio: 4 / 5;
  }
  #shopify-section-{{ section.id }} .coll-hero__media[data-media-fill="inset"] {
    border-radius: 6px;
    aspect-ratio: auto;
    height: var(--ch-media-h, 480px);
    min-height: var(--ch-media-h, 480px);
  }
  #shopify-section-{{ section.id }} .coll-hero__media[data-media-fill="column"],
  #shopify-section-{{ section.id }} .coll-hero__media[data-media-fill="bleed"] {
    border-radius: 0;
    align-self: stretch;
    min-height: var(--ch-media-h, 480px);
    height: 100%;
    aspect-ratio: auto;
  }
  #shopify-section-{{ section.id }} .coll-hero__media img,
  #shopify-section-{{ section.id }} .coll-hero__media .coll-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    position: absolute;
    inset: 0;
    display: block;
    transform: scale(var(--ch-zoom, 1));
    transform-origin: center center;
  }

  #shopify-section-{{ section.id }} .sole-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6, 24px);
    margin-top: var(--space-9, 40px);
  }

  #shopify-section-{{ section.id }} .sole-card {
    border: 1px solid var(--border-default, #d6cfc0);
    border-radius: var(--radius-gallery, 8px);
    padding: var(--space-7, 28px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--bg-primary, #fff);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  #shopify-section-{{ section.id }} .sole-card:hover {
    border-color: #1c1916;
    box-shadow: 0 8px 24px rgba(28, 25, 22, 0.08);
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .sole-card__cta {
    margin-top: auto;
    padding-top: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #1c1916;
    border-bottom: 1px solid #1c1916;
    align-self: flex-start;
  }
  #shopify-section-{{ section.id }} .sole-card__tag {
    font-size: var(--text-xs, 10px);
    font-weight: var(--weight-bold, 700);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted, #8a8a8a);
  }
  #shopify-section-{{ section.id }} .sole-card__best {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-primary, #c45c3f);
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} .sole-card__title {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary, #1c1916);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .sole-card__desc {
    font-size: 14px;
    color: var(--text-body, #4a4a4a);
    line-height: 1.6;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .sole-card__img {
    width: 100%;
    aspect-ratio: 16/9;
    background: var(--bg-alternate, #faf8f6);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 4px;
  }
  #shopify-section-{{ section.id }} .sole-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .coll-hero {
      padding: var(--utp-y-m, 36px) var(--utp-x-m, 20px);
    }
    #shopify-section-{{ section.id }} .coll-hero--split {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    #shopify-section-{{ section.id }} .coll-hero--split.coll-hero--reverse {
      direction: ltr;
    }
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] {
      gap: 0;
    }
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] .coll-hero__copy {
      padding: var(--utp-y-m, 36px) var(--utp-x-m, 20px);
      overflow: visible;
    }
    {%- if qa_frame -%}
    {%- comment -%} Mobile aspect ratio dropdown → wrapper. data-mobile-ratio = section.settings.aspect_ratio_mobile. {%- endcomment -%}
    #shopify-section-{{ section.id }} .coll-hero--split .coll-hero__media,
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="inset"] .coll-hero__media,
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] .coll-hero__media,
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="column"] .coll-hero__media {
      width: 100%;
      height: auto;
      min-height: 0;
      max-height: none;
      position: relative;
      overflow: hidden;
      margin: 0;
      padding: 0;
    }
    #shopify-section-{{ section.id }} .coll-hero--split .coll-hero__media[data-mobile-ratio="square"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="inset"] .coll-hero__media[data-mobile-ratio="square"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] .coll-hero__media[data-mobile-ratio="square"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="column"] .coll-hero__media[data-mobile-ratio="square"] {
      aspect-ratio: 1 / 1;
      height: auto;
      min-height: 0;
      max-height: none;
    }
    #shopify-section-{{ section.id }} .coll-hero--split .coll-hero__media[data-mobile-ratio="portrait"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="inset"] .coll-hero__media[data-mobile-ratio="portrait"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] .coll-hero__media[data-mobile-ratio="portrait"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="column"] .coll-hero__media[data-mobile-ratio="portrait"] {
      aspect-ratio: 3 / 4;
      height: auto;
      min-height: 0;
      max-height: none;
    }
    #shopify-section-{{ section.id }} .coll-hero--split .coll-hero__media[data-mobile-ratio="landscape"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="inset"] .coll-hero__media[data-mobile-ratio="landscape"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] .coll-hero__media[data-mobile-ratio="landscape"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="column"] .coll-hero__media[data-mobile-ratio="landscape"] {
      aspect-ratio: 16 / 9;
      height: auto;
      min-height: 0;
      max-height: none;
    }
    #shopify-section-{{ section.id }} .coll-hero--split .coll-hero__media[data-mobile-ratio="widescreen"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="inset"] .coll-hero__media[data-mobile-ratio="widescreen"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] .coll-hero__media[data-mobile-ratio="widescreen"],
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="column"] .coll-hero__media[data-mobile-ratio="widescreen"] {
      aspect-ratio: 21 / 9;
      height: auto;
      min-height: 0;
      max-height: none;
    }
    #shopify-section-{{ section.id }} .coll-hero--split .coll-hero__media[data-mobile-ratio="natural"] {
      aspect-ratio: auto;
    }
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="square"] picture,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="portrait"] picture,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="landscape"] picture,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="widescreen"] picture,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="square"] img,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="portrait"] img,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="landscape"] img,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="widescreen"] img,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="square"] video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="portrait"] video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="landscape"] video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="widescreen"] video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="square"] .coll-hero__video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="portrait"] .coll-hero__video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="landscape"] .coll-hero__video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="widescreen"] .coll-hero__video {
      width: 100%;
      height: 100%;
      position: absolute;
      inset: 0;
      display: block;
      object-position: center;
      transform: none;
      max-height: none;
    }
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="square"] img,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="portrait"] img,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="landscape"] img,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="widescreen"] img {
      object-fit: {{ image_fit_mobile }};
    }
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="square"] video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="portrait"] video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="landscape"] video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="widescreen"] video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="square"] .coll-hero__video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="portrait"] .coll-hero__video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="landscape"] .coll-hero__video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="widescreen"] .coll-hero__video {
      object-fit: {{ video_fit_mobile }};
    }
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="natural"] picture {
      display: block;
      width: 100%;
      height: auto;
      position: static;
    }
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="natural"] img,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="natural"] video,
    #shopify-section-{{ section.id }} .coll-hero__media[data-mobile-ratio="natural"] .coll-hero__video {
      width: 100%;
      height: auto;
      position: static;
      inset: auto;
      display: block;
      object-fit: unset;
      transform: none;
      max-height: none;
    }
    {%- if text_height_mobile > 0 %}
    /* Text frame grows independently. Type size untouched. */
    #shopify-section-{{ section.id }} .coll-hero--split .coll-hero__copy,
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] .coll-hero__copy {
      min-height: {{ text_height_mobile }}px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    {%- endif %}
    {%- else -%}
    /* Existing behavior — every non-collection template */
    #shopify-section-{{ section.id }} .coll-hero--split .coll-hero__media {
      min-height: 0;
      max-height: 52vh;
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] .coll-hero__media {
      max-height: none;
      min-height: 52vw;
      overflow: hidden;
    }
    {%- endif -%}
    #shopify-section-{{ section.id }} .sole-cards {
      grid-template-columns: 1fr;
    }
  }
</style>

{%- comment -%} TE live preview: section.settings.* only.{%- endcomment -%}
{% style %}
  {%- liquid
    assign te_mh = section.settings.min_height
    if te_mh == blank
      assign te_mh = section.settings.media_height | default: 480
    endif
    assign te_pct = section.settings.media_column_pct | default: 48
    assign te_zoom = section.settings.image_zoom | default: section.settings.image_scale | default: 100
  -%}
  #shopify-section-{{ section.id }} {
    --ch-text: {{ 100 | minus: te_pct }}fr !important;
    --ch-media: {{ te_pct }}fr !important;
    --ch-zoom: {{ te_zoom | times: 0.01 }} !important;
    --ch-media-h: {{ te_mh }}px !important;
    margin-top: {{ section.settings.section_gap | default: 0 }}px !important;
    margin-bottom: {{ section.settings.section_gap | default: 0 }}px !important;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-bottom: {{ section.settings.section_gap_mobile | default: 0 }}px !important;
    }
    {%- if section.settings.text_height_mobile > 0 %}
    #shopify-section-{{ section.id }} .coll-hero--split .coll-hero__copy,
    #shopify-section-{{ section.id }} .coll-hero--split[data-media-fill="bleed"] .coll-hero__copy {
      min-height: {{ section.settings.text_height_mobile }}px !important;
    }
    {%- endif %}
  }
{% endstyle %}

{% render 'unified-text-pads-te-style', selector: '.coll-hero--split', y_d: 56, side_d: 40, y_m: 36, x_m: 20 %}
{% render 'unified-text-pads-te-style', selector: '.coll-hero:not(.coll-hero--split)', y_d: 72, side_d: 40, y_m: 36, x_m: 20 %}
{% render 'unified-text-pads-te-style', selector: '.coll-hero--split[data-media-fill="bleed"] .coll-hero__copy', y_d: 56, side_d: 48, y_m: 36, x_m: 20 %}

{% render 'bg-video-autoplay-script',
  section_id: section.id,
  root_class: 'coll-hero',
  video_selector: 'video.coll-hero__video, .coll-hero__media video'
%}

{% schema %}
{
  "name": "Collection Hero",
  "settings": [
    { "type": "header", "content": "1 — Photo / video" },
    { "type": "paragraph", "content": "Pick one source. Priority: Shopify video → Video URL → Shopify image → Image URL." },
    { "type": "video", "id": "video", "label": "Shopify video" },
    { "type": "text", "id": "video_url", "label": "Video URL (mp4)" },
    { "type": "image_picker", "id": "image", "label": "Image / poster (Shopify)" },
    { "type": "text", "id": "image_url", "label": "Image URL", "info": "Used when Shopify image is empty. Leave blank for text-only hero." },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image (optional)", "info": "Ignored when video is set." },

    { "type": "header", "content": "2 — Focus + height" },
    { "type": "range", "id": "image_zoom", "label": "Desktop zoom % (default 100)", "min": 100, "max": 180, "step": 2, "unit": "%", "default": 100, "info": "Never below 100 — no cream gaps." },
    { "type": "range", "id": "min_height", "label": "Height — desktop (default 480)", "min": 360, "max": 720, "step": 10, "unit": "px", "default": 480 },
    { "type": "range", "id": "media_column_pct", "label": "Image width — desktop (default 48%)", "min": 35, "max": 70, "step": 1, "unit": "%", "default": 48 },
    { "type": "select", "id": "media_fill", "label": "Photo size (default: Inset card)", "default": "inset", "info": "Inset = rounded card. Column fill = fills the photo column. Full size = photo to the page edge.", "options": [
      { "value": "inset", "label": "Inset card" },
      { "value": "column", "label": "Fill column" },
      { "value": "bleed", "label": "Full size (edge of page)" }
    ]},
    { "type": "header", "content": "Phone only" },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "label": "Phone frame shape (default: Natural)",
      "default": "natural",
      "options": [
        { "value": "natural", "label": "Natural — photo’s own ratio" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "widescreen", "label": "Widescreen" }
      ],
      "info": "Collection template uses portrait framing on phone."
    },
    {
      "type": "select",
      "id": "image_fit_mobile",
      "label": "Phone image fit (default: Cover)",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "fill", "label": "Fill" }
      ]
    },
    {
      "type": "select",
      "id": "video_fit_mobile",
      "label": "Phone video fit (default: Cover)",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "fill", "label": "Fill" }
      ]
    },
    {
      "type": "range",
      "id": "text_height_mobile",
      "label": "Phone text frame height (default 0)",
      "min": 0,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 = fits the copy. Drag to grow the text frame; type size unchanged."
    },

    { "type": "header", "content": "3 — Heading / body / CTA" },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level (default H1)",
      "default": "h1",
      "options": [
        { "value": "h1", "label": "H1 — collection page title" }
      ],
      "info": "Collection heroes always render as H1 for SEO."
    },
    { "type": "text", "id": "title", "label": "Heading", "default": "Secure in Every Hold" },
    { "type": "inline_richtext", "id": "body", "label": "Body", "default": "No sliding. No resets. Pick Closed or Open — $74 — then shop every color below." },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "Shop Now" },
    { "type": "text", "id": "cta_url", "label": "Button link", "default": "#grid" },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button",
      "default": "rust_solid",
      "options": [
        { "value": "rust_solid", "label": "Rust" },
        { "value": "black_solid", "label": "Black" },
        { "value": "rust_outline", "label": "Rust outline" },
        { "value": "black_outline", "label": "Black outline" }
      ]
    },
    { "type": "text", "id": "secondary_cta_text", "label": "Secondary link label", "default": "See why →" },
    { "type": "text", "id": "secondary_cta_url", "label": "Secondary link URL", "default": "#pose" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (when trust strip is off)" },

    { "type": "header", "content": "4 — Trust strip" },
    { "type": "checkbox", "id": "show_trust_strip", "label": "Show trust strip (default: on)", "default": true },
    { "type": "text", "id": "trust_text", "label": "Trust line", "default": "Trusted by 1,000's of instructors & studios" },

    { "type": "header", "content": "5 — Layout" },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Image on right — desktop (default: off)",
      "default": false,
      "info": "769px and up only."
    },
    {
      "type": "select",
      "id": "mobile_stack_order",
      "label": "Phone stack (default: image on top)",
      "default": "media_first",
      "options": [
        { "value": "media_first", "label": "Image above copy (default)" },
        { "value": "copy_first", "label": "Copy above image" }
      ]
    },
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 96)",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96,
      "info": "Unset in JSON keeps legacy split padding (56px) until you set this in TE."
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 64)",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 64,
      "info": "Unset in JSON keeps legacy 40px (48px bleed copy) until you set this in TE."
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 80)",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80,
      "info": "Unset uses stored mobile spacing (often 36px) until you set this."
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 20)",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    { "type": "text", "id": "aria_label", "label": "Accessibility name (aria-label)", "default": "Collection hero" },

    { "type": "header", "content": "6 — Section gap" },
    {
      "type": "range",
      "id": "section_gap",
      "label": "Space above & below — desktop (default 0)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_gap_mobile",
      "label": "Space after section — phone (default 0)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    { "type": "header", "content": "Sole cards (optional — off for Collection v18)" },
    { "type": "checkbox", "id": "show_sole_cards", "label": "Show Open/Closed comparison cards", "default": false, "info": "v18 Locked: off. Sole via grid tabs + FAQ only." },
    { "type": "image_picker", "id": "closed_image", "label": "Closed Sole image" },
    { "type": "url", "id": "closed_url", "label": "Closed Sole link" },
    { "type": "text", "id": "closed_best_for", "label": "Closed Sole — Pick this if", "default": "you want heel and foot fully covered.", "info": "Feel and coverage only — never assign a discipline to a sole." },
    { "type": "textarea", "id": "closed_desc", "label": "Closed Sole description", "default": "Heel and foot fully covered. 360° grip across the entire underfoot. Both perform identically — same grip, same stability." },
    { "type": "image_picker", "id": "open_image", "label": "Open Sole image" },
    { "type": "url", "id": "open_url", "label": "Open Sole link" },
    { "type": "text", "id": "open_best_for", "label": "Open Sole — Pick this if", "default": "you want a more grounded, barefoot feel with natural toe splay.", "info": "Feel and coverage only — never assign a discipline to a sole." },
    { "type": "textarea", "id": "open_desc", "label": "Open Sole description", "default": "Heel exposed, mid-foot breathing hole. More grounded, barefoot feel. Natural toe splay. Both perform identically — same grip, same stability." },

    { "type": "header", "content": "Legacy (hidden — do not edit)" },
    { "type": "paragraph", "content": "Preserves stored values on Theme Editor save." },
    { "type": "select", "id": "media_type", "label": "Legacy: Media type", "default": "image", "options": [{ "value": "image", "label": "Image" }, { "value": "video", "label": "Video" }], "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}" },
    { "type": "range", "id": "media_height", "label": "Legacy: Photo height", "min": 360, "max": 720, "step": 10, "unit": "px", "default": 480, "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}" },
    { "type": "checkbox", "id": "show_trust", "label": "Legacy: Show trust line", "default": true, "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}" },
    { "type": "range", "id": "text_spacing_mobile", "label": "Legacy: Mobile text spacing", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 36, "visible_if": "{{ section.settings.heading_level == '__legacy_hidden__' }}" }
  ],
  "presets": [{ "name": "Collection Hero" }]
}
{% endschema %}
