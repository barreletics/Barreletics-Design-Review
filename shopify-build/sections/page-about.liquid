{% comment %}
  Page About Section
  Brand story, values, category creation narrative.
  Used on: page.about.json
{% endcomment %}

<section class="section" id="shopify-section-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="section__inner section__inner--narrow">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow eyebrow--accent page-about__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="page-about__title type-hero">{{ section.settings.title }}</h1>
    <div class="page-about__intro">
      {{ section.settings.intro_text }}
    </div>
  </div>
</section>

{% if section.settings.manifesto != blank %}
<section class="section section--dark">
  <div class="section__inner section__inner--narrow">
    <blockquote class="page-about__manifesto type-statement">
      {{ section.settings.manifesto }}
    </blockquote>
  </div>
</section>
{% endif %}

{% if section.blocks.size > 0 %}
<section class="section section--cream">
  <div class="section__inner">
    <h2 class="page-about__values-title h2-standard">{{ section.settings.values_heading }}</h2>
    <div class="page-about__values-grid">
      {% for block in section.blocks %}
        {% if block.type == 'value' %}
          <div class="page-about__value" {{ block.shopify_attributes }}>
            <h3 class="page-about__value-title">{{ block.settings.title }}</h3>
            <p class="page-about__value-body">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if section.settings.made_in_usa_text != blank %}
<section class="section">
  <div class="section__inner section__inner--narrow">
    <div class="page-about__usa">
      <p class="eyebrow">Made in USA</p>
      <h2 class="page-about__usa-title h2-standard">{{ section.settings.made_in_usa_heading }}</h2>
      <div class="page-about__usa-body">
        {{ section.settings.made_in_usa_text }}
      </div>
    </div>
  </div>
</section>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Barreletics",
  "url": "https://barreletics.com",
  "description": {{ section.settings.intro_text | strip_html | json }},
  "brand": {
    "@type": "Brand",
    "name": "Barreletics"
  },
  "foundingCountry": "US",
  "knowsAbout": ["Performance footwear", "Grippy shoes", "Pilates", "Barre", "Reformer"]
}
</script>

<style>
  .page-about__eyebrow {
    margin: 0 0 var(--gap-a);
  }

  /* Size/weight/tracking come from .type-hero — cadence only here */
  .page-about__title {
    color: var(--text-primary);
    margin: 0 0 var(--gap-b);
  }

  .page-about__intro {
    font-size: var(--type-lede-size);
    font-weight: var(--type-lede-weight);
    color: var(--text-body);
    line-height: var(--type-lede-leading);
  }

  .page-about__intro p {
    margin-bottom: var(--space-4);
  }

  /* Dark-band tier 1 — size/weight/tracking come from .type-statement */
  .page-about__manifesto {
    color: var(--color-white);
    text-align: center;
    margin: 0;
    padding: 0;
    border: none;
  }

  /* Size/weight/tracking come from .h2-standard */
  .page-about__values-title {
    color: var(--text-primary);
    text-align: center;
    margin: 0 0 var(--space-9);
  }

  .page-about__values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--grid-gap);
  }

  .page-about__value {
    padding: var(--space-6);
    background: var(--bg-primary);
    border-radius: var(--radius-card);
    border: 1px solid var(--border-default);
  }

  /* Card titles take the H3 role */
  .page-about__value-title {
    font-size: var(--type-h3-size);
    font-weight: var(--type-h3-weight);
    line-height: var(--type-h3-leading);
    letter-spacing: var(--type-h3-tracking);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .page-about__value-body {
    font-size: var(--type-body-size);
    font-weight: var(--type-body-weight);
    color: var(--text-body);
    line-height: var(--type-body-leading);
    margin: 0;
  }

  .page-about__usa {
    text-align: center;
  }

  /* Size/weight/tracking come from .h2-standard */
  .page-about__usa-title {
    color: var(--text-primary);
    margin: var(--gap-a) 0 var(--gap-b);
  }

  .page-about__usa-body {
    font-size: var(--type-body-size);
    font-weight: var(--type-body-weight);
    color: var(--text-body);
    line-height: var(--type-body-leading);
    max-width: var(--max-width-copy);
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .page-about__values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "About Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Our Story"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text",
      "default": "<p>Barreletics is replacing the grip sock category with Performance Skins — injection-molded grippy shoes engineered for barre, reformer, Lagree, and Pilates. Instead of asking 'which grip sock?' we want you asking 'why grip socks at all?'</p>"
    },
    {
      "type": "richtext",
      "id": "manifesto",
      "label": "Manifesto quote",
      "default": "<p>We didn't improve the grip sock. We made it obsolete.</p>"
    },
    {
      "type": "text",
      "id": "values_heading",
      "label": "Values section heading",
      "default": "What We Stand For"
    },
    {
      "type": "text",
      "id": "made_in_usa_heading",
      "label": "Made in USA heading",
      "default": "Designed and Made in the USA"
    },
    {
      "type": "richtext",
      "id": "made_in_usa_text",
      "label": "Made in USA text",
      "default": "<p>Every pair of Barreletics is manufactured in the United States. From material sourcing to injection molding to quality control — the entire process stays domestic. No overseas factories. No compromises on quality oversight.</p>"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Brand Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Value title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Value description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Page"
    }
  ]
}
{% endschema %}
