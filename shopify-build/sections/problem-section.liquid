{% comment %}
  Problem section — Home WORKING 12b. Cream beat with optional muted media + copy split.
{% endcomment %}

{%- liquid
  assign cta_style = section.settings.cta_style | default: 'solid'
  assign cta_bg = section.settings.cta_bg_color | default: '#c45c3f'
  assign cta_border = section.settings.cta_border_color | default: cta_bg
  assign cta_text_color = section.settings.cta_text_color | default: '#ffffff'
  assign mobile_media_height = section.settings.mobile_media_height | default: 520
  assign media_position_x = section.settings.media_position_x | default: 50
  assign media_position_y_mobile = section.settings.media_position_y_mobile | default: 50
  assign copy_stack_gap = section.settings.copy_stack_gap | default: 28

  assign has_media = false
  if section.settings.video != blank
    assign has_media = true
  elsif section.settings.video_asset != blank
    assign has_media = true
  elsif section.settings.video_url != blank
    assign has_media = true
  elsif section.settings.image != blank
    assign has_media = true
  endif

  assign video_src = section.settings.video_url | strip
  assign video_asset = section.settings.video_asset | default: '' | strip
  if video_asset != blank
    assign video_src = video_asset | asset_url
  endif
  assign video_source_type = 'video/mp4'
  if video_src contains '.mov'
    assign video_source_type = 'video/quicktime'
  endif

  assign poster_url = ''
  if section.settings.image != blank
    assign poster_url = section.settings.image | image_url: width: 1600
  endif
-%}
<section
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} problem-section{% if has_media %} problem-section--with-media{% endif %}"
  id="{{ section.settings.anchor_id | default: 'problem' | handleize }}"
  aria-label="{{ section.settings.title | escape }}"
  style="{% render 'section-inset-vars' %} --pr-cta-bg: {{ cta_bg }}; --pr-cta-border: {{ cta_border }}; --pr-cta-text: {{ cta_text_color }}; --pr-mobile-media-height: {{ mobile_media_height }}px; --pr-media-pos-x: {{ media_position_x }}%; --pr-media-pos-y-mobile: {{ media_position_y_mobile }}%; --pr-copy-stack-gap: {{ copy_stack_gap }}px;"
>
  <div class="problem-shell">
    <div class="problem-layout{% if has_media %} problem-layout--with-media{% endif %}">
      {% if has_media %}
        <div class="problem-media">
          <div class="problem-media__clip">
            {% if section.settings.video != blank %}
              {{
                section.settings.video
                | video_tag:
                  image_size: '1600x',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  class: 'problem-media__video'
              }}
            {% elsif video_src != blank %}
              <video
                class="problem-media__video"
                autoplay
                muted
                loop
                playsinline
                webkit-playsinline
                preload="auto"
                disablepictureinpicture
                {% if poster_url != blank %}poster="{{ poster_url | escape }}"{% endif %}
              >
                <source src="{{ video_src | escape }}" type="{{ video_source_type }}">
              </video>
            {% elsif section.settings.image != blank %}
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag:
                  widths: '600, 900, 1200, 1600',
                  sizes: '(max-width: 768px) 100vw, 50vw',
                  alt: section.settings.title,
                  loading: 'lazy',
                  class: 'problem-media__img'
              }}
            {% endif %}
          </div>
        </div>
      {% endif %}
      <div class="problem-inner">
        <div>
          <h2 class="problem-title h2-display">{{ section.settings.title }}</h2>
          {% if section.settings.body != blank %}
            <p class="problem-body">{{ section.settings.body }}</p>
          {% endif %}
        </div>
        <div>
          {% if section.blocks.size > 0 %}
            <ul class="problem-list">
              {% for block in section.blocks %}
                {% if block.settings.text != blank %}
                <li {{ block.shopify_attributes }}>
                  <span class="problem-list__x" aria-hidden="true">×</span>
                  <span>{{ block.settings.text }}</span>
                </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
          {% if section.settings.cta_text != blank %}
            <div class="problem-resolve">
              <a class="problem-resolve__cta{% if cta_style == 'outline' %} problem-resolve__cta--outline{% endif %}" href="{{ section.settings.cta_url | default: '#variants' }}">
                {{ section.settings.cta_text }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .problem-section {
    padding: 72px 40px;
    background: #faf8f6;
  }
  {% if template.name == 'collection' %}
  #shopify-section-{{ section.id }} .problem-section {
    background: #faf8f6;
  }
  {% endif %}
  .problem-shell {
    max-width: 1100px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: stretch;
    max-width: none;
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media .problem-shell {
    max-width: none;
  }
  #shopify-section-{{ section.id }} .problem-media__clip {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 860px; /* Home 50/50 desk ruler (Grip / One Pair) */
    overflow: hidden;
    border-radius: 4px;
    background: #f0ebe4;
  }
  #shopify-section-{{ section.id }} .problem-media__video,
  #shopify-section-{{ section.id }} .problem-media__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .problem-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media .problem-inner {
    grid-column: auto;
    grid-template-columns: 1fr;
    gap: var(--pr-copy-stack-gap, 28px);
  }
  .problem-title {
    max-width: none;
    margin: 0 0 var(--gap-b);
  }
  .problem-body {
    font-size: var(--type-body-size);
    font-weight: var(--type-body-weight);
    color: var(--text-body);
    line-height: var(--type-body-leading);
    margin: 0;
    max-width: 38ch;
  }
  .problem-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .problem-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid #d6cfc0;
    font-size: 15px;
    color: #4a4a4a;
    line-height: 1.45;
  }
  .problem-list li:last-child { border-bottom: 1px solid #d6cfc0; }
  .problem-list__x {
    color: #c45c3f;
    font-weight: 700;
    flex-shrink: 0;
  }
  .problem-resolve {
    margin-top: 28px;
    padding-top: 0;
    border-top: none;
  }
  .problem-resolve__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
    background: var(--pr-cta-bg, #c45c3f);
    color: var(--pr-cta-text, #fff);
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    line-height: var(--type-cta-leading, 1);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid var(--pr-cta-border, var(--pr-cta-bg, #c45c3f));
    transition: opacity 0.15s ease;
  }
  .problem-resolve__cta--outline {
    background: transparent;
    color: var(--pr-cta-text, var(--pr-cta-border, #c45c3f));
  }
  .problem-resolve__cta:hover { opacity: 0.92; }
  @media (max-width: 768px) {
    .problem-section { padding: 48px 16px; }
    #shopify-section-{{ section.id }} .problem-layout--with-media {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    #shopify-section-{{ section.id }} .problem-media__clip {
      height: var(--pr-mobile-media-height, 520px);
      min-height: var(--pr-mobile-media-height, 520px);
      max-height: var(--pr-mobile-media-height, 520px);
    }
    .problem-inner {
      grid-template-columns: 1fr;
      gap: var(--pr-copy-stack-gap, 28px);
    }
    #shopify-section-{{ section.id }} .problem-media__video,
    #shopify-section-{{ section.id }} .problem-media__img {
      object-position: 50% var(--pr-media-pos-y-mobile, 50%);
    }
  }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .problem-media__video,
    #shopify-section-{{ section.id }} .problem-media__img {
      object-position: var(--pr-media-pos-x, 50%) 50%;
    }
  }
</style>

{% if section.settings.video != blank or video_src != blank %}
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var video = root.querySelector('.problem-media__video');
    if (!video || video.hasAttribute('controls')) return;
    function kick() {
      video.muted = true;
      video.defaultMuted = true;
      video.setAttribute('muted', '');
      video.playsInline = true;
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
    }
    video.addEventListener('loadeddata', kick);
    video.addEventListener('canplay', kick);
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) kick(); });
      }, { rootMargin: '80px 0px' });
      io.observe(video);
    }
    kick();
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Problem section",
  "settings": [
    {
      "type": "header",
      "content": "Shared — Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Never slip in Chair Pose"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Never slip again in side plank or flat back chair. Try that in a barre grip sock."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA label",
      "default": "Shop Now"
    },
    
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "options": [
        { "value": "solid", "label": "Solid fill" },
        { "value": "outline", "label": "Outline only" }
      ],
      "default": "solid"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Media (optional)"
    },
    {
      "type": "paragraph",
      "content": "When set, shows muted looping video (or still image) beside copy. Priority: Shopify video → Video URL → Image. All videos are always muted."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "CDN/external mp4. Ignored when Shopify video is set. Legacy theme-asset filenames in saved settings still work."
    },
    {
      "type": "text",
      "id": "video_asset",
      "label": "Theme video asset filename",
      "info": "e.g. chair-pose-home.mp4 in Assets. Wins over Video URL."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster / still image",
      "info": "Poster for video URL, or still image when no video is set."
    },
    {
      "type": "range",
      "id": "media_position_x",
      "label": "Desktop media — left ↔ right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "Object position on desktop (769px+). Media always uses cover."
    },
    {
      "type": "range",
      "id": "media_position_y_mobile",
      "label": "Mobile media — up ↔ down",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "Object position on mobile (768px and below)."
    },
    {
      "type": "range",
      "id": "mobile_media_height",
      "label": "Mobile media height",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 520,
      "info": "Fixed height for the media column on phone when split layout is active."
    },
    {
      "type": "header",
      "content": "Section — Problem"
    },
    {
      "type": "range",
      "id": "copy_stack_gap",
      "label": "Space above bullet list",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 28,
      "info": "Gap under the title and body before the list (stacked copy). Lower = list moves up."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "problem"
    },
    {
      "type": "header",
      "content": "Shared — Section frame"
    },
    {
      "type": "paragraph",
      "content": "OUTER inset from the page edges (margin). Top and bottom are independent; left & right = one control. Custom mobile OFF = mobile uses the same inset as desktop. Defaults 0 = full bleed."
    },
    {
      "type": "checkbox",
      "id": "inset_custom_mobile",
      "label": "Custom mobile inset",
      "default": false,
      "info": "OFF (default): ignore the mobile inset sliders — mobile uses desktop Inset top / bottom / left & right. ON: use the mobile inset sliders instead."
    },
    {
      "type": "range",
      "id": "inset_top",
      "label": "Inset top",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_bottom",
      "label": "Inset bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x",
      "label": "Inset left & right",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Same value on both sides."
    },
    {
      "type": "range",
      "id": "inset_top_mobile",
      "label": "Inset top — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "range",
      "id": "inset_bottom_mobile",
      "label": "Inset bottom — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "inset_x_mobile",
      "label": "Inset left & right — mobile",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Only when Custom mobile inset is on."
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Pain point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Grip socks that peel, stretch out, and quit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problem section",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Flat back chair & water ski — resetting mid-set"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Reformer footwork — adjusting between sets"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Deep lunges on barre, reformer & Megaformer"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Grip socks that peel, stretch out, and quit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
