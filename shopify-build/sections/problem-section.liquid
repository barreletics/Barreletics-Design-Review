{% comment %}
  Problem section — Home split (50/50 parity) + pain-point list blocks.
  Media / layout / TE controls align with fifty-fifty.liquid; unique: × list + copy_stack_gap.
{% endcomment %}
{% liquid
  assign heading_class = 'h2-display'
  assign heading_level = section.settings.heading_level | default: 'h2'
  if heading_level != 'h1' and heading_level != 'h2' and heading_level != 'h3' and heading_level != 'h4' and heading_level != 'h5' and heading_level != 'h6'
    assign heading_level = 'h2'
  endif

  assign media_fit = section.settings.media_fit | default: 'cover'
  assign image_fit_m = section.settings.image_fit_mobile | default: 'cover'
  assign media_aspect = section.settings.media_aspect | default: 'stretch'
  assign media_aspect_m = section.settings.media_aspect_mobile | default: 'stretch'

  assign bg_style = section.settings.bg_style
  if bg_style == 'white'
    assign panel_bg = '#ffffff'
  elsif bg_style == 'cream'
    assign panel_bg = '#faf8f6'
  elsif bg_style == 'darker_cream'
    assign panel_bg = '#efe9dd'
  else
    assign bg_preset = section.settings.bg_preset | default: ''
    if bg_preset == 'white'
      assign panel_bg = '#ffffff'
    elsif bg_preset == 'cream'
      assign panel_bg = '#faf8f6'
    elsif bg_preset == 'custom'
      assign panel_bg = section.settings.bg_color | default: '#faf8f6'
    else
      assign legacy_bg = section.settings.bg_color | default: ''
      if legacy_bg == '#faf8f6' or legacy_bg == '#FAF8F6'
        assign panel_bg = '#faf8f6'
      elsif legacy_bg == '#efe9dd' or legacy_bg == '#EFE9DD'
        assign panel_bg = '#efe9dd'
      elsif legacy_bg != blank
        assign panel_bg = legacy_bg
      else
        assign panel_bg = '#faf8f6'
      endif
    endif
  endif

  assign media_pad_bg = section.settings.media_bg | default: '#ffffff'
  if media_pad_bg == blank
    assign media_bg_preset = section.settings.media_bg_preset
    if media_bg_preset == 'cream'
      assign media_pad_bg = '#faf8f6'
    elsif media_bg_preset == 'white'
      assign media_pad_bg = '#ffffff'
    else
      assign media_pad_bg = '#ffffff'
    endif
  endif

  assign cta_target = section.settings.cta_link_target | default: 'custom'
  if cta_target != blank and cta_target != 'custom'
    assign cta_href = cta_target
  else
    assign cta_href = section.settings.cta_url
  endif

  assign media_pct = section.settings.media_column_pct
  if media_pct == blank
    assign desktop_split = section.settings.desktop_split | default: '50_50'
    if desktop_split == '62_38'
      assign media_pct = 62
    elsif desktop_split == '38_62'
      assign media_pct = 38
    else
      assign media_pct = 50
    endif
  endif
  assign text_pct = 100 | minus: media_pct

  assign min_height = section.settings.min_height | default: 860
  assign mobile_media_height = section.settings.mobile_media_height | default: 0
  if mobile_media_height > 0
    assign ff_mobile_media_h_css = mobile_media_height | append: 'px'
  else
    assign ff_mobile_media_h_css = 'var(--split-media-h-mobile, 500px)'
  endif
  assign mobile_media_width = section.settings.mobile_media_width | default: 100

  assign image_position_key = section.settings.image_position | default: 'center'
  assign image_position = image_position_key
  if image_position_key == 'custom'
    assign focal_x = section.settings.focal_x | default: 50
    assign focal_y = section.settings.focal_y | default: 50
    assign image_position = focal_x | append: '% ' | append: focal_y | append: '%'
  endif

  assign image_position_m_key = section.settings.image_position_mobile | default: 'same'
  assign image_position_m = image_position
  assign ff_pos_fit_m = 'center top'
  if image_position_m_key == 'same' or image_position_m_key == blank
    if image_position_key != blank and image_position_key != 'center'
      if image_position_key != 'custom' or image_position != '50% 50%'
        assign ff_pos_fit_m = image_position
      endif
    endif
  elsif image_position_m_key == 'custom'
    assign focal_x_m = section.settings.focal_x_mobile | default: 50
    assign focal_y_m = section.settings.focal_y_mobile | default: 50
    assign image_position_m = focal_x_m | append: '% ' | append: focal_y_m | append: '%'
    assign ff_pos_fit_m = image_position_m
  else
    assign image_position_m = image_position_m_key
    assign ff_pos_fit_m = image_position_m_key
  endif

  assign image_scale = section.settings.image_scale | default: 100
  assign contain_width = section.settings.contain_width | default: 72
  assign media_radius = section.settings.media_radius | default: 0
  assign side_padding = section.settings.side_padding | default: 40
  assign text_pad_y_d = section.settings.text_pad_y | default: 96
  assign text_pad_top_d = text_pad_y_d
  assign text_pad_bottom_d = text_pad_y_d
  assign text_pad_y_m = section.settings.text_pad_y_mobile | default: 80
  assign text_pad_m = text_pad_y_m
  assign text_pad_bottom_m = text_pad_y_m
  assign text_pad_x_m = section.settings.text_pad_x_mobile | default: 16
  assign section_gap = 0
  if section.settings.section_gap != blank
    assign section_gap = section.settings.section_gap
  endif
  assign section_gap_m = 0
  if section.settings.section_gap_mobile == 0 or section.settings.section_gap_mobile != blank
    assign section_gap_m = section.settings.section_gap_mobile
  endif
  assign image_scale_ratio = image_scale | times: 1.0 | divided_by: 100.0

  assign cta_style = section.settings.cta_style | default: 'rust_solid'
  if cta_style == 'solid'
    assign cta_style = 'rust_solid'
  elsif cta_style == 'outline'
    assign cta_style = 'rust_outline'
  endif
  case cta_style
    when 'rust_outline', 'outline'
      assign cta_btn_class = 'btn--brand-outline'
    when 'black_solid', 'primary'
      assign cta_btn_class = 'btn--primary'
    when 'black_outline', 'secondary'
      assign cta_btn_class = 'btn--secondary'
    else
      assign cta_btn_class = 'btn--brand'
  endcase

  assign region_label = section.settings.aria_label | strip
  if region_label == blank
    assign region_label = section.settings.title | strip | truncate: 60
  endif
  if region_label == blank
    assign region_label = 'Problem section'
  endif

  assign copy_stack_gap = section.settings.copy_stack_gap | default: 12
  assign show_trust_strip = section.settings.show_trust_strip
  assign trust_text = section.settings.trust_text | strip

  assign has_media = false
  if section.settings.video != blank
    assign has_media = true
  elsif section.settings.video_url != blank
    assign has_media = true
  elsif section.settings.image != blank
    assign has_media = true
  elsif section.settings.image_url != blank
    assign has_media = true
  elsif section.settings.video_asset != blank
    assign has_media = true
  elsif section.settings.image_asset != blank
    assign has_media = true
  endif
%}
<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} split-section problem-section{% unless has_media %} split-section--text-only{% endunless %}{% if section.settings.reverse %} split-section--reverse{% endif %}{% if media_fit == 'contain' %} split-section--contain{% endif %}{% if media_fit == 'fit' %} split-section--fit{% endif %}{% if media_fit == 'cover_inset' %} split-section--cover-inset{% endif %}{% if image_fit_m == 'fit' %} split-section--fit-m{% endif %}{% if image_fit_m == 'contain' %} split-section--contain-m{% endif %}{% if media_aspect == 'square' %} split-section--media-square{% endif %}{% if media_aspect_m == 'square' %} split-section--media-square-m{% endif %}{% render 'split-mobile-stack-class', mobile_stack_order: section.settings.mobile_stack_order %}"
  style="{% render 'section-inset-vars' %}
    --ff-min-height: {{ min_height }}px;
    --ff-mobile-media-height: {{ ff_mobile_media_h_css }};
    --ff-media-fr: {{ media_pct }}fr;
    --ff-text-fr: {{ text_pct }}fr;
    --ff-object-position: {{ image_position }};
    --ff-object-position-m: {{ image_position_m }};
    --ff-object-position-fit-m: {{ ff_pos_fit_m }};
    --ff-mobile-media-width: {{ mobile_media_width }}%;
    --ff-image-scale: {{ image_scale_ratio }};
    --ff-contain-width: {{ contain_width }}%;
    --ff-media-radius: {{ media_radius }}px;
    --ff-text-radius: {{ media_radius }}px;
    --ff-panel-bg: {{ panel_bg }};
    --ff-media-pad-bg: {{ media_pad_bg }};
    --ff-side-padding: {{ side_padding }}px;
    --ff-text-pad-top-d: {{ text_pad_top_d }}px;
    --ff-text-pad-bottom-d: {{ text_pad_bottom_d }}px;
    --ff-section-gap: {{ section_gap }}px;
    --ff-section-gap-m: {{ section_gap_m }}px;
    --ff-text-pad-top-m: {{ text_pad_m }}px;
    --ff-text-pad-bottom-m: {{ text_pad_bottom_m }}px;
    --ff-text-pad-x-m: {{ text_pad_x_m }}px;
    --pr-copy-stack-gap: {{ copy_stack_gap }}px;
  "
  role="region"
  aria-label="{{ region_label | escape }}"
>
  {% if has_media %}<div class="split-media" style="background: {{ media_pad_bg }};">
    <div class="split-media__clip">
    {%- comment -%} Phone image (optional): replaces the still image at max-width 768px via <picture>; desktop keeps the main image. {%- endcomment -%}
    {%- assign ff_pic = false -%}
    {%- if section.settings.image_mobile != blank and section.settings.video == blank and section.settings.video_url == blank -%}{%- assign ff_pic = true -%}
    <picture style="display:contents">
      <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 780 }} 780w, {{ section.settings.image_mobile | image_url: width: 1170 }} 1170w" sizes="100vw" width="{{ section.settings.image_mobile.width }}" height="{{ section.settings.image_mobile.height }}">
    {%- endif -%}
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          image_size: '1200x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'split-media__video'
      }}
    {% elsif section.settings.video_url != blank %}
      <video
        class="split-media__video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 1200 }}"
        {% elsif section.settings.poster_url != blank %}
          poster="{{ section.settings.poster_url | escape }}"
        {% endif %}
      >
        <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
      </video>
    {% elsif section.settings.image != blank %}
      {%- assign ff_alt = section.settings.image_alt -%}
      {% render 'media-img',
         image: section.settings.image,
         alt: ff_alt,
         class: 'split-media__img',
         widths: '600, 900, 1200',
         width_default: 1200,
         sizes: '(max-width: 768px) 100vw, 50vw',
         loading: 'lazy',
         position: 'css' %}
    {% elsif section.settings.image_asset != blank %}
      {%- assign ff_alt_a = section.settings.image_alt -%}
      {%- assign ff_src_a = section.settings.image_asset | asset_url -%}
      {% render 'media-img',
         url: ff_src_a,
         alt: ff_alt_a,
         class: 'split-media__img',
         loading: 'lazy',
         position: 'css' %}
    {% elsif section.settings.image_url != blank %}
      {%- assign ff_alt_u = section.settings.image_alt -%}
      {% render 'media-img',
         url: section.settings.image_url,
         alt: ff_alt_u,
         class: 'split-media__img',
         loading: 'lazy',
         position: 'css' %}
    {% elsif section.settings.video_asset != blank %}
      <video
        class="split-media__video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        disablepictureinpicture
      >
        <source src="{{ section.settings.video_asset | asset_url }}" type="video/mp4">
      </video>
    {% else %}
      <div class="split-media__placeholder">
        {{ section.settings.image_alt | default: 'Media placeholder' }}
      </div>
    {% endif %}
    {%- if ff_pic %}</picture>{% endif %}
    </div>
  </div>{% endif %}
  <div class="split-text align-editorial" style="background: {{ panel_bg }};">
    <div class="split-text__stack">
      {% if show_trust_strip %}
        <div class="split-trust split-trust--with-text">
          <span class="split-trust__stars" aria-hidden="true">★★★★★</span>
          {% if trust_text != blank %}
            <span class="split-trust__text">{{ trust_text | escape }}</span>
          {% endif %}
        </div>
      {% endif %}
      {% if section.settings.title != blank %}
        {% case heading_level %}
          {% when 'h1' %}
            <h1 class="split-text__title {{ heading_class }}">{{ section.settings.title }}</h1>
          {% when 'h3' %}
            <h3 class="split-text__title {{ heading_class }}">{{ section.settings.title }}</h3>
          {% when 'h4' %}
            <h4 class="split-text__title {{ heading_class }}">{{ section.settings.title }}</h4>
          {% when 'h5' %}
            <h5 class="split-text__title {{ heading_class }}">{{ section.settings.title }}</h5>
          {% when 'h6' %}
            <h6 class="split-text__title {{ heading_class }}">{{ section.settings.title }}</h6>
          {% else %}
            <h2 class="split-text__title {{ heading_class }}">{{ section.settings.title }}</h2>
        {% endcase %}
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="split-text__body type-body">{{ section.settings.body }}</p>
      {% endif %}
      {% if section.blocks.size > 0 %}
        <ul class="problem-list" style="margin-top: var(--pr-copy-stack-gap, 12px);">
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              <li {{ block.shopify_attributes }}>
                <span class="problem-list__x" aria-hidden="true">×</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a href="{{ cta_href | default: '#variants' }}" class="btn {{ cta_btn_class }} split-cta problem-section__cta">{{ section.settings.cta_text }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  {%- if section.settings.heading_size_override != blank %}
  #shopify-section-{{ section.id }} { {% render 'type-override-vars', title_size: section.settings.heading_size_override %} --te-title-size-n: {{ section.settings.heading_size_override }}; }
  {%- endif %}
  /* Section rhythm (fix-forward 2026-08-09): band lives on the Shopify
     section WRAPPER so neighbouring fifty-fifties never weld — without
     insetting the media column. Prior padding-block on .split-section left
     64px empty bands above/below the image inside the section frame. */
  #shopify-section-{{ section.id }} {
    --ff-section-gap: {{ section_gap }}px;
    --ff-section-gap-m: {{ section_gap_m }}px;
    --ff-text-pad-top-d: {{ text_pad_top_d }}px;
    --ff-text-pad-bottom-d: {{ text_pad_bottom_d }}px;
    --ff-text-pad-top-m: {{ text_pad_m }}px;
    --ff-text-pad-bottom-m: {{ text_pad_bottom_m }}px;
    --ff-text-pad-x-m: {{ text_pad_x_m }}px;
    padding-block: var(--ff-section-gap, var(--section-padding-y, 32px));
    box-sizing: border-box;
    background: {{ panel_bg }};
  }
  /* Visible air you named: hero → mosaic tiles = 16 (mosaic pad). Cream, not white. */
  #shopify-section-{{ section.id }}:has(#never-loses-grip) {
    padding-bottom: 16px;
  }
  #shopify-section-{{ section.id }}:has(#never-loses-grip) + .shopify-section .section-frame {
    margin-top: 0 !important;
  }
  #shopify-section-{{ section.id }} .split-section {
    display: grid;
    grid-template-columns: var(--ff-media-fr, 1fr) var(--ff-text-fr, 1fr);
    gap: 0;
    align-items: stretch;
    min-height: var(--ff-min-height, 560px);
    padding-block: 0;
    box-sizing: border-box;
    overflow: hidden;
    border-radius: var(--ff-media-radius, 0);
  }
  #shopify-section-{{ section.id }} .split-section--reverse {
    grid-template-columns: var(--ff-text-fr, 1fr) var(--ff-media-fr, 1fr);
  }
  #shopify-section-{{ section.id }} .split-section--reverse .split-media { order: 2; }
  #shopify-section-{{ section.id }} .split-section--reverse .split-text { order: 1; }
  #shopify-section-{{ section.id }} .split-media {
    position: relative;
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    contain: paint;
    align-self: stretch;
    height: 100%;
    min-height: var(--ff-min-height, 560px);
    border-radius: var(--ff-media-radius, 0);
    clip-path: inset(0 round var(--ff-media-radius, 0px));
    -webkit-clip-path: inset(0 round var(--ff-media-radius, 0px));
  }
  #shopify-section-{{ section.id }} .split-media__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    contain: paint;
    border-radius: var(--ff-media-radius, 0);
    clip-path: inset(0 round var(--ff-media-radius, 0px));
    -webkit-clip-path: inset(0 round var(--ff-media-radius, 0px));
  }
  /* Square media column — packshots fill the frame under cover without
     landscape toe-clip. Section grows with the column width (≥ min_height). */
  #shopify-section-{{ section.id }} .split-section--media-square .split-media {
    aspect-ratio: 1 / 1;
    width: 100%;
    height: auto;
    min-height: var(--ff-min-height, 560px);
  }
  /* Round media only on the outer edge (away from the text column) */
  #shopify-section-{{ section.id }} .split-section--media-outer-radius .split-media {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }
  #shopify-section-{{ section.id }} .split-section--media-outer-radius.split-section--reverse .split-media {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: var(--ff-media-radius, 0);
    border-bottom-right-radius: var(--ff-media-radius, 0);
  }
  #shopify-section-{{ section.id }} .split-media__img,
  #shopify-section-{{ section.id }} .split-media__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--ff-object-position, center);
    display: block;
    position: absolute;
    inset: 0;
    transform: scale(var(--ff-image-scale, 1));
    transform-origin: var(--ff-object-position, center);
  }
  /* PDP fit-in-frame lives at the end of this tag — Home --fit still collapses. */
  /* Full-bleed media law (Andrew 2026-08-08): Cover mode only. Fit and
     packshot-contain are excluded — :not(contain) was winning over Fit
     and forcing object-fit: cover (2026-08-17). */
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media {
    padding: 0;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media__img,
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media__video {
    padding: 0;
    margin: 0;
    max-width: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--ff-object-position, center);
  }
  /* Cover inset (sit in panel): modest pad inside media column; media still object-fit cover */
  #shopify-section-{{ section.id }} .split-section--cover-inset .split-media {
    padding: 28px;
    box-sizing: border-box;
    background: {{ media_pad_bg }};
  }
  #shopify-section-{{ section.id }} .split-section--cover-inset .split-media__clip {
    border-radius: 4px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .split-section--cover-inset .split-media__img,
  #shopify-section-{{ section.id }} .split-section--cover-inset .split-media__video {
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .split-section--contain .split-media {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .split-section--contain .split-media__img {
    position: relative;
    inset: auto;
    width: var(--ff-contain-width, 72%);
    max-width: 420px;
    height: auto;
    object-fit: contain;
    object-position: var(--ff-object-position, center);
    padding: 48px 24px;
    transform: scale(var(--ff-image-scale, 1));
    transform-origin: center center;
  }
  /* Fit = natural photo (Andrew 2026-08-17). Column width owns the
     image. Height follows the file. No 560 crop. No letterbox. */
  #shopify-section-{{ section.id }} .split-section.split-section--fit {
    min-height: 0;
  }
  #shopify-section-{{ section.id }} .split-section.split-section--fit .split-media {
    padding: 0;
    margin: 0;
    height: auto;
    min-height: 0;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .split-section.split-section--fit .split-media__clip,
  #shopify-section-{{ section.id }} .split-section--contain .split-media__clip {
    position: relative;
    inset: auto;
    height: auto;
    min-height: inherit;
  }
  #shopify-section-{{ section.id }} .split-section.split-section--fit .split-media__img,
  #shopify-section-{{ section.id }} .split-section.split-section--fit .split-media__video {
    position: relative;
    inset: auto;
    width: 100%;
    height: auto;
    max-width: none;
    padding: 0;
    margin: 0;
    object-fit: unset;
    transform: none;
    display: block;
  }
  #shopify-section-{{ section.id }} .split-media__placeholder {
    width: 100%;
    height: 100%;
    min-height: var(--ff-min-height, 560px);
    background: linear-gradient(135deg, #c9c5b8, #e9d3cb);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: var(--text-muted, #8a8a8a);
    padding: var(--space-8, 32px);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .split-text {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    box-sizing: border-box;
    padding: var(--ff-text-pad-top-d, 96px) var(--ff-side-padding, 64px) var(--ff-text-pad-bottom-d, 96px);
    background: var(--ff-panel-bg, {{ panel_bg }});
    overflow: hidden;
    border-radius: var(--ff-text-radius, 0);
    clip-path: inset(0 round var(--ff-text-radius, 0px));
    -webkit-clip-path: inset(0 round var(--ff-text-radius, 0px));
    text-align: var(--align-editorial, left);
  }
  /* Desktop: fill grid row height; center the copy stack as one block (symmetric air). */
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .split-text {
      min-height: 100%;
    }
    #shopify-section-{{ section.id }} .split-text__stack {
      margin-block: auto;
    }
  }
  #shopify-section-{{ section.id }} .split-text__stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    margin-block: 0;
  }
  #shopify-section-{{ section.id }} .split-text__stack > :first-child {
    margin-top: 0 !important;
  }
  #shopify-section-{{ section.id }} .split-text__stack > :last-child {
    margin-bottom: 0 !important;
  }
  #shopify-section-{{ section.id }} .split-text__title {
    font-family: var(--font-family, 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif);
    max-width: none !important;
    margin: 0 0 var(--gap-b, 20px);
    text-transform: none;
  }
  #shopify-section-{{ section.id }} .split-text__title em {
    font-style: normal;
    font-weight: 400;
    color: #6b645a;
  }
  /* GLOBAL HEADING SYSTEM (locked 2026-09-27): one fifty-fifty heading on every page.
     No TE title size/weight vars; register (display/supporting/standard) and content_style
     "statement" all render the same. Typed <strong>/<b> inherit 400. */
  #shopify-section-{{ section.id }} .split-text__title,
  #shopify-section-{{ section.id }} .split-text__title.h2-display,
  #shopify-section-{{ section.id }} .split-text__title.h2-standard,
  #shopify-section-{{ section.id }} .split-text__title.h2-supporting,
  #shopify-section-{{ section.id }} .split-text__title.type-statement {
    font-size: clamp(var(--heading-phone, 36px), calc(var(--te-title-size-n, var(--heading-standard-desktop-n, 56)) * 4.8vw / 56), var(--te-title-size, var(--heading-standard-desktop, 56px)));
    font-weight: 400;
    line-height: var(--heading-standard-leading, 1.06);
    letter-spacing: var(--heading-standard-tracking, -0.032em);
    text-wrap: pretty; /* avoid one-word last lines (2026-09-27, Andrew) */
  }
  #shopify-section-{{ section.id }} .split-text__title strong,
  #shopify-section-{{ section.id }} .split-text__title b {
    font-weight: inherit;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .split-text__title,
    #shopify-section-{{ section.id }} .split-text__title.h2-display,
    #shopify-section-{{ section.id }} .split-text__title.h2-standard,
    #shopify-section-{{ section.id }} .split-text__title.h2-supporting,
    #shopify-section-{{ section.id }} .split-text__title.type-statement {
      font-size: var(--heading-phone, 36px);
    }
  }
  #shopify-section-{{ section.id }} .split-text__body--quiet {
    color: #6b645a;
    max-width: 32ch;
  }
  #shopify-section-{{ section.id }} .split-text__eyebrow {
    font-size: var(--type-label-size, 11px);
    text-transform: uppercase;
    letter-spacing: var(--type-label-tracking, 0.08em);
    color: var(--type-label-color, #6b645a);
    font-weight: var(--type-label-weight, 600);
    margin: 0 0 var(--gap-a, 16px);
  }
  #shopify-section-{{ section.id }} .split-text__title.h2-display,
  #shopify-section-{{ section.id }} .split-text__title.h2-standard,
  #shopify-section-{{ section.id }} .split-text__title.h2-supporting {
    margin: 0 0 var(--gap-b, 20px);
  }
  /* Global heading system 2026-09-27: body locked 17 / 1.70 (TE body size ignored). */
  #shopify-section-{{ section.id }} .split-text__body {
    font-family: var(--font-family, 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 17px;
    font-weight: var(--ff-body-weight, var(--type-body-weight, 400));
    color: var(--text-body, #4a4a4a);
    line-height: 1.70;
    margin: 0 0 var(--gap-c, 32px);
    max-width: 36ch;
  }
  #shopify-section-{{ section.id }} .split-cta {
    width: fit-content;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: 0;
      padding-bottom: var(--ff-section-gap-m, 0px);
    }
    #shopify-section-{{ section.id }} .split-section {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: 0;
      {% if template.name == 'product' %}
      gap: 0;
      row-gap: 0;
      {% endif %}
    }
    #shopify-section-{{ section.id }} .split-section--reverse .split-media,
    #shopify-section-{{ section.id }} .split-section--reverse .split-text { order: 0; }
    #shopify-section-{{ section.id }} .split-media {
      aspect-ratio: auto;
      width: var(--ff-mobile-media-width, 100%);
      max-width: 100%;
      margin-inline: auto;
      height: var(--ff-mobile-media-height, var(--split-media-h-mobile, 500px));
      min-height: var(--ff-mobile-media-height, var(--split-media-h-mobile, 500px));
    }
    /* Phone square frame — 1/1; height follows width (ignore height slider). */
    #shopify-section-{{ section.id }} .split-section--media-square-m .split-media {
      aspect-ratio: 1 / 1;
      width: 100%;
      height: auto;
      min-height: 0;
    }
    #shopify-section-{{ section.id }} .split-section.split-section--fit .split-media,
    #shopify-section-{{ section.id }} .split-section.split-section--fit-m .split-media {
      height: auto;
      min-height: 0;
    }
    #shopify-section-{{ section.id }} .split-section.split-section--fit-m .split-media__clip {
      position: relative;
      inset: auto;
      height: auto;
      min-height: 0;
    }
    #shopify-section-{{ section.id }} .split-section.split-section--fit-m .split-media__img,
    #shopify-section-{{ section.id }} .split-section.split-section--fit-m .split-media__video {
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
      max-width: none;
      object-fit: unset;
      transform: none;
    }
    #shopify-section-{{ section.id }} .split-section.split-section--contain-m .split-media {
      height: auto;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    #shopify-section-{{ section.id }} .split-section.split-section--contain-m .split-media__clip {
      position: relative;
      inset: auto;
      height: auto;
    }
    #shopify-section-{{ section.id }} .split-section.split-section--contain-m .split-media__img {
      position: relative;
      inset: auto;
      width: var(--ff-contain-width, 72%);
      max-width: 420px;
      height: auto;
      object-fit: contain;
    }
    #shopify-section-{{ section.id }} .split-section--media-outer-radius .split-media,
    #shopify-section-{{ section.id }} .split-section--media-outer-radius.split-section--reverse .split-media {
      border-radius: var(--ff-media-radius, 0);
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }
    #shopify-section-{{ section.id }} .split-text {
      padding: var(--ff-text-pad-top-m, 32px) var(--ff-text-pad-x-m, var(--section-padding-x-mobile, 20px)) var(--ff-text-pad-bottom-m, 32px);
    }
    {%- if mobile_text_height > 0 %}
    /* Fixed phone text column: center the stack inside equal top/bottom pad. */
    #shopify-section-{{ section.id }} .split-text {
      min-height: {{ mobile_text_height }}px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding-top: {{ text_pad_m }}px;
      padding-bottom: {{ text_pad_m }}px;
    }
    #shopify-section-{{ section.id }} .split-text__stack {
      margin-block: auto;
    }
    {%- endif %}
  }

  /* Quote composition — Cormorant ~28px default; Title size/weight scale quote */
  #shopify-section-{{ section.id }} .split-trust {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    line-height: 1;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .split-trust__stars,
  #shopify-section-{{ section.id }} .split-quote__stars {
    color: var(--ff-quote-star, #d4af37);
    font-size: 15px;
    letter-spacing: 0.22em;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .split-trust__text {
    font-size: 13px;
    font-weight: 400;
    color: #4a4a4a;
    letter-spacing: 0;
  }
  #shopify-section-{{ section.id }} .split-quote__text {
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-size: var(--ff-title-size, 28px);
    font-style: var(--ff-quote-style, italic);
    font-weight: var(--ff-title-weight, 400);
    color: #1c1916;
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
    max-width: 34ch;
  }
  #shopify-section-{{ section.id }} .split-quote__author {
    font-family: var(--font-family, 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 12px;
    font-weight: 600;
    color: #1c1916;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 8px;
    line-height: 1.35;
  }
  #shopify-section-{{ section.id }} .split-quote__author--sentence {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  #shopify-section-{{ section.id }} .split-quote__meta {
    font-family: var(--font-family, 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 14px;
    font-weight: 400;
    color: #6b645a;
    letter-spacing: 0.01em;
    line-height: 1.5;
    margin: 0;
    max-width: 36ch;
  }
  #shopify-section-{{ section.id }} .split-text--quote .split-quote__author:last-child,
  #shopify-section-{{ section.id }} .split-text--quote .split-quote__meta:last-of-type {
    margin-bottom: 0;
  }
  #shopify-section-{{ section.id }} .split-cta--after-stack {
    margin-top: 32px;
  }

  /* Stats composition — rust bar color TE; prefer Stat blocks */
  #shopify-section-{{ section.id }} .split-text--stats .split-text__eyebrow {
    margin: 0 0 32px;
    color: #6b645a;
  }
  #shopify-section-{{ section.id }} .split-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    margin-bottom: 0;
  }
  #shopify-section-{{ section.id }} .split-stat {
    border-left: 3px solid var(--ff-stat-bar, #c45c3f);
    padding-left: 20px;
  }
  #shopify-section-{{ section.id }} .split-stat__value {
    font-size: 32px;
    font-weight: 700;
    color: #1c1916;
    margin: 0;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .split-stat__value--line {
    font-size: 22px;
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .split-stat__label {
    font-size: 14px;
    color: #4a4a4a;
    margin: 6px 0 0;
    line-height: 1.4;
  }
  /* PERMANENT 50/50 IMAGE RULE — ALL cover 50/50s. Last wins. Do not revert.
     Fill = 100% width + 100% height of the media panel. Cover. No contain.
     No fit. No letterbox. Frame stays (--ff-min-height / --ff-mobile-media-height).
     Fit / contain / fit-m / contain-m stay excluded. */
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media__clip,
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media__img,
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media__img,
  #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit) .split-media__video {
    object-fit: cover;
    object-position: var(--ff-object-position, center);
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit):not(.split-section--fit-m):not(.split-section--contain-m):not(.split-section--media-square-m) .split-media {
      position: relative;
      align-self: stretch;
      width: 100%;
      height: var(--ff-mobile-media-height, var(--split-media-h-mobile, 500px));
      min-height: var(--ff-mobile-media-height, var(--split-media-h-mobile, 500px));
      aspect-ratio: auto;
      overflow: hidden;
      background: transparent;
    }
    #shopify-section-{{ section.id }} .split-section.split-section--media-square-m:not(.split-section--contain):not(.split-section--fit):not(.split-section--fit-m):not(.split-section--contain-m) .split-media {
      position: relative;
      align-self: stretch;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: transparent;
    }
    #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit):not(.split-section--fit-m):not(.split-section--contain-m) .split-media__clip,
    #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit):not(.split-section--fit-m):not(.split-section--contain-m) .split-media__img,
    #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit):not(.split-section--fit-m):not(.split-section--contain-m) .split-media__video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      max-width: none;
    }
    #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit):not(.split-section--fit-m):not(.split-section--contain-m) .split-media__img,
    #shopify-section-{{ section.id }} .split-section:not(.split-section--contain):not(.split-section--fit):not(.split-section--fit-m):not(.split-section--contain-m) .split-media__video {
      object-fit: cover;
      object-position: var(--ff-object-position-m, var(--ff-object-position, center));
    }
  }
  /* PDP 50/50 only (Andrew 2026-09-09). Closed is the standard:
     mobile 550 · desktop min 560 · text may grow desktop.
     cover / fit = image inside that frame. fit must not collapse it.
     Home / Shop All / Apparel --fit still collapses. No JSON / crop change. */

  #shopify-section-{{ section.id }} .problem-list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .problem-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid #d6cfc0;
    font-size: 15px;
    color: #4a4a4a;
    line-height: 1.45;
  }
  #shopify-section-{{ section.id }} .problem-list li:last-child { border-bottom: 1px solid #d6cfc0; }
  #shopify-section-{{ section.id }} .problem-list__x {
    color: #c45c3f;
    font-weight: 700;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .split-text__body {
    margin-bottom: 0;
    max-width: 38ch;
  }
  #shopify-section-{{ section.id }} .split-cta.problem-section__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    line-height: var(--type-cta-leading, 1);
    text-transform: uppercase;
    border-radius: 4px;
    margin-top: 28px;
    transition: opacity 0.15s ease;
  }
  #shopify-section-{{ section.id }} .split-cta.problem-section__cta:hover {
    opacity: 0.92;
  }
  #shopify-section-{{ section.id }} .split-cta.problem-section__cta.btn--brand-outline:hover,
  #shopify-section-{{ section.id }} .split-cta.problem-section__cta.btn--secondary:hover {
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .split-text__title {
    text-wrap: balance;
  }
  #shopify-section-{{ section.id }} .split-section--text-only {
    grid-template-columns: 1fr !important;
  }
</style>


{% style %}
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .split-section {
    --ff-min-height: {{ section.settings.min_height }}px !important;
    {%- if section.settings.mobile_media_height > 0 %}
    --ff-mobile-media-height: {{ section.settings.mobile_media_height }}px !important;
    {%- else %}
    --ff-mobile-media-height: var(--split-media-h-mobile, 500px) !important;
    {%- endif %}
    {%- if template.name == 'product' %}
        {%- else %}
        {%- endif %}
    --ff-mobile-media-width: {{ section.settings.mobile_media_width | default: 100 }}% !important;
    --ff-media-fr: {{ section.settings.media_column_pct }}fr !important;
    --ff-text-fr: {{ 100 | minus: section.settings.media_column_pct }}fr !important;
    {%- if section.settings.image_position == 'custom' %}
    --ff-object-position: {{ section.settings.focal_x | default: 50 }}% {{ section.settings.focal_y | default: 50 }}% !important;
    {%- elsif section.settings.image_position != blank and section.settings.image_position != 'center' %}
    --ff-object-position: {{ section.settings.image_position }} !important;
    {%- else %}
    --ff-object-position: center !important;
    {%- endif %}
    {%- assign te_pos_m = section.settings.image_position_mobile | default: 'same' -%}
    {%- if te_pos_m == 'same' or te_pos_m == blank -%}
      {%- if section.settings.image_position == 'custom' -%}
    --ff-object-position-m: {{ section.settings.focal_x | default: 50 }}% {{ section.settings.focal_y | default: 50 }}% !important;
        {%- if section.settings.focal_x != 50 or section.settings.focal_y != 50 -%}
    --ff-object-position-fit-m: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}% !important;
        {%- else -%}
    --ff-object-position-fit-m: center top !important;
        {%- endif -%}
      {%- elsif section.settings.image_position != blank and section.settings.image_position != 'center' -%}
    --ff-object-position-m: {{ section.settings.image_position }} !important;
    --ff-object-position-fit-m: {{ section.settings.image_position }} !important;
      {%- else -%}
    --ff-object-position-m: center !important;
    --ff-object-position-fit-m: center top !important;
      {%- endif -%}
    {%- elsif te_pos_m == 'custom' -%}
    --ff-object-position-m: {{ section.settings.focal_x_mobile | default: 50 }}% {{ section.settings.focal_y_mobile | default: 50 }}% !important;
    --ff-object-position-fit-m: {{ section.settings.focal_x_mobile | default: 50 }}% {{ section.settings.focal_y_mobile | default: 50 }}% !important;
    {%- else -%}
    --ff-object-position-m: {{ te_pos_m }} !important;
    --ff-object-position-fit-m: {{ te_pos_m }} !important;
    {%- endif -%}
    --ff-image-scale: {{ section.settings.image_scale | default: 100 | times: 1.0 | divided_by: 100.0 }} !important;
    --ff-contain-width: {{ section.settings.contain_width | default: 72 }}% !important;
    --ff-media-radius: {{ section.settings.media_radius | default: 0 }}px !important;
    --ff-text-radius: {{ section.settings.media_radius | default: 0 }}px !important;
    --ff-side-padding: {{ section.settings.side_padding | default: 40 }}px !important;
    --ff-text-pad-top-d: {{ section.settings.text_pad_y | default: 96 }}px !important;
    --ff-text-pad-bottom-d: {{ section.settings.text_pad_y | default: 96 }}px !important;
    --ff-section-gap: {{ section.settings.section_gap | default: 0 }}px !important;
    --ff-section-gap-m: {{ section.settings.section_gap_mobile | default: 0 }}px !important;
    --ff-text-pad-top-m: {{ section.settings.text_pad_y_mobile | default: 80 }}px !important;
    --ff-text-pad-bottom-m: {{ section.settings.text_pad_y_mobile | default: 80 }}px !important;
    --ff-text-pad-x-m: {{ section.settings.text_pad_x_mobile | default: 16 }}px !important;
    {%- if section.settings.bg_style == 'white' -%}
    --ff-panel-bg: #ffffff !important;
    {%- elsif section.settings.bg_style == 'cream' -%}
    --ff-panel-bg: #faf8f6 !important;
    {%- elsif section.settings.bg_style == 'darker_cream' -%}
    --ff-panel-bg: #efe9dd !important;
    {%- elsif section.settings.bg_preset == 'white' -%}
    --ff-panel-bg: #ffffff !important;
    {%- elsif section.settings.bg_preset == 'cream' -%}
    --ff-panel-bg: #faf8f6 !important;
    {%- else -%}
    --ff-panel-bg: {{ section.settings.bg_color | default: '#faf8f6' }} !important;
    {%- endif -%}
    --ff-media-pad-bg: {{ section.settings.media_bg | default: '#ffffff' }} !important;
    --ff-quote-star: #d4af37 !important;
    --ff-quote-style: {% if section.settings.quote_italic == false %}normal{% else %}italic{% endif %} !important;
    --ff-stat-bar: #c45c3f !important;
  }
  /* Panel + media pad colours (inline background on wrapper / .split-text / .split-media). */
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .split-text {
    background: var(--ff-panel-bg) !important;
  }
  #shopify-section-{{ section.id }} .split-media {
    background: var(--ff-media-pad-bg) !important;
  }
  {% endstyle %}

