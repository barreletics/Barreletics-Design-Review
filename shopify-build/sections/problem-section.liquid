{% schema %}
{
  "name": "Problem section",
  "settings": [
    {
      "type": "header",
      "content": "1 — Photo / video"
    },
    {
      "type": "paragraph",
      "content": "Pick ONE. Priority: Shopify video → Video URL → Shopify image → Image URL."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video",
      "info": "Preferred when the file lives in Shopify Files. Use this OR Video URL — not both."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (mp4)",
      "info": "External/CDN mp4. Ignored if Shopify video is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image / poster (Shopify)",
      "info": "Still image, or poster when using Video URL."
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "Video poster: still before video loads",
      "info": "Used when Video URL is set and Image / poster (Shopify) is empty."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "info": "Used when Shopify image is empty (and no video)."
