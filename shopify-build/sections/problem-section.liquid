{% comment %}
  Problem section — Home WORKING 12b. Cream beat with optional muted media + copy split.
{% endcomment %}

{%- liquid
  assign cta_style = section.settings.cta_style | default: 'solid'
  assign cta_bg = section.settings.cta_bg_color | default: '#c45c3f'
  assign cta_border = section.settings.cta_border_color | default: cta_bg
  assign cta_text_color = section.settings.cta_text_color | default: '#ffffff'
  if cta_style == 'outline'
    assign _cta_tc = cta_text_color | downcase
    if _cta_tc == '#ffffff' or _cta_tc == '#fff' or _cta_tc == 'white' or cta_text_color == blank
      assign cta_text_color = cta_border
    endif
  endif
  assign mobile_media_height = section.settings.mobile_media_height | default: 520
  assign copy_stack_gap = section.settings.copy_stack_gap | default: 16
  assign reverse = section.settings.reverse
  assign mobile_stack_order = section.settings.mobile_stack_order | default: 'media_first'
  assign media_fit = section.settings.media_fit | default: 'cover'
  assign image_fit_mobile = section.settings.image_fit_mobile | default: 'cover'
  assign media_aspect = section.settings.media_aspect | default: 'stretch'
  assign min_height = section.settings.min_height | default: 860


  assign has_media = false
  if section.settings.video != blank
    assign has_media = true
  elsif section.settings.video_url != blank
    assign has_media = true
  elsif section.settings.image != blank
    assign has_media = true
  elsif section.settings.video_asset != blank
    assign has_media = true
  endif

  # Media priority: Shopify video → Video URL → Image → theme asset (last)
  assign video_src = section.settings.video_url | strip
  assign video_asset = section.settings.video_asset | default: '' | strip
  assign video_source_type = 'video/mp4'
  if video_src contains '.mov'
    assign video_source_type = 'video/quicktime'
  endif

  assign poster_url = ''
  if section.settings.image != blank
    assign poster_url = section.settings.image | image_url: width: 1600
  endif
-%}
<section
  class="section-frame{% if section.settings.hide_on_mobile %} section-frame--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} section-frame--hide-desktop{% endif %} problem-section{% if has_media %} problem-section--with-media{% endif %}{% if reverse %} problem-section--reverse{% endif %}{% if mobile_stack_order == 'copy_first' %} problem-section--copy-first{% else %} problem-section--media-first{% endif %}{% if media_aspect == 'square' %} problem-section--media-square{% endif %}{% if media_fit == 'contain' or media_fit == 'fit' %} problem-section--media-contain{% endif %}{% if image_fit_mobile == 'fit' or image_fit_mobile == 'contain' %} problem-section--fit-mobile{% endif %}{% if media_fit == 'contain' %} problem-section--media-contain{% endif %}"
  id="{{ section.settings.anchor_id | default: 'problem' | handleize }}"
  aria-label="{{ section.settings.title | escape }}"
  style="{% render 'section-inset-vars' %} --pr-cta-bg: {{ cta_bg }}; --pr-cta-border: {{ cta_border }}; --pr-cta-text: {{ cta_text_color }}; --pr-mobile-media-height: {{ mobile_media_height }}px; --pr-desk-media-min: {{ min_height }}px; --pr-copy-stack-gap: {{ copy_stack_gap }}px;"
>
  <div class="problem-shell">
    <div class="problem-layout{% if has_media %} problem-layout--with-media{% endif %}">
      {% if has_media %}
        <div class="problem-media">
          <div class="problem-media__clip">
            {% if section.settings.video != blank %}
              {{
                section.settings.video
                | video_tag:
                  image_size: '1600x',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  class: 'problem-media__video'
              }}
            {% elsif video_src != blank %}
              <video
                class="problem-media__video"
                autoplay
                muted
                loop
                playsinline
                webkit-playsinline
                preload="auto"
                disablepictureinpicture
                {% if poster_url != blank %}poster="{{ poster_url | escape }}"{% endif %}
              >
                <source src="{{ video_src | escape }}" type="{{ video_source_type }}">
              </video>
            {% elsif section.settings.image != blank %}
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag:
                  widths: '600, 900, 1200, 1600',
                  sizes: '(max-width: 768px) 100vw, 50vw',
                  alt: section.settings.title,
                  loading: 'lazy',
                  class: 'problem-media__img'
              }}
            {% elsif video_asset != blank %}
              <video
                class="problem-media__video"
                autoplay
                muted
                loop
                playsinline
                webkit-playsinline
                preload="auto"
                disablepictureinpicture
              >
                <source src="{{ video_asset | asset_url }}" type="video/mp4">
              </video>
            {% else %}
              <div class="problem-media__placeholder" aria-hidden="true"></div>
            {% endif %}
          </div>
        </div>
      {% endif %}
      <div class="problem-inner">
        <div>
          <h2 class="problem-title h2-display">{{ section.settings.title }}</h2>
          {% if section.settings.body != blank %}
            <p class="problem-body">{{ section.settings.body }}</p>
          {% endif %}
        </div>
        <div>
          {% if section.blocks.size > 0 %}
            <ul class="problem-list">
              {% for block in section.blocks %}
                {% if block.settings.text != blank %}
                <li {{ block.shopify_attributes }}>
                  <span class="problem-list__x" aria-hidden="true">×</span>
                  <span>{{ block.settings.text }}</span>
                </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
          {% if section.settings.cta_text != blank %}
            <div class="problem-resolve">
              <a class="problem-resolve__cta{% if cta_style == 'outline' %} problem-resolve__cta--outline{% endif %}" href="{{ section.settings.cta_url | default: '#variants' }}">
                {{ section.settings.cta_text }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .problem-section {
    padding: 72px 40px;
    background: #faf8f6;
  }
  {% if template.name == 'collection' %}
  #shopify-section-{{ section.id }} .problem-section {
    background: #faf8f6;
  }
  {% endif %}
  .problem-shell {
    max-width: 1100px;
    margin: 0 auto;
  }
  /* Media column = One Pair 50/50 law: column stretches, clip fills column, Cover. */
  #shopify-section-{{ section.id }} .problem-layout--with-media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
    max-width: none;
    min-height: var(--pr-desk-media-min, 860px);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media .problem-shell {
    max-width: none;
  }
  #shopify-section-{{ section.id }} .problem-media {
    position: relative;
    align-self: stretch;
    height: 100%;
    min-height: var(--pr-desk-media-min, 860px);
    overflow: hidden;
    background: #f0ebe4;
  }
  #shopify-section-{{ section.id }} .problem-media__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 0;
    background: #f0ebe4;
  }
  #shopify-section-{{ section.id }} .problem-section--media-square .problem-media {
    aspect-ratio: 1 / 1;
    height: auto;
    min-height: var(--pr-desk-media-min, 860px);
  }
  #shopify-section-{{ section.id }} .problem-media__video,
  #shopify-section-{{ section.id }} .problem-media__img,
  #shopify-section-{{ section.id }} .problem-media__clip video,
  #shopify-section-{{ section.id }} .problem-media__clip img,
  #shopify-section-{{ section.id }} .problem-media__placeholder {
    display: block;
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    object-fit: cover !important;
    object-position: center center;
  }
  #shopify-section-{{ section.id }} .problem-media__placeholder {
    background: linear-gradient(135deg, #e8e2da, #f0ebe4);
    object-fit: unset !important;
  }
  #shopify-section-{{ section.id }} .problem-section--media-contain .problem-media__video,
  #shopify-section-{{ section.id }} .problem-section--media-contain .problem-media__img,
  #shopify-section-{{ section.id }} .problem-section--media-contain .problem-media__clip video,
  #shopify-section-{{ section.id }} .problem-section--media-contain .problem-media__clip img {
    object-fit: contain !important;
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media .problem-inner {
    padding: 72px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .problem-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media .problem-inner {
    grid-column: auto;
    grid-template-columns: 1fr;
    gap: var(--pr-copy-stack-gap, 28px);
  }
  .problem-title {
    max-width: none;
    margin: 0 0 var(--gap-b);
  }
  .problem-body {
    font-size: var(--type-body-size);
    font-weight: var(--type-body-weight);
    color: var(--text-body);
    line-height: var(--type-body-leading);
    margin: 0;
    max-width: 38ch;
  }
  .problem-layout--with-media .problem-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .problem-layout--with-media .problem-list,
  .problem-layout--with-media .problem-resolve {
    /* list block starts after title/body */
  }
  .problem-layout--with-media .problem-inner > div:last-child {
    margin-top: var(--pr-copy-stack-gap, 12px);
  }
  .problem-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .problem-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid #d6cfc0;
    font-size: 15px;
    color: #4a4a4a;
    line-height: 1.45;
  }
  .problem-list li:last-child { border-bottom: 1px solid #d6cfc0; }
  .problem-list__x {
    color: #c45c3f;
    font-weight: 700;
    flex-shrink: 0;
  }
  .problem-resolve {
    margin-top: 28px;
    padding-top: 0;
    border-top: none;
  }
  #shopify-section-{{ section.id }} .problem-resolve__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: var(--type-cta-min-height);
    padding: var(--type-cta-pad-y) var(--type-cta-pad-x);
    background: var(--pr-cta-bg, #c45c3f);
    color: var(--pr-cta-text, #fff);
    font-size: var(--type-cta-size);
    font-weight: var(--type-cta-weight);
    letter-spacing: var(--type-cta-tracking);
    line-height: var(--type-cta-leading, 1);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid var(--pr-cta-border, var(--pr-cta-bg, #c45c3f));
    transition: opacity 0.15s ease;
  }
  #shopify-section-{{ section.id }} .problem-resolve__cta--outline {
    background: transparent;
    /* Outline ink = remapped --pr-cta-text (white→border in liquid). Border fallback if unset. */
    color: var(--pr-cta-text, var(--pr-cta-border, #c45c3f));
    border-color: var(--pr-cta-border, #c45c3f);
  }
  #shopify-section-{{ section.id }} .problem-resolve__cta:hover { opacity: 0.92; }
  #shopify-section-{{ section.id }} .problem-resolve__cta--outline:hover { opacity: 0.85; }
  
  /* Desk L/R — same mechanism as fifty-fifty reverse (CSS order, not % crop) */
  #shopify-section-{{ section.id }} .problem-layout--with-media {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  #shopify-section-{{ section.id }} .problem-layout--with-media .problem-media { order: 1; }
  #shopify-section-{{ section.id }} .problem-layout--with-media .problem-inner { order: 2; }
  #shopify-section-{{ section.id }} .problem-section--reverse .problem-layout--with-media .problem-media { order: 2; }
  #shopify-section-{{ section.id }} .problem-section--reverse .problem-layout--with-media .problem-inner { order: 1; }

  /* Phone U/D — same idea as fifty-fifty mobile_stack_order */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .problem-layout--with-media {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .problem-section--media-first .problem-layout--with-media .problem-media { order: 1; }
    #shopify-section-{{ section.id }} .problem-section--media-first .problem-layout--with-media .problem-inner { order: 2; }
    #shopify-section-{{ section.id }} .problem-section--copy-first .problem-layout--with-media .problem-inner { order: 1; }
    #shopify-section-{{ section.id }} .problem-section--copy-first .problem-layout--with-media .problem-media { order: 2; }
    /* reset desk reverse on phone */
    #shopify-section-{{ section.id }} .problem-section--reverse .problem-layout--with-media .problem-media,
    #shopify-section-{{ section.id }} .problem-section--reverse .problem-layout--with-media .problem-inner { order: unset; }
    #shopify-section-{{ section.id }} .problem-section--media-first.problem-section--reverse .problem-layout--with-media .problem-media { order: 1; }
    #shopify-section-{{ section.id }} .problem-section--media-first.problem-section--reverse .problem-layout--with-media .problem-inner { order: 2; }
    #shopify-section-{{ section.id }} .problem-section--copy-first.problem-section--reverse .problem-layout--with-media .problem-inner { order: 1; }
    #shopify-section-{{ section.id }} .problem-section--copy-first.problem-section--reverse .problem-layout--with-media .problem-media { order: 2; }
  }
@media (max-width: 768px) {
    .problem-section { padding: 48px 16px; }
    #shopify-section-{{ section.id }} .problem-layout--with-media {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    #shopify-section-{{ section.id }} .problem-layout--with-media {
      min-height: 0;
      gap: 0;
    }
    #shopify-section-{{ section.id }} .problem-media {
      min-height: var(--pr-mobile-media-height, 520px);
      height: var(--pr-mobile-media-height, 520px);
    }
    #shopify-section-{{ section.id }} .problem-media__clip {
      position: absolute;
      inset: 0;
      height: 100%;
      min-height: 0;
      max-height: none;
    }
    #shopify-section-{{ section.id }} .problem-layout--with-media .problem-inner {
      padding: 40px 20px;
    }
    .problem-inner {
      grid-template-columns: 1fr;
      gap: var(--pr-copy-stack-gap, 28px);
    }
    #shopify-section-{{ section.id }} .problem-media__video,
    #shopify-section-{{ section.id }} .problem-media__img {
      object-position: center center;
    }
  }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .problem-media__video,
    #shopify-section-{{ section.id }} .problem-media__img {
      object-position: center center;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .problem-section--fit-mobile .problem-media__video,
    #shopify-section-{{ section.id }} .problem-section--fit-mobile .problem-media__img {
      object-fit: contain;
    }
  }
</style>

{% if section.settings.video != blank or video_src != blank %}
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var video = root.querySelector('.problem-media__video');
    if (!video || video.hasAttribute('controls')) return;
    function kick() {
      video.muted = true;
      video.defaultMuted = true;
      video.setAttribute('muted', '');
      video.playsInline = true;
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
    }
    video.addEventListener('loadeddata', kick);
    video.addEventListener('canplay', kick);
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) kick(); });
      }, { rootMargin: '80px 0px' });
      io.observe(video);
    }
    kick();
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Problem section",
  "settings": [
    {
      "type": "header",
      "content": "Shared \u2014 Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Never slip in Chair Pose"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Never slip again in side plank or flat back chair. Try that in a barre grip sock."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA label",
      "default": "Shop Now"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "options": [
        {
          "value": "solid",
          "label": "Solid fill"
        },
        {
          "value": "outline",
          "label": "Outline only"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA background color",
      "default": "#c45c3f",
      "info": "Solid fill. Outline ignores fill; border still applies."
    },
    {
      "type": "color",
      "id": "cta_border_color",
      "label": "CTA outline / border color",
      "default": "#c45c3f"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA label color",
      "default": "#ffffff",
      "info": "Solid: usually white. Outline auto-uses border color when left white."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Media (optional)"
    },
    {
      "type": "paragraph",
      "content": "When set, shows muted looping video (or still image) beside copy. Priority: Shopify video \u2192 Video URL \u2192 Image. All videos are always muted."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "CDN/external mp4. Ignored when Shopify video is set. Legacy theme-asset filenames in saved settings still work."
    },
    {
      "type": "text",
      "id": "video_asset",
      "label": "Theme asset fallback (don't use if Shopify video/image set)",
      "info": "e.g. chair-pose-home.mp4 in Assets. Wins over Video URL."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster / still image",
      "info": "Poster for video URL, or still image when no video is set."
    },
    {
      "type": "range",
      "id": "mobile_media_height",
      "label": "Photo height \u2014 phone",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 520,
      "info": "Same control as 50/50."
    },
    {
      "type": "header",
      "content": "Media (50/50 standard)"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover (lifestyle / video)"
        },
        {
          "value": "fit",
          "label": "Fit (whole photo in the frame)"
        },
        {
          "value": "contain",
          "label": "Contain (packshot)"
        }
      ],
      "info": "Same control as 50/50."
    },
    {
      "type": "select",
      "id": "image_fit_mobile",
      "label": "Media fit \u2014 phone",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover (same as desktop)"
        },
        {
          "value": "fit",
          "label": "Fit \u2014 full photo, no crop"
        },
        {
          "value": "contain",
          "label": "Contain (packshot)"
        }
      ],
      "info": "Same control as 50/50."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Desktop min height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 860,
      "info": "Same control as 50/50. Interni-like ~640; Grip/One Pair Home often 860."
    },
    {
      "type": "select",
      "id": "media_aspect",
      "label": "Media frame shape",
      "default": "stretch",
      "options": [
        {
          "value": "stretch",
          "label": "Stretch to section height (default)"
        },
        {
          "value": "square",
          "label": "Square \u2014 packshots under cover"
        }
      ],
      "info": "Same control as 50/50."
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse layout (text left, media right)",
      "default": false,
      "info": "Desktop only (769px+)."
    },
    {
      "type": "select",
      "id": "mobile_stack_order",
      "label": "Mobile stack order",
      "default": "media_first",
      "options": [
        {
          "value": "media_first",
          "label": "Image above copy"
        },
        {
          "value": "copy_first",
          "label": "Copy above image"
        }
      ],
      "info": "Below 768px only."
    },
    {
      "type": "header",
      "content": "Section \u2014 Problem"
    },
    {
      "type": "range",
      "id": "copy_stack_gap",
      "label": "Space above bullet list",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 12,
      "info": "Smaller = bullets sit tighter under the title."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "problem"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Pain point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Grip socks that peel, stretch out, and quit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problem section",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Flat back chair & water ski \u2014 resetting mid-set"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Reformer footwork \u2014 adjusting between sets"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Deep lunges on barre, reformer & Megaformer"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Grip socks that peel, stretch out, and quit"
          }
        }
      ]
    }
