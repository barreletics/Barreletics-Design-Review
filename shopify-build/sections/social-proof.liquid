{% comment %}
  Reviews — Home WORKING composition:
  featured quote + 3 image cards per page + prev/next carousel.
{% endcomment %}

<section class="reviews-section" id="reviews" aria-label="Customer reviews">
  <div class="reviews-inner">
    <div class="reviews-head">
      <div>
        {% if section.settings.title != blank %}
          <h2 class="reviews-head__title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <p class="reviews-head__body">{{ section.settings.body }}</p>
        {% endif %}
      </div>
      {% if section.settings.all_reviews_url != blank %}
        <a class="reviews-head__more" href="{{ section.settings.all_reviews_url }}">
          {{ section.settings.all_reviews_label | default: 'More stories →' }}
        </a>
      {% endif %}
    </div>

    <div class="reviews-featured" id="reviews-featured-{{ section.id }}" aria-live="polite">
      <div class="reviews-featured__stars" aria-hidden="true">★★★★★</div>
      <p class="reviews-featured__quote" id="reviews-featured-quote-{{ section.id }}"></p>
      <p class="reviews-featured__author" id="reviews-featured-author-{{ section.id }}"></p>
      <p class="reviews-featured__meta" id="reviews-featured-meta-{{ section.id }}"></p>
    </div>

    <div class="reviews-grid" id="reviews-grid-{{ section.id }}" aria-live="polite"></div>

    <div class="reviews-nav">
      <span class="reviews-nav__status" id="reviews-status-{{ section.id }}" aria-live="polite"></span>
      <button type="button" class="reviews-nav__btn" id="reviews-prev-{{ section.id }}" aria-label="Previous reviews">←</button>
      <button type="button" class="reviews-nav__btn" id="reviews-next-{{ section.id }}" aria-label="Next reviews">→</button>
    </div>
  </div>
</section>

<script type="application/json" id="reviews-data-{{ section.id }}">
[
{%- for block in section.blocks -%}
  {
    "quote": {{ block.settings.body | json }},
    "author": {{ block.settings.author | json }},
    "meta": {{ block.settings.location | json }},
    "img": {{ block.settings.image_url | json }}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
</script>

<script>
(function () {
  var sid = {{ section.id | json }};
  var dataEl = document.getElementById('reviews-data-' + sid);
  if (!dataEl) return;
  var REVIEWS = [];
  try { REVIEWS = JSON.parse(dataEl.textContent || '[]'); } catch (e) { REVIEWS = []; }
  if (!REVIEWS.length) return;

  var PAGE_SIZE = 3;
  var page = 0;
  var pageCount = Math.ceil(REVIEWS.length / PAGE_SIZE);
  var gridEl = document.getElementById('reviews-grid-' + sid);
  var quoteEl = document.getElementById('reviews-featured-quote-' + sid);
  var authorEl = document.getElementById('reviews-featured-author-' + sid);
  var metaEl = document.getElementById('reviews-featured-meta-' + sid);
  var statusEl = document.getElementById('reviews-status-' + sid);
  var prevBtn = document.getElementById('reviews-prev-' + sid);
  var nextBtn = document.getElementById('reviews-next-' + sid);

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderReviews() {
    if (!gridEl || !quoteEl) return;
    var start = page * PAGE_SIZE;
    var slice = REVIEWS.slice(start, start + PAGE_SIZE);
    var featured = slice[0] || REVIEWS[0];
    var q = featured.quote || '';
    if (q && q.charAt(0) !== '"') q = '"' + q + '"';
    quoteEl.textContent = q;
    authorEl.textContent = featured.author || '';
    metaEl.textContent = featured.meta || '';
    gridEl.innerHTML = slice.map(function (r) {
      var body = r.quote || '';
      if (body && body.charAt(0) !== '"') body = '"' + body + '"';
      var img = r.img
        ? '<img class="review-card__img" src="' + esc(r.img) + '" alt="" loading="lazy">'
        : '<div class="review-card__img review-card__img--empty" aria-hidden="true"></div>';
      return (
        '<div class="review-card">' +
          img +
          '<div class="review-card__pad">' +
            '<div class="review-card__stars" aria-hidden="true">★★★★★</div>' +
            '<p class="review-card__body">' + esc(body) + '</p>' +
            '<span class="review-card__author">' + esc(r.author || '') + '</span>' +
            '<span class="review-card__loc">' + esc(r.meta || '') + '</span>' +
          '</div>' +
        '</div>'
      );
    }).join('');
    if (statusEl) statusEl.textContent = (page + 1) + ' / ' + pageCount;
  }

  if (prevBtn && nextBtn) {
    prevBtn.addEventListener('click', function () {
      page = (page - 1 + pageCount) % pageCount;
      renderReviews();
    });
    nextBtn.addEventListener('click', function () {
      page = (page + 1) % pageCount;
      renderReviews();
    });
  }
  renderReviews();
})();
</script>

<style>
  .reviews-section {
    padding: 96px 40px;
    background: #f5f2ec;
  }
  .reviews-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .reviews-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 8px;
  }
  .reviews-head__title {
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 400;
    color: #1c1916;
    letter-spacing: -0.028em;
    margin: 0 0 16px;
    line-height: 1.15;
  }
  .reviews-head__body {
    font-size: 17px;
    color: #4a4a4a;
    margin: 0;
    max-width: 28ch;
    line-height: 1.45;
  }
  .reviews-head__more {
    font-size: 13px;
    font-weight: 500;
    color: #1c1916;
    text-decoration: none;
  }
  .reviews-head__more:hover { color: #c45c3f; }
  .reviews-featured {
    max-width: 640px;
    margin: 36px 0 24px;
    padding: 32px 0;
    border-top: 1px solid #d6cfc0;
    border-bottom: 1px solid #d6cfc0;
  }
  .reviews-featured__stars {
    color: #c45c3f;
    font-size: 14px;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }
  .reviews-featured__quote {
    font-size: 20px;
    font-weight: 400;
    font-style: normal;
    line-height: 1.45;
    color: #1c1916;
    margin: 0 0 20px;
    letter-spacing: -0.015em;
  }
  .reviews-featured__author {
    font-size: 14px;
    font-weight: 500;
    color: #1c1916;
    margin: 0 0 4px;
  }
  .reviews-featured__meta {
    font-size: 13px;
    color: #6b645a;
    margin: 0;
  }
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 32px;
  }
  .reviews-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 28px;
  }
  .reviews-nav__btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #d6cfc0;
    background: #fff;
    color: #1c1916;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .reviews-nav__btn:hover { background: #1c1916; color: #fff; border-color: #1c1916; }
  .reviews-nav__status {
    font-size: 12px;
    color: #8a8a8a;
    letter-spacing: 0.04em;
    margin-right: auto;
  }
  .reviews-section .review-card {
    background: #fff;
    border: none;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
  }
  .reviews-section .review-card__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .reviews-section .review-card__img--empty {
    background: #e8e2d8;
  }
  .reviews-section .review-card__pad {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .reviews-section .review-card__stars {
    color: #c45c3f;
    font-size: 14px;
    letter-spacing: 0.1em;
  }
  .reviews-section .review-card__body {
    font-size: 15px;
    font-style: normal;
    color: #4a4a4a;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }
  .reviews-section .review-card__author {
    font-size: 13px;
    font-weight: 500;
    color: #1c1916;
  }
  .reviews-section .review-card__loc {
    font-size: 12px;
    color: #8a8a8a;
  }
  @media (max-width: 1024px) {
    .reviews-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .reviews-section { padding: 48px 16px; }
    .reviews-grid { grid-template-columns: 1fr; gap: 16px; margin-top: 24px; }
    .reviews-nav { justify-content: space-between; }
    .reviews-section .review-card__pad { padding: 18px 18px 20px; }
    .reviews-section .review-card__body { font-size: 14px; }
  }
</style>

{% schema %}
{
  "name": "Social Proof",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Unused on Home WORKING — leave blank." },
    { "type": "text", "id": "title", "label": "Section title", "default": "Real people. Real results." },
    { "type": "text", "id": "body", "label": "Support", "default": "See the difference. Feel the grip." },
    { "type": "checkbox", "id": "show_aggregate", "label": "Show aggregate rating", "default": false, "info": "Home WORKING hides aggregate counts." },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "294" },
    { "type": "url", "id": "all_reviews_url", "label": "All reviews link" },
    { "type": "text", "id": "all_reviews_label", "label": "All reviews label", "default": "More stories →" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "body", "label": "Review text" },
        { "type": "text", "id": "author", "label": "Author name" },
        { "type": "text", "id": "location", "label": "Location / context" },
        { "type": "text", "id": "image_url", "label": "Card image URL" }
      ]
    }
  ],
  "presets": [{
    "name": "Social Proof",
    "blocks": [
      {
        "type": "review",
        "settings": {
          "body": "My love-hate relationship with the sock has finally come to a ceremonial end. The improvement during the first minute of barre class is beyond words. I will never go back.",
          "author": "Mia Evans",
          "location": "Barre Instructor · NYC · Verified Purchase",
          "image_url": "https://barreletics.com/cdn/shop/files/Square_Pink.png?v=1764627088&width=1200"
        }
      }
    ]
  }]
}
{% endschema %}
