{% comment %}
  About page — dark close CTA (v25 Locked)
{% endcomment %}

<section
  class="page-about-close"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
  aria-label="{{ section.settings.aria_label | escape }}"
>
  {% if section.settings.heading != blank %}
    <h2 class="page-about-close__title">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.body != blank %}
    <p class="page-about-close__body">{{ section.settings.body }}</p>
  {% endif %}
  {% if section.settings.cta_text != blank %}
    <a class="page-about-close__cta" href="{{ section.settings.cta_url | default: '/collections/barre-pilates-yoga-shoe-sock-footwear' }}">
      {{ section.settings.cta_text }}
    </a>
  {% endif %}
</section>

<style>
  #shopify-section-{{ section.id }} .page-about-close {
    background: #1c1916;
    color: #fff;
    padding: clamp(80px, 18vh, 160px) clamp(20px, 8vw, 8vw);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .page-about-close__title {
    font-size: clamp(44px, 7vw, 88px);
    font-weight: 400;
    letter-spacing: -0.038em;
    line-height: 1.02;
    margin: 0 0 20px;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .page-about-close__body {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    margin: 0 0 32px;
  }
  #shopify-section-{{ section.id }} .page-about-close__cta {
    display: inline-block;
    background: #fff;
    color: #1c1916;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
  }
  #shopify-section-{{ section.id }} .page-about-close__cta:hover {
    background: #c45c3f;
    color: #fff;
    text-decoration: none;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-close { padding: 56px 20px; }
    #shopify-section-{{ section.id }} .page-about-close__title {
      font-size: clamp(28px, 8vw, 40px);
    }
  }
</style>

{% schema %}
{
  "name": "About — Close",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let us knock your socks off" },
    { "type": "text", "id": "body", "label": "Body", "default": "One pair. All-over grip. Built for the studio." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop Performance Skins" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Shop Performance Skins" }
  ],
  "presets": [{ "name": "About — Close" }]
}
{% endschema %}
