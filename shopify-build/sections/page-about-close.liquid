        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" }
      ]
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Body weight",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" }
      ]
    },
    {
      "type": "select",
      "id": "cta_size",
      "label": "CTA label size",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "12", "label": "12px" },
        { "value": "13", "label": "13px" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" }
      ]
    }
  ],
  "presets": [{ "name": "About — Close" }]
}
{% endschema %}
