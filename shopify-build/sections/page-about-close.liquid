        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" },
        { "value": "40", "label": "40px" },
        { "value": "44", "label": "44px" },
        { "value": "48", "label": "48px" },
        { "value": "56", "label": "56px" },
        { "value": "64", "label": "64px" },
        { "value": "72", "label": "72px" },
        { "value": "80", "label": "80px" },
        { "value": "88", "label": "88px" },
        { "value": "96", "label": "96px" }
      ]
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Heading weight",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
