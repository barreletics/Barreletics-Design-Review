{% comment %}
  Full cart page — mirrors drawer bundle preview block; preserves cart form POST /checkout.
{% endcomment %}

<section class="cart-page section" id="main-cart" data-section-type="main-cart">
  <div class="cart-page__inner page-width">
    <h1 class="cart-page__title" id="cart-page-title">
      {%- if cart.item_count > 0 -%}Your cart ({{ cart.item_count }}){%- else -%}Your cart{%- endif -%}
    </h1>

    {% if cart.item_count == 0 %}
      <div class="cart-page__empty">
        <p>Your cart is empty</p>
        <a href="/collections/closed-sole" class="btn btn--primary">Shop Performance Skins</a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="cart-page__form">
        <div class="cart-page__items" id="cart-page-items">
          {% for item in cart.items %}
            <div class="cart-page__item" data-line-key="{{ item.key }}">
              <a href="{{ item.url }}" class="cart-page__item-img">
                <img
                  src="{{ item.image | image_url: width: 160 }}"
                  alt="{{ item.title | escape }}"
                  width="96"
                  height="96"
                  loading="lazy"
                >
              </a>
              <div class="cart-page__item-details">
                <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
                <p class="cart-page__item-variant">{{ item.variant.title }}</p>
                <div class="cart-page__item-qty">
                  <label class="visually-hidden" for="qty-{{ forloop.index }}">Quantity</label>
                  <input
                    id="qty-{{ forloop.index }}"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    data-qty-input
                  >
                </div>
              </div>
              <span class="cart-page__item-price">{{ item.final_line_price | money }}</span>
            </div>
          {% endfor %}
        </div>

        <div id="cart-page-bundle-promo" class="cart-page__bundle-slot" hidden></div>

        <div class="cart-page__summary">
          <div class="cart-page__subtotal">
            <span>Subtotal</span>
            <span id="cart-page-subtotal">{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-page__estimated-row" id="cart-page-estimated-row" hidden>
            <span>Estimated total</span>
            <strong id="cart-page-estimated-total"></strong>
          </div>
          <p id="cart-page-ship-preview" class="cart-page__ship-preview" hidden></p>
          <p class="cart-page__note">Shipping and discounts calculated at checkout.</p>
          <button type="submit" name="checkout" class="btn btn--primary cart-page__checkout" data-checkout-button>
            Check out
          </button>
        </div>
      </form>
    {% endif %}
  </div>
</section>

<style>
  .cart-page__inner {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
  }

  .cart-page__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    margin: 0 0 var(--space-6);
  }

  .cart-page__item {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-default);
  }

  .cart-page__item-title {
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 14px;
  }

  .cart-page__item-variant {
    font-size: 12px;
    color: var(--text-muted);
    margin: var(--space-1) 0;
  }

  .cart-page__summary {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-top: 1px solid var(--border-default);
    padding-top: var(--space-5);
  }

  .cart-page__subtotal,
  .cart-page__estimated-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-md);
  }

  .cart-page__estimated-row {
    font-weight: var(--weight-bold);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-default);
  }

  .cart-page__ship-preview {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .cart-page__checkout {
    width: 100%;
    text-align: center;
  }

  .cart-page__note {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }
</style>
