        { "value": "700", "label": "700" }
      ]
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Lede size",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "14", "label": "14px" },
        { "value": "15", "label": "15px" },
        { "value": "16", "label": "16px" },
        { "value": "17", "label": "17px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" }
      ]
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Lede weight",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" }
      ]
    },
    {
      "type": "select",
      "id": "fact_title_size",
      "label": "Fact title size",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default / Type OS" },
        { "value": "16", "label": "16px" },
        { "value": "18", "label": "18px" },
        { "value": "20", "label": "20px" },
        { "value": "22", "label": "22px" },
        { "value": "24", "label": "24px" },
        { "value": "26", "label": "26px" },
        { "value": "28", "label": "28px" },
        { "value": "32", "label": "32px" },
        { "value": "36", "label": "36px" }
