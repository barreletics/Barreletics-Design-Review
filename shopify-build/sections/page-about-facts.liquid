{% comment %}
  About page — Made in USA facts band (v25 Locked)
{% endcomment %}

<section
  class="page-about-facts"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
  aria-label="{{ section.settings.aria_label | escape }}"
  style="{% render 'type-override-vars', title_size: section.settings.title_size, title_weight: section.settings.title_weight, body_size: section.settings.body_size, body_weight: section.settings.body_weight, sub_size: section.settings.fact_title_size, sub_weight: section.settings.fact_title_weight %}"
>
  <div class="page-about-facts__intro">
    {% if section.settings.heading != blank %}
      <h2 class="page-about-facts__title">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.lede != blank %}
      <div class="page-about-facts__lede rte">{{ section.settings.lede }}</div>
    {% endif %}
  </div>
  <dl class="page-about-facts__grid">
    {% for block in section.blocks %}
      {% if block.type == 'fact' %}
        <div {{ block.shopify_attributes }}>
          <dt class="page-about-facts__term">{{ block.settings.title }}</dt>
          <dd class="page-about-facts__desc">{{ block.settings.description }}</dd>
        </div>
      {% endif %}
    {% endfor %}
  </dl>
  {%- comment -%} Also featured in line (press line 2026-09-27). Theme editor: Show text line / Hide on mobile / styles / name size / text. {%- endcomment -%}
  {%- if section.settings.show_mentions and section.settings.mentions_items != blank -%}
    {%- liquid
      assign mention_items = section.settings.mentions_items | split: ','
      assign mentions_d = section.settings.mentions_style_desktop | default: 'caps'
      assign mentions_m = section.settings.mentions_style_mobile | default: 'sentence'
      assign mentions_size = section.settings.mentions_name_size | default: '16'
      assign mentions_count = 0
    -%}
    <p class="page-about-facts__mentions page-about-facts__mentions--d-{{ mentions_d }} page-about-facts__mentions--m-{{ mentions_m }}{% if section.settings.mentions_hide_mobile %} page-about-facts__mentions--hide-mobile{% endif %}" style="--mentions-name-size: {{ mentions_size }}px;">
      {%- if section.settings.mentions_lead != blank -%}
        <span class="page-about-facts__mentions-lead">{{ section.settings.mentions_lead | escape }}</span>{{ ' ' }}
      {%- endif -%}
      {%- for item in mention_items -%}
        {%- assign mention_name = item | strip -%}
        {%- if mention_name != blank -%}
          {%- if mentions_count > 0 -%}{{ ' ' }}<span class="page-about-facts__mentions-sep" aria-hidden="true">·</span>{{ ' ' }}{%- endif -%}
          <span class="page-about-facts__mentions-item">{{ mention_name | escape }}</span>
          {%- assign mentions_count = mentions_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </p>
  {%- endif -%}
</section>

<style>
  #shopify-section-{{ section.id }} .page-about-facts {
    background: var(--color-warm-cream, #faf8f6);
    min-height: min(82vh, 880px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(64px, 12vh, 120px) clamp(20px, 8vw, 8vw);
  }
  /* Desktop width matches the other content pages (Andrew 2026-09-30): heading uses the grid width so
     "Made in the USA." stays on one line; the lede caps at the 760px content-page measure. */
  #shopify-section-{{ section.id }} .page-about-facts__intro {
    max-width: none;
    margin: 0 0 clamp(40px, 8vh, 72px);
  }
  #shopify-section-{{ section.id }} .page-about-facts__title {
    font-size: var(--te-title-size, clamp(56px, 9vw, 112px));
    font-weight: var(--te-title-weight, 400);
    letter-spacing: -0.042em;
    line-height: 0.94;
    margin: 0 0 24px;
    color: var(--text-primary, #1c1916);
  }
  #shopify-section-{{ section.id }} .page-about-facts__lede {
    font-size: var(--te-body-size, 18px);
    font-weight: var(--te-body-weight, 400);
    line-height: 1.55;
    color: var(--text-body, #4a4a4a);
    max-width: 760px;
  }
  #shopify-section-{{ section.id }} .page-about-facts__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 4vw, 40px) clamp(20px, 3vw, 32px);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .page-about-facts__term {
    font-size: var(--te-sub-size, clamp(22px, 2.4vw, 28px));
    font-weight: var(--te-sub-weight, 500);
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .page-about-facts__desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-body, #4a4a4a);
    margin: 0;
    max-width: 22ch;
  }
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .page-about-facts__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-facts {
      min-height: auto;
      padding: 48px 20px;
    }
    #shopify-section-{{ section.id }} .page-about-facts__title {
      font-size: var(--te-title-size, clamp(40px, 11vw, 56px));
    }
    #shopify-section-{{ section.id }} .page-about-facts__intro { margin-bottom: 28px; }
    #shopify-section-{{ section.id }} .page-about-facts__grid { grid-template-columns: 1fr; }
  }
  /* Also featured in line. Desktop caps = A3, mobile sentence = M2 (press line 2026-09-27). Breakpoint 768px. */
  #shopify-section-{{ section.id }} .page-about-facts__mentions { margin: clamp(28px, 4vw, 40px) 0 0; padding: 0; font-family: 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif; text-align: left; }
  #shopify-section-{{ section.id }} .page-about-facts__mentions-item { white-space: nowrap; font-size: var(--mentions-name-size, 16px); }
  #shopify-section-{{ section.id }} .page-about-facts__mentions-sep { padding: 0 .2em; }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .page-about-facts__mentions--d-caps { font-size: 16px; font-weight: 600; line-height: 1.3; letter-spacing: normal; color: #1c1916; text-transform: none; }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--d-caps .page-about-facts__mentions-lead { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #3a3a3a; margin-right: .5em; }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--d-caps .page-about-facts__mentions-sep { padding: 0 .35em; font-weight: 400; color: #6b645a; }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--d-sentence { font-size: 16px; font-weight: 400; line-height: 1.5; letter-spacing: normal; color: var(--text-body, #4a4a4a); text-transform: none; }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--d-sentence .page-about-facts__mentions-lead { font-weight: 400; color: var(--text-body, #4a4a4a); }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--d-sentence .page-about-facts__mentions-item { font-weight: 500; color: #1c1916; }
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-facts__mentions--m-sentence { font-size: 16px; font-weight: 400; line-height: 1.5; letter-spacing: normal; color: var(--text-body, #4a4a4a); text-transform: none; }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--m-sentence .page-about-facts__mentions-lead { font-weight: 400; color: var(--text-body, #4a4a4a); }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--m-sentence .page-about-facts__mentions-item { font-weight: 500; color: #1c1916; }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--m-caps { font-size: 16px; font-weight: 600; line-height: 1.3; letter-spacing: normal; color: #1c1916; text-transform: none; }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--m-caps .page-about-facts__mentions-lead { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #3a3a3a; margin-right: .5em; }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--m-caps .page-about-facts__mentions-sep { padding: 0 .35em; font-weight: 400; color: #6b645a; }
    #shopify-section-{{ section.id }} .page-about-facts__mentions--hide-mobile { display: none !important; }
  }
</style>

{% schema %}
{
