        { "value": "88", "label": "88px" },
        { "value": "96", "label": "96px" },
        { "value": "104", "label": "104px" },
        { "value": "112", "label": "112px" }
      ]
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Heading weight",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
