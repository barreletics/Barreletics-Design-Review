{% comment %}
  About page — Made in USA facts band (v25 Locked)
{% endcomment %}

<section
  class="page-about-facts"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="page-about-facts__intro">
    {% if section.settings.heading != blank %}
      <h2 class="page-about-facts__title">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.lede != blank %}
      <div class="page-about-facts__lede rte">{{ section.settings.lede }}</div>
    {% endif %}
  </div>
  <dl class="page-about-facts__grid">
    {% for block in section.blocks %}
      {% if block.type == 'fact' %}
        <div {{ block.shopify_attributes }}>
          <dt class="page-about-facts__term">{{ block.settings.title }}</dt>
          <dd class="page-about-facts__desc">{{ block.settings.description }}</dd>
        </div>
      {% endif %}
    {% endfor %}
  </dl>
</section>

<style>
  #shopify-section-{{ section.id }} .page-about-facts {
    background: var(--color-warm-cream, #f5f2ec);
    min-height: min(82vh, 880px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(64px, 12vh, 120px) clamp(20px, 8vw, 8vw);
  }
  #shopify-section-{{ section.id }} .page-about-facts__intro {
    max-width: 18em;
    margin: 0 0 clamp(40px, 8vh, 72px);
  }
  #shopify-section-{{ section.id }} .page-about-facts__title {
    font-size: clamp(56px, 9vw, 112px);
    font-weight: 400;
    letter-spacing: -0.042em;
    line-height: 0.94;
    margin: 0 0 24px;
    color: var(--text-primary, #1c1916);
  }
  #shopify-section-{{ section.id }} .page-about-facts__lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-body, #4a4a4a);
  }
  #shopify-section-{{ section.id }} .page-about-facts__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 4vw, 40px) clamp(20px, 3vw, 32px);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .page-about-facts__term {
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .page-about-facts__desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-body, #4a4a4a);
    margin: 0;
    max-width: 22ch;
  }
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .page-about-facts__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-about-facts {
      min-height: auto;
      padding: 48px 20px;
    }
    #shopify-section-{{ section.id }} .page-about-facts__title {
      font-size: clamp(40px, 11vw, 56px);
    }
    #shopify-section-{{ section.id }} .page-about-facts__intro { margin-bottom: 28px; }
    #shopify-section-{{ section.id }} .page-about-facts__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "About — Facts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made in the USA." },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Lede",
      "default": "<p>Designed and manufactured in Michigan. 360° injection-molded grip. Same grip, same stability in Open Sole or Closed Sole — choice is preference and feel only.</p>"
    },
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Made in the USA" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Facts",
      "blocks": [
        { "type": "fact", "settings": { "title": "Coperni", "description": "Spring–Summer 2026 runway, Paris." } },
        { "type": "fact", "settings": { "title": "Free People", "description": "Spring 2026." } },
        { "type": "fact", "settings": { "title": "195 countries", "description": "Shipped worldwide." } },
        { "type": "fact", "settings": { "title": "1,000+ instructors", "description": "Trusted in studio." } }
      ]
    }
  ]
}
{% endschema %}
