{
  "_comment": "Copy into section schema (Layout / padding). Labels match fifty-fifty.",
  "unified_pad_controls": [
    {
      "type": "range",
      "id": "text_pad_y",
      "label": "Text pad top & bottom — desktop (default 96)",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Text pad left & right — desktop (default 64)",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "text_pad_y_mobile",
      "label": "Text pad top & bottom — phone (default 80)",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "text_pad_x_mobile",
      "label": "Text pad left & right — phone (default 20)",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "legacy_visible_if": "{{ section.settings.aria_label == '__legacy_hidden__' }}"
}
