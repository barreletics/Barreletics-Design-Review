<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>
    {%- case template.name -%}
      {%- when 'index' -%}
        Barreletics — Performance Skins for Barre, Pilates & Reformer
      {%- when 'product' -%}
        {{ product.title }} | Barreletics
      {%- when 'collection' -%}
        {{ collection.title }} | Barreletics Grippy Shoes
      {%- when 'article' -%}
        {{ article.title }} | Barreletics Journal
      {%- else -%}
        {{ page_title }} | Barreletics
    {%- endcase -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Preconnects {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {%- comment -%} Fonts {%- endcomment -%}
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  {%- comment -%} Design Tokens + Base CSS (critical) {%- endcomment -%}
  {{ 'design-tokens.css' | asset_url | stylesheet_tag }}
  {{ 'barreletics-base.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Structured data {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Barreletics",
      "url": "{{ shop.url }}",
      "logo": "{{ 'logo.png' | asset_url }}"
    }
  </script>

  {% if template.name != 'index' %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{ shop.url }}"
          }
          {%- if template.name == 'collection' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": "{{ collection.title | escape }}",
              "item": "{{ shop.url }}{{ collection.url }}"
            }
          {%- elsif template.name == 'product' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": "Grippy Shoes",
              "item": "{{ shop.url }}/collections/grippy-shoes"
            }
            ,{
              "@type": "ListItem",
              "position": 3,
              "name": "{{ product.title | escape }}",
              "item": "{{ shop.url }}{{ product.url }}"
            }
          {%- endif -%}
        ]
      }
    </script>
  {% endif %}

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">

  <a href="#main-content" class="skip-link">Skip to content</a>

  {%- comment -%} Announcement Strip {%- endcomment -%}
  {% render 'announcement-strip' %}

  {%- comment -%} Header / Navigation (header-nav.liquid provides its own <header> element) {%- endcomment -%}
  {% render 'header-nav' %}

  {%- comment -%} Main Content {%- endcomment -%}
  <main id="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- comment -%} Footer (footer.liquid provides its own <footer> element) {%- endcomment -%}
  {% render 'footer' %}

  {%- comment -%} Cart Drawer (D-024) {%- endcomment -%}
  {% render 'cart-drawer' %}

  {%- comment -%} Skip link styles {%- endcomment -%}
  <style>
    .skip-link {
      position: absolute;
      top: -100%;
      left: 16px;
      z-index: 9999;
      padding: 12px 24px;
      background: var(--color-charcoal);
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      border-radius: var(--radius-button);
      text-decoration: none;
      transition: top 0.2s;
    }

    .skip-link:focus {
      top: 16px;
    }
  </style>

  {%- comment -%} Reduced motion preference {%- endcomment -%}
  <style>
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>

</body>
</html>
