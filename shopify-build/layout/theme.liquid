<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>
    {%- case template.name -%}
      {%- when 'index' -%}
        {{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}
      {%- when 'product' -%}
        {{ product.title }} | {{ shop.name }}
      {%- when 'collection' -%}
        {{ collection.title }} | {{ shop.name }}
      {%- when 'article' -%}
        {{ article.title }} | {{ shop.name }}
      {%- when 'blog' -%}
        {{ blog.title }} | {{ shop.name }}
      {%- when 'page' -%}
        {{ page.title }} | {{ shop.name }}
      {%- else -%}
        {{ page_title }} | {{ shop.name }}
    {%- endcase -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {%- comment -%}
    Analytics / chat / pixels: prefer App embeds + content_for_header.
    Do not render theme snippets that are missing or would double-fire (Tidio, Meta, etc.).
  {%- endcomment -%}

  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  {{ 'design-tokens.css' | asset_url | stylesheet_tag }}
  {{ 'barreletics-base.css' | asset_url | stylesheet_tag }}
  {{ 'chrome.css' | asset_url | stylesheet_tag }}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
    }
  </script>

  {%- if template.name == 'index' -%}
    {%- capture website_search_target -%}{{ shop.url }}/search?q={%- raw -%}{search_term_string}{%- endraw -%}{%- endcapture -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ website_search_target | json }},
          "query-input": "required name=search_term_string"
        }
      }
    </script>
  {%- endif -%}

  {% render 'judgeme_core' %}
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">

  <a href="#main-content" class="skip-link">Skip to content</a>

  {% sections 'header-group' %}

  {%- comment -%} Theme popups (newsletter / age) — file exists on draft; no Impulse chrome restore {%- endcomment -%}
  {% sections 'popup-group' %}

  <main id="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}

  <script src="{{ 'cart.js' | asset_url }}" defer></script>
  <script src="{{ 'chrome.js' | asset_url }}" defer></script>

  <style>
    .skip-link {
      position: absolute;
      top: -100%;
      left: 16px;
      z-index: 9999;
      padding: 12px 24px;
      background: var(--color-charcoal);
      color: var(--color-white);
      font-size: 14px;
      font-weight: 700;
      border-radius: var(--radius-button);
      text-decoration: none;
      transition: top 0.2s;
    }
    .skip-link:focus { top: 16px; }

    /* Hide Judge.me review COUNTS sitewide — stars stay */
    .jdgm-prev-badge__text,
    .jdgm-rev-widg__summary-text,
    .jdgm-all-reviews__summary-text,
    .jdgm-all-reviews__count,
    .jdgm-histogram,
    .jdgm-rev-widg__histogram,
    .jdgm-all-reviews__histogram,
    .jdgm-star-histogram,
    .jdgm-histogram__row {
      display: none !important;
    }

    /* Native Write a Review only on /pages/reviews (suffix uses underscores) */
    body:not(.template-page-reviews):not(.template-page-judgeme_all_reviews) .jdgm-write-rev-link,
    body:not(.template-page-reviews):not(.template-page-judgeme_all_reviews) .jdgm-form-wrapper,
    body:not(.template-page-reviews):not(.template-page-judgeme_all_reviews) .jdgm-write-rev-form {
      display: none !important;
    }
    .template-page-reviews .jdgm-write-rev-link,
    .template-page-judgeme_all_reviews .jdgm-write-rev-link,
    .pdp-reviews--full .pdp-reviews__write .jdgm-write-rev-link {
      display: inline-block !important;
    }
    .visually-hidden {
      position: absolute !important;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0);
      white-space: nowrap; border: 0;
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>

</body>
</html>
