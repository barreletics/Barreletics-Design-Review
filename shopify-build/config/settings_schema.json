      {
        "type": "color",
        "id": "color_white",
        "label": "White",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_warm_cream",
        "label": "Warm cream (alternate bg)",
        "default": "#f5f2ec"
      },
      {
        "type": "header",
        "content": "Accent colors"
      },
      {
        "type": "color",
        "id": "color_coral",
        "label": "Coral (accent)",
        "default": "#e8927c"
      },
      {
        "type": "color",
        "id": "color_rust",
        "label": "Rust (CTA/accent)",
        "default": "#c45c3f"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Gold (star ratings)",
        "default": "#d4af37"
      },
      {
        "type": "header",
        "content": "Borders & surfaces"
      },
      {
        "type": "color",
        "id": "color_border",
