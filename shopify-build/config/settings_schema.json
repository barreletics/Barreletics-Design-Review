  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_font_family",
        "label": "Primary font",
        "default": "roboto_n4"
      },
      {
        "type": "range",
        "id": "type_base_size",
        "label": "Base font size",
        "min": 14,
        "max": 20,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "label": "Heading scale factor",
        "min": 100,
        "max": 150,
        "step": 5,
        "default": 100,
        "unit": "%"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "max_width",
        "label": "Max content width",
        "min": 1000,
        "max": 1600,
        "step": 40,
        "default": 1200,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_padding_x",
        "label": "Section horizontal padding",
        "min": 16,
        "max": 64,
        "step": 4,
        "default": 24,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Announcement bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "announcement_enabled",
