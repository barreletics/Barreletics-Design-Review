      {
        "type": "color",
        "id": "color_warm_border",
        "label": "Warm border (header scroll)",
        "default": "#d6cfc0"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_font_family",
        "label": "Primary font",
        "default": "roboto_n4"
      },
      {
        "type": "range",
        "id": "type_base_size",
        "label": "Base font size",
        "min": 14,
        "max": 20,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "label": "Heading scale factor",
        "min": 100,
        "max": 150,
        "step": 5,
        "default": 100,
        "unit": "%"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "max_width",
        "label": "Max content width",
        "min": 1000,
        "max": 1600,
        "step": 40,
        "default": 1200,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_padding_x",
        "label": "Section horizontal padding",
        "min": 16,
        "max": 64,
        "step": 4,
        "default": 24,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Announcement bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "announcement_enabled",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_message_1",
        "label": "Message 1",
        "default": "Buy 2, Save 15% \u2014 Code SAVE15"
      },
      {
        "type": "text",
        "id": "announcement_message_2",
        "label": "Message 2",
        "default": "Free Shipping Over $150"
      },
      {
        "type": "text",
        "id": "announcement_message_3",
        "label": "Message 3",
        "default": "30-Day Returns \u00b7 Made in USA"
      },
      {
        "type": "range",
        "id": "announcement_rotation_speed",
        "label": "Rotation speed",
        "min": 2,
        "max": 8,
        "step": 1,
        "default": 4,
        "unit": "s"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer (recommended)"
          },
          {
            "value": "page",
            "label": "Full page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold",
        "default": "150"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL",
        "default": "https://instagram.com/barreletics"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL",
        "default": "https://tiktok.com/@barreletics"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL",
        "default": "https://facebook.com/barreletics"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL",
        "default": "https://pinterest.com/Barreletics"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL",
        "default": "https://www.youtube.com/"
      }
    ]
  },
  {
    "name": "Favicon & branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "og_default_image",
        "label": "Default Open Graph image",
        "info": "Displayed when sharing pages without a specific image. Recommended: 1200x630px."
      }
    ]
  },
  {
    "name": "Tracking & Integrations",
    "settings": [
      {
        "type": "header",
        "content": "Analytics"
      },
      {
        "type": "paragraph",
        "content": "Only use these fields if NOT using Shopify's native Google/Meta channel integrations. Using both will cause duplicate tracking events."
      },
      {
        "type": "text",
        "id": "ga4_measurement_id",
        "label": "GA4 Measurement ID",
        "info": "Format: G-XXXXXXXXXX. Found in GA4 Admin \u2192 Data Streams. Leave blank if using Shopify's Google channel."
      },
      {
        "type": "text",
        "id": "meta_pixel_id",
        "label": "Meta Pixel ID",
        "info": "From Meta Business Manager \u2192 Events Manager. Leave blank if using Shopify's Meta & Instagram channel."
      },
      {
        "type": "text",
        "id": "pinterest_tag_id",
        "label": "Pinterest Tag ID",
        "info": "From Pinterest Business \u2192 Ads \u2192 Conversions."
      },
      {
        "type": "text",
        "id": "clarity_project_id",
        "label": "Microsoft Clarity Project ID",
        "info": "From clarity.microsoft.com \u2192 Settings \u2192 Setup."
      },
      {
        "type": "header",
        "content": "Customer support"
      },
      {
        "type": "text",
        "id": "helpscout_beacon_id",
        "label": "Help Scout Beacon ID",
        "info": "Leave blank to disable the Help Scout chat widget."
      },
      {
        "type": "text",
        "id": "tidio_widget_key",
        "label": "Tidio Widget Key",
        "info": "Leave blank to disable the Tidio chat widget."
      },
      {
        "type": "header",
        "content": "Search & verification"
      },
      {
        "type": "text",
        "id": "search_console_verification",
        "label": "Google Search Console Verification",
        "info": "The meta tag content value for domain verification. Found in Search Console \u2192 Settings \u2192 Ownership verification \u2192 HTML tag."
      }
    ]
  },
  {
    "name": "Free shipping",
    "settings": [
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 150,
        "unit": "$"
      },
      {
        "type": "text",
        "id": "free_shipping_message",
        "label": "Free shipping message",
        "default": "Free shipping on orders over $150"
      }
    ]
  },
  {
    "name": "PDP hero image",
    "settings": [
      {
        "type": "paragraph",
        "content": "Global default for which product image shows in the PDP buy-box hero and sticky ATC thumb — without reordering variants or media in Admin. Buy Box / Sticky section settings can override per template."
      },
      {
        "type": "select",
        "id": "pdp_hero_image_mode",
        "label": "Hero image priority",
        "options": [
          { "value": "admin_order", "label": "Admin media order (default)" },
          { "value": "variant_color", "label": "Variant color / option value" },
          { "value": "media_index", "label": "Specific media position #" }
        ],
        "default": "admin_order"
      },
      {
        "type": "text",
        "id": "pdp_hero_color",
        "label": "Hero color / option value",
        "info": "When priority is Variant color. e.g. Coral, Bright Yellow, Blue, DarkGrey."
      },
      {
        "type": "range",
        "id": "pdp_hero_media_index",
        "label": "Hero media position",
        "min": 1,
        "max": 12,
        "step": 1,
        "default": 1,
        "info": "When priority is Specific media position #."
      }
    ]
  },
  {
    "name": "One-off colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Pick a product → quiet link + Grippy nav item show. Clear the picker → they hide. No extra switches. Do not also add this in Online Store → Navigation."
      },
      {
        "type": "product",
        "id": "one_off_product",
        "label": "One-off product",
        "info": "Leave blank to hide nav + quiet link. All Variants uses this when its own One-Offs picker is empty."
      },
      {
        "type": "text",
        "id": "one_off_nav_label",
        "label": "Nav label",
        "default": "One-off colors",
        "info": "Injected under the Grippy Shoes parent in the header."
      },
      {
        "type": "text",
        "id": "one_off_parent_match",
        "label": "Parent menu match",
        "default": "grippy",
        "info": "Case-insensitive: parent link title must contain this (e.g. Grippy Shoes)."
      },
      {
        "type": "text",
        "id": "one_off_link_label",
        "label": "PDP quiet link",
        "default": "This week’s one-off color →",
        "info": "Under Add to Cart on Closed / Open / Outdoor. Hidden on the one-off product itself."
      }
    ]
  }
]
