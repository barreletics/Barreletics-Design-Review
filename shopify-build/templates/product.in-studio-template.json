        "pdpcopy-faq-care": {
          "type": "faq_item",
          "settings": {
            "question": "How do I put on and care for my grippy shoes?",
            "answer": "<p><strong>How do I put on my grippy shoes?</strong> Pull from the top of the foot, not the straps, to help extend their lifespan.</p><p><strong>After class.</strong> When you wipe down your equipment, give your Barreletics a quick pass with the same wipe.</p><p><strong>Cleaning.</strong> Hand wash with warm soapy water. They dry in seconds. That's it.</p>"
          }
        },
        "pdpcopy-faq-returns": {
          "type": "faq_item",
          "settings": {
            "question": "How do returns, exchanges and the 90-day warranty work?",
            "answer": "<p>You have 30 days to return or exchange. Every pair also has a 90-day warranty against manufacturing defects. <a href=\"/pages/returns\">See our returns policy</a>.</p>"
          }
        }
