    "reviews": {
      "type": "pdp-reviews",
      "blocks": {
        "featured1": {
          "type": "featured_review",
          "settings": {
            "rating": 5,
            "body": "I've tried several grip socks. The grip wears off and my toes slip. With Barreletics those days are gone. More confidence in my poses, and the grip stays consistent.",
            "author": "Leslie S.",
            "location": "Katy, US"
          }
        },
        "photo1": {
          "type": "photo_review",
          "settings": {
            "image_url": "https://review-images.judgeme.com/barreletics/1778161226__9063__original.jpg?quality=80&width=1024",
            "title": "Sock era: over.",
            "body": "My love-hate relationship with the sock has finally come to a ceremonial end. The vast improvement during the first minute of barre class, with my new Barreletics performance skin shoes, is beyond words.",
            "author": "Mia Evans",
            "location": "Verified Purchase",
            "rating": 5
          }
        },
        "photo2": {
          "type": "photo_review",
          "settings": {
            "image_url": "https://review-images.judgeme.com/barreletics/1774226614__img_9682__original.jpeg?quality=80&width=1024",
            "title": "Genius. Simple. Effective.",
            "body": "A long time void that was begging for a solution! Genius concept. Simple, effective, stylish. I can improve my workout 10 fold without the nagging sock slippage and constant adjustment.",
            "author": "Jess",
            "location": "Ashburn, US",
            "rating": 5
          }
        },
        "photo3": {
          "type": "photo_review",
          "settings": {
            "image_url": "https://review-images.judgeme.com/barreletics/1780166108__img_3722__original.jpeg?quality=80&width=1024",
            "title": "Back to footwork.",
            "body": "After almost a year off the foot bar due to my neuropathy, I am confidently back to the footwork series in Pilates!",
            "author": "JenB",
            "location": "Millville, US",
            "rating": 5
          }
        },
        "text1": {
          "type": "text_review",
          "settings": {
            "title": "Secure from the first class.",
            "body": "I am a full-time Barre instructor and teach on a variety of surfaces and mats. These provide the perfect level of grip and support and fit like a glove. YES! Finally a good durable barre shoe!",
            "author": "Laura P.",
            "location": "Sacramento, US · Barre instructor",
            "rating": 5
          }
        },
        "text2": {
          "type": "text_review",
          "settings": {
            "title": "Plank without fear.",
            "body": "Traditional Pilates socks never fit me right so I decided to try this product. At my very first class using them, I was able to hold a plank without fear. Absolutely worth it!",
            "author": "Alexis G.",
            "location": "Massapequa, US",
            "rating": 5
          }
        },
        "text3": {
          "type": "text_review",
          "settings": {
            "title": "After spinal fusion, still steady.",
            "body": "I was dreading going back to Pilates after a spinal fusion because I felt like grip socks were not going to cut it. I had never found a pair of grip socks that wouldn't slip a bit while doing bridges on the chair or reformer so I started looking for something that would help alleviate my fears.",
            "author": "Samantha B.",
            "location": "Castle Rock, US",
            "rating": 5
          }
        },
        "text4": {
          "type": "text_review",
          "settings": {
            "title": "Safe on the equipment.",
            "body": "Several ladies in my Pilates classes have commented on my shoes and I love to sing your praises. In one word, they make me feel SAFE on the equipment. Yes, they are a bit spendy, but in the long run, they save me money because I don't have to buy grip socks all the time.",
            "author": "Deborah R.",
            "location": "Eugene, US",
            "rating": 5
          }
        },
        "text5": {
          "type": "text_review",
          "settings": {
            "title": "Bought a third pair.",
            "body": "This is the second pair I'm buying. Love them sooo much, got a lot of use out of it and I bought a third. Lasted me a year, used it almost every day!",
            "author": "Catherine R.",
            "location": "Lanham, US",
            "rating": 5
          }
        },
        "text6": {
          "type": "text_review",
          "settings": {
            "title": "Unstable on socks. Steady now.",
            "body": "Loving these 'shoes'. I felt very unstable on the reformer with the grippy socks because they do not grip well on the heel and my feet can move around in the socks but this does not happen with these and I am so confident during the classes now. Love these.",
            "author": "Dianne P.",
            "location": "George Town, KY",
            "rating": 5
          }
        }
      },
