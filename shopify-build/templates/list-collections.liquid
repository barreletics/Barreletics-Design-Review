{% comment %}
  /collections (list-collections) for the draft design. Renders inside layout/theme.liquid, so the
  header group and footer group wrap it. Replaces Shopify's unstyled fallback list (QC H04, 2026-09-30).
  Cards follow the variant-grid card look (white card, warm border, 6px radius, cream media);
  page-open pad copies the Shop All ruler (--pad-grid-page-open 72 / 56).
  Collection titles are shown exactly as set in Admin.
{% endcomment %}

<section class="section collections-list" aria-labelledby="CollectionsListTitle">
  <div class="section__inner collections-list__inner">
    <h1 id="CollectionsListTitle" class="collections-list__title">Product Collections</h1>
    <ul class="collections-list__grid" role="list">
      {%- for collection in collections -%}
        {%- if collection.all_products_count > 0 -%}
          <li class="collections-list__item">
            <a class="collections-list__card" href="{{ collection.url }}">
              <div class="collections-list__media">
                {%- if collection.featured_image != blank -%}
                  {{
                    collection.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(max-width: 768px) 50vw, 25vw',
                      alt: collection.title,
                      class: 'collections-list__img'
                  }}
                {%- endif -%}
              </div>
              <div class="collections-list__content">
                <h2 class="collections-list__name">{{ collection.title | escape }}</h2>
                <p class="collections-list__count">{{ collection.all_products_count }} {{ collection.all_products_count | pluralize: 'product', 'products' }}</p>
              </div>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .collections-list {
    padding-top: var(--pad-grid-page-open, 72px);
    padding-bottom: var(--space-16, 96px);
    background: var(--bg-primary, #fff);
  }
  .collections-list__inner {
    max-width: 1200px;
  }
  .collections-list__title {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.028em;
    text-transform: none;
    text-align: center;
    color: var(--text-primary, #1c1916);
    margin: 0 0 var(--space-8, 32px);
  }
  .collections-list__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .collections-list__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid #e8e2d8;
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .collections-list__card:hover { border-color: #c9c0b3; }
  .collections-list__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--bg-alternate-soft, #faf8f6);
    overflow: hidden;
  }
  .collections-list__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .collections-list__content {
    padding: 16px 16px 20px;
    text-align: center;
  }
  .collections-list__name {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--text-primary, #1c1916);
    margin: 0 0 6px;
  }
  .collections-list__count {
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-muted, #6b645a);
    margin: 0;
  }
  @media (max-width: 1024px) {
    .collections-list__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .collections-list {
      padding-top: var(--pad-grid-page-open-mobile, 56px);
      padding-bottom: var(--space-12, 64px);
    }
    .collections-list__title { font-size: clamp(28px, 8vw, 36px); margin-bottom: 24px; }
    .collections-list__grid { column-gap: 10px; row-gap: 20px; }
    .collections-list__content { padding: 14px 10px 16px; }
    .collections-list__name { font-size: 15px; }
    .collections-list__count { font-size: 13px; }
  }
</style>
