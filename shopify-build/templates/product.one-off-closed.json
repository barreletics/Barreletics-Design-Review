      "blocks": {
        "oo1": {
          "type": "faq_item",
          "settings": {
            "question": "What are One-Off colors?",
            "answer": "<p>One-Offs are exclusive Performance Skin colorways outside the core lineup. Same 360° grip, same studio performance — limited color only. When a color sells out, it’s gone.</p>"
          }
        },
        "oo2": {
          "type": "faq_item",
          "settings": {
            "question": "When a One-Off color sells out, will it come back?",
            "answer": "<p>No. One-Offs are limited runs. Available now, then earlier drops stay sold out. If you want a color, grab it while it’s here.</p>"
          }
        },
        "oo3": {
          "type": "faq_item",
          "settings": {
            "question": "Are One-Offs the same shoe as core Closed Sole / Open Sole?",
            "answer": "<p>Yes. Same Performance Skin construction, same grip, same stability. The difference is the exclusive colorway and limited availability — not a different product system.</p>"
          }
        }
      },
