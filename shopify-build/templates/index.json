      },
      "blocks": {
        "r1": {
          "type": "review",
          "settings": {
            "rating": 5,
            "body": "My love-hate relationship with the sock has finally come to a ceremonial end. The improvement during the first minute of barre class is beyond words. I will never go back.",
            "author": "Mia Evans",
            "location": "Barre Instructor \u00b7 NYC \u00b7 Verified Purchase",
            "image_url": "https://barreletics.com/cdn/shop/files/Square_Pink.png?v=1764627088&width=1200"
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "rating": 5,
            "body": "I looked at these for over a year thinking 'Way too expensive.' I can't tell you how much I spent on Pilates socks that got ruined in no time. Game changer.",
            "author": "Gwen M.",
            "location": "Queens \u00b7 Verified purchase",
            "image_url": "https://barreletics.com/cdn/shop/files/Dusty_Rose_5e602111-f285-4b53-98b2-b3cdc3ff25a2.png?v=1773521063&width=600"
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "rating": 5,
            "body": "I refuse to wear anything else. I am 70 years old and able to accomplish advanced moves on the Cadillac apparatus. Your foot has to be gripping the bar without fail.",
            "author": "Dvorah S.",
            "location": "Fairfield \u00b7 Pilates 5x/week",
            "image_url": "https://barreletics.com/cdn/shop/files/IMG_2917.jpg?v=1741040637&width=2000"
          }
        },
        "r4": {
          "type": "review",
          "settings": {
            "rating": 5,
            "body": "Secure on the carriage through the entire footwork series. No more adjusting between sets. Feels like it was engineered for the reformer specifically.",
            "author": "Lauren T.",
            "location": "Los Angeles \u00b7 Reformer 4x/week",
            "image_url": "https://barreletics.com/cdn/shop/files/Multi_Image.jpg?v=1768346625&width=900"
          }
        },
        "r5": {
          "type": "review",
          "settings": {
            "rating": 5,
            "body": "Water ski used to mean resetting mid-set. Now my feet stay put and I can push the shake instead of fighting the sock.",
            "author": "Hannah R.",
            "location": "Austin \u00b7 Barre 4x/week",
            "image_url": "https://barreletics.com/cdn/shop/products/barreletixxjumpingtogether.jpg?v=1619360969&width=900"
          }
        },
        "r6": {
          "type": "review",
          "settings": {
            "rating": 5,
            "body": "Hot yoga used to wreck every pair of grip socks I owned. One Performance Skin \u2014 rinse, reuse, still locked in tree pose.",
            "author": "Priya K.",
            "location": "Chicago \u00b7 Hot yoga",
            "image_url": "https://barreletics.com/cdn/shop/products/Yellow_Image-Blue_Shoe_1200x1200_59ef7b79-1661-4c2f-a2da-c6b9211e2c42.jpg?v=1678412911&width=900"
          }
        },
        "r7": {
          "type": "review",
          "settings": {
            "rating": 5,
            "body": "Super Lunges on the Megaformer finally feel safe. Full-foot grip without the stretch-out cycle of barre socks.",
            "author": "Jordan P.",
            "location": "Miami \u00b7 Lagree",
            "image_url": "https://barreletics.com/cdn/shop/files/Copreni_Final_More_grey.png?v=1774119812&width=1200"
          }
        },
        "r8": {
          "type": "review",
          "settings": {
            "rating": 5,
            "body": "Instructors in my studio switched and the difference in flat back chair is obvious. No more walking feet.",
            "author": "Elena V.",
            "location": "Toronto \u00b7 Studio owner",
            "image_url": "https://barreletics.com/cdn/shop/products/barreletixxstefrunningpinkbackground.jpg?v=1710549452&width=1600"
          }
        },
        "r9": {
          "type": "review",
          "settings": {
            "rating": 5,
            "body": "I teach reformer all day. Open Sole for mat, Closed for machines \u2014 same grip system, zero sock drawer.",
            "author": "Chris N.",
            "location": "London \u00b7 Classical Pilates",
            "image_url": "https://barreletics.com/cdn/shop/files/A14_TopBottom_LightGrey-1000x1000_d30b6fcb-229e-4af9-8062-e1c4901df31e.jpg?v=1773920300&width=600"
          }
        }
      },
