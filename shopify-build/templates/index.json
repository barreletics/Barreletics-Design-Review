    "social-proof": {
      "type": "social-proof",
      "settings": {
        "eyebrow": "",
        "title": "Real people. Real results.",
        "body": "See the difference. Feel the grip.",
        "show_aggregate": false,
        "all_reviews_url": "/pages/reviews",
