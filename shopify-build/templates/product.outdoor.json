    "collection-faq": {
      "type": "collection-faq",
      "blocks": {
        "f1": {
          "type": "faq_item",
          "settings": {
            "question": "What is the Outdoor Performance Skin actually for?",
            "answer": "<p>Outdoor volleyball. Outdoor yoga. Resortwear &amp; travel. Sun-baked pavement. Anywhere you'd go barefoot, but better.</p>"
          }
        },
        "f2": {
          "type": "faq_item",
          "settings": {
            "question": "How is this different from the studio Performance Skins?",
            "answer": "<p>Outdoor Performance Skin: heel and sole covered for outdoor use. Provides grip, stability, and protection from hot pavement. The open-toe design lets your toes spread naturally, giving you better balance, better grip, and a more connected feel underfoot.</p>"
          }
        },
        "f3": {
          "type": "faq_item",
          "disabled": true,
          "settings": {
            "question": "Are they better than water shoes?",
            "answer": "<p>Also a great alternative to water shoes: far less bulky, far more versatile, and they don't trap sand or water inside.</p>"
          }
        },
        "f4": {
          "type": "faq_item",
          "settings": {
            "question": "Is there any surface I should be mindful of?",
            "answer": "<p>Yes. Like any footwear, Barreletics won’t create grip where a surface has none.</p><p>Wet tile, wet stone, and other slick floors are inherently slippery for any footwear. Always check the surface before you trust it.</p>"
          }
        },
        "f5": {
          "type": "faq_item",
          "settings": {
            "question": "How do I clean them?",
            "answer": "<p>Hand wash with warm soapy water. That's it.</p><p>How to put on: pull from the top of the foot, not the straps, to help extend their lifespan.</p>"
          }
        },
        "f6": {
          "type": "faq_item",
          "settings": {
            "question": "What size should I order?",
            "answer": "<p>M (Women 5.5 to 7.5) and L (Women 7.5 to 11, Men up to 10.5). Between 7.5 and 8? Wider foot → Large. Narrower foot → Medium.</p>"
          }
        },
        "f7": {
          "type": "faq_item",
          "settings": {
            "question": "How long do they actually last?",
            "answer": "<p>They wear well outdoors and when you travel.</p><p>Like all footwear, sun and rough surfaces will show wear over time. Grip is molded into the sole (it doesn’t peel off like printed sock dots). Normal wear isn’t a defect. Our 90-day warranty covers manufacturing defects only. See <a href=\"/pages/help#warranty\">warranty</a>.</p>"
          }
        },
        "f8": {
          "type": "faq_item",
          "settings": {
            "question": "What's the return and warranty policy?",
            "answer": "<p>30-day returns on items in new, sellable condition. 90-day warranty covers manufacturing defects only. Free shipping on orders over $150. We ship within 1 to 2 business days.</p>"
          }
        },
        "geo-beach": {
          "type": "faq_item",
          "disabled": true,
          "settings": {
            "question": "Grippy shoes for beach and hot sand",
            "answer": "<p>Beach workouts &amp; beach volleyball. Hot sand &amp; sun-baked pavement. A barrier where it matters: the sole creates just enough separation to keep you comfortable without losing ground feel.</p>"
          }
        },
        "geo-boat": {
          "type": "faq_item",
          "disabled": true,
          "settings": {
            "question": "Grippy shoes for boat decks and paddleboarding",
            "answer": "<p>On a boat deck, Barreletics protect your feet and give you grip where bare feet slip. Paddleboarding too. For slick surfaces, see <em>Good to know</em> above and “Is there any surface I should be mindful of?”</p>"
          }
        },
        "geo-travel": {
          "type": "faq_item",
          "settings": {
            "question": "Packable grippy shoes for travel and resortwear",
            "answer": "<p>Resortwear &amp; travel. Travel-friendly, zero maintenance: rinse and go. Whether practicing at home or on the go, travel light and workout without having a yoga mat in tow.</p>"
          }
        },
        "geo-outdoor-yoga": {
          "type": "faq_item",
          "settings": {
            "question": "Grip footwear for outdoor yoga",
            "answer": "<p>Outdoor yoga. Outdoor volleyball: grip on sand and grass without bulk. The open-toe design lets your toes spread naturally, giving you better balance, better grip, and a more connected feel underfoot.</p>"
          }
        }
      },
