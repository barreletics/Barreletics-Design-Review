    "reviews": {
      "type": "pdp-reviews",
      "blocks": {
        "photo1": {
          "type": "photo_review",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0045/0612/4391/files/Multi_Image.jpg?v=1768346625",
            "body": "I wish I hadn't put off buying these. They are durable and comfortable. My reformer practice has improved because they do not let you budge. I feel strong and stable in any position.",
            "author": "Kathia C.",
            "location": "New York, US",
            "rating": 5
          }
        },
        "photo2": {
          "type": "photo_review",
          "settings": {
            "image_url": "https://barreletics.com/cdn/shop/products/barreletixxstefrunningpinkbackground.jpg?v=1710549452&width=1200",
            "body": "Makes me feel so much more secure during my pilates practice \u2014 socks tended to slip to the side. These are my second pair to put in rotation. Love them even if they are pricey.",
            "author": "Victoria",
            "location": "Miami, US",
            "rating": 5
          }
        },
        "photo3": {
          "type": "photo_review",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0045/0612/4391/files/barreletixxjumpingtogether.jpg",
            "body": "I have thin, narrow feet. Most socks slip around during Pilates. These are perfect \u2014 once you wear them, you'll never go back. Just wipe them down and wear them the next day.",
            "author": "Sheryl C.",
            "location": "Verified Purchase",
            "rating": 5
          }
        },
        "text1": {
          "type": "text_review",
          "settings": {
            "body": "The grip is incredible. Easy to clean, and I love the colour I selected.",
            "author": "Sylvie D.",
            "location": "Zurich, CH",
            "rating": 5
          }
        },
        "text2": {
          "type": "text_review",
          "settings": {
            "body": "I have tried several brands of grip socks. The grip wears off and my toes slip. Since I started using Barreletics, those days are gone \u2014 more confidence in my poses and consistent grip.",
            "author": "Leslie S.",
            "location": "Katy, US",
            "rating": 5
          }
        },
        "text3": {
          "type": "text_review",
          "settings": {
            "body": "Love them. Secure in every hold \u2014 worth every dollar versus another drawer of failed socks.",
            "author": "Debora T.",
            "location": "Fleming Island, US",
            "rating": 5
          }
        },
        "text4": {
          "type": "text_review",
          "settings": {
            "body": "Feel more confident with my feet placement during Pilates class. Worth every dollar.",
            "author": "Kathleen B.",
            "location": "Verified Purchase",
            "rating": 5
          }
        },
        "text5": {
          "type": "text_review",
          "settings": {
            "body": "Best Pilates shoes by far. Support when I need it most \u2014 they don't roll or slide around.",
            "author": "Donna M.",
            "location": "Cary, US",
            "rating": 5
          }
        },
        "text6": {
          "type": "text_review",
          "settings": {
            "body": "As a martial artist and barefoot footwear enthusiast \u2014 extremely unique. Conversation with the founder sealed it.",
            "author": "Lewis J.",
            "location": "Columbus, US",
            "rating": 5
          }
        },
        "featured_review": {
          "type": "featured_review",
          "settings": {
            "rating": 5,
            "body": "Where have you been all my life? These grippy shoes have absolutely changed my Pilates practice. No slipping, no wasted time tugging on socks. For me going forward, it\u2019s Barreletics or nothing.",
            "author": "Verified buyer",
            "location": "Pilates"
          }
        }
      },
