        "f1": {
          "type": "faq_item",
          "settings": {
            "question": "How long do they last?",
            "answer": "<p>Customers report 18+ months with daily studio use and zero grip degradation. The patented material doesn't wear down like silicone dots or rubber patches. One pair replaces 6–8 pairs of grip socks per year.</p>"
          }
        },
        "f2": {
          "type": "faq_item",
          "settings": {
            "question": "Can I wear them with socks?",
            "answer": "<p>They're designed to be worn barefoot for full 360° grip. Thin liner socks break the grip contact — skip them.</p>"
          }
        },
        "f3": {
          "type": "faq_item",
          "settings": {
            "question": "What's the difference between Open and Closed Sole?",
            "answer": "<p>Closed Sole covers the foot for machines and colder studios. Open Sole leaves the toes free for mat work and warmer rooms. Same grip system either way.</p>"
          }
        }
      },
