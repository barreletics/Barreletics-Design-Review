{% comment %}
  Mix/match bundle messaging (preview). Feature flag: bundles_promo_enabled (default off).
  Assets + JSON config: snippets/cart-bundle-promo-assets.liquid (via cart-drawer).
{% endcomment %}

<div
  class="cart-bundle-promo{% if context == 'page' %} cart-bundle-promo--page{% endif %}"
  data-cart-bundle-promo
  id="cart-bundle-promo-{% if context == 'page' %}page{% else %}drawer{% endif %}"
  {% unless settings.bundles_promo_enabled %}hidden{% endunless %}
  aria-live="polite"
></div>

<style>
  .cart-bundle-promo {
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--border-default);
    background: var(--color-warm-cream, #f5f2ec);
  }

  .cart-bundle-promo--page {
    margin-bottom: var(--space-6);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card-sm, 8px);
  }

  .cart-bundle-promo__label {
    font-size: 11px;
    font-weight: var(--weight-semibold, 600);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-warm-muted, #8a8a8a);
    margin: 0 0 var(--space-2);
  }

  .cart-bundle-promo__messages {
    margin: 0 0 var(--space-2);
    padding-left: 1.1rem;
    font-size: var(--text-sm, 14px);
    color: var(--text-primary, #1c1916);
  }

  .cart-bundle-promo__messages li {
    margin-bottom: 4px;
  }

  .cart-bundle-promo__notice {
    font-size: 11px;
    line-height: 1.45;
    color: var(--text-muted, #8a8a8a);
    margin: 0;
  }

  .cart-bundle-promo__link {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: 12px;
    font-weight: var(--weight-semibold, 600);
    color: var(--accent-primary, #c45c3f);
  }
</style>
