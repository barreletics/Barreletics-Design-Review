{% comment %}
  GA4 / Google Tag — Head Snippet
  Placement: Inside <head> via theme.liquid
  Configuration: Theme Settings → Tracking & Integrations → GA4 Measurement ID

  Loads gtag.js and configures the GA4 property.
  Enhanced ecommerce events handled separately in analytics-events.liquid.

  IMPORTANT: If using Shopify's native Google channel integration,
  leave the Measurement ID blank to prevent duplicate tracking.
{% endcomment %}

{% if settings.ga4_measurement_id != blank %}
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_measurement_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', {{ settings.ga4_measurement_id | json }}, {
    'send_page_view': true
  });
</script>
{% endif %}
