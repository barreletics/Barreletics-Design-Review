{% comment %}
  GA4 / Google Tag — Head Snippet
  Property: 300437005
  Placement: Inside <head> via theme.liquid

  This snippet loads the Google tag (gtag.js) and configures
  the GA4 property. Enhanced ecommerce events are handled
  separately in analytics-events.liquid.
{% endcomment %}

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-XXXXXXXXXX', {
    'send_page_view': true
  });
</script>

{% comment %}
  OWNER ACTION REQUIRED:
  Replace 'G-XXXXXXXXXX' above with the actual GA4 Measurement ID
  from GA4 Admin > Data Streams > Web stream details.
  GA4 Property ID is 300437005 — the Measurement ID (G-XXXXX) is different
  and found in the data stream configuration.
{% endcomment %}
