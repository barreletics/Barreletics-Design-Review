{%- comment -%}
  Theme Editor live preview — same fallback as unified-text-pads-vars, no !important.
{%- endcomment -%}
{%- liquid
  assign u_y_d = section.settings.text_pad_y
  if u_y_d != blank and u_y_d != y_d
    assign eff_y_d = u_y_d
  elsif legacy_y_d != blank
    assign eff_y_d = legacy_y_d
  else
    assign eff_y_d = u_y_d | default: y_d
  endif

  assign u_side_d = section.settings.side_padding
  if u_side_d != blank and u_side_d != side_d
    assign eff_side_d = u_side_d
  elsif legacy_side_d != blank
    assign eff_side_d = legacy_side_d
  else
    assign eff_side_d = u_side_d | default: side_d
  endif

  assign u_y_m = section.settings.text_pad_y_mobile
  if u_y_m != blank and u_y_m != y_m
    assign eff_y_m = u_y_m
  elsif legacy_y_m != blank
    assign eff_y_m = legacy_y_m
  else
    assign eff_y_m = u_y_m | default: y_m
  endif

  assign u_x_m = section.settings.text_pad_x_mobile
  if u_x_m != blank and u_x_m != x_m
    assign eff_x_m = u_x_m
  elsif legacy_x_m != blank
    assign eff_x_m = legacy_x_m
  else
    assign eff_x_m = u_x_m | default: x_m
  endif
-%}
{% style %}
  #shopify-section-{{ section.id }} {{ selector }} {
    padding-top: {{ eff_y_d }}px;
    padding-bottom: {{ eff_y_d }}px;
    padding-left: {{ eff_side_d }}px;
    padding-right: {{ eff_side_d }}px;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {{ selector }} {
      padding-top: {{ eff_y_m }}px;
      padding-bottom: {{ eff_y_m }}px;
      padding-left: {{ eff_x_m }}px;
      padding-right: {{ eff_x_m }}px;
    }
  }
{% endstyle %}
