{%- comment -%}
  Theme Editor live preview — same fallback chain as unified-text-pads-vars, no !important.
{%- endcomment -%}
{%- liquid
  assign eff_y_d = y_d
  if legacy_y_d != blank
    assign eff_y_d = legacy_y_d
  elsif section.settings.text_pad_y != blank
    assign eff_y_d = section.settings.text_pad_y
  endif

  assign eff_side_d = side_d
  if legacy_side_d != blank
    assign eff_side_d = legacy_side_d
  elsif section.settings.side_padding != blank
    assign eff_side_d = section.settings.side_padding
  endif

  assign eff_y_m = y_m
  if legacy_y_m != blank
    assign eff_y_m = legacy_y_m
  elsif section.settings.text_pad_y_mobile != blank
    assign eff_y_m = section.settings.text_pad_y_mobile
  endif

  assign eff_x_m = x_m
  if legacy_x_m != blank
    assign eff_x_m = legacy_x_m
  elsif section.settings.text_pad_x_mobile != blank
    assign eff_x_m = section.settings.text_pad_x_mobile
  endif
-%}
{% style %}
  #shopify-section-{{ section.id }} {{ selector }} {
    padding-top: {{ eff_y_d }}px;
    padding-bottom: {{ eff_y_d }}px;
    padding-left: {{ eff_side_d }}px;
    padding-right: {{ eff_side_d }}px;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {{ selector }} {
      padding-top: {{ eff_y_m }}px;
      padding-bottom: {{ eff_y_m }}px;
      padding-left: {{ eff_x_m }}px;
      padding-right: {{ eff_x_m }}px;
    }
  }
{% endstyle %}
