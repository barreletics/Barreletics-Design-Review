{% comment %}
  One tab panel: expand product variants into variant-card.
  Params: product, sole_label, tab_key, max_variants, is_default, messaging_style, page_product_id
  Swirl-pattern variants are skipped (never shown in grids). Only exception: an IN-STOCK swirl
  variant on that product's own PDP (page_product_id == product.id). Sold-out swirl is always hidden.
  One-Offs (tab_key == oneoffs): single grid — available first, then sold-out (no separate band).
{% endcomment %}
{%- if product != blank -%}
  {%- liquid
    assign vgp_hide_swirl = true
    assign vgp_pid = product.id | append: ''
    if page_product_id != blank and page_product_id == vgp_pid
      assign vgp_hide_swirl = false
    endif
  -%}
  <div
    class="var-grid{% if tab_key == 'oneoffs' %} var-grid--oneoffs{% endif %}{% unless is_default %} is-grid-hidden{% endunless %}"
    id="grid-{{ tab_key }}"
    data-grid-tab="{{ tab_key }}"
  >
    {%- if tab_key == 'oneoffs' -%}
      {%- comment -%} Pass 1: in stock {%- endcomment -%}
      {%- for variant in product.variants limit: max_variants -%}
        {%- assign o1d = variant.option1 | downcase -%}
        {%- assign o2d = variant.option2 | downcase -%}
        {%- assign vtd = variant.title | downcase -%}
        {%- if vtd contains 'swirl' -%}{%- if vgp_hide_swirl or variant.available == false -%}{%- continue -%}{%- endif -%}{%- endif -%}
        {%- if o1d contains 'kid' or o2d contains 'kid' -%}{%- continue -%}{%- endif -%}
        {%- unless variant.available -%}{%- continue -%}{%- endunless -%}
        {% render 'variant-card',
          product: product,
          variant: variant,
          sole_label: sole_label,
          tab_key: tab_key,
          messaging_style: messaging_style
        %}
      {%- endfor -%}
      {%- comment -%} Pass 2: sold out (after available — same grid, no “Earlier” heading) {%- endcomment -%}
      {%- for variant in product.variants limit: max_variants -%}
        {%- assign o1d = variant.option1 | downcase -%}
        {%- assign o2d = variant.option2 | downcase -%}
        {%- assign vtd = variant.title | downcase -%}
        {%- if vtd contains 'swirl' -%}{%- if vgp_hide_swirl or variant.available == false -%}{%- continue -%}{%- endif -%}{%- endif -%}
        {%- if o1d contains 'kid' or o2d contains 'kid' -%}{%- continue -%}{%- endif -%}
        {%- if variant.available -%}{%- continue -%}{%- endif -%}
        {% render 'variant-card',
          product: product,
          variant: variant,
          sole_label: sole_label,
          tab_key: tab_key,
          messaging_style: messaging_style
        %}
      {%- endfor -%}
    {%- else -%}
      {%- for variant in product.variants limit: max_variants -%}
        {%- assign o1d = variant.option1 | downcase -%}
        {%- assign o2d = variant.option2 | downcase -%}
        {%- assign vtd = variant.title | downcase -%}
        {%- if vtd contains 'swirl' -%}{%- if vgp_hide_swirl or variant.available == false -%}{%- continue -%}{%- endif -%}{%- endif -%}
        {%- if o1d contains 'kid' or o2d contains 'kid' -%}
          {%- continue -%}
        {%- endif -%}
        {% render 'variant-card',
          product: product,
          variant: variant,
          sole_label: sole_label,
          tab_key: tab_key,
          messaging_style: messaging_style
        %}
      {%- endfor -%}
    {%- endif -%}
  </div>
{%- endif -%}
