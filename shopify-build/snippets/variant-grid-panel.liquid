{% comment %}
  One tab panel: expand product variants into variant-card.
  Params: product, sole_label, tab_key, max_variants, is_default, messaging_style
  One-Offs (tab_key == oneoffs): Available now + Earlier one-offs groups.
{% endcomment %}
{%- if product != blank -%}
  <div
    class="var-grid{% if tab_key == 'oneoffs' %} var-grid--oneoffs{% endif %}{% unless is_default %} is-grid-hidden{% endunless %}"
    id="grid-{{ tab_key }}"
    data-grid-tab="{{ tab_key }}"
  >
    {%- if tab_key == 'oneoffs' -%}
      {%- assign oo_available_count = 0 -%}
      {%- assign oo_earlier_count = 0 -%}
      {%- for variant in product.variants limit: max_variants -%}
        {%- assign o1d = variant.option1 | downcase -%}
        {%- assign o2d = variant.option2 | downcase -%}
        {%- if o1d contains 'kid' or o2d contains 'kid' -%}
          {%- continue -%}
        {%- endif -%}
        {%- if variant.available -%}
          {%- assign oo_available_count = oo_available_count | plus: 1 -%}
        {%- else -%}
          {%- assign oo_earlier_count = oo_earlier_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if oo_available_count > 0 -%}
        <div class="var-grid-group" data-oneoff-group="available">
          <p class="var-grid-group__label">Available now</p>
          <div class="var-grid-group__cards">
            {%- for variant in product.variants limit: max_variants -%}
              {%- assign o1d = variant.option1 | downcase -%}
              {%- assign o2d = variant.option2 | downcase -%}
              {%- if o1d contains 'kid' or o2d contains 'kid' -%}{%- continue -%}{%- endif -%}
              {%- unless variant.available -%}{%- continue -%}{%- endunless -%}
              {% render 'variant-card',
                product: product,
                variant: variant,
                sole_label: sole_label,
                tab_key: tab_key,
                messaging_style: messaging_style
              %}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if oo_earlier_count > 0 -%}
        <div class="var-grid-group" data-oneoff-group="earlier">
          <p class="var-grid-group__label">Earlier one-offs</p>
          <div class="var-grid-group__cards">
            {%- for variant in product.variants limit: max_variants -%}
              {%- assign o1d = variant.option1 | downcase -%}
              {%- assign o2d = variant.option2 | downcase -%}
              {%- if o1d contains 'kid' or o2d contains 'kid' -%}{%- continue -%}{%- endif -%}
              {%- if variant.available -%}{%- continue -%}{%- endif -%}
              {% render 'variant-card',
                product: product,
                variant: variant,
                sole_label: sole_label,
                tab_key: tab_key,
                messaging_style: messaging_style
              %}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- else -%}
      {%- for variant in product.variants limit: max_variants -%}
        {%- assign o1d = variant.option1 | downcase -%}
        {%- assign o2d = variant.option2 | downcase -%}
        {%- if o1d contains 'kid' or o2d contains 'kid' -%}
          {%- continue -%}
        {%- endif -%}
        {% render 'variant-card',
          product: product,
          variant: variant,
          sole_label: sole_label,
          tab_key: tab_key,
          messaging_style: messaging_style
        %}
      {%- endfor -%}
    {%- endif -%}
  </div>
{%- endif -%}
