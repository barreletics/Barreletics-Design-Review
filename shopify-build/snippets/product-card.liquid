{% comment %}
  Product Card
  Source: Doc 04 (Component 6), approved prototypes

  Displays a single product variant with image, name, price, quick-add.
  Hover: image 1.02× scale, 320ms. No swatches on cards.

  Usage:
    {% render 'product-card', product: product %}
    {% render 'product-card', product: product, show_quick_add: true %}

  Parameters:
    - product: Shopify product object (required)
    - show_quick_add: boolean (default: true)
    - show_badge: boolean (default: true)
    - show_installments: boolean (default: true)
    - card_style: 'default' | 'minimal' (default: 'default')
{% endcomment %}

{% assign show_quick_add = show_quick_add | default: true %}
{% assign show_badge = show_badge | default: true %}
{% assign show_installments = show_installments | default: true %}
{% assign card_style = card_style | default: 'default' %}

<article class="product-card{% if card_style == 'minimal' %} product-card--minimal{% endif %}">
  <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title }}">
    <div class="product-card__media">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | escape | default: product.title }}"
          width="600"
          height="600"
          loading="lazy"
          class="product-card__img"
        />
      {% else %}
        <div class="product-card__placeholder">
          {{ product.title | slice: 0 }}
        </div>
      {% endif %}

      {% if show_badge and product.metafields.custom.badge != blank %}
        <span class="product-card__badge">{{ product.metafields.custom.badge }}</span>
      {% elsif show_badge and product.available == false %}
        <span class="product-card__badge product-card__badge--soldout">Sold Out</span>
      {% endif %}
    </div>

    <div class="product-card__content">
      <h3 class="product-card__name">{{ product.title }}</h3>
      {% if product.metafields.custom.subtitle != blank %}
        <p class="product-card__meta">{{ product.metafields.custom.subtitle }}</p>
      {% endif %}
      <p class="product-card__price">{{ product.price | money }}</p>
      {% if show_installments %}
        <p class="product-card__installment">or 4 × {{ product.price | divided_by: 4 | money }} with Shop Pay</p>
      {% endif %}
    </div>
  </a>

  {% if show_quick_add and product.available %}
    <form method="post" action="/cart/add" class="product-card__form">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
      <input type="hidden" name="quantity" value="1" />
      <button type="submit" class="product-card__add" aria-label="Add {{ product.title }} to cart">
        Add to Cart
      </button>
    </form>
  {% endif %}
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card-sm);
    overflow: hidden;
    transition: box-shadow var(--transition-fast);
    background: var(--color-white);
  }
  .product-card:hover { box-shadow: var(--shadow-md); }

  .product-card__link { text-decoration: none; color: inherit; display: flex; flex-direction: column; flex: 1; }
  .product-card__link:hover { text-decoration: none; }

  .product-card__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--bg-alternate);
  }
  .product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .product-card:hover .product-card__img { transform: scale(1.04); }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: var(--text-muted);
    background: var(--bg-alternate);
  }

  .product-card__badge {
    position: absolute;
    bottom: 10px;
    left: 10px;
    font-size: 9px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    background: rgba(28, 25, 22, 0.7);
    color: var(--color-white);
    padding: 3px 8px;
    border-radius: 2px;
  }
  .product-card__badge--soldout { background: var(--text-muted); }

  .product-card__content {
    padding: 18px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex: 1;
  }
  .product-card__name {
    font-size: 18px;
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }
  .product-card__meta {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
  }
  .product-card__price {
    font-size: 16px;
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 4px 0 0;
  }
  .product-card__installment {
    font-size: 12px;
    color: var(--text-muted);
    margin: 2px 0 0;
  }

  .product-card__form { padding: 0 18px 18px; }
  .product-card__add {
    width: 100%;
    font-size: 13px;
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--text-primary);
    border-radius: var(--radius-button);
    padding: 10px 20px;
    letter-spacing: 0.03em;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .product-card__add:hover {
    background: var(--color-charcoal);
    color: var(--color-white);
  }

  /* Minimal variant (no border, no add button) */
  .product-card--minimal { border: none; }
  .product-card--minimal:hover { box-shadow: none; }
</style>
