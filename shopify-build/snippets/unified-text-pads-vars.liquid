{%- comment -%}
  Storefront CSS variables for unified text pads.
  y_d / side_d / y_m / x_m = schema defaults for this section (must match {% schema %} default).
  Priority:
    1) unified slider when value != schema default (merchant moved slider)
    2) else legacy when passed and not blank
    3) else unified value (= schema default)
{%- endcomment -%}
{%- liquid
  assign u_y_d = section.settings.text_pad_y
  if u_y_d != blank and u_y_d != y_d
    assign _y_d = u_y_d
  elsif legacy_y_d != blank
    assign _y_d = legacy_y_d
  else
    assign _y_d = u_y_d | default: y_d
  endif

  assign u_side_d = section.settings.side_padding
  if u_side_d != blank and u_side_d != side_d
    assign _side_d = u_side_d
  elsif legacy_side_d != blank
    assign _side_d = legacy_side_d
  else
    assign _side_d = u_side_d | default: side_d
  endif

  assign u_y_m = section.settings.text_pad_y_mobile
  if u_y_m != blank and u_y_m != y_m
    assign _y_m = u_y_m
  elsif legacy_y_m != blank
    assign _y_m = legacy_y_m
  else
    assign _y_m = u_y_m | default: y_m
  endif

  assign u_x_m = section.settings.text_pad_x_mobile
  if u_x_m != blank and u_x_m != x_m
    assign _x_m = u_x_m
  elsif legacy_x_m != blank
    assign _x_m = legacy_x_m
  else
    assign _x_m = u_x_m | default: x_m
  endif
-%}
--utp-y-d: {{ _y_d }}px; --utp-side-d: {{ _side_d }}px; --utp-y-m: {{ _y_m }}px; --utp-x-m: {{ _x_m }}px;
