{%- comment -%}
  Storefront CSS variables for unified text pads.
  Priority: legacy (template JSON) → unified slider (when non-blank) → render defaults y_d/side_d/y_m/x_m.
  Unified range settings must omit schema default so unsaved instances stay blank until migrated.
{%- endcomment -%}
{%- liquid
  assign _y_d = y_d
  if legacy_y_d != blank
    assign _y_d = legacy_y_d
  elsif section.settings.text_pad_y != blank
    assign _y_d = section.settings.text_pad_y
  endif

  assign _side_d = side_d
  if legacy_side_d != blank
    assign _side_d = legacy_side_d
  elsif section.settings.side_padding != blank
    assign _side_d = section.settings.side_padding
  endif

  assign _y_m = y_m
  if legacy_y_m != blank
    assign _y_m = legacy_y_m
  elsif section.settings.text_pad_y_mobile != blank
    assign _y_m = section.settings.text_pad_y_mobile
  endif

  assign _x_m = x_m
  if legacy_x_m != blank
    assign _x_m = legacy_x_m
  elsif section.settings.text_pad_x_mobile != blank
    assign _x_m = section.settings.text_pad_x_mobile
  endif
-%}
--utp-y-d: {{ _y_d }}px; --utp-side-d: {{ _side_d }}px; --utp-y-m: {{ _y_m }}px; --utp-x-m: {{ _x_m }}px;
