{% comment %}
  Cart bundle preview JSON config for cart-bundle-promo.js (off unless theme setting enabled).
  Template placeholders use assign+append (no Liquid tags inside filter string literals).
{% endcomment %}
{% liquid
  assign _l = '{' | append: '{'
  assign _r = '}' | append: '}'
  assign _pct = _l | append: 'percent' | append: _r
  assign _cnt = _l | append: 'count' | append: _r
  assign _unit = _l | append: 'unit' | append: _r
  assign _amt = _l | append: 'amount' | append: _r
  assign default_footwear_offer = 'Buy 2+ Closed Sole pairs. Save ' | append: _pct | append: '%.'
  assign default_pants_offer = 'Save ' | append: _pct | append: '% on one pair of yoga pants with 2+ Closed Sole pairs.'
  assign default_pants_headline = default_pants_offer
  assign default_pants_qual = 'Add 1 more Closed Sole pair for ' | append: _pct | append: '% off yoga pants'
  assign default_draft_notice = 'Draft test: savings show when cart qualifies. Codes are not auto-applied—use checkout or an offer link below when configured.'
  assign default_nudge = 'Add ' | append: _cnt | append: ' ' | append: _unit | append: '. Save ' | append: _pct | append: '.'
  assign default_savings = 'You save ' | append: _amt | append: '.'
  assign default_preview_notice = default_draft_notice
  assign default_pants_url = '/products/' | append: 'lightly-padded-knee-yoga-pant-black'
%}
<script id="cart-bundle-promo-config" type="application/json">
{
  "enabled": {{ settings.cart_bundle_promo_enabled | default: false | json }},
  "pairPromoMode": {{ settings.cart_bundle_pair_mode | default: 'live_2for15' | json }},
  "livePairPercent": {{ settings.cart_bundle_live_pair_percent | default: 15 | json }},
  "tierTwoPercent": {{ settings.cart_bundle_tier_two_percent | default: 10 | json }},
  "tierThreePlusPercent": {{ settings.cart_bundle_tier_three_plus_percent | default: 15 | json }},
  "pantsMinPairs": {{ settings.cart_bundle_pants_min_pairs | default: 2 | json }},
  "pantsPercent": {{ settings.cart_bundle_pants_percent | default: 35 | json }},
  "pantsProposedPriceCents": {{ settings.cart_bundle_pants_proposed_price | default: 9800 | json }},
  "footwearOfferTemplate": {{ settings.cart_bundle_footwear_offer_template | default: default_footwear_offer | json }},
  "pantsOfferTemplate": {{ settings.cart_bundle_pants_offer_template | default: default_pants_offer | json }},
  "pantsHeadline": {{ settings.cart_bundle_pants_headline | default: default_pants_headline | json }},
  "pantsQualTemplate": {{ settings.cart_bundle_pants_qual_template | default: default_pants_qual | json }},
  "nudgeAddPairTemplate": {{ settings.cart_bundle_nudge_template | default: default_nudge | json }},
  "draftDisplayMode": {{ settings.cart_bundle_draft_display_mode | default: 'qualification_test' | json }},
  "previewNotice": {{ settings.cart_bundle_preview_notice | default: default_preview_notice | json }},
  "footwearDiscountCode": {{ settings.cart_bundle_footwear_discount_code | default: '' | json }},
  "pantsDiscountCode": {{ settings.cart_bundle_pants_discount_code | default: '' | json }},
  "footwearCodeLinkLabel": {{ settings.cart_bundle_footwear_code_link_label | default: 'Apply footwear offer code at checkout' | json }},
  "pantsCodeLinkLabel": {{ settings.cart_bundle_pants_code_link_label | default: 'Apply yoga pants offer code at checkout' | json }},
  "pantsProductTitle": {{ settings.cart_bundle_pant_product_title | default: 'Lightly Padded Knee Yoga Pant' | json }},
  "pantsImageUrl": {{ settings.cart_bundle_pant_image_url | default: 'https://cdn.shopify.com/s/files/1/0045/0612/4391/files/IMG_2914.jpg?v=1741040643' | json }},
  "pantsAddLabel": {{ settings.cart_bundle_pant_add_label | default: 'Add yoga pants' | json }},
  "pantsProductHandle": {{ settings.cart_bundle_pant_product_handle | default: 'lightly-padded-knee-yoga-pant-black' | json }},
  "pantsProductUrl": {% if settings.cart_bundle_pant_product_url != blank %}{{ settings.cart_bundle_pant_product_url | json }}{% else %}{{ default_pants_url | json }}{% endif %},
  "pantsDefaultVariantId": {{ settings.cart_bundle_pant_variant_id | default: 0 | json }},
  "freeShippingThresholdCents": {{ settings.cart_bundle_free_ship_threshold | default: 15000 | json }},
  "savingsTemplate": {{ settings.cart_bundle_savings_template | default: default_savings | json }},
  "previewDisclaimer": {{ settings.cart_bundle_preview_disclaimer | default: 'Cart subtotal and checkout are unchanged. These lines are illustrative savings math only.' | json }},
  "skinHandleNeedles": {{ settings.cart_bundle_skin_handles | default: 'closed-sole' | split: ',' | json }},
  "skinTitleNeedles": {{ settings.cart_bundle_skin_titles | default: 'Closed Sole,Performance Skin' | split: ',' | json }},
  "pantHandleNeedles": {{ settings.cart_bundle_pant_handles | default: 'pant,yoga-pant' | split: ',' | json }},
  "pantTitleNeedles": {{ settings.cart_bundle_pant_titles | default: 'Yoga Pant,Pant' | split: ',' | json }},
  "skinRequireClosedSole": {{ settings.cart_bundle_require_closed_sole | default: true | json }}
}
</script>
