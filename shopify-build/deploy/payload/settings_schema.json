[
  {
    "name": "theme_info",
    "theme_name": "Barreletics",
    "theme_version": "1.0.0",
    "theme_author": "Barreletics",
    "theme_documentation_url": "https://barreletics.com",
    "theme_support_url": "https://barreletics.com/pages/contact"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Primary palette"
      },
      {
        "type": "color",
        "id": "color_charcoal",
        "label": "Charcoal (primary text)",
        "default": "#1c1916"
      },
      {
        "type": "color",
        "id": "color_body_text",
        "label": "Body text",
        "default": "#4a4a4a"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#8a8a8a"
      },
      {
        "type": "color",
        "id": "color_white",
        "label": "White",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_warm_cream",
        "label": "Warm cream (alternate bg)",
        "default": "#f5f2ec"
      },
      {
        "type": "header",
        "content": "Accent colors"
      },
      {
        "type": "color",
        "id": "color_coral",
        "label": "Coral (accent)",
        "default": "#e8927c"
      },
      {
        "type": "color",
        "id": "color_rust",
        "label": "Rust (CTA/accent)",
        "default": "#c45c3f"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Gold (star ratings)",
        "default": "#d4af37"
      },
      {
        "type": "header",
        "content": "Borders & surfaces"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Default border",
        "default": "#e5e0d8"
      },
      {
        "type": "color",
        "id": "color_warm_border",
        "label": "Warm border (header scroll)",
        "default": "#d6cfc0"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_font_family",
        "label": "Primary font",
        "default": "roboto_n4"
      },
      {
        "type": "range",
        "id": "type_base_size",
        "label": "Base font size",
        "min": 14,
        "max": 20,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "label": "Heading scale factor",
        "min": 100,
        "max": 150,
        "step": 5,
        "default": 100,
        "unit": "%"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "max_width",
        "label": "Max content width",
        "min": 1000,
        "max": 1600,
        "step": 40,
        "default": 1200,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "section_padding_x",
        "label": "Section horizontal padding",
        "min": 16,
        "max": 64,
        "step": 4,
        "default": 24,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Announcement bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "announcement_enabled",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_message_1",
        "label": "Message 1",
        "default": "Buy 2, Save 15% — Code SAVE15"
      },
      {
        "type": "text",
        "id": "announcement_message_2",
        "label": "Message 2",
        "default": "Free Shipping Over $150"
      },
      {
        "type": "text",
        "id": "announcement_message_3",
        "label": "Message 3",
        "default": "30-Day Returns · Made in USA"
      },
      {
        "type": "range",
        "id": "announcement_rotation_speed",
        "label": "Rotation speed",
        "min": 2,
        "max": 8,
        "step": 1,
        "default": 4,
        "unit": "s"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer (recommended)" },
          { "value": "page", "label": "Full page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold",
        "default": "150"
      }
    ]
  },
  {
    "name": "Cart bundle preview (Nov08)",
    "settings": [
      {
        "type": "paragraph",
        "content": "Theme-only preview estimates for cart drawer and cart page. Does not create Shopify discounts or change checkout prices. Default off."
      },
      {
        "type": "checkbox",
        "id": "cart_bundle_promo_enabled",
        "label": "Enable cart bundle preview",
        "default": false
      },
      {
        "type": "select",
        "id": "cart_bundle_pair_mode",
        "label": "Pair promo mode",
        "default": "live_2for15",
        "options": [
          { "value": "live_2for15", "label": "Live — 2FOR15 / SAVE15 style (percent)" },
          { "value": "future_tiers", "label": "Future — 2 pairs = tier 2%, 3+ pairs = tier 3%" }
        ]
      },
      {
        "type": "range",
        "id": "cart_bundle_live_pair_percent",
        "label": "Live pair discount percent",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 15,
        "unit": "%"
      },
      {
        "type": "range",
        "id": "cart_bundle_tier_two_percent",
        "label": "Future tier — 2 pairs",
        "min": 0,
        "max": 25,
        "step": 1,
        "default": 10,
        "unit": "%"
      },
      {
        "type": "range",
        "id": "cart_bundle_tier_three_plus_percent",
        "label": "Future tier — 3+ pairs",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 15,
        "unit": "%"
      },
      {
        "type": "range",
        "id": "cart_bundle_pants_min_pairs",
        "label": "Pants offer — minimum Performance Skin pairs",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 2
      },
      {
        "type": "range",
        "id": "cart_bundle_pants_percent",
        "label": "Pants preview discount percent",
        "min": 0,
        "max": 50,
        "step": 1,
        "default": 35,
        "unit": "%"
      },
      {
        "type": "number",
        "id": "cart_bundle_pants_proposed_price",
        "label": "Pants proposed price for preview math (cents)",
        "default": 9800,
        "info": "Used only for preview savings math (e.g. 9800 = $98.00 → $63.70 at 35%). Live catalog price (e.g. $89) is not modified."
      },
      {
        "type": "text",
        "id": "cart_bundle_pants_headline",
        "label": "Pants headline",
        "default": "Complete your set. Save {{percent}}% on yoga pants.",
        "info": "Use {{percent}} — updates when discount % changes."
      },
      {
        "type": "text",
        "id": "cart_bundle_pants_qual_template",
        "label": "Pants qualify note",
        "default": "Add {{count}} more {{unit}} of Performance Skins to qualify."
      },
      {
        "type": "text",
        "id": "cart_bundle_nudge_template",
        "label": "Add-pair nudge template",
        "default": "Add {{count}} {{unit}}. Save {{percent}}%.",
        "info": "Placeholders: {{count}}, {{unit}}, {{percent}}."
      },
      {
        "type": "text",
        "id": "cart_bundle_pant_product_title",
        "label": "Pants upsell title",
        "default": "Lightly Padded Knee Yoga Pant"
      },
      {
        "type": "text",
        "id": "cart_bundle_pant_image_url",
        "label": "Pants preview image URL",
        "default": "https://cdn.shopify.com/s/files/1/0045/0612/4391/files/IMG_2914.jpg?v=1741040643",
        "info": "CDN URL from approved mock — not uploaded to theme files."
      },
      {
        "type": "text",
        "id": "cart_bundle_pant_add_label",
        "label": "Pants CTA label",
        "default": "Add yoga pants"
      },
      {
        "type": "text",
        "id": "cart_bundle_pant_product_handle",
        "label": "Pants product handle",
        "default": "lightly-padded-knee-yoga-pant-black",
        "info": "Public product.js loads size/color options for cart add (no silent default size)."
      },
      {
        "type": "url",
        "id": "cart_bundle_pant_product_url",
        "label": "Pants product page URL (fallback link)",
        "default": "/products/lightly-padded-knee-yoga-pant-black"
      },
      {
        "type": "number",
        "id": "cart_bundle_pant_variant_id",
        "label": "Pants default variant ID for AJAX add (optional)"
      },
      {
        "type": "number",
        "id": "cart_bundle_free_ship_threshold",
        "label": "Free shipping threshold for preview math (cents)",
        "default": 15000
      },
      {
        "type": "text",
        "id": "cart_bundle_savings_template",
        "label": "Total savings template",
        "default": "You save {{amount}}.",
        "info": "Use {{amount}} placeholder."
      },
      {
        "type": "textarea",
        "id": "cart_bundle_preview_disclaimer",
        "label": "Preview disclaimer",
        "default": "Preview estimate only. Your cart still uses live Shopify prices; checkout discounts are not applied by this theme preview."
      },
      {
        "type": "text",
        "id": "cart_bundle_skin_handles",
        "label": "Eligible skin handles (comma-separated substrings)",
        "default": "closed-sole"
      },
      {
        "type": "text",
        "id": "cart_bundle_skin_titles",
        "label": "Eligible skin title substrings",
        "default": "Closed Sole,Performance Skin"
      },
      {
        "type": "text",
        "id": "cart_bundle_pant_handles",
        "label": "Eligible pant handles (comma-separated substrings)",
        "default": "pant,yoga-pant"
      },
      {
        "type": "text",
        "id": "cart_bundle_pant_titles",
        "label": "Eligible pant title substrings",
        "default": "Yoga Pant,Pant"
      },
      {
        "type": "checkbox",
        "id": "cart_bundle_require_closed_sole",
        "label": "Require Closed Sole for pair counting",
        "default": true
      }
    ]
  },
