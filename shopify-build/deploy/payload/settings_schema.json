  {
    "name": "Favicon & branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "og_default_image",
        "label": "Default Open Graph image",
        "info": "Displayed when sharing pages without a specific image. Recommended: 1200x630px."
      }
    ]
  },
  {
    "name": "Tracking & Integrations",
    "settings": [
      {
        "type": "header",
        "content": "Analytics"
      },
      {
        "type": "paragraph",
        "content": "Only use these fields if NOT using Shopify's native Google\/Meta channel integrations. Using both will cause duplicate tracking events."
      },
      {
        "type": "text",
        "id": "ga4_measurement_id",
        "label": "GA4 Measurement ID",
        "info": "Format: G-XXXXXXXXXX. Found in GA4 Admin → Data Streams. Leave blank if using Shopify's Google channel."
      },
      {
        "type": "text",
        "id": "meta_pixel_id",
        "label": "Meta Pixel ID",
        "info": "From Meta Business Manager → Events Manager. Leave blank if using Shopify's Meta & Instagram channel."
      },
      {
        "type": "text",
        "id": "pinterest_tag_id",
        "label": "Pinterest Tag ID",
        "info": "From Pinterest Business → Ads → Conversions."
      },
      {
        "type": "text",
        "id": "clarity_project_id",
        "label": "Microsoft Clarity Project ID",
        "info": "From clarity.microsoft.com → Settings → Setup."
      },
      {
        "type": "header",
        "content": "Customer support"
      },
      {
        "type": "text",
        "id": "helpscout_beacon_id",
        "label": "Help Scout Beacon ID",
        "info": "Leave blank to disable the Help Scout chat widget."
      },
      {
        "type": "text",
        "id": "tidio_widget_key",
        "label": "Tidio Widget Key",
        "info": "Leave blank to disable the Tidio chat widget."
      },
      {
        "type": "header",
        "content": "Search & verification"
      },
      {
        "type": "text",
        "id": "search_console_verification",
        "label": "Google Search Console Verification",
        "info": "The meta tag content value for domain verification. Found in Search Console → Settings → Ownership verification → HTML tag."
      }
    ]
  },
  {
    "name": "Free shipping",
    "settings": [
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 150,
        "unit": "$"
      },
      {
        "type": "text",
        "id": "free_shipping_message",
        "label": "Free shipping message",
        "default": "Free shipping on orders over $150"
      }
    ]
  }
]
